{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The website: static files only, no Worker code. Unknown paths get dist/404.html with
  // status 404. Deploys and the custom domain (featherplay.candygoogy.dev) wait for the
  // maintainer's OK.
  "name": "featherplay-site",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
