{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The website: static files only, no Worker code, served at featherplay.candygoogy.dev.
  // Unknown paths get dist/404.html with status 404.
  "name": "featherplay-site",
  "compatibility_date": "2026-10-30",
  "routes": [{ "pattern": "featherplay.candygoogy.dev", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
