---
// Everything you'd miss, kept: one surface divided into cells by 1 px lines, each live piece
// placed straight on its cell and whole inside it at every width (all on the page's one
// player). The smaller things (the local API, Opus, coming from Pear Desktop) are answers in
// the questions (src/data/faq.ts), where they were said already.
import MediaKeys from "./pieces/MediaKeys.astro";
import DiscordCard from "./pieces/DiscordCard.astro";
import ScrobbleRow from "./pieces/ScrobbleRow.astro";
import SponsorBlock from "./pieces/SponsorBlock.astro";
import TrayTip from "./pieces/TrayTip.astro";
import Note from "./Note.astro";
---

<section id="kept" class="sec kept frame" aria-labelledby="kept-title">
  <div class="sec-head">
    <h2 id="kept-title" class="t-title">Everything you’d miss, kept</h2>
    <p class="t-lede ink2">Built in from the first run. No add-ons to find.</p>
  </div>
  <div class="cells">
    <article class="cell c-keys">
      <div class="cell-text"><h3 class="t-subtitle">Media keys</h3><p>Play, pause and skip from your keyboard, the Windows media overlay or the taskbar.</p></div>
      <div class="cell-piece"><MediaKeys><Note id="keysFirst" arrow="up-left" class="n-keys n-keys-first" /><Note id="keys" arrow="up-left" class="n-keys n-keys-own" /></MediaKeys></div>
    </article>
    <article class="cell c-discord">
      <div class="cell-text"><h3 class="t-subtitle">Discord status</h3><p>Friends see what you’re playing, with a preview in Settings. Off until you turn it on.</p></div>
      <div class="cell-piece"><DiscordCard /></div>
    </article>
    <article class="cell c-scrobble">
      <div class="cell-text"><h3 class="t-subtitle">Scrobbling</h3><p>Songs you play past halfway go to Last.fm, ListenBrainz or both.</p></div>
      <div class="cell-piece"><ScrobbleRow /></div>
    </article>
    <article class="cell c-sponsor">
      <div class="cell-text"><h3 class="t-subtitle">SponsorBlock</h3><p>featherplay skips the talking in music videos, so you hear the song.</p></div>
      <div class="cell-piece"><SponsorBlock /></div>
    </article>
    <article class="cell c-tray">
      <div class="cell-text"><h3 class="t-subtitle">The tray</h3><p>Closing the window asks to quit or play on in the tray, until you tell it to remember.</p></div>
      <div class="cell-piece tray-piece">
        <!-- The little story in order: the close button asks, then the song plays on in the tray. -->
        <div class="tray-story">
        <div class="step">
          <p class="step-l"><span class="step-n">1</span>Close the window: it asks</p>
          <div class="m-close" aria-hidden="true">
            <p class="mc-h">Close featherplay?</p>
            <p class="mc-p">Choose what the close button does this time. featherplay will ask again next time.</p>
            <p class="mc-check"><span class="box"></span>Remember my choice</p>
            <p class="mc-btns"><span class="chosen">Keep playing in the tray</span><span class="solid">Close featherplay</span></p>
          </div>
        </div>
        <svg class="step-arrow" viewBox="0 0 48 16" width="48" height="16" aria-hidden="true"
          ><path d="M2 8h42M37 2l7 6-7 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
          ></path></svg
        >
        <div class="step step-tray">
          <p class="step-l"><span class="step-n">2</span>In the tray, still playing</p>
          <TrayTip corner />
        </div>
        </div>
      </div>
    </article>
  </div>
</section>

<style>
  .kept {
    --hair: color-mix(in srgb, var(--text) 10%, transparent);
  }
  /* One surface, cut into cells by 1 px lines (the gaps show the line colour beneath). */
  .cells {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1px;
    margin-top: var(--s7);
    overflow: hidden;
    border-radius: var(--r-panel);
    /* Solid line tones: a translucent edge over the desk would vanish against the dark cells. */
    background: color-mix(in srgb, #e5ddd2 calc(var(--light) * 100%), #2b2b2b);
    box-shadow:
      0 0 0 1px var(--panel-edge),
      0 1px 2px var(--panel-lift),
      0 24px 56px -28px var(--panel-lift);
  }
  .cell {
    display: grid;
    grid-template-rows: auto 1fr;
    align-content: start;
    gap: var(--s6);
    min-width: 0;
    padding: var(--panel-pad);
    background: color-mix(in srgb, #fdfcfa calc(var(--light) * 100%), #181818);
  }
  .cell-text {
    display: grid;
    align-content: start;
    gap: var(--s2);
  }
  .c-tray .cell-text {
    align-content: center;
  }
  /* Under the keys (which stay centred under the overlay), from their middle on to the right,
     its arrow pointing back up at them. */
  .c-keys :global(.n-keys) {
    left: 50%;
    top: calc(100% + 2.75rem);
  }
  /* The visitor's own keys reach the page only while a song plays with sound: until then the
     note asks for a song first (bind-pieces.ts marks the keys data-idle). */
  .c-keys :global([data-keys-stage][data-idle] .n-keys-own),
  .c-keys :global([data-keys-stage]:not([data-idle]) .n-keys-first) {
    display: none;
  }
  @media (width >= 760px) {
    .c-keys :global(.mk-board) {
      padding-bottom: calc(var(--fs-pen) + var(--s3));
    }
  }
  /* Phones and tablets: no media keys to try. */
  @media (width < 760px) {
    .c-keys :global(.n-keys) {
      display: none;
    }
  }
  .cell-text p {
    max-width: 40ch;
    color: var(--ink2);
  }
  /* Each piece is its cell's subject: on a quiet well of its own, centred, with room. */
  .cell-piece {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    min-height: 15rem;
    padding: var(--s7) var(--s6);
    border-radius: 14px;
    background: light-dark(rgb(90 66 40 / 0.035), rgb(255 255 255 / 0.025));
  }
  .c-scrobble .cell-piece > :global(*) {
    width: min(100%, 30rem);
  }
  /* A wide well (a large screen): Discord's card and SponsorBlock's a size up, by layout, so
     each fills its well as its neighbours do. */
  .cell-piece {
    container: piece / inline-size;
  }
  @container piece (width > 36rem) {
    .c-discord :global(.m-discord) {
      width: min(31rem, 100%);
      padding: var(--s5) var(--s6);
      font-size: var(--fs-text);
    }
    .c-discord :global(.dc-art > img) {
      width: 112px;
      height: 112px;
    }
    .c-discord :global(.dc-title) {
      font-size: var(--fs-lede);
    }
  }
  /* A narrow well (a phone): a smaller cover, so the song's title keeps its room (still taller
     than the three lines beside it, so the card is one height whatever the song). */
  @container piece (width < 22rem) {
    .c-discord :global(.m-discord) {
      padding: var(--s4);
    }
    .c-discord :global(.dc-act) {
      gap: var(--s3);
    }
    .c-discord :global(.dc-art > img) {
      width: 68px;
      height: 68px;
    }
  }
  @container piece (width > 50rem) {
    .c-sponsor :global(.m-sponsor) {
      width: min(46rem, 100%);
      padding: var(--s6) var(--s7) var(--s7);
      font-size: var(--fs-text);
    }
    .c-sponsor :global(.sp-top img) {
      width: 56px;
      height: 56px;
    }
    .c-sponsor :global(.sp-title) {
      font-size: var(--fs-lede);
    }
  }
  .cell-piece > :global(*) {
    max-width: 100%;
  }
  .c-keys,
  .c-sponsor {
    grid-column: span 7;
  }
  .c-discord,
  .c-scrobble {
    grid-column: span 5;
  }
  .c-tray {
    grid-column: span 12;
    grid-template-rows: auto;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
  }
  /* The two steps beside each other wherever they fit, the arrow between them pointing on;
     stacked where they don't, the arrow turned to point down (a size container: the cell's
     own width decides, not the screen's). */
  .tray-piece {
    container-type: inline-size;
  }
  .tray-story {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    /* (The gap gives way before the dialog does: its two buttons keep one row. In steps, not
       in the container's own units: those are worked out again whenever anything in the well
       changes, the tooltip's clock every second.) */
    gap: var(--s5) var(--s4);
  }
  @container (width >= 46rem) {
    .tray-story .mc-btns {
      flex-wrap: nowrap;
      white-space: nowrap;
    }
  }
  @container (width >= 50rem) {
    .tray-story {
      column-gap: var(--s5);
    }
  }
  @container (width >= 58rem) {
    .tray-story {
      column-gap: var(--s6);
    }
  }
  @container (width >= 68rem) {
    .tray-story {
      column-gap: var(--s7);
    }
  }
  @container (width < 46rem) {
    .tray-story {
      flex-direction: column;
      align-items: center;
    }
    .tray-story .step-arrow {
      rotate: 90deg;
      margin-top: 0;
    }
    /* One under the other, the tray's step is centred under the dialog as the arrow is. */
    .tray-story .step-tray,
    .tray-story .step-tray :global(.tray-corner) {
      justify-items: center;
    }
  }
  .step {
    display: grid;
    justify-items: start;
    gap: var(--s3);
  }
  /* The tray's step keeps one width whatever the song: its tooltip is as wide as its words (a
     long title, a short one), set to the step's right edge with its label, so it grows into
     room that is already there and the dialog beside it never moves. */
  .step-tray {
    flex: none;
    /* (A length, not a share of the row: the row is sized by what is in it.) */
    width: 19.5rem;
    max-width: 100%;
    justify-items: end;
  }
  .step-tray :global(.tray-corner) {
    grid-template-columns: minmax(0, 1fr);
    width: 100%;
  }
  .step-tray :global(.tray-tip) {
    max-width: 100%;
  }
  .step-l {
    display: flex;
    align-items: center;
    gap: var(--s2);
    color: var(--ink2);
    font-weight: var(--fw-medium);
  }
  .step-n {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: var(--tonal);
    color: var(--text);
    font-size: var(--fs-small);
    font-weight: var(--fw-bold);
  }
  .step-arrow {
    align-self: center;
    margin-top: var(--s7);
    color: var(--ink2);
  }
  /* The app's close dialog, drawn (close_dialog.slint). */
  .m-close {
    width: min(26rem, 100%);
    padding: var(--s5);
    border-radius: var(--r-panel);
    background: var(--mat-fly);
    box-shadow: var(--lit), var(--ring), var(--shadow);
    font-family: var(--font-ui);
    font-size: 14px;
  }
  .mc-h {
    font-family: var(--font);
    font-size: 18px;
    font-weight: 700;
  }
  .mc-p {
    margin-top: var(--s2);
    color: var(--ink2);
  }
  .mc-check {
    display: flex;
    align-items: center;
    gap: var(--s2);
    margin-top: var(--s4);
  }
  .box {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    box-shadow: inset 0 0 0 1.5px var(--ink2);
  }
  .mc-btns {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--s2);
    margin-top: var(--s4);
  }
  .mc-btns span {
    padding: var(--s2) var(--s4);
    border-radius: var(--r-pill);
    background: var(--tonal);
    font-weight: 600;
  }
  .mc-btns .solid {
    background: var(--solid);
    color: var(--on-solid);
  }
  /* The choice this story makes. */
  .mc-btns .chosen {
    box-shadow: 0 0 0 2px var(--accent);
  }
  @media (width < 1100px) {
    .cell,
    .c-keys,
    .c-sponsor,
    .c-discord,
    .c-scrobble {
      grid-column: span 12;
    }
    .c-tray {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (width < 560px) {
    /* A phone: the well gives the piece its whole width. */
    .cell-piece {
      min-height: 0;
      padding: var(--s4) var(--s2);
    }
  }
</style>
