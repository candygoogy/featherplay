---
// One of the maker's handwritten notes (src/data/notes.ts): the words in the hand and a pen
// arrow, placed by its host's CSS in free ground beside what it points at. Decoration only: the
// page says the same in its own words, so it is hidden from assistive technology. It writes
// itself in once, the first time it is wholly in view, and is hidden rather than drawn over
// anything its words would touch at the width it gets (src/scripts/notes.ts). Without script
// nothing can judge that, so it isn't shown; with reduced motion it is there without the writing.
import { notes, type NoteId } from "../data/notes";

/** The arrows, drawn once each with the pen, and which side of the words they sit on. */
const ARROWS = {
  right: { w: 60, h: 24, d: "M3 15 C 18 19.5, 36 17.6, 55 9 M48.4 6.2 L55.6 9.1 L50.6 15.3", before: false },
  "down-right": { w: 40, h: 30, d: "M6 4 C 8.4 13, 13.2 20.4, 22 25 M14.5 24.6 L22.6 25.5 L20.8 17.8", before: false },
  down: { w: 34, h: 40, d: "M5 5 C 7 17, 12 27, 21 34 M13.4 34.6 L21.4 34.8 L20 27", before: false },
  /** A long reach down and a little right: from beside the words, past an edge, into what's under it. */
  "down-reach": { w: 40, h: 78, d: "M4 6 C 16 10, 28 34, 32 74 M26.7 68 L32 74 L35.7 67", before: false },
  "down-left": { w: 44, h: 30, d: "M40 5 C 30 6.5, 17 12, 8 24 M8.5 15.6 L7.6 24.4 L15.6 21.6", before: true },
  "up-left": { w: 40, h: 30, d: "M36 24 C 26 22.5, 16 17, 8.5 6.5 M15.4 8.6 L8.2 6 L7.6 13.6", before: true },
} as const;

interface Props {
  id: NoteId;
  arrow?: keyof typeof ARROWS | "none";
  class?: string;
  /** Written by its owner's script (the story, the window), not on coming into view. */
  manual?: boolean;
  /** Its arrow drawn by its owner's script to what it points at (src/scripts/notes.ts penArrow). */
  free?: boolean;
  /** Its first word underlined with the pen, after the words. */
  underline?: boolean;
}
const { id, arrow = "none", class: className, manual = false, free = false, underline = false } = Astro.props;
const a = free || arrow === "none" ? null : ARROWS[arrow];
// The arrows are sized in em (drawn for the 30 px hand), so a larger hand has larger arrows.
const em = (n: number) => `${+(n / 30).toFixed(4)}em`;
const text = notes[id];
const cut = text.indexOf(" ");
---

<p class:list={["hand", className, a && `arrow-${arrow}`, free && "free-arrow"]} data-note={id} data-note-manual={manual ? "" : undefined} aria-hidden="true">
  {a?.before && <svg viewBox={`0 0 ${a.w} ${a.h}`} style={`width:${em(a.w)};height:${em(a.h)}`}><path pathLength="1" d={a.d} /></svg>}<span
    >{
      underline && cut > 0 ? (
        <>
          <span class="ul">
            {text.slice(0, cut)}
            <svg class="ul-line" viewBox="0 0 100 10" preserveAspectRatio="none"><path pathLength="1" d="M2 6.5 C 28 3.5, 62 8, 98 4.5" /></svg>
          </span>
          {text.slice(cut)}
        </>
      ) : (
        text
      )
    }</span
  >{a && !a.before && <svg viewBox={`0 0 ${a.w} ${a.h}`} style={`width:${em(a.w)};height:${em(a.h)}`}><path pathLength="1" d={a.d} /></svg>}{
    free && (
      <svg class="free" width="1" height="1">
        <path pathLength="1" d="M0 0" />
      </svg>
    )
  }
</p>

<style is:global>
  /* The hand's face, with the notes only (the pages without notes don't reference it). */
  @font-face {
    font-family: "Reenie Beanie";
    src: url("/fonts/reenie-beanie-subset.woff2") format("woff2");
    font-weight: 400;
    font-display: block;
  }
</style>
