---
// The download arrow in two parts, for the Download buttons: the arrow, clipped at the tray so
// it can drop into it, and the tray (src/scripts/moves.ts plays the drop on hover and press, the
// Lottie file's timings). At rest it is the plain arrow-into-tray.
interface Props {
  size?: number;
  stroke?: number;
  class?: string;
}
const { size = 18, stroke = 1.8, class: className } = Astro.props;
---

<svg
  class:list={["dl-glyph", className]}
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  data-dl-glyph
  ><svg x="0" y="0" width="24" height="18.4" overflow="hidden"><path class="dl-arrow-part" d="M12 4.5 V15 M7.5 10.5 L12 15 L16.5 10.5"></path></svg><path
    class="dl-tray-part"
    d="M5 19.5 H19"></path></svg
>
