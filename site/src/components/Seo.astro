---
// Search and sharing: the canonical address, Open Graph and Twitter cards with the laptop
// image, and (on the home page) the SoftwareApplication structured data. Facts only: the
// version, size and price come from release.ts, nothing invented (no ratings).
import { release } from "../data/release";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  app?: boolean;
}
const { title, description, noindex = false, app = false } = Astro.props;
const site = Astro.site ?? new URL("https://featherplay.candygoogy.dev");
const path = Astro.url.pathname.replace(/\.html$/, "").replace(/\/index$/, "/");
const canonical = new URL(path, site).href;
const image = new URL("/og.jpg", site).href;
const ld = app
  ? {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      name: "featherplay",
      description,
      url: site.href,
      applicationCategory: "MultimediaApplication",
      applicationSubCategory: "Music player",
      operatingSystem: "Windows 10, Windows 11",
      softwareVersion: release.version,
      fileSize: `${release.sizeMB.toFixed(2)} MB`,
      downloadUrl: release.url,
      license: "https://opensource.org/licenses/MIT",
      isAccessibleForFree: true,
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      image,
      screenshot: image,
    }
  : null;
---

{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
<meta property="og:type" content="website" />
<meta property="og:site_name" content="featherplay" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:alt" content="featherplay on a Windows laptop, showing a song with its synced lyrics" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content="featherplay on a Windows laptop, showing a song with its synced lyrics" />
{ld && <script type="application/ld+json" set:html={JSON.stringify(ld)} />}
