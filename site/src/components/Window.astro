---
// featherplay's window on the page: the replica (the app's own layout, Replica.astro) in a frame
// that is a size container, so the app lays itself out for the window's size as the real one
// does (the end of replica.css). Without script it fills its slot, a still of the app at that size;
// with it, src/demo/window.ts sizes and scales it to fit, never past the viewport, and makes it
// a window: dragged by its title bar, maximised and restored, minimised to the tray, closed
// with the app's own question (the dialog below, at the page's size). Where the window stood
// while it is away (in the tray, or closed) the desk shows what a desk has (.win-gone): the
// app's shortcut, which brings it back, with the maker's hand over it taking the headline at
// its word; and under it three more things lying about, each a real way on: the Recycle Bin
// (what featherplay leaves out), a text file (how the numbers were measured) and a folder (the
// music's credits). The screen is never left with nothing where the app was.
import Replica from "./Replica.astro";
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { notes } from "../data/notes";
---

<div class="window" data-window>
  <div class="win-body" data-win-body>
    <Replica view="lyrics" />
  </div>
</div>
<div class="win-gone" data-win-gone>
  <!-- Not one of the page's placed notes (no data-note: nothing judges or writes it but the
       window's script, each time it shows). -->
  <p class="hand gone-hand" data-judged data-gone-hand data-closed={notes.closed} data-tray={notes.tray} aria-hidden="true">
    <span data-gone-words>{notes.closed}</span>
    <svg viewBox="0 0 24 34"><path pathLength="1" d="M10 3 C 9 12, 11 20, 13 30 M6.5 23.5 L13.2 30.4 L18 22.4"></path></svg>
  </p>
  <button class="shortcut" type="button" data-win-back tabindex="-1" aria-label="Open featherplay">
    <Logo size={44} /><span class="sc-name">featherplay</span>
  </button>
  <div class="sc-row">
    <a class="shortcut" href="#leaves" aria-label="Recycle Bin: what featherplay leaves out">
      <svg class="sc-glyph" viewBox="0 0 24 24" width="30" height="30" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"
        ><path d="M4.5 7.5 H19.5 M9.5 7.5 V5.6 a1 1 0 0 1 1 -1 h3 a1 1 0 0 1 1 1 V7.5 M6.6 7.5 l0.8 10.9 a1.6 1.6 0 0 0 1.6 1.5 h6 a1.6 1.6 0 0 0 1.6 -1.5 l0.8 -10.9 M10.2 11 v5.6 M13.8 11 v5.6"></path></svg
      ><span class="sc-name">Recycle Bin</span>
    </a>
    <a class="shortcut" href="/method" aria-label="how we measured.txt: how the numbers were measured">
      <svg class="sc-glyph" viewBox="0 0 24 24" width="30" height="30" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"
        ><path d="M7.6 3.5 H13.8 L18 7.7 V18.9 a1.6 1.6 0 0 1 -1.6 1.6 H7.6 A1.6 1.6 0 0 1 6 18.9 V5.1 A1.6 1.6 0 0 1 7.6 3.5 Z M13.8 3.5 V7.7 H18 M9 12 h6 M9 15 h6 M9 18 h3.5"></path></svg
      ><span class="sc-name">how we measured.txt</span>
    </a>
    <a class="shortcut" href="/credits" aria-label="Music credits: the songs and their licences">
      <Icon name="folder" size={30} class="sc-glyph" /><span class="sc-name">Music credits</span>
    </a>
  </div>
</div>
<dialog class="closer glass float live" data-closer aria-labelledby="closer-h" aria-describedby="closer-text">
  <h2 id="closer-h" class="closer-h">Close featherplay?</h2>
  <p id="closer-text" class="closer-p" data-closer-text>Choose what the close button does this time. featherplay will ask again next time.</p>
  <label class="closer-check"><input type="checkbox" data-closer-remember /> Remember my choice</label>
  <div class="closer-btns">
    <button type="button" class="closer-btn" data-closer-do="tray">Keep playing in the tray</button>
    <button type="button" class="closer-btn solid" data-closer-do="close">Close featherplay</button>
  </div>
</dialog>

<script>
  import { bindReplicas } from "../demo/replica";
  import { bindWindow } from "../demo/window";
  const player = bindReplicas();
  const el = document.querySelector<HTMLElement>("[data-window]");
  if (player && el) bindWindow(el, player);
</script>

<style>
  .window {
    --s: 1;
    position: absolute;
    inset: 0;
    z-index: 10;
  }
  /* With script, unseen until placed at its size: no frame of the slot's layout first, and the
     app inside not laid out at all until then (it would be laid out twice at load, once at the
     slot's size). */
  :global(.js) .window:not(:global(.placed)) {
    visibility: hidden;
    content-visibility: hidden;
  }
  /* Placed by script: its own size and a transform from its top left. */
  .window:global(.placed) {
    inset: auto;
    left: 0;
    top: 0;
    transform-origin: 0 0;
    will-change: transform;
  }
  .win-body {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: calc(8px / var(--s));
    container: app / size;
    box-shadow:
      0 0 0 calc(1px / var(--s)) var(--edge),
      0 calc(1px / var(--s)) calc(2px / var(--s)) var(--shade-1),
      0 calc(4px / var(--s)) calc(16px / var(--s)) var(--shade-2),
      0 calc(16px / var(--s)) calc(56px / var(--s)) var(--shade-3);
  }
  /* A sleeve carried over it: a ring, the window saying it will take it. */
  .window[data-drop] .win-body {
    outline: calc(3px / var(--s)) solid color-mix(in srgb, var(--text) 70%, transparent);
    outline-offset: calc(4px / var(--s));
  }
  .window[data-max] .win-body {
    border-radius: 0;
  }
  .window[data-minimised] {
    visibility: hidden;
    transition: visibility 0s linear 400ms;
  }
  /* Where the window stood while it is away (src/demo/window.ts places it at that middle): a
     few things on the desk, each lit under the pointer as Windows lights a desktop icon. The
     app's shortcut first, the maker's note over it with its arrow down to it; the other three
     in a row under it, smaller in voice (the second ink). In once the window has gone, out at
     once as it comes back. */
  .win-gone {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 9;
    display: grid;
    justify-items: center;
    gap: var(--s4);
    visibility: hidden;
    opacity: 0;
    transition: opacity 160ms ease;
  }
  .sc-row {
    display: flex;
    align-items: start;
    gap: var(--s1);
  }
  .sc-row .shortcut {
    color: var(--ink2);
    text-decoration: none;
  }
  .sc-row .shortcut:hover,
  .sc-row .shortcut:focus-visible {
    color: var(--text);
  }
  .shortcut :global(.sc-glyph) {
    width: 30px;
    height: 30px;
    stroke-width: 1.4;
  }
  .sc-name {
    line-height: 1.25;
    text-align: center;
    text-wrap: balance;
  }
  .shortcut {
    display: grid;
    justify-items: center;
    gap: 6px;
    width: 6.5rem;
    padding: 10px 6px 8px;
    border: 0;
    border-radius: var(--r-small);
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    cursor: pointer;
    transition:
      background-color var(--t-hover) ease,
      color var(--t-hover) ease,
      scale var(--t-release) var(--spring-release);
  }
  .shortcut:hover,
  .shortcut:focus-visible {
    background: var(--tonal);
  }
  .shortcut:active {
    background: var(--tonal-hover);
    scale: var(--press-scale);
    transition-duration: var(--t-hover), var(--t-press);
  }
  /* The note sits over the app's shortcut (the block's top), centred on it, its arrow under
     its words. */
  .gone-hand {
    left: 50%;
    bottom: calc(100% + 0.1em);
    flex-direction: column;
    align-items: center;
    gap: 0.05em;
    translate: -50% 0;
  }
  .gone-hand svg {
    width: 0.8em;
    height: 1.1333em;
  }
  .win-gone[data-on] {
    visibility: visible;
    opacity: 1;
    transition:
      opacity 280ms ease 340ms,
      visibility 0s linear 340ms;
  }
  :global(:root:not(.js)) .win-gone {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .win-gone,
    .win-gone[data-on] {
      transition: none;
    }
  }
  /* The caption buttons' targets are 32 page px tall whatever the window's scale (their width
     is Windows' 46 px, scaled). */
  .window :global(button.cap) {
    position: relative;
  }
  .window :global(button.cap::after) {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: max(100%, 32px / var(--s));
  }
  /* The title bar is the window's handle. */
  @media (min-width: 761px) {
    .window :global(.titlebar) {
      touch-action: none;
    }
    .window[data-dragging] :global(.titlebar) {
      cursor: grabbing;
    }
  }
  /* Until the visitor clicks into the window, the wheel over it scrolls the page: its lists
     don't scroll. */
  .window:not([data-active]) :global(.rows) {
    overflow: hidden;
  }

  /* The app's own close dialog (close_dialog.slint), at the page's size, over the window. */
  .closer {
    --mat: var(--mat-fly);
    position: fixed;
    inset: auto;
    left: 50%;
    top: 50%;
    width: min(28.75rem, 100vw - 32px);
    margin: 0;
    padding: var(--s5);
    border: 0;
    border-radius: var(--r-panel);
    color: var(--text);
    font-family: var(--font-ui);
    font-size: 14px;
  }
  /* The theme's own scrim: black at a third turned light's warm paper a muddy grey. */
  .closer::backdrop {
    background: var(--scrim);
  }
  /* It comes up as the app's dialog does: a little smaller and lower, and in. */
  @media (prefers-reduced-motion: no-preference) {
    .closer[open] {
      animation: closer-in 220ms var(--ease-out);
    }
    .closer[open]::backdrop {
      animation: closer-dim 220ms ease-out;
    }
  }
  @keyframes closer-in {
    from {
      opacity: 0;
      scale: 0.96;
      translate: 0 8px;
    }
  }
  @keyframes closer-dim {
    from {
      opacity: 0;
    }
  }
  .closer-h {
    font-family: var(--font);
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .closer-p {
    margin-top: var(--s2);
    color: var(--ink2);
  }
  .closer-check {
    display: flex;
    align-items: center;
    gap: var(--s2);
    margin-top: var(--s4);
    cursor: pointer;
  }
  .closer-check input {
    width: 18px;
    height: 18px;
    margin: 0;
    accent-color: var(--accent);
  }
  .closer-btns {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--s2);
    margin-top: var(--s5);
  }
  .closer-btn {
    min-height: 40px;
    padding: 0 var(--s4);
    border: 0;
    border-radius: var(--r-pill);
    background: var(--tonal);
    color: var(--text);
    font-weight: 600;
    cursor: pointer;
    transition: background-color var(--t-hover) ease;
  }
  .closer-btn:hover {
    background: var(--tonal-hover);
  }
  .closer-btn.solid {
    background: var(--solid);
    color: var(--on-solid);
  }
  .closer-btn.solid:hover {
    background: var(--solid-hover);
  }
  @media (width < 420px) {
    .closer-btn {
      flex: 1 1 100%;
    }
  }
</style>

<style is:global>
  /* Maximise and restore (src/demo/window.ts): a view transition of the window alone. The page
     is left out of it (it goes on as it is; presses wait the third of a second it takes, since
     a window in transition can't be pressed and they would land on what is under it), the
     frame grows from the old size
     to the new on the window curve, and the old layout, on top, dissolves quickly into the new
     one under it. Each keeps its own proportions from the frame's top left: the new one fills
     the frame, the old one keeps the frame's height, so the two are the same size where they
     show together (the title bar and the player bar don't double). */
  :root[data-win-morph] {
    view-transition-name: none;
  }
  ::view-transition-group(fp-window) {
    overflow: clip;
    /* The window's own edge and shadow, which the clip would take off on the way. */
    border-radius: 8px;
    box-shadow:
      0 0 0 1px var(--edge),
      0 4px 16px var(--shade-2),
      0 16px 56px var(--shade-3);
    animation-duration: 340ms;
    animation-timing-function: cubic-bezier(0.32, 0.72, 0, 1);
  }
  ::view-transition-image-pair(fp-window) {
    isolation: auto;
  }
  ::view-transition-old(fp-window),
  ::view-transition-new(fp-window) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left top;
    mix-blend-mode: normal;
  }
  ::view-transition-new(fp-window) {
    animation: none;
    opacity: 1;
  }
  /* Its own fade alone (the browser's pair of animations would also add the two layouts'
     light together). */
  ::view-transition-old(fp-window) {
    z-index: 1;
    width: auto;
    object-fit: fill;
    animation: win-old-out 140ms ease-out both;
  }
  @keyframes win-old-out {
    to {
      opacity: 0;
    }
  }
</style>
