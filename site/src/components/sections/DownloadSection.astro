---
// Download: one card, "Download for Windows" with the version and what it runs on, the two ways
// to get it as two rows with their sizes, the two notes for the first run, and a slice of the
// real window cut off by the card's edge. Linux in its own row outside the Windows card; then
// the releases and checksums. Every file and size from src/data/release.ts.
import { downloadOptions, release, sizeLabel } from "../../data/release";
import { links } from "../../data/links";
import Icon from "../Icon.astro";

const options = downloadOptions();
const linux = release.linux;
const size = (f: Parameters<typeof sizeLabel>[0]) => sizeLabel(f).replace(" ", " ");
const arrow = "M12 4.5 V15 M7.5 10.5 L12 15 L16.5 10.5 M5 19.5 H19";
---

<section class="sec sec-dl frame" id="download" aria-labelledby="download-title">
  <div class="dl panel" data-download-card>
    <div class="dl-main">
      <h2 id="download-title" class="t-title">Download for Windows</h2>
      <p class="dl-meta"><span>Version <span data-version>{release.version}</span></span><span>Windows 10 and 11, 64-bit</span><span>Free</span></p>
      <ul class="dl-rows">
        {
          options.map((o) => (
            <li class="dl-row" data-download-option={o.id}>
              <div class="what">
                <h3 class="o-title">
                  {o.title}
                  {o.primary && options.length > 1 && <span class="rec">recommended</span>}
                </h3>
                <p class="o-note">{o.note}</p>
              </div>
              <div class="get">
                <span class="size num">
                  <span class="visually-hidden">{o.file.name}, </span>
                  <span data-size>{size(o.file)}</span>
                </span>
                <a class:list={["btn", o.primary ? "red" : "tonal"]} href={o.file.url} data-release-link>
                  <svg class="dl-arrow" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d={arrow} />
                  </svg>
                  {o.action}
                </a>
              </div>
            </li>
          ))
        }
      </ul>
      <div class="dl-notes" data-first-run>
        <h3 class="visually-hidden">Before you run it</h3>
        <div class="fr">
          <Icon name="shield" size={20} />
          <div>
            <h4>“Windows protected your&nbsp;PC”</h4>
            <p>featherplay isn’t code-signed yet, so SmartScreen may warn you once. Choose <strong>More info</strong>, then <strong>Run anyway</strong>.</p>
          </div>
        </div>
        <div class="fr">
          <Icon name="folder" size={20} />
          <div>
            <h4>Where it keeps things</h4>
            <p>
              Settings in <span class="path">%APPDATA%\<wbr />featherplay</span>, the cache in <span class="path">%LOCALAPPDATA%\<wbr />featherplay</span>,
              your sign-in in Credential Manager. The uninstaller removes them all; with the exe, delete them and it’s gone.
            </p>
          </div>
        </div>
      </div>
    </div>
    <div class="dl-slice" aria-hidden="true">
      <img class="only-dark" src="/img/window-slice-dark.webp" width="1200" height="711" alt="" loading="lazy" decoding="async" />
      <img class="only-light" src="/img/window-slice-light.webp" width="1200" height="711" alt="" loading="lazy" decoding="async" />
    </div>
  </div>
  {
    linux && (
      <div class="linux-row panel" data-download-linux>
        <div class="what">
          <h3 class="o-title">Also for Linux, experimental</h3>
          <p class="o-note">
            An AppImage for x86_64, on glibc 2.35 or newer. Tested automatically on Ubuntu, Debian, Fedora and Arch; only lightly on real
            desktops so far. The .tar.gz and the aarch64 builds are on the <a class="text-link" href={linux.page}>release page</a>, the steps and
            limits in the <a class="text-link" href={links.linux}>README</a>.
          </p>
        </div>
        <div class="get">
          <span class="size num">
            <span class="visually-hidden">{linux.appImage.name}, </span>
            <span data-size>{size(linux.appImage)}</span>
          </span>
          <a class="btn tonal" href={linux.appImage.url} data-release-link>
            <svg class="dl-arrow" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={arrow} />
            </svg>
            Download the AppImage
          </a>
        </div>
      </div>
    )
  }
  <p class="fine t-small"><a class="text-link" href={release.url}>All releases and checksums on GitHub</a></p>
</section>

<style>
  .sec-dl {
    --hair: color-mix(in srgb, var(--text) 11%, transparent);
  }
  .dl {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: var(--s7);
    padding: var(--panel-pad);
    overflow: hidden;
  }
  .dl-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s1) var(--s4);
    margin-top: var(--s3);
    color: var(--ink2);
    font-weight: var(--fw-medium);
  }
  .dl-meta span + span::before {
    content: "·";
    margin-right: var(--s4);
  }
  .dl-rows {
    margin: var(--s6) 0 0;
    padding: 0;
    list-style: none;
  }
  .dl-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--s4) var(--s6);
    padding: var(--s5) 0;
    box-shadow: inset 0 1px 0 var(--hair);
  }
  .dl-row:last-child {
    box-shadow:
      inset 0 1px 0 var(--hair),
      inset 0 -1px 0 var(--hair);
  }
  .o-title {
    font-size: var(--fs-lede);
    font-weight: var(--fw-bold);
    letter-spacing: var(--tr-lede);
  }
  .rec {
    margin-left: 6px;
    color: var(--ink2);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    letter-spacing: 0;
  }
  .o-note {
    max-width: 48ch;
    margin-top: var(--s1);
    color: color-mix(in srgb, var(--text) 86%, transparent);
    text-wrap: pretty;
  }
  .get {
    display: flex;
    align-items: center;
    gap: var(--s4);
  }
  .size {
    color: var(--ink2);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    white-space: nowrap;
  }
  .get .btn {
    min-width: 15.5rem;
  }
  /* The arrow drops into its tray as the button is pressed (download-arrow's timing). */
  .dl-arrow {
    transition: translate var(--t-release) var(--spring-release);
  }
  .btn:active .dl-arrow {
    translate: 0 2px;
    transition: translate var(--t-press) var(--ease-out);
  }
  .dl-notes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s6);
    margin-top: var(--s6);
  }
  .fr {
    display: grid;
    grid-template-columns: 20px minmax(0, 1fr);
    gap: var(--s3);
    color: var(--ink2);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    line-height: var(--lh-small);
  }
  .fr :global(svg) {
    margin-top: 1px;
  }
  .fr h4 {
    margin: 0 0 var(--s1);
    color: var(--text);
    font-size: var(--fs-text);
    font-weight: var(--fw-bold);
  }
  .fr strong {
    color: var(--text);
    font-weight: var(--fw-bold);
  }
  .path {
    padding: 0 4px;
    border-radius: var(--r-control);
    background: var(--tonal);
    white-space: nowrap;
  }
  /* A slice of the real window, cut off by the card's right and bottom edges. */
  .dl-slice {
    position: relative;
    min-height: 24rem;
    margin: var(--s8) calc(-1 * var(--panel-pad)) calc(-1 * var(--panel-pad)) 0;
  }
  .dl-slice img {
    position: absolute;
    left: 0;
    top: 0;
    width: 60rem;
    max-width: none;
    height: auto;
    border-radius: var(--r-small) 0 0 0;
    box-shadow:
      0 0 0 1px var(--edge),
      0 1px 2px var(--shade-1),
      0 4px 16px var(--shade-2),
      0 16px 56px var(--shade-3);
  }
  .linux-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--s4) var(--s7);
    margin-top: var(--s5);
    padding: var(--panel-pad);
  }
  .linux-row .o-note {
    max-width: 70ch;
  }
  .fine {
    margin-top: var(--s5);
  }
  @media (width < 1000px) {
    .dl {
      grid-template-columns: minmax(0, 1fr);
    }
    .dl-slice {
      min-height: 16rem;
      margin: 0 calc(-1 * var(--panel-pad)) calc(-1 * var(--panel-pad)) var(--s5);
    }
    .dl-slice img {
      width: 44rem;
    }
  }
  @media (width < 700px) {
    /* Wrapped, a dot would start a line: the gap alone keeps them apart. */
    .dl-meta span + span::before {
      content: none;
    }
    .dl-row,
    .linux-row {
      grid-template-columns: minmax(0, 1fr);
    }
    .dl-notes {
      grid-template-columns: minmax(0, 1fr);
    }
    .get {
      flex-direction: row-reverse;
      justify-content: flex-end;
    }
    .get .btn {
      min-width: 0;
      flex: 1;
    }
  }
</style>
