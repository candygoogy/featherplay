---
// Download: one card, "Download for Windows" with the version and what it runs on as one meta
// line, then the two ways to get it: the installer first, on its own step of tone with its
// "Recommended" badge, the portable exe second; each with its size and its button as one unit,
// the sizes in one column of tabular figures and the two buttons one width. Under them the two
// notes for the first run. On the right, the app itself: a third view of the page's one player
// (the live replica, inert, kept on the cover view so the crop cuts no line of lyrics), opening
// level with the rows and cropped by the card's right and bottom edges, so it follows the song
// and the theme and is sharp at any size. Linux in its own
// row outside the card, on the same columns; then the releases and checksums. Every file and
// size from src/data/release.ts.
import { downloadOptions, release, sizeLabel } from "../../data/release";
import { links } from "../../data/links";
import { demoStart } from "../../data/songs";
import Icon from "../Icon.astro";
import Replica from "../Replica.astro";
import Note from "../Note.astro";
import DlGlyph from "../DlGlyph.astro";

const options = downloadOptions();
const linux = release.linux;
const size = (f: Parameters<typeof sizeLabel>[0]) => sizeLabel(f).replace(" ", " ");
---

<section class="sec sec-dl frame" id="download" aria-labelledby="download-title">
  <div class="dl panel" data-download-card>
    <div class="dl-main">
      <h2 id="download-title" class="t-title">Download for Windows</h2>
      <p class="dl-meta">
        <span>Version <span class="num" data-version>{release.version}</span></span><span>Windows 10 and 11, 64-bit</span><span>Free</span>
      </p>
      <ul class="dl-rows">
        {
          options.map((o) => (
            <li class:list={["dl-row", { first: o.primary }]} data-download-option={o.id}>
              <div class="what">
                <h3 class="o-title">
                  {o.title}
                  {o.primary && options.length > 1 && <span class="rec">Recommended</span>}
                </h3>
                <p class="o-note">{o.note}</p>
              </div>
              <span class="size num">
                <span class="visually-hidden">{o.file.name}, </span>
                <span data-size>{size(o.file)}</span>
              </span>
              <a class:list={["btn", "get", o.primary ? "red" : "tonal"]} href={o.file.url} data-release-link>
                <DlGlyph class="dl-arrow" />
                {o.action}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="dl-notes" data-first-run>
        <h3 class="visually-hidden">Before you run it</h3>
        <div class="fr">
          <span class="fr-icon"><Icon name="shield" size={18} /></span>
          <div>
            <h4>“Windows protected your&nbsp;PC”</h4>
            <p>featherplay isn’t code-signed yet, so SmartScreen may warn you once. Choose <strong>More info</strong>, then <strong>Run anyway</strong>.</p>
          </div>
        </div>
        <div class="fr">
          <span class="fr-icon"><Icon name="folder" size={18} /></span>
          <div>
            <h4>Where it keeps things</h4>
            <p>
              Settings in <code>%APPDATA%\<wbr />featherplay</code>, the cache in <code>%LOCALAPPDATA%\<wbr />featherplay</code>, your sign-in in
              Credential Manager. The uninstaller removes them all; with the exe, delete them and it’s gone.
            </p>
          </div>
        </div>
      </div>
    </div>
    <div class="dl-shot" aria-hidden="true">
      <div class="dl-win win-body" inert>
        <Replica id="replica-dl" songId={demoStart.songId} positionMs={demoStart.positionMs} view="now" pin nowLabel="Now playing, by the download" />
      </div>
    </div>
  </div>
  {
    linux && (
      <div class="linux-row panel" data-download-linux>
        <div class="what">
          <h3 class="o-title">Also for Linux, experimental</h3>
          <p class="o-note">
            An AppImage for x86_64, on glibc 2.35 or newer. Tested automatically on Ubuntu, Debian, Fedora and Arch; only lightly on real
            desktops so far. The .tar.gz and the aarch64 builds are on the <a class="text-link" href={linux.page}>release page</a>, the steps and
            limits in the <a class="text-link" href={links.linux}>README</a>.
          </p>
        </div>
        <span class="size num">
          <span class="visually-hidden">{linux.appImage.name}, </span>
          <span data-size>{size(linux.appImage)}</span>
        </span>
        <a class="btn get tonal" href={linux.appImage.url} data-release-link>
          <DlGlyph class="dl-arrow" />
          Download the AppImage
        </a>
      </div>
    )
  }
  <div class="dl-foot">
    <p class="fine"><a class="text-link" href={release.url}>All releases and checksums on GitHub</a></p>
    <Note id="end" class="n-end" />
  </div>
</section>

<style>
  .sec-dl {
    /* The two columns every row shares, in the card and in Linux's: the size (tabular, set to
       its right edge) and the button. */
    --size-w: 5.5rem;
    --get-w: 17rem;
    --row-pad: var(--s5);
  }
  .dl {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: var(--s8);
    padding: var(--panel-pad);
    overflow: hidden;
  }
  .dl-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s1) var(--s3);
    margin-top: var(--s3);
    color: var(--ink2);
    font-weight: var(--fw-medium);
  }
  .dl-meta > span + span::before {
    content: "·";
    margin-right: var(--s3);
  }
  /* The rows on one grid (subgrid): the words, the size, the button. Space and a step of tone
     part them, no rules. */
  .dl-rows {
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--size-w) var(--get-w);
    gap: var(--s2) 0;
    margin: var(--s6) calc(-1 * var(--row-pad)) 0;
    padding: 0;
    list-style: none;
  }
  .dl-row {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: 1 / -1;
    align-items: center;
    column-gap: var(--s4);
    padding: var(--row-pad);
    border-radius: 16px;
  }
  /* The first choice: its own step of tone, so it reads first. */
  .dl-row.first {
    background: light-dark(rgb(90 66 40 / 0.055), rgb(255 255 255 / 0.055));
    box-shadow: inset 0 0 0 1px light-dark(rgb(90 66 40 / 0.07), rgb(255 255 255 / 0.05));
  }
  .what {
    min-width: 0;
    padding-right: var(--s4);
  }
  .o-title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s1) var(--s3);
    font-size: var(--fs-lede);
    font-weight: var(--fw-bold);
    letter-spacing: var(--tr-lede);
  }
  .rec {
    display: inline-flex;
    align-items: center;
    height: 1.5rem;
    padding: 0 0.6rem;
    border-radius: var(--r-pill);
    background: color-mix(in srgb, var(--accent) 13%, transparent);
    color: light-dark(#a00a29, #ff9aa8);
    font-size: var(--fs-small);
    font-weight: var(--fw-bold);
    letter-spacing: 0.01em;
  }
  .o-note {
    max-width: 52ch;
    margin-top: var(--s1);
    color: color-mix(in srgb, var(--text) 86%, transparent);
    text-wrap: pretty;
  }
  .size {
    justify-self: end;
    color: var(--ink2);
    font-weight: var(--fw-medium);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  /* The pair: one width, the arrow at the same place in each, the words after it. */
  .get {
    justify-content: flex-start;
    width: 100%;
    padding-inline: 1.375rem;
  }
  .dl-notes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s6);
    margin-top: var(--s6);
  }
  .fr {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: var(--s3);
    align-items: start;
  }
  .fr-icon {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 10px;
    background: var(--tonal);
    color: var(--text);
  }
  .fr h4 {
    margin: 0.25rem 0 var(--s1);
    font-size: var(--fs-text);
    font-weight: var(--fw-bold);
  }
  .fr p {
    max-width: 44ch;
    color: var(--ink2);
    text-wrap: pretty;
  }
  .fr strong {
    color: var(--text);
    font-weight: var(--fw-bold);
  }
  .fr code {
    padding: 0.05em 0.35em;
    border-radius: 6px;
    background: var(--tonal);
    color: var(--text);
    font-family: ui-monospace, "Cascadia Mono", Consolas, monospace;
    font-size: 0.84em;
    font-weight: 400;
    white-space: nowrap;
  }
  /* The app, cropped: its top left corner opens level with the rows and it runs out by the
     card's right edge, under a soft shade that makes the cut a crop. Towards the card's foot
     it dissolves into the card's own surface (painted over it: no mask on the live window),
     so no line is sliced through. Drawn at the app's own size and scaled, so it is sharp at
     any size. */
  .dl-shot {
    --k: 0.78;
    position: relative;
    min-height: 26rem;
    margin: calc(var(--s6) + 4.75rem) calc(-1 * var(--panel-pad)) calc(-1 * var(--panel-pad)) 0;
    overflow: hidden;
  }
  .dl-shot::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(to left, light-dark(rgb(70 48 24 / 0.09), rgb(0 0 0 / 0.3)), transparent 2.5rem),
      linear-gradient(to top, var(--panel-bg) 0.25rem, transparent 5rem);
  }
  .dl-win {
    position: absolute;
    left: 1px;
    top: 1px;
    /* As tall as the card leaves it, and past its bottom edge (cut there). */
    width: 1280px;
    height: calc(100% / var(--k) + 48px);
    min-height: 720px;
    overflow: hidden;
    border-radius: 12px 0 0 0;
    container: app / size;
    transform: scale(var(--k));
    transform-origin: 0 0;
    box-shadow: 0 0 0 1px var(--edge);
  }
  .dl-foot {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: var(--s5);
    padding-inline: var(--panel-pad);
  }
  /* The page's last words in the hand: a step larger than the notes beside the sections,
     where the line has the room (on a phone the larger words wouldn't fit beside the link). */
  .sec-dl :global(.n-end) {
    position: static;
  }
  @media (width >= 761px) {
    .sec-dl :global(.n-end) {
      font-size: calc(var(--fs-pen) * 1.25);
    }
  }
  .linux-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--size-w) var(--get-w);
    align-items: center;
    column-gap: var(--s4);
    margin-top: var(--s5);
    padding: var(--panel-pad);
  }
  .linux-row .o-note {
    max-width: 70ch;
  }
  @media (width < 1600px) {
    .dl {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    }
    .dl-shot {
      --k: 0.66;
    }
  }
  @media (width < 1200px) {
    .dl {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
    .dl-shot {
      --k: 0.6;
      min-height: 20rem;
      margin: var(--s7) calc(-1 * var(--panel-pad)) calc(-1 * var(--panel-pad)) var(--s6);
    }
  }
  @media (width < 700px) {
    .sec-dl {
      --row-pad: var(--s4);
    }
    .dl-meta > span + span::before {
      content: none;
    }
    /* One column: the words, the button the full width, its size under it. */
    .dl-rows,
    .linux-row {
      grid-template-columns: minmax(0, 1fr);
    }
    .dl-row,
    .linux-row {
      row-gap: var(--s2);
    }
    .what {
      padding-right: 0;
      padding-bottom: var(--s2);
    }
    .get {
      grid-row: 2;
      justify-content: center;
    }
    .size {
      grid-row: 3;
      justify-self: center;
      font-size: var(--fs-small);
    }
    .dl-notes {
      grid-template-columns: minmax(0, 1fr);
    }
    .dl-shot {
      --k: 0.42;
      min-height: 14rem;
      margin-left: var(--s4);
    }
  }
  @media (width < 900px) {
    .dl-foot {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--s5);
    }
  }
</style>
