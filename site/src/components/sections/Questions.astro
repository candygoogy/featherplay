---
// Questions: the heading and the three groups' names on the left (sticky), one readable column
// of questions on the right. Native <details>; src/scripts/faq.ts eases them open and keeps
// the clicked question where it is. Answers: src/data/faq.ts.
import { faqGroups } from "../../data/faq";
import { repo } from "../../data/links";
---

<section class="sec sec-faq frame" id="questions" aria-labelledby="questions-title">
  <div class="faq-grid">
    <div class="faq-intro">
      <h2 id="questions-title" class="t-title">Questions</h2>
      <p class="t-lede ink2">Something else? <a class="text-link" href={`${repo}/issues`}>Ask on GitHub</a>.</p>
      <ol class="faq-index">
        {faqGroups.map((g) => <li><a href={`#${g.id}`}>{g.title}</a></li>)}
      </ol>
    </div>
    <div class="faq" data-faq>
      {
        faqGroups.map((g) => (
          <div class="faq-group" id={g.id}>
            <h3 class="t-subtitle">{g.title}</h3>
            {g.items.map((f) => (
              <details id={f.id}>
                <summary>
                  <span class="q">{f.q}</span>
                  <span class="pm" aria-hidden="true" />
                </summary>
                <div class="answer-wrap" data-answer>
                  <div class="answer">
                    {f.a.map((p) => (
                      <p>{p}</p>
                    ))}
                    {f.link && (
                      <p>
                        <a class="text-link" href={f.link.href}>
                          {f.link.text}
                        </a>
                      </p>
                    )}
                  </div>
                </div>
              </details>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { bindFaq } from "../../scripts/faq";
  const root = document.querySelector<HTMLElement>("[data-faq]");
  if (root) bindFaq(root);
</script>

<style>
  .faq-grid {
    --hair: color-mix(in srgb, var(--text) 11%, transparent);
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: var(--s7);
    align-items: start;
  }
  .faq-intro {
    position: sticky;
    top: var(--s9);
    display: grid;
    gap: var(--s4);
  }
  .faq-index {
    display: grid;
    gap: var(--s2);
    margin: var(--s4) 0 0;
    padding: 0;
    list-style: none;
  }
  .faq-index a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    color: var(--ink2);
    font-weight: var(--fw-medium);
    text-decoration: none;
    transition: color var(--t-hover) ease;
  }
  .faq-index a:hover {
    color: var(--text);
  }
  /* The browser's own scroll anchoring would move the clicked question (faq.ts). */
  .faq {
    max-width: 48rem;
    overflow-anchor: none;
  }
  .faq-group {
    scroll-margin-top: var(--s9);
  }
  .faq-group + .faq-group {
    margin-top: var(--s8);
  }
  .faq-group h3 {
    margin-bottom: var(--s4);
  }
  /* Square while shut (the lines between them run straight to the ends), rounded once open on
     its lighter fill. */
  details {
    margin-inline: calc(-1 * var(--s4));
    padding-inline: var(--s4);
    box-shadow: inset 0 1px 0 var(--hair);
    scroll-margin-top: var(--s9);
    transition:
      background-color var(--t-small) ease,
      box-shadow var(--t-small) ease;
  }
  details:last-child {
    box-shadow:
      inset 0 1px 0 var(--hair),
      inset 0 -1px 0 var(--hair);
  }
  /* The open answer on a lighter fill (a warm step of the paper in light). */
  details[open] {
    border-radius: var(--r-small);
    background: color-mix(in srgb, rgb(120 90 60 / 0.07) calc(var(--light) * 100%), rgb(255 255 255 / 0.06));
    box-shadow: none;
  }
  details[open] + details {
    box-shadow: none;
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s5);
    min-height: 56px;
    padding: var(--s3) 0;
    font-size: var(--fs-lede);
    font-weight: var(--fw-medium);
    letter-spacing: var(--tr-lede);
    line-height: 1.35;
    list-style: none;
    cursor: pointer;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  details[open]:not([data-closing]) summary {
    font-weight: var(--fw-bold);
  }
  summary:focus-visible {
    outline-offset: 2px;
    border-radius: var(--r-control);
  }
  /* Plus, turning to minus. */
  .pm {
    position: relative;
    flex: none;
    width: 14px;
    height: 14px;
    color: var(--ink2);
  }
  .pm::before,
  .pm::after {
    content: "";
    position: absolute;
    left: 0;
    top: 6px;
    width: 14px;
    height: 2px;
    border-radius: var(--r-pill);
    background: currentColor;
    transition: rotate var(--t-medium) var(--ease-out);
  }
  .pm::after {
    rotate: 90deg;
  }
  details[open]:not([data-closing]) .pm::after {
    rotate: 0deg;
  }
  .answer {
    display: grid;
    gap: var(--s3);
    max-width: 64ch;
    padding: 0 0 var(--s5);
    color: color-mix(in srgb, var(--text) 88%, transparent);
  }
  .answer p {
    text-wrap: pretty;
  }
  @media (prefers-reduced-motion: reduce) {
    .pm::before,
    .pm::after {
      transition: none;
    }
  }
  @media (width < 900px) {
    .faq-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s6);
    }
    .faq-intro {
      position: static;
    }
    .faq-index {
      display: flex;
      flex-wrap: wrap;
      gap: var(--s1) var(--s5);
    }
  }
</style>
