---
// Questions: the heading, the way to ask something else and the three groups' names on the left,
// held in view while the section is (the group being read marked); the questions on the right on
// one content panel, set for reading. Native <details> sharing one name: one answer open at a
// time; src/scripts/faq.ts eases the swap and keeps the clicked question where it is. Answers:
// src/data/faq.ts (its two marks: a paragraph's run-in, the name of a thing to look for).
import { faqGroups } from "../../data/faq";
import { repo } from "../../data/links";

/** A paragraph's text in pieces: plain, the run-in (`**…**`), a name (`*…*`). */
const pieces = (p: string) =>
  p
    .split(/(\*\*[^*]+\*\*|\*[^*]+\*)/)
    .filter(Boolean)
    .map((t) => (t.startsWith("**") ? { kind: "lead", t: t.slice(2, -2) } : t.startsWith("*") ? { kind: "name", t: t.slice(1, -1) } : { kind: "text", t }));
---

<section class="sec sec-faq frame" id="questions" aria-labelledby="questions-title">
  <div class="faq-grid">
    <div class="faq-intro">
      <h2 id="questions-title" class="t-title">Questions</h2>
      <p class="ask">Something else? <a class="text-link" href={`${repo}/issues`}>Ask on GitHub</a>.</p>
      <nav aria-label="Question groups">
        <ol class="faq-index" data-faq-index>
          {
            faqGroups.map((g) => (
              <li>
                <a href={`#${g.id}`} data-count={g.items.length}>
                  {g.title}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </div>
    <div class="faq panel" data-faq>
      {
        faqGroups.map((g) => (
          <div class="faq-group" id={g.id}>
            <h3 class="g-title">{g.title}</h3>
            {g.items.map((f) => (
              <details name="faq" id={f.id}>
                <summary>
                  <span class="q">{f.q}</span>
                  <span class="pm" aria-hidden="true" />
                </summary>
                <div class="answer-wrap" data-answer>
                  <div class="answer">
                    {f.a.map((p) => (
                      <p>
                        {pieces(p).map((x) => (x.kind === "lead" ? <strong class="lead">{x.t}</strong> : x.kind === "name" ? <span class="name">{x.t}</span> : x.t))}
                      </p>
                    ))}
                    {f.link && (
                      <p class="more">
                        <a class="text-link" href={f.link.href}>
                          {f.link.text}
                        </a>
                      </p>
                    )}
                  </div>
                </div>
              </details>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { bindFaq } from "../../scripts/faq";
  const root = document.querySelector<HTMLElement>("[data-faq]");
  if (root) bindFaq(root);
</script>

<style>
  .faq-grid {
    --hair: color-mix(in srgb, var(--text) 10%, transparent);
    --row-x: var(--s4);
    display: grid;
    /* The heading and the index need little room: a quarter of the width (never under 16 rem),
       the rest the questions'. */
    grid-template-columns: minmax(16rem, 3fr) minmax(0, 9fr);
    gap: var(--s7);
    align-items: start;
  }
  /* Held in view while the section is, under the capsule; its heading level with the list's
     first group. */
  .faq-intro {
    position: sticky;
    top: calc(var(--bar-h, 64px) + var(--s6));
    display: grid;
    gap: var(--s3);
    padding-top: var(--panel-pad);
  }
  .ask {
    color: var(--ink2);
    font-size: var(--fs-lede);
    letter-spacing: var(--tr-lede);
  }
  .faq-index {
    display: grid;
    gap: 2px;
    margin: var(--s5) 0 0;
    padding: 0;
    list-style: none;
  }
  .faq-index a {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 40px;
    padding-left: var(--s4);
    color: var(--ink2);
    font-weight: var(--fw-medium);
    text-decoration: none;
    transition: color var(--t-hover) ease;
  }
  /* The group being read: its name in the text's ink and a short bar beside it. */
  .faq-index a::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    width: 3px;
    height: 0;
    border-radius: var(--r-pill);
    background: var(--accent);
    translate: 0 -50%;
    transition: height var(--t-small) var(--ease-out);
  }
  .faq-index a[aria-current="true"] {
    color: var(--text);
  }
  /* How many questions the group holds, quiet beside its name (drawn, not said: the link is
     the group's name). */
  .faq-index a::after {
    content: attr(data-count) / "";
    margin-left: var(--s2);
    font-variant-numeric: tabular-nums;
    color: var(--ink3);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
  }
  .faq-index a[aria-current="true"]::before {
    height: 1.25rem;
  }
  .faq-index a:hover {
    color: var(--text);
  }
  /* The list on the content panel. The browser's own scroll anchoring would scroll the page as an
     answer closes (faq.ts). */
  .faq {
    padding: var(--panel-pad) calc(var(--panel-pad) - var(--row-x)) calc(var(--panel-pad) - var(--s3));
    overflow-anchor: none;
  }
  .faq-group {
    scroll-margin-top: calc(var(--bar-h, 64px) + var(--s6));
  }
  .faq-group + .faq-group {
    margin-top: var(--s7);
  }
  .g-title {
    margin: 0 var(--row-x) var(--s3);
    color: var(--ink2);
    font-size: var(--fs-text);
    font-weight: var(--fw-bold);
    letter-spacing: 0.01em;
  }
  /* Rows: a hairline between them, inset to the words; the open one lifted on a clean, lighter
     fill with a soft edge (no line next to it). */
  details {
    position: relative;
    border-radius: 14px;
    scroll-margin-top: calc(var(--bar-h, 64px) + var(--s6));
    transition:
      background-color var(--t-small) ease,
      box-shadow var(--t-small) ease;
  }
  details + details::before {
    content: "";
    position: absolute;
    inset: 0 var(--row-x) auto;
    height: 1px;
    background: var(--hair);
    transition: opacity var(--t-small) ease;
  }
  details[open]:not([data-closing]) {
    background: light-dark(rgb(255 255 255 / 0.92), rgb(255 255 255 / 0.06));
    box-shadow:
      0 0 0 1px light-dark(rgb(90 66 40 / 0.08), rgb(255 255 255 / 0.07)),
      0 1px 2px light-dark(rgb(70 48 24 / 0.05), rgb(0 0 0 / 0)),
      0 6px 20px light-dark(rgb(70 48 24 / 0.06), rgb(0 0 0 / 0));
  }
  details[open]:not([data-closing])::before,
  details[open]:not([data-closing]) + details::before {
    opacity: 0;
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s5);
    min-height: 60px;
    padding: var(--s3) var(--row-x);
    border-radius: 14px;
    font-size: var(--fs-lede);
    font-weight: var(--fw-medium);
    letter-spacing: var(--tr-lede);
    line-height: 1.35;
    list-style: none;
    cursor: pointer;
    transition: background-color var(--t-hover) ease;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  @media (hover: hover) {
    details:not([open]) summary:hover {
      background: var(--part-hover);
    }
    summary:hover .pm {
      color: var(--text);
    }
  }
  details[open]:not([data-closing]) summary {
    font-weight: var(--fw-bold);
  }
  summary:focus-visible {
    outline-offset: -2px;
  }
  /* Plus, turning to minus: the upright bar turns flat, 180 ms. */
  .pm {
    position: relative;
    flex: none;
    width: 14px;
    height: 14px;
    color: var(--ink2);
    transition: color var(--t-hover) ease;
  }
  .pm::before,
  .pm::after {
    content: "";
    position: absolute;
    left: 0;
    top: 6px;
    width: 14px;
    height: 2px;
    border-radius: var(--r-pill);
    background: currentColor;
    transition: rotate 180ms var(--ease-out);
  }
  .pm::after {
    rotate: 90deg;
  }
  details[open]:not([data-closing]) .pm::after {
    rotate: 0deg;
  }
  /* Set for reading: about 68 characters a line (the open card's width, not half of it), open
     leading, clear space between paragraphs; the first paragraph, the short answer, in the full
     ink. */
  .answer {
    display: grid;
    gap: var(--s4);
    max-width: 68ch;
    padding: var(--s1) var(--row-x) var(--s6);
    color: color-mix(in srgb, var(--text) 84%, transparent);
    line-height: 1.68;
  }
  .answer p {
    text-wrap: pretty;
  }
  .answer p:first-child {
    color: var(--text);
  }
  .answer .lead {
    color: var(--text);
    font-weight: var(--fw-bold);
  }
  .answer .name {
    color: var(--text);
    font-weight: var(--fw-medium);
  }
  @media (prefers-reduced-motion: reduce) {
    .pm::before,
    .pm::after {
      transition: none;
    }
  }
  /* Forced colours paint over backgrounds: the plus and the index's bar keep the system's inks. */
  @media (forced-colors: active) {
    .pm,
    .faq-index a::before {
      forced-color-adjust: none;
    }
    .pm {
      color: CanvasText;
    }
    .faq-index a::before {
      background: Highlight;
    }
  }
  @media (width < 900px) {
    .faq-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s5);
    }
    .faq-intro {
      position: static;
      padding-top: 0;
    }
    .faq-index {
      display: flex;
      flex-wrap: wrap;
      gap: var(--s1) var(--s5);
      margin-top: var(--s2);
    }
    .faq-index a {
      padding-left: 0;
    }
    .faq-index a::before {
      display: none;
    }
    .faq {
      --row-x: var(--s3);
    }
  }
</style>
