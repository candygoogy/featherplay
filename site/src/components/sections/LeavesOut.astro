---
// What featherplay leaves out: two folders as Explorer shows them, two solid windows on the
// desk: Pear Desktop 3.12 installed, every entry tied to what it's there for, and featherplay's
// one portable exe. Under the exe the two installed sizes drawn to scale, like with like, and
// four plain notes on what isn't there. Pointing at a note (or focusing, or tapping it) lights
// its files in Pear's folder; the first is lit to begin with, so the idea shows itself. Facts:
// src/data/numbers.ts.
import { installFolders, leftOutTotals, type FolderEntry, type LeftOut } from "../../data/numbers";
import { formatBytes } from "../../data/format";
import { release, sizeLabel } from "../../data/release";

const { pear, featherplay } = installFolders;
// Explorer's own size column: kilobytes, rounded up, with thousands separators.
const kb = (b: number) => `${Math.ceil(b / 1024).toLocaleString("en-GB")} KB`;
const mb = (b: number) => formatBytes(b).replace(" ", " ");
const filesOf = (g: LeftOut) => {
  const list = pear.entries.filter((e) => e.group === g).sort((a, b) => b.bytes - a.bytes);
  const named = list.slice(0, 2).map((e) => (e.files ? `${e.name} folder` : e.name));
  const more = list.length - named.length;
  return `${named.join(", ")}${more ? ` and ${more} more` : ""}`;
};
// A group’s share of Pear’s folder, the length of its card’s bar.
const shareOf = (g: LeftOut) => `${((leftOutTotals(g).bytes / pear.bytes) * 100).toFixed(2)}%`;
const notes: { word: string; why: string; group?: LeftOut }[] = [
  {
    word: "Chromium",
    group: "chromium",
    why: "No browser engine in the window. Signing in uses Windows’ own WebView2 once, or your own browser, which you close when you’re in.",
  },
  { word: "Electron", group: "electron", why: "One native program, written in Rust and drawn with Slint, instead of a web app in a frame." },
  { word: "Video", group: "video", why: "It never plays video. A music video with a song version plays as the song." },
  { word: "Telemetry", why: "No analytics and no tracking, and no server of its own." },
];
// A file's type, for its icon: a folder, an app, a library, data or text.
const kind = (e: FolderEntry) =>
  e.files ? "folder" : /\.exe$/.test(e.name) ? "app" : /\.dll$/.test(e.name) ? "dll" : /\.(txt|html|json)$/.test(e.name) ? "text" : "data";
const installedBytes = featherplay.bytes + featherplay.installed.uninstallerBytes + featherplay.installed.runtimeBytes;
// The two installed folders to scale: Pear's bar is the whole length, featherplay's its share.
const installedShare = `${((installedBytes / pear.bytes) * 100).toFixed(2)}%`;
const exeLabel = release.portable ? sizeLabel(release.portable).replace(" ", " ") : mb(featherplay.bytes);
import Note from "../Note.astro";
---

<section class="sec sec-leaves frame" id="leaves" aria-labelledby="leaves-title" data-out data-lit="" data-bar-sec="light">
  <svg class="sprite" aria-hidden="true">
    <symbol id="g-folder" viewBox="0 0 16 16"><path d="M1.5 4a1 1 0 0 1 1-1h3.2l1.3 1.4h6.5a1 1 0 0 1 1 1V12a1 1 0 0 1-1 1h-11a1 1 0 0 1-1-1Z" fill="var(--folder)"></path></symbol>
    <symbol id="g-app" viewBox="0 0 16 16"><rect x="2" y="3" width="12" height="10" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.2"></rect><path d="M2 5.6h12" stroke="currentColor" stroke-width="1.2"></path></symbol>
    <symbol id="g-dll" viewBox="0 0 16 16"><path d="M4 1.8h5.2L12.5 5v9.2H4Z" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"></path><circle cx="8.2" cy="9.6" r="1.6" fill="none" stroke="currentColor" stroke-width="1.1"></circle></symbol>
    <symbol id="g-data" viewBox="0 0 16 16"><path d="M4 1.8h5.2L12.5 5v9.2H4Z" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"></path><path d="M6 8.5h4.5M6 11h4.5" stroke="currentColor" stroke-width="1.1"></path></symbol>
    <symbol id="g-text" viewBox="0 0 16 16"><path d="M4 1.8h5.2L12.5 5v9.2H4Z" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"></path><path d="M6 7.5h4.5M6 9.6h4.5M6 11.7h3" stroke="currentColor" stroke-width="1"></path></symbol>
  </svg>
  <div class="sec-head">
    <h2 id="leaves-title" class="t-title">What featherplay leaves out</h2>
    <p class="t-lede ink2">
      Two folders as Explorer shows them: Pear Desktop 3.12 installed, and featherplay’s portable exe. Installed, featherplay adds only
      its uninstaller and the Visual&nbsp;C++ runtime.
    </p>
  </div>
  <div class="desk">
    <div class="pair">
    <figure class="explorer pear" aria-labelledby="pear-folder">
      <div class="ex-bar" aria-hidden="true">
        <svg viewBox="0 0 16 16" width="16" height="16"><use href="#g-folder"></use></svg><span>youtube-music</span>
      </div>
      <figcaption class="crumbs" id="pear-folder">
        <span class="visually-hidden">Pear Desktop’s install folder:</span>
        {pear.path.map((p, i) => <span class:list={["crumb", { here: i === pear.path.length - 1 }]}>{p}</span>)}
      </figcaption>
      <div class="cols" aria-hidden="true"><span>Name</span><span>Size</span></div>
      <ul class="files">
        {
          pear.entries.map((e) => (
            <li data-kind={kind(e)} data-group={e.group}>
              <svg class="glyph" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                <use href={`#g-${kind(e)}`} />
              </svg>
              <span class="fname">{e.name}</span>
              <span class="fsize">{e.files ? `${e.files} files` : kb(e.bytes)}</span>
            </li>
          ))
        }
      </ul>
      <p class="status"><strong>{pear.files} files</strong>, {mb(pear.bytes)}</p>
    </figure>
    <div class="side">
      <div class="ours-hold">
      <Note id="onefile" arrow="right" class="n-onefile" />
      <figure class="explorer ours" aria-labelledby="fp-folder">
        <div class="ex-bar" aria-hidden="true">
          <svg viewBox="0 0 16 16" width="16" height="16"><use href="#g-folder"></use></svg><span>Downloads</span>
        </div>
        <figcaption class="crumbs" id="fp-folder">
          <span class="visually-hidden">featherplay’s folder:</span>
          {featherplay.path.map((p) => <span class="crumb here">{p}</span>)}
        </figcaption>
        <div class="cols" aria-hidden="true"><span>Name</span><span>Size</span></div>
        <ul class="files">
          {
            featherplay.entries.map((e) => (
              <li data-kind="app">
                <span class="art glyph" aria-hidden="true">
                  <img class="only-dark" src="/tri-vane.svg" width="16" height="16" alt="" />
                  <img class="only-light" src="/tri-vane-light.svg" width="16" height="16" alt="" />
                </span>
                <span class="fname">{e.name}</span>
                <span class="fsize">{kb(e.bytes)}</span>
              </li>
            ))
          }
        </ul>
        <p class="status"><strong>{featherplay.files} file</strong>, {exeLabel}</p>
      </figure>
      </div>
      <figure class="weigh" data-weigh aria-labelledby="weigh-h">
        <p class="weigh-h" id="weigh-h">Installed</p>
        <p class="scale-row ours-row" data-scale="featherplay">
          <span class="who">featherplay</span><span class="fig">about {Math.round(installedBytes / 1_048_576)}&nbsp;MB</span>
          <svg class="bar" aria-hidden="true"><rect class="track" width="100%" height="100%" rx="3"></rect><rect class="fill" width={installedShare} height="100%" rx="3"></rect></svg>
        </p>
        <p class="scale-row pear-row" data-scale="pear">
          <span class="who">Pear Desktop</span><span class="fig">{mb(pear.bytes)}</span>
          <svg class="bar" aria-hidden="true"><rect class="track" width="100%" height="100%" rx="3"></rect><rect class="fill" width="100%" height="100%" rx="3"></rect></svg>
        </p>
        <figcaption>
          The exe, its uninstaller (about {mb(featherplay.installed.uninstallerBytes)}) and the Visual&nbsp;C++ runtime (about {
            mb(featherplay.installed.runtimeBytes)
          }): {Math.round(pear.bytes / installedBytes)} times smaller than Pear Desktop installed.
        </figcaption>
      </figure>
    </div>
    </div>
    <div class="outs">
        <div class="outs-head">
          <h3 class="outs-h">Not in featherplay’s folder</h3>
          <p class="hint">
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"
              ><path d="M4.5 2.5v9l2.4-2.2 1.6 3.6 1.6-.7-1.6-3.5h3.2Z" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"
              ></path></svg
            ><span>Choose one to see its files in Pear’s folder.</span>
          </p>
        </div>
        <ul data-leaves-out>
          {
            notes.map((n) =>
              n.group ? (
                <li class="out out-card" data-note-for={n.group}>
                    <span class="card-top">
                      <span class="note-name">{n.word}</span>
                      <span class="pick" aria-hidden="true" />
                    </span>
                    <p class="why" id={`out-${n.group}-why`}>{n.why}</p>
                    <p class="which" id={`out-${n.group}-which`}>
                      {filesOf(n.group)}: <span class="of"><strong class="num">{mb(leftOutTotals(n.group).bytes)}</strong> of Pear’s folder</span>
                    </p>
                    <svg class="share" aria-hidden="true">
                      <rect class="track" width="100%" height="100%" rx="2" />
                      <rect class="fill" width={shareOf(n.group)} height="100%" rx="2" />
                    </svg>
                </li>
              ) : (
                <li class="out-last">
                  <span class="note-name">{n.word}</span>
                  <p class="why">{n.why}</p>
                </li>
              ),
            )
          }
        </ul>
    </div>
  </div>
  <p class="source-line t-small ink2">Listed on the measuring PC on 1 November 2026, sizes as Explorer shows them.</p>
</section>

<script>
  // Each card lights its files in Pear's folder, and its share of the folder on its own bar:
  // while pointed at (a mouse or a pen) or focused, for a look; pressed (clicked, tapped, Enter
  // or Space), it stays chosen until another is. The section names the group lit (data-lit);
  // CSS does the rest. Without script the cards are plain notes to read and every file shows
  // alike: they become buttons here.
  const out = document.querySelector<HTMLElement>("[data-out]");
  if (out) {
    // Each card's word and pick become its button, which covers the whole card (CSS): named by
    // the word, described by its sentence and its files.
    const cards = [...out.querySelectorAll<HTMLElement>("[data-note-for]")].map((card) => {
      const g = card.dataset.noteFor!;
      const top = card.querySelector<HTMLElement>(".card-top")!;
      const b = document.createElement("button");
      // Every attribute (the class, the styles' scope).
      for (const a of top.attributes) b.setAttribute(a.name, a.value);
      b.type = "button";
      b.dataset.group = g;
      b.setAttribute("aria-describedby", `out-${g}-why out-${g}-which`);
      b.setAttribute("aria-pressed", String(g === "chromium"));
      b.append(...top.childNodes);
      top.replaceWith(b);
      card.classList.add("live");
      return b;
    });
    out.dataset.lit = "chromium";
    const pressed = () => cards.find((n) => n.getAttribute("aria-pressed") === "true")?.dataset.group ?? "";
    const light = (g: string) => (out.dataset.lit = g);
    for (const n of cards) {
      const g = n.dataset.group!;
      // A finger's touch is a press, not a look (its leave comes before its click).
      n.addEventListener("pointerenter", (e) => e.pointerType !== "touch" && light(g));
      n.addEventListener("pointerleave", (e) => e.pointerType !== "touch" && light(pressed()));
      n.addEventListener("focus", () => light(g));
      n.addEventListener("blur", () => light(pressed()));
      n.addEventListener("click", () => {
        for (const o of cards) o.setAttribute("aria-pressed", String(o === n));
        light(g);
      });
    }
  }
</script>

<style>
  /* What wears the song's colour here fades to the next one itself (system.css --paint). */
  .explorer,
  .ex-bar,
  .files li {
    --paint: var(--song);
    transition: --paint var(--t-glow) ease;
  }
  .sprite {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }
  /* The pair: Pear's tall folder and featherplay's one file, with air round it (the difference in
     their sizes is the point); under both, the four things left out, each with room. */
  .desk {
    display: grid;
    gap: var(--s8);
    margin-top: var(--s7);
  }
  /* The two folders start on one line; featherplay's one file stays in view beside Pear's long
     list as it scrolls past (sticky under the capsule, within the pair), its note and the
     weighed sizes with it. */
  .pair {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    grid-template-areas: "pear ours";
    align-items: start;
    gap: var(--s8);
  }
  .pear {
    grid-area: pear;
  }
  /* featherplay's half: its window and the two sizes to scale under it, one column on the
     frame's right edge, with open desk between it and Pear's window (where the note sits). Its
     window's title bar is level with Pear's; it stays in view while the list scrolls by and
     comes to rest with its last line level with Pear's last. */
  .side {
    --side-w: min(100%, max(26rem, 60%));
    grid-area: ours;
    position: sticky;
    top: calc(var(--cap-top) + var(--cap-h) + var(--s5));
    display: grid;
    justify-items: end;
    gap: var(--s6);
  }
  .ours-hold {
    position: relative;
    width: var(--side-w);
  }
  /* An app window: solid, as windows on Windows are, a faint tint of the song. */
  .explorer {
    overflow: hidden;
    border-radius: var(--r-small);
    background: color-mix(in srgb, var(--paint) 4%, var(--surface));
    box-shadow: var(--lit), var(--ring), var(--shadow);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
  }
  /* In the open desk left of featherplay's window, pointing across at its one file: the arrow's
     head (Note.astro's "right") ends just inside the window, level with the file's row (the
     window's bar, path and column heads above it are 36 + 46 + 30 px, the row 28). */
  .side :global(.n-onefile) {
    right: calc(100% - 1.25rem);
    top: calc(129px - 1.4em);
  }
  .ex-bar {
    display: flex;
    align-items: center;
    gap: var(--s2);
    height: 36px;
    padding-left: var(--s4);
    background: color-mix(in srgb, var(--paint) 6%, var(--panel-tint));
  }
  .crumbs {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: var(--s2) var(--s3) 6px;
    padding: 6px var(--s3);
    border-radius: var(--r-control);
    background: var(--panel-tint);
    color: var(--ink2);
  }
  .crumb::before {
    content: "›";
    margin-right: 6px;
  }
  .crumb.here {
    color: var(--text);
    font-weight: var(--fw-bold);
  }
  .cols {
    display: flex;
    justify-content: space-between;
    padding: 6px 28px var(--s1) 46px;
    color: var(--ink2);
  }
  .files {
    display: grid;
    margin: 0;
    padding: 0 var(--s3);
    list-style: none;
  }
  .files li {
    display: grid;
    grid-template-columns: 16px minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--s3);
    min-height: 28px;
    padding: 0 var(--s4) 0 var(--s3);
    border-radius: var(--r-control);
    transition:
      background-color var(--t-hover) ease,
      color var(--t-hover) ease;
  }
  .files li:nth-child(odd) {
    background: color-mix(in srgb, var(--panel-tint) 60%, transparent);
  }
  .glyph {
    color: var(--ink2);
  }
  .fname {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .fsize {
    color: var(--ink2);
    font-variant-numeric: tabular-nums;
  }
  .status {
    padding: var(--s3) 28px var(--s4);
    color: var(--ink2);
  }
  .status strong {
    color: var(--text);
  }
  .explorer.ours .files li {
    background: color-mix(in srgb, var(--paint) 18%, transparent);
    font-weight: var(--fw-bold);
  }
  /* Its status bar carries the point: one file, at the size of a lede, its count in full ink. */
  .explorer.ours .status {
    padding-block: var(--s4) var(--s5);
    font-size: var(--fs-lede);
    line-height: var(--lh-subtitle);
    letter-spacing: var(--tr-lede);
  }
  .explorer.ours .status strong {
    font-size: var(--fs-subtitle);
    letter-spacing: var(--tr-subtitle);
  }

  /* The two installed sizes to scale: a name and its figure over a bar whose length is that
     size against Pear's (the whole bar). featherplay's in the playing song's colour, Pear's in
     quiet ink, both on a faint track; then the caption. */
  .weigh {
    display: grid;
    gap: var(--s3);
    width: var(--side-w);
    margin: 0;
    padding-inline: var(--s1);
  }
  .weigh-h {
    color: var(--ink2);
    font-size: var(--fs-small);
    font-weight: var(--fw-bold);
    line-height: var(--lh-small);
  }
  .scale-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    row-gap: 6px;
    font-weight: var(--fw-medium);
  }
  .who {
    color: var(--ink2);
  }
  .fig {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .ours-row .who,
  .ours-row .fig {
    color: var(--text);
    font-weight: var(--fw-bold);
  }
  .bar {
    grid-column: 1 / -1;
    display: block;
    width: 100%;
    height: 6px;
    overflow: visible;
  }
  .bar .track {
    fill: var(--panel-tint);
  }
  .pear-row .fill {
    fill: color-mix(in srgb, var(--text) 30%, transparent);
  }
  .ours-row .fill {
    --paint: var(--song);
    transition: --paint var(--t-glow) ease;
    fill: light-dark(color-mix(in oklab, var(--paint) 86%, black), var(--paint));
  }
  .weigh figcaption {
    margin-top: var(--s2);
    padding-top: var(--s3);
    border-top: 1px solid var(--hairline);
    color: var(--ink2);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    line-height: var(--lh-small);
    text-wrap: pretty;
  }
  @media (forced-colors: active) {
    .bar .track {
      fill: Canvas;
      stroke: CanvasText;
    }
    .bar .fill {
      fill: CanvasText;
    }
  }
  .outs-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s2) var(--s5);
  }
  .outs-h {
    font-size: var(--fs-subtitle);
    font-weight: var(--fw-bold);
    letter-spacing: var(--tr-subtitle);
    line-height: var(--lh-subtitle);
  }
  /* The invitation, easy to see: a pointer and the text's own size. */
  .hint {
    display: inline-flex;
    align-items: center;
    gap: var(--s2);
    padding: 0.25rem 0.75rem 0.25rem 0.6rem;
    border-radius: var(--r-pill);
    background: var(--tonal);
    color: var(--text);
    font-weight: var(--fw-medium);
  }
  /* Without script nothing answers a point or a tap. */
  :global(:root:not(.js)) .hint {
    display: none;
  }
  /* (A mouse pointer says nothing to a finger.) */
  @media (hover: none) {
    .hint svg {
      display: none;
    }
  }
  /* The three things that are files: three cards, side by side under both folders. Without
     script they are plain notes; with it, controls (.out-card.live below). Then telemetry, which
     is no file, on a line of its own: a closing statement, not a fourth card. */
  .outs ul {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s4);
    margin: var(--s5) 0 0;
    padding: 0;
    list-style: none;
  }
  .out {
    display: grid;
  }
  .out-card {
    --paint: var(--song);
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: var(--s2);
    min-width: 0;
    margin: 0;
    padding: var(--s5) var(--s5) var(--s5);
    border: 0;
    border-radius: var(--r-panel);
    background: transparent;
    color: var(--text);
    font: inherit;
    text-align: start;
    transition: --paint var(--t-glow) ease;
  }
  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s3);
  }
  .note-name {
    font-size: var(--fs-lede);
    font-weight: var(--fw-bold);
    letter-spacing: var(--tr-lede);
    line-height: var(--lh-subtitle);
  }
  .why {
    display: block;
    text-wrap: pretty;
  }
  .which {
    display: block;
    align-self: end;
    margin-top: var(--s3);
    color: var(--ink2);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    line-height: var(--lh-small);
    text-wrap: pretty;
  }
  .which .of {
    white-space: nowrap;
  }
  .which strong {
    color: var(--text);
    font-weight: var(--fw-bold);
  }
  /* The group's share of Pear's folder: the whole bar is the folder (396 MB). */
  .share {
    display: block;
    width: 100%;
    height: 4px;
    margin-top: var(--s1);
    overflow: visible;
  }
  .share .track {
    fill: var(--panel-tint);
  }
  .share .fill {
    --paint: var(--song);
    fill: color-mix(in srgb, var(--text) 30%, transparent);
    transition:
      fill var(--t-hover) ease,
      --paint var(--t-glow) ease;
  }
  /* Without script, plain notes: their words on the section’s edge, like telemetry’s. */
  .out-card:not(.live) {
    padding-inline: 0;
  }
  :global(:root:not(.js)) .outs ul {
    column-gap: var(--s7);
  }
  /* The pick (with script): an empty ring at rest, a dot in it once chosen, as a radio has. */
  .pick {
    display: none;
  }

  /* ---- With script: real controls, on the windows' own solid material ---- */
  .out-card.live {
    position: relative;
    background: color-mix(in srgb, var(--paint) 4%, var(--surface));
    box-shadow:
      var(--lit),
      var(--ring),
      0 1px 2px var(--shade-1),
      0 6px 18px -10px var(--shade-2);
    cursor: pointer;
    transition:
      background-color var(--t-hover) ease,
