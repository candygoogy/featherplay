---
// The Tri-vane, in the drawing for the ground it sits on (decorative: callers name it).
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: className = "" } = Astro.props;
---

<span class:list={["logo", "art", className]} style={`--logo:${size}px`} aria-hidden="true">
  <img class="only-dark" src="/tri-vane.svg" width={size} height={size} alt="" />
  <img class="only-light" src="/tri-vane-light.svg" width={size} height={size} alt="" />
</span>

<style>
  .logo {
    display: inline-grid;
    width: var(--logo);
    height: var(--logo);
    flex: none;
  }
  .logo img {
    width: 100%;
    height: 100%;
  }
</style>
