---
// The app's playing mark (parts.slint, PlayingMark): a short wave in one accent stroke, at
// rest a still, middling wave. The path runs two wavelengths past each end, so it can travel
// one wavelength and loop (app-controls.css).
interface Props {
  size?: number;
  class?: string;
}
const { size = 18, class: className } = Astro.props;
const span = size * 0.76;
const wavelength = span / 1.5;
const amp = size * 0.32 * 0.6;
const mid = size / 2;
const pts: string[] = [];
for (let x = -2 * wavelength; x <= size + 2 * wavelength; x += 1) {
  // The app's still wave sits 0.15 of a cycle along.
  const y = mid - amp * Math.sin(((x - size * 0.12) / wavelength - 0.15 * 1.5) * 2 * Math.PI);
  pts.push(`${x.toFixed(1)} ${y.toFixed(1)}`);
}
const d = `M ${pts.join(" L ")}`;
---

<svg
  class:list={["fp-mark", className]}
  viewBox={`0 0 ${size} ${size}`}
  width={size}
  height={size}
  aria-hidden="true"
  style={`--wavelength:${wavelength.toFixed(2)}px`}
  ><g class="swell"><g class="travel"><path d={d}></path></g></g></svg
>
