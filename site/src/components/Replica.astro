---
// A working copy of featherplay's window, laid out at the app's own sizes (theme.slint) on a
// 1440x900 desktop, with the app's controls, states and motion (parts.slint, bottom_bar.slint,
// pages/now_playing.slint, sidebar.slint). Rendered here in the state given (so without
// script it's a still frame of the app), then bound to the shared player store by
// src/demo/replica.ts.
import "../styles/app-controls.css";
import "../styles/replica.css";
import "../styles/fields.css";
import Icon from "./Icon.astro";
import Mark from "./Mark.astro";
import { demoStart, songs, type Song } from "../data/songs";
import { albumLine, currentLineIndex, formatTime, lyricsSource, type View } from "../demo/player";

interface Props {
  songId?: string;
  positionMs?: number;
  view?: View;
  /** Keep to `view`, whatever the page's player shows (a window that is a picture: the download card's). */
  pin?: boolean;
  id?: string;
  /** Its Now playing region's name: each replica's own, so the page's landmarks differ. */
  nowLabel?: string;
}
const { songId = demoStart.songId, positionMs = demoStart.positionMs, view = "lyrics", pin = false, id = "replica", nowLabel = "Now playing" } = Astro.props;
const song: Song = songs.find((s) => s.id === songId) ?? songs[0];
const current = currentLineIndex(song, positionMs);
const lineState = (i: number) => (i < current ? "past" : i === current ? "current" : "next");
const fraction = positionMs / song.durationMs;
const isNow = view === "now" || view === "lyrics";
// A window kept to Now playing (the download card's) never shows the browse pages, the sidebar or
// a list of lines: those are left out of it (their places stay, empty, for the script), so the
// page carries the app's whole markup once less.
const lite = pin && isNow;
// (Every copy is data-nosnippet: the demo's lyrics and lists are no search result's summary.)
const hasLyrics = song.lyrics.length > 0;
// Up next: the song playing pinned at the top, then the demo's songs after it.
const at = songs.indexOf(song);
// The side panel's Lyrics tab, there unless the full lyrics view shows the lines.
const lyricsTab = !(view === "lyrics" && hasLyrics);
const resume = song;
// Home's card: what's next in the queue (the demo's list after the song).
const next: Song | undefined = songs[at + 1];
const summaryId = `${id}-summary`;
// Where the lines sit without script, by the app's rule (src/demo/follow.ts followOffset): the
// current line's centre a third of the way down the panel, between the top and the list's
// end. A line is a sixth of its 24 px type above and below plus 32.8 px a row of words, a
// long one wraps to two rows in the 688 px column beside the side panel (about 11.2 px a
// character of the bold face), lines are 24 * 0.18 px apart with no extra room between
// verses, and the credit under them takes 24 + 19 (replica.css, as the app's lyrics.slint).
// The panel's height is left to CSS (cqh, the .lyrics box is a size container), so the phone
// layout's shorter panel is right too; the script measures it all exactly once it runs.
const LYRIC = 24;
const lineH = (i: number) => (2 * LYRIC) / 6 + 32.8 * Math.max(1, Math.ceil((song.lyrics[i].line.length * 11.2) / 688));
const GAP = LYRIC * 0.18;
const PAD_TOP = 24;
const lineTop = (i: number) => PAD_TOP + Array.from({ length: i }, (_, j) => lineH(j) + GAP).reduce((a, b) => a + b, 0);
const n = song.lyrics.length;
// The list above its bottom padding (half the panel): the lines, then the credit.
const listTop = n ? lineTop(n - 1) + lineH(n - 1) + GAP + 24 + 19 : PAD_TOP;
const centre = current >= 0 ? lineTop(current) + lineH(current) / 2 : 0;
// clamp(0, centre - view / 3, list - view / 2): a max under the min resolves to 0, as the app's.
const linesY = current < 0 ? "0px" : `clamp(0px, ${centre}px - 100cqh / 3, ${listTop}px - 50cqh)`;

// The sidebar's library, under its three chips (made-up playlists of the demo's songs).
const playlists: [string, Song][] = [
  ["Night drives", songs[0]],
  ["Kitchen radio", songs[1]],
  ["Coast road", songs[4]],
  ["Sunday, slowly", songs[3]],
];
// Home's Shortcuts after Liked songs: the playlists, then albums and singles.
const shortcuts = [
  ...playlists.map(([name, s]) => ({ id: s.id, title: name, line: "Playlist · made for the demo", cover: s.cover })),
  ...songs.slice(0, 5).map((s) => ({ id: s.id, title: s.album?.title ?? s.title, line: s.album ? `Album · ${s.artist}` : `Single · ${s.artist}`, cover: s.cover })),
];
const pages: { page: View; icon: "home" | "library" | "explore" | "history"; label: string }[] = [
  { page: "home", icon: "home", label: "Home" },
  { page: "library", icon: "library", label: "Library" },
  { page: "explore", icon: "explore", label: "Explore" },
  { page: "history", icon: "history", label: "History" },
];
---

<div
  data-nosnippet
  class="replica"
  id={id}
  inert
  data-replica
  data-view={view}
  data-pin-view={pin ? view : undefined}
  data-playing="false"
  data-lyrics-on="true"
  data-has-lyrics={String(hasLyrics)}
  data-queue-open="false"
  data-side-open="true"
  data-queue-tab="next"
  data-lyrics-tab={String(lyricsTab)}
  data-song={song.id}
  data-at={positionMs}
  role="group"
  aria-label="featherplay demo"
  aria-describedby={summaryId}
  style={`--song:${song.colour}`}
>
  <p class="visually-hidden" id={summaryId}>
    A working demo of featherplay's window, playing short clips of six songs under free licences. You can play and pause, skip, like a
    song or mark it not for you, open the lyrics and click a line to jump to it, scroll the lyrics, search, browse the
    sidebar's pages, open Up next, Related and the lyrics beside the song, clear Up next, and minimise the window to the tray.
  </p>

  <!-- featherplay's own title bar (top_bar.slint): one 48 px row over the sidebar and the page.
       On the browse pages the sidebar's first row has the icon, the name, Back and Forward,
       and the search field (below) sits in the row at the page's edge; on Now playing the
       page's header row (Back, "Playing from", the lyrics' buttons and the Lyrics pill) is the
       row. The window buttons end it, Windows' sizes. Its free space drags the window
       (src/demo/window.ts). -->
  <div class="titlebar">
    <span class="tb-brand" data-chrome="browse" hidden={isNow}>
      <span class="art" aria-hidden="true">
        <img class="only-dark" src="/tri-vane.svg" width="16" height="16" alt="" />
        <img class="only-light" src="/tri-vane-light.svg" width="16" height="16" alt="" />
      </span>
      <span class="titlebar-name">featherplay</span>
    </span>
    <span class="tb-nav" data-chrome="browse" hidden={isNow}>
      <button class="tb-b tb-menu" type="button" aria-label="Menu" aria-disabled="true" tabindex="-1">
        <Icon name="menu" size={20} />
      </button>
      <button class="tb-b" type="button" data-act="back" aria-label="Back"><Icon name="back" size={20} /></button>
      <button class="tb-b tb-fwd" type="button" aria-label="Forward" aria-disabled="true" tabindex="-1"><Icon name="forward" size={20} /></button>
    </span>
    <span class="caption">
      <button class="cap" type="button" data-act="minimise" aria-label="Minimise featherplay to the tray">
        <svg viewBox="0 0 10 10" width="10" height="10" aria-hidden="true"
          ><path d="M0 5.5h10" stroke="currentColor" stroke-width="1"></path></svg
        >
      </button>
      <button class="cap" type="button" data-act="maximise" aria-label="Maximise featherplay">
        <svg class="i-max" viewBox="0 0 10 10" width="10" height="10" aria-hidden="true"
          ><rect x="0.5" y="0.5" width="9" height="9" rx="1.5" fill="none" stroke="currentColor" stroke-width="1"
          ></rect></svg
        >
        <svg class="i-restore" viewBox="0 0 10 10" width="10" height="10" aria-hidden="true"
          ><path d="M2.5 2.5 V1.8 C2.5 1.1 3.1 0.5 3.8 0.5 H8.2 C8.9 0.5 9.5 1.1 9.5 1.8 V6.2 C9.5 6.9 8.9 7.5 8.2 7.5 H7.5" fill="none" stroke="currentColor" stroke-width="1"
          ></path><rect x="0.5" y="2.5" width="7" height="7" rx="1.3" fill="none" stroke="currentColor" stroke-width="1"></rect></svg
        >
      </button>
      <button class="cap close" type="button" data-act="close" aria-label="Close featherplay">
        <svg viewBox="0 0 10 10" width="10" height="10" aria-hidden="true"
          ><path d="M0.5 0.5l9 9M9.5 0.5l-9 9" stroke="currentColor" stroke-width="1"></path></svg
        >
      </button>
    </span>
  </div>

  <div class="app">
    <!-- Now playing's ground (now_playing.slint): the cover's field, its colours as soft bands
         down the page, the same with the lyrics on or off, running round the Up next card. -->
    <span class="stage-wash" aria-hidden="true"></span>
    <!-- Sidebar (the browse pages) -->
    <nav class="sidebar" aria-label="featherplay" data-chrome="browse" hidden={isNow}>
      {!lite && (<>
      <ul class="side-nav">
        {
          pages.map((p) => (
            <li>
              <button
                class="side-item"
                type="button"
                aria-label={p.label}
                data-page={p.page}
                aria-current={view === p.page ? "page" : undefined}
              >
                <Icon name={p.icon} size={20} />
                <span>{p.label}</span>
              </button>
            </li>
          ))
        }
      </ul>
      <span class="side-rule" aria-hidden="true"></span>
      <button class="side-item" type="button" data-page="library" data-liked-link aria-label="Liked songs">
        <Icon name="heart" size={20} /><span>Liked songs</span>
      </button>
      <div class="chips" role="tablist" aria-label="Your library">
        {
          ["Playlists", "Albums", "Artists"].map((c, i) => (
            <button class="chip" type="button" role="tab" data-chip={i} aria-selected={String(i === 0)}>
              {c}
            </button>
          ))
        }
      </div>
      <ul class="side-list" data-chip-list="0">
        {
          playlists.map(([name, s]) => (
            <li>
              <img src={s.cover} width="32" height="32" alt="" loading="lazy" decoding="async" />
              <span>{name}</span>
            </li>
          ))
        }
      </ul>
      <ul class="side-list" data-chip-list="1" hidden>
        {
          songs.slice(0, 5).map((s) => (
            <li>
              <img src={s.cover} width="32" height="32" alt="" loading="lazy" decoding="async" />
              <span>{s.title}</span>
            </li>
          ))
        }
      </ul>
      <ul class="side-list" data-chip-list="2" hidden>
        {
          songs.slice(0, 5).map((s) => (
            <li>
              <img class="round" src={s.cover} width="32" height="32" alt="" loading="lazy" decoding="async" />
              <span>{s.artist}</span>
            </li>
          ))
        }
      </ul>
      <div class="side-foot" aria-hidden="true">
        <span class="side-item muted"><Icon name="gear" size={20} /><span>Settings</span></span>
        <span class="side-rule"></span>
        <span class="account"><span class="avatar">Y</span><span>You</span></span>
      </div>
      </>)}
    </nav>

    <div class="main">
      {!lite && (<>
      <!-- Top bar (the browse pages) -->
      <form class="topbar" role="search" data-search data-chrome="browse" hidden={isNow}>
        <label class="field">
          <Icon name="search" size={20} />
          <input
            type="search"
            name="q"
            data-search-input
            placeholder="Search songs, albums, artists, playlists"
            aria-label="Search songs, albums, artists, playlists"
            autocomplete="off"
            spellcheck="false"
          />
          <span class="keys" aria-hidden="true"><kbd>Ctrl</kbd><kbd>K</kbd></span>
        </label>
      </form>

      <!-- Home (home.slint): one top row, the Now playing card (pages/home/hero.slint) beside the
           Shortcuts (ShortcutGrid), both 224 px high; under an 800 px page the Shortcuts go under
           the card. Then a shelf. -->
      <section class="page home" data-pane="home" aria-label="Home" hidden={view !== "home"}>
        <div class="home-top">
          <div class="band">
            <!-- The art, edge to edge at the card's left end, with no label: paused shows through
                 the solid Resume. -->
            <span class="band-art">
              <img class="band-cover" data-resume-cover src={resume.cover} width="224" height="224" alt="" loading="lazy" decoding="async" />
            </span>
            <div class="band-text">
              <p class="band-title" data-resume-title data-fit={resume.title.length * 22 > 310 ? "m" : undefined}>{resume.title}</p>
              <p class="band-meta"><b data-resume-artist>{resume.artist}</b><span data-band-album>{resume.album ? ` · ${albumLine(resume)}` : ""}</span></p>
              <!-- One line: what's next while Up next is closed (a click opens it); where the song
                   plays from while it's open and the pill doesn't say so. -->
              <button class="band-line line-next" type="button" data-act="queue" data-band-next hidden={!next}>
                <span class="bl-lead">Next</span>
                <img data-band-next-cover src={next?.cover} width="22" height="22" alt="" loading="lazy" decoding="async" />
                <span class="bl-name"><b data-band-next-title>{next?.title}</b><span data-band-next-artist>{next ? ` · ${next.artist}` : ""}</span></span>
                <Icon name="chevronRight" size={16} />
              </button>
              <button class="band-line line-from" type="button" data-act="source">
                <span class="bl-lead">From</span>
                <Icon name="playlist" size={16} />
                <span class="bl-name"><b>Made for the demo</b></span>
                <Icon name="chevronRight" size={16} />
              </button>
              <div class="band-row">
                <button class="pill solid band-resume" type="button" data-act="toggle">
                  <Icon name="play" size={18} /><span>Resume</span>
                </button>
                <button class="pill band-source" type="button" data-act="source" aria-label="Open Made for the demo">
                  <Icon name="playlist" size={18} /><span>Made for the demo</span><Icon name="chevronRight" size={16} />
                </button>
                <button class="band-round like" type="button" data-act="like" aria-label="Like" aria-pressed="false"><Icon name="heart" size={20} /></button>
                <button class="band-round" type="button" aria-label="Add to playlist" aria-disabled="true" tabindex="-1"><Icon name="plus" size={20} /></button>
                <button class="band-round" type="button" aria-label="Start radio" aria-disabled="true" tabindex="-1"><Icon name="radio" size={20} /></button>
                <button class="band-round band-artist" type="button" aria-label="Go to artist" aria-disabled="true" tabindex="-1"><Icon name="person" size={20} /></button>
              </div>
            </div>
          </div>
          <!-- The Shortcuts: as high as the card in the fewest rows that hold them (here, four
               rows of 50 px tiles), the rest behind "N more": a pile of the first three hidden
               ones' covers, the count and their names, for each number of tiles the window's
               width shows (replica.css); no heading. -->
          <ul class="shortcuts" aria-label="Shortcuts">
            <li>
              <button class="sc-tile" type="button" data-page="library" aria-label="Liked songs">
                <span class="sc-art sc-liked" aria-hidden="true"><Icon name="heart" size={20} /></span>
                <span class="sc-text"><span class="t">Liked songs</span><span class="a">Everything you liked</span></span>
              </button>
            </li>
            {
              shortcuts.map((t) => (
                <li>
                  <button class="sc-tile" type="button" data-play={t.id} aria-label={`Play ${t.title}`}>
                    <img class="sc-art" src={t.cover} width="64" height="64" alt="" loading="lazy" decoding="async" />
                    <span class="sc-text"><span class="t">{t.title}</span><span class="a">{t.line}</span></span>
                  </button>
                </li>
              ))
            }
            <li class="sc-more-li">
              <button class="sc-tile sc-more" type="button" aria-disabled="true" tabindex="-1">
                <span class="sc-art sc-pile sc-v" aria-hidden="true">
                  {[1, 3, 5, 7].map((shown) => <span data-shown={shown}>{shortcuts.slice(shown - 1, shown + 2).map((t) => <img src={t.cover} width="64" height="64" alt="" loading="lazy" decoding="async" />)}</span>)}
                </span>
                <span class="sc-text">
                  <span class="t"><span class="sc-v">{[1, 3, 5, 7].map((shown) => <span data-shown={shown}>{shortcuts.length + 1 - shown}</span>)}</span> more</span>
                  <span class="a sc-v">{[1, 3, 5, 7].map((shown) => <span data-shown={shown}>{shortcuts.slice(shown - 1, shown + 2).map((t) => t.title).join(", ")}</span>)}</span>
                </span>
                <Icon name="chevronDown" size={16} class="sc-chev" />
              </button>
            </li>
          </ul>
        </div>
        <h3 class="page-h">Made for the demo</h3>
        <ul class="cards">
          {
            songs.map((s) => (
              <li>
                <button class="card" type="button" data-play={s.id} aria-label={`Play ${s.title}`}>
                  <span class="card-cover">
                    <img src={s.cover} width="170" height="170" alt="" loading="lazy" decoding="async" />
                    <span class="card-play" aria-hidden="true">
                      <Icon name="play" size={20} />
                    </span>
                  </span>
                  <span class="t">{s.title}</span>
                  <span class="a">{s.artist}</span>
                </button>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- Library: the songs liked in the demo, and the playlists -->
      <section class="page library" data-pane="library" aria-label="Library" hidden={view !== "library"}>
        <h3 class="page-title">Library</h3>
        <h3 class="page-h">Liked songs</h3>
        <div class="songs" data-liked-list></div>
        <p class="empty" data-liked-empty>Songs you like show up here. Press the heart in the bar.</p>
        <h3 class="page-h">Playlists</h3>
        <ul class="cards">
          {
            playlists.map(([name, s]) => (
              <li>
                <button class="card" type="button" data-play={s.id} aria-label={`Play ${name}`}>
                  <span class="card-cover">
                    <img src={s.cover} width="170" height="170" alt="" loading="lazy" decoding="async" />
                    <span class="card-play" aria-hidden="true">
                      <Icon name="play" size={20} />
                    </span>
                  </span>
                  <span class="t">{name}</span>
                  <span class="a">Playlist, made for the demo</span>
                </button>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- Explore -->
      <section class="page explore" data-pane="explore" aria-label="Explore" hidden={view !== "explore"}>
        <h3 class="page-title">Explore</h3>
        <h3 class="page-h">New for the demo</h3>
        <ul class="cards">
          {
            [...songs].reverse().map((s) => (
              <li>
                <button class="card" type="button" data-play={s.id} aria-label={`Play ${s.title}`}>
                  <span class="card-cover">
                    <img src={s.cover} width="170" height="170" alt="" loading="lazy" decoding="async" />
                    <span class="card-play" aria-hidden="true">
                      <Icon name="play" size={20} />
                    </span>
                  </span>
                  <span class="t">{s.title}</span>
                  <span class="a">{s.artist}</span>
                </button>
              </li>
            ))
          }
        </ul>
        <h3 class="page-h">Moods</h3>
        <div class="moods" aria-hidden="true">
          {["Late night", "Rain on the roof", "Coast", "Slow mornings", "Instrumental"].map((m) => <span class="mood">{m}</span>)}
        </div>
      </section>

      <!-- History: what's been played here, the latest first -->
      <section class="page history" data-pane="history" aria-label="History" hidden={view !== "history"}>
        <h3 class="page-title">History</h3>
        <h3 class="page-h">Today</h3>
        <div class="songs" data-history-list></div>
      </section>

      <!-- Search -->
      <section class="page search" data-pane="search" aria-label="Search results" hidden={view !== "search"}>
        <h3 class="page-h" data-search-heading>Songs</h3>
        <div data-search-result></div>
        <p class="empty" data-search-empty hidden>No songs match that. Try a title, an artist or a song link.</p>
      </section>

      </>)}

      <!-- Now playing: the cover view, or the full lyrics view, on the cover's field (the
           ground under .app) -->
      <section class="stage" data-pane="now" aria-label={nowLabel} hidden={!isNow}>
        <button class="fp-ib back" type="button" data-act="back" aria-label="Back">
          <Icon name="back" size={20} />
        </button>
        <!-- Where the queue comes from, centred in the header row; it opens Up next. -->
        <button class="np-source" type="button" data-act="source">
          <span class="src-l">Playing from</span>
          <span class="src-t">Made for the demo<Icon name="chevronRight" size={16} /></span>
        </button>
        <!-- Translate and the lyrics menu's ⋯, left of the pill while the lyrics show (the demo's
             lyrics are in English and have no other matches: only drawn). -->
        <span class="lyr-acts" aria-hidden="true">
          <span class="lyr-act"><Icon name="translate" size={20} /></span>
          <span class="lyr-act"><Icon name="more" size={20} /></span>
        </span>
        <!-- A song with no lyrics keeps the cover view, and the pill says so. -->
        <button class="lyrics-pill" type="button" data-act="lyrics" aria-pressed={String(view === "lyrics")} data-lyrics-toggle>
          <Icon name="lyrics" size={18} /><span class="pill-has">Lyrics</span><span class="pill-none">No lyrics</span>
        </button>
        <div class="np">
          <img class="np-cover" data-np-cover src={song.cover} width="440" height="440" alt="" decoding="async" />
          <div class="np-text">
            <div class="np-row">
              <p class="np-title" data-np-title>{song.title}</p>
              <span class="np-actions">
                <span class="fp-tipped nfm">
                  <button class="fp-ib" type="button" data-act="notforme" aria-label="Not for me" aria-describedby={`${id}-nfm`}>
                    <Icon name="notForMe" size={20} />
                  </button>
                  <span class="fp-tip" id={`${id}-nfm`}>
                    <b>Not for me</b><span>Skips the song and marks it as one you dislike</span>
                  </span>
                </span>
                <button class="fp-ib like" type="button" data-act="like" aria-label="Like" aria-pressed="false">
                  <Icon name="heart" size={20} />
                </button>
                <button class="fp-ib" type="button" data-act="more" aria-label="More" aria-disabled="true" tabindex="-1">
                  <Icon name="more" size={20} />
                </button>
              </span>
            </div>
            <p class="np-artist" data-np-artist>{song.artist}</p>
            <!-- "album · year"; left out for a track without an album, as the app does. -->
            <p class="np-album" data-np-album hidden={!song.album}>{albumLine(song)}</p>
            <!-- Filled only when the visitor presses "No lyrics", so a screen reader hears it. -->
            <p class="np-note" data-no-lyrics role="status"></p>
          </div>
        </div>
        <div class="lyrics" data-lyrics>
          <ol class="lines" data-lines style={`transform:translateY(calc(-1 * ${linesY}))`}>
            {
              !lite && song.lyrics.map((l, i) => (
                <li>
                  <button
                    class="line"
                    type="button"
                    data-at={l.atMs}
                    data-state={lineState(i)}
                    aria-current={i === current ? "true" : undefined}
                  >
                    {l.line}
                  </button>
                </li>
              ))
            }
            {!lite && <li class="source">{lyricsSource(song)}</li>}
          </ol>
        </div>
      </section>
    </div>

    <!-- Up next, Related and Lyrics: beside Now playing, or opened over a page from the bar.
         The Lyrics tab steps aside while the full lyrics view shows them. -->
    <aside class="queue" data-queue aria-label="Up next" hidden={!isNow}>
      <div class="tabs" role="tablist" aria-label="Up next, Related and Lyrics">
        <span class="tab-pill" aria-hidden="true"></span>
        <button class="tab" type="button" role="tab" data-tab="next" aria-selected="true" aria-controls={`${id}-next`}>Up next</button>
        <button class="tab" type="button" role="tab" data-tab="related" aria-selected="false" aria-controls={`${id}-related`}>Related</button>
        <button class="tab" type="button" role="tab" data-tab="lyrics" aria-selected="false" aria-controls={`${id}-lyrics`} hidden={!lyricsTab}>
          Lyrics
        </button>
      </div>
      <div class="tab-panel" id={`${id}-next`} role="tabpanel" data-tab-panel="next">
        <!-- "Playing from" and Clear, then the song playing, pinned, and the songs after it. -->
        <div class="from">
          <span class="from-l">Playing from</span>
          <span class="from-t">Made for the demo</span>
          <button class="clear" type="button" data-act="clear" aria-disabled={String(at + 1 >= songs.length)}>Clear</button>
        </div>
        <ul class="rows">
          {
            songs.map((s, i) => (
              <li hidden={i < at}>
                <button
                  class="row"
                  type="button"
                  data-play={s.id}
                  data-row={s.id}
                  aria-current={s.id === song.id ? "true" : undefined}
                >
                  <span class="row-cover">
                    <img src={s.cover} width="40" height="40" alt="" loading="lazy" decoding="async" />
                    <span class="cover-play" aria-hidden="true">
                      <Icon name="play" size={20} class="i-play" />
                      <Icon name="pause" size={20} class="i-pause" />
                    </span>
                  </span>
                  <span class="row-text">
                    <span class="visually-hidden" data-row-verb>Play </span>
                    <span class="t">{s.title}</span>
                    <span class="a">{s.artist}</span>
                  </span>
                  <span class="row-end">
                    <Mark />
                    <span class="dur">{formatTime(s.durationMs)}</span>
                  </span>
                </button>
              </li>
            ))
          }
        </ul>
        <p class="up-empty" data-up-empty role="status" hidden={at + 1 < songs.length}>Nothing up next</p>
      </div>
      <div class="tab-panel" id={`${id}-related`} role="tabpanel" data-tab-panel="related" hidden>
        <p class="similar" data-similar>Similar to {song.title}</p>
        <div class="songs" data-related-list></div>
      </div>
      <!-- The song's lines on a card of its colour, following it; or why there are none. -->
      <div class="tab-panel side-tab" id={`${id}-lyrics`} role="tabpanel" data-tab-panel="lyrics" hidden>
        <div class="side-card">
          <div class="side-lyrics" data-side-lyrics>
            <ol class="lines" data-side-lines>
              {
                !lite && song.lyrics.map((l, i) => (
                  <li>
                    <button class="line" type="button" data-at={l.atMs} data-state={lineState(i)}>
                      {l.line}
                    </button>
                  </li>
                ))
              }
              {!lite && hasLyrics && <li class="source">{lyricsSource(song)}</li>}
            </ol>
          </div>
        </div>
        <div class="side-none">
          <span class="side-none-tile" aria-hidden="true"><Icon name="lyrics" size={26} /></span>
          <p class="side-none-h">No lyrics for this song</p>
          <p class="side-none-why">Searched LRCLIB and YouTube Music.</p>
        </div>
      </div>
    </aside>

    <!-- The player bar -->
    <div class="bar" data-bar>
      <button class="bar-song" type="button" data-act="nowplaying">
        <span class="bar-cover-wrap">
          <img class="bar-cover" data-bar-cover src={song.cover} width="56" height="56" alt="" decoding="async" />
          <span class="bar-veil" aria-hidden="true">
            <Icon name="chevronUp" size={20} class="i-up" /><Icon name="chevronDown" size={20} class="i-down" />
          </span>
        </span>
        <span class="bar-text">
          <span class="visually-hidden">Now playing: </span>
          <span class="bar-title" data-bar-title>{song.title}</span>
          <span class="bar-artist" data-bar-artist>{song.artist}</span>
        </span>
      </button>
      <div class="bar-mid">
        <div class="transport">
          <button class="fp-ib" type="button" data-act="shuffle" aria-label="Shuffle" aria-pressed="false">
            <Icon name="shuffle" size={20} />
          </button>
          <button class="fp-ib t1" type="button" data-act="previous" aria-label="Previous">
            <Icon name="prev" size={20} />
          </button>
          <span class="fp-tipped play-tipped">
            <button class="fp-play play" type="button" data-act="toggle" aria-label="Play" data-play-label>
              <Icon name="play" class="i-play" /><Icon name="pause" class="i-pause" />
            </button>
            <span class="fp-tip row-tip" aria-hidden="true"><b data-play-text>Play</b><span>Space</span></span>
          </span>
          <button class="fp-ib t1" type="button" data-act="next" aria-label="Next">
            <Icon name="next" size={20} />
          </button>
          <button class="fp-ib repeat" type="button" data-act="repeat" aria-label="Repeat off" aria-pressed="false" data-repeat="off">
            <Icon name="repeat" size={20} /><span class="one" aria-hidden="true">1</span>
          </button>
        </div>
        <div class="seek">
          <span class="time" data-bar-time>{formatTime(positionMs)}</span>
          <span class="seek-line" data-seek-line>
            <span class="rail"><span class="fill" data-progress style={`transform:scaleX(${fraction})`}></span></span>
            <span class="thumb" data-thumb style={`translate:${(fraction * 100).toFixed(3)}cqw 0`} aria-hidden="true"></span>
            <span class="seek-tip" data-seek-tip aria-hidden="true">0:00</span>
            <input
              type="range"
              min="0"
              max={song.durationMs}
              step="1000"
              value={positionMs}
              data-seek
              aria-label="Seek"
              aria-valuetext={`${formatTime(positionMs)} of ${formatTime(song.durationMs)}`}
            />
          </span>
          <span class="time end" data-bar-duration>{formatTime(song.durationMs)}</span>
        </div>
      </div>
      <div class="bar-end">
        <span class="fp-tipped lyr">
          <button
            class="fp-ib mic"
            type="button"
            data-act="lyrics"
            data-lyrics-toggle
            aria-label="Lyrics"
            aria-pressed={String(view === "lyrics")}
          >
            <Icon name="lyrics" size={20} />
          </button>
          <span class="fp-tip row-tip" aria-hidden="true"><b data-lyrics-tip>{view === "lyrics" ? "Hide lyrics" : "Lyrics"}</b><span>Ctrl+L</span></span>
        </span>
        <span class="fp-tipped nfm">
          <button class="fp-ib" type="button" data-act="notforme" aria-label="Not for me" aria-describedby={`${id}-nfm-bar`}>
            <Icon name="notForMe" size={20} />
          </button>
          <span class="fp-tip" id={`${id}-nfm-bar`}><b>Not for me</b><span>Skips the song and marks it as one you dislike</span></span>
        </span>
        <button class="fp-ib like" type="button" data-act="like" aria-label="Like" aria-pressed="false">
          <Icon name="heart" size={20} />
        </button>
        <button class="fp-ib mute" type="button" data-act="mute" aria-label="Mute">
          <Icon name="volume" size={20} class="i-on" /><Icon name="volumeOff" size={20} class="i-off" />
        </button>
        <span class="volume" data-volume-wrap style="--vol:0.7">
          <span class="vol-rail"><span class="vol-fill"></span></span>
          <input type="range" min="0" max="100" value="70" aria-label="Volume" data-volume />
        </span>
        <button class="fp-ib queue-btn" type="button" data-act="queue" aria-label="Up next" aria-pressed={String(isNow)}>
          <Icon name="queue" size={20} />
        </button>
      </div>
    </div>

    <div class="toast" data-toast hidden>
      <span data-toast-text></span>
      <button class="toast-act" type="button" data-act="undo">Undo</button>
    </div>
  </div>
</div>

<script>
  import { bindReplicas } from "../demo/replica";
  bindReplicas();
</script>
