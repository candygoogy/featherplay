---
// Scrobbling, as the app's Settings shows it: the song, its state, and a ring that fills with
// the time actually heard; at half the song (four minutes at most) the ring closes and a tick
// draws in, and the song joins the two scrobbled before it. The ring and the tick are CSS
// (stroke-dashoffset on pathLength), live on the player store (src/demo/pieces.ts createListen),
// the ring drawn in small steps (src/demo/bind-pieces.ts).
import "../../styles/pieces.css";
import { demoStart, songById } from "../../data/songs";

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const song = songById(demoStart.songId)!;
---

<div class:list={["m-scrobble", className]} data-piece="scrobble">
  <div class="sc-row" data-sc-row>
    <img data-bind="cover" src={song.cover} width="48" height="48" alt="" decoding="async" />
    <span class="sc-text"><span class="sc-title" data-bind="title">{song.title}</span><span class="sc-artist" data-bind="artist">{song.artist}</span></span>
    <span class="sc-state">
      <span data-sc-label>Paused</span>
      <svg class="sc-ring" viewBox="0 0 20 20" width="26" height="26" aria-hidden="true">
        <circle class="sc-track" cx="10" cy="10" r="8"></circle>
        <circle class="sc-fill" cx="10" cy="10" r="8" pathLength="100" data-sc-ring></circle>
        <path class="sc-tick" pathLength="1" d="M6.6 10.2 L8.9 12.4 L13.4 7.8"></path>
      </svg>
    </span>
  </div>
  <ol class="sc-past" data-sc-past aria-label="Scrobbled earlier"></ol>
</div>
