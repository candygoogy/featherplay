---
// Scrobbling, the rule at work: the song playing, and under it a line that fills with the time
// actually heard (not where the song is: a seek forward doesn't count) toward the mark at half
// the song (four minutes at most). At the mark the song is scrobbled: the mark closes with a
// tick and the song drops into the list of those scrobbled this visit. Nothing is sent anywhere:
// a picture of what the app does, kept on this page. Live on the player store
// (src/demo/pieces.ts createListen, src/demo/bind-pieces.ts); the line runs on the compositor.
import "../../styles/pieces.css";
import { demoStart, songById } from "../../data/songs";
import { formatTime } from "../../demo/player";
import { scrobbleAfterMs } from "../../demo/pieces";

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const song = songById(demoStart.songId)!;
const half = (scrobbleAfterMs(song.durationMs) / song.durationMs) * 100;
---

<div class:list={["m-scrobble", className]} data-piece="scrobble" style={`--half:${half}%`}>
  <div class="sc-now">
    <img data-bind="cover" src={song.cover} width="56" height="56" alt="" decoding="async" />
    <span class="sc-text"><span class="sc-title" data-bind="title">{song.title}</span><span class="sc-artist" data-bind="artist">{song.artist}</span></span>
    <span class="sc-state" data-sc-label>Paused</span>
  </div>
  <div class="sc-meter" aria-hidden="true">
    <span class="sc-line"><span class="sc-heard" data-sc-fill></span></span>
    <svg class="sc-mark" viewBox="0 0 20 20" width="20" height="20">
      <circle cx="10" cy="10" r="9"></circle>
      <path class="sc-tick" pathLength="1" d="M6.4 10.3 L8.8 12.6 L13.6 7.7"></path>
    </svg>
  </div>
  <p class="sc-scale num" aria-hidden="true">
    <span><span data-sc-heard>0:00</span> heard</span><span class="sc-half">Halfway</span><span data-bind="duration">{formatTime(song.durationMs)}</span>
  </p>
  <div class="sc-recent">
    <p class="sc-h">Scrobbled this visit<span>shown here only</span></p>
    <ol class="sc-past" data-sc-past aria-label="Scrobbled this visit"></ol>
    <p class="sc-empty">Play a song past halfway and it lands here.</p>
  </div>
</div>

<style is:global>
  /* ---------- Scrobbling: the time heard fills the song's line to the halfway mark ---------- */
  .m-scrobble {
    --half: 50%;
    container: sc / inline-size;
    width: min(30rem, 100%);
    padding: var(--s4) var(--s5) var(--s5);
    border-radius: var(--r-panel);
    background: var(--mat-solid);
    box-shadow: var(--lit), var(--ring), 0 18px 40px -24px var(--shade-2);
    color: var(--text);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
  }
  .sc-now {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--s4);
  }
  .sc-now > img {
    width: 56px;
    height: 56px;
    border-radius: var(--r-small);
    object-fit: cover;
    box-shadow: 0 1px 2px var(--shade-1), 0 4px 12px var(--shade-2);
  }
  .sc-text {
    display: grid;
    min-width: 0;
  }
  .sc-title,
  .sc-artist {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .sc-title {
    font-weight: var(--fw-bold);
  }
  .sc-now .sc-title {
    font-size: var(--fs-text);
  }
  .sc-artist,
  .sc-state {
    color: var(--ink2);
  }
  .sc-state {
    white-space: nowrap;
    transition: color var(--t-medium) ease;
  }
  [data-scrobbled] .sc-state {
    color: var(--accent);
    font-weight: var(--fw-bold);
  }
  /* The song's line: the fill is the time heard; the mark sits at half the song. */
  .sc-meter {
    position: relative;
    display: grid;
    align-items: center;
    height: 20px;
    margin-top: var(--s5);
  }
  .sc-line {
    position: relative;
    height: 4px;
    overflow: hidden;
    border-radius: var(--r-pill);
    background: var(--tonal);
  }
  .sc-heard {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--text);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }
  .sc-mark {
    position: absolute;
    top: 0;
    left: var(--half);
    margin-left: -10px;
    overflow: visible;
  }
  .sc-mark circle {
    fill: var(--mat-solid);
    stroke: var(--ink2);
    stroke-width: 2;
    transition:
      fill var(--t-small) ease,
      stroke var(--t-small) ease;
  }
  .sc-tick {
    fill: none;
    stroke: var(--on-accent);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  /* At the mark (scrobble-tick's timings): it fills, tightens to 92 % in 100 ms and eases back by
     500 ms while the tick draws from 83 to 400 ms. */
  [data-scrobbled] .sc-mark {
    animation: sc-tighten 500ms cubic-bezier(0.4, 0, 0.6, 1);
  }
  [data-scrobbled] .sc-mark circle {
    fill: var(--accent);
    stroke: var(--accent);
  }
  [data-scrobbled] .sc-tick {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 317ms cubic-bezier(0.35, 0, 0.1, 1) 83ms;
  }
  @keyframes sc-tighten {
    20% {
      scale: 0.92;
      animation-timing-function: cubic-bezier(0.2, 0, 0, 1);
    }
  }
  .sc-scale {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    margin-top: var(--s1);
    color: var(--ink2);
    font-size: 0.75rem;
  }
  .sc-scale > :last-child {
    text-align: end;
  }
  [data-scrobbled] .sc-half {
    color: var(--accent);
  }
  /* The songs scrobbled this visit: the list has its three rows' room from the start (the
     empty line fills it), so a song landing in it moves nothing on the page. */
  .sc-recent {
    --sc-room: 156px;
    display: grid;
    margin-top: var(--s5);
    padding-top: var(--s4);
    border-top: 1px solid var(--hairline);
  }
  .sc-h {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0 var(--s3);
    font-weight: var(--fw-bold);
  }
  .sc-h > span {
    color: var(--ink2);
    font-size: 0.75rem;
    font-weight: var(--fw-medium);
  }
  .sc-past,
  .sc-empty {
    grid-area: 2 / 1;
    min-height: var(--sc-room);
  }
  .sc-past {
    display: grid;
    align-content: start;
    gap: 6px;
    margin: var(--s3) 0 0;
    padding: 0;
    list-style: none;
  }
  .sc-past li {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--s3);
    padding: 6px var(--s3) 6px 6px;
    border-radius: var(--r-small);
    background: var(--panel-tint);
    line-height: 1.3;
    animation: sc-in var(--t-large) var(--ease-out);
  }
  .sc-past img {
    width: 36px;
    height: 36px;
    border-radius: var(--r-control);
    object-fit: cover;
  }
  .sc-to {
    display: grid;
    justify-items: end;
    color: var(--ink2);
    font-size: 0.75rem;
  }
  @keyframes sc-in {
    from {
      opacity: 0;
      translate: 0 calc(-2 * var(--rise));
    }
  }
  .sc-empty {
    display: grid;
    place-items: center;
    margin-top: var(--s3);
    padding: var(--s2) var(--s4);
    border-radius: var(--r-small);
    background: var(--panel-tint);
    color: var(--ink2);
    text-align: center;
    text-wrap: balance;
  }
  .sc-past:has(li) + .sc-empty {
    display: none;
  }
  /* Narrow (a phone): the state under the song, the services under each scrobbled one, so the
     titles keep their room. */
  @container sc (width < 19rem) {
    .sc-recent {
      --sc-room: 210px;
    }
    .sc-now {
      grid-template-columns: 56px minmax(0, 1fr);
      row-gap: 0;
    }
    .sc-state {
      grid-column: 2;
    }
    .sc-past li {
      grid-template-columns: 36px minmax(0, 1fr);
      row-gap: 2px;
    }
    .sc-to {
      grid-column: 2;
      display: flex;
      gap: var(--s2);
    }
  }
  /* Forced colours: the line and what has been heard of it stay in the system's ink. */
  @media (forced-colors: active) {
    .sc-line {
      outline: 1px solid CanvasText;
    }
    .sc-heard {
      background: CanvasText;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-scrobbled] .sc-tick {
      transition: none;
    }
    [data-scrobbled] .sc-mark,
    .sc-past li {
      animation: none;
    }
  }
</style>
