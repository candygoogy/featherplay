---
// Where featherplay answers play, pause and skip: Windows' media overlay (on the screen, above)
// and the keyboard's media keys (below, inert until the script is here). The taskbar's
// thumbnail, the third place the cell's words name, was drawn here too and made the well too
// busy: the words carry it. Every control here acts on the page's one
// player (src/demo/bind-pieces.ts), and the key caps press when any of them is used, or when the
// visitor's own media keys reach the page (Media Session, once a song has played). The four
// keys are the ones a keyboard has and the app answers: previous, play or pause, stop (which
// pauses, as in the app) and next. The slot is for the note by the keys.
import "../../styles/pieces.css";
import Icon from "../Icon.astro";
import MediaFlyout from "./MediaFlyout.astro";
const keys = [
  { key: "previous", label: "Previous" },
  { key: "toggle", label: "Play" },
  { key: "stop", label: "Stop" },
  { key: "next", label: "Next" },
] as const;
---

<div class="mk" data-keys-stage>
  <div class="mk-in">
    <div class="mk-place mk-overlay">
      <MediaFlyout overlay surface cover={76} />
      <p class="mk-cap">Media overlay</p>
    </div>
    <div class="mk-place mk-board">
      <div class="mk-keys" data-piece="keys" inert role="group" aria-label="Media keys">
        {
          keys.map((k) => (
            <button type="button" class="kc" data-do={k.key} data-key={k.key} data-play-label={k.key === "toggle" ? "" : undefined} aria-label={k.label}>
              <span class="kc-top">
                {k.key === "toggle" ? (
                  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="currentColor">
                    <path d="M3.5 6.6 C3.5 6 4.2 5.6 4.7 6 L11.6 11.4 C12 11.7 12 12.3 11.6 12.6 L4.7 18 C4.2 18.4 3.5 18 3.5 17.4 Z" />
                    <rect x="14.2" y="6" width="2.4" height="12" rx="0.8" />
                    <rect x="18.6" y="6" width="2.4" height="12" rx="0.8" />
                  </svg>
                ) : k.key === "stop" ? (
                  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="currentColor">
                    <rect x="6.5" y="6.5" width="11" height="11" rx="1.8" />
                  </svg>
                ) : (
                  <Icon name={k.key === "previous" ? "prev" : "next"} size={20} />
                )}
              </span>
            </button>
          ))
        }
        <slot />
      </div>
      <p class="mk-cap">Keyboard</p>
    </div>
  </div>
</div>

<style is:global>
  /* Windows 11's media overlay (MediaFlyout `overlay`): the app's name over the title and artist,
     the cover on the right, the time under the line, the keys centred. */
  .m-media.mm-overlay {
    padding: var(--s4) var(--s4) var(--s2);
  }
  .mm-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--s4);
  }
  .mm-overlay .mm-text {
    display: flex;
    flex-direction: column;
  }
  .mm-overlay .mm-app {
    margin-bottom: auto;
    padding-bottom: var(--s3);
  }
  /* A long title takes a second line rather than losing its end. */
  /* One line, cut with an ellipsis as Windows cuts it: a long title doesn't make the overlay
     taller (and move what is under it). */
  .mm-overlay .mm-title {
    font-size: var(--fs-text);
    line-height: 1.3;
  }
  .mm-overlay .mm-rail {
    margin: var(--s4) 0 0;
  }
  .mm-times {
    display: flex;
    justify-content: space-between;
    margin-top: 6px;
    color: var(--ink2);
    font-size: 0.75rem;
    font-weight: var(--fw-medium);
  }
  .mm-overlay .mm-keys {
    margin-top: 0;
  }

  /* ---------- The media keys: the overlay on the screen, the keys below ---------- */
  .mk {
    container: mk / inline-size;
    width: 100%;
  }
  /* The overlay, the keys under it; the room beside the keys is the note's. */
  .mk-in {
    display: grid;
    justify-items: center;
    gap: var(--s6);
    width: min(24rem, 100%);
    margin-inline: auto;
  }
  .mk-place {
    display: grid;
    justify-items: center;
    width: 100%;
    min-width: 0;
  }
  .mk-place > .m-media {
    width: 100%;
  }
  .mk-cap {
    margin-top: var(--s3);
    color: var(--ink2);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
  }
  /* The keys: four key caps as a keyboard's are seen from above and a little in front. Each is
     its body (the sides, widest at the front) with the top face set into it; pressed, the
     face goes down and the cap's shadow closes, and it comes back on the app's spring. Pressed
     by the player (a key of the visitor's own, the overlay, the cap itself) its mark lights. */
  .mk-keys {
    --kc: 58px;
    position: relative;
    display: flex;
    gap: 10px;
  }
  .kc {
    position: relative;
    width: var(--kc);
    height: var(--kc);
    padding: 0;
    border: 0;
    border-radius: 13px;
    background: light-dark(linear-gradient(#ebe6de, #d6cec2), linear-gradient(#27272b, #19191c));
    box-shadow:
      inset 0 1px 0 light-dark(rgb(255 255 255 / 0.9), rgb(255 255 255 / 0.07)),
      0 0 0 1px light-dark(rgb(60 40 20 / 0.14), rgb(0 0 0 / 0.55)),
      0 2px 3px light-dark(rgb(60 40 20 / 0.14), rgb(0 0 0 / 0.5)),
      0 10px 18px -8px light-dark(rgb(60 40 20 / 0.32), rgb(0 0 0 / 0.75));
    color: var(--ink2);
    cursor: pointer;
    transition: box-shadow var(--t-release) ease;
  }
  .kc-top {
    position: absolute;
    inset: 5px 7px 11px;
    display: grid;
    place-items: center;
    border-radius: 8px;
    background:
      radial-gradient(120% 90% at 50% 0%, light-dark(#ffffff, rgb(255 255 255 / 0.06)), transparent 65%),
      light-dark(linear-gradient(#fbfaf7, #f1ede6), linear-gradient(#37373c, #2c2c31));
    box-shadow:
      inset 0 1px 0 light-dark(#ffffff, rgb(255 255 255 / 0.12)),
      0 1px 1px light-dark(rgb(60 40 20 / 0.12), rgb(0 0 0 / 0.45));
    transition:
      translate var(--t-release) var(--spring-release),
      color var(--t-medium) ease;
  }
  .kc-top svg {
    width: 18px;
    height: 18px;
  }
  .kc:hover .kc-top {
    color: var(--text);
  }
  .kc:active,
  .kc[data-pressed] {
    box-shadow:
      inset 0 1px 0 light-dark(rgb(255 255 255 / 0.9), rgb(255 255 255 / 0.07)),
      0 0 0 1px light-dark(rgb(60 40 20 / 0.14), rgb(0 0 0 / 0.55)),
      0 1px 1px light-dark(rgb(60 40 20 / 0.14), rgb(0 0 0 / 0.5)),
      0 3px 6px -4px light-dark(rgb(60 40 20 / 0.32), rgb(0 0 0 / 0.75));
    transition-duration: var(--t-press);
  }
  .kc:active .kc-top,
  .kc[data-pressed] .kc-top {
    translate: 0 3px;
    color: var(--text);
    transition-duration: var(--t-press);
    transition-timing-function: var(--ease-out);
  }
  .kc[data-pressed] .kc-top {
    color: var(--accent);
  }
  .kc:focus-visible {
    outline-offset: 3px;
  }
  @media (prefers-reduced-motion: reduce) {
    .kc:active .kc-top,
    .kc[data-pressed] .kc-top {
      translate: none;
      background: light-dark(#ece7df, #232327);
    }
  }
  @media (forced-colors: active) {
    .kc,
    .kc-top {
      border: 1px solid ButtonText;
    }
  }
  /* A wide stage (a large screen): the same parts a size up, by layout. */
  @container mk (width > 50rem) {
    .mk-in {
      width: min(29rem, 100%);
    }
    .mk .m-media {
      --cover: 96px !important;
      font-size: var(--fs-text);
    }
    .mk .mm-title {
      font-size: var(--fs-lede);
    }
    .mk-keys {
      --kc: 66px;
      gap: 12px;
    }
    .kc-top {
      inset: 6px 8px 12px;
    }
    .kc-top svg {
      width: 20px;
      height: 20px;
    }
  }
</style>
