---
// featherplay's tray icon and Windows' two-line tooltip on it (the song, then the artist and
// the time), live on the player store (src/demo/pieces.ts trayLines). With `corner`, drawn in
// the corner of a taskbar with the chevron and the visitor's clock, the tooltip over it.
import "../../styles/pieces.css";
import Logo from "../Logo.astro";

interface Props {
  corner?: boolean;
  class?: string;
}
const { corner = false, class: className } = Astro.props;
---

{
  corner ? (
    <span class:list={["tray-corner", className]} data-piece="tray" role="img" aria-label="featherplay’s icon in the tray, its tooltip naming the song">
      <span class="tray-tip glass float" aria-hidden="true">
        <span data-tray-1>featherplay</span>
        <span data-tray-2>Nothing playing</span>
      </span>
      <span class="tray-row" aria-hidden="true">
        <span class="tb">
          <svg viewBox="0 0 24 24" width="16" height="16"><path d="M7.5 14 L12 9.5 L16.5 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
        </span>
        <span class="tb lit"><Logo size={18} /></span>
        <span class="tray-clock num" data-clock><span data-clock-time></span><span data-clock-date></span></span>
      </span>
    </span>
  ) : (
    <span class:list={["tray-tip glass float", className]} data-piece="tray">
      <span data-tray-1>featherplay</span>
      <span data-tray-2>Nothing playing</span>
    </span>
  )
}
