---
// The first screen, and the window stepping back as the page moves (the scroll story): one
// pinned stage. The first screen is the study's composition (src/scripts/first.ts): the
// headline top left, the sentence and buttons under it, a shelf of the six sleeves under the
// words, the window from the middle of the headline's second line as large as the room allows
// (or the words and the shelf side by side over a full-width window in tall rooms; one column
// on phones). Without script, a plain grid of the same parts. Where the story runs (src/scripts/story.ts: a pointer-sized
// screen, motion allowed) the stage is pinned for its length and the window takes three holds:
// whole, narrow, in the tray. Elsewhere (phones, short windows, reduced motion) the window sits
// in its slot and the steps under it are a switch that puts the same window in each shape
// (src/scripts/shapes.ts); without script they are plain words.
import Window from "./Window.astro";
import NowPlaying from "./NowPlaying.astro";
import Note from "./Note.astro";
import DlGlyph from "./DlGlyph.astro";
import Shelf from "./Shelf.astro";
import Segmented from "./Segmented.astro";
import { release, sizeLabel, heroPicks } from "../data/release";
import { figures } from "../data/numbers";

// Download: the file for the visitor's system where the page can tell it (boot.js), else the
// Download section. Every system's line is in the page; CSS shows the one for data-os, so
// nothing changes under the visitor as the page lands.
const picks = heroPicks();
const get = Object.fromEntries(picks.map((p) => [`data-get-${p.os}`, p.file.url]));
const runsOn = release.linux ? "Windows and Linux" : "Windows 10 and 11";
const size = (f: Parameters<typeof sizeLabel>[0]) => sizeLabel(f).replace(" ", " ");
// Its best fact, on the first screen: memory with a song playing and the window minimised, as
// measured (the numbers section has the rest, and how).
const memory = figures[0].memoryMB;
const steps = [
  { key: "whole" as const, label: "Whole", h: "A whole player when you want one.", p: "Home, your library, synced lyrics and the queue, in one native window." },
  { key: "narrow" as const, label: "Narrow", h: "Narrow, beside your work.", p: "Down to 480 px wide it keeps the cover, the lyrics and the bar." },
  {
    key: "tray" as const,
    label: "In the tray",
    h: "Or nothing at all.",
    p: "Closed to the tray it keeps playing: 39 MB of memory, one process. Your media keys still work.",
  },
];
---

<section class="stage" id="app" tabindex="-1" data-stage aria-labelledby="hero-title">
  <span class="anchor" id="top" aria-hidden="true"></span>
  <div class="pin" data-pin>
    <div class="frame first" data-first>
      <h1 id="hero-title" class="t-display head" data-head><span class="line">Light enough to forget</span> <span class="line">it’s running.</span></h1>
      <div class="col" data-col>
        <p class="t-lede">
          featherplay is a free, native player for YouTube&nbsp;Music on Windows and Linux. Minimised, it plays in
          <a class="lede-link" href="#light">{memory}&nbsp;MB of memory</a>.
        </p>
        <div class="actions">
          <a class="btn red" href="#download" data-pick {...get}>
            <DlGlyph />
            Download
            {picks.map((p) => <span class="visually-hidden" data-for={p.os}> featherplay for {p.os === "windows" ? "Windows" : "Linux"}</span>)}
          </a>
          <button class="btn tonal play-first" type="button" data-do="toggle" data-play-toggle hidden>
            <span class="pp" aria-hidden="true">
              <svg class="i-play" viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M8 5.2 V18.8 C8 19.4 8.7 19.8 9.2 19.4 L19.2 12.7 C19.7 12.4 19.7 11.6 19.2 11.3 L9.2 4.6 C8.7 4.2 8 4.6 8 5.2 Z"></path></svg>
              <svg class="i-pause" viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M7 5.5 C7 5.2 7.2 5 7.5 5 H9.5 C9.8 5 10 5.2 10 5.5 V18.5 C10 18.8 9.8 19 9.5 19 H7.5 C7.2 19 7 18.8 7 18.5 Z M14 5.5 C14 5.2 14.2 5 14.5 5 H16.5 C16.8 5 17 5.2 17 5.5 V18.5 C17 18.8 16.8 19 16.5 19 H14.5 C14.2 19 14 18.8 14 18.5 Z"></path></svg>
            </span>
            <span data-play-toggle-text>Play a song</span>
          </button>
        </div>
        <p class="t-small ink2 meta" data-pick>
          {
            picks.map((p) => (
              <span data-for={p.os}>
                {size(p.file)}, version {release.version}{p.also && <>{" · "}<a class="lede-link" href="#download">Also for {p.also}</a></>}
              </span>
            ))
          }
          <span data-for="other">Version {release.version}, for {runsOn}</span>
        </p>
        <NowPlaying class="credit" />
      </div>
      <Shelf />
      <Note id="screenshot" free underline class="n-screenshot" manual />
      <Note id="sleeves" free class="n-sleeves" manual />
      <a class="skip skip-app" href="#after-app" data-before-replica>Skip past the app</a>
      <div class="slot" data-win-slot>
        <Window />
      </div>
    </div>
    <!-- The story's change of shape (src/scripts/story-morph.ts): the window's frame, with a
         still copy of the shape it leaves in it. -->
    <div class="ghost" data-ghost aria-hidden="true" inert></div>
    <!-- The three holds' captions, laid out by the story (the same words are in the steps below,
         read in order). -->
    <div class="caps" aria-hidden="true">
      {
        steps.map((s, i) => (
          <div class="cap" data-cap={i}>
            <p class="t-title">{s.h}</p>
            <p class="t-lede">{s.p}</p>
          </div>
        ))
      }
    </div>
  </div>
  <!-- Notes their scripts place: by the tray icon the first time the window comes back from
       it (src/demo/window.ts), and beside the tray's flyout in the story's last hold. -->
  <Note id="opens" arrow="up-left" class="n-opens" manual />
  <Note id="playing" arrow="up-left" class="n-playing" manual />
</section>

<!-- What’s playing, said once a song (and when it pauses), never per line. -->
<p class="visually-hidden" role="status" data-announce></p>

<!-- The three steps: the story's words for reading in order; where it doesn't run, a switch
     that puts the window above in each shape, with that step's words under it. -->
<section class="steps" id="after-app" tabindex="-1" aria-label="How featherplay steps back" data-steps data-bar-sec="app">
  <div class="frame steps-in">
    <Segmented class="shapes" name="win-shape" legend="featherplay’s window" options={steps.map((s) => ({ value: s.key, label: s.label, icon: s.key, phone: s.key !== "whole" }))} checked="whole" stretch="phone" data-shape-switch />
    <div class="says" aria-live="polite">
      {
        steps.map((s) => (
          <div class="step" data-step={s.key}>
            <h2 class="t-title">{s.h}</h2>
            <p class="t-lede ink2">{s.p}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { bindReplicas } from "../demo/replica";
  import { bindPieces } from "../demo/bind-pieces";
  import { startClock } from "../scripts/clock";
  import { startStory } from "../scripts/story";
  import { startFirst } from "../scripts/first";
  import { startShapes } from "../scripts/shapes";
  import { bindShelf } from "../scripts/shelf";
  const player = bindReplicas();
  if (player) {
    bindPieces(player);
    startFirst();
    const shelf = document.querySelector<HTMLElement>("[data-shelf]");
    if (shelf) bindShelf(shelf, player);
    startStory(player);
    startShapes(player);
  }
  // Sections out of view are marked so that a song's colour change fades only where it is seen
  // (system.css section[data-away]).
  if ("IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (es) => {
        for (const e of es) e.target.toggleAttribute("data-away", !e.isIntersecting);
      },
      { rootMargin: "64px" },
    );
    for (const s of document.querySelectorAll("main > section")) io.observe(s);
  }
  // The bar starts its own clock (Bar.astro).
  for (const el of document.querySelectorAll<HTMLElement>("[data-clock]:not([data-site-bar] *)")) startClock(el);
</script>

<style>
  /* Nothing placed on the stage (a note left where it was shown before a resize, the window
     on its way in) can widen the page: clipped at the sides, not a scroll box (the pin stays
     sticky). */
  .stage {
    position: relative;
    overflow-x: clip;
  }
  .anchor {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 1px;
  }
  .pin {
    position: relative;
  }

  /* The first screen without its composition (no script, or stacked by it): the headline
     across the top; under it the sentence, the buttons and the credit in a column on the left,
     the shelf under them, the window filling the room on the right. One column on a phone: the
     words, the window, the shelf. */
  .first {
    display: grid;
    grid-template-columns: minmax(16rem, 25rem) minmax(0, 1fr);
    grid-template-rows: auto auto minmax(0, 1fr);
    grid-template-areas:
      "head head"
      "col win"
      "shelf win";
    column-gap: var(--s7);
    row-gap: var(--s6);
    min-height: 100svh;
    padding-top: calc(var(--bar-h) + clamp(var(--s4), 5vh, var(--s8)));
    padding-bottom: clamp(var(--s4), 3vh, 40px);
  }
  .head {
    grid-area: head;
  }
  /* Each line its own box, as wide as its words (first.ts measures them). */
  .head .line {
    display: block;
    width: fit-content;
  }
  .first > :global(.shelf[data-off]),
  .first:is([data-laid="wide"], [data-laid="tall"]) > :global(.shelf[data-off]) {
    display: none;
  }
  /* (Right under the words: in a tall room its foot would otherwise fall to the screen's,
     leaving a hole between the words and the sleeves.) */
  .first > :global(.shelf) {
    grid-area: shelf;
    align-self: start;
    --sz: min(132px, (100vw - 2 * var(--gut) - 28px) / 3);
  }
  .col {
    grid-area: col;
    /* With script, as wide as the composition gives it, measured at that width (first.ts). */
    width: var(--col-w, auto);
    display: grid;
    align-content: start;
    gap: var(--s4);
  }
  /* The memory figure: the lede's own weight, a quiet underline to the numbers that prove it. */
  .lede-link {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);
    white-space: nowrap;
    transition: text-decoration-color var(--t-hover) ease;
  }
  .lede-link:hover {
    text-decoration-color: currentColor;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s3);
    margin-top: var(--s2);
  }
  .meta {
    margin-top: var(--s1);
  }
  /* One line for each system; the visitor's shows (boot.js sets data-os before the first
     paint), else the one that says what featherplay runs on. */
  [data-pick] > [data-for] {
    display: none;
  }
  .meta > [data-for="other"],
  :global(:root[data-os="windows"]) [data-pick] > [data-for="windows"],
  :global(:root[data-os="linux"]) [data-pick] > [data-for="linux"],
  :global(:root[data-os="linux-arm"]) [data-pick] > [data-for="linux-arm"] {
    display: inline;
  }
  :global(:root[data-os="windows"]) .meta:has(> [data-for="windows"]) > [data-for="other"],
  :global(:root[data-os="linux"]) .meta:has(> [data-for="linux"]) > [data-for="other"],
  :global(:root[data-os="linux-arm"]) .meta:has(> [data-for="linux-arm"]) > [data-for="other"] {
    display: none;
  }
  .play-first .pp {
    width: 18px;
    height: 18px;
  }
  .slot {
    grid-area: win;
    position: relative;
    min-height: 0;
  }
  /* Shown under the bar, never behind it. */
  .skip-app {
    position: absolute;
    z-index: 70;
    top: calc(var(--bar-h) + var(--s3));
  }
  .caps {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  /* Its ground, shadow, size and place are the script's (the window's own, as it resizes). */
  .ghost {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 9;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
    transform-origin: 0 0;
  }
  .cap {
    position: absolute;
    left: 0;
    top: 0;
    width: min(26rem, 100% - 2 * var(--gut));
    display: grid;
    gap: var(--s4);
    opacity: 0;
    visibility: hidden;
  }
  /* Focus is moved here (and to the stage) only to carry the keys on: no ring. */
  .stage:focus,
  .steps:focus {
    outline: none;
  }
  /* (No room under the last step: the section after brings its own, as every section does.) */
  .steps-in {
    display: grid;
    justify-items: start;
    gap: var(--s5);
    padding-block: var(--s8) 0;
  }
  .says {
    display: grid;
    gap: var(--s7);
    max-width: 36rem;
  }
  .step {
    display: grid;
    align-content: start;
    gap: var(--s4);
  }
  /* The switch is there where the steps are one (boot.js decides before the first paint). */
  :global(:root:not([data-shapes])) .shapes {
    display: none;
  }
  /* The switch shows one step's words at a time, all three in one place (as tall as the
     longest), so nothing under it moves as the pick changes. */
  :global(:root[data-shapes]) .says > .step {
    grid-area: 1 / 1;
  }
  :global(:root[data-shapes]) .says > .step:not([data-picked]) {
    visibility: hidden;
  }
  /* Right under the window it changes. The switch's name is for the ear: the words under
     it say what each shape is. */
  :global(:root[data-shapes]) .steps-in {
    padding-top: var(--s5);
  }
  /* On a desktop the switch is drawn right under the window (shapes.ts places it), its words
     where they were. */
  .steps[data-lifted] {
    position: relative;
  }
  .steps[data-lifted] .shapes {
    position: absolute;
  }
  .shapes :global(legend) {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* A short phone (360 x 740): the same words at the same sizes, closer together, and the
     size line left to the Download section, so the whole window fits on the first screen. */
  @media (width < 761px) and (height < 800px) {
    .first {
      row-gap: var(--s4);
    }
    .col {
      gap: var(--s3);
    }
    .actions {
      margin-top: 0;
    }
    .meta {
      display: none;
    }
  }
  @media (width < 761px) {
    .first {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      grid-template-areas:
        "head"
        "col"
        "win";
      min-height: 0;
      padding-bottom: 0;
    }
    /* As much room above the window as under it (the row gap and this; under it the steps'
       own top, the same sum). */
    .slot {
      margin-top: var(--s3);
    }
    :global(:root[data-shapes]) .steps-in {
      padding-top: calc(var(--s6) + var(--s3));
      gap: var(--s5);
      grid-template-areas:
        "lead"
        "switch"
        "say";
    }
    /* On a phone there is no Whole to pick (drawn at a phone's width, a whole window's text is
       a few px tall): its words lead the steps instead, under the window they describe (the
       whole player, in its narrow form there), then the switch and the picked step's words. */
    :global(:root[data-shapes]) .says {
      display: contents;
    }
    :global(:root[data-shapes]) .shapes {
      grid-area: switch;
    }
    :global(:root[data-shapes]) .says > .step {
      grid-area: say;
    }
    :global(:root[data-shapes]) .says > .step[data-step="whole"] {
      grid-area: lead;
      visibility: visible;
    }
    /* The bar's song button picks a song on a phone: the shelf of sleeves would be a second
       way to do it, and Make it yours has a third. */
    .first > :global(.shelf),
    .first > :global(.n-sleeves) {
      display: none;
    }
    /* The three steps as one short run: the headings a step down, closer. */
    .says {
      gap: var(--s6);
    }
    .step {
      gap: var(--s2);
    }
    .step > .t-title {
      font-size: var(--fs-subtitle);
      line-height: var(--lh-subtitle);
      letter-spacing: var(--tr-subtitle);
    }
    /* The headline as large as lets its first line fit the phone's width. */
    .head {
      font-size: clamp(2rem, 8.7vw, 3.4rem);
    }
    /* In small viewport units: a phone's toolbar showing and hiding never resizes the window;
       never taller than the screen under the bar. */
    .slot {
      height: clamp(26rem, 78svh, 47rem);
      max-height: calc(100svh - var(--bar-h) - 16px);
    }
  }

  /* A short phone's closer rows: the same room under the window as above it (after the phone's
     own rule, which it overrides). */
  @media (width < 761px) and (height < 800px) {
    :global(:root[data-shapes]) .steps-in {
      padding-top: calc(var(--s4) + var(--s3));
    }
  }
  /* With script, the first screen shows once it is laid out (first.ts), never half-placed. */
  :global(:root.js) .first:not([data-shown]) {
    visibility: hidden;
  }
  /* Composed (first.ts): every part placed in the room's own coordinates. */
  .first:is([data-laid="wide"], [data-laid="tall"]) {
    display: block;
    position: relative;
    width: 100%;
    max-width: none;
    height: var(--first-h, 100svh);
    min-height: 0;
    margin: 0;
    padding: 0;
  }
  .first:is([data-laid="wide"], [data-laid="tall"]) > :is(.head, .col, .slot) {
    position: absolute;
    margin: 0;
  }
  .first:is([data-laid="wide"], [data-laid="tall"]) > .head {
    left: var(--hx);
    top: var(--hy);
    width: max-content;
  }
  .first:is([data-laid="wide"], [data-laid="tall"]) > .col {
    left: var(--hx);
    top: var(--cy);
    width: var(--col-w);
  }
  /* (Its own rule: the shelf is another component's, which a scoped group wouldn't reach.) */
  .first:is([data-laid="wide"], [data-laid="tall"]) > :global(.shelf) {
    position: absolute;
    margin: 0;
    left: var(--sx);
    top: var(--sy);
  }
  /* The two notes the composition places, in the room's coordinates; they step aside while the
     window is away from home (dragged, maximised, in the tray). */
  .first > :global(.hand[data-note-manual]) {
    position: absolute;
    z-index: 5;
  }
  :global(.stage[data-win-away]) .first > :global(.hand) {
    opacity: 0 !important;
  }

  /* The story runs (story.ts sets data-story on the root): the stage is pinned for its length,
     and the steps are words for reading in order only (the captions show them). */
  :global(:root[data-story]) .stage {
    height: calc(100svh + var(--story-len, 2400px));
  }
  :global(:root[data-story]) .pin {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: clip;
  }
  :global(:root[data-story]) .first,
  :global(:root[data-story]) .first[data-laid] {
    height: 100svh;
    min-height: 0;
  }
  :global(:root[data-story]) .steps {
    position: absolute !important;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
