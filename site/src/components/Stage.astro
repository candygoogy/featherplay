---
// The first screen, and the window stepping back as the page moves (the scroll story): one
// pinned stage. The first screen is the study's composition (src/scripts/first.ts): the
// headline top left, the sentence and buttons under it, a shelf of the six sleeves under the
// words, the window from the middle of the headline's second line as large as the room allows
// (or the words and the shelf side by side over a full-width window in tall rooms; one column
// on phones). Without script, a plain grid of the same parts. Where the story runs (src/scripts/story.ts: a pointer-sized
// screen, motion allowed) the stage is pinned for its length and the window takes three holds:
// whole, narrow, in the tray. Elsewhere (phones, short windows, reduced motion, no script) the
// window sits in its slot and the three steps are plain blocks under it.
import Window from "./Window.astro";
import NowPlaying from "./NowPlaying.astro";
import Logo from "./Logo.astro";
import Note from "./Note.astro";
import DlGlyph from "./DlGlyph.astro";
import Shelf from "./Shelf.astro";
import TrayTip from "./pieces/TrayTip.astro";
import { release, sizeLabel } from "../data/release";
import { songs } from "../data/songs";

const main = release.installer ?? release.portable;
const steps = [
  { h: "A whole player when you want one.", p: "Home, your library, synced lyrics and the queue, in one native window." },
  { h: "Narrow, beside your work.", p: "Down to 480 px wide it keeps the cover, the lyrics and the bar." },
  {
    h: "Or nothing at all.",
    p: "Closed to the tray it keeps playing: 39 MB of memory, one process. Your media keys still work.",
  },
];
---

<section class="stage" id="app" tabindex="-1" data-stage aria-labelledby="hero-title">
  <span class="anchor" id="top" aria-hidden="true"></span>
  <div class="pin" data-pin>
    <div class="frame first" data-first>
      <h1 id="hero-title" class="t-display head" data-head><span class="line">Light enough to forget</span> <span class="line">it’s running.</span></h1>
      <div class="col" data-col>
        <p class="t-lede">featherplay is a free, native player for YouTube&nbsp;Music on Windows and Linux.</p>
        <div class="actions">
          <a class="btn red" href="#download">
            <DlGlyph />
            Download for Windows
          </a>
          <button class="btn tonal play-first" type="button" data-do="toggle" data-play-toggle hidden>
            <span class="pp" aria-hidden="true">
              <svg class="i-play" viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M8 5.2 V18.8 C8 19.4 8.7 19.8 9.2 19.4 L19.2 12.7 C19.7 12.4 19.7 11.6 19.2 11.3 L9.2 4.6 C8.7 4.2 8 4.6 8 5.2 Z"></path></svg>
              <svg class="i-pause" viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M7 5.5 C7 5.2 7.2 5 7.5 5 H9.5 C9.8 5 10 5.2 10 5.5 V18.5 C10 18.8 9.8 19 9.5 19 H7.5 C7.2 19 7 18.8 7 18.5 Z M14 5.5 C14 5.2 14.2 5 14.5 5 H16.5 C16.8 5 17 5.2 17 5.5 V18.5 C17 18.8 16.8 19 16.5 19 H14.5 C14.2 19 14 18.8 14 18.5 Z"></path></svg>
            </span>
            <span data-play-toggle-text>Play a song</span>
          </button>
        </div>
        {main && <p class="t-small ink2 meta">{sizeLabel(main).replace(" ", " ")}, version {release.version}</p>}
        <NowPlaying class="credit" />
      </div>
      <Shelf />
      <Note id="screenshot" free underline class="n-screenshot" manual />
      <Note id="sleeves" free class="n-sleeves" manual />
      <a class="skip skip-app" href="#after-app" data-before-replica>Skip past the app</a>
      <div class="slot" data-win-slot>
        <Window />
      </div>
    </div>
    <!-- The story's change of shape: the window's ground carrying the app's icon, as Windows
         draws a window snapping, and the snap outline where it goes. -->
    <div class="ghost" data-ghost aria-hidden="true"></div>
    <span class="ghost-icon" data-ghost-icon aria-hidden="true"><Logo size={56} /></span>
    <!-- The three holds' captions, laid out by the story (the same words are in the steps below,
         read in order). -->
    <div class="caps" aria-hidden="true">
      {
        steps.map((s, i) => (
          <div class="cap" data-cap={i}>
            <p class="t-title">{s.h}</p>
            <p class="t-lede">{s.p}</p>
          </div>
        ))
      }
    </div>
  </div>
  <!-- Notes their scripts place: by the tray icon the first time the window comes back from
       it (src/demo/window.ts), and beside the tray's flyout in the story's last hold. -->
  <Note id="opens" arrow="up-left" class="n-opens" manual />
  <Note id="playing" arrow="up-left" class="n-playing" manual />
</section>

<!-- What’s playing, said once a song (and when it pauses), never per line. -->
<p class="visually-hidden" role="status" data-announce></p>

<!-- The three steps: the story's words for reading in order, and plain blocks where it doesn't run. -->
<section class="steps" id="after-app" tabindex="-1" aria-label="How featherplay steps back" data-steps data-bar-sec="app">
  <div class="frame steps-in">
    {
      steps.map((s, i) => (
        <div class="step">
          {/* Each step's small picture: the whole app, the narrow one (the app in miniature, drawn
              from its own parts: the playing cover, the queue's covers, its red play button), the
              tray corner. */}
          {i < 2 ? (
            <div class:list={["mini", i === 0 ? "wide" : "narrow"]} aria-hidden="true">
              <span class="m-title">
                <Logo size={10} />
                <svg class="m-caps" viewBox="0 0 34 8" width="34" height="8" fill="none" stroke="currentColor" stroke-linecap="round"><path d="M1 4h6M14.5 1.5h5v5h-5zM27.5 1.5l5 5M32.5 1.5l-5 5" vector-effect="non-scaling-stroke" /></svg>
              </span>
              <span class="m-body">
                <span class="m-now">
                  <img class="m-cover" data-mini-cover src={songs[0].cover} width="96" height="96" alt="" loading="lazy" decoding="async" />
                  <span class="m-names">
                    <i />
                    <i />
                  </span>
                </span>
                <span class="m-lines">
                  <i />
                  <i />
                  <i class="on" />
                  <i />
                  <i />
                  <i />
                </span>
              </span>
              {i === 0 && (
                <span class="m-side">
                  <i class="m-tabs" />
                  {songs.slice(0, 5).map((q) => (
                    <span class="m-row">
                      <img src={q.cover} width="24" height="24" alt="" loading="lazy" decoding="async" />
                      <span>
                        <i />
                        <i />
                      </span>
                    </span>
                  ))}
                </span>
              )}
              <span class="m-bar">
                <img class="m-thumb" data-mini-cover src={songs[0].cover} width="32" height="32" alt="" loading="lazy" decoding="async" />
                <span class="m-ctl">
                  <i />
                  <i class="m-play" />
                  <i />
                </span>
                <i class="m-prog" />
              </span>
            </div>
          ) : (
            <div class="mini-tray">
              <TrayTip corner />
            </div>
          )}
          <h2 class="t-title">{s.h}</h2>
          <p class="t-lede ink2">{s.p}</p>
        </div>
      ))
    }
  </div>
</section>

<script>
  import { bindReplicas } from "../demo/replica";
  import { bindPieces } from "../demo/bind-pieces";
  import { startClock } from "../scripts/clock";
  import { startStory } from "../scripts/story";
  import { startFirst } from "../scripts/first";
  import { bindShelf } from "../scripts/shelf";
  const player = bindReplicas();
  if (player) {
    bindPieces(player);
    startFirst();
    const shelf = document.querySelector<HTMLElement>("[data-shelf]");
    if (shelf) bindShelf(shelf, player);
    startStory(player);
    // The steps' small pictures show the cover that is playing.
    const minis = document.querySelectorAll<HTMLImageElement>("[data-mini-cover]");
    let miniSong = "";
    if (minis.length)
      player.subscribe((s) => {
        if (!s.song || s.song.id === miniSong) return;
        miniSong = s.song.id;
        for (const m of minis) if (m.getAttribute("src") !== s.song.cover) m.src = s.song.cover;
      });
  }
  // Sections out of view are marked so that a song's colour change fades only where it is seen
  // (system.css section[data-away]).
  if ("IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (es) => {
        for (const e of es) e.target.toggleAttribute("data-away", !e.isIntersecting);
      },
      { rootMargin: "64px" },
    );
    for (const s of document.querySelectorAll("main > section")) io.observe(s);
  }
  // The bar starts its own clock (Bar.astro).
  for (const el of document.querySelectorAll<HTMLElement>("[data-clock]:not([data-site-bar] *)")) startClock(el);
</script>

<style>
  /* Nothing placed on the stage (a note left where it was shown before a resize, the window
     on its way in) can widen the page: clipped at the sides, not a scroll box (the pin stays
     sticky). */
  .stage {
    position: relative;
    overflow-x: clip;
  }
  .anchor {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 1px;
  }
  .pin {
    position: relative;
  }

  /* The first screen without its composition (no script, or stacked by it): the headline
     across the top; under it the sentence, the buttons and the credit in a column on the left,
     the shelf under them, the window filling the room on the right. One column on a phone: the
     words, the window, the shelf. */
  .first {
    display: grid;
    grid-template-columns: minmax(16rem, 25rem) minmax(0, 1fr);
    grid-template-rows: auto auto minmax(0, 1fr);
    grid-template-areas:
      "head head"
      "col win"
      "shelf win";
    column-gap: var(--s7);
    row-gap: var(--s6);
    min-height: 100svh;
    padding-top: calc(var(--bar-h) + clamp(var(--s4), 5vh, var(--s8)));
    padding-bottom: clamp(var(--s4), 3vh, 40px);
  }
  .head {
    grid-area: head;
  }
  /* Each line its own box, as wide as its words (first.ts measures them). */
  .head .line {
    display: block;
    width: fit-content;
  }
  .first > :global(.shelf[data-off]),
  .first:is([data-laid="wide"], [data-laid="tall"]) > :global(.shelf[data-off]) {
    display: none;
  }
  /* (Right under the words: in a tall room its foot would otherwise fall to the screen's,
     leaving a hole between the words and the sleeves.) */
  .first > :global(.shelf) {
    grid-area: shelf;
    align-self: start;
    --sz: min(132px, (100vw - 2 * var(--gut) - 28px) / 3);
  }
  .col {
    grid-area: col;
    /* With script, as wide as the composition gives it, measured at that width (first.ts). */
    width: var(--col-w, auto);
    display: grid;
    align-content: start;
    gap: var(--s4);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s3);
    margin-top: var(--s2);
  }
  .meta {
    margin-top: var(--s1);
  }
  .play-first .pp {
    width: 18px;
    height: 18px;
  }
  .slot {
    grid-area: win;
    position: relative;
    min-height: 0;
  }
  /* Shown under the bar, never behind it. */
  .skip-app {
    position: absolute;
    z-index: 70;
    top: calc(var(--bar-h) + var(--s3));
  }
  .caps {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .ghost,
  .ghost-icon {
    position: absolute;
    left: 0;
    top: 0;
    opacity: 0;
    pointer-events: none;
  }
  .ghost {
    z-index: 9;
    border-radius: var(--r-small);
    background: var(--bg);
    box-shadow: var(--ring), var(--shadow);
    transform-origin: 0 0;
  }
  .ghost-icon {
    z-index: 11;
  }
  /* On Now playing and lyrics (story.ts marks the stage) the ground is that view's own, the
     song's colour as the app paints it (replica.css --stage), and carries no icon: the window
     keeps its colour all the way, where a plain ground read as a blank box. */
  .stage[data-ghost-now] .ghost {
    background: color-mix(in srgb, var(--song) 60%, #0f0f0f);
  }
  .stage[data-ghost-now] .ghost-icon {
    display: none;
  }
  .cap {
    position: absolute;
    left: 0;
    top: 0;
    width: min(26rem, 100% - 2 * var(--gut));
    display: grid;
    gap: var(--s4);
    opacity: 0;
    visibility: hidden;
  }
  /* Focus is moved here (and to the stage) only to carry the keys on: no ring. */
  .stage:focus,
  .steps:focus {
    outline: none;
  }
  /* (No room under the last step: the section after brings its own, as every section does.) */
  .steps-in {
    display: grid;
    gap: var(--s7);
    padding-block: var(--s8) 0;
  }
  .step {
    display: grid;
    gap: var(--s4);
    max-width: 36rem;
  }
  /* The small pictures: the app in miniature on the lyrics view, in the song's colour, the
     whole one wide with its queue beside the lyrics, the narrow one tall; the tray corner is
     the live piece. Sized in --u, a 100th of the wide one's width (its own container's), so
     the two are drawn at one scale and keep their proportions at any width. */
  .mini {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-rows: auto minmax(0, 1fr);
    overflow: hidden;
    margin-bottom: var(--s2);
    border-radius: 8px;
    background: var(--surface);
    box-shadow: var(--lit), var(--ring), var(--shadow);
    container-type: inline-size;
  }
  .mini.wide {
    --u: 1cqw;
    width: min(22rem, 100%);
    aspect-ratio: 16 / 10;
  }
  .mini.narrow {
    --u: 2.26cqw;
    width: 9.75rem;
    aspect-ratio: 480 / 660;
  }
  .m-title {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: calc(5.6 * var(--u));
    padding-inline: calc(2.2 * var(--u));
    background: color-mix(in srgb, var(--text) 6%, var(--surface));
    color: var(--ink2);
  }
  .m-title :global(.logo) {
    --logo: calc(3.2 * var(--u)) !important;
  }
  .m-caps {
    width: auto;
    height: calc(2 * var(--u));
    stroke-width: 1;
  }
  .m-body {
    display: flex;
    gap: calc(5.5 * var(--u));
    min-width: 0;
    padding: calc(5 * var(--u)) calc(4.5 * var(--u)) calc(14 * var(--u));
    background: color-mix(in srgb, var(--song) 72%, #000);
    transition: background-color var(--paint, 0s) ease;
  }
  .m-now {
    display: grid;
    flex: none;
    align-content: start;
    gap: calc(2.6 * var(--u));
    width: calc(18 * var(--u));
  }
  .m-cover {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    border-radius: calc(1.5 * var(--u));
    box-shadow: 0 calc(1 * var(--u)) calc(3.5 * var(--u)) rgb(0 0 0 / 0.32);
  }
  .m-names {
    display: grid;
    gap: calc(1.3 * var(--u));
  }
  .m-names i,
  .m-lines i,
  .m-row i {
    display: block;
    border-radius: 99px;
  }
  .m-names i {
    width: 92%;
    height: calc(1.6 * var(--u));
    background: rgb(255 255 255 / 0.92);
  }
  .m-names i + i {
    width: 58%;
    height: calc(1.1 * var(--u));
    background: rgb(255 255 255 / 0.55);
  }
  .m-lines {
    display: grid;
    flex: 1;
    align-content: start;
    gap: calc(2.7 * var(--u));
    min-width: 0;
    padding-top: calc(1 * var(--u));
  }
  .m-lines i {
    width: 66%;
    height: calc(1.5 * var(--u));
    background: rgb(255 255 255 / 0.42);
  }
  .m-lines i:nth-child(2) {
    width: 74%;
  }
  .m-lines i.on {
    width: 86%;
    background: #fff;
  }
  .m-lines i:nth-child(4) {
    width: 58%;
  }
  .m-lines i:nth-child(5) {
    width: 80%;
  }
  /* The queue beside the lyrics: its two tabs, then a cover and two lines a row. */
  .m-side {
    display: grid;
    align-content: start;
    gap: calc(2.5 * var(--u));
    width: calc(31 * var(--u));
    padding: calc(3 * var(--u)) calc(2.8 * var(--u));
    background: color-mix(in srgb, var(--text) 2%, var(--surface));
  }
  .m-tabs {
    height: calc(3.8 * var(--u));
    border-radius: 99px;
    background: linear-gradient(90deg, color-mix(in srgb, var(--song) 46%, var(--surface)) 50%, color-mix(in srgb, var(--text) 9%, var(--surface)) 50%);
  }
  .m-row {
    display: flex;
    align-items: center;
    gap: calc(2 * var(--u));
  }
  .m-row img {
    flex: none;
    width: calc(4.6 * var(--u));
    height: calc(4.6 * var(--u));
    border-radius: calc(1 * var(--u));
  }
  .m-row > span {
    display: grid;
    flex: 1;
    gap: calc(1 * var(--u));
  }
  .m-row i {
    width: 78%;
    height: calc(1.1 * var(--u));
    background: color-mix(in srgb, var(--text) 62%, transparent);
  }
  .m-row i + i {
    width: 48%;
    background: color-mix(in srgb, var(--text) 30%, transparent);
  }
  .m-row:nth-child(2n) i {
    width: 62%;
  }
  .m-row:nth-child(2n) i + i {
    width: 40%;
  }
  /* The player's bar, floating over the foot of both as in the app: the cover, the red play
     button between its neighbours, the line of the song under them. */
  .m-bar {
    position: absolute;
    inset: auto calc(2.4 * var(--u)) calc(2.4 * var(--u));
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: calc(9.4 * var(--u));
    padding-inline: calc(2 * var(--u));
    border-radius: calc(2.8 * var(--u));
    background: color-mix(in srgb, var(--song) 14%, var(--surface));
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--text) 9%, transparent),
      0 calc(1 * var(--u)) calc(4 * var(--u)) rgb(0 0 0 / 0.28);
  }
  .m-thumb {
    width: calc(5.8 * var(--u));
    height: calc(5.8 * var(--u));
    border-radius: calc(1.2 * var(--u));
  }
  .m-ctl {
    display: flex;
    align-items: center;
    gap: calc(2.4 * var(--u));
    translate: 0 calc(-0.9 * var(--u));
  }
  .m-ctl i {
    width: calc(1.7 * var(--u));
    height: calc(1.7 * var(--u));
    border-radius: 50%;
    background: color-mix(in srgb, var(--text) 62%, transparent);
  }
  .m-ctl .m-play {
    display: grid;
    place-items: center;
    width: calc(4.8 * var(--u));
    height: calc(4.8 * var(--u));
    background: var(--accent);
  }
  .m-play::after {
    content: "";
    width: calc(1.6 * var(--u));
    height: calc(1.9 * var(--u));
    margin-left: calc(0.35 * var(--u));
    background: var(--on-accent);
    clip-path: polygon(0 0, 100% 50%, 0 100%);
  }
  .m-prog {
    position: absolute;
    inset: auto 30% calc(1.3 * var(--u));
    height: calc(0.7 * var(--u));
    border-radius: 99px;
    background: linear-gradient(90deg, var(--accent) 38%, color-mix(in srgb, var(--text) 18%, transparent) 38%);
  }
  /* The narrow window: the cover beside the song's name over the lyrics, no queue. */
  .mini.narrow .m-body {
    flex-direction: column;
    gap: calc(4.5 * var(--u));
    padding: calc(4.5 * var(--u)) calc(4.5 * var(--u)) calc(14 * var(--u));
  }
  .mini.narrow .m-now {
    display: flex;
    align-items: center;
    gap: calc(3.2 * var(--u));
    width: auto;
  }
  .mini.narrow .m-cover {
    width: calc(15 * var(--u));
  }
  .mini.narrow .m-names {
    flex: 1;
  }
  .mini.narrow .m-lines {
    flex: none;
    padding-top: 0;
  }
  .mini.narrow .m-prog {
    inset-inline: 26%;
  }
  .mini-tray {
    justify-self: start;
    margin-bottom: var(--s2);
  }

  /* A short phone (360 x 740): the same words at the same sizes, closer together, and the
     size line left to the Download section, so the whole window fits on the first screen. */
  @media (width < 761px) and (height < 800px) {
    .first {
      row-gap: var(--s4);
    }
    .col {
      gap: var(--s3);
    }
    .actions {
      margin-top: 0;
    }
    .meta {
      display: none;
    }
  }
  @media (width < 761px) {
    .first {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      grid-template-areas:
        "head"
        "col"
        "win"
        "shelf";
      min-height: 0;
    }
    .first > :global(.shelf) {
      align-self: start;
      margin-top: var(--s3);
    }
    /* The headline as large as lets its first line fit the phone's width. */
    .head {
      font-size: clamp(2rem, 8.7vw, 3.4rem);
    }
    /* In small viewport units: a phone's toolbar showing and hiding never resizes the window;
       never taller than the screen under the bar. */
    .slot {
      height: clamp(26rem, 78svh, 47rem);
      max-height: calc(100svh - var(--bar-h) - 16px);
    }
  }

  /* With script, the first screen shows once it is laid out (first.ts), never half-placed. */
  :global(:root.js) .first:not([data-shown]) {
    visibility: hidden;
  }
  /* Composed (first.ts): every part placed in the room's own coordinates. */
  .first:is([data-laid="wide"], [data-laid="tall"]) {
    display: block;
    position: relative;
    width: 100%;
    max-width: none;
    height: var(--first-h, 100svh);
    min-height: 0;
    margin: 0;
    padding: 0;
  }
  .first:is([data-laid="wide"], [data-laid="tall"]) > :is(.head, .col, .slot) {
    position: absolute;
    margin: 0;
  }
  .first:is([data-laid="wide"], [data-laid="tall"]) > .head {
    left: var(--hx);
    top: var(--hy);
    width: max-content;
  }
  .first:is([data-laid="wide"], [data-laid="tall"]) > .col {
    left: var(--hx);
    top: var(--cy);
    width: var(--col-w);
  }
  /* (Its own rule: the shelf is another component's, which a scoped group wouldn't reach.) */
