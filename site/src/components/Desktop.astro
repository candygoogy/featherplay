---
// A Windows 11-style desktop at 1440x900: our own wallpaper ("Folded Light", three ribbons
// that turn over once; its generator script is kept outside the repo)
// in the cover glow's colour, dark or light with the page, a centred
// taskbar with a neutral Start glyph (no Microsoft logo), featherplay pinned and running,
// and the tray with featherplay's icon, its real two-line hover text, and the visitor's
// clock. Its windows go in the slot.
interface Props {
  tooltip?: [string, string];
  id?: string;
}
const { tooltip = ["featherplay", "Nothing playing"], id = "desktop" } = Astro.props;
const tipId = `${id}-tray-tip`;
---

<div class="desktop" data-desktop data-ui>
  <div class="wallpaper" aria-hidden="true"></div>
  <div class="windows">
    <slot />
  </div>
  <div class="taskbar">
    <div class="pinned">
      <span class="tb start" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="22" height="22"
          ><circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="2"></circle><circle
            cx="12"
            cy="12"
            r="2.6"
            fill="currentColor"></circle></svg
        >
      </span>
      <span class="tb" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="20" height="20"
          ><path
            d="M10.5 4.5 a6 6 0 1 0 0.01 0 Z M15 15 L19.5 19.5"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"></path></svg
        >
      </span>
      <span class="tb" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="22" height="22"
          ><path d="M3.5 7.5a2 2 0 0 1 2-2h4l2 2.2h7a2 2 0 0 1 2 2V17a2 2 0 0 1-2 2h-13a2 2 0 0 1-2-2Z" fill="#E8B94A"
          ></path><path d="M3.5 10h17V17a2 2 0 0 1-2 2h-13a2 2 0 0 1-2-2Z" fill="#F4CC63"></path></svg
        >
      </span>
      <button class="tb running" type="button" data-taskbar-app aria-label="featherplay window">
        <span class="art" aria-hidden="true">
          <img class="only-dark" src="/tri-vane.svg" width="24" height="24" alt="" />
          <img class="only-light" src="/tri-vane-light.svg" width="24" height="24" alt="" />
        </span>
      </button>
    </div>
    <div class="tray">
      <span class="tb small" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="16" height="16"
          ><path d="M7.5 14 L12 9.5 L16.5 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
          ></path></svg
        >
      </span>
      <span class="tray-slot">
        <button class="tb small tray-icon" type="button" data-tray-icon aria-describedby={tipId}>
          <span class="visually-hidden">featherplay in the notification area</span>
          <span class="art" aria-hidden="true">
            <img class="only-dark" src="/tri-vane.svg" width="18" height="18" alt="" />
            <img class="only-light" src="/tri-vane-light.svg" width="18" height="18" alt="" />
          </span>
        </button>
        <span class="tray-tip" role="tooltip" id={tipId} data-tray-tip>
          <span data-tray-line="1">{tooltip[0]}</span>
          <span data-tray-line="2">{tooltip[1]}</span>
        </span>
      </span>
      <span class="tb status" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="18" height="18"
          ><path
            d="M3.5 9.5a12 12 0 0 1 17 0M6.5 12.6a7.6 7.6 0 0 1 11 0M9.4 15.6a3.4 3.4 0 0 1 5.2 0"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"></path><circle cx="12" cy="18.6" r="1.2" fill="currentColor"></circle></svg
        >
        <svg viewBox="0 0 24 24" width="18" height="18"
          ><path
            d="M4 9.5 H7.5 L12 5.5 V18.5 L7.5 14.5 H4 Z M15.5 9.5 A3.5 3.5 0 0 1 15.5 14.5 M18 7 A7 7 0 0 1 18 17"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linejoin="round"
            stroke-linecap="round"></path></svg
        >
      </span>
      <time class="clock" data-clock>
        <span data-clock-time></span>
        <span data-clock-date></span>
      </time>
    </div>
  </div>
</div>

<script>
  import { startClock } from "../scripts/clock";
  for (const el of document.querySelectorAll<HTMLElement>("[data-clock]")) startClock(el);
  // The wallpaper's folds load once the page is idle: at rest the window covers all but its
  // edges, and the flat colour stands in until then.
  const wall = () => {
    for (const d of document.querySelectorAll<HTMLElement>("[data-desktop]")) d.dataset.wall = "";
  };
  if ("requestIdleCallback" in window) requestIdleCallback(wall, { timeout: 2500 });
  else setTimeout(wall, 1200);
</script>

<style>
  .desktop {
    overflow: hidden;
    font-family: var(--font-ui);
    color: var(--text);
    background: #000;
  }

  .wallpaper {
    position: absolute;
    inset: 0;
    isolation: isolate;
    /* The song's colour mixed into the ground, a little deeper in the dark theme; both ease
       with the page's theme (--wall-ground, --light). */
    background: color-mix(in srgb, var(--glow) calc(34% - 8% * var(--light)), var(--wall-ground));
    /* It eases to the next song's colour with the page's glow (--glow is a registered colour). */
    transition: background-color var(--t-glow) ease;
  }
  /* The folds: light and shade in grey, laid over the song's colour with an overlay blend, so
     they take every cover's hue (and ease with it). AVIF only, about 8 KB each: a browser
     without it keeps the flat colour. Nothing on the desktop sits on them but the windows and
     the taskbar, which have grounds of their own. The dark theme's folds are ::before, the
     light's ::after: they cross-fade on --light as the theme changes, and fade in together
     (--wall-in) once they load. */
  @property --wall-in {
    syntax: "<number>";
    inherits: false;
    initial-value: 0;
  }
  .wallpaper::before,
  .wallpaper::after {
    content: "";
    position: absolute;
    inset: 0;
    mix-blend-mode: overlay;
    background: center / cover no-repeat;
    transition: --wall-in 400ms ease;
  }
  .wallpaper::before {
    opacity: calc(var(--wall-in) * (1 - var(--light)));
  }
  .wallpaper::after {
    opacity: calc(var(--wall-in) * var(--light));
  }
  [data-wall] .wallpaper::before {
    --wall-in: 1;
    background-image: url("/wallpaper/wallpaper-dark.avif");
  }
  [data-wall] .wallpaper::after {
    --wall-in: 1;
    background-image: url("/wallpaper/wallpaper-light.avif");
  }

  .windows {
    position: absolute;
    inset: 0 0 48px 0;
  }

  .taskbar {
    position: absolute;
    inset: auto 0 0 0;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--taskbar);
    color: var(--taskbar-ink);
    box-shadow: 0 -1px 0 var(--taskbar-rim); /* taste-skill-ignore: Windows' own taskbar and tooltip */
  }
  .pinned {
    display: flex;
    gap: 4px;
  }
  .tb {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 4px;
    background: transparent;
    color: inherit;
    padding: 0;
  }
  .tb.small {
    width: 28px;
  }
  .start {
    color: var(--start-ink);
  }
  .running {
    background: var(--taskbar-hover);
    transition: background-color var(--t-hover) ease;
  }
  button.tb {
    cursor: pointer;
  }
  .running:hover {
    background: var(--taskbar-hover-strong);
  }
  /* Minimised: the button rests and its mark shrinks to a dot, as in Windows. */
  [data-minimised] .running {
    background: transparent;
  }
  [data-minimised] .running::after {
    width: 6px;
    margin-left: -3px;
    background: var(--taskbar-dot);
  }
  .running::after {
    content: "";
    position: absolute;
    bottom: 2px;
    left: 50%;
    width: 16px;
    height: 3px;
    margin-left: -8px;
    border-radius: 2px;
    background: var(--accent);
  }

  .tray {
    position: absolute;
    right: 12px;
    top: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    gap: 2px;
  }
  .tray-slot {
    position: relative;
    display: inline-flex;
  }
  .tray-icon {
    cursor: default;
    transition: background-color var(--t-hover) ease;
  }
  .tray-icon:hover,
  .tray-icon:focus-visible {
    background: var(--taskbar-hover);
  }
  .tray-icon:focus-visible {
    outline-offset: 0;
  }
  .status {
    display: inline-flex;
    gap: 8px;
    width: auto;
    padding: 0 8px;
  }
  .clock {
    display: grid;
    justify-items: end;
    min-width: 76px;
    padding: 0 8px;
    font-size: 12px;
    line-height: 16px;
  }

  /* Windows' own tooltip: plain, two lines, after a short rest on the icon. */
  .tray-tip {
    position: absolute;
    bottom: calc(100% + 14px);
    left: 50%;
    display: grid;
    padding: 6px 9px;
    white-space: nowrap;
    border-radius: 6px;
    background: var(--tip);
    box-shadow: /* taste-skill-ignore: Windows' own taskbar and tooltip */
      0 0 0 1px var(--tip-edge),
      0 8px 20px #00000040;
    color: var(--text);
    font-size: 12px;
    line-height: 17px;
    transform: translateX(-50%);
    visibility: hidden;
    opacity: 0;
    transition:
      opacity var(--t-fast) ease,
      visibility 0s linear var(--t-fast);
    pointer-events: none;
  }
  .tray-icon:hover + .tray-tip,
  .tray-icon:focus + .tray-tip {
    visibility: visible;
    opacity: 1;
    transition:
      opacity var(--t-fast) ease 400ms,
      visibility 0s linear 400ms;
  }
</style>
