---
// The footer: one frosted panel in the docked bar's material (the page opens with a frosted bar
// and closes with its sibling), five columns (featherplay and what it runs on, then Product,
// Project, Help, Legal), then, under a hairline, one line of small print and the way back up.
// The frost is painted: only the still desk lies behind it. No large name. Outside links from
// src/data/links.ts.
import { release } from "../data/release";
import { links } from "../data/links";
import Logo from "./Logo.astro";

const groups = [
  {
    id: "foot-product",
    title: "Product",
    items: [
      { label: "Download", href: "/#download" },
      { label: "Features", href: "/#kept" },
      { label: "Lyrics", href: "/#lyrics" },
      { label: "How light?", href: "/#light" },
      { label: "Make it yours", href: "/#yours" },
    ],
  },
  {
    id: "foot-project",
    title: "Project",
    items: [
      { label: "GitHub", href: links.repo },
      { label: "Releases and changes", href: links.releases },
      { label: "Report a bug", href: links.issues },
      { label: "How we measured", href: "/method" },
    ],
  },
  {
    id: "foot-help",
    title: "Help",
    items: [
      { label: "Questions", href: "/#questions" },
      { label: "What it connects to", href: "/#connects" },
      { label: "Uninstalling", href: "/#uninstall" },
      { label: "Coming from Pear", href: links.comingFromPear },
    ],
  },
  {
    id: "foot-legal",
    title: "Legal",
    items: [
      { label: "MIT licence", href: links.licence },
      { label: "Third-party licences", href: links.thirdParty },
      { label: "Unofficial notice", href: "/#official" },
      { label: "Music credits", href: "/credits" },
    ],
  },
];
---

<footer class="foot">
  <div class="frame">
    <div class="foot-panel">
      <div class="foot-cols">
        <div class="fgroup about">
          <h2 id="foot-about"><Logo size={18} />featherplay</h2>
          <ul aria-labelledby="foot-about">
            <li>Version {release.version}</li>
            <li>Windows 10 and 11, 64-bit</li>
            <li>Linux (experimental), glibc 2.35+</li>
            <li>Free and open source</li>
          </ul>
        </div>
        <nav class="foot-links" aria-label="More from featherplay">
          {
            groups.map((g) => (
              <div class="fgroup">
                <h2 id={g.id}>{g.title}</h2>
                <ul aria-labelledby={g.id}>
                  {g.items.map((l) => (
                    <li>
                      <a class="fl" href={l.href}>
                        {l.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </nav>
      </div>
      <div class="foot-legal">
        <ul class="foot-fine">
          <li>© 2026&nbsp;<a class="fl" href={links.author}>candygoogy</a></li>
          <li>Free and unofficial. Not made by or affiliated with Google or YouTube.</li>
          <li><a class="fl" href="/#connects">Privacy</a></li>
        </ul>
        <a class="to-top" href="#top">
          Back to top
          <span class="to-top-key" aria-hidden="true">
            <svg viewBox="0 0 16 52" width="16" height="52" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M8 13V3.5M3.75 7.5 8 3.25l4.25 4.25M8 49V39.5M3.75 43.5 8 39.25l4.25 4.25"></path></svg>
          </span>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .foot {
    position: relative;
    margin-top: var(--s8);
    padding-bottom: var(--s7);
  }
  .foot-panel {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: var(--r-float);
    /* Painted (the still desk is all that passes under it): the capsule's denser tint. */
    background: var(--pane-hl), var(--mat-capsule);
    box-shadow: var(--pane-edge), var(--pane-rim);
  }
  .foot-panel::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--grain) 0 0 / 96px;
    opacity: var(--pane-grain);
    pointer-events: none;
  }
  .foot-cols {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) repeat(4, minmax(0, 1fr));
    gap: var(--s7) var(--s6);
    align-items: start;
    padding: var(--s7) var(--panel-pad);
  }
  .foot-links {
    display: grid;
    grid-column: 2 / 6;
    grid-template-columns: subgrid;
    row-gap: var(--s7);
  }
  .fgroup h2 {
    display: flex;
    align-items: center;
    gap: var(--s2);
    margin-bottom: var(--s3);
    font-size: var(--fs-text);
    font-weight: var(--fw-bold);
    letter-spacing: 0;
    line-height: 1.3;
  }
  .fgroup ul {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    line-height: 1.35;
  }
  .fgroup li {
    display: flex;
    align-items: center;
    min-height: 32px;
    color: var(--ink2);
  }
  /* A footer link: second-level ink; on hover full ink and an underline that draws in from
     where the pointer came in (--ux, src/scripts/underline.ts; from the left without one). */
  .fl {
    color: var(--ink2);
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) var(--ux, 0%) 100% / 0 1px no-repeat;
    transition:
      color var(--t-hover) ease,
      background-size var(--t-small) var(--ease-out);
  }
  .fl:hover,
  .fl:focus-visible {
    color: var(--text);
    background-size: 100% 1px;
  }
  .fl:focus-visible {
    outline-offset: 4px;
  }
  @media (pointer: coarse) {
    .fgroup li {
      min-height: 44px;
    }
  }
  /* The small print: one quiet line under a hairline, its parts set apart by a dot, and the
     way back up at its end: its words and a round tonal key with an arrow. Pointed at, the
     words brighten, the key takes the tonal hover and its arrow leaves by the top as a second
     one comes up from under it (the key clips them); pressed, the key gives as the page's buttons do. */
  .foot-legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s3) var(--s6);
    margin-inline: var(--panel-pad);
    padding-block: var(--s4);
    border-top: 1px solid var(--hairline);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    line-height: 1.5;
  }
  .foot-fine {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s1) 0;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--ink3);
  }
  .foot-fine li + li::before {
    content: "·";
    margin-inline: var(--s3);
  }
  .to-top {
    display: inline-flex;
    align-items: center;
    gap: var(--s3);
    min-height: 2.75rem;
    color: var(--ink2);
    font-weight: var(--fw-bold);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--t-hover) ease;
  }
  .to-top-key {
    display: block;
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
    padding: 10px;
    overflow: hidden;
    border-radius: 50%;
    background: var(--tonal);
    color: var(--text);
    transition:
      background-color var(--t-hover) ease,
      scale var(--t-release) var(--spring-release);
  }
  .to-top-key svg {
    display: block;
    transition: translate 320ms var(--ease-out);
  }
  .to-top:hover,
  .to-top:focus-visible {
    color: var(--text);
  }
  .to-top:hover .to-top-key,
  .to-top:focus-visible .to-top-key {
    background: var(--tonal-hover);
  }
  .to-top:hover .to-top-key svg,
  .to-top:focus-visible .to-top-key svg {
    translate: 0 -36px;
  }
  .to-top:active .to-top-key {
    background: var(--tonal-pressed);
    scale: var(--press-scale);
    transition-duration: var(--t-hover), var(--t-press);
  }
  .to-top:focus-visible {
    outline-offset: 4px;
    border-radius: var(--r-pill);
  }
  @media (prefers-reduced-motion: reduce) {
    .to-top-key svg {
      transition: none;
    }
    .to-top:hover .to-top-key svg,
    .to-top:focus-visible .to-top-key svg {
      translate: none;
    }
  }
  @media (forced-colors: active) {
    .to-top-key {
      border: 1px solid ButtonText;
    }
  }
  @media (width < 1100px) {
    .foot-cols {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .about {
      grid-column: 1 / -1;
    }
    .about ul {
      display: flex;
      flex-wrap: wrap;
      column-gap: var(--s5);
    }
    .foot-links {
      grid-column: 1 / -1;
    }
  }
  @media (width < 640px) {
    .foot-cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    /* A phone: the small print's parts one under the other, without the dots. */
    .foot-fine {
      display: grid;
      gap: var(--s1);
    }
    .foot-fine li + li::before {
      content: none;
    }
  }
  /* A phone: what it runs on is said by the Download card just above, so featherplay's
     column keeps its version and that it is free, on one line (the wider screens' row); Product's links lead back up
     the page the visitor has just read, so they go; the groups sit closer. */
  @media (width < 761px) {
    .foot-cols {
      row-gap: var(--s6);
      padding-block: var(--s6) var(--s5);
    }
    .foot-links {
      row-gap: var(--s5);
    }
    .about li:nth-child(2),
    .about li:nth-child(3),
    .foot-links > .fgroup:first-child {
      display: none;
    }
  }
</style>
