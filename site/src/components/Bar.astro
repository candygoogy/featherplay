---
// The bar: docked along the top of the first screen (mockup 9's slim bar: the mark and name,
// the sections, the tray icon, the theme, the visitor's clock and Download), and once the page
// moves, one floating capsule (the mark, the sections, the song, the theme, Download). One component with
// exactly two states, `data-state="docked"` and `"capsule"`, each laid out by CSS alone; the
// change between them is decoration over the new layout (src/scripts/bar.ts: the parts glide
// from where they were by transform, the grounds fade), so the bar can never rest half-way.
// It collapses by rule as the room narrows (container queries on its own width): the
// sections' words go to icons under 1,240 px, then the sections and the tray step aside for
// the song under 840 px, then the name under 460 px; the capsule drops the sections under
// 560 px. Where the sections' row doesn't fit, one part stands for it: the icon of the section
// on screen and a chevron, opening the five as a flyout, as the song's part opens the songs.
// The docked bar's frost is painted (only still ground passes under it); the capsule,
// its flyouts, the menu and the tooltip are real glass (the page moves behind them).
import Logo from "./Logo.astro";
import TriVane from "./TriVane.astro";
import DlGlyph from "./DlGlyph.astro";
import Icon from "./Icon.astro";
import MediaFlyout from "./pieces/MediaFlyout.astro";
import { songs, demoStart, songById } from "../data/songs";
import { sections } from "../data/sections";
import { formatTime } from "../demo/player";
import { release, sizeLabel } from "../data/release";

interface Props {
  /** The home page, with the app: its song, tray icon and desktop menu. Elsewhere the sections
   *  are links to the home page’s. */
  home?: boolean;
}
const { home = true } = Astro.props;
const pre = home ? "" : "/";
const song = songById(demoStart.songId)!;
const downloads = [
  release.installer && { name: "Installer", note: "Windows 10 and 11, recommended", file: release.installer },
  release.portable && { name: "Portable exe", note: "One file, nothing to install", file: release.portable },
  release.linux && { name: "Linux AppImage", note: "x86_64, experimental", file: release.linux.appImage },
].filter(Boolean) as { name: string; note: string; file: NonNullable<typeof release.installer> }[];
const arrow = "M12 4.5 V15 M7.5 10.5 L12 15 L16.5 10.5 M5 19.5 H19";
---

<span class="bar-sentinel" data-bar-sentinel aria-hidden="true"></span>
<header class="bar" data-site-bar data-state="docked">
  <div class="dock" aria-hidden="true"></div>
  <div class="row" data-row>
    <span class="cap-bg glass live float" aria-hidden="true"></span>
    <a class="bp brand" href={home ? "#top" : "/"} data-part aria-label={home ? "featherplay, back to the top" : "featherplay, home"}>
      <TriVane size={22} />
      <span class="bn only-dock">featherplay</span>
    </a>
    <span class="b-div only-cap" data-part aria-hidden="true"></span>
    <nav class="b-nav" aria-label="Sections">
      {
        sections.map((s) => (
          <a class="bp b-sec" href={`${pre}#${s.id}`} data-part data-sec={s.id} data-tip={s.tip}>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-icon={s.id}>
              {s.parts.map((p) => <path d={p.d} data-ip={p.part} pathLength={p.len ? 1 : undefined} />)}
            </svg>
            <span class="lbl">{s.label}</span>
          </a>
        ))
      }
    </nav>
    <div class="b-end">
      <button class="bp b-secs" type="button" data-part data-secs popovertarget="fly-secs" aria-label="Sections" aria-expanded="false">
        <span class="secs-now" aria-hidden="true">
          {
            sections.map((s, i) => (
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-for={s.id} data-on={i === 0 ? "" : undefined}>
                {s.parts.map((p) => <path d={p.d} />)}
              </svg>
            ))
          }
        </span>
        <svg class="np-chev" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 10 L12 15 L17 10"></path></svg>
      </button>
      <div class="fly fly-secs glass live float" id="fly-secs" popover data-fly role="group" aria-label="Sections">
        <ol class="secs-list">
          {
            sections.map((s) => (
              <li>
                <a class="fq fs" href={`${pre}#${s.id}`} data-sec={s.id} data-secs-go>
                  <span class="fs-icon">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      {s.parts.map((p) => <path d={p.d} />)}
                    </svg>
                  </span>
                  <span class="fq-title">{s.label}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </div>
      {home && (
        <>
      <button class="bp b-np" type="button" data-part data-np data-tray-target popovertarget="fly-song" aria-label={`${song.title}: the song and the player`}>
        <span class="np-thumb"><img data-np-cover src={song.cover} width="28" height="28" alt="" /></span>
        <svg class="np-chev" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 10 L12 15 L17 10"></path></svg>
      </button>
      <div class="fly glass live float" id="fly-song" popover data-fly role="group" aria-label="The song and the player">
        <MediaFlyout />
        <button class="fly-show" type="button" data-show-window>
          <Logo size={16} /><span>Show featherplay’s window</span>
        </button>
        <ol class="fly-queue" aria-label="The demo’s six songs">
          {
            songs.map((s) => (
              <li>
                <button class="fq" type="button" data-do="play" data-song={s.id} aria-current={s.id === song.id ? "true" : undefined}>
                  <img src={s.cover} width="40" height="40" alt="" loading="lazy" decoding="async" />
                  <span class="fq-text"><span class="fq-title">{s.title}</span><span class="fq-artist">{s.artist}</span></span>
                  <span class="fq-time num">{formatTime(s.durationMs)}</span>
                </button>
              </li>
            ))
          }
        </ol>
      </div>
      <button class="bp b-tray only-dock" type="button" data-part data-tray data-tray-target data-tip="featherplay: show or hide the window" aria-label="featherplay in the tray: show or hide the window">
        <Logo size={18} />
      </button>
        </>
      )}
      <button class="bp b-theme" type="button" data-part data-theme-toggle data-choice="system" aria-label="Theme: System. Switch to Light">
        <svg class="system" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="7.5" fill="none" stroke="currentColor" stroke-width="1.6"></circle><path class="half" d="M12 4.5 A7.5 7.5 0 0 1 12 19.5 Z" fill="currentColor"></path></svg>
        <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4" fill="currentColor"></circle><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
        <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M19.5 14.6A8 8 0 0 1 9.4 4.5a8 8 0 1 0 10.1 10.1Z" fill="currentColor"></path></svg>
      </button>
      <time class="bp b-clock only-dock num" data-part data-clock aria-hidden="true"><span data-clock-time>00:00</span><span data-clock-date>00/00/0000</span></time>
      <a class="bp b-dl" href={`${pre}#download`} data-part data-dl aria-describedby="fly-dl-h" aria-controls="fly-dl" aria-expanded="false">
        <DlGlyph size={16} />
        Download
        <span class="dl-drop" aria-hidden="true"><svg class="dl-chev" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 10 L12 15 L17 10"></path></svg></span>
      </a>
      <div class="fly fly-dl glass live float" id="fly-dl" popover data-fly role="group" aria-labelledby="fly-dl-h">
        <p class="dlf-h" id="fly-dl-h">featherplay {release.version}</p>
        {
          downloads.map((d) => (
            <a class="dlf-row" href={d.file.url}>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={arrow} /></svg>
              <span class="dlf-text"><b>{d.name}</b><i>{d.note}</i></span>
              <span class="dlf-size num">{sizeLabel(d.file).replace(" ", " ")}</span>
            </a>
          ))
        }
        <a class="dlf-more" href={`${pre}#download`}>All the ways to get it</a>
      </div>
    </div>
  </div>
  <span class="bar-tip glass live float" role="tooltip" id="bar-tip" data-bar-tip aria-hidden="true"></span>
  <!-- A right-click on the empty desk (or Shift+F10, or the menu key): the app's own menu. -->
  {home && (
  <div class="ctx glass live float" role="menu" aria-label="Desktop" popover data-ctx>
    <button class="ctx-item" type="button" role="menuitem" data-ctx-do="toggle">
      <span class="pp" aria-hidden="true"><Icon name="play" size={18} class="i-play" /><Icon name="pause" size={18} class="i-pause" /></span>
      <span data-ctx-play>Play</span>
    </button>
    <button class="ctx-item" type="button" role="menuitem" data-ctx-do="next"><Icon name="next" size={18} /><span>Next song</span></button>
    <button class="ctx-item" type="button" role="menuitem" data-ctx-do="theme">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="7.5" fill="none" stroke="currentColor" stroke-width="1.6"></circle><path d="M12 4.5 A7.5 7.5 0 0 1 12 19.5 Z" fill="currentColor"></path></svg>
      <span data-ctx-theme>Switch to light</span>
    </button>
    <span class="ctx-div" role="separator"></span>
    <a class="ctx-item" href="#download" role="menuitem" data-ctx-do="download">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={arrow}></path></svg>
      <span>Download</span>
    </a>
  </div>
  )}
</header>

<script>
  import { bindReplicas } from "../demo/replica";
  import { bindBar } from "../scripts/bar";
  import { startClock } from "../scripts/clock";
  import { bindMoves } from "../scripts/moves";
  // The pages without the app have no replica: no player, and the bar without its song.
  const player = bindReplicas();
  const bar = document.querySelector<HTMLElement>("[data-site-bar]");
  if (bar) bindBar(bar, player);
  // The mark answers a song starting: play after a pause, or another song while playing.
  bindMoves(
    player
      ? (start) => {
          let was = player.state.playing;
          let song = player.state.song?.id;
          player.subscribe((s) => {
            if (s.playing && (!was || s.song?.id !== song)) start();
            was = s.playing;
            song = s.song?.id;
          });
        }
      : undefined,
  );
  for (const el of document.querySelectorAll<HTMLElement>("[data-site-bar] [data-clock]")) startClock(el);
</script>

<style>
  /* Scrolled past this, the bar floats (an observer, never a scroll handler). */
  .bar-sentinel {
    position: absolute;
    top: 8px;
    left: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }
  /* Landing away from the top (boot.js data-away): unseen until its script has its state, so the
     docked bar of the page's top never shows over the place it landed. */
  :global(:root[data-away]) .bar:not([data-ready]) {
    visibility: hidden;
  }
  .bar {
    position: fixed;
    z-index: 50;
    inset: 0 0 auto;
    height: calc(var(--cap-top) + var(--cap-h));
    color: var(--text);
    font-size: var(--fs-bar);
    font-weight: 600;
    pointer-events: none;
    container: bar / inline-size;
  }

  /* A phone: the capsule steps up out of the way while the page moves down (bar.ts). */
  @media (width < 761px) {
    .bar {
      transition: translate var(--t-medium) var(--ease-window);
    }
    .bar[data-tucked] {
      translate: 0 calc(-100% - 12px);
    }
  }

  /* The state the page loads in, drawn at once (bar.ts). */
  .bar[data-instant],
  .bar[data-instant] * {
    transition: none !important;
  }

  /* ---- The grounds: the docked bar’s painted frost, and the capsule’s glass ---- */
  /* Painted frost (only the still desk passes under it): the thin tint, a highlight from the
     top, a lit lower edge over a dark hair, the panes' fine grain. */
  .dock {
    position: absolute;
    inset: 0 0 auto;
    height: var(--bar-h);
    background: var(--pane-hl), var(--mat-dock);
    box-shadow:
      inset 0 -1px 0 light-dark(rgb(255 255 255 / 0.85), rgb(255 255 255 / 0.09)),
      0 1px 0 light-dark(rgb(60 40 20 / 0.11), rgb(0 0 0 / 0.42));
    transition:
      opacity var(--t-small) var(--ease-out),
      translate var(--t-medium) var(--ease-window);
  }
  .dock::before {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--grain) 0 0 / 96px;
    opacity: var(--pane-grain);
  }
  .row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    column-gap: var(--s4);
    /* The first screen's frame (src/scripts/first-math.ts frameOf): its edges line up with the
       headline's and the window's. */
    width: min(var(--frame-max), 89%, 100% - 40px);
    height: var(--bar-h);
    margin-inline: auto;
    pointer-events: auto;
  }
  .cap-bg {
    --mat: var(--mat-capsule);
    -webkit-backdrop-filter: var(--mat-blur-lift);
    backdrop-filter: var(--mat-blur-lift);
    position: absolute;
    inset: 0;
    border-radius: var(--r-float);
    opacity: 0;
    scale: 0.96;
    pointer-events: none;
    transition:
      opacity var(--t-small) var(--ease-out),
      scale var(--t-medium) var(--ease-window);
  }
  /* The capsule's blur only while it is the capsule: hidden glass blurs nothing. */
  .bar:not([data-state="capsule"]) .cap-bg {
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }
  .bar[data-state="capsule"] .dock {
    opacity: 0;
    translate: 0 -100%;
  }
  .bar[data-state="capsule"] .row {
    display: flex;
    gap: var(--s2);
    width: max-content;
    max-width: calc(100% - 2 * var(--s3));
    height: var(--cap-h);
    margin-top: var(--cap-top);
    /* Download's end is as far from the capsule's as its top and bottom are (8 px): the two
       rounded ends nest, and its ring on the download section sits evenly inside the capsule. */
    padding: 0 8px 0 6px;
  }
  .bar[data-state="capsule"] .cap-bg {
    opacity: 1;
    scale: 1;
  }

  /* ---- The parts ---- */
  .bp {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--s2);
    height: 40px;
    min-width: 0;
    padding: 0 10px;
    border: 0;
    border-radius: var(--r-control);
    background: transparent;
    color: inherit;
    font: inherit;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition:
      background-color var(--t-hover) ease,
      color var(--t-hover) ease;
  }
  /* Every part's target reaches the bar's height. */
  .bp::before {
    content: "";
    position: absolute;
    inset: -6px -1px;
  }
  .bar[data-state="capsule"] .bp {
    height: 36px;
    border-radius: var(--r-pill);
  }
  @media (hover: hover) {
    .bp:hover {
      background: var(--part-hover);
    }
  }
  .bp:active {
    background: var(--part-press);
  }
  .bp > :is(svg, .np-thumb) {
    flex: none;
    transition: scale var(--t-release) var(--spring-release);
  }
  .bp:active > :is(svg, .np-thumb) {
    scale: var(--press-icon);
    transition: scale var(--t-press) var(--ease-out);
  }
  .bp:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: -2px;
  }
  .brand {
    justify-self: start;
    gap: 10px;
    padding-left: 9px;
  }
  .bar[data-state="capsule"] .brand {
    width: 36px;
    padding: 0;
  }
  .bn {
    font-size: var(--fs-text);
    font-weight: var(--fw-bold);
    letter-spacing: -0.03em;
  }
  .b-div {
    flex: none;
    width: 1px;
    height: 20px;
    background: color-mix(in srgb, var(--text) 16%, transparent);
  }
  .b-nav {
    justify-self: center;
    display: flex;
    gap: 2px;
  }
  .b-sec {
    padding: 0 11px;
    color: var(--ink2);
  }
  .b-sec[aria-current="true"],
  .b-sec:hover {
    color: var(--text);
  }
  .bar[data-state="capsule"] .b-sec[aria-current="true"] {
    background: var(--part-on);
  }
  .lbl {
    letter-spacing: -0.005em;
  }
  /* The icons' moving parts turn and slide round their own points (moves.ts). */
  .b-sec path[data-ip] {
    transform-box: view-box;
  }
  .b-sec path[data-ip="titlebar"] {
    transform-origin: 12px 8.8px;
  }
  .b-sec path[data-ip="needle"] {
    transform-origin: 12px 14.2px;
  }
  .b-sec path[data-ip="tile"] {
    transform-origin: 16.5px 16.5px;
  }
  .b-sec path[data-ip="arc"] {
    transform-origin: 12px 7.2px;
    stroke-dasharray: 0 1;
    stroke-dashoffset: -0.5;
    /* At rest not there at all (a zero-length dash would draw its round caps as a dot). */
    opacity: 0;
  }
  /* A section's words, hidden, stay its name. */
  .bar[data-state="capsule"] .b-sec:not([aria-current="true"]) .lbl,
  .b-sec.icon-only .lbl {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .bar[data-state="capsule"] .b-sec:not([aria-current="true"]) {
    width: 40px;
    padding: 0;
  }
  .b-end {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 2px;
  }
  .b-np {
    gap: 4px;
    padding: 0 6px;
  }
  .np-thumb {
    display: block;
    width: 28px;
    height: 28px;
    border-radius: var(--r-control);
    overflow: hidden;
    box-shadow: 0 0 0 1px var(--hairline);
  }
  .np-thumb img {
    width: 28px;
    height: 28px;
    object-fit: cover;
  }
  .np-chev {
    color: var(--ink2);
    transition: rotate var(--t-small) var(--ease-out);
  }
  .b-np[aria-expanded="true"] .np-chev,
  .b-secs[aria-expanded="true"] .np-chev {
    rotate: 180deg;
  }
  /* The sections' one part: the icon of the section on screen (bar.ts marks it), a chevron. */
  .b-secs {
    display: none;
    gap: 2px;
    padding: 0 6px 0 9px;
  }
  .secs-now {
    display: grid;
  }
  .secs-now > svg {
    grid-area: 1 / 1;
  }
  .secs-now > svg:not([data-on]) {
    visibility: hidden;
  }
  .secs-list {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Each section by its icon and name alone (its tooltip's words said the name again). */
  .fs {
    grid-template-columns: 34px minmax(0, 1fr);
    min-height: 46px;
    text-decoration: none;
  }
  .fs-icon {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: var(--r-control);
    background: var(--tonal);
    color: var(--ink2);
  }
  .fs[aria-current="true"] .fs-icon {
    color: var(--text);
  }
  .b-tray,
  .b-theme {
    width: 34px;
    padding: 0;
  }
  :global(:root[data-window-minimised]) .b-tray {
    background: none;
    box-shadow: inset 0 -2px 0 -0.5px var(--ink3);
  }
  /* Closed, not in the tray (src/demo/window.ts): no running mark under it, and its icon
     unlit, as something that isn't running. It still opens the app. */
  :global(:root[data-window-closed]) .b-tray {
    box-shadow: none;
  }
  .b-tray > :global(*) {
    transition:
      opacity var(--t-small) ease,
      filter var(--t-small) ease;
  }
  :global(:root[data-window-closed]) .b-tray:not(:hover, :focus-visible) > :global(*) {
    opacity: 0.5;
    filter: grayscale(1);
  }
  .b-clock {
    display: grid;
    justify-items: end;
    align-content: center;
    gap: 0;
    padding: 0 var(--s2);
    font-size: var(--fs-bar-clock);
    font-weight: var(--fw-medium);
    line-height: 16px;
    cursor: default;
    pointer-events: none;
  }
  .b-dl {
    gap: 6px;
    height: 32px;
    margin-left: 6px;
    padding: 0 var(--s4) 0 var(--s3);
    border-radius: var(--r-pill);
    background: var(--accent);
    color: var(--on-accent);
    font-weight: var(--fw-bold);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.22), 0 1px 2px var(--shade-1);
  }
  .bar[data-state="capsule"] .b-dl {
    height: 32px;
  }
  /* On the download section, Download is where the visitor is (bar.ts): a thin ring of its own
     red, just off its edge, as a lit section's pill says "here" for the others. 2 px off it and
     1.5 px wide, it leaves the same 4.5 px to the capsule's edge all round. */
  .b-dl {
    outline: 1.5px solid transparent;
    outline-offset: 2px;
    transition: outline-color var(--t-small) var(--ease-out);
  }
  .b-dl[aria-current="true"] {
    outline-color: color-mix(in srgb, var(--accent) 55%, transparent);
  }
