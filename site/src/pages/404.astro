---
// The 404: a state the app really has, Now playing with nothing to play and nothing up next.
// A blank cover, "404" by "page not found", the bar at 0:00 of 4:04, and one way back. The
// app's window on the desk, as on the home page (no laptop): a still frame of the app
// (replica.css) laid out for the window's size by the app's own container rules, no demo
// script, so it stays light.
import "../styles/app-controls.css";
import "../styles/replica.css";
import Base from "../layouts/Base.astro";
import Bar from "../components/Bar.astro";
import DeskLite from "../components/DeskLite.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Icon from "../components/Icon.astro";
---

<Base
  title="Page not found | featherplay"
  description="This page isn't in the queue. Go back to featherplay's home page."
  noindex
  system
>
  <DeskLite />
  <Bar home={false} />
  <main id="main" tabindex="-1" class="nf frame">
    <div class="nf-head">
      <h1 class="t-display">Not in the queue</h1>
      <p class="t-lede ink2">The page you asked for isn’t here. It may have moved, or the link may be wrong.</p>
    </div>
    <div class="nf-desk">
      <div class="nf-win win-body" role="group" aria-label="featherplay showing an empty Now playing: 404, page not found">
          <div class="replica" data-view="now" data-playing="false" data-lyrics-on="true" data-has-lyrics="false" style="--song:#808080">
            <div class="titlebar">
              <span class="art" aria-hidden="true">
                <img class="only-dark" src="/tri-vane.svg" width="16" height="16" alt="" />
                <img class="only-light" src="/tri-vane-light.svg" width="16" height="16" alt="" />
              </span>
              <span>featherplay</span>
            </div>
            <div class="app">
              <div class="main">
                <section class="stage" aria-label="Now playing">
                  <span class="stage-wash" aria-hidden="true"></span>
                  <div class="np">
                    <div class="np-cover blank" aria-hidden="true"><Icon name="note" size={96} /></div>
                    <div class="np-text">
                      <div class="np-row"><p class="np-title" data-nf-title>404</p></div>
                      <p class="np-artist" data-nf-artist>page not found</p>
                      <p class="nf-line">This page isn't in the queue.</p>
                      <a class="pill solid nf-home" href="/"><Icon name="play" size={18} /><span>Play from the start</span></a>
                    </div>
                  </div>
                </section>
              </div>
              <aside class="queue" aria-label="Up next">
                <div class="tabs" aria-hidden="true">
                  <span class="tab-pill"></span><span class="tab">Up next</span><span class="tab">Related</span>
                </div>
                <p class="nf-empty">Nothing up next</p>
              </aside>
              <div class="bar" aria-hidden="true">
                <span class="bar-song">
                  <span class="bar-cover blank"></span>
                  <span class="bar-text"><span class="bar-title">404</span><span class="bar-artist">page not found</span></span>
                </span>
                <div class="bar-mid">
                  <div class="transport">
                    <span class="fp-ib"><Icon name="shuffle" size={20} /></span>
                    <span class="fp-ib t1"><Icon name="prev" size={20} /></span>
                    <span class="fp-play"><Icon name="play" class="i-play" /></span>
                    <span class="fp-ib t1"><Icon name="next" size={20} /></span>
                    <span class="fp-ib"><Icon name="repeat" size={20} /></span>
                  </div>
                  <div class="seek">
                    <span class="time" data-nf-time>0:00</span>
                    <span class="seek-line"><span class="rail"></span></span>
                    <span class="time end" data-nf-length>4:04</span>
                  </div>
                </div>
                <div class="bar-end">
                  <span class="fp-ib"><Icon name="heart" size={20} /></span>
                  <span class="fp-ib"><Icon name="volume" size={20} /></span>
                </div>
              </div>
            </div>
          </div>
      </div>
    </div>
  </main>
  <SiteFooter />
</Base>

<style>
  /* The still picture's selected tab (Up next, on the tinted pill) in the full text colour,
     as the live replica's selected tab is. */
  .nf :global(.tabs .tab:nth-child(2)) {
    color: var(--text);
  }
  .nf {
    padding-top: calc(var(--bar-h) + var(--s8));
  }
  .nf-head {
    display: grid;
    gap: var(--s4);
    max-width: 46rem;
  }
  .nf-head .t-lede {
    max-width: 44ch;
  }
  /* The app's window on the desk: laid out at the window's own size by the app's container
     rules (wide down to its narrow layout); on a phone, the narrow window drawn smaller. */
  .nf-desk {
    margin-top: var(--s7);
  }
  .nf-win {
    position: relative;
    width: min(100%, 1100px);
    aspect-ratio: 1440 / 852;
    margin-inline: auto;
    overflow: hidden;
    border-radius: 8px;
    container: app / size;
    box-shadow:
      0 0 0 1px var(--edge),
      0 1px 2px var(--shade-1),
      0 4px 16px var(--shade-2),
      0 16px 56px var(--shade-3);
  }
  @media (width < 760px) {
    .nf-win {
      width: 480px;
      aspect-ratio: auto;
      height: 780px;
      zoom: 0.8;
    }
  }
  @media (width < 440px) {
    .nf-win {
      zoom: 0.7;
    }
  }
  /* The empty cover: the app's cover-empty ground with its note. */
  .blank {
    display: grid;
    place-items: center;
    background: var(--cover-empty);
    color: var(--text-faint);
  }
  /* Wide: Now playing beside the queue, a smaller cover than the player's so the line and the
     button under it clear the bar. Narrow, the app's own narrow layout. */
  @container app (width >= 1000px) {
    .nf :global(.replica .app) {
      grid-template-columns: 1fr 400px;
    }
    .nf :global(.replica .np) {
      top: 32px;
      width: 272px;
    }
  }
  /* Narrow: a smaller blank cover, so the words and the way back stay clear of the bar. */
  @container app (width < 1000px) {
    .nf :global(.replica .np-cover.blank) {
      width: min(220px, 60%);
    }
  }
  .nf :global(.replica .np-cover.blank) {
    aspect-ratio: 1;
  }
  .nf :global(.replica .bar-cover.blank) {
    display: block;
    width: 56px;
    height: 56px;
    border-radius: 10px;
  }
  .nf-line {
    margin-top: 18px;
    color: var(--text-muted);
    font-size: 16px;
  }
  .nf-home {
    margin-top: 18px;
    text-decoration: none;
  }
  .nf-empty {
    padding: 24px 8px;
    color: var(--text-faint);
  }
</style>
