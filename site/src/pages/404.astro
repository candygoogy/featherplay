---
// The 404 as the app's queue would show it: the song that should be playing is missing (a blank
// cover, "404", page not found), and under it what is up next, the home page's five sections as
// the app lists songs (each its icon, the bar's, its name and its own title). Beside the queue,
// the page's own words and two ways on. The two are one spread, set side by side at their own
// sizes in the middle of the frame, never pushed to its two ends; the spread sits in the room
// between the bar and the footer, and the footer at the foot of the window: no desk under it.
// No picture of the app (it read as something to play with, and carried the app's stylesheet).
import Base from "../layouts/Base.astro";
import Bar from "../components/Bar.astro";
import DeskLite from "../components/DeskLite.astro";
import SiteFooter from "../components/SiteFooter.astro";
import DlGlyph from "../components/DlGlyph.astro";
import Icon from "../components/Icon.astro";
import { sections } from "../data/sections";
---

<Base
  title="Page not found | featherplay"
  description="This page isn't in the queue. Go back to featherplay's home page."
  noindex
  system
>
  <DeskLite />
  <Bar home={false} />
  <main id="main" tabindex="-1" class="nf frame">
    <div class="nf-head">
      <h1 class="t-display">Not in the queue</h1>
      <p class="t-lede ink2">The page you asked for isn’t here.<br /> It may have moved, or the link may be wrong.</p>
      <div class="nf-actions">
        <a class="btn red" href="/">Back to featherplay</a>
        <a class="btn tonal" href="/#download"><DlGlyph />Download</a>
      </div>
    </div>
    <nav class="nf-queue panel" aria-labelledby="nf-next">
      <p class="nf-label">Now playing</p>
      <p class="nf-now">
        <span class="nf-cover" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-linecap="round">
            <circle cx="12" cy="12" r="8" stroke-width="1.6" stroke-dasharray="2.6 2.6" />
            <circle cx="12" cy="12" r="2" stroke-width="1.6" />
          </svg>
        </span>
        <span class="nf-text">
          <b class="num" data-nf-code>404</b>
          <span>Page not found</span>
        </span>
      </p>
      <h2 class="nf-label nf-next" id="nf-next">Up next</h2>
      <ul>
        {
          sections.map((s) => (
            <li>
              <a class="nf-row" href={`/#${s.id}`}>
                <span class="nf-ic" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    {s.parts.map((p) => (
                      <path d={p.d} />
                    ))}
                  </svg>
                </span>
                <span class="nf-text">
                  <b>{s.label}</b>
                  <span>{s.about}</span>
                </span>
                <span class="nf-go" aria-hidden="true"><Icon name="chevronRight" size={16} /></span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </main>
  <SiteFooter />
</Base>

<style>
  /* The page as a column the window's height at least: the main part takes what the bar and the
     footer leave, so the footer ends at the window's foot however short the page is. (The skip
     link, the desk and the bar are fixed: they take no room in it.) */
  :global(body:has(> main.nf)) {
    display: flex;
    flex-direction: column;
  }

  /* One spread: the words and the queue side by side at their own widths, centred in the frame
     with one measured gap between them, and level with each other; centred, too, in the room
     between the bar and the footer, a little above its middle, as the eye sets a middle (the
     footer's own margin is the space under it, the top a step less). One column on a phone and
     a tablet. */
  .nf {
    flex: 1 0 auto;
    display: grid;
    grid-template-columns: minmax(0, max-content) minmax(19rem, 23rem);
    justify-content: center;
    align-content: center;
    align-items: center;
    column-gap: clamp(var(--s7), 5vw, var(--s9));
    padding-top: calc(var(--bar-h) + var(--s7));
  }
  .nf-head {
    display: grid;
    justify-items: start;
    gap: var(--s4);
  }
  /* Its two sentences on two lines where there is room (one line each), wrapped where not. */
  .nf-head .t-lede {
    max-width: 46ch;
  }
  .nf-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s3);
    margin-top: var(--s4);
  }

  /* The queue: the app's queue, the missing song first, then the site's places up next. */
  .nf-queue {
    display: grid;
    padding: var(--s3);
  }
  .nf-now,
  .nf-row {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: var(--s4);
    align-items: center;
    padding: var(--s2) var(--s3);
    border-radius: var(--r-small);
  }
  /* What should be playing, on the playing row's tint. Its cover: the same tile as the places
     under it, with the record drawn in dashes in it, the record that isn't there. */
  .nf-now {
    background: var(--part-hover);
  }
  .nf-cover {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--r-control);
    background: var(--tonal);
    color: var(--text);
  }
  /* The queue's two labels, as the app's queue names its parts. */
  .nf-label {
    margin: var(--s1) var(--s3) var(--s2);
    color: var(--ink2);
    font-size: var(--fs-small);
    font-weight: var(--fw-bold);
    line-height: var(--lh-small);
  }
  .nf-next {
    margin-top: var(--s5);
  }
  .nf-queue ul {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nf-row {
    grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    color: var(--text);
    text-decoration: none;
    transition: background-color var(--t-hover) ease;
  }
  /* A row is a way somewhere: pointed at or focused, a chevron comes in at its end. */
  .nf-go {
    display: grid;
    color: var(--ink2);
    opacity: 0;
    translate: -4px 0;
    transition:
      opacity var(--t-hover) ease,
      translate var(--t-hover) var(--ease-out);
  }
  .nf-row:focus-visible .nf-go {
    opacity: 1;
    translate: none;
  }
  @media (hover: hover) {
    .nf-row:hover {
      background: var(--part-hover);
    }
    .nf-row:hover .nf-go {
      opacity: 1;
      translate: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .nf-go {
      translate: none;
    }
  }
  .nf-row:active {
    background: var(--tonal);
  }
  .nf-row:focus-visible {
    outline-offset: -2px;
  }
  .nf-ic {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--r-control);
    background: var(--tonal);
    color: var(--text);
  }
  .nf-text {
    display: grid;
    min-width: 0;
    line-height: var(--lh-small);
  }
  .nf-text b {
    font-weight: var(--fw-bold);
  }
  .nf-text span {
    overflow: hidden;
    color: var(--ink2);
    font-size: var(--fs-small);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* A tablet and a phone: one column, the words first; the queue at a list's width, not the
     page's. */
  @media (width < 960px) {
    .nf {
      grid-template-columns: minmax(0, 1fr);
      justify-content: stretch;
      align-content: start;
      row-gap: var(--s7);
      padding-top: calc(var(--bar-h) + var(--s7));
    }
    .nf-queue {
      max-width: 26rem;
    }
  }
  /* A phone: the two ways on still share one row, with a step less room at their sides. */
  @media (width < 600px) {
    .nf-actions .btn {
      padding-inline: var(--s4);
    }
  }
</style>
