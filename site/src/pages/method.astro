---
// How the comparison's figures were measured, and where each one comes from. The setups are
// the two measurements' (featherplay 0.8.0 on 27 November 2026, in both its drawing modes, Pear
// Desktop and Edge on 1 November; their write-ups are kept outside the repo), plus 0.2.0's one run
// with the sound features on (9 November); the figures and the sizes come from numbers.ts and
// release.ts.
// Laid out as a calm document that uses the width: the parts' index held in view on the left
// (the part being read marked, as the Questions section's index does), the text at a reading
// measure, and beside each part the measured facts it gives, pulled out as small spec sheets
// and figure tables; the scripts and the raw measurements' files as folders in the site's own
// Explorer style. Every fact stays in the text too, so the asides only gather it.
import Base from "../layouts/Base.astro";
import Bar from "../components/Bar.astro";
import DeskLite from "../components/DeskLite.astro";
import SiteFooter from "../components/SiteFooter.astro";
import {
  figureFor,
  figures,
  installFolders,
  metrics,
  processorMode as cpu,
  settledMemoryMB as settled,
  shownWindow as shown,
  timings,
  withProcessing,
  type Metric,
} from "../data/numbers";
import { figureText, formatBytes, formatFigure } from "../data/format";
import { release, sizeLabel } from "../data/release";

const names: Record<Metric, string> = {
  memoryMB: "Memory while playing",
  memoryPausedMB: "Memory while paused",
  cpuPlayingPct: "CPU while playing",
  cpuPausedPct: "CPU while paused",
  processes: "Processes",
  startToSoundS: "Start to music playing",
  clickToSoundS: "Click to sound",
  downloadMB: "Download",
};
const file = (path: string) => path.split("/").pop() ?? path;
const fp = figureFor("featherplay");
const pear = figureFor("Pear Desktop");
const edge = figureFor("YouTube Music in Edge");
const procs = (f: (typeof figures)[number]) => figureText(f, "processes");
// Seconds as the page writes them: two significant figures (0.73 s, 6.4 s, 0.003 s).
const s = (v: number) => `${v.toLocaleString("en-GB", { maximumSignificantDigits: 2 })} s`;
const { startToSoundS: start, clickToSoundS: click, hovered, notHovered, preparedAhead, hoveredOnly, cold } = timings;

/** The page's parts, for the index. */
const parts = [
  ["setup", "The PC and the players"],
  ["run", "How each one ran"],
  ["start", "Start to music playing"],
  ["click", "Click to sound"],
  ["counted", "What’s counted"],
  ["dropped", "Left out, and measured again"],
  ["scripts", "The scripts"],
  ["sources", "Every figure and its source"],
] as const;
const title = Object.fromEntries(parts) as Record<(typeof parts)[number][0], string>;

/** The click timings as a small table: which clicks, how many, the median and the range. */
const clickRows = [
  { k: "All clicks", t: click, median: formatFigure("clickToSoundS", click.median) },
  { k: "Hovered first", t: hovered },
  { k: "Not hovered", t: notHovered },
  { k: "Prepared ahead", t: preparedAhead },
  { k: "Ready from a hover alone", t: hoveredOnly },
  { k: "Cold", t: cold },
].map((r) => ({ ...r, median: r.median ?? s(r.t.median), range: r.t.n > 1 ? `${s(r.t.min)} to ${s(r.t.max)}` : "" }));

/** Each player's files: the folder they lie in (inside the measurements), each file with the
 *  figures it gives; what wasn't part of a measurement on a line of its own. */
function folderOf(f: (typeof figures)[number]) {
  const byFile = new Map<string, Metric[]>();
  const none: Metric[] = [];
  for (const m of metrics) {
    const src = f.sources[m];
    if (!src) none.push(m);
    else byFile.set(src, [...(byFile.get(src) ?? []), m]);
  }
  const paths = [...byFile.keys()].filter((p) => p.startsWith("measurements/"));
  const dirs = paths.map((p) => p.split("/").slice(0, -1));
  const common = dirs.reduce((a, d) => a.filter((x, i) => d[i] === x), dirs[0] ?? []);
  const files = [...byFile].map(([path, ms]) => ({
    name: path.startsWith("measurements/") ? path.split("/").slice(common.length).join("/") : path,
    kind: path.startsWith("measurements/") ? (/\.md$/.test(path) ? "text" : "data") : "release",
    ms,
  }));
  return { crumbs: common, files, none };
}

const scripts = [
  { name: "measure-pear.ps1", what: "Pear Desktop, 1 November" },
  { name: "measure-edge.ps1", what: "Edge, 1 November" },
  { name: "measure-pass.ps1", what: "featherplay, 27 November" },
  { name: "run-starts.ps1", what: "Start to music playing" },
  { name: "run-clicks.ps1", what: "Click to sound" },
  { name: "shown.ps1", what: "The window shown" },
];
---

<Base
  title="How featherplay's figures were measured"
  description="The PC, the versions and the method behind the memory, CPU, timing and download figures that compare featherplay with Pear Desktop and YouTube Music in Edge."
  system
>
  <DeskLite />
  <Bar home={false} />
  <main id="main" tabindex="-1" class="frame method">
    <svg class="sprite" aria-hidden="true">
      <symbol id="m-folder" viewBox="0 0 16 16"><path d="M1.5 4a1 1 0 0 1 1-1h3.2l1.3 1.4h6.5a1 1 0 0 1 1 1V12a1 1 0 0 1-1 1h-11a1 1 0 0 1-1-1Z" fill="var(--folder)"></path></symbol>
      <symbol id="m-data" viewBox="0 0 16 16"><path d="M4 1.8h5.2L12.5 5v9.2H4Z" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"></path><path d="M6 8.5h4.5M6 11h4.5" stroke="currentColor" stroke-width="1.1"></path></symbol>
      <symbol id="m-text" viewBox="0 0 16 16"><path d="M4 1.8h5.2L12.5 5v9.2H4Z" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"></path><path d="M6 7.5h4.5M6 9.6h4.5M6 11.7h3" stroke="currentColor" stroke-width="1"></path></symbol>
      <symbol id="m-release" viewBox="0 0 16 16"><rect x="2" y="3" width="12" height="10" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.2"></rect><path d="M2 5.6h12" stroke="currentColor" stroke-width="1.2"></path></symbol>
      <symbol id="m-script" viewBox="0 0 16 16"><path d="M4 1.8h5.2L12.5 5v9.2H4Z" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"></path><path d="M6 8l1.6 1.4L6 10.8M8.6 11.4h2" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"></path></symbol>
    </svg>

    <nav class="index" aria-label="On this page">
      <p class="index-h">On this page</p>
      <ol data-method-index>
        {parts.map(([id, t]) => <li><a href={`#${id}`}>{t}</a></li>)}
      </ol>
    </nav>

    <div class="body">
      <header class="head">
        <h1 class="t-display">How these were measured</h1>
        <p class="lede t-lede ink2">
          All three players were measured on one PC: Pear Desktop and Edge on the evening of 1 November 2026, featherplay
          {fp.version} in the afternoon of 27 November, in both the ways it can draw its window. Every figure on the home
          page comes from those two measurements, and each one names its files below.
        </p>
      </header>

      <section class="part" aria-labelledby="setup">
        <h2 id="setup">{title.setup}</h2>
        <div class="text">
          <dl class="kv players">
            <div>
              <dt>featherplay {fp.version}</dt>
              <dd>
                {fp.version}'s code, built for release on the same PC, so not the release's own exe. It draws its window
                with the graphics card by default, and the figures are that mode's; drawing with the processor, the
                setting in Settings › Window › Performance, it was measured too, in turn with it. The download sizes are
                {release.version}'s: its exe
                is{release.portable ? ` ${sizeLabel(release.portable)}` : ""}, the installer
                {release.installer ? ` ${sizeLabel(release.installer)}` : ""}. It ran on a copy of a long-used featherplay
                folder (settings, saved queue, kept streams and covers), with Streaming quality on High, so every song played
                as Opus. The settings were its owner's (lyrics on, a 2 s crossfade, the equalizer, Even out loudness and Skip
                silence off), with Discord status off, Last.fm off in the copy, and quick search, the sleep timer, desktop
                lyrics and lyrics timed by the word off, as they are by default.
              </dd>
            </div>
            <div>
              <dt>Pear Desktop {pear.version}</dt>
              <dd>Installed, with its owner's settings left as they were.</dd>
            </div>
            <div>
              <dt>YouTube Music in Microsoft Edge {edge.version}</dt>
              <dd>A separate Edge with a clean profile of its own and no extensions, one tab, signed in.</dd>
            </div>
          </dl>
        </div>
        <aside class="aside" aria-label="The PC">
          <div class="sheet">
            <p class="sheet-h">The PC</p>
            <dl>
              <div><dt>Processor</dt><dd>AMD Ryzen 7 9800X3D</dd></div>
              <div><dt>Cores</dt><dd>8 cores, 16 logical processors</dd></div>
              <div><dt>Memory</dt><dd>32 GB</dd></div>
              <div><dt>Display</dt><dd>3840 × 2160 at 150 % scaling, 240 Hz</dd></div>
              <div><dt>Windows</dt><dd>Windows 11 Pro for Workstations, build 26300</dd></div>
            </dl>
          </div>
        </aside>
      </section>

      <section class="part" aria-labelledby="run">
        <h2 id="run">{title.run}</h2>
        <div class="text">
          <ul class="facts">
            <li>
              Pear Desktop and Edge, on 1 November: the same song in both, on repeat, at normal volume. Each was the only
              player running. Pear Desktop stayed open but paused while Edge was measured, and wasn't counted.
            </li>
            <li>
              featherplay, on 27 November: one song on repeat, at featherplay's volume of 2 % (Windows' own volume left as
              it was), three runs drawing with the graphics card and three with the processor, taken in turn. Each
              figure is the median of the three. Pear Desktop wasn't running at any point. featherplay ran on a Windows
              desktop of its own, so its window never showed while the PC was in use; the whole machine averaged 9 to
              11 % CPU over each part of a run.
            </li>
            <li>
              Which one drew was checked in every run: drawing with the graphics card, featherplay logs its graphics
              device and holds the graphics card's memory while shown; drawing with the processor, it logs none and holds
              none.
            </li>
            <li>The window was minimised, and no games were running.</li>
            <li>
              Five minutes playing, then three minutes paused, with a sample every 5 seconds, the first about 16 s after
              the window was minimised.
            </li>
            <li>
              Drawing with the graphics card, featherplay lets go of the graphics card's memory 30 s after the window is
              minimised, so the memory while playing ({figureText(fp, "memoryMB")}) includes the first seconds before
              that. From 40 s on it averaged {settled.gpu} MB; drawing with the processor, {settled.processor} MB. With
              the graphics card, memory depends on the window's size (its screen buffers alone are about 32 MB each at
              4K), so a smaller display uses less.
            </li>
            <li>
              Drawing with the processor, featherplay played in {cpu.memoryMB} MB at{" "}
              {formatFigure("cpuPlayingPct", cpu.cpuPlayingPct)} CPU, and paused in {cpu.memoryPausedMB} MB at{" "}
              {formatFigure("cpuPausedPct", cpu.cpuPausedPct)}.
            </li>
            <li>
              With the window shown on Home, 1280 × 800 at 150 % (1920 × 1200 pixels), and a song playing, for 60 s (three runs each, and not part of the
              comparison, which is minimised): drawing with the graphics card, featherplay used {shown.gpu.taskManagerMB}{" "}
              MB as Task Manager counts it, plus {shown.gpu.gpuMB} MB of the graphics card's memory; drawing with the
              processor, {shown.processor.taskManagerMB} MB.
            </li>
            <li>
              With the equalizer, Even out loudness, Skip silence and a 5 s crossfade all on, one more run, of featherplay
              0.2.0 on 9 November, used {withProcessing.memoryMB} MB of memory and{" "}
              {formatFigure("cpuPlayingPct", withProcessing.cpuPlayingPct)} CPU while playing. That run is 0.2.0's, wasn't
              repeated since, and isn't in the comparison.
            </li>
          </ul>
        </div>
        <aside class="aside" aria-label="Each run">
          <div class="sheet">
            <p class="sheet-h">Each run</p>
            <dl>
              <div><dt>Playing</dt><dd>5 minutes</dd></div>
              <div><dt>Paused</dt><dd>3 minutes</dd></div>
              <div><dt>A sample</dt><dd>every 5 seconds</dd></div>
              <div><dt>The window</dt><dd>minimised</dd></div>
              <div><dt>featherplay</dt><dd>3 runs in each mode, the median of each figure</dd></div>
            </dl>
          </div>
          <div class="sheet">
            <p class="sheet-h">featherplay {fp.version} drawing with the processor</p>
            <dl>
              <div><dt>Memory while playing</dt><dd class="num">{cpu.memoryMB} MB</dd></div>
              <div><dt>Memory while paused</dt><dd class="num">{cpu.memoryPausedMB} MB</dd></div>
              <div><dt>CPU while playing</dt><dd class="num">{formatFigure("cpuPlayingPct", cpu.cpuPlayingPct)}</dd></div>
            </dl>
          </div>
          <div class="sheet">
            <p class="sheet-h">The window shown, on Home, playing</p>
            <dl>
              <div><dt>Graphics card</dt><dd class="num">{shown.gpu.taskManagerMB} MB, and {shown.gpu.gpuMB} MB of its memory</dd></div>
              <div><dt>Processor</dt><dd class="num">{shown.processor.taskManagerMB} MB</dd></div>
            </dl>
          </div>
          <div class="sheet">
            <p class="sheet-h">The sound features on: featherplay 0.2.0, one run</p>
            <dl>
              <div><dt>Memory</dt><dd class="num">{withProcessing.memoryMB} MB</dd></div>
              <div><dt>CPU while playing</dt><dd class="num">{formatFigure("cpuPlayingPct", withProcessing.cpuPlayingPct)}</dd></div>
            </dl>
          </div>
        </aside>
      </section>

      <section class="part" aria-labelledby="start">
        <h2 id="start">{title.start}</h2>
        <div class="text">
          <ul class="facts">
            <li>
              featherplay only: Pear Desktop and Edge weren't part of this measurement. Each start resumed the queue
              featherplay had saved, which picks a song up at 0:04, so the song had to load and seek. 0.2.2's starts resumed
              theirs at 0:49, a longer seek, so the two figures aren't directly comparable.
            </li>
            <li>
              The clock starts when Windows creates featherplay's process and stops when its audio engine logs the first
              sound: the moment Windows' audio output takes the song's first samples.
            </li>
            <li>
              Play was sent the way the taskbar thumbnail's Play button sends it, as soon as the window would take it, 0.22
              to 0.24 s after the start. The window was shown, not minimised.
            </li>
            <li>
              Warm starts, with featherplay and its folder already used: one start to warm up, not counted, then{" "}
              {start.n}. The median is {formatFigure("startToSoundS", start.median)}, and they took {s(start.min)} to{" "}
              {s(start.max)}. All {start.n} played the stream featherplay had kept from the last session, with no lookup; by
              the time Play was taken the stream was mostly ready, and from Play to the first sound took 0.08 to 0.11 s.
            </li>
            <li>
              Drawing with the processor, the window takes Play sooner (0.08 to 0.09 s after the start), and the same
              number of starts had a median of 0.29 s (0.24 to 0.87 s), most of it the stream's first request.
            </li>
            <li>
              A new install has nothing kept yet. In 0.2.0, a new install's very first song took longer, about 12 s once,
              while featherplay downloaded the two helpers it used (yt-dlp and Deno); the starts after it took 0.5 to 0.9 s.
              Since featherplay answers YouTube's player challenges with the JavaScript engine built into it, the first song
              no longer waits for that download: a new install prepares YouTube's player at startup, in about 5 s, and a
              first click after that is one request (0.2 to 0.6 s, measured on 9 November 2026). About one fresh start in
              seven gets answers from YouTube without a stream, and then plays through yt-dlp instead (4 to 9 s) until the
              next song.
            </li>
          </ul>
        </div>
        <aside class="aside" aria-label="Warm starts">
          <div class="sheet">
            <p class="sheet-h">featherplay {fp.version}, warm starts</p>
            <dl>
              <div class="big"><dt>Median</dt><dd class="num">{formatFigure("startToSoundS", start.median)}</dd></div>
              <div><dt>All {start.n}</dt><dd class="num">{s(start.min)} to {s(start.max)}</dd></div>
              <div><dt>Play to the first sound</dt><dd class="num">0.08 to 0.11 s</dd></div>
              <div><dt>Play sent</dt><dd class="num">0.22 to 0.24 s after the start</dd></div>
              <div><dt>Drawing with the processor</dt><dd class="num">0.29 s</dd></div>
            </dl>
          </div>
        </aside>
      </section>

      <section class="part" aria-labelledby="click">
        <h2 id="click">{title.click}</h2>
        <div class="text">
          <ul class="facts">
            <li>
              featherplay only: Pear Desktop and Edge weren't part of this measurement. In Liked songs, the play button on a
              song's cover was clicked through the window itself, with the messages Windows sends for a mouse click (move,
              press, release). The real pointer didn't move.
            </li>
            <li>
              On featherplay's own desktop the first press and release after a move never counted (0.2.0 behaves the same
              there), so each click was a move, then two presses and releases 40 ms apart. The second release plays the
              song. The first press lets featherplay start on the song about 45 ms early, as a real click's press does.
            </li>
            <li>The clock starts at the release, the moment a click counts, and stops at the same first sound as above.</li>
            <li>
              Hovered first means the pointer rests on the song before the click; featherplay starts getting a song ready
              120 ms into a hover, or at a press. For these clicks a press and release 1 s before the click stood in for a
              1 s hover, which starts the same work. Not hovered means the click alone.
            </li>
            <li>
              Two sessions of six clicks, {click.n} in all, alternating hovered and not. featherplay started paused, so each
              session's first click came while nothing played; each next one came about 12 s into the song the last click
              started. While a song plays, featherplay prepares the songs on screen, as it does in everyday use. Before each
              session the songs' kept streams were removed, so only that session's work made a song ready.
            </li>
            <li>
              All {click.n}: median {formatFigure("clickToSoundS", click.median)}, {s(click.min)} to {s(click.max)}. Hovered
              first: median {s(hovered.median)} ({s(hovered.min)} to {s(hovered.max)}). Not hovered: median{" "}
              {s(notHovered.median)} ({s(notHovered.min)} to {s(notHovered.max)}).
            </li>
            <li>
              By what was ready: {preparedAhead.n} of the {click.n} songs had been prepared while another played (median{" "}
              {s(preparedAhead.median)}, {s(preparedAhead.min)} to {s(preparedAhead.max)}). A prepared song's stream isn't
              fetched ahead: the click's first press starts it, and a quick click waits for it, as all 5 quick ones here did
              (0.043 to 0.37 s); a hovered one plays from memory. One session's first click was ready from its hover alone
              ({s(hoveredOnly.median)}). The other session's first was cold: it waited for its lookup and its stream's
              first request ({s(cold.median)}).
            </li>
            <li>
              Drawing with the processor, the same two sessions came to a median of 0.008 s (0.002 to 0.40 s): hovered
              0.006 s, not hovered 0.056 s. The quick clicks' waits are the stream's first bytes from the network, in
              both modes.
            </li>
          </ul>
        </div>
        <aside class="aside" aria-label="The clicks">
          <div class="sheet">
            <p class="sheet-h">featherplay {fp.version}, {click.n} clicks</p>
            <table class="clicks">
              <thead>
                <tr><th scope="col">Clicks</th><th scope="col">Median</th><th scope="col">Range</th></tr>
              </thead>
              <tbody>
                {
                  clickRows.map((r, i) => (
                    <tr class:list={{ all: i === 0 }}>
                      <th scope="row">
                        {r.k} <span class="n">{r.t.n}</span>
                      </th>
                      <td>{r.median}</td>
                      <td>{r.range}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </aside>
      </section>

      <section class="part" aria-labelledby="counted">
        <h2 id="counted">{title.counted}</h2>
        <div class="text">
          <ul class="facts">
            <li>
              Every process each player runs: {procs(fp)} for featherplay, {procs(pear)} for Pear Desktop and {procs(edge)} for
              Edge. Edge's are picked out by the profile folder, so no other Edge window gets counted. featherplay's would
              include any helper it starts to find a song's stream; none ran while it was measured.
            </li>
            <li>
              Memory is private memory, the memory those processes keep for themselves, averaged over the run. It's in MB as
              Windows counts them: 1 MB is 1,048,576 bytes, here and for every size on the site.
            </li>
            <li>
              CPU is a share of the whole processor: the CPU seconds the processes used, divided by the seconds measured,
              divided by the 16 logical processors. Windows charges CPU time in 15.6 ms ticks, which can miss very short
              wakes; 0.2.0's paused figure of 0% came from that. So featherplay's processor cycles are counted too, as CPU
              seconds at the processor's reference rate. Until 0.4.0 the two agreed (0.4.0: 0.063% charged, 0.062% in
              cycles). Since 0.7.0 the charged time no longer follows the work: on 27 November, for cycles of 0.048 to
              0.049% while playing, the runs read 0.031 to 0.078%. featherplay's CPU figures are therefore its cycles
              (0.0485 to 0.0492% while playing, drawing with the graphics card); Pear Desktop's and Edge's are their CPU
              seconds, as measured on 1 November. Paused, both ways come to 0.002%.
            </li>
            <li>
              Download is what you download to install it: featherplay {release.version}'s installer (or the{" "}
              {release.portable ? sizeLabel(release.portable) : ""} portable exe), Pear Desktop's {figureText(pear, "downloadMB")}{" "}
              installer. Edge comes with Windows, so there's nothing to download.
            </li>
            <li>
              The two folders under the comparison are Pear Desktop's install folder on the same PC, listed on 1 November
              2026 ({installFolders.pear.files} files, {formatBytes(installFolders.pear.bytes)}), and featherplay's portable
              exe. Source: {file(installFolders.source)}. Installed, featherplay's folder is the same exe plus its uninstaller
              (about {formatBytes(installFolders.featherplay.installed.uninstallerBytes)}) and the Visual C++ runtime the exe
              needs (about {formatBytes(installFolders.featherplay.installed.runtimeBytes)}), source:{" "}
              {file(installFolders.featherplay.installed.source)}, so its installed size is given as an approximation.
            </li>
          </ul>
        </div>
        <aside class="aside" aria-label="The units">
          <div class="sheet">
            <p class="sheet-h">The units</p>
            <dl>
              <div><dt>Memory</dt><dd>private memory, all processes, averaged</dd></div>
              <div><dt>1 MB</dt><dd class="num">1,048,576 bytes</dd></div>
              <div><dt>CPU</dt><dd>CPU seconds ÷ seconds measured ÷ 16 logical processors (featherplay’s from its cycles)</dd></div>
              <div><dt>Windows’ CPU tick</dt><dd class="num">15.6 ms</dd></div>
            </dl>
          </div>
          <div class="sheet">
            <p class="sheet-h">Processes</p>
            <dl>
              {figures.map((f) => <div><dt>{f === edge ? "Edge" : f.app}</dt><dd class="num">{procs(f)}</dd></div>)}
            </dl>
          </div>
        </aside>
      </section>

      <section class="part" aria-labelledby="dropped">
        <h2 id="dropped">{title.dropped}</h2>
        <div class="text">
          <p class="para">On 1 November, two runs were thrown away and done again:</p>
          <ul class="facts">
            <li>Edge's first playing run, because playback had stalled.</li>
            <li>
              Edge's second playing run, because a rounding bug in the script's CPU column spoiled its CPU figure. The bug is
              fixed. That run's memory, 999 MB, agrees with the run that's used.
            </li>
          </ul>
          <p class="para">On 27 November:</p>
          <ul class="facts">
            <li>
              A trial run, which looked up the runs' song once so that every run played it from the stream featherplay had
              kept, and a dry run of the whole set weren't counted.
            </li>
            <li>
              A first set that morning, on an earlier build, stopped after five runs. The figures are the afternoon's
              set, on the final build, and the morning's isn't used.
            </li>
            <li>
              Two runs of 0.7.0 on the same folder and settings, taken in turn with the others, sat at 28 MB at 0.057%
              CPU in cycles. They're 0.7.0's, so they aren't used.
            </li>
          </ul>
        </div>
        <aside class="aside" aria-label="featherplay's memory while playing, by run">
          <div class="sheet">
            <p class="sheet-h">featherplay’s memory while playing</p>
            <dl>
              <div><dt>{fp.version}, graphics card, three runs</dt><dd class="num">55 to 56 MB</dd></div>
              <div><dt>The same, from 40 s on</dt><dd class="num">43 to 45 MB</dd></div>
              <div><dt>{fp.version}, processor, three runs</dt><dd class="num">30 to 31 MB</dd></div>
              <div><dt>0.7.0, the same afternoon</dt><dd class="num">28 MB</dd></div>
              <div><dt>0.7.0, 26 November</dt><dd class="num">29 MB</dd></div>
              <div><dt>0.4.0, 14 November</dt><dd class="num">38 to 39 MB</dd></div>
            </dl>
          </div>
        </aside>
      </section>

      <section class="part" aria-labelledby="scripts">
        <h2 id="scripts">{title.scripts}</h2>
        <div class="text">
          <p class="para">
            PowerShell scripts took the samples and wrote them to CSV files. On 1 November, <code>measure-pear.ps1</code>{" "}
            for Pear Desktop and <code>measure-edge.ps1</code> for Edge, which reads each process's CPU time from Windows' own
            process list (Win32_Process). On 27 November, <code>measure-pass.ps1</code> for featherplay (the method of the 1
            November script, with more columns, the processor cycles among them), <code>run-starts.ps1</code> and{" "}
            <code>run-clicks.ps1</code> for the two timings, and <code>shown.ps1</code> for the window shown.
          </p>
        </div>
        <aside class="aside" aria-label="The scripts, as files">
          <figure class="folder">
            <figcaption class="f-bar"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><use href="#m-folder"></use></svg>The scripts</figcaption>
            <ul class="f-list">
              {
                scripts.map((x) => (
                  <li>
                    <svg class="glyph" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                      <use href="#m-script" />
                    </svg>
                    <span class="f-name">{x.name}</span>
                    <span class="f-what">{x.what}</span>
                  </li>
                ))
              }
            </ul>
          </figure>
        </aside>
      </section>

      <section class="part wide" aria-labelledby="sources">
        <h2 id="sources">{title.sources}</h2>
        <p class="para text">
          Each player’s files, by their place in the measurements’ write-ups, and the figures each one gives.
        </p>
        <div class="folders">
          {
            figures.map((f) => {
              const d = folderOf(f);
              return (
                <figure class="folder" aria-labelledby={`src-${f.app.replace(/\W+/g, "-")}`}>
                  <figcaption class="f-bar" id={`src-${f.app.replace(/\W+/g, "-")}`}>
                    <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                      <use href="#m-folder" />
                    </svg>
                    <span>
                      {f.app} {f.version}
                    </span>
                  </figcaption>
                  <p class="crumbs">
                    {d.crumbs.map((c, i) => (
                      <span class:list={["crumb", { here: i === d.crumbs.length - 1 }]}>{c}</span>
                    ))}
                  </p>
                  <ul class="f-list">
                    {d.files.map((x) => (
                      <li class="src">
                        <svg class="glyph" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
                          <use href={`#m-${x.kind}`} />
                        </svg>
                        <span class="f-name">{x.name}</span>
                        <dl class="gives">
                          {x.ms.map((m) => (
                            <div>
                              <dt>{names[m]}</dt>
                              <dd>{figureText(f, m)}</dd>
                            </div>
                          ))}
                        </dl>
                      </li>
                    ))}
                    {d.none.length > 0 && (
                      <li class="src none">
                        <span class="f-name">Not part of this measurement</span>
                        <dl class="gives">
                          {d.none.map((m) => (
                            <div>
                              <dt>{names[m]}</dt>
                              <dd>{figureText(f, m)}</dd>
                            </div>
                          ))}
                        </dl>
                      </li>
                    )}
                  </ul>
                </figure>
              );
            })
          }
        </div>
      </section>

      <p class="back"><a class="text-link" href="/#light">Back to the comparison</a></p>
    </div>
  </main>
  <SiteFooter />
</Base>

<script>
  // The index marks the part being read (as the Questions section's index does).
  const links = new Map<Element, HTMLAnchorElement>();
  for (const a of document.querySelectorAll<HTMLAnchorElement>("[data-method-index] a")) {
    const part = document.getElementById(a.hash.slice(1))?.closest("section");
    if (part) links.set(part, a);
  }
  if (links.size && "IntersectionObserver" in window) {
    const shown = new Set<Element>();
    const io = new IntersectionObserver(
      (es) => {
        for (const e of es) e.isIntersecting ? shown.add(e.target) : shown.delete(e.target);
        const at = [...links.keys()].find((p) => shown.has(p));
        for (const [p, a] of links) {
          if (p === at) a.setAttribute("aria-current", "true");
          else a.removeAttribute("aria-current");
        }
      },
      { rootMargin: "-30% 0px -55% 0px" },
    );
    for (const p of links.keys()) io.observe(p);
  }
</script>

