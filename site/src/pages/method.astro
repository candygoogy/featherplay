---
// How the comparison's figures were measured, and where each one comes from. The setups are
// the two measurements' (featherplay 0.3.0 on 13 November 2026, Pear Desktop and Edge on
// 1 November; their write-ups are kept outside the repo), plus 0.2.0's one run with the sound
// features on (9 November); the figures and the sizes come from numbers.ts and release.ts.
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import { figureFor, figures, installFolders, metrics, timings, withProcessing, type Metric } from "../data/numbers";
import { figureText, formatBytes, formatFigure } from "../data/format";
import { release, sizeLabel } from "../data/release";

const names: Record<Metric, string> = {
  memoryMB: "Memory while playing",
  memoryPausedMB: "Memory while paused",
  cpuPlayingPct: "CPU while playing",
  cpuPausedPct: "CPU while paused",
  processes: "Processes",
  startToSoundS: "Start to music playing",
  clickToSoundS: "Click to sound",
  downloadMB: "Download",
};
const file = (path: string) => path.split("/").pop() ?? path;
// A figure's source, by its path inside the measurements folder.
const source = (path: string | null) => (path ? path.replace(/^measurements\//, "") : "Not part of this measurement");
const fp = figureFor("featherplay");
const pear = figureFor("Pear Desktop");
const edge = figureFor("YouTube Music in Edge");
const procs = (f: (typeof figures)[number]) => figureText(f, "processes");
// Seconds as the page writes them: two significant figures (0.73 s, 6.4 s, 0.003 s).
const s = (v: number) => `${v.toLocaleString("en-GB", { maximumSignificantDigits: 2 })} s`;
const { startToSoundS: start, clickToSoundS: click, hovered, notHovered, preparedAhead, hoveredOnly, cold } = timings;
---

<Base
  title="How featherplay's figures were measured"
  description="The PC, the versions and the method behind the memory, CPU, timing and download figures that compare featherplay with Pear Desktop and YouTube Music in Edge."
>
  <Header />
  <main id="main" tabindex="-1" class="wrap method">
    <h1>How these were measured</h1>
    <p class="lede">
      All three players were measured on one PC: Pear Desktop and Edge on the evening of 1 November 2026, featherplay
      {fp.version} early on 13 November. Every figure on the home page comes from those two measurements, and each one
      names its files below.
    </p>

    <section aria-labelledby="setup">
      <h2 id="setup">The PC and the players</h2>
      <ul class="facts">
        <li>
          An AMD Ryzen 7 9800X3D (8 cores, 16 logical processors) with 32 GB of memory, running Windows 11 Pro for
          Workstations, build 26300.
        </li>
        <li>
          featherplay {fp.version}, the release's own portable exe, the one offered for download, checked against the
          release's checksums: the exe is{release.portable ? ` ${sizeLabel(release.portable)}` : ""}, the installer
          {release.installer ? ` ${sizeLabel(release.installer)}` : ""}. It ran on a copy of a long-used featherplay
          folder (settings, saved queue, kept streams and covers), with Streaming quality on High, so every song played
          as Opus. The settings were its owner's (lyrics on, a 2 s crossfade, the equalizer, Even out loudness and Skip
          silence off), with Discord status off. Last.fm was off, as the folder wasn't signed in to it.
        </li>
        <li>Pear Desktop {pear.version}, installed, with its owner's settings left as they were.</li>
        <li>
          YouTube Music in Microsoft Edge {edge.version}: a separate Edge with a clean profile of its own and no
          extensions, one tab, signed in.
        </li>
      </ul>
    </section>

    <section aria-labelledby="run">
      <h2 id="run">How each one ran</h2>
      <ul class="facts">
        <li>
          Pear Desktop and Edge, on 1 November: the same song in both, on repeat, at normal volume. Each was the only
          player running. Pear Desktop stayed open but paused while Edge was measured, and wasn't counted.
        </li>
        <li>
          featherplay, on 13 November: one song on repeat, at featherplay's volume of 2 % (Windows' own volume left as
          it was), three runs. Each figure is the median of the three. Pear Desktop wasn't running at any point.
          featherplay ran on a Windows desktop of its own, so its window never showed while the PC was in use; the
          whole machine averaged 8 to 9 % CPU over each part of a run.
        </li>
        <li>The window was minimised, and no games were running.</li>
        <li>Five minutes playing, then three minutes paused, with a sample every 5 seconds.</li>
        <li>
          With the equalizer, Even out loudness, Skip silence and a 5 s crossfade all on, one more run, of featherplay
          0.2.0 on 9 November, used {withProcessing.memoryMB} MB of memory and{" "}
          {formatFigure("cpuPlayingPct", withProcessing.cpuPlayingPct)} CPU while playing. That run is 0.2.0's, wasn't
          repeated for {fp.version}, and isn't in the comparison.
        </li>
      </ul>
    </section>

    <section aria-labelledby="start">
      <h2 id="start">Start to music playing</h2>
      <ul class="facts">
        <li>
          featherplay only: Pear Desktop and Edge weren't part of this measurement. Each start resumed the queue
          featherplay had saved, which picks a song up at 0:04, so the song had to load and seek. 0.2.2's starts
          resumed theirs at 0:49, a longer seek, so the two figures aren't directly comparable.
        </li>
        <li>
          The clock starts when Windows creates featherplay's process and stops when its audio engine logs the first
          sound: the moment Windows' audio output takes the song's first samples.
        </li>
        <li>
          Play was sent the way the taskbar thumbnail's Play button sends it, as soon as the window would take it, 0.07
          to 0.12 s after the start. The window was shown, not minimised.
        </li>
        <li>
          Warm starts, with featherplay and its folder already used: one start to warm up, not counted, then{" "}
          {start.n}. The median is {formatFigure("startToSoundS", start.median)}, and they took {s(start.min)} to{" "}
          {s(start.max)}. All {start.n} played the stream featherplay had kept from the last session, with no lookup, so
          from Play to the first sound was the stream's first request and the seek: 0.10 to 0.22 s.
        </li>
        <li>
          A new install has nothing kept yet. In 0.2.0, a new install's very
          first song took longer, about 12 s once, while featherplay downloaded the two helpers it used (yt-dlp and
          Deno); the starts after it took 0.5 to 0.9 s. Since featherplay answers YouTube's player challenges with the
          JavaScript engine built into it, the first song no longer waits for that download: a new install prepares
          YouTube's player at startup, in about 5 s, and a first click after that is one request (0.2 to 0.6 s,
          measured on 9 November 2026). About one fresh start in seven gets answers from YouTube without a stream,
          and then plays through yt-dlp instead (4 to 9 s) until the next song.
        </li>
      </ul>
    </section>

    <section aria-labelledby="click">
      <h2 id="click">Click to sound</h2>
      <ul class="facts">
        <li>
          featherplay only: Pear Desktop and Edge weren't part of this measurement. In Liked songs, the play button on a
          song's cover was clicked through the window itself, with the messages Windows sends for a mouse click (move,
          press, release). The real pointer didn't move.
        </li>
        <li>
          On featherplay's own desktop the first press and release after a move never counted (0.2.0 behaves the same
          there), so each click was a move, then two presses and releases 40 ms apart. The second release plays the
          song. The first press lets featherplay start on the song about 45 ms early, as a real click's press does.
        </li>
        <li>
          The clock starts at the release, the moment a click counts, and stops at the same first sound as above.
        </li>
        <li>
          Hovered first means the pointer rests on the song before the click; featherplay starts getting a song ready
          120 ms into a hover, or at a press. For these clicks a press and release 1 s before the click stood in for a
          1 s hover, which starts the same work. Not hovered means the click alone.
        </li>
        <li>
          Two sessions of six clicks, {click.n} in all, alternating hovered and not. featherplay started paused, so each
          session's first click came while nothing played; each next one came about 12 s into the song the last click
          started. While a song plays, featherplay prepares the songs on screen, as it does in everyday use. Before each
          session the songs' kept streams were removed, so only that session's work made a song ready.
        </li>
        <li>
          All {click.n}: median {formatFigure("clickToSoundS", click.median)}, {s(click.min)} to {s(click.max)}. Hovered
          first: median {s(hovered.median)} ({s(hovered.min)} to {s(hovered.max)}). Not hovered: median{" "}
          {s(notHovered.median)} ({s(notHovered.min)} to {s(notHovered.max)}).
        </li>
        <li>
          By what was ready: {preparedAhead.n} of the {click.n} songs had been prepared while another played (median{" "}
          {s(preparedAhead.median)}, {s(preparedAhead.min)} to {s(preparedAhead.max)}). A prepared song's stream isn't
          fetched ahead, so a click on one waits for the stream's first request; a hovered one plays from memory. One
          session's first click was ready from its hover alone ({s(hoveredOnly.median)}). The other session's first was
          cold: it waited for its lookup and its stream's first request ({s(cold.median)}).
        </li>
      </ul>
    </section>

    <section aria-labelledby="counted">
      <h2 id="counted">What's counted</h2>
      <ul class="facts">
        <li>
          Every process each player runs: {procs(fp)} for featherplay, {procs(pear)} for Pear Desktop and{" "}
          {procs(edge)} for Edge. Edge's are picked out by the profile folder, so no other Edge window gets counted.
          featherplay's would include any helper it starts to find a song's stream; none ran while it was measured.
        </li>
        <li>
          Memory is private memory, the memory those processes keep for themselves, averaged over the run. It's in MB
          as Windows counts them: 1 MB is 1,048,576 bytes, here and for every size on the site.
        </li>
        <li>
          CPU is a share of the whole processor: the CPU seconds the processes used, divided by the seconds measured,
          divided by the 16 logical processors. Windows charges CPU time in 15.6 ms ticks, which can miss very short
          wakes; 0.2.0's paused figure of 0% came from that. For {fp.version} the processor cycles were counted too.
          While playing they agree with the CPU seconds; paused, the CPU seconds are five or six of those ticks in three
          minutes, and the cycles come to 0.002% against their 0.003%.
        </li>
        <li>
          Download is what you download to install it: featherplay's installer (or the{" "}
          {release.portable ? sizeLabel(release.portable) : ""} portable exe), Pear Desktop's {figureText(pear, "downloadMB")}{" "}
          installer. Edge comes with Windows, so there's nothing to download.
        </li>
        <li>
          The two folders under the comparison are Pear Desktop's install folder on the same PC, listed on 1 November
          2026 ({installFolders.pear.files} files, {formatBytes(installFolders.pear.bytes)}), and featherplay's portable
          exe. Source: {file(installFolders.source)}. Installed, featherplay's folder is the same exe plus its
          uninstaller (about {formatBytes(installFolders.featherplay.installed.uninstallerBytes)}) and the Visual C++
          runtime the exe needs (about {formatBytes(installFolders.featherplay.installed.runtimeBytes)}), source:{" "}
          {file(installFolders.featherplay.installed.source)}, so its installed size is given as an approximation.
        </li>
      </ul>
    </section>

    <section aria-labelledby="dropped">
      <h2 id="dropped">Left out, and measured again</h2>
      <p class="para">On 1 November, two runs were thrown away and done again:</p>
      <ul class="facts">
        <li>Edge's first playing run, because playback had stalled.</li>
        <li>
          Edge's second playing run, because a rounding bug in the script's CPU column spoiled its CPU figure. The bug
          is fixed. That run's memory, 999 MB, agrees with the run that's used.
        </li>
      </ul>
      <p class="para">On 13 November:</p>
      <ul class="facts">
        <li>
          A trial run, which looked up the runs' song once so that every run played it from the stream featherplay had
          kept, wasn't counted.
        </li>
        <li>
          One of the three runs sat at 58 MB of memory from the start, the other two at 41 and 42 MB, with the same song.
          0.2.2's runs did the same (one of three at 57 MB), as did 0.2.0's exe when it was tried; what puts a run there
          wasn't found. The median of the three is the figure used.
        </li>
      </ul>
    </section>

    <section aria-labelledby="scripts">
      <h2 id="scripts">The scripts</h2>
      <p class="para">
        PowerShell scripts took the samples and wrote them to CSV files. On 1 November, <code>measure-pear.ps1</code>{" "}
        for Pear Desktop and <code>measure-edge.ps1</code> for Edge, which reads each process's CPU time from Windows'
        own process list (Win32_Process). On 13 November, <code>measure-pass.ps1</code> for featherplay (the method of
        the 1 November script, with more columns, the processor cycles among them), and <code>run-starts.ps1</code> and{" "}
        <code>run-clicks.ps1</code> for the two timings.
      </p>
    </section>

    <section aria-labelledby="sources">
      <h2 id="sources">Every figure and its source</h2>
      {
        figures.map((f) => (
          <div class="app">
            <h3>
              {f.app} {f.version}
            </h3>
            <dl>
              {metrics.map((m) => (
                <div class="fact">
                  <dt>{names[m]}</dt>
                  <dd>
                    <span class="v">{figureText(f, m)}</span>
                    <span class="src">{source(f.sources[m])}</span>
                  </dd>
                </div>
              ))}
            </dl>
          </div>
        ))
      }
    </section>

    <p class="back"><a href="/#light">Back to the comparison</a></p>
  </main>
</Base>

<style>
  .method {
    padding-block: clamp(48px, 8vw, 120px);
    max-width: 960px;
  }
  h1 {
    font-size: clamp(2.75rem, 7vw, 5.5rem);
  }
  .lede {
    max-width: 44ch;
    margin-top: 24px;
    font-size: clamp(1.125rem, 1.6vw, 1.375rem);
    font-weight: 600;
    line-height: 1.35;
  }
  .para {
    max-width: 64ch;
    margin-bottom: 14px;
  }
  code {
    font-size: 0.9375em;
    white-space: nowrap;
  }
  section {
    margin-top: clamp(56px, 7vw, 96px);
  }
  h2 {
    font-size: clamp(1.75rem, 3.4vw, 2.75rem);
    margin-bottom: 24px;
  }
  .facts {
    display: grid;
    gap: 14px;
    max-width: 64ch;
    padding-left: 1.2em;
  }
  .app {
    margin-top: 40px;
  }
  h3 {
    font-size: 1.375rem;
    margin-bottom: 12px;
  }
  dl {
    display: grid;
    gap: 8px;
  }
  .fact {
    display: grid;
    grid-template-columns: minmax(0, 14rem) 1fr;
    gap: 4px 24px;
    padding: 10px 0;
  }
  dt {
    color: var(--text-muted);
  }
  dd {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    margin: 0;
  }
  .v {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .src {
    color: var(--text-muted);
    font-size: 0.9375rem;
    overflow-wrap: anywhere;
  }
  .back {
    margin-top: 64px;
    font-weight: 700;
  }
  @media (max-width: 640px) {
    .fact {
      grid-template-columns: 1fr;
    }
  }
</style>
