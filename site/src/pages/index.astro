---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Stage from "../components/Stage.astro";
import Compare from "../components/Compare.astro";
import LyricsShowcase from "../components/LyricsShowcase.astro";
import Customise from "../components/Customise.astro";
import Faq from "../components/Faq.astro";
import Download from "../components/Download.astro";
import Footer from "../components/Footer.astro";
---

<Base
  app
  system
  title="featherplay: a light, native music player for Windows and Linux"
  description="featherplay is a free, native player for YouTube Music on Windows and Linux, with Last.fm scrobbling, Discord status, media keys and synced lyrics, and no browser running behind it."
>
  <Header />
  <main id="main" tabindex="-1">
    <Stage />
    <Compare />
    <LyricsShowcase />
    <Customise />
    <Faq />
    <Download />
  </main>
  <Footer />
</Base>
