---
import Base from "../layouts/Base.astro";
import Bar from "../components/Bar.astro";
import Desk from "../components/Desk.astro";
import Stage from "../components/Stage.astro";
import Numbers from "../components/sections/Numbers.astro";
import LeavesOut from "../components/sections/LeavesOut.astro";
import Lyrics from "../components/sections/Lyrics.astro";
import Yours from "../components/sections/Yours.astro";
import Kept from "../components/Kept.astro";
import Questions from "../components/sections/Questions.astro";
import DownloadSection from "../components/sections/DownloadSection.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<Base
  app
  system
  title="featherplay: a light, native music player for Windows and Linux"
  description="featherplay is a free, native player for YouTube Music on Windows and Linux, with Last.fm scrobbling, Discord status, media keys and synced lyrics, and no browser running behind it."
>
  <Desk />
  <Bar />
  <main id="main" tabindex="-1">
    <Stage />
    <Numbers />
    <LeavesOut />
    <Lyrics />
    <Yours />
    <Kept />
    <Questions />
    <DownloadSection />
  </main>
  <SiteFooter />
</Base>
