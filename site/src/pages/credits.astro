---
// The music in the demo, credited in full: each track with its cover (our own art), where it
// comes from and its licence, then each artist's credit in their own requested wording. The
// players on the home page carry the short credit and link here. Then the two typefaces.
import Base from "../layouts/Base.astro";
import Bar from "../components/Bar.astro";
import DeskLite from "../components/DeskLite.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { musicCredits, musicCreditsNote, songs } from "../data/songs";
---

<Base
  title="Music in the featherplay demo: credits"
  description="The six tracks the featherplay website plays, who made them, where they come from and the licences they're shared under."
  system
>
  <DeskLite />
  <Bar home={false} />
  <main id="main" tabindex="-1" class="frame doc credits-page" data-music-credits>
    <h1 class="t-display">Music in the demo</h1>
    <p class="lede t-lede ink2">
      The players on the home page play short clips of six tracks that their artists share under Creative Commons
      licences. Thank you to them.
    </p>

    <ul class="tracks">
      {
        songs.map((s) => (
          <li class="track" id={s.id}>
            <img src={s.cover} width="72" height="72" alt="" loading="lazy" decoding="async" />
            <div class="tk-text">
              <p class="tk-title">“{s.title}”</p>
              <p class="tk-artist">{s.artist}</p>
            </div>
            {s.credit && (
              <p class="tk-links">
                <a href={s.credit.sourceUrl}>The track</a>
                <span class="dot" aria-hidden="true">·</span>
                <a href={s.credit.licenceUrl}>{s.credit.licence}</a>
              </p>
            )}
          </li>
        ))
      }
    </ul>

    <section class="wording" aria-labelledby="wording-title">
      <h2 id="wording-title">As the artists ask to be credited</h2>
      <ul class="lines">
        {
          musicCredits.map((parts) => (
            <li>{parts.map((p) => (typeof p === "string" ? p : <a href={p.href}>{p.text}</a>))}</li>
          ))
        }
      </ul>
      <p class="note">{musicCreditsNote} The covers are featherplay's own drawings, not the tracks' artwork.</p>
    </section>

    <section class="wording type" id="type" aria-labelledby="type-title">
      <h2 id="type-title">The type</h2>
      <ul class="lines">
        <li>
          The page is set in Manrope by Mikhail Sharanda and the Manrope Project Authors, under the SIL Open Font License 1.1
          (<a href="/fonts/manrope-OFL.txt">licence</a>).
        </li>
        <li>
          The handwritten notes are in Reenie Beanie by James Grieshaber (Typeco), cut to the letters they use, under the SIL Open Font
          License 1.1 (<a href="/fonts/reenie-beanie-OFL.txt">licence</a>).
        </li>
      </ul>
    </section>

    <p class="back"><a href="/">Back to featherplay</a></p>
  </main>
  <SiteFooter />
</Base>

<style>
  .doc > :not(.lede) {
    max-width: 60rem;
  }
  .credits-page {
    padding-block: calc(var(--bar-h) + var(--s8)) clamp(32px, 4vw, 64px);
  }
  /* On the system: the page’s title and lede sizes, the column on the bar’s left edge. */
  .lede {
    max-width: 46ch;
    margin-top: var(--s5);
  }
  .tracks {
    display: grid;
    gap: 4px;
    margin: clamp(40px, 5vw, 64px) 0 0;
    padding: 0;
    list-style: none;
  }
  .track {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr) auto;
    align-items: center;
    gap: 20px;
    padding: 12px;
    border-radius: 18px;
    scroll-margin-top: 24px;
  }
  .track:nth-child(odd) {
    background: var(--surface);
  }
  /* Arrived here from a player's credit: that track, marked. */
  .track:target {
    background: color-mix(in srgb, var(--accent) 14%, var(--surface));
  }
  .track img {
    width: 72px;
    height: 72px;
    border-radius: 12px;
  }
  .tk-title {
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.015em;
  }
  .tk-artist {
    color: var(--text-muted);
  }
  .tk-links {
    display: flex;
    gap: 8px;
    font-weight: 700;
    white-space: nowrap;
  }
  .tk-links a {
    text-underline-offset: 0.2em;
  }
  .dot {
    color: var(--text-muted);
  }
  .wording {
    margin-top: clamp(56px, 7vw, 96px);
  }
  h2 {
    font-size: clamp(1.75rem, 3.4vw, 2.5rem);
    margin-bottom: 20px;
  }
  .lines {
    display: grid;
    gap: 14px;
    max-width: 68ch;
    padding: 0;
    list-style: none;
    line-height: 1.55;
  }
  .lines a,
  .back a {
    text-underline-offset: 0.2em;
  }
  .note {
    max-width: 68ch;
    margin-top: 20px;
    color: var(--text-muted);
  }
  .back {
    margin-top: 56px;
    font-weight: 700;
  }
  @media (max-width: 640px) {
    .track {
      grid-template-columns: 56px minmax(0, 1fr);
      gap: 14px;
    }
    .track img {
      width: 56px;
      height: 56px;
    }
    .tk-links {
      grid-column: 2;
    }
  }
</style>
