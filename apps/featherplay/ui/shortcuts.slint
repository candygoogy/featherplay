// The window's keyboard shortcuts, listed once: Settings' "Keyboard shortcuts" dialog shows
// these rows, and app.slint's key handler reports each one it takes (`Shortcuts.used`), so a
// test can press every listed key and check the handler takes it as listed.
// Keys a menu, a dialog or the search suggestions take for themselves (arrows, Tab, Enter)
// aren't listed: they work as everywhere in Windows.

import { SettingsData } from "pages/settings/data.slint";

export enum ShortcutKind {
    play-pause,
    previous,
    next,
    shuffle,
    repeat,
    volume,
    search,
    search-settings,
    lyrics,
    desktop-lyrics,
    mini-player,
    back,
    forward,
    escape,
    shortcuts,
}

export struct ShortcutRow {
    kind: ShortcutKind,
    // What it does.
    label: string,
    // One keycap each, pressed together; an empty one between two keys that each do it (the
    // list writes "or" there).
    keys: [string],
}

export global Shortcuts {
    out property <[ShortcutRow]> playback: [
        { kind: ShortcutKind.play-pause, label: @tr("Play or pause"), keys: [@tr("Space")] },
        { kind: ShortcutKind.previous, label: @tr("Previous"), keys: [@tr("Ctrl"), "←"] },
        { kind: ShortcutKind.next, label: @tr("Next"), keys: [@tr("Ctrl"), "→"] },
        { kind: ShortcutKind.shuffle, label: @tr("Shuffle on or off"), keys: [@tr("Ctrl"), "S"] },
        { kind: ShortcutKind.repeat, label: @tr("Repeat: off, all, one"), keys: [@tr("Ctrl"), "R"] },
        { kind: ShortcutKind.volume, label: @tr("Volume up or down"), keys: ["↑", "", "↓"] },
    ];
    // Ctrl+M only where the desktop has no tray, as the bar's mini player button (Windows
    // always has one).
    out property <[ShortcutRow]> moving: SettingsData.has-tray ? [
        { kind: ShortcutKind.search, label: @tr("Search"), keys: [@tr("Ctrl"), "K"] },
        { kind: ShortcutKind.search-settings, label: @tr("Search settings (on Settings)"), keys: [@tr("Ctrl"), "F"] },
        { kind: ShortcutKind.lyrics, label: @tr("Lyrics on or off"), keys: [@tr("Ctrl"), "L"] },
        { kind: ShortcutKind.desktop-lyrics, label: @tr("Desktop lyrics on or off"), keys: [@tr("Ctrl"), @tr("Shift"), "L"] },
        { kind: ShortcutKind.back, label: @tr("Back"), keys: [@tr("Alt"), "←"] },
        { kind: ShortcutKind.forward, label: @tr("Forward"), keys: [@tr("Alt"), "→"] },
        { kind: ShortcutKind.escape, label: @tr("Clear the search, or leave Now playing"), keys: [@tr("Esc")] },
        { kind: ShortcutKind.shortcuts, label: @tr("Keyboard shortcuts"), keys: [@tr("Ctrl"), "/"] },
    ] : [
        { kind: ShortcutKind.search, label: @tr("Search"), keys: [@tr("Ctrl"), "K"] },
        { kind: ShortcutKind.search-settings, label: @tr("Search settings (on Settings)"), keys: [@tr("Ctrl"), "F"] },
        { kind: ShortcutKind.lyrics, label: @tr("Lyrics on or off"), keys: [@tr("Ctrl"), "L"] },
        { kind: ShortcutKind.desktop-lyrics, label: @tr("Desktop lyrics on or off"), keys: [@tr("Ctrl"), @tr("Shift"), "L"] },
        { kind: ShortcutKind.mini-player, label: @tr("Mini player on or off"), keys: [@tr("Ctrl"), "M"] },
        { kind: ShortcutKind.back, label: @tr("Back"), keys: [@tr("Alt"), "←"] },
        { kind: ShortcutKind.forward, label: @tr("Forward"), keys: [@tr("Alt"), "→"] },
        { kind: ShortcutKind.escape, label: @tr("Clear the search, or leave Now playing"), keys: [@tr("Esc")] },
        { kind: ShortcutKind.shortcuts, label: @tr("Keyboard shortcuts"), keys: [@tr("Ctrl"), "/"] },
    ];
    // The window's key handler took a shortcut (the tests listen).
    callback used(ShortcutKind);
}
