// The player bar: a rounded panel floating over the bottom of the window,
// `Theme.bar-inset` in from its edges (app.slint places it). The track on the left; in the
// middle the transport around the round play button, with the time, the seek line and the
// length under it; Lyrics (the microphone), "Not for me" (a thumbs-down), like, volume and
// the Up next button on the right, and where the desktop has no tray, the mini player's
// button before them. It reads and drives the `Player` global; `src/bar.rs` connects that to
// the controller. The transport, the mini player, Lyrics, "Not for me" and the speed pill
// share one tooltip (`BarTip`): the name, then the shortcut.
import { Theme, Icons, Curves } from "theme.slint";
import { Body, Cover, IconButton, Icon, PlayButton } from "parts.slint";
import { Player, Repeat } from "player.slint";
import { Nav, PageKind, Frame } from "nav.slint";
import { NotForMeButton, LikeButton } from "not_for_me.slint";
import { BarTip } from "bar_tip.slint";
import { LyricsData, LyricsState } from "pages/lyrics.slint";
import { Chips } from "pages/content.slint";
import { SettingsData } from "pages/settings/data.slint";

// The seek line, between the time and the length: 4 px, 6 px while hovered, with round ends;
// click or drag anywhere on it to seek. Hovered, a thumb sits at the fill's end and a tooltip
// shows the time under the pointer. The fill follows a drag directly and stays
// where it was dropped until the next position arrives. The tray's mini player has one too.
// With Skip silence on, what it drops shows as dashed marks on the line; over one the tooltip
// adds "Silence", and a click there seeks to the mark's end.
export component SeekLine inherits Rectangle {
    // The time under the pointer stays between the line's ends (the mini player's line
    // runs close to its window's edges); by default it may reach half its width past them.
    in property <bool> tip-within: false;
    property <bool> can-seek: Player.has-track && Player.duration-s > 0;
    out property <bool> dragging: ta.pressed && self.can-seek;
    property <bool> active: (ta.has-hover || self.dragging) && self.can-seek;
    // Where the pointer is along the line, 0..1.
    out property <float> preview: clamp(ta.mouse-x / max(1px, self.width), 0, 1);
    // Where a seek was dropped, until the player reports a position (-1: none).
    property <float> dropped: -1;
    property <float> position: Player.position-s;
    property <string> track: Player.track-id;
    changed position => { root.dropped = -1; }
    changed track => { root.dropped = -1; }
    property <float> shown: self.dragging ? self.preview : (self.dropped >= 0 ? self.dropped : (Player.duration-s > 0 ? clamp(Player.position-s / Player.duration-s, 0, 1) : 0));
    property <length> thickness: root.active ? 6px : 4px;
    property <length> mid: self.height / 2;
    // A mark is never drawn shorter than this.
    property <length> min-mark: 8px;
    // The end of the mark under the pointer, 0 off them. Kept as the pointer leaves, so the
    // tooltip doesn't change while it fades out.
    property <float> mark-end: Player.silences.length > 0 ? Player.silence-end(Player.silences, root.preview, root.min-mark / max(1px, root.width)) : 0;
    // A mark's dashes ahead of the fill (behind it they're in the accent).
    property <color> dash-ahead: Theme.pick(#FFFFFF66, #00000059);
    height: 16px;
    accessible-role: slider;
    accessible-label: @tr("Seek");
    accessible-value: Player.elapsed;
    ta := TouchArea {
        enabled: root.can-seek;
        mouse-cursor: pointer;
        pointer-event(e) => {
            // Inside a mark: to its end, where Skip silence would take the song anyway.
            if e.kind == PointerEventKind.up && e.button == PointerEventButton.left {
                let to = root.mark-end > 0 ? root.mark-end : root.preview;
                root.dropped = to;
                Player.seek(to);
            }
        }
    }
    Rectangle {
        y: root.mid - self.height / 2;
        height: root.thickness;
        border-radius: self.height / 2;
        background: Theme.track;
        animate height { duration: Theme.t-hover; }
    }
    if root.shown > 0: Rectangle {
        x: 0;
        y: root.mid - self.height / 2;
        width: max(self.height, root.width * root.shown);
        height: root.thickness;
        border-radius: self.height / 2;
        background: Theme.accent;
        animate height { duration: Theme.t-hover; }
    }
    // Skip silence's marks: each span it drops is cut out of the line, 2 px of the bar's colour
    // at either end, and dashed inside: 3 px dashes every 6 px, the line's thickness, in the
    // accent once played and a pale track colour ahead. A mark is `min-mark` long at least,
    // from the line's start or to its end when the span touches one, else centred on it
    // (`bar::silence_end` hits them the same way, to within a pixel). A song's marks fade in together when they
    // arrive. Rectangles rather than a tiled image: a dozen or so per mark, drawn only
    // while there are marks, with no asset or image shader.
    Rectangle {
        opacity: Player.silences.length > 0 ? 1 : 0;
        visible: self.opacity > 0;
        animate opacity { duration: Theme.fading ? 150ms : 0ms; easing: Curves.ease-out; }
        for s in Player.silences: Rectangle {
            // On whole pixels, so the line doesn't show a fringe at the cuts.
            property <length> from: round(root.width * s.start / 1px) * 1px;
            property <length> to: round(root.width * s.end / 1px) * 1px;
            property <bool> short: self.to - self.from < root.min-mark;
            x: !self.short ? self.from : (s.start <= 0 ? 0 : (s.end >= 1 ? self.to - root.min-mark : clamp(round((self.from + self.to - root.min-mark) / 2px) * 1px, 0, root.width - root.min-mark)));
            y: root.mid - self.height / 2;
            width: max(root.min-mark, self.to - self.from);
            height: root.thickness + 2px;
            border-radius: 1px;
            background: Theme.bar;
            animate height { duration: Theme.t-hover; }
            // As many dashes as the inside holds (the last one may be cut short), within
            // reason: the line is 600 px at most.
            for i in min(120, ceil((self.width - 4px) / 6px)): Rectangle {
                x: 2px + i * 6px;
                y: 1px;
                width: min(3px, parent.width - 2px - self.x);
                height: parent.height - 2px;
                border-radius: 1px;
                background: parent.x + self.x + 1.5px < root.width * root.shown ? Theme.accent : root.dash-ahead;
            }
        }
    }
    // Until the first sound: a shimmer runs along the line (the only repeating animation,
    // and only while loading). Without motion, a quiet static line instead.
    if Player.loading && Theme.moving: Rectangle {
        y: root.mid - 2px;
        height: 4px;
        border-radius: 2px;
        clip: true;
        Rectangle {
            property <float> t: mod(animation-tick() / 1ms, Theme.t-shimmer / 1ms) / (Theme.t-shimmer / 1ms);
            x: (self.t * 1.4 - 0.4) * parent.width;
            width: parent.width * 0.4;
            background: @linear-gradient(90deg, transparent 0%, Theme.accent 50%, transparent 100%);
        }
    }
    if Player.loading && !Theme.moving: Rectangle {
        y: root.mid - 2px;
        height: 4px;
        border-radius: 2px;
        background: Theme.accent;
        opacity: 0.4;
    }
    // The thumb: centred on the fill's end and the line.
    Rectangle {
        x: root.width * root.shown - self.width / 2;
        y: root.mid - self.height / 2;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: Theme.accent;
        drop-shadow-blur: 4px;
        drop-shadow-color: #00000066;
        opacity: root.active ? 1 : 0;
        visible: self.opacity > 0;
        transform-scale: root.active || !Theme.moving ? 1.0 : 0.5;
        animate opacity { duration: Theme.t-fast; easing: Curves.ease-out; }
        animate transform-scale {
            duration: root.active ? Theme.t-release : Theme.t-fast;
            easing: root.active ? Curves.release : Curves.ease-out;
        }
    }
    // The time under the pointer, 8 px above the line; over a mark, a muted "Silence" after it.
    Rectangle {
        property <length> w: tip.preferred-width;
        property <length> reach: root.tip-within ? 0 : self.w / 2;
        x: clamp(ta.mouse-x - self.w / 2, -self.reach, root.width - self.w + self.reach);
        y: root.mid - 3px - Theme.s2 - self.height;
        width: self.w;
        height: tip.preferred-height;
        border-radius: Theme.r-s;
        background: Theme.card;
        drop-shadow-blur: 8px;
        drop-shadow-color: Theme.cover-shadow;
        opacity: root.active ? 1 : 0;
        visible: self.opacity > 0;
        animate opacity { duration: Theme.t-fast; easing: Curves.ease-out; }
        tip := HorizontalLayout {
            padding-left: 6px;
            padding-right: 6px;
            padding-top: 4px;
            padding-bottom: 4px;
            spacing: Theme.s2;
            Body {
                text: Player.clock(root.preview * Player.duration-s);
                font-size: Theme.t-meta;
                font-weight: 600;
                color: Theme.text1;
                vertical-alignment: center;
            }
            if root.mark-end > 0: Body {
                text: @tr("Silence");
                font-size: Theme.t-meta;
                color: Theme.text2;
                vertical-alignment: center;
            }
        }
    }
}

// The volume: a click or a drag sets it, a wheel notch and Up or Down (`step`) move it by the
// Volume step. While it changes, its value shows above the line: 1.5 s past the last wheel
// or key change, while pressed and 0.4 s past the release; then it fades out.
component VolumeSlider inherits Rectangle {
    property <float> preview: clamp(ta.mouse-x / max(1px, self.width), 0, 1);
    // The wheel or the keys changed the volume and it isn't saved yet: `save` saves it a
    // second after the last change.
    property <bool> unsaved: false;
    // The value shows: from a change until `rest` ends, and while the slider is pressed.
    property <bool> changing: false;
    property <bool> tip: root.changing || ta.pressed;
    // How long the value stays after the last change: long enough to read after a wheel
    // or key step, shorter after a drag, which showed it all along.
    property <duration> hold: 1.5s;
    width: 88px;
    accessible-role: slider;
    accessible-label: @tr("Volume");
    accessible-value: round(Player.volume * 100) + " %";
    // Up or Down: one step onto the step's grid (37 % and Up at 5 % is 40 %), within 0–100 %.
    // The small margin keeps a value a hair off the grid (0.4 as 39.99998 %) from counting as
    // below it.
    public function step(up: bool) {
        let s = max(1, Player.volume-step);
        let at = Player.volume * 100 / s;
        let to = up ? floor(at + 0.01) + 1 : ceil(at - 0.01) - 1;
        Player.set-volume(clamp(to * s / 100, 0, 1), false);
        root.stepped();
    }
    // A wheel or key change: shows the value for `hold` and saves it a second later.
    function stepped() {
        root.unsaved = true;
        if save.running {
            save.restart();
        } else {
            save.running = true;
        }
        root.linger(1.5s);
    }
    // Shows the value and starts its time `d` again.
    function linger(d: duration) {
        root.changing = true;
        root.hold = d;
        if rest.running {
            rest.restart();
        } else {
            rest.running = true;
        }
    }
    // Saves an unsaved change; runs only after one, for a second.
    save := Timer {
        interval: 1s;
        running: false;
        triggered => {
            self.running = false;
            if root.unsaved {
                root.unsaved = false;
                Player.set-volume(Player.volume, true);
            }
        }
    }
    // Runs only while the value shows.
    rest := Timer {
        interval: root.hold;
        running: false;
        triggered => {
            self.running = false;
            root.changing = false;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        // A notch (60 px) moves it one step; a touchpad's smaller steps move it in proportion.
        scroll-event(e) => {
            if e.delta-y == 0 {
                return reject;
            }
            Player.set-volume(clamp(Player.volume + e.delta-y / 60px * Player.volume-step / 100, 0, 1), false);
            root.stepped();
            accept
        }
        // Pressed, the value shows by `ta.pressed`; the release saves it.
        pointer-event(e) => {
            if e.button == PointerEventButton.left {
                if e.kind == PointerEventKind.down {
                    rest.running = false;
                    root.changing = false;
                    Player.set-volume(root.preview, false);
                } else if e.kind == PointerEventKind.up {
                    Player.set-volume(root.preview, true);
                    root.unsaved = false;
                    save.running = false;
                    root.linger(400ms);
                }
            }
        }
        moved => {
            if self.pressed {
                Player.set-volume(root.preview, false);
            }
        }
    }
    Rectangle {
        y: (parent.height - 4px) / 2;
        height: 4px;
        border-radius: 2px;
        background: Theme.track;
    }
    Rectangle {
        x: 0;
        y: (parent.height - 4px) / 2;
        width: parent.width * clamp(Player.volume, 0, 1);
        height: 4px;
        border-radius: 2px;
        background: ta.has-hover || ta.pressed ? Theme.accent : Theme.text2;
        animate background { duration: Theme.t-hover; }
    }
    // The value, 8 px above the line, over the fill's end and kept within the slider: like
    // the seek line's time. It glides to a wheel or key step's value, but sticks to the
    // pointer while pressed; it comes in quickly and leaves more gently.
    Rectangle {
        property <length> w: value.preferred-width + 12px;
        x: clamp(root.width * clamp(Player.volume, 0, 1) - self.w / 2, 0, root.width - self.w);
        y: root.height / 2 - 2px - Theme.s2 - self.height;
        width: self.w;
        height: value.preferred-height + 8px;
        border-radius: Theme.r-s;
        background: Theme.card;
        drop-shadow-blur: 8px;
        drop-shadow-color: Theme.cover-shadow;
        opacity: root.tip ? 1 : 0;
        visible: self.opacity > 0;
        animate opacity { duration: root.tip ? Theme.t-fast : Theme.t-linger; easing: Curves.ease-out; }
        animate x { duration: ta.pressed ? 0ms : Theme.t-step; easing: Curves.ease-out; }
        value := Body {
            text: @tr("{} %", round(Player.volume * 100));
            font-size: Theme.t-meta;
            font-weight: 600;
            color: Theme.text1;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// Lyrics, the microphone left of "Not for me": Now playing's full lyrics view on and off from
// any page (`LyricsData.toggle-view`; elsewhere it opens Now playing on the lyrics), in the
// accent while the view shows. Its tooltip names what a click does, with the shortcut. For a
// song with no lyrics it says so, and a press does what the stage's pill does: the stage stays
// and the pill's note says why.
component LyricsButton inherits Rectangle {
    // How far above the button the tooltip ends (the bar lifts it clear of itself).
    in property <length> above: Theme.s2;
    width: 36px;
    height: 36px;
    btn := IconButton {
        icon: Icons.lyrics;
        label: @tr("Lyrics");
        description: LyricsData.showing ? @tr("Hides the lyrics, back to the cover") : (LyricsData.missing ? LyricsData.message : @tr("Shows the lyrics on Now playing"));
        active: LyricsData.showing;
        // Off is always possible; on needs a song.
        enabled: Player.has-track || LyricsData.showing;
        clicked => {
            tip.dismiss();
            LyricsData.toggle-view();
        }
    }
    tip := BarTip {
        over: btn.hovered;
        name: LyricsData.showing ? @tr("Hide lyrics") : (LyricsData.state == LyricsState.none ? @tr("No lyrics") : (LyricsData.state == LyricsState.error ? @tr("Retry lyrics") : @tr("Lyrics")));
        hint: @tr("Ctrl+L");
        above: root.above;
    }
}

// The mini player, first in the right-hand group, only where the desktop has no tray
// (`SettingsData.has-tray`; Windows always has one): elsewhere a click on the tray icon opens
// it, and without the icon nothing would. A click opens it above the button or closes it, as
// the icon's click does (`BottomBar.toggle-mini`).
component MiniPlayerButton inherits Rectangle {
    // How far above the button the tooltip ends (the bar lifts it clear of itself).
    in property <length> above: Theme.s2;
    callback clicked();
    width: 36px;
    height: 36px;
    btn := IconButton {
        icon: Icons.mini-player;
        label: @tr("Mini player");
        description: @tr("Opens or closes the mini player");
        clicked => {
            tip.dismiss();
            root.clicked();
        }
    }
    tip := BarTip {
        over: btn.hovered;
        name: @tr("Mini player");
        hint: @tr("Ctrl+M");
        above: root.above;
    }
}

// The bar's play button, with its tooltip: Play or Pause, and its shortcut, Space.
component BarPlayButton inherits Rectangle {
    // How far above the button the tooltip ends (the bar lifts it clear of itself).
    in property <length> above: Theme.s2;
    width: btn.width;
    height: btn.height;
    btn := PlayButton {
        clicked => { tip.dismiss(); }
    }
    tip := BarTip {
        over: btn.hovered;
        name: Player.playing ? @tr("Pause") : @tr("Play");
        hint: @tr("Space");
        above: root.above;
    }
}

// The transport's other buttons (Shuffle, Previous, Next, Repeat): an `IconButton` with the
// bar's tooltip, `tip` and its `hint` (the shortcut). Children go on the button.
component TransportButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> filled: false;
    in property <color> tint: Theme.text2;
    in property <bool> active: false;
    in property <string> tip;
    in property <string> hint;
    // How far above the button the tooltip ends (the bar lifts it clear of itself).
    in property <length> above: Theme.s2;
    callback clicked();
    width: btn.width;
    height: btn.height;
    btn := IconButton {
        icon: root.icon;
        label: root.label;
        filled: root.filled;
        tint: root.tint;
        active: root.active;
        enabled: Player.has-track;
        clicked => {
            bar-tip.dismiss();
            root.clicked();
        }
        @children
    }
    bar-tip := BarTip {
        over: btn.hovered;
        name: root.tip;
        hint: root.hint;
        above: root.above;
    }
}

// The speed while it isn't 1x, just before the bar's right-hand group: a 28 px pill on the
// accent's tonal fill, as a selected chip. A click opens the speed popup over it. Its tooltip
// names it; the pill shows the value.
component SpeedPill inherits Rectangle {
    // How far above the pill's 36 px row the tooltip ends (the bar lifts it clear of itself).
    in property <length> above: Theme.s2;
    width: pill.width;
    height: 36px;
    pill := Rectangle {
        y: 4px;
        height: 28px;
        width: t.preferred-width + 2 * Theme.s3;
        border-radius: self.height / 2;
        background: ta.has-hover || ta.pressed || Player.speed-open ? Theme.accent-tonal-hover : Theme.accent-tonal;
        accessible-role: button;
        accessible-label: @tr("Playback speed, {}", Player.speed-labels[Player.speed]);
        accessible-action-default => { Player.speed-open = true; }
        animate background { duration: Theme.t-hover; }
        ta := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                tip.dismiss();
                Player.speed-open = true;
            }
        }
        t := Body {
            text: Player.speed-labels[Player.speed];
            font-size: Theme.t-meta;
            font-weight: 600;
            color: Theme.text1;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    tip := BarTip {
        over: ta.has-hover;
        name: @tr("Playback speed");
        above: root.above;
    }
}

// The speed popup: the Settings chips in a panel `s2` above the bar, centred on the pill.
// A pick, Escape or a click outside closes it. app.slint draws it over everything, shown
// while `Player.speed-open`.
export component SpeedLayer inherits Rectangle {
    // The bar's top edge, and the pill's centre (window coordinates).
    in property <length> bottom;
    in property <length> anchor;
    callback closed();
    property <bool> open: Player.speed-open;
    changed open => {
        if self.open {
            keys.focus();
        }
    }
    function close() {
        Player.speed-open = false;
        root.closed();
    }
    TouchArea {
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.close();
            }
        }
        scroll-event(e) => {
            root.close();
            accept
        }
    }
    Rectangle {
        width: chips.preferred-width + 2 * Theme.s4;
        height: 2 * Theme.s4 + 20px + Theme.s3 + chips.height;
        x: max(8px, min(root.anchor - self.width / 2, root.width - self.width - 8px));
        y: root.bottom - Theme.s2 - self.height;
        border-radius: Theme.r-l;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.card-edge;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: Theme.cover-shadow;
        accessible-role: list;
        accessible-label: @tr("Playback speed");
        // Swallows clicks on the panel's padding.
        TouchArea { }
        keys := FocusScope {
            key-pressed(e) => {
                if e.text == Key.Escape {
                    root.close();
                    return accept;
                }
                reject
            }
        }
        Body {
            x: Theme.s4;
            y: Theme.s4;
            height: 20px;
            text: @tr("Playback speed");
            font-weight: 600;
            color: Theme.text1;
            vertical-alignment: center;
        }
        chips := Chips {
            x: Theme.s4;
            y: Theme.s4 + 20px + Theme.s3;
            labels: Player.speed-labels;
            active: Player.speed;
            selected(i) => {
                Player.pick-speed(i);
                root.close();
            }
        }
    }
}

export component BottomBar inherits Rectangle {
    // The volume to go back to when unmuting.
    property <float> unmuted: 0.7;
    // Up or Down from the window's keys: the volume one step up or down.
    public function step-volume(up: bool) {
        volume.step(up);
    }
    // The mini player's button, or Ctrl+M: the mini player opens above the button (first in
    // the right-hand group, so at its start), or closes.
    public function toggle-mini() {
        Frame.toggle-mini(root.absolute-position.x + actions.x + 18px, root.absolute-position.y + actions.y);
    }
    // The middle column (the transport, the time and the line), and what's left either side
    // for the title: it stays clear of the buttons on the right at the narrowest window.
    // The speed pill, while it shows, sits just left of the right-hand group, which then
    // takes its room too.
    property <length> right-w: actions.preferred-width + (Player.speed != 2 ? speed-pill.width + 4px : 0px);
    // The right-hand buttons sit as far in from the bar's right end as from its top and bottom,
    // so the last one is centred in the rounded end, as the cover is at the left.
    property <length> end-gap: (Theme.bar-h - 36px) / 2;
    property <length> center-w: max(320px, min(600px, self.width - 2 * (root.right-w + root.end-gap + 2px)));
    // Where the speed popup centres (in the bar).
    out property <length> speed-centre: speed-pill.x + speed-pill.width / 2;
    // The middle column's left edge: centred on the bar, unless that would run it into the
    // right-hand group (the narrowest windows with the speed pill, or Linux's mini player
    // button), then shifted left to stay 12 px clear of it.
    property <length> middle-w: max(root.center-w, transport.preferred-width);
    property <length> middle-x: min((self.width - root.middle-w) / 2, (Player.speed != 2 ? speed-pill.x : actions.x) - 12px - root.middle-w);
    property <length> left-w: max(80px, root.middle-x + (root.middle-w - root.center-w) / 2 - 100px);
    // The transport row, and the time row under it.
    property <length> transport-y: 8px;
    property <length> time-y: 60px;
    height: Theme.bar-h;
    border-radius: Theme.r-xl;
    background: Theme.bar;
    border-width: 1px;
    border-color: Theme.card-edge;
    drop-shadow-blur: 24px;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: Theme.cover-shadow;
    animate background { duration: Theme.t-colour; }

    // Cover, title and artist: open Now playing (or close it).
    Rectangle {
        x: 8px;
        y: 8px;
        width: root.left-w + 84px;
        height: root.height - 16px;
        border-radius: Theme.r-l - 4px;
        background: Player.has-track ? Theme.state(ota.pressed, ota.has-hover) : transparent;
        accessible-role: button;
        accessible-label: Player.has-track ? @tr("Now playing: {}", Player.title) : @tr("Nothing playing");
        accessible-action-default => { Nav.toggle-now-playing(); }
        animate background { duration: Theme.t-hover; }
        ota := TouchArea {
            enabled: Player.has-track;
            mouse-cursor: pointer;
            clicked => { Nav.toggle-now-playing(); }
        }
        Cover {
            x: 8px;
            y: (parent.height - self.height) / 2;
            width: 56px;
            height: 56px;
            radius: Theme.r-m;
            source: Player.cover;
            crossfade: true;
            // Hovered: a veil and a chevron say it opens Now playing.
            Rectangle {
                background: Theme.cover-hover;
                opacity: ota.has-hover && Player.has-track ? 1 : 0;
                visible: self.opacity > 0;
                animate opacity { duration: Theme.t-hover; easing: Curves.ease-hover; }
                Icon {
                    width: 20px;
                    height: 20px;
                    commands: Nav.page == PageKind.now-playing ? Icons.chevron-down : Icons.chevron-up;
                    stroke: #FFFFFF;
                    stroke-width: 2px;
                }
            }
        }
        Body {
            x: 76px;
            y: parent.height / 2 - 19px;
            width: root.left-w;
            text: Player.has-track ? Player.title : @tr("Nothing playing");
            font-weight: 600;
            color: Player.has-track ? Theme.text1 : Theme.text3;
        }
        // The artist links to the artist's page, underlined on hover.
        artist := Rectangle {
            property <bool> link: Player.artist-id != "";
            x: 76px;
            y: parent.height / 2 + 3px;
            width: min(root.left-w, artist-text.preferred-width);
            height: artist-text.preferred-height;
            accessible-role: button;
            accessible-label: Player.artist;
            accessible-action-default => { Nav.open-artist(Player.artist-id); }
            artist-text := Body {
                width: parent.width;
                text: Player.artist;
                font-size: Theme.t-meta;
                color: ata.has-hover && artist.link ? Theme.text1 : Theme.text2;
            }
            if ata.has-hover && artist.link: Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.text1;
            }
            ata := TouchArea {
                enabled: artist.link;
                mouse-cursor: pointer;
                clicked => { Nav.open-artist(Player.artist-id); }
            }
        }
    }

    // The transport, centred over the time row.
    transport := HorizontalLayout {
        x: root.middle-x + (root.middle-w - self.width) / 2;
        y: root.transport-y;
        height: Theme.play-size;
        width: self.preferred-width;
        spacing: 12px;
        // The tooltips end `s2` above the bar.
        TransportButton {
            y: (Theme.play-size - self.height) / 2;
            above: root.transport-y + self.y + Theme.s2;
            icon: Icons.shuffle;
            label: Player.shuffle ? @tr("Shuffle on") : @tr("Shuffle off");
            tip: self.label;
            hint: @tr("Ctrl+S");
            active: Player.shuffle;
            clicked => { Player.toggle-shuffle(); }
        }
        TransportButton {
            y: (Theme.play-size - self.height) / 2;
            above: root.transport-y + self.y + Theme.s2;
            icon: Icons.prev;
            label: @tr("Previous");
            tip: self.label;
            hint: @tr("Ctrl+←");
            filled: true;
            tint: Theme.text1;
            clicked => { Player.previous(); }
        }
        BarPlayButton {
            above: root.transport-y + Theme.s2;
        }
        TransportButton {
            y: (Theme.play-size - self.height) / 2;
            above: root.transport-y + self.y + Theme.s2;
            icon: Icons.next;
            label: @tr("Next");
            tip: self.label;
            hint: @tr("Ctrl+→");
            filled: true;
            tint: Theme.text1;
            clicked => { Player.next(); }
        }
        TransportButton {
            y: (Theme.play-size - self.height) / 2;
            above: root.transport-y + self.y + Theme.s2;
            icon: Icons.repeat;
            label: Player.repeat == Repeat.one ? @tr("Repeat one") : (Player.repeat == Repeat.all ? @tr("Repeat all") : @tr("Repeat off"));
            tip: self.label;
            hint: @tr("Ctrl+R");
            active: Player.repeat != Repeat.off;
            clicked => { Player.cycle-repeat(); }
            if Player.repeat == Repeat.one: Text {
                x: parent.width - 13px;
                y: 4px;
                text: "1";
                font-family: Theme.body-font;
                font-size: 9px;
                font-weight: 700;
                color: Theme.accent;
            }
        }
    }

    // Under the transport: the time, the seek line and the length. Fixed widths for the
    // times, so the line doesn't shift as they tick.
    HorizontalLayout {
        x: root.middle-x + (root.middle-w - root.center-w) / 2;
        y: root.time-y;
        width: root.center-w;
        height: 16px;
        spacing: Theme.s3;
        Body {
            width: 44px;
            text: Player.has-track ? Player.elapsed : "";
            font-size: Theme.t-meta;
            color: Theme.text2;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: clip;
        }
        SeekLine {
            horizontal-stretch: 1;
        }
        Body {
            width: 44px;
            text: Player.has-track ? Player.total : "";
            font-size: Theme.t-meta;
            color: Theme.text2;
            horizontal-alignment: left;
            vertical-alignment: center;
            overflow: clip;
        }
    }

    speed-pill := SpeedPill {
        x: actions.x - self.width - 4px;
        y: actions.y;
        above: (Theme.bar-h - 36px) / 2 + Theme.s2;
        visible: Player.speed != 2;
    }

    actions := HorizontalLayout {
        x: parent.width - self.width - root.end-gap;
        y: (parent.height - 36px) / 2;
        height: 36px;
        width: self.preferred-width;
        spacing: 4px;
        // The tooltips end `s2` above the bar (the buttons sit centred in it).
        // Only without a tray (`if`: a hidden element keeps its room).
        if !SettingsData.has-tray: MiniPlayerButton {
            above: (Theme.bar-h - 36px) / 2 + Theme.s2;
            clicked => { root.toggle-mini(); }
        }
        // Not there with lyrics off in Settings.
        if LyricsData.on: LyricsButton {
            above: (Theme.bar-h - 36px) / 2 + Theme.s2;
        }
        NotForMeButton {
            above: (Theme.bar-h - 36px) / 2 + Theme.s2;
        }
        LikeButton { }
        IconButton {
            icon: Player.volume > 0 ? Icons.volume : Icons.volume-off;
            label: Player.volume > 0 ? @tr("Mute") : @tr("Unmute");
            clicked => {
                if Player.volume > 0 {
                    root.unmuted = Player.volume;
                    Player.set-volume(0, true);
                } else {
                    Player.set-volume(root.unmuted, true);
                }
            }
        }
        volume := VolumeSlider { }
        Rectangle {
            width: 8px;
        }
        IconButton {
            icon: Icons.queue;
            label: @tr("Up next");
            // On Now playing it shows and hides the page's own side panel; elsewhere the
            // frame's Up next panel. Each keeps its own state.
            active: Frame.full-page ? Frame.side-open : Frame.queue-open;
            // The open panel shows the state; a circle here, lit all the time on Now playing
            // (its side panel is open by default), only looked stuck.
            circle: false;
            clicked => {
                if Frame.full-page {
                    Frame.side-open = !Frame.side-open;
                    Frame.side-toggled(Frame.side-open);
                } else {
                    Frame.queue-open = !Frame.queue-open;
                    Frame.queue-toggled(Frame.queue-open);
                }
            }
        }
    }
}
