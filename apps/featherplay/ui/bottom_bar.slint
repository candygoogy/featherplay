// The player bar: a rounded panel floating over the bottom of the window,
// `Theme.bar-inset` in from its edges (app.slint places it). The track on the left; in the
// middle the transport around the round play button, with the time, the seek line and the
// length under it; Lyrics (the microphone), "Not for me" (a thumbs-down), like, volume and
// the Up next button on the right, and before them the sleep timer's button while its
// setting is on, and where the desktop has no tray, the mini player's button first. It reads
// and drives the `Player` global; `src/bar.rs` connects that to the controller. The
// transport, the mini player, the sleep timer, Lyrics, "Not for me" and the speed pill share
// one tooltip (`BarTip`): the name, then the shortcut. Below 960 px the bar gives up the speed
// pill, the volume's slider (to a popup from its button) and the extra buttons in turn
// (`show-speed`); below about 666, the volume's button (to the Up next sheet), then Shuffle and
// Repeat (to the sheet too), Not for me and the times (`show-order`). The wheel anywhere over
// the bar sets the volume, at every width.
import { Theme, Icons, Curves } from "theme.slint";
import { Body, Cover, IconButton, Icon, PlayButton } from "parts.slint";
import { Player, Repeat } from "player.slint";
import { Nav, PageKind, Frame } from "nav.slint";
import { NotForMeButton, LikeButton } from "not_for_me.slint";
import { BarTip } from "bar_tip.slint";
import { LyricsData, LyricsState } from "pages/lyrics.slint";
import { Chips } from "pages/content.slint";
import { SettingsData } from "pages/settings/data.slint";
import { Sleep, SleepButton } from "sleep_timer.slint";

// The seek line, between the time and the length: 4 px, 6 px while hovered, with round ends;
// click or drag anywhere on it to seek. Hovered, a thumb sits at the fill's end and a tooltip
// shows the time under the pointer. The fill follows a drag directly and stays
// where it was dropped until the next position arrives. The tray's mini player has one too.
// With Skip silence on, what it drops shows as dashed marks on the line; over one the tooltip
// adds "Silence", and a click there seeks to the mark's end.
export component SeekLine inherits Rectangle {
    // The time under the pointer stays between the line's ends (the mini player's line
    // runs close to its window's edges); by default it may reach half its width past them.
    in property <bool> tip-within: false;
    property <bool> can-seek: Player.has-track && Player.duration-s > 0;
    out property <bool> dragging: ta.pressed && self.can-seek;
    property <bool> active: (ta.has-hover || self.dragging) && self.can-seek;
    // Where the pointer is along the line, 0..1.
    out property <float> preview: clamp(ta.mouse-x / max(1px, self.width), 0, 1);
    // Where a seek was dropped, until the player reports a position (-1: none).
    property <float> dropped: -1;
    property <float> position: Player.position-s;
    property <string> track: Player.track-id;
    changed position => { root.dropped = -1; }
    changed track => { root.dropped = -1; }
    property <float> shown: self.dragging ? self.preview : (self.dropped >= 0 ? self.dropped : (Player.duration-s > 0 ? clamp(Player.position-s / Player.duration-s, 0, 1) : 0));
    property <length> thickness: root.active ? 6px : 4px;
    property <length> mid: self.height / 2;
    // A mark is never drawn shorter than this.
    property <length> min-mark: 8px;
    // The end of the mark under the pointer, 0 off them. Kept as the pointer leaves, so the
    // tooltip doesn't change while it fades out.
    property <float> mark-end: Player.silences.length > 0 ? Player.silence-end(Player.silences, root.preview, root.min-mark / max(1px, root.width)) : 0;
    // A mark's dashes ahead of the fill (behind it they're in the accent).
    property <color> dash-ahead: Theme.pick(#FFFFFF66, #00000059);
    height: 16px;
    accessible-role: slider;
    accessible-label: @tr("Seek");
    accessible-value: Player.elapsed;
    ta := TouchArea {
        enabled: root.can-seek;
        mouse-cursor: pointer;
        pointer-event(e) => {
            // Inside a mark: to its end, where Skip silence would take the song anyway.
            if e.kind == PointerEventKind.up && e.button == PointerEventButton.left {
                let to = root.mark-end > 0 ? root.mark-end : root.preview;
                root.dropped = to;
                Player.seek(to);
            }
        }
    }
    Rectangle {
        y: root.mid - self.height / 2;
        height: root.thickness;
        border-radius: self.height / 2;
        background: Theme.track;
        animate height { duration: Theme.t-hover; }
    }
    if root.shown > 0: Rectangle {
        x: 0;
        y: root.mid - self.height / 2;
        width: max(self.height, root.width * root.shown);
        height: root.thickness;
        border-radius: self.height / 2;
        background: Theme.accent;
        animate height { duration: Theme.t-hover; }
    }
    // Skip silence's marks: each span it drops is cut out of the line, 2 px of the bar's colour
    // at either end, and dashed inside: 3 px dashes every 6 px, the line's thickness, in the
    // accent once played and a pale track colour ahead. A mark is `min-mark` long at least,
    // from the line's start or to its end when the span touches one, else centred on it
    // (`bar::silence_end` hits them the same way, to within a pixel). A song's marks fade in together when they
    // arrive. Rectangles rather than a tiled image: a dozen or so per mark, drawn only
    // while there are marks, with no asset or image shader.
    Rectangle {
        opacity: Player.silences.length > 0 ? 1 : 0;
        visible: self.opacity > 0;
        animate opacity { duration: Theme.fading ? 150ms : 0ms; easing: Curves.ease-out; }
        for s in Player.silences: Rectangle {
            // On whole pixels, so the line doesn't show a fringe at the cuts.
            property <length> from: round(root.width * s.start / 1px) * 1px;
            property <length> to: round(root.width * s.end / 1px) * 1px;
            property <bool> short: self.to - self.from < root.min-mark;
            x: !self.short ? self.from : (s.start <= 0 ? 0 : (s.end >= 1 ? self.to - root.min-mark : clamp(round((self.from + self.to - root.min-mark) / 2px) * 1px, 0, root.width - root.min-mark)));
            y: root.mid - self.height / 2;
            width: max(root.min-mark, self.to - self.from);
            height: root.thickness + 2px;
            border-radius: 1px;
            background: Theme.bar;
            animate height { duration: Theme.t-hover; }
            // As many dashes as the inside holds (the last one may be cut short), within
            // reason: the line is 600 px at most.
            for i in min(120, ceil((self.width - 4px) / 6px)): Rectangle {
                x: 2px + i * 6px;
                y: 1px;
                width: min(3px, parent.width - 2px - self.x);
                height: parent.height - 2px;
                border-radius: 1px;
                background: parent.x + self.x + 1.5px < root.width * root.shown ? Theme.accent : root.dash-ahead;
            }
        }
    }
    // Until the first sound: a shimmer runs along the line (the only repeating animation,
    // and only while loading). Without motion, a quiet static line instead.
    if Player.loading && Theme.moving: Rectangle {
        y: root.mid - 2px;
        height: 4px;
        border-radius: 2px;
        clip: true;
        Rectangle {
            property <float> t: mod(animation-tick() / 1ms, Theme.t-shimmer / 1ms) / (Theme.t-shimmer / 1ms);
            x: (self.t * 1.4 - 0.4) * parent.width;
            width: parent.width * 0.4;
            background: @linear-gradient(90deg, transparent 0%, Theme.accent 50%, transparent 100%);
        }
    }
    if Player.loading && !Theme.moving: Rectangle {
        y: root.mid - 2px;
        height: 4px;
        border-radius: 2px;
        background: Theme.accent;
        opacity: 0.4;
    }
    // The thumb: centred on the fill's end and the line.
    Rectangle {
        x: root.width * root.shown - self.width / 2;
        y: root.mid - self.height / 2;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: Theme.accent;
        drop-shadow-blur: 4px;
        drop-shadow-color: #00000066;
        opacity: root.active ? 1 : 0;
        visible: self.opacity > 0;
        transform-scale: root.active || !Theme.moving ? 1.0 : 0.5;
        animate opacity { duration: Theme.t-fast; easing: Curves.ease-out; }
        animate transform-scale {
            duration: root.active ? Theme.t-release : Theme.t-fast;
            easing: root.active ? Curves.release : Curves.ease-out;
        }
    }
    // The time under the pointer, 8 px above the line; over a mark, a muted "Silence" after it.
    Rectangle {
        property <length> w: tip.preferred-width;
        property <length> reach: root.tip-within ? 0 : self.w / 2;
        x: clamp(ta.mouse-x - self.w / 2, -self.reach, root.width - self.w + self.reach);
        y: root.mid - 3px - Theme.s2 - self.height;
        width: self.w;
        height: tip.preferred-height;
        border-radius: Theme.r-s;
        background: Theme.card;
        drop-shadow-blur: 8px;
        drop-shadow-color: Theme.cover-shadow;
        opacity: root.active ? 1 : 0;
        visible: self.opacity > 0;
        animate opacity { duration: Theme.t-fast; easing: Curves.ease-out; }
        tip := HorizontalLayout {
            padding-left: 6px;
            padding-right: 6px;
            padding-top: 4px;
            padding-bottom: 4px;
            spacing: Theme.s2;
            Body {
                text: Player.clock(root.preview * Player.duration-s);
                font-size: Theme.t-meta;
                font-weight: 600;
                color: Theme.text1;
                vertical-alignment: center;
            }
            if root.mark-end > 0: Body {
                text: @tr("Silence");
                font-size: Theme.t-meta;
                color: Theme.text2;
                vertical-alignment: center;
            }
        }
    }
}

// The volume to go back to when unmuting, one for every mute button (the bar's, its popup's
// and the Up next sheet's).
global Mute {
    in-out property <float> unmuted: 0.7;
    public function toggle() {
        if Player.volume > 0 {
            unmuted = Player.volume;
            Player.set-volume(0, true);
        } else {
            Player.set-volume(unmuted, true);
        }
    }
}

// The volume: a click or a drag sets it, a wheel notch and Up or Down (`step`) move it by the
// Volume step. While it changes, its value shows above the line: 1.5 s past the last wheel
// or key change, while pressed and 0.4 s past the release; then it fades out. Where the value
// always shows beside it (`VolumeRow`), it doesn't.
component VolumeSlider inherits Rectangle {
    in property <bool> tip-shown: true;
    property <float> preview: clamp(ta.mouse-x / max(1px, self.width), 0, 1);
    // The wheel or the keys changed the volume and it isn't saved yet: `save` saves it a
    // second after the last change.
    property <bool> unsaved: false;
    // The value shows: from a change until `rest` ends, and while the slider is pressed. The
    // bar shows it in its level card while the slider itself is hidden.
    out property <bool> changing: false;
    property <bool> tip: root.changing || ta.pressed;
    // How long the value stays after the last change: long enough to read after a wheel
    // or key step, shorter after a drag, which showed it all along.
    property <duration> hold: 1.5s;
    width: 88px;
    accessible-role: slider;
    accessible-label: @tr("Volume");
    accessible-value: round(Player.volume * 100) + " %";
    // Up or Down: one step onto the step's grid (37 % and Up at 5 % is 40 %), within 0–100 %.
    // The small margin keeps a value a hair off the grid (0.4 as 39.99998 %) from counting as
    // below it.
    public function step(up: bool) {
        let s = max(1, Player.volume-step);
        let at = Player.volume * 100 / s;
        let to = up ? floor(at + 0.01) + 1 : ceil(at - 0.01) - 1;
        Player.set-volume(clamp(to * s / 100, 0, 1), false);
        root.stepped();
    }
    // A wheel's turn over it, or over the volume button: a notch (60 px) moves it one step; a
    // touchpad's smaller steps move it in proportion.
    public function wheel(dy: length) {
        Player.set-volume(clamp(Player.volume + dy / 60px * Player.volume-step / 100, 0, 1), false);
        root.stepped();
    }
    // A wheel or key change: shows the value for `hold` and saves it a second later.
    function stepped() {
        root.unsaved = true;
        if save.running {
            save.restart();
        } else {
            save.running = true;
        }
        root.linger(1.5s);
    }
    // Shows the value and starts its time `d` again.
    function linger(d: duration) {
        root.changing = true;
        root.hold = d;
        if rest.running {
            rest.restart();
        } else {
            rest.running = true;
        }
    }
    // Saves an unsaved change; runs only after one, for a second.
    save := Timer {
        interval: 1s;
        running: false;
        triggered => {
            self.running = false;
            if root.unsaved {
                root.unsaved = false;
                Player.set-volume(Player.volume, true);
            }
        }
    }
    // Runs only while the value shows.
    rest := Timer {
        interval: root.hold;
        running: false;
        triggered => {
            self.running = false;
            root.changing = false;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        scroll-event(e) => {
            if e.delta-y == 0 {
                return reject;
            }
            root.wheel(e.delta-y);
            accept
        }
        // Pressed, the value shows by `ta.pressed`; the release saves it.
        pointer-event(e) => {
            if e.button == PointerEventButton.left {
                if e.kind == PointerEventKind.down {
                    rest.running = false;
                    root.changing = false;
                    Player.set-volume(root.preview, false);
                } else if e.kind == PointerEventKind.up {
                    Player.set-volume(root.preview, true);
                    root.unsaved = false;
                    save.running = false;
                    root.linger(400ms);
                }
            }
        }
        moved => {
            if self.pressed {
                Player.set-volume(root.preview, false);
            }
        }
    }
    Rectangle {
        y: (parent.height - 4px) / 2;
        height: 4px;
        border-radius: 2px;
        background: Theme.track;
    }
    Rectangle {
        x: 0;
        y: (parent.height - 4px) / 2;
        width: parent.width * clamp(Player.volume, 0, 1);
        height: 4px;
        border-radius: 2px;
        background: ta.has-hover || ta.pressed ? Theme.accent : Theme.text2;
        animate background { duration: Theme.t-hover; }
    }
    // The value, 8 px above the line, over the fill's end and kept within the slider: like
    // the seek line's time. It glides to a wheel or key step's value, but sticks to the
    // pointer while pressed; it comes in quickly and leaves more gently.
    Rectangle {
        property <length> w: value.preferred-width + 12px;
        x: clamp(root.width * clamp(Player.volume, 0, 1) - self.w / 2, 0, root.width - self.w);
        y: root.height / 2 - 2px - Theme.s2 - self.height;
        width: self.w;
        height: value.preferred-height + 8px;
        border-radius: Theme.r-s;
        background: Theme.card;
        drop-shadow-blur: 8px;
        drop-shadow-color: Theme.cover-shadow;
        opacity: root.tip && root.tip-shown ? 1 : 0;
        visible: self.opacity > 0;
        animate opacity { duration: root.tip ? Theme.t-fast : Theme.t-linger; easing: Curves.ease-out; }
        animate x { duration: ta.pressed ? 0ms : Theme.t-step; easing: Curves.ease-out; }
        value := Body {
            text: @tr("{} %", round(Player.volume * 100));
            font-size: Theme.t-meta;
            font-weight: 600;
            color: Theme.text1;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// Lyrics, the microphone left of "Not for me": Now playing's full lyrics view on and off from
// any page (`LyricsData.toggle-view`; elsewhere it opens Now playing on the lyrics), in the
// accent while the view shows. Its tooltip names what a click does, with the shortcut. For a
// song with no lyrics it says so, and a press does what the stage's pill does: the stage stays
// and the pill's note says why.
component LyricsButton inherits Rectangle {
    // How far above the button the tooltip ends (the bar lifts it clear of itself).
    in property <length> above: Theme.s2;
    width: 36px;
    height: 36px;
    btn := IconButton {
        icon: Icons.lyrics;
        label: @tr("Lyrics");
        description: LyricsData.showing ? @tr("Hides the lyrics, back to the cover") : (LyricsData.missing ? LyricsData.message : @tr("Shows the lyrics on Now playing"));
        active: LyricsData.showing;
        // Off is always possible; on needs a song.
        enabled: Player.has-track || LyricsData.showing;
        clicked => {
            tip.dismiss();
            LyricsData.toggle-view();
        }
    }
    tip := BarTip {
        over: btn.hovered;
        name: LyricsData.showing ? @tr("Hide lyrics") : (LyricsData.state == LyricsState.none ? @tr("No lyrics") : (LyricsData.state == LyricsState.error ? @tr("Retry lyrics") : @tr("Lyrics")));
        hint: @tr("Ctrl+L");
        above: root.above;
    }
}

// The mini player, first in the right-hand group, only where the desktop has no tray
// (`SettingsData.has-tray`; Windows always has one): elsewhere a click on the tray icon opens
// it, and without the icon nothing would. A click opens it above the button or closes it, as
// the icon's click does (`BottomBar.toggle-mini`).
component MiniPlayerButton inherits Rectangle {
    // How far above the button the tooltip ends (the bar lifts it clear of itself).
    in property <length> above: Theme.s2;
    callback clicked();
    width: 36px;
    height: 36px;
    btn := IconButton {
        icon: Icons.mini-player;
        label: @tr("Mini player");
        description: @tr("Opens or closes the mini player");
        clicked => {
            tip.dismiss();
            root.clicked();
        }
    }
    tip := BarTip {
        over: btn.hovered;
        name: @tr("Mini player");
        hint: @tr("Ctrl+M");
        above: root.above;
    }
}

// The bar's play button, with its tooltip: Play or Pause, and its shortcut, Space.
component BarPlayButton inherits Rectangle {
    // How far above the button the tooltip ends (the bar lifts it clear of itself).
    in property <length> above: Theme.s2;
    width: btn.width;
    height: btn.height;
    btn := PlayButton {
        clicked => { tip.dismiss(); }
    }
    tip := BarTip {
        over: btn.hovered;
        name: Player.playing ? @tr("Pause") : @tr("Play");
        hint: @tr("Space");
        above: root.above;
    }
}

// The transport's other buttons (Shuffle, Previous, Next, Repeat): an `IconButton` with the
// bar's tooltip, `tip` and its `hint` (the shortcut). Children go on the button.
component TransportButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> filled: false;
    in property <color> tint: Theme.text2;
    in property <bool> active: false;
    in property <string> tip;
    in property <string> hint;
    // How far above the button the tooltip ends (the bar lifts it clear of itself).
    in property <length> above: Theme.s2;
    callback clicked();
    width: btn.width;
    height: btn.height;
    btn := IconButton {
        icon: root.icon;
        label: root.label;
        filled: root.filled;
        tint: root.tint;
        active: root.active;
        enabled: Player.has-track;
        clicked => {
            bar-tip.dismiss();
            root.clicked();
        }
        @children
    }
    bar-tip := BarTip {
        over: btn.hovered;
        name: root.tip;
        hint: root.hint;
        above: root.above;
    }
}

// The speed while it isn't 1x, just before the bar's right-hand group: a 28 px pill on the
// accent's tonal fill, as a selected chip. A click opens the speed popup over it. Its tooltip
// names it; the pill shows the value.
component SpeedPill inherits Rectangle {
    // How far above the pill's 36 px row the tooltip ends (the bar lifts it clear of itself).
    in property <length> above: Theme.s2;
    width: pill.width;
    height: 36px;
    pill := Rectangle {
        y: 4px;
        height: 28px;
        width: t.preferred-width + 2 * Theme.s3;
        border-radius: self.height / 2;
        background: ta.has-hover || ta.pressed || Player.speed-open ? Theme.accent-tonal-hover : Theme.accent-tonal;
        accessible-role: button;
        accessible-label: @tr("Playback speed, {}", Player.speed-labels[Player.speed]);
        accessible-action-default => { Player.speed-open = true; }
        animate background { duration: Theme.t-hover; }
        ta := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                tip.dismiss();
                Player.speed-open = true;
            }
        }
        t := Body {
            text: Player.speed-labels[Player.speed];
            font-size: Theme.t-meta;
            font-weight: 600;
            color: Theme.text1;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    tip := BarTip {
        over: ta.has-hover;
        name: @tr("Playback speed");
        above: root.above;
    }
}

// The speed popup: the Settings chips in a panel `s2` above the bar, centred on the pill.
// A pick, Escape or a click outside closes it. app.slint draws it over everything, shown
// while `Player.speed-open`.
export component SpeedLayer inherits Rectangle {
    // The bar's top edge, and the pill's centre (window coordinates).
    in property <length> bottom;
    in property <length> anchor;
    callback closed();
    property <bool> open: Player.speed-open;
    changed open => {
        if self.open {
            keys.focus();
        }
    }
    function close() {
        Player.speed-open = false;
        root.closed();
    }
    TouchArea {
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.close();
            }
        }
        scroll-event(e) => {
            root.close();
            accept
        }
    }
    Rectangle {
        width: chips.preferred-width + 2 * Theme.s4;
        height: 2 * Theme.s4 + 20px + Theme.s3 + chips.height;
        x: max(8px, min(root.anchor - self.width / 2, root.width - self.width - 8px));
        y: root.bottom - Theme.s2 - self.height;
        border-radius: Theme.r-l;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.card-edge;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: Theme.cover-shadow;
        accessible-role: list;
        accessible-label: @tr("Playback speed");
        // Swallows clicks on the panel's padding.
        TouchArea { }
        keys := FocusScope {
            key-pressed(e) => {
                if e.text == Key.Escape {
                    root.close();
                    return accept;
                }
                reject
            }
        }
        Body {
            x: Theme.s4;
            y: Theme.s4;
            height: 20px;
            text: @tr("Playback speed");
            font-weight: 600;
            color: Theme.text1;
            vertical-alignment: center;
        }
        chips := Chips {
            x: Theme.s4;
            y: Theme.s4 + 20px + Theme.s3;
            labels: Player.speed-labels;
            active: Player.speed;
            selected(i) => {
                Player.pick-speed(i);
                root.close();
            }
        }
    }
}

// The volume as one row: the mute button, the slider and the value, always shown. In the
// bar's volume popup, and in the Up next sheet once the bar has no volume button left.
export component VolumeRow inherits Rectangle {
    public function step(up: bool) {
        slider.step(up);
    }
    height: 36px;
    IconButton {
        x: 0;
        y: (root.height - self.height) / 2;
        icon: Player.volume > 0 ? Icons.volume : Icons.volume-off;
        label: Player.volume > 0 ? @tr("Mute") : @tr("Unmute");
        clicked => { Mute.toggle(); }
    }
    slider := VolumeSlider {
        x: 36px + Theme.s2;
        width: root.width - self.x - Theme.s2 - value.width;
        height: root.height;
        tip-shown: false;
    }
    value := Body {
        x: root.width - self.width;
        width: 40px;
        height: root.height;
        text: @tr("{} %", round(Player.volume * 100));
        font-size: Theme.t-meta;
        font-weight: 600;
        color: Theme.text2;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

// The volume's button where the bar has no room for its slider: a click opens the slider in
// a popup above it (`VolumeLayer`), a wheel notch moves it a step, as over the slider.
component VolumeButton inherits Rectangle {
    // How far above the button the tooltip ends (the bar lifts it clear of itself).
    in property <length> above: Theme.s2;
    // A wheel's turn over it: the bar's slider moves the volume.
    callback wheel(length);
    width: 36px;
    height: 36px;
    border-radius: self.width / 2;
    // Held in its hover look while its popup is open, as the speed pill is.
    background: Theme.state(ta.pressed, ta.has-hover || Frame.volume-open);
    accessible-role: button;
    accessible-label: @tr("Volume");
    accessible-description: @tr("{} %", round(Player.volume * 100));
    accessible-action-default => { Frame.volume-open = !Frame.volume-open; }
    animate background { duration: Theme.t-hover; }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            tip.dismiss();
            Frame.volume-open = !Frame.volume-open;
        }
        scroll-event(e) => {
            if e.delta-y == 0 {
                return reject;
            }
            root.wheel(e.delta-y);
            accept
        }
    }
    Icon {
        width: 20px;
        height: 20px;
        commands: Player.volume > 0 ? Icons.volume : Icons.volume-off;
        stroke: ta.has-hover || Frame.volume-open ? Theme.text1 : Theme.text2;
    }
    tip := BarTip {
        over: ta.has-hover && !Frame.volume-open;
        name: @tr("Volume");
        hint: @tr("↑ ↓");
        above: root.above;
    }
}

// The volume popup: `VolumeRow` in a panel `s2` above the bar, centred on the volume button.
// Escape or a click outside closes it; Up and Down step the volume while it's open. app.slint
// draws it over everything while `Frame.volume-open`. It comes and goes at once, as the speed
// and sleep popups do.
export component VolumeLayer inherits Rectangle {
    // The bar's top edge, and the button's centre (window coordinates).
    in property <length> bottom;
    in property <length> anchor;
    callback closed();
    property <bool> open: Frame.volume-open;
    changed open => {
        if self.open {
            keys.focus();
        }
    }
    function close() {
        Frame.volume-open = false;
        root.closed();
    }
    TouchArea {
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.close();
            }
        }
        scroll-event(e) => {
            root.close();
            accept
        }
    }
    Rectangle {
        width: 264px;
        height: 36px + 2 * Theme.s3;
        x: max(8px, min(root.anchor - self.width / 2, root.width - self.width - 8px));
        y: root.bottom - Theme.s2 - self.height;
        border-radius: Theme.r-l;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.card-edge;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: Theme.cover-shadow;
        // Swallows clicks on the panel's padding.
        TouchArea { }
        keys := FocusScope {
            key-pressed(e) => {
                if e.text == Key.Escape {
                    root.close();
                    return accept;
                }
                if (e.text == Key.UpArrow || e.text == Key.DownArrow) && !e.modifiers.control && !e.modifiers.alt && !e.modifiers.meta {
                    row.step(e.text == Key.UpArrow);
                    return accept;
                }
                reject
            }
        }
        row := VolumeRow {
            x: Theme.s3;
            y: Theme.s3;
            width: parent.width - 2 * Theme.s3;
        }
    }
}

export component BottomBar inherits Rectangle {
    // Up or Down from the window's keys: the volume one step up or down.
    public function step-volume(up: bool) {
        volume.step(up);
    }
    // The mini player's button, or Ctrl+M: the mini player opens above the button (first in
    // the right-hand group, so at its start), or closes.
    public function toggle-mini() {
        Frame.toggle-mini(root.absolute-position.x + actions.x + 18px, root.absolute-position.y + actions.y);
    }
    // The right-hand buttons sit as far in from the bar's right end as from its top and bottom,
    // so the last one is centred in the rounded end, as the cover is at the left.
    property <length> end-gap: (Theme.bar-h - 36px) / 2;
    // A narrow bar gives things up: first the title shortens to 80 px and the time row to
    // 280, then whole groups go, in this order: the speed pill, the volume's slider (its
    // button stays and opens the slider in a popup), then the extra buttons (the mini
    // player's, the sleep timer's and Lyrics). A group goes once keeping it would bring the
    // time row within 8 px of the title's 80 px. Counted from the buttons' fixed sizes (the
    // sleep timer's idle 36 px), not from the layout, so what shows never feeds back into
    // the count. From 960 px wide everything still shows.
    property <length> fit-x: 84px + 80px + 8px + 280px + 12px;
    // Not for me, like and Up next, each 36 px, and the gaps either side of the volume.
    property <length> core-w: 3 * 36px + 3 * 4px;
    property <length> volume-w: 36px + 4px + 88px + 4px + 8px;
    property <length> extras-w: (LyricsData.on ? 40px : 0px) + (SettingsData.has-tray ? 0px : 40px) + (SettingsData.sleep-timer ? 40px : 0px);
    property <length> pill-w: speed-pill.width + 4px;
    // The volume's button alone, while it shows without its slider.
    property <length> knob-w: !root.show-volume && root.volume-button ? 36px : 0px;
    // What the volume takes in the bar now: its slider, its button, or nothing.
    property <length> volume-now: root.show-volume ? root.volume-w : root.knob-w;
    property <bool> show-extras: self.width - root.end-gap - root.core-w - 36px - root.extras-w >= root.fit-x;
    property <bool> show-volume: root.show-extras && self.width - root.end-gap - root.core-w - root.extras-w - root.volume-w >= root.fit-x;
    property <bool> show-speed: Player.speed != 2 && root.show-volume && self.width - root.end-gap - root.core-w - root.extras-w - root.volume-w - root.pill-w >= root.fit-x;
    // Narrower still (a window under about 666 px, `squeezed`), the middle column keeps to its
    // least and the title takes the rest, 112 px at least while anything is left to give up.
    // First the volume's button goes: the wheel over the bar, Up and Down and a row in the Up
    // next sheet still set the volume. Then, each once keeping it would leave the title under
    // 112 px: Shuffle and Repeat (the sheet holds them, and the Up next button wears a dot
    // while either is on), Not for me (Now playing and the song menu have it), then the
    // times: the seek line runs along the bar's foot, and its tooltip tells the time. The
    // middle column's least is the whole transport (240 px) while it has Shuffle and Repeat,
    // then a 200 px time row (an 88 px line).
    // `title-room`: the cover, the title's 112 px and the 16 px before the middle column;
    // `narrow-r`: the right-hand group with Not for me, like and Up next.
    property <length> title-room: 84px + 112px + 16px;
    property <length> narrow-r: root.end-gap + 3 * 36px + 2 * 4px;
    out property <bool> volume-button: !root.squeezed;
    out property <bool> show-order: self.width - root.narrow-r - 12px - 240px - root.title-room >= 0;
    property <bool> show-dislike: root.show-order || self.width - root.narrow-r - 12px - 200px - root.title-room >= 0;
    out property <bool> show-times: root.show-dislike || self.width - (root.narrow-r - 40px) - 12px - 200px - root.title-room >= 0;
    // The sheet holds what the bar gave up (`Frame`, for the sheet and Rust).
    init => {
        Frame.order-in-sheet = !root.show-order;
        Frame.volume-in-sheet = !root.volume-button;
    }
    changed show-order => { Frame.order-in-sheet = !self.show-order; }
    changed volume-button => { Frame.volume-in-sheet = !self.volume-button; }
    property <bool> order-mark: !root.show-order && (Player.shuffle || Player.repeat != Repeat.off);
    // The popup closes with its button (the slider back in the bar, or the button gone).
    changed knob-w => {
        if self.knob-w == 0 {
            Frame.volume-open = false;
        }
    }
    // Where the volume popup centres (in the bar): on the button, just left of Up next.
    out property <length> volume-centre: actions.x + actions.width - 36px - 4px - 18px;
    // Even the core buttons and the volume's button leave too little for the title's 80 px and
    // a 280 px time row: the time row narrows to the transport's width, and the title takes
    // the rest.
    property <bool> squeezed: self.width - root.end-gap - root.core-w - 36px < root.fit-x;
    // The middle column (the transport, the time and the line), and what's left either side
    // for the title: it stays clear of the buttons on the right at 960 px, every group in.
    // The speed pill, while it shows, sits just left of the right-hand group, which then
    // takes its room too.
    property <length> right-w: actions.preferred-width + (root.show-speed ? root.pill-w : 0px);
    // What the middle column stays clear of: the speed pill while it shows, else the group.
    property <length> anchor: root.show-speed ? speed-pill.x : actions.x;
    // The time row is 320 px at least, and the title 80 px from x 84, 16 px before it. Only
    // when the right-hand group leaves less (Linux without a tray, with the speed pill and the
    // sleep timer at 960 px, or a narrower bar) does the time row give up to
    // 40 px. Centred, it keeps the title's 180 px on the left as well as the group's room on
    // the right.
    // Narrow (`squeezed`), the middle column keeps to its least (the whole transport while it
    // has Shuffle and Repeat, else a 200 px time row) and the title takes the rest; without
    // the times, it's the transport alone.
    property <length> center-w: !root.show-times ? root.transport-w : (root.squeezed ? (root.show-order ? 240px : 200px) : max(280px, min(max(320px, min(600px, self.width - 2 * max(root.right-w + root.end-gap + 2px, 180px))), root.anchor - 12px - 180px)));
    // Where the speed popup centres (in the bar).
    out property <length> speed-centre: speed-pill.x + speed-pill.width / 2;
    // The sleep timer's button: after the mini player's, if that shows. Idle 36 px; running,
    // it takes the time left's text only while that leaves the time row 320 px and the title
    // 80 px (`sleep-room`), the long form first.
    property <length> sleep-room: self.width - root.end-gap - tail.preferred-width - (SettingsData.has-tray ? 0px : 40px) - 4px - (root.show-speed ? root.pill-w : 0px) - 12px - 320px - 180px;
    property <length> sleep-long-w: sleep-long.preferred-width + Sleep.pill-pad;
    property <length> sleep-short-w: sleep-short.preferred-width + Sleep.pill-pad;
    out property <string> sleep-text: !Sleep.running ? "" : (root.sleep-long-w <= root.sleep-room ? Sleep.long-text : (root.sleep-short-w <= root.sleep-room ? Sleep.short-text : ""));
    property <length> sleep-w: root.sleep-text == "" ? 36px : (root.sleep-text == Sleep.long-text ? root.sleep-long-w : root.sleep-short-w);
    // Where the sleep timer's popup centres (in the bar).
    out property <length> sleep-centre: actions.x + (SettingsData.has-tray ? 0px : 40px) + root.sleep-w / 2;
    // The middle column's left edge: centred on the bar, unless that would run it into the
    // right-hand group (a bar near 960 px with the speed pill, or Linux's mini player
    // button, or a bar that gave groups up), then shifted left to stay 12 px clear of it; and
    // no further left than the title's 80 px, 16 px before it, while there's room for that.
    // Narrow, it sits 12 px from the right-hand group, and the title takes the rest; without
    // the times, 24 px, twice the transport's own gaps, so the two read as two groups (down
    // to 12 px, where the window is too narrow for a title and that would reach the cover).
    property <length> middle-w: max(root.center-w, root.transport-w);
    property <length> middle-x: !root.show-times ? max(root.anchor - 24px - root.middle-w, min(root.anchor - 12px - root.middle-w, 84px)) : (root.squeezed ? root.anchor - 12px - root.middle-w : min(max((self.width - root.middle-w) / 2, 180px), root.anchor - 12px - root.middle-w));
    property <length> left-w: max(root.squeezed ? 0px : 80px, root.middle-x + (root.middle-w - root.center-w) / 2 - 100px);
    // The title and the artist show while they have a word's room.
    property <bool> titled: root.left-w >= 32px;
    // The transport: Previous, play and Next (`transport`), with Shuffle and Repeat 12 px
    // either side while they show; its left edge, centred over the time row.
    property <length> transport-w: transport.preferred-width + (root.show-order ? 2 * (36px + 12px) : 0px);
    property <length> transport-x: root.middle-x + (root.middle-w - root.transport-w) / 2;
    // The transport row, and the time row under it. Without the times, Previous, play and Next
    // (`row-y`) and the right-hand group (`actions-y`) come down onto the cover's middle, one
    // row above the seek line; what shows only with the times keeps the fixed places.
    property <length> transport-y: 8px;
    property <length> row-y: root.show-times ? root.transport-y : 14px;
    property <length> actions-y: root.show-times ? (root.height - 36px) / 2 : 20px;
    property <length> time-y: 60px;
    property <length> time-x: root.middle-x + (root.middle-w - root.center-w) / 2;
    height: Theme.bar-h;
    border-radius: Theme.r-xl;
    background: Theme.bar;
    border-width: 1px;
    border-color: Theme.card-edge;
    drop-shadow-blur: 24px;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: Theme.cover-shadow;
    animate background { duration: Theme.t-colour; }

    // The wheel over the bar sets the volume, as over the slider, wherever nothing in the bar
    // takes the wheel itself (the slider and the volume's button do the same), and never
    // scrolls the page under the bar. At every width: below the slider's room it's the
    // quickest way to the volume.
    TouchArea {
        scroll-event(e) => {
            if e.delta-y != 0 {
                volume.wheel(e.delta-y);
            }
            accept
        }
    }

    // Cover, title and artist: open Now playing (or close it).
    // Without the times it ends above the seek line along the foot; without the title, at
    // the cover (a window manager can make the window that narrow).
    Rectangle {
        x: 8px;
        y: 8px;
        width: root.titled ? root.left-w + 84px : 64px;
        height: root.height - (root.show-times ? 16px : 28px);
        border-radius: Theme.r-l - 4px;
        background: Player.has-track ? Theme.state(ota.pressed, ota.has-hover) : transparent;
        accessible-role: button;
        accessible-label: Player.has-track ? @tr("Now playing: {}", Player.title) : @tr("Nothing playing");
        accessible-action-default => { Nav.toggle-now-playing(); }
        animate background { duration: Theme.t-hover; }
        ota := TouchArea {
            enabled: Player.has-track;
            mouse-cursor: pointer;
            clicked => { Nav.toggle-now-playing(); }
        }
        Cover {
            x: 8px;
            y: (parent.height - self.height) / 2;
            width: 56px;
            height: 56px;
            radius: Theme.r-m;
            source: Player.cover;
            crossfade: true;
            // Hovered: a veil and a chevron say it opens Now playing.
            Rectangle {
                background: Theme.cover-hover;
                opacity: ota.has-hover && Player.has-track ? 1 : 0;
                visible: self.opacity > 0;
                animate opacity { duration: Theme.t-hover; easing: Curves.ease-hover; }
                Icon {
                    width: 20px;
                    height: 20px;
                    commands: Nav.page == PageKind.now-playing ? Icons.chevron-down : Icons.chevron-up;
                    stroke: #FFFFFF;
                    stroke-width: 2px;
                }
            }
        }
        Body {
            x: 76px;
            y: parent.height / 2 - 19px;
            width: root.left-w;
            visible: root.titled;
            text: Player.has-track ? Player.title : @tr("Nothing playing");
            font-weight: 600;
            color: Player.has-track ? Theme.text1 : Theme.text3;
        }
        // The artist links to the artist's page, underlined on hover.
        artist := Rectangle {
            property <bool> link: Player.artist-id != "";
            visible: root.titled;
            x: 76px;
            y: parent.height / 2 + 3px;
            width: min(root.left-w, artist-text.preferred-width);
            height: artist-text.preferred-height;
            accessible-role: button;
            accessible-label: Player.artist;
            accessible-action-default => { Nav.open-artist(Player.artist-id); }
            artist-text := Body {
                width: parent.width;
                text: Player.artist;
                font-size: Theme.t-meta;
                color: ata.has-hover && artist.link ? Theme.text1 : Theme.text2;
            }
            if ata.has-hover && artist.link: Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.text1;
            }
            ata := TouchArea {
                enabled: artist.link;
                mouse-cursor: pointer;
                clicked => { Nav.open-artist(Player.artist-id); }
            }
        }
    }

    // The transport, centred over the time row. Shuffle and Repeat sit either side of it,
    // placed by hand and hidden rather than made and unmade (each `if` costs the exe a
    // component of its own).
    // The tooltips end `s2` above the bar.
    Rectangle {
        x: root.transport-x;
        y: root.transport-y + (Theme.play-size - self.height) / 2;
        width: 36px;
        height: 36px;
        visible: root.show-order;
        TransportButton {
            above: root.transport-y + (Theme.play-size - 36px) / 2 + Theme.s2;
            icon: Icons.shuffle;
            label: Player.shuffle ? @tr("Shuffle on") : @tr("Shuffle off");
            tip: self.label;
            hint: @tr("Ctrl+S");
            active: Player.shuffle;
            clicked => { Player.toggle-shuffle(); }
        }
    }
    Rectangle {
        x: root.transport-x + root.transport-w - self.width;
        y: root.transport-y + (Theme.play-size - self.height) / 2;
        width: 36px;
        height: 36px;
        visible: root.show-order;
        TransportButton {
            above: root.transport-y + (Theme.play-size - 36px) / 2 + Theme.s2;
            icon: Icons.repeat;
            label: Player.repeat == Repeat.one ? @tr("Repeat one") : (Player.repeat == Repeat.all ? @tr("Repeat all") : @tr("Repeat off"));
            tip: self.label;
            hint: @tr("Ctrl+R");
            active: Player.repeat != Repeat.off;
            clicked => { Player.cycle-repeat(); }
            if Player.repeat == Repeat.one: Text {
                x: parent.width - 13px;
                y: 4px;
                text: "1";
                font-family: Theme.body-font;
                font-size: 9px;
                font-weight: 700;
                color: Theme.accent;
            }
        }
    }
    transport := HorizontalLayout {
        x: root.transport-x + (root.show-order ? 36px + 12px : 0px);
        y: root.row-y;
        height: Theme.play-size;
        width: self.preferred-width;
        spacing: 12px;
        TransportButton {
            y: (Theme.play-size - self.height) / 2;
            above: root.row-y + self.y + Theme.s2;
            icon: Icons.prev;
            label: @tr("Previous");
            tip: self.label;
            hint: @tr("Ctrl+←");
            filled: true;
            tint: Theme.text1;
            clicked => { Player.previous(); }
        }
        BarPlayButton {
            above: root.row-y + Theme.s2;
        }
        TransportButton {
            y: (Theme.play-size - self.height) / 2;
            above: root.row-y + self.y + Theme.s2;
            icon: Icons.next;
            label: @tr("Next");
            tip: self.label;
            hint: @tr("Ctrl+→");
            filled: true;
            tint: Theme.text1;
            clicked => { Player.next(); }
        }
    }

    // Under the transport: the time, the seek line and the length, 12 px apart. Fixed widths
    // for the times, so the line doesn't shift as they tick. Without the times, the line runs
    // the bar's width along its foot, from the cover's left edge to as far in on the right.
    Body {
        x: root.time-x;
        y: root.time-y;
        width: 44px;
        height: 16px;
        visible: root.show-times;
        text: Player.has-track ? Player.elapsed : "";
        font-size: Theme.t-meta;
        color: Theme.text2;
        horizontal-alignment: right;
        vertical-alignment: center;
        overflow: clip;
    }
    SeekLine {
        x: root.show-times ? root.time-x + 44px + Theme.s3 : 16px;
        // Its middle 12 px above the bar's foot, just under the cover.
        y: root.show-times ? root.time-y : root.height - 12px - self.height / 2;
        width: root.show-times ? root.center-w - 2 * (44px + Theme.s3) : root.width - 2 * 16px;
    }
    Body {
        x: root.time-x + root.center-w - 44px;
        y: root.time-y;
        width: 44px;
        height: 16px;
        visible: root.show-times;
        text: Player.has-track ? Player.total : "";
        font-size: Theme.t-meta;
        color: Theme.text2;
        horizontal-alignment: left;
        vertical-alignment: center;
        overflow: clip;
    }

    // Measure the running pill's texts.
    sleep-long := Body {
        visible: false;
        text: Sleep.long-text;
        font-size: Theme.t-meta;
        font-weight: 600;
    }
    sleep-short := Body {
        visible: false;
        text: Sleep.short-text;
        font-size: Theme.t-meta;
        font-weight: 600;
    }

    // The volume while the wheel over the bar, or Up or Down, changes it and the bar has no
    // slider to show it: a small card `s2` above the bar, over the volume's button, or at
    // the bar's right end by Up next, whose sheet holds the volume then. The speaker, the
    // level as a short line (the slider's rail, its fill in the accent, as under a hand) and
    // the value. It shows while the slider's own value would (`VolumeSlider.changing`) and
    // fades as that value does: in quickly, out more gently, shorter without motion; the
    // line's fill glides to each step as the value's card does (at once without motion).
    Rectangle {
        property <length> anchor: root.volume-button ? root.volume-centre : actions.x + actions.width - 18px;
        property <bool> on: volume.changing && !root.show-volume;
        x: min(self.anchor - self.width / 2, root.width - self.width);
        y: -Theme.s2 - self.height;
        width: 136px;
        height: 32px;
        border-radius: Theme.r-s;
        background: Theme.card;
        border-width: 1px;
        border-color: Theme.card-edge;
        drop-shadow-blur: 8px;
        drop-shadow-offset-y: 2px;
        drop-shadow-color: Theme.cover-shadow;
        opacity: self.on ? 1 : 0;
        visible: self.opacity > 0;
        animate opacity { duration: self.on ? Theme.t-fast : Theme.t-linger; easing: Curves.ease-out; }
        Icon {
            x: 10px;
            width: 16px;
            height: 16px;
            commands: Icons.volume;
        }
        Rectangle {
            x: 34px;
            y: (parent.height - self.height) / 2;
            width: 48px;
            height: 4px;
            border-radius: 2px;
            background: Theme.track;
            Rectangle {
                x: 0;
                width: parent.width * clamp(Player.volume, 0, 1);
                border-radius: 2px;
                background: Theme.accent;
                animate width { duration: Theme.t-step; easing: Curves.ease-out; }
            }
        }
        // Right-aligned, so "%" stays put as the digits change.
        Body {
            x: parent.width - 10px - self.width;
            width: 34px;
            text: @tr("{} %", round(Player.volume * 100));
            font-size: Theme.t-meta;
            font-weight: 600;
            color: Theme.text1;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }

    speed-pill := SpeedPill {
        x: actions.x - self.width - 4px;
        y: actions.y;
        above: (Theme.bar-h - 36px) / 2 + Theme.s2;
        visible: root.show-speed;
    }

    actions := HorizontalLayout {
        x: parent.width - self.width - root.end-gap;
        y: root.actions-y;
        height: 36px;
        width: self.preferred-width;
        spacing: 4px;
        // The tooltips end `s2` above the bar (the buttons sit centred in it).
        // Only without a tray (`if`: a hidden element keeps its room). It, the sleep timer's
        // button and Lyrics, the extra buttons, show only while the bar has room for them.
        if !SettingsData.has-tray && root.show-extras: MiniPlayerButton {
            above: (Theme.bar-h - 36px) / 2 + Theme.s2;
            clicked => { root.toggle-mini(); }
        }
        // Only with its setting on; it grows to the left, so the buttons after it stay put.
        if SettingsData.sleep-timer && root.show-extras: SleepButton {
            width: root.sleep-w;
            text: root.sleep-text;
            above: (Theme.bar-h - 36px) / 2 + Theme.s2;
        }
        // The rest, in a layout of its own, so the sleep timer's room is measured without
        // the sleep timer.
        tail := HorizontalLayout {
            spacing: 4px;
            // Not there with lyrics off in Settings.
            if LyricsData.on && root.show-extras: LyricsButton {
                above: (Theme.bar-h - 36px) / 2 + Theme.s2;
            }
            // Not for me and like, 4 px apart; gone, Not for me takes its gap with it.
            Rectangle {
                width: root.show-dislike ? 76px : 36px;
                Rectangle {
                    x: 0;
                    width: 36px;
                    visible: root.show-dislike;
                    NotForMeButton {
                        above: (Theme.bar-h - 36px) / 2 + Theme.s2;
                    }
                }
                LikeButton {
                    x: parent.width - 36px;
                }
            }
            // The volume, its button and slider, then Up next; where the slider doesn't fit, its
            // button alone, which opens it in a popup. Once the bar has no room even for the
            // button, hidden with its gap, but kept (not an `if`), so Up and Down and the wheel
            // over the bar still step it.
            Rectangle {
                width: root.volume-now + (root.volume-now > 0 ? 4px : 0px) + 36px;
                Rectangle {
                    x: 0;
                    width: root.volume-w;
                    visible: root.show-volume;
                    HorizontalLayout {
                        spacing: 4px;
                        IconButton {
                            icon: Player.volume > 0 ? Icons.volume : Icons.volume-off;
                            label: Player.volume > 0 ? @tr("Mute") : @tr("Unmute");
                            clicked => { Mute.toggle(); }
                        }
                        volume := VolumeSlider { }
                        Rectangle {
                            width: 8px;
                        }
                    }
                }
                Rectangle {
                    x: 0;
                    width: 36px;
                    visible: root.knob-w > 0;
                    VolumeButton {
                        above: (Theme.bar-h - 36px) / 2 + Theme.s2;
                        wheel(dy) => { volume.wheel(dy); }
                    }
                }
                Rectangle {
                    x: parent.width - 36px;
                    width: 36px;
                    height: 36px;
                    IconButton {
                        icon: Icons.queue;
                        label: @tr("Up next");
                        description: root.order-mark ? @tr("Shuffle or repeat is on") : "";
                        // In a window too narrow for a side panel, it opens and closes the Up next
                        // sheet. Otherwise, on Now playing it shows and hides the page's own side
                        // panel; elsewhere the frame's Up next panel. Each keeps its own state.
                        active: Frame.sheet ? Frame.sheet-open : (Frame.full-page ? Frame.side-open : Frame.queue-open);
                        // The open panel shows the state; a circle here, lit all the time on Now
                        // playing (its side panel is open by default), only looked stuck.
                        circle: false;
                        clicked => {
                            if Frame.sheet {
                                Frame.sheet-open = !Frame.sheet-open;
                            } else if Frame.full-page {
                                Frame.side-open = !Frame.side-open;
                                Frame.side-toggled(Frame.side-open);
                            } else {
                                Frame.queue-open = !Frame.queue-open;
                                Frame.queue-toggled(Frame.queue-open);
                            }
                        }
                    }
                    // Shuffle or repeat is on while the sheet holds their toggles: a dot in the
                    // accent at the glyph's upper right, ringed in the bar's colour so it stands
                    // clear of the glyph's stroke.
                    Rectangle {
                        x: 24px;
                        y: 4px;
                        width: 9px;
                        height: 9px;
                        border-radius: self.width / 2;
                        border-width: 1.5px;
                        border-color: Theme.bar;
                        background: Theme.accent;
                        visible: root.order-mark;
                    }
                }
            }
        }
    }
}
