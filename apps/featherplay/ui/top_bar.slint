// The top bar: the row at the window's top, across the sidebar and the page, with Back,
// Forward and the search field, and with the window's own title bar the icon and name and the
// window buttons (`TopBar`, `CaptionButtons`). Ctrl+K focuses the field, Enter searches,
// Escape clears it then leaves it (the window's key handler), × clears it. The query is filled
// by `src/top_bar.rs` on every page shown.
// While the user types, suggestions drop down under the field (`src/suggest.rs`): Down and
// Up move through them, Enter picks the one highlighted, Escape closes them first. After the
// music, after a divider, come up to three settings that match (`settings/search.rs`).
// On Settings the field is Settings' search instead: it reads "Search settings", what's
// typed filters the page (`SettingsSearch`), and nothing drops down under it.
// In a window without a sidebar (below `Theme.drawer-below`) a menu button at the row's start
// opens the sidebar as a drawer (app.slint); it takes Tab's focus, and Enter or Space opens it.
import { Theme, Icons, Curves } from "theme.slint";
import { Icon, Body, Cover } from "parts.slint";
import { Nav, Frame } from "nav.slint";
import { SmallLogo } from "logo.slint";
import { SettingsSearch } from "pages/settings/data.slint";

// What a suggestion row is.
export enum SuggestionKind { query, history, song, album, artist, playlist, setting }

export struct Suggestion {
    kind: SuggestionKind,
    // A completion (`query`, or `history`, a past search): the part the user typed, then
    // `rest`; the query is the two together. A result: its title, `rest` empty.
    title: string,
    rest: string,
    // A result's line under the title, as YouTube Music writes it: `Song • Daft Punk • 111M plays`;
    // a setting's, `Setting • Playback`.
    subtitle: string,
    cover: image,
}

export global TopBarData {
    // The field's text: what the user types, and the search page's query once one is shown
    // (back and forward included). On Settings, Settings' search (`src/top_bar.rs` keeps
    // the music's text meanwhile).
    in-out property <string> query;
    // The text on one line: line breaks, tabs and other control characters become spaces,
    // the ends trimmed (`top_bar::single_line`).
    pure callback single-line(string) -> string;
    // A paste is about to read the clipboard (Ctrl+V, Shift+Insert or the menu's Paste):
    // `top_bar::pasting` logs whether the system clipboard could be opened and holds text.
    callback pasting();

    // The suggestions for the field's text (`src/suggest.rs`): `completions` completions
    // first, then the direct results.
    in property <[Suggestion]> suggestions;
    in property <int> completions;
    // Where the settings start among the rows, after a divider; -1 for none.
    in property <int> settings-from: -1;
    // The pick `pick` is called for was made with the keyboard.
    in-out property <bool> picked-by-key;
    // The rows are wanted. Set by Rust when an answer for the field's text lands; cleared by
    // Escape, Enter, a pick, a click outside them and a page change.
    in-out property <bool> suggesting;
    // The row the arrows or the pointer are on, -1 for none.
    in-out property <int> highlighted: -1;
    // The user changed the text: typing, a paste, ×, Escape's clear.
    callback edited(string);
    // Row `i` was picked: a completion is searched, a song plays, a page opens.
    callback pick(int);
    // The rows were closed without a pick: answers still on their way are dropped.
    callback dismissed();
}

// Glyphs only the suggestions use, on the same 24 px grid as `Icons`.
global SuggestIcons {
    // A past search: a clock.
    out property <string> history: "M12 4.5 a7.5 7.5 0 1 0 0.01 0 Z M12 8.5 V12 L14.5 14.5";
}

// One suggestion: a completion (its icon, the typed part in bold, the rest), or a result
// (its cover, round for an artist, the title and YouTube Music's line under it).
component SuggestionRow inherits Rectangle {
    in property <Suggestion> item;
    in property <bool> highlighted;
    // Off while the rows fade out, so a click then does nothing.
    in property <bool> enabled: true;
    callback clicked();
    callback hovered(bool);
    property <bool> completion: root.item.kind == SuggestionKind.query || root.item.kind == SuggestionKind.history;
    height: root.completion ? 40px : 56px;
    border-radius: Theme.r-s;
    background: Theme.state(ta.pressed, root.highlighted);
    animate background { duration: Theme.t-hover; }
    accessible-role: list-item;
    accessible-label: root.completion ? root.item.title + root.item.rest : (root.item.subtitle != "" ? root.item.title + ", " + root.item.subtitle : root.item.title);
    accessible-action-default => { root.clicked(); }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        changed has-hover => { root.hovered(self.has-hover); }
    }
    // The icon and the text line up with the field's, above.
    Icon {
        visible: root.completion;
        x: Theme.s2;
        width: 20px;
        height: 20px;
        commands: root.item.kind == SuggestionKind.history ? SuggestIcons.history : Icons.search;
        stroke: Theme.text3;
    }
    HorizontalLayout {
        visible: root.completion;
        x: 40px;
        width: parent.width - self.x - Theme.s3;
        alignment: start;
        Body {
            text: root.item.title;
            font-weight: 700;
            vertical-alignment: center;
            overflow: clip;
            horizontal-stretch: 0;
        }
        Body {
            text: root.item.rest;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
    if !root.completion && root.item.kind != SuggestionKind.setting: Cover {
        x: Theme.s2;
        y: (parent.height - self.height) / 2;
        width: 40px;
        height: 40px;
        radius: Theme.r-s;
        round: root.item.kind == SuggestionKind.artist;
        source: root.item.cover;
    }
    // A setting: Settings' own gear from the sidebar, on a tile in the cover's place.
    Rectangle {
        visible: root.item.kind == SuggestionKind.setting;
        x: Theme.s2;
        y: (parent.height - self.height) / 2;
        width: 40px;
        height: 40px;
        border-radius: Theme.r-m;
        background: Theme.selected;
        Icon {
            width: 20px;
            height: 20px;
            commands: Icons.gear;
            stroke: Theme.text2;
            stroke-width: 1.5px;
        }
    }
    VerticalLayout {
        visible: !root.completion;
        x: 60px;
        width: parent.width - self.x - Theme.s3;
        alignment: center;
        spacing: 2px;
        Body {
            text: root.item.title;
            font-weight: 600;
        }
        if root.item.subtitle != "": Body {
            text: root.item.subtitle;
            font-size: Theme.t-meta;
            color: Theme.text3;
        }
    }
}

component Divider inherits Rectangle {
    height: 9px;
    Rectangle {
        x: Theme.s2;
        y: 4px;
        width: parent.width - 2 * Theme.s2;
        height: 1px;
        background: Theme.hairline;
    }
}

// The rows under the field. Stays instantiated so it can fade out; hidden once it has.
component SuggestionsPanel inherits Rectangle {
    in property <bool> open;
    // Closed by a key or a pick: keyboard actions don't animate.
    in property <bool> snap;
    in property <length> room;
    callback picked(int);

    // Opening, it snaps to its start (clear, a little up toward the field), then eases
    // down into place; closing, it fades. Nothing runs once it's in place or gone.
    property <bool> settled: true;
    changed open => {
        if root.open {
            root.settled = false;
            settle.running = true;
        }
    }
    settle := Timer {
        interval: 1ms;
        running: false;
        triggered => {
            self.running = false;
            root.settled = true;
        }
    }
    property <length> nudge: root.open && !root.settled ? -Theme.nudge : 0px;
    animate nudge { duration: root.open && root.settled ? Theme.t-menu : 0ms; easing: Curves.ease-out; }
    opacity: root.open && root.settled ? 1 : 0;
    animate opacity {
        duration: root.open ? (root.settled ? Theme.t-menu : 0ms) : (root.snap ? 0ms : Theme.t-fast);
        easing: Curves.ease-out;
    }
    visible: self.opacity > 0;
    height: min(rows.preferred-height, root.room);
    border-radius: Theme.r-l;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.card-edge;
    drop-shadow-blur: 24px;
    drop-shadow-offset-y: 8px;
    drop-shadow-color: Theme.cover-shadow;
    clip: true;
    accessible-role: list;
    accessible-label: @tr("Search suggestions");

    // Swallows clicks on the padding, and the wheel, which would scroll the page under it.
    TouchArea {
        enabled: root.open;
        scroll-event(e) => { accept }
    }
    rows := VerticalLayout {
        y: root.nudge;
        padding: Theme.s2;
        for item[i] in TopBarData.suggestions: VerticalLayout {
            if (i == TopBarData.completions || i == TopBarData.settings-from) && i > 0: Divider { }
            SuggestionRow {
                item: item;
                enabled: root.open;
                highlighted: TopBarData.highlighted == i;
                clicked => { root.picked(i); }
                hovered(over) => {
                    if over {
                        TopBarData.highlighted = i;
                    } else if TopBarData.highlighted == i {
                        TopBarData.highlighted = -1;
                    }
                }
            }
        }
    }
}

// A key of a shortcut hint: its label in a small rounded cap with a hairline edge.
export component Keycap inherits Rectangle {
    in property <string> text;
    height: 20px;
    min-width: self.height;
    border-radius: Theme.r-s;
    border-width: 1px;
    border-color: Theme.field-edge-hover;
    accessible-role: none;
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        Text {
            text: root.text;
            font-family: Theme.body-font;
            font-size: 11px;
            font-weight: 600;
            color: Theme.text2;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// The row's round buttons: the menu button (`filled`: the field's round twin, its fill and its
// edge lifting on hover, three lines) and Back and Forward (ghosts). Tab reaches them, Enter or
// Space presses them, and from the keyboard the accent ring shows, as on the app's other
// rings. Forward is always there, dimmed while there's nowhere to go, so nothing shifts.
component RoundButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <string> description;
    in property <bool> filled;
    in property <bool> enabled: true;
    // The menu button: what it opens is open.
    in property <bool> expandable;
    in property <bool> open;
    // Clicked, or Enter or Space while it has the keys (`by-key`).
    callback activated(bool);
    // Takes the keys back as the drawer closes, its ring showing.
    public function focus-by-key() {
        fs.focus();
        root.ring = true;
    }
    property <bool> ring;
    property <bool> lit: root.enabled && (ta.has-hover || root.open);
    width: Theme.top-control;
    height: Theme.top-control;
    border-radius: self.height / 2;
    background: root.filled ? Theme.field-solid : transparent;
    border-width: root.filled ? 1px : 0px;
    border-color: root.lit ? Theme.field-edge-hover : Theme.field-edge;
    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.description;
    accessible-enabled: root.enabled;
    accessible-expandable: root.expandable;
    accessible-expanded: root.open;
    accessible-action-default => { root.activated(false); }
    animate border-color { duration: Theme.t-hover; easing: Curves.ease-hover; }
    fs := FocusScope {
        enabled: root.visible && root.enabled;
        focus-on-click: false;
        focus-gained(reason) => { root.ring = reason == FocusReason.tab-navigation; }
        focus-lost => { root.ring = false; }
        key-pressed(e) => {
            if (e.text == Key.Return || e.text == " ") && !e.repeat {
                root.activated(true);
                return accept;
            }
            reject
        }
    }
    // Above the focus scope, so a click is the touch area's.
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.activated(false); }
    }
    Rectangle {
        border-radius: root.border-radius;
        background: Theme.state(ta.pressed, ta.has-hover);
        animate background { duration: Theme.t-hover; }
    }
    Icon {
        width: 20px;
        height: 20px;
        commands: root.icon;
        stroke: Frame.contrast ? Frame.hc-text : (!root.enabled ? Theme.text3 : (root.lit || !root.filled ? Theme.text1 : Theme.text2));
        stroke-width: root.filled ? 1.6px : 1.8px;
        opacity: root.enabled ? 1 : 0.55;
    }
    Rectangle {
        visible: fs.has-focus && root.ring;
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: self.height / 2;
        border-width: 2px;
        border-color: Theme.accent;
    }
}

// The wide rounded field. Enter submits; Escape bubbles up to the window. On Settings
// (`settings`) it searches the settings: its text goes to `SettingsSearch` as typed, Enter
// does nothing, and no suggestions show.
component SearchField inherits Rectangle {
    in property <bool> settings;
    callback submitted(string);
    // A suggestion picked with Enter.
    callback picked-by-key(int);
    // Escape closed the suggestions.
    callback escaped();
    out property <bool> focused: input.has-focus;
    // The suggestions show: wanted, rows to show, and the field has the keys.
    out property <bool> suggestions-open: !root.settings && TopBarData.suggesting && input.has-focus && TopBarData.query != "" && TopBarData.suggestions.length > 0;
    public function focus-input() {
        input.focus();
        input.select-all();
    }
    // The text changed: the suggestions for it, or on Settings the page filtered by it.
    public function set(text: string) {
        TopBarData.query = text;
        if root.settings {
            SettingsSearch.query = text;
            SettingsSearch.edited(text);
        } else {
            TopBarData.edited(text);
        }
    }
    property <bool> has-text: TopBarData.query != "";
    property <bool> hovered: ta.has-hover && !input.has-focus;
    property <length> lead: 48px;
    // The Ctrl K keycaps step aside in a short field (a narrow window), for the placeholder.
    property <bool> hinted: !root.has-text && !input.has-focus && root.width >= 400px;
    // Room on the right: the × button, or the Ctrl K keycaps.
    property <length> trail: root.has-text ? 44px : (root.hinted ? keycaps.width + Theme.s3 + Theme.s2 : Theme.s4);
    height: Theme.top-control;
    border-radius: self.height / 2;
    // Opaque, so it reads the same over a page's wash or an artist's photo as on the ground,
    // with a neutral 1 px edge that keeps its shape there. The fill never changes, so the
    // placeholder keeps its contrast; hover lifts the edge, focus makes it a 2 px accent ring.
    background: Theme.field-solid;
    border-width: input.has-focus ? 2px : 1px;
    border-color: input.has-focus ? Theme.accent : (root.hovered ? Theme.field-edge-hover : Theme.field-edge);
    animate border-color { duration: Theme.t-hover; easing: Curves.ease-hover; }
    ta := TouchArea {
        mouse-cursor: text;
        clicked => { input.focus(); }
        Icon {
            x: Theme.s4;
            width: 20px;
            height: 20px;
            commands: Icons.search;
            stroke: input.has-focus ? Theme.text1 : (root.hovered ? Theme.text2 : Theme.text3);
        }
        Body {
            visible: !root.has-text;
            // Starts just past the text cursor, so the cursor never draws over its first letter.
            x: root.lead + input.text-cursor-width + 2px;
            width: parent.width - self.x - root.trail;
            height: parent.height;
            // A short field (a narrow window) says only what it does.
            text: root.settings ? @tr("Search settings") : (root.width < 360px ? @tr("Search") : @tr("Search songs, albums, artists, playlists"));
            color: Theme.text3;
            vertical-alignment: center;
        }
        // Right-click (or the Menu key): Cut, Copy, Paste and Select all, as any text field
        // has. Paste calls `TopBarData.pasting` first, which logs whether the system
        // clipboard could be read (the paste regression of 2026-10-31).
        ContextMenuArea {
            width: parent.width;
            height: parent.height;
            Menu {
                MenuItem {
                    title: @tr("Cut");
                    enabled: root.has-text;
                    activated => { input.cut(); }
                }
                MenuItem {
                    title: @tr("Copy");
                    enabled: root.has-text;
                    activated => { input.copy(); }
                }
                MenuItem {
                    title: @tr("Paste");
                    activated => {
                        input.focus();
                        TopBarData.pasting();
                        input.paste();
                    }
                }
                MenuSeparator { }
                MenuItem {
                    title: @tr("Select all");
                    enabled: root.has-text;
                    activated => {
                        input.focus();
                        input.select-all();
                    }
                }
            }
            input := TextInput {
                x: root.lead;
                width: parent.width - root.lead - root.trail;
                height: parent.height;
                text <=> TopBarData.query;
                single-line: true;
                vertical-alignment: center;
                font-family: Theme.body-font;
                font-size: Theme.t-body;
                color: Theme.text1;
                selection-background-color: Theme.solid;
                selection-foreground-color: Theme.on-solid;
                accessible-role: text-input;
                accessible-label: root.settings ? @tr("Search settings") : @tr("Search");
                accessible-description: @tr("Ctrl+K");
                accepted => {
                    if !root.settings {
                        root.submitted(self.text);
                    }
                }
                // Paste keys are only noted here; the input still pastes them itself.
                // The arrows move through the suggestions (Down past the last one comes back
                // to the field), Enter picks the one highlighted, Escape closes them; with
                // none highlighted, Enter searches for the text as it is.
                key-pressed(e) => {
                    if (e.modifiers.control && (e.text == "v" || e.text == "V")) || (e.modifiers.shift && e.text == Key.Insert) {
                        TopBarData.pasting();
                    }
                    if root.settings {
                        // Tab: the "Search music" link under the results, while the page
                        // is filtered.
                        if e.text == Key.Tab && !e.modifiers.shift && SettingsSearch.active {
                            SettingsSearch.link-asks += 1;
                            return accept;
                        }
                        return reject;
                    }
                    if e.text == Key.DownArrow && TopBarData.suggestions.length > 0 && TopBarData.query != "" {
                        if root.suggestions-open {
                            TopBarData.highlighted = Math.mod(TopBarData.highlighted + 2, TopBarData.suggestions.length + 1) - 1;
                        } else {
                            TopBarData.highlighted = -1;
                            TopBarData.suggesting = true;
                        }
                        return accept;
                    }
                    if root.suggestions-open {
                        if e.text == Key.UpArrow {
                            TopBarData.highlighted = Math.mod(TopBarData.highlighted + TopBarData.suggestions.length + 1, TopBarData.suggestions.length + 1) - 1;
                            return accept;
                        }
                        if e.text == Key.Escape {
                            root.escaped();
                            return accept;
                        }
                        if e.text == Key.Return && TopBarData.highlighted >= 0 && TopBarData.highlighted < TopBarData.suggestions.length {
                            root.picked-by-key(TopBarData.highlighted);
                            return accept;
                        }
                    }
                    reject
                }
                // A paste can bring line breaks (Windows' CR LF, of which Slint turns only the LF
                // into a space) and tabs, which would break the text onto a second line, above
                // the field's middle. Put it back on one line, the cursor at its end.
                edited => {
                    if self.text.replace-all("\u{d}", "").replace-all("\u{a}", "").replace-all("\u{9}", "") != self.text {
                        TopBarData.query = TopBarData.single-line(self.text);
                        self.set-selection-offsets(2147483647, 2147483647);
                    }
                    // Typing brings the keys back to the field, off any row.
                    TopBarData.highlighted = -1;
                    root.set(TopBarData.query);
                }
            }
        }
        // The shortcut, as two small keycaps. Only a hint: screen readers hear it from the
        // field's description instead.
        keycaps := HorizontalLayout {
            x: parent.width - self.width - Theme.s3;
            y: (parent.height - self.height) / 2;
            width: self.preferred-width;
            height: self.preferred-height;
            visible: root.hinted;
            spacing: Theme.s1;
            Keycap { text: @tr("Ctrl"); }
            Keycap { text: "K"; }
        }
        // Clears the field and keeps (or puts) the cursor in it.
        Rectangle {
            visible: root.has-text;
            x: parent.width - self.width - 4px;
            width: 32px;
            height: 32px;
            border-radius: self.width / 2;
            background: Theme.state(cta.pressed, cta.has-hover);
            accessible-role: button;
            accessible-label: @tr("Clear search");
            accessible-action-default => {
                root.set("");
                input.focus();
            }
            animate background { duration: Theme.t-hover; }
            cta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.set("");
                    input.focus();
                }
            }
            Icon {
                width: 18px;
                height: 18px;
                commands: Icons.close;
                stroke: cta.has-hover ? Theme.text1 : Theme.text2;
            }
        }
    }
}

// The row at the window's top, across the sidebar and the page (`Theme.top-bar-h`). Over
// the sidebar: with the window's own title bar the icon and "featherplay", then Back and
// Forward (beside the rail they move in front of the field, and in a window without a sidebar
// the menu button and Back come first). Over the page: the search field on the page's left
// edge, free space, then the window buttons (`CaptionButtons`, which the window draws over
// everything). On Now playing only Back, over the stage, whose header row is the rest of the
// row (`now_playing.slint`, with the window's own title bar). Its free space drags
// the window (`hits`: the controls Windows leaves to the app).
export component TopBar inherits Rectangle {
    // The sidebar beside the page (0 without one), and the page's width beside it.
    in property <length> side-w;
    in property <length> page-w;
    // The sidebar is the icon rail: the field is narrower.
    in property <bool> narrow: false;
    // Over a page that runs up under it (album, playlist, artist, Sign in): no ground of its
    // own over the page, so the page's wash shows through; the page's `TopScrim` covers what
    // scrolls under it.
    in property <bool> clear: false;
    // Now playing: Back over the stage, nothing else; the page's header controls share the row.
    in property <bool> stage;
    // No search field (Sign in).
    in property <bool> searchable: true;
    // The content area's height from the bar's top: the suggestions end above its foot.
    in property <length> area-h: 0px;
    // On Settings: the field searches the settings.
    in property <bool> settings;
    // No sidebar beside the page: the menu button shows, left of Back (`menu-open`: its
    // drawer is open).
    in property <bool> menu: false;
    in property <bool> menu-open: false;
    // The menu button was pressed, by a click or a key (`by-key`).
    callback menu-pressed(bool);
    public function focus-menu() {
        menu-button.focus-by-key();
    }
    out property <bool> searching: field.focused;
    out property <bool> suggestions-open: field.suggestions-open;
    callback submitted(string);
    // Suggestion `i` was picked, by Enter (`by-key`) or a click: the window calls
    // `TopBarData.pick`.
    callback picked(int, bool);
    // A click outside the suggestions closed them: the field lets the keys go.
    callback dismissed();
    public function close-suggestions(by-key: bool) {
        root.snap = by-key;
        TopBarData.suggesting = false;
        TopBarData.highlighted = -1;
    }
    property <bool> snap;
    changed suggestions-open => {
        if root.suggestions-open {
            root.snap = false;
        }
    }
    public function focus-search() {
        field.focus-input();
    }
    // Escape's first press in the field (the window's key handler).
    public function clear-search() {
        field.set("");
    }

    height: Theme.top-bar-h;
    property <bool> own: Frame.own-bar;
    property <length> y-in: (root.height - Theme.top-control) / 2;
    // Where the window buttons leave off: 48 px free to drag before them.
    property <length> room-end: root.own ? root.width - 3 * Theme.caption-w - Theme.s8 : root.width;
    property <bool> drawer: root.menu && !root.stage;
    property <bool> wide: !root.stage && !root.drawer && !root.narrow;
    // The sidebar's part, in its colour.
    Rectangle {
        visible: !root.stage && root.side-w > 0;
        x: 0;
        width: root.side-w;
        background: Frame.contrast ? Frame.hc-ground : Theme.surface;
    }
    // The page's part.
    Rectangle {
        visible: !root.stage && (!root.clear || Frame.contrast);
        x: root.side-w;
        width: root.width - root.side-w;
        background: Frame.contrast ? Frame.hc-ground : Theme.ground;
    }
    // A contrast theme: a line under the row.
    Rectangle {
        visible: Frame.contrast;
        y: root.height - 1px;
        height: 1px;
        background: Frame.hc-text;
    }
    // Clicks on the row beside its controls don't reach a page's rows scrolled under it. Not
    // on Now playing, whose header controls are under it.
    TouchArea { visible: !root.stage; }
    // While the suggestions show, a click anywhere else in the content area closes them
    // (and goes no further); the field stays clickable above it. `app.slint` covers the
    // rest of the window.
    TouchArea {
        visible: root.suggestions-open;
        x: root.side-w;
        y: 0;
        width: root.page-w;
        height: max(root.height, root.area-h);
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.close-suggestions(false);
                TopBarData.dismissed();
                root.dismissed();
            }
        }
        scroll-event(e) => {
            root.close-suggestions(false);
            TopBarData.dismissed();
            root.dismissed();
            accept
        }
    }
    // The icon and "featherplay", as Windows' apps name themselves in their title bar; on the
    // rail the icon alone, centred on it. It drags the window too. Inactive, it fades.
    Rectangle {
        visible: root.own && !root.drawer && !root.stage;
        x: root.wide ? Theme.s4 : (root.side-w - 16px) / 2;
        width: 16px;
        SmallLogo {
            y: (parent.height - self.height) / 2;
            width: 16px;
            height: 16px;
            opacity: Frame.active ? 1 : 0.45;
        }
        Text {
            visible: root.wide;
            x: 16px + 10px;
            width: self.preferred-width;
            text: "featherplay";
            font-size: Theme.t-meta;
            color: Frame.contrast ? Frame.hc-text : (Frame.active ? Theme.text1 : Theme.caption-off);
            vertical-alignment: center;
            accessible-role: none;
        }
    }
    // Before Back and the field, so Tab goes menu, Back, Forward, search.
    menu-button := RoundButton {
        x: Theme.s3;
        y: root.y-in;
        visible: root.drawer;
        filled: true;
        icon: "M5 7.5 H19 M5 12 H19 M5 16.5 H19";
        label: @tr("Menu");
        description: @tr("Shows the sidebar");
        expandable: true;
        open: root.menu-open;
        activated(by-key) => { root.menu-pressed(by-key); }
    }
    // On a wide window over the sidebar, right of the name (first without it); beside the
    // rail in front of the field; without a sidebar after the menu button.
    property <length> back-x: root.stage || (root.wide && !root.own) ? Theme.s3 : (root.wide ? 156px : (root.drawer ? 52px : root.side-w + Theme.s3));
    property <bool> back-shown: !root.stage || root.own;
    property <bool> forward-shown: !root.stage && !root.drawer;
    property <length> forward-x: root.back-x + Theme.top-control + Theme.s1;
    RoundButton {
        x: root.back-x;
        y: root.y-in;
        visible: root.back-shown;
        icon: Icons.back;
        label: @tr("Back");
        description: @tr("Alt+Left");
        enabled: Nav.can-back;
        activated(by-key) => {
            if by-key {
                Frame.instant = true;
            }
            Nav.back();
        }
    }
    RoundButton {
        x: root.forward-x;
        y: root.y-in;
        visible: root.forward-shown;
        icon: Icons.chevron-right;
        label: @tr("Forward");
        description: @tr("Alt+Right");
        enabled: Nav.can-forward;
        activated(by-key) => {
            if by-key {
                Frame.instant = true;
            }
            Nav.forward();
        }
    }
    // On a wide window the pages' padding (`Theme.pad-for`), so the field lines up with their
    // content; beside the rail after Forward, without a sidebar after Back.
    property <length> pad: Theme.pad-for(root.page-w);
    property <length> field-x: root.wide ? root.side-w + root.pad : (root.drawer ? root.back-x + Theme.top-control + Theme.s2 : root.forward-x + Theme.top-control + Theme.s3);
    property <length> field-end: min(root.side-w + root.page-w - root.pad, root.room-end);
    field := SearchField {
        settings: root.settings;
        visible: !root.stage && root.searchable;
        x: root.field-x;
        y: root.y-in;
        width: max(0px, min(root.wide ? Theme.top-search-w : Theme.top-search-narrow, root.field-end - root.field-x));
        submitted(q) => {
            root.close-suggestions(true);
            TopBarData.dismissed();
            root.submitted(q);
        }
        picked-by-key(i) => {
            root.close-suggestions(true);
            root.picked(i, true);
        }
        escaped => {
            root.close-suggestions(true);
            TopBarData.dismissed();
        }
    }
    // The controls in the row, as left edges and widths: Windows leaves them to the app, and
    // the rest of the row drags the window.
    out property <[length]> hits: root.stage ? [
        root.back-x, Theme.top-control,
        Frame.np-controls-x, Frame.np-controls-w,
        Frame.np-source-x, Frame.np-source-w] : [
        menu-button.visible ? menu-button.x : 0px, menu-button.visible ? menu-button.width : 0px,
        root.back-shown ? root.back-x : 0px, root.back-shown ? Theme.top-control : 0px,
        root.forward-shown ? root.forward-x : 0px, root.forward-shown ? Theme.top-control : 0px,
        field.visible ? field.x : 0px, field.visible ? field.width : 0px];
    SuggestionsPanel {
        x: field.x;
        y: field.y + field.height + Theme.s2;
        width: field.width;
        room: max(0px, root.area-h - self.y - Theme.s4);
        open: field.suggestions-open;
        snap: root.snap;
        picked(i) => {
            root.close-suggestions(true);
            root.picked(i, false);
        }
    }
}

// One window button: Windows' size and glyph, hovered and held as Windows reports them
// (`Frame.caption-*`). Close turns red under the pointer, its glyph white.
component CaptionButton inherits Rectangle {
    in property <int> index;
    in property <string> glyph;
    in property <string> label;
    property <bool> close: root.index == 2;
    property <bool> over: Frame.caption-hover == root.index;
    property <bool> down: Frame.caption-down == root.index && root.over;
    // A contrast theme: the highlight under the pointer, close's too.
    property <bool> lit: Frame.contrast && root.over;
    property <bool> red: root.close && root.over && !Frame.contrast;
    width: Theme.caption-w;
    height: Theme.top-bar-h;
    background: root.lit ? Frame.hc-highlight : (root.red ? (root.down ? Theme.close-down : Theme.close-hover) : (root.down ? Theme.caption-down : (root.over ? Theme.caption-hover : transparent)));
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { Frame.caption(root.index); }
    Path {
        width: 10px;
        height: 10px;
        viewbox-width: 10;
        viewbox-height: 10;
        commands: root.glyph;
        fill: transparent;
        stroke-width: 1px;
        stroke: root.lit ? Frame.hc-on-highlight : (root.red ? (root.down ? #FFFFFFB3 : #FFFFFF) : (Frame.contrast ? Frame.hc-text : (Frame.active ? Theme.text1 : Theme.caption-off)));
    }
}

// The window buttons at the top right, with the window's own title bar: Minimise, Maximise
// (Restore while maximised) and Close. Out of Tab, as Windows' own are; Windows hands their
// pointer events to `src/title_bar.rs`, which reports them here.
export component CaptionButtons inherits Rectangle {
    width: 3 * Theme.caption-w;
    height: Theme.top-bar-h;
    CaptionButton {
        x: 0;
        index: 0;
        glyph: "M0 5.5 H10";
        label: @tr("Minimise");
    }
    CaptionButton {
        x: Theme.caption-w;
        index: 1;
        glyph: Frame.maximised ? "M2.5 0.5 H9.5 V7.5 H7.5 M0.5 2.5 H7.5 V9.5 H0.5 Z" : "M0.5 0.5 H9.5 V9.5 H0.5 Z";
        label: Frame.maximised ? @tr("Restore") : @tr("Maximise");
    }
    CaptionButton {
        x: 2 * Theme.caption-w;
        index: 2;
        glyph: "M0.2 0.2 L9.8 9.8 M9.8 0.2 L0.2 9.8";
        label: @tr("Close");
    }
}
