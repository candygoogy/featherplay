// The Tri-vane logo in the window, drawn with `Path`s: the paths of `logo/tri-vane*.svg`,
// which stay the drawings (the build renders the icons and installer images from them).
// Paths, not the SVGs as images, so a release build has no SVG renderer in it (~1.5 MB).
// `logo_paths_match_the_svgs` (tests/app/logo.rs) checks the two stay the same.
import { Theme } from "theme.slint";

