// The panel of `ItemMenu` (item_menu.slint), in the song menu's style (song_menu.slint: the
// same panel, rows, motion, placement and dismissal): a head with the item's cover, title and
// line; Play, Shuffle, Play next, Add to queue; then Pin or Unpin. From a Shortcuts tile, a
// pin also gets Move left and Move right (only the moves that can happen) and a suggestion
// Remove from Shortcuts. Liked songs gets Play and Shuffle only.
import { Theme, Icons } from "theme.slint";
import { MenuPanel } from "menu_panel.slint";
import { ItemKind, Body, Cover, Icon } from "parts.slint";
import { MenuItem, Divider, MenuIcons } from "song_menu.slint";
import { ItemMenu } from "item_menu.slint";

// Covers the window while the menu is open: a click outside closes it, Escape too.
export component ItemMenuLayer inherits Rectangle {
    callback closed();
    // The menu stays above this (the bottom bar's top edge); the layer still covers the bar.
    in property <length> bottom-limit: root.height;
    property <length> head-h: 56px;
    property <bool> liked: ItemMenu.item.id == "LM" || ItemMenu.item.id == "VLLM";
    property <length> w: 288px;
    property <bool> moves: ItemMenu.shortcut && ItemMenu.pinned;
    // Play and Shuffle; for the rest Play next and Add to queue, a divider, Pin or Unpin, and
    // from Shortcuts the moves that can happen or Remove.
    property <int> rows: root.liked ? 2 : 5 + (root.moves ? (ItemMenu.can-left ? 1 : 0) + (ItemMenu.can-right ? 1 : 0) : (ItemMenu.shortcut ? 1 : 0));
    property <int> dividers: root.liked ? 0 : 1;
    property <length> actions-h: root.rows * 36px + root.dividers * 9px;
    property <length> h: 2 * Theme.s2 + root.head-h + 9px + root.actions-h;

    // The panel stays instantiated so it can fold away (`MenuPanel`).
    property <bool> open: ItemMenu.open;
    // Closed by Escape: keyboard actions don't animate.
    property <bool> snap: false;
    property <bool> left: ItemMenu.anchor-x + root.w + 8px > root.width;
    property <bool> up: ItemMenu.anchor-y + root.h + 8px > root.bottom-limit;
    changed open => {
        if root.open {
            root.snap = false;
            keys.focus();
        }
    }

    function close() {
        ItemMenu.close();
        root.closed();
    }

    TouchArea {
        visible: ItemMenu.open;
        width: root.width;
        height: root.height;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.close();
            }
        }
        scroll-event(e) => {
            root.close();
            accept
        }
    }
    panel := MenuPanel {
        open: root.open;
        up: root.up;
        snap: root.snap;
        full-h: root.h;
        x: root.left ? max(8px, ItemMenu.anchor-x - root.w) : ItemMenu.anchor-x;
        y: root.up ? max(8px, ItemMenu.anchor-top - self.height) : ItemMenu.anchor-y;
        width: root.w;
        accessible-role: list;
        accessible-label: ItemMenu.item.kind == ItemKind.album ? @tr("Album menu") : (ItemMenu.item.kind == ItemKind.artist ? @tr("Artist menu") : @tr("Playlist menu"));

        // Swallows clicks on the panel's padding.
        TouchArea { enabled: root.open; }
        keys := FocusScope {
            enabled: root.open;
            key-pressed(e) => {
                if e.text == Key.Escape {
                    root.snap = true;
                    root.close();
                    return accept;
                }
                reject
            }
        }

        // The item's cover, or for Liked songs its red tile with the heart.
        if !root.liked: Cover {
            x: Theme.s2 + 8px;
            y: Theme.s2 + 8px;
            width: Theme.row-cover;
            height: Theme.row-cover;
            radius: Theme.r-s;
            round: ItemMenu.item.round;
            source: ItemMenu.item.cover;
        }
        Rectangle {
            visible: root.liked;
            x: Theme.s2 + 8px;
            y: Theme.s2 + 8px;
            width: Theme.row-cover;
            height: Theme.row-cover;
            border-radius: Theme.r-s;
            background: @linear-gradient(135deg, Theme.brand-accent 0%, #7A0E20 100%);
            Icon {
                width: 18px;
                height: 18px;
                commands: Icons.heart;
                fill: #FFFFFF;
                stroke: transparent;
            }
        }
        VerticalLayout {
            x: Theme.s2 + 8px + Theme.row-cover + 12px;
            y: Theme.s2;
            width: parent.width - self.x - Theme.s4;
            height: root.head-h;
            alignment: center;
            spacing: 1px;
            Body {
                text: ItemMenu.item.title;
                font-weight: 600;
            }
            if ItemMenu.item.subtitle != "": Body {
                text: ItemMenu.item.subtitle;
                font-size: Theme.t-meta;
                color: Theme.text2;
            }
        }
        Divider {
            x: 0;
            y: Theme.s2 + root.head-h;
            width: parent.width;
        }

        VerticalLayout {
            x: Theme.s2;
            y: Theme.s2 + root.head-h + 9px;
            width: parent.width - 2 * Theme.s2;
            height: root.actions-h;
            MenuItem {
                enabled: root.open;
                icon: Icons.play;
                icon-filled: true;
                label: @tr("Play");
                clicked => {
                    ItemMenu.play(ItemMenu.item);
                    root.close();
                }
            }
            MenuItem {
                enabled: root.open;
                icon: Icons.shuffle;
                label: @tr("Shuffle");
                clicked => {
                    ItemMenu.shuffle(ItemMenu.item);
                    root.close();
                }
            }
            MenuItem {
                visible: !root.liked;
                height: self.visible ? 36px : 0px;
                enabled: root.open;
                icon: MenuIcons.play-next;
                label: @tr("Play next");
                clicked => {
                    ItemMenu.play-next(ItemMenu.item);
                    root.close();
                }
            }
            MenuItem {
                visible: !root.liked;
                height: self.visible ? 36px : 0px;
                enabled: root.open;
                icon: MenuIcons.add-to-queue;
                label: @tr("Add to queue");
                clicked => {
                    ItemMenu.add-to-queue(ItemMenu.item);
                    root.close();
                }
            }
            Divider {
                visible: !root.liked;
                height: self.visible ? 9px : 0px;
            }
            MenuItem {
                visible: !root.liked;
                height: self.visible ? 36px : 0px;
                enabled: root.open;
                icon: ItemMenu.pinned ? MenuIcons.unpin : MenuIcons.pin;
                label: ItemMenu.pinned ? @tr("Unpin") : @tr("Pin");
                clicked => {
                    ItemMenu.pin(ItemMenu.item);
                    root.close();
                }
            }
            MenuItem {
                visible: !root.liked && root.moves && ItemMenu.can-left;
                height: self.visible ? 36px : 0px;
                enabled: root.open;
                icon: Icons.chevron-left;
                label: @tr("Move left");
                clicked => {
                    ItemMenu.move(ItemMenu.item, false);
                    root.close();
                }
            }
            MenuItem {
                visible: !root.liked && root.moves && ItemMenu.can-right;
                height: self.visible ? 36px : 0px;
                enabled: root.open;
                icon: Icons.chevron-right;
                label: @tr("Move right");
                clicked => {
                    ItemMenu.move(ItemMenu.item, true);
                    root.close();
                }
            }
            MenuItem {
                visible: !root.liked && ItemMenu.shortcut && !ItemMenu.pinned;
                height: self.visible ? 36px : 0px;
                enabled: root.open;
                icon: Icons.close;
                label: @tr("Remove from Shortcuts");
                clicked => {
                    ItemMenu.remove(ItemMenu.item);
                    root.close();
                }
            }
        }
    }
}
