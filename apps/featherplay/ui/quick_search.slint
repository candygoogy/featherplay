// The quick search box: a small borderless window over whatever app is in front, opened by
// the quick search's global hotkey (`src/quick_search.rs` creates it, places it and drops it
// on close). The field, then the rows: the last picks while it's empty (`Recent`), the top
// bar's suggestions once typed (results first, then completions), or a calm line in a row's
// grammar (no results, offline, nothing picked yet); last, a footer with the song playing
// now on the left and the highlighted row's actions on the right.
//
// One left edge runs through it: the field's text, the titles and the completions start at
// x 72, and the magnifier, the covers, the completions' icons and the calm lines' tiles share
// the column before it. The accent is kept for what means something: the ✓ of a row picked
// to play next, the wave of the song playing now, the sweep under the field while the first
// answer is on its way. The highlight is a neutral lift.
//
// Its height follows its rows; Rust keeps its top edge where it opened. The window shows at
// once; its content fades in and settles 4 px over `t-menu` (the app's menus), the rows fade
// in over 120 ms when the list goes from empty to full, and the highlight moves at once. It
// has its own `Theme` global, which Rust copies from the main window's.
import { Theme, Icons, Curves } from "theme.slint";
import { Icon, Body, Cover, Mark } from "parts.slint";
import { SuggestionKind } from "top_bar.slint";
import { SmallLogo } from "logo.slint";

// One row: a result (song, album, artist, playlist) or a completion (`query`).
export struct QuickRow {
    kind: SuggestionKind,
    // A result: its title, its line (the artist, or the playlist's author), its kind at the
    // right ("Song", "Album"), and, for an artist without a photo, their initials.
    title: string,
    line: string,
    what: string,
    initials: string,
    // A completion's text in three parts, the middle one bright: what it adds to the typed
    // text ("josh" + "woodward"), or the text a "Search for “…”" row searches.
    lead: string,
    hit: string,
    tail: string,
    // The footer's name for Enter on this row: "Play song", "Play album", "Search".
    action: string,
    cover: image,
    // "Plays next", "Plays after it": set by Shift+Enter, kept while the box is open.
    tag: string,
}

// What the box shows under the field.
export enum QuickState {
    // The field is empty: the last picks, under "Recent".
    recent,
    // Empty and nothing picked yet: a hint line.
    fresh,
    // Typed, and the answer isn't in yet: the sweep under the field, nothing else.
    waiting,
    // The answer's rows.
    results,
    // The answer has no rows: a calm line, and one row that searches featherplay for the text.
    none,
    // No connection.
    offline,
}

// How a row was picked: Enter (play), Shift+Enter (play next), Ctrl+Enter (open).
export enum QuickPick { play, next, open }

export global QuickData {
    in-out property <string> query;
    in property <[QuickRow]> rows;
    // Where the completions start among the rows; -1 for none.
    in property <int> completions-from: -1;
    in property <QuickState> state: QuickState.fresh;
    // "No results for “xqzv”".
    in property <string> none-title;
    // The highlighted row, -1 for none (the field). Typing puts it back on the top result.
    in-out property <int> highlighted: -1;
    // The pointer moved the highlight (it eases as a hover does); the keys move it at once.
    in-out property <bool> by-pointer;
    // Counts up each time the list goes from empty to full: its rows fade in.
    in property <int> arrived;
    // The song playing now, for the footer; empty with nothing playing.
    in property <string> playing;
    // An ordinary window in the desktop's frame, where the app can't place it (Wayland).
    in property <bool> framed;
    callback edited(string);
    callback pick(int, QuickPick);
    // Escape: close, the focus back to the window that had it.
    callback dismiss();
    // The box's height changed with its rows: the window follows.
    callback height-changed(length);
}

// The column the covers, the magnifier and the calm lines' tiles share, and the titles' edge,
// from the box's left edge; the rows are inset 8 px.
global Grid {
    out property <length> inset: 8px;
    out property <length> cover-x: 20px;
    out property <length> cover: 40px;
    out property <length> text-x: 72px;
    // The neutral grounds of the calm lines' tiles and the initials' discs.
    out property <color> mono: Theme.pick(#FFFFFF14, #0000000F);
}

// A key of the footer's actions: a small filled chip, no outline.
component Cap inherits Rectangle {
    in property <string> text;
    height: 18px;
    min-width: self.height;
    border-radius: 4px;
    background: Theme.pick(#FFFFFF17, #0000000F);
    // ↵ and ⇧ are drawn: the body fonts draw them too small to read.
    property <string> glyph: root.text == "↵" ? "M18 6.5 V11.5 A1.5 1.5 0 0 1 16.5 13 H6.5 M9.5 10 L6.5 13 L9.5 16" : (root.text == "⇧" ? "M12 5.5 L18.5 12 H15 V18.5 H9 V12 H5.5 Z" : "");
    if root.glyph != "": Icon {
        width: 14px;
        height: 14px;
        commands: root.glyph;
        stroke: Theme.text2;
        stroke-width: 1.6px;
    }
    if root.glyph == "": HorizontalLayout {
        padding-left: 5px;
        padding-right: 5px;
        Text {
            text: root.text;
            font-family: Theme.body-font;
            font-size: 11px;
            font-weight: 600;
            color: Theme.text2;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// An action in the footer: its name, then its keys. The primary one (Enter's) in text1/600,
// Play next in text3.
component Action inherits HorizontalLayout {
    in property <string> label;
    in property <[string]> keys;
    in property <bool> primary;
    spacing: 6px;
    Text {
        text: root.label;
        font-family: Theme.body-font;
        font-size: Theme.t-meta;
        font-weight: root.primary ? 600 : 400;
        color: root.primary ? Theme.text1 : Theme.text3;
        vertical-alignment: center;
    }
    for k in root.keys: VerticalLayout {
        alignment: center;
        Cap {
            text: k;
        }
    }
}

// A group's label above its rows: "Recent", "Top results", "Searches", on the covers' left
// edge. More room above it than under it, so it belongs to its rows; less above the first.
component Section inherits Rectangle {
    in property <string> text;
    in property <bool> first;
    height: root.first ? 26px : 30px;
    Text {
        x: Grid.cover-x - Grid.inset;
        y: root.height - 2px - self.height;
        height: 16px;
        text: root.text;
        font-family: Theme.body-font;
        font-size: Theme.t-meta;
        font-weight: 600;
        color: Theme.text3;
        vertical-alignment: center;
    }
}

component Row inherits Rectangle {
    in property <QuickRow> item;
    in property <bool> highlighted;
    callback clicked();
    callback hovered(bool);
    property <bool> completion: root.item.kind == SuggestionKind.query || root.item.kind == SuggestionKind.history;
    // The covers' column and the titles' edge, in the row's own coordinates.
    property <length> cover-x: Grid.cover-x - Grid.inset;
    property <length> text-x: Grid.text-x - Grid.inset;
    height: root.completion ? 36px : 52px;
    accessible-role: list-item;
    accessible-label: root.completion ? root.item.lead + root.item.hit + root.item.tail : root.item.title + (root.item.line != "" ? ", " + root.item.line : "") + ", " + (root.item.tag != "" ? root.item.tag : root.item.what);
    accessible-action-default => { root.clicked(); }
    // The highlight, the window's 8 px corners: instant on the keys, a hover's ease for the
    // pointer.
    Rectangle {
        border-radius: 8px;
        background: root.highlighted ? Theme.hover : Theme.hover.transparentize(1);
        animate background { duration: QuickData.by-pointer ? Theme.t-hover : 0ms; }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        changed has-hover => { root.hovered(self.has-hover); }
    }
    // A completion: the magnifier on the covers' column, the text it adds bright.
    if root.completion: Icon {
        x: root.cover-x + (Grid.cover - self.width) / 2;
        width: 16px;
        height: 16px;
        commands: Icons.search;
        stroke: Theme.text3;
    }
    if root.completion: HorizontalLayout {
        x: root.text-x;
        width: parent.width - self.x - Theme.s3;
        alignment: start;
        if root.item.lead != "": Text {
            text: root.item.lead;
            font-size: Theme.t-body;
            color: Theme.text2;
            vertical-alignment: center;
            overflow: clip;
            horizontal-stretch: 0;
        }
        Text {
            text: root.item.hit;
            font-size: Theme.t-body;
            font-weight: 600;
            color: Theme.text1;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: root.item.tail == "" ? 1 : 0;
        }
        if root.item.tail != "": Text {
            text: root.item.tail;
            font-size: Theme.t-body;
            color: Theme.text2;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
    // A result: the cover (an artist round, their initials without a photo), the title and
    // the artist, the kind at the right.
    if !root.completion && root.item.initials == "": Cover {
        x: root.cover-x;
        y: (parent.height - self.height) / 2;
        width: Grid.cover;
        height: Grid.cover;
        radius: 6px;
        round: root.item.kind == SuggestionKind.artist;
        source: root.item.cover;
    }
    if !root.completion && root.item.initials != "": Rectangle {
        x: root.cover-x;
        y: (parent.height - self.height) / 2;
        width: Grid.cover;
        height: Grid.cover;
        border-radius: self.width / 2;
        background: Grid.mono;
        Text {
            text: root.item.initials;
            font-family: Theme.body-font;
            font-size: 13px;
            font-weight: 600;
            letter-spacing: 0.2px;
            color: Theme.text2;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    if !root.completion: VerticalLayout {
        x: root.text-x;
        width: right.x - Theme.s3 - self.x;
        alignment: center;
        spacing: 1px;
        Body {
            text: root.item.title;
            font-weight: 600;
        }
        if root.item.line != "": Body {
            text: root.item.line;
            font-size: Theme.t-meta;
            color: Theme.text2;
        }
    }
    // The kind, or "✓ Plays next" once picked to play next (an accent check, no pill).
    right := HorizontalLayout {
        visible: !root.completion;
        x: parent.width - Theme.s3 - self.width;
        width: self.preferred-width;
        spacing: 6px;
        if root.item.tag != "": VerticalLayout {
            alignment: center;
            Icon {
                width: 14px;
                height: 14px;
                commands: "M5.5 12.5 L10 17 L18.5 7.5";
                stroke: Theme.accent;
                stroke-width: 2px;
            }
        }
        Text {
            text: root.item.tag != "" ? root.item.tag : root.item.what;
            font-family: Theme.body-font;
            font-size: Theme.t-meta;
            font-weight: root.item.tag != "" ? 600 : 400;
            color: root.item.tag != "" ? Theme.text1 : Theme.text3;
            vertical-alignment: center;
        }
    }
}

// A calm line in a row's grammar: a tile with a glyph in the covers' column, a title and one
// line on the titles' edge.
component Calm inherits HorizontalLayout {
    in property <string> icon;
    in property <string> title;
    in property <string> line;
    padding-left: Grid.cover-x;
    padding-right: Grid.cover-x;
    padding-top: 14px;
    padding-bottom: 18px;
    spacing: Grid.text-x - Grid.cover-x - Grid.cover;
    VerticalLayout {
        alignment: center;
        Rectangle {
            width: Grid.cover;
            height: Grid.cover;
            border-radius: 6px;
            background: Grid.mono;
            Icon {
                width: 20px;
                height: 20px;
                commands: root.icon;
                stroke: Theme.text3;
            }
        }
    }
    VerticalLayout {
        alignment: center;
        spacing: 1px;
        Body {
            text: root.title;
            font-weight: 600;
        }
        Body {
            text: root.line;
            font-size: Theme.t-meta;
            color: Theme.text2;
        }
    }
}

// While the first answer is on its way: after `t-skeleton-delay`, so a fast answer never
// flashes it, a short accent band travels along the hairline under the field. It exists only
// while the box waits, so `animation-tick()` ends with the wait; without motion it rests in
// the middle.
component Sweep inherits Rectangle {
    property <bool> shown: false;
    property <length> band: 180px;
    property <float> t: Theme.moving ? mod(animation-tick() / 1ms, Theme.t-shimmer / 1ms) / (Theme.t-shimmer / 1ms) : 0.5;
    height: 2px;
    clip: true;
    Timer {
        interval: Theme.t-skeleton-delay;
        running: !root.shown;
        triggered => { root.shown = true; }
    }
    if root.shown: Rectangle {
        x: Theme.moving ? (root.t * (root.width + root.band) - root.band) : (root.width - root.band) / 2;
        width: root.band;
        background: @linear-gradient(90deg, Theme.accent.transparentize(1) 0%, Theme.accent 35%, Theme.accent 65%, Theme.accent.transparentize(1) 100%);
    }
}

export component QuickSearch inherits Window {
    // The field, then the hairline under it.
    property <length> head-h: 61px;
    property <length> foot-h: 40px;
    // The footer's actions follow the highlighted row: a completion searches, anything else
    // plays (and plays next with Shift).
    property <bool> has-row: QuickData.highlighted >= 0 && QuickData.highlighted < QuickData.rows.length;
    property <bool> on-search: root.has-row && QuickData.rows[QuickData.highlighted].kind == SuggestionKind.query;
    // The box's height for its rows (`quick_search` sizes the window by it).
    out property <length> box-height: root.head-h + body.preferred-height + root.foot-h;
    changed box-height => {
        QuickData.height-changed(self.box-height);
    }

    title: @tr("featherplay quick search");
    // `quick_search` sizes the window by `box-height` (`height-changed`): a binding here
    // would be undone by the first resize.
    width: 640px;
    preferred-height: root.box-height;
    no-frame: !QuickData.framed;
    always-on-top: true;
    // The player bar's colour, which carries the cover's tint.
    background: Theme.bar;
    default-font-family: Theme.body-font;
    default-font-size: Theme.t-body;
    forward-focus: input;
    // The field takes the keys, its text cursor at the end.
    public function focus-input() {
        input.focus();
        input.set-selection-offsets(2147483647, 2147483647);
    }

    // Opening: the content snaps to its start (clear, 4 px down), then eases into place.
    property <bool> entered: false;
    init => {
        enter.running = true;
    }
    enter := Timer {
        interval: 1ms;
        running: false;
        triggered => {
            self.running = false;
            root.entered = true;
        }
    }
    // The rows' own fade, when the list goes from empty to full.
    property <bool> rows-in: true;
    property <int> arrived: QuickData.arrived;
    changed arrived => {
        root.rows-in = false;
        rows-enter.running = true;
    }
    rows-enter := Timer {
        interval: 1ms;
        running: false;
        triggered => {
            self.running = false;
            root.rows-in = true;
        }
    }

    // The 1 px highlight inside the edge, a little brighter along the top.
    Rectangle {
        border-width: 1px;
        border-color: Theme.pick(#FFFFFF0F, #FFFFFFB3);
    }
    Rectangle {
        x: 1px;
        y: 0;
        width: parent.width - 2px;
        height: 1px;
        background: Theme.pick(#FFFFFF1F, #FFFFFF);
    }

    // The footer's band, a step off the list's surface, under one full-bleed hairline; and
    // the hairline under the field, which carries the sweep while the box waits.
    Rectangle {
        y: root.height - root.foot-h;
        height: root.foot-h;
        background: Theme.pick(Theme.bar.mix(#000000, 0.72), Theme.bar.mix(#FFFFFF, 0.5));
    }
    Rectangle {
        y: root.height - root.foot-h;
        height: 1px;
        background: Theme.hairline;
    }
    Rectangle {
        y: root.head-h - 1px;
        height: 1px;
        background: Theme.hairline;
    }
    if QuickData.state == QuickState.waiting: Sweep {
        y: root.head-h - 1px;
    }

    content := Rectangle {
        y: root.entered ? 0px : Theme.nudge;
        opacity: root.entered ? 1 : 0;
        animate y, opacity { duration: root.entered ? Theme.t-menu : 0ms; easing: Curves.ease-out; }

        // The magnifier centred on the covers' column; the text on the titles' edge, in the
        // UI face as the top bar's field.
        Icon {
            x: Grid.cover-x + (Grid.cover - self.width) / 2;
            y: (root.head-h - 1px - self.height) / 2;
            width: 20px;
            height: 20px;
            commands: Icons.search;
            stroke: Theme.text3;
        }
        if QuickData.query == "": Text {
            x: Grid.text-x + input.text-cursor-width + 2px;
            y: 0;
            width: parent.width - self.x - Theme.s5;
            height: root.head-h - 1px;
            text: @tr("Search songs, albums, artists");
            font-family: Theme.body-font;
            font-size: 20px;
            color: Theme.text3;
            vertical-alignment: center;
            overflow: elide;
        }
        input := TextInput {
            x: Grid.text-x;
            y: 0;
            width: parent.width - self.x - Theme.s5;
            height: root.head-h - 1px;
            text <=> QuickData.query;
            single-line: true;
            vertical-alignment: center;
            font-family: Theme.body-font;
            font-size: 20px;
            color: Theme.text1;
            text-cursor-width: 2px;
            selection-background-color: Theme.accent;
            selection-foreground-color: Theme.on-solid;
            accessible-role: text-input;
            accessible-label: @tr("Quick search");
            key-pressed(e) => {
                if e.text == Key.Escape {
                    QuickData.dismiss();
                    return accept;
                }
                // ↓ on the last row stays put: no wrap. ↑ from the first goes back to the
                // field only among the recent picks.
                if e.text == Key.DownArrow {
                    if QuickData.rows.length > 0 {
                        QuickData.by-pointer = false;
                        QuickData.highlighted = min(QuickData.highlighted + 1, QuickData.rows.length - 1);
                    }
                    return accept;
                }
                if e.text == Key.UpArrow {
                    if QuickData.rows.length > 0 {
                        QuickData.by-pointer = false;
                        QuickData.highlighted = max(QuickData.highlighted - 1, QuickData.state == QuickState.recent ? -1 : 0);
                    }
                    return accept;
                }
                if e.text == Key.Return {
                    if QuickData.highlighted >= 0 && QuickData.highlighted < QuickData.rows.length {
                        QuickData.pick(QuickData.highlighted, e.modifiers.shift ? QuickPick.next : (e.modifiers.control ? QuickPick.open : QuickPick.play));
                    }
                    return accept;
                }
                reject
            }
            edited => {
                QuickData.edited(self.text);
            }
        }

        body := VerticalLayout {
            y: root.head-h;
            width: parent.width;
            height: self.preferred-height;
            // Room for the sweep's second pixel.
            if QuickData.state == QuickState.waiting: Rectangle {
                height: 1px;
            }
            if QuickData.state == QuickState.fresh: Calm {
                icon: Icons.note;
                title: @tr("Nothing picked here yet");
                line: @tr("Type a song, album, artist or playlist. Enter plays it.");
            }
            if QuickData.state == QuickState.none: Calm {
                icon: Icons.search;
                title: QuickData.none-title;
                line: @tr("Check the spelling, or try fewer words.");
                padding-bottom: Theme.s1;
            }
            if QuickData.state == QuickState.offline: Calm {
                icon: Icons.alert;
                title: @tr("You're offline");
                line: @tr("Search comes back with the connection.");
            }
            if QuickData.state == QuickState.recent || QuickData.state == QuickState.results || QuickData.state == QuickState.none: VerticalLayout {
                padding-left: Grid.inset;
                padding-right: Grid.inset;
                padding-top: QuickData.state == QuickState.none ? 0 : 4px;
                padding-bottom: 8px;
                opacity: root.rows-in ? 1 : 0;
                animate opacity { duration: root.rows-in && Theme.fading ? 120ms : 0ms; easing: Curves.ease-out; }
                if QuickData.state == QuickState.recent: Section {
                    text: @tr("Recent");
                    first: true;
                }
                for item[i] in QuickData.rows: VerticalLayout {
                    // The groups' labels separate them; no line between.
                    if QuickData.state == QuickState.results && i == 0 && QuickData.completions-from != 0: Section {
                        text: @tr("Top results");
                        first: true;
                    }
                    if QuickData.state == QuickState.results && i == QuickData.completions-from: Section {
                        text: @tr("Searches");
                        first: i == 0;
                    }
                    Row {
                        item: item;
                        highlighted: QuickData.highlighted == i;
                        clicked => { QuickData.pick(i, QuickPick.play); }
                        hovered(over) => {
                            if over {
                                QuickData.by-pointer = true;
                                QuickData.highlighted = i;
                            }
                        }
                    }
                }
            }
        }

        // The footer: the song playing now on the left (the mark and the name with nothing
        // playing); the highlighted row's action, named for what it is, and Play next on the
        // right. Ctrl+Enter (open in featherplay) is in the action's accessible description.
        if QuickData.playing != "": Path {
            x: Grid.cover-x;
            y: root.height - root.foot-h + (root.foot-h - self.height) / 2;
            width: 16px;
            height: 16px;
            viewbox-x: 0;
            viewbox-y: 0;
            viewbox-width: 16;
            viewbox-height: 16;
            stroke: Theme.accent;
            stroke-width: 2px;
            stroke-line-cap: round;
            stroke-line-join: round;
            fill: transparent;
            // The playing mark at rest: a still wave, as nothing in the box moves at rest.
            commands: Mark.path(16, 16, -1);
        }
        if QuickData.playing == "": SmallLogo {
            x: Grid.cover-x;
            y: root.height - root.foot-h + (root.foot-h - self.height) / 2;
            width: 14px;
            height: 14px;
        }
        Text {
            x: QuickData.playing != "" ? Grid.cover-x + 16px + 8px : 40px;
            y: root.height - root.foot-h;
            width: (root.has-row ? actions-box.x - Theme.s3 : parent.width - Theme.s4) - self.x;
            height: root.foot-h;
            text: QuickData.playing != "" ? QuickData.playing : "featherplay";
            font-family: Theme.body-font;
            font-size: Theme.t-meta;
            font-weight: QuickData.playing != "" ? 400 : 600;
            color: Theme.text3;
            vertical-alignment: center;
            overflow: elide;
            accessible-role: text;
            accessible-label: QuickData.playing != "" ? @tr("Playing now: {}", QuickData.playing) : self.text;
        }
        actions-box := Rectangle {
            visible: root.has-row;
            x: parent.width - self.width - Theme.s4;
            y: root.height - root.foot-h;
            width: actions.preferred-width;
            height: root.foot-h;
            if root.has-row: Rectangle {
                accessible-role: text;
                accessible-label: root.on-search ? @tr("Enter searches") : @tr("Enter plays, Shift+Enter plays next");
                accessible-description: root.on-search ? "" : @tr("Ctrl+Enter opens it in featherplay");
            }
            actions := HorizontalLayout {
                spacing: Theme.s3;
                Action {
                    label: root.has-row ? QuickData.rows[QuickData.highlighted].action : "";
                    keys: ["↵"];
                    primary: true;
                }
                if !root.on-search: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 1px;
                        height: 16px;
                        background: Theme.hairline;
                    }
                }
                if !root.on-search: Action {
                    label: @tr("Play next");
                    keys: ["⇧", "↵"];
                }
            }
        }
    }
}
