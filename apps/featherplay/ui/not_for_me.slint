// "Not for me" (the bar and Now playing): a thumbs-down beside the heart, styled as the
// heart is so the two read as a pair: the same button (36 px, 40 on Now playing) and 20 px
// glyph in `text2` (the cover's tint while the colours follow it), the same hover and
// press, and filled in `text1` for a song already rated Dislike, as the heart fills for a
// liked one. A click rates the song Dislike and skips it (`src/not_for_me.rs`); the toast
// that follows offers Undo. On a song it shows filled it's a toggle, as the heart is: the
// click takes the dislike off ("Remove dislike") and the song plays on. Resting on it shows
// the bar's tooltip (`BarTip`) saying what it does, so the skip never comes as a surprise.
// `LikeButton`, the heart, is here too: the bar and Now playing show the pair.
import { Theme, Icons } from "theme.slint";
import { IconButton } from "parts.slint";
import { Player } from "player.slint";
import { BarTip } from "bar_tip.slint";

// The current song's heart: filled in `text1` while it's liked, `text2` otherwise. A like
// added here pops the glyph (it snaps smaller and eases back).
export component LikeButton inherits IconButton {
    property <bool> pop: false;
    icon: Icons.heart;
    label: Player.liked ? @tr("Remove like") : @tr("Like");
    filled: Player.liked;
    tint: Player.liked ? Theme.text1 : Theme.text2;
    enabled: Player.has-track;
    glyph-scale: root.pop && Theme.moving ? 0.8 : 1.0;
    pop-end := Timer {
        interval: 1ms;
        running: false;
        triggered => {
            self.running = false;
            root.pop = false;
        }
    }
    clicked => {
        if !Player.liked {
            root.pop = true;
            pop-end.running = true;
        }
        Player.toggle-like();
    }
}

export component NotForMeButton inherits Rectangle {
    // How far above the button the tooltip ends (the bar lifts it clear of itself).
    in property <length> above: Theme.s2;
    // Shows the button from 0 (gone) to 1, as `IconButton.fade`.
    in property <float> fade: 1.0;
    // The target's side: the bar's 36 px, or Now playing's 40.
    in property <length> size: 36px;
    width: btn.width;
    height: btn.height;
    btn := IconButton {
        x: 0;
        y: 0;
        width: root.size;
        height: root.size;
        icon: Player.disliked ? Icons.dislike-filled : Icons.dislike;
        filled: Player.disliked;
        label: Player.disliked ? @tr("Remove dislike") : @tr("Not for me");
        description: Player.disliked ? @tr("Tells YouTube Music you no longer dislike the song") : @tr("Skips the song and tells YouTube Music you dislike it");
        tint: Player.disliked ? Theme.text1 : Theme.text2;
        enabled: Player.has-track;
        fade: root.fade;
        clicked => {
            tip.dismiss();
            Player.not-for-me();
        }
    }
    tip := BarTip {
        over: btn.hovered;
        name: btn.label;
        // What it does rather than a shortcut (it has none), set off by a dot.
        hint: Player.disliked ? @tr("· Back to no rating") : @tr("· Dislike and skip");
        above: root.above;
    }
}
