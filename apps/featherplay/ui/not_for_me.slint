// "Not for me" (the bar and Now playing): a thumbs-down beside the heart, styled as the
// heart is so the two read as a pair: the same 36 px button and 20 px glyph in `text2` (the
// cover's tint while the colours follow it), the same hover and press, and filled in `text1`
// for a song already rated Dislike, as the heart fills for a liked one. A click rates the
// song Dislike (unless it already is) and skips it (`src/not_for_me.rs`); the toast that
// follows offers Undo. Resting on it for a moment shows a tooltip over its right end that
// says what it does, so the skip never comes as a surprise. The delay keeps the tooltip from
// flashing as the pointer crosses the bar; its timer runs only while the pointer is on the
// button. `LikeButton`, the heart, is here too: the bar and Now playing show the pair.
import { Theme, Curves, Icons } from "theme.slint";
import { Body, IconButton } from "parts.slint";
import { Player } from "player.slint";

// The current song's heart: filled in `text1` while it's liked, `text2` otherwise. A like
// added here pops the glyph (it snaps smaller and eases back).
export component LikeButton inherits IconButton {
    property <bool> pop: false;
    icon: Icons.heart;
    label: Player.liked ? @tr("Remove like") : @tr("Like");
    filled: Player.liked;
    tint: Player.liked ? Theme.text1 : Theme.text2;
    enabled: Player.has-track;
    glyph-scale: root.pop && Theme.moving ? 0.8 : 1.0;
    pop-end := Timer {
        interval: 1ms;
        running: false;
        triggered => {
            self.running = false;
            root.pop = false;
        }
    }
    clicked => {
        if !Player.liked {
            root.pop = true;
            pop-end.running = true;
        }
        Player.toggle-like();
    }
}

export component NotForMeButton inherits Rectangle {
    // How far above the button the tooltip ends (the bar lifts it clear of itself).
    in property <length> above: Theme.s2;
    // Shows the button from 0 (gone) to 1, as `IconButton.fade`.
    in property <float> fade: 1.0;
    property <bool> over: btn.hovered;
    // The pointer has rested long enough (at once in snapshots), and hasn't clicked since.
    property <bool> rested: false;
    property <bool> dismissed: false;
    property <bool> tip: root.over && !root.dismissed && (root.rested || Theme.still);
    changed over => {
        if !root.over {
            root.rested = false;
            root.dismissed = false;
        }
    }
    width: btn.width;
    height: btn.height;
    Timer {
        interval: 500ms;
        running: root.over && !root.rested;
        triggered => { root.rested = true; }
    }
    btn := IconButton {
        x: 0;
        y: 0;
        icon: Player.disliked ? Icons.dislike-filled : Icons.dislike;
        filled: Player.disliked;
        label: @tr("Not for me");
        description: @tr("Skips the song and tells YouTube Music you dislike it");
        tint: Player.disliked ? Theme.text1 : Theme.text2;
        enabled: Player.has-track;
        fade: root.fade;
        clicked => {
            root.dismissed = true;
            Player.not-for-me();
        }
    }
    // The tooltip, `above` the button, its right end over the button's.
    Rectangle {
        x: root.width - self.width;
        y: btn.y - root.above - self.height;
        width: lay.preferred-width;
        height: lay.preferred-height;
        border-radius: Theme.r-s;
        background: Theme.card;
        border-width: 1px;
        border-color: Theme.card-edge;
        drop-shadow-blur: 8px;
        drop-shadow-color: Theme.cover-shadow;
        opacity: root.tip ? 1 : 0;
        visible: self.opacity > 0;
        animate opacity { duration: Theme.t-fast; easing: Curves.ease-out; }
        lay := VerticalLayout {
            padding-left: Theme.s3;
            padding-right: Theme.s3;
            padding-top: Theme.s2;
            padding-bottom: Theme.s2;
            spacing: 2px;
            Body {
                text: @tr("Not for me");
                font-size: Theme.t-meta;
                font-weight: 600;
                color: Theme.text1;
            }
            Body {
                text: @tr("Skips the song and tells YouTube Music you dislike it");
                font-size: Theme.t-meta;
                color: Theme.text2;
            }
        }
    }
}
