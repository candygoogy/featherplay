// Shared building blocks. Pages compose these; anything a single page needs stays in its file.
// They're in `parts/`, by kind; this file exports them all, so a page imports them from here.
export { TrackRow, ItemKind, RowHover, Refused, HoverIntent, SongList, ShownRows, RowsShown, PageHover, PageIntent, CardItem } from "parts/items.slint";
export { Icon, Display, Body, PageTitle, ShelfTitle, Bands, ProgressRail, PageStub, TextLink } from "parts/text.slint";
export { Cover, Mark, PlayingMark, CoverPlay } from "parts/covers.slint";
export { PlayButton, IconButton, Pill, ShelfArrows, Tabs } from "parts/buttons.slint";
export { Card, Shelf } from "parts/cards.slint";
export { SongRow, TrackListRow, ChoiceList, ChoiceRow } from "parts/rows.slint";
