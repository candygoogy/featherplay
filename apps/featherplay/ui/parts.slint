// Shared building blocks. Pages compose these; anything a single page needs stays in its file.
import { Theme, Icons, Curves } from "theme.slint";
import { Player } from "player.slint";

// One song in a list. Built by `ui_bridge::to_rows`; covers arrive later from `covers.rs`.
export struct TrackRow {
    id: string,         // videoId
    index: string,      // "1", "2"... for album and playlist lists
    title: string,
    artist: string,     // "A, B"
    artist-id: string,  // the first artist's channel id, or ""
    album: string,
    album-id: string,
    duration: string,   // "3:57", or "" when unknown
    cover: image,
    liked: bool,
    playing: bool,      // the current track
}

export enum ItemKind { album, artist, playlist, song }

// A song row the pointer has rested on for a moment, or pressed (`HoverIntent`): the app
// resolves its stream then, so a click plays at once (`song_menu.rs`).
export global RowHover {
    callback rested(string /* videoId */);
}

// Reports `id` to `RowHover` once the row has been hovered for 120 ms, or at once when it's
// pressed (the click comes on release), once per hover. The timer runs only while hovered.
export component HoverIntent {
    in property <bool> hovered;
    in property <bool> pressed;
    in property <string> id;
    width: 0;
    height: 0;
    property <bool> sent;
    changed hovered => {
        if !self.hovered {
            self.sent = false;
        }
    }
    changed pressed => {
        if self.pressed && self.hovered && !self.sent && self.id != "" {
            self.sent = true;
            RowHover.rested(self.id);
        }
    }
    Timer {
        interval: 120ms;
        running: root.hovered && !root.sent && root.id != "";
        triggered => {
            root.sent = true;
            RowHover.rested(root.id);
        }
    }
}

// One card on a shelf or grid, or a playlist in the sidebar.
export struct CardItem {
    id: string,
    kind: ItemKind,
    title: string,
    subtitle: string,
    cover: image,
    round: bool,        // artists
}

export component Icon inherits Path {
    width: 20px;
    height: 20px;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: Theme.text2;
    stroke-width: 1.6px;
    stroke-line-cap: round;
    fill: transparent;
}

// The play button (the bar, and the tray's mini player): a solid accent disc that morphs
// with the player (an M3 Expressive shape morph, on a spring): paused, it's round and shows
// play; playing, it eases into a rounded square and shows pause. A press squashes it a
// little, and it springs back on release. With nothing to play it's a neutral grey disc with
// a grey glyph (`selected` under `text3`, over 3:1 on the bar in both themes), not a faded
// accent. The bar is shared by every page, so it's the same size everywhere.
export component PlayButton inherits Rectangle {
    in property <length> size: Theme.play-size;
    in property <length> glyph: 24px;
    // For the bar's tooltip.
    out property <bool> hovered: pta.has-hover;
    // After the toggle, on a click.
    callback clicked();
    property <bool> on: Player.has-track;
    width: root.size;
    height: root.size;
    border-radius: Player.playing ? self.height * 0.3 : self.height / 2;
    background: root.on ? Theme.accent : Theme.selected;
    transform-scale: pta.pressed ? Theme.press-scale - (Theme.moving ? 0.02 : 0) : 1.0;
    accessible-role: button;
    accessible-label: Player.playing ? @tr("Pause") : @tr("Play");
    // Its shortcut, in both windows.
    accessible-description: @tr("Space");
    accessible-enabled: root.on;
    accessible-action-default => { Player.toggle(); }
    animate border-radius { duration: Theme.t-morph; easing: Curves.morph; }
    animate background { duration: Theme.t-hover; }
    animate transform-scale {
        duration: pta.pressed ? Theme.t-press : Theme.t-release;
        easing: pta.pressed ? Curves.ease-out : Curves.release;
    }
    // Hover and press: the usual overlay, over the accent.
    Rectangle {
        border-radius: parent.border-radius;
        background: Theme.state(pta.pressed, pta.has-hover);
        animate background { duration: Theme.t-hover; }
    }
    pta := TouchArea {
        enabled: root.on;
        mouse-cursor: pointer;
        clicked => {
            Player.toggle();
            root.clicked();
        }
    }
    // Play turns into pause as the shape changes: both glyphs stay, one shrinking and
    // turning away as the other turns in.
    Icon {
        width: root.glyph;
        height: root.glyph;
        commands: Icons.play;
        fill: root.on ? Theme.on-accent : Theme.text3;
        stroke: transparent;
        opacity: Player.playing ? 0 : 1;
        transform-scale: Player.playing && Theme.moving ? 0.6 : 1.0;
        transform-rotation: Player.playing && Theme.moving ? 90deg : 0deg;
        animate opacity { duration: Theme.t-fast; easing: Curves.ease-out; }
        animate transform-scale, transform-rotation { duration: Theme.t-morph; easing: Curves.morph; }
    }
    Icon {
        width: root.glyph;
        height: root.glyph;
        commands: Icons.pause;
        fill: root.on ? Theme.on-accent : Theme.text3;
        stroke: transparent;
        opacity: Player.playing ? 1 : 0;
        transform-scale: Player.playing || !Theme.moving ? 1.0 : 0.6;
        transform-rotation: Player.playing || !Theme.moving ? 0deg : -90deg;
        animate opacity { duration: Theme.t-fast; easing: Curves.ease-out; }
        animate transform-scale, transform-rotation { duration: Theme.t-morph; easing: Curves.morph; }
    }
}

export component Display inherits Text {
    font-family: Theme.display-font;
    font-weight: 700;
    color: Theme.text1;
    letter-spacing: self.font-size * Theme.display-tracking;
    overflow: elide;
}

export component Body inherits Text {
    font-family: Theme.body-font;
    font-size: Theme.t-body;
    color: Theme.text1;
    overflow: elide;
}

// A page title in the display face (40 px).
export component PageTitle inherits Display {
    height: 48px;
    font-size: Theme.t-display-l;
    vertical-alignment: center;
}

export component ShelfTitle inherits Display {
    font-size: Theme.t-display-s;
    height: 32px;
    vertical-alignment: center;
}

// A vertical gradient from `top` to `bottom` as `count` solid bands, in whole physical pixels
// so neighbours meet without a seam. Skia fills a gradient pixel by pixel, at several times
// the cost of a solid fill, and a strip that content scrolls under is filled again every
// frame: the scrims and fades over scrolling pages cost a 4K frame up to ~1.3 ms as
// gradients (measured 2026-10-31). Use it for anything a list scrolls under; enough
// bands for a level or so between neighbours look the same as the gradient.
export component Bands inherits Rectangle {
    in property <color> top;
    in property <color> bottom;
    in property <int> count: 24;
    for i in root.count: Rectangle {
        y: Math.round(root.height * i / root.count / 1phx) * 1phx;
        height: Math.round(root.height * (i + 1) / root.count / 1phx) * 1phx - self.y;
        // At the band's middle: `top` at 0, `bottom` at 1.
        background: root.bottom.mix(root.top, (i + 0.5) / root.count);
    }
}

// A cover with a hairline edge, so pale art keeps its shape on light and black art on dark.
// Empty (no art, or not loaded yet): a quiet note glyph (a person when `round`) on the empty
// tile; art fades in over it. `crossfade` (bar, menu header, Now playing, Home hero): a
// new source dissolves over the old one instead of replacing it.
// Art whose pixels aren't the cover's physical pixels (cards and tiles are fluid, their art is
// decoded at a fixed size) draws through a cached layer at the cover's size, rounded corners and
// all: a frame copies the layer instead of resampling the art through a rounded clip, which cost
// a 4K Home scroll frame 10 ms. The layer lives as long as the cover, so long lists of such
// covers belong in a `ListView` (Home, `CardGrid`), which drops what's scrolled away.
// The fade in is the layer's own opacity, outside it, so the layer is drawn once and blended
// as it fades (the renderer's change 12); a fade inside it drew it again in every frame, and a
// page of cards fading in at once cost ~15 ms a 4K frame (`tests/app/content_fade.rs`).
export component Cover inherits Rectangle {
    in property <image> source;
    in property <length> radius: Theme.r-m;
    in property <bool> round: false;
    in property <bool> crossfade: false;
    // Off where the cover draws its own glyph (the Liked songs tile).
    in property <bool> placeholder: true;
    // May take a layer. Off for a cover out of sight in a clipped row (a shelf's other
    // pages): Slint draws a layer even where it's clipped away, so each one off the page
    // would still cost its whole draw when its row enters.
    in property <bool> layered: true;
    // The art underneath while a crossfade runs, the art last shown, and whether the top
    // layer has settled.
    property <image> under;
    property <image> last;
    property <bool> settled: true;
    border-radius: root.round ? self.width / 2 : root.radius;
    // The empty tile, until the art covers it: opaque art over it would only cost a rounded
    // fill per cover per frame.
    background: root.source.width > 0 && root.settled && art.opacity >= 1 && top.opacity >= 1 ? transparent : Theme.cover-empty;
    // Only a crossfade needs the art last shown: kept in any other cover, it would hold its
    // first image for as long as the cover lives, after the app has let it go.
    init => {
        if root.crossfade {
            root.last = root.source;
        }
    }
    changed source => {
        if root.crossfade {
            // The art that was showing stays below; the new one starts clear and fades in.
            root.under = root.last;
            root.last = root.source;
            root.settled = false;
            settle.running = true;
        }
    }
    // One tick later, so the snap to clear lands before the fade starts.
    settle := Timer {
        interval: 1ms;
        running: false;
        triggered => {
            self.running = false;
            root.settled = true;
        }
    }
    if root.placeholder && root.source.width == 0 && root.under.width == 0: Icon {
        width: Math.round(root.width * 0.4 / 1px) * 1px;
        height: self.width;
        commands: root.round ? Icons.person : Icons.note;
        stroke: Theme.text3;
        stroke-width: max(1.2px, self.width / 24 * 1.6);
        opacity: 0.6;
    }
    // The empty tile's edge, until the art's own covers it.
    Rectangle {
        visible: art.opacity < 1;
        border-radius: parent.border-radius;
        border-width: 1px;
        border-color: Theme.cover-edge;
    }
    art := Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: parent.border-radius;
        clip: true;
        // `layered` last: a cover without art never depends on it, so a change to it repaints nothing.
        cache-rendering-hint: root.source.width > 0 && abs(root.source.width * 1phx - root.width) > 0.01px && root.layered;
        // A plain cover fades its art in as a whole; a crossfade fades `top` over `under` in it.
        opacity: root.crossfade || root.source.width > 0 ? 1 : 0;
        animate opacity { duration: Theme.t-fast; easing: Curves.ease-hover; }
        if root.crossfade && root.under.width > 0 && root.source.width > 0: Image {
            width: parent.width;
            height: parent.height;
            source: root.under;
            image-fit: cover;
        }
        top := Image {
            width: parent.width;
            height: parent.height;
            source: root.source;
            image-fit: cover;
            opacity: !root.crossfade || (root.source.width > 0 && root.settled) ? 1 : 0;
            animate opacity {
                duration: root.settled ? Theme.t-cover : 0ms;
                easing: Curves.ease-hover;
            }
        }
        Rectangle {
            border-radius: parent.border-radius;
            border-width: 1px;
            border-color: Theme.cover-edge;
        }
    }
}

// The playing mark's clock (the wave, chosen 2026-10-30). One `Timer` in `AppWindow`
// steps `frame` 30 times a second while sound plays and the window shows, and nothing is
// armed when paused, stopped, loading, minimized, hidden in the tray or with reduced motion.
// Only a live `PlayingMark` reads `frame`, so only the current track's marks repaint, each one
// small rectangle (one `Path`), and only where they're on screen.
export global Mark {
    in-out property <int> frame;
    out property <int> fps: 30;
    out property <duration> step: floor(1000 / root.fps) * 1ms;
    // One cycle of the wave's travel and of its swell, in seconds.
    out property <float> period: 1.6;
    // Points along the wave, past its first.
    out property <int> segments: 12;
    // The wave's swell at `t` seconds: its amplitude, of the most it may take. At rest
    // (`t` < 0) a still, middling wave.
    public pure function swell(t: float) -> float {
        return t < 0 ? 0.6 : 0.62 + 0.38 * Math.sin(t / root.period * 360deg);
    }
    // Point `i`'s height, -1 to 1: one and a half wavelengths travelling right, pinned at both
    // ends (the sine envelope), swelling and settling.
    public pure function wave(i: int, t: float) -> float {
        return Mark.swell(t) * Math.sin(i / root.segments * 180deg) * Math.sin((i / root.segments * 1.5 - (t < 0 ? 0.15 : t) / (root.period / 2)) * 360deg);
    }
    // " L x y" for point `i` in a `w` x `h` viewbox: the wave spans the middle 76 % of the
    // width and swings up to 32 % of the height either side of the middle.
    pure function at(i: int, w: float, h: float, t: float) -> string {
        return " L \{w * 0.12 + i * w * 0.76 / root.segments} \{h / 2 - h * 0.32 * Mark.wave(i, t)}";
    }
    // The wave's path in a `w` x `h` viewbox at `t` seconds (no loops in Slint functions).
    public pure function path(w: float, h: float, t: float) -> string {
        return "M \{w * 0.12} \{h / 2}" + Mark.at(1, w, h, t) + Mark.at(2, w, h, t) + Mark.at(3, w, h, t) + Mark.at(4, w, h, t) + Mark.at(5, w, h, t) + Mark.at(6, w, h, t) + Mark.at(7, w, h, t) + Mark.at(8, w, h, t) + Mark.at(9, w, h, t) + Mark.at(10, w, h, t) + Mark.at(11, w, h, t) + Mark.at(12, w, h, t);
    }
}

// The playing mark: one accent stroke, a short wave travelling through the mark while the
// current track is audible and motion is on. Paused, loading, or with Windows' animation
// effects off, it rests as a still wave, which still says "this one". The viewbox is the
// mark's own pixels, so the stroke stays 2 px at any size.
export component PlayingMark inherits Rectangle {
    // From 0 (gone) to 1, through the stroke's colour (see IconButton.fade).
    in property <float> fade: 1.0;
    width: 20px;
    height: 20px;
    property <bool> live: Player.playing && !Player.loading && Theme.moving;
    // Seconds into the wave, or -1 at rest. Read only while live, so a resting mark doesn't
    // depend on the clock at all.
    property <float> t: root.live ? Mark.frame / Mark.fps : -1;
    accessible-role: image;
    accessible-label: Player.playing ? @tr("Playing") : @tr("Paused");
    Path {
        width: root.width;
        height: root.height;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: root.width / 1px;
        viewbox-height: root.height / 1px;
        stroke: Theme.accent.transparentize(1 - root.fade);
        stroke-width: 2px;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: transparent;
        commands: Mark.path(root.width / 1px, root.height / 1px, root.t);
    }
}

// Over a song row's cover: hovering shows play, and clicking plays the row (`play`); on the
// current track's row it shows pause or play and toggles the player. `mark`: the current
// track's cover also rests under a deep veil with the playing mark (the lists; `SongRow` marks
// its row at the right instead). Put it inside the row's TouchArea, over the cover, so
// hovering it keeps the row hovered.
export component CoverPlay inherits TouchArea {
    in property <bool> current;
    in property <bool> mark: true;
    in property <length> radius: Theme.r-s;
    // For screen readers.
    in property <string> title;
    callback play();
    // A right-click here, in window coordinates: the row's song menu.
    callback right-clicked(length, length);
    property <bool> resting: root.current && root.mark;
    property <bool> pause: root.current && Player.playing;
    mouse-cursor: pointer;
    accessible-role: button;
    accessible-label: root.pause ? @tr("Pause {}", root.title) : @tr("Play {}", root.title);
    accessible-action-default => { root.activate(); }
    clicked => { root.activate(); }
    pointer-event(e) => {
        if e.button == PointerEventButton.right && e.kind == PointerEventKind.up {
            root.right-clicked(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
        }
    }
    function activate() {
        if root.current {
            Player.toggle();
        } else {
            root.play();
        }
    }
    // The veil fades in with the hover, as the row's own hover does.
    Rectangle {
        border-radius: root.radius;
        background: root.pressed ? Theme.cover-button-pressed : (root.resting ? Theme.cover-playing : Theme.cover-button);
        opacity: root.resting || root.has-hover ? 1 : 0;
        visible: self.opacity > 0;
        animate opacity { duration: Theme.t-hover; easing: Curves.ease-hover; }
        animate background { duration: Theme.t-hover; easing: Curves.ease-hover; }
    }
    if root.resting && !root.has-hover: PlayingMark {
        width: 20px;
        height: 20px;
    }
    // White on the dark veil, over any art in either theme (as the cards' play button).
    Icon {
        width: min(20px, round(root.width / 2 / 1px) * 1px);
        height: self.width;
        commands: root.pause ? Icons.pause : Icons.play;
        fill: #FFFFFF;
        stroke: transparent;
        opacity: root.has-hover ? 1 : 0;
        visible: self.opacity > 0;
        animate opacity { duration: Theme.t-hover; easing: Curves.ease-hover; }
    }
}

// Round icon button with a 36 px target.
export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;            // for screen readers
    // What it does, for screen readers, when the label alone doesn't say.
    in property <string> description;
    in property <color> tint: Theme.text2;
    in property <bool> filled: false;      // filled glyphs (transport)
    in property <length> glyph: 20px;
    in property <bool> active: false;      // toggles: accent glyph
    in property <bool> enabled: true;
    // Below 1, the glyph snaps to this size and eases back to 1 (the like pop).
    in property <float> glyph-scale: 1.0;
    // Shows the button from 0 (gone) to 1; rows fade it with their hover. Set this, never
    // `opacity`: a group opacity on anything with children renders it through a layer as
    // large as the window's repainted area (skia), every frame of a scroll.
    in property <float> fade: 1.0;
    property <float> alpha: (root.enabled ? 1.0 : 0.4) * root.fade;
    out property <bool> hovered: ta.has-hover;
    callback clicked();
    width: 36px;
    height: 36px;
    border-radius: self.width / 2;
    background: (root.enabled ? Theme.state(ta.pressed, ta.has-hover) : transparent).transparentize(1 - root.alpha);
    // Press: a small give, then a short spring back past rest on release.
    transform-scale: ta.pressed ? Theme.press-scale : 1.0;
    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.description;
    accessible-action-default => { root.clicked(); }
    animate background { duration: Theme.t-hover; }
    animate transform-scale {
        duration: ta.pressed ? Theme.t-press : Theme.t-release;
        easing: ta.pressed ? Curves.ease-out : Curves.release;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Icon {
        width: root.glyph;
        height: root.glyph;
        commands: root.icon;
        stroke: (root.filled ? transparent : (root.active ? Theme.accent : root.tint)).transparentize(1 - root.alpha);
        fill: (root.filled ? (root.active ? Theme.accent : root.tint) : transparent).transparentize(1 - root.alpha);
        transform-scale: root.glyph-scale;
        animate transform-scale { duration: root.glyph-scale < 1 ? 0ms : Theme.t-fast; easing: Curves.ease-out; }
    }
}

// Pill button: solid (primary, neutral) or tonal (secondary).
export component Pill inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> solid: false;
    in property <bool> icon-filled: true;
    in property <bool> enabled: true;
    callback clicked();
    height: 40px;
    width: lay.preferred-width;
    border-radius: self.height / 2;
    // Dimmed through each part's colour, not `opacity` (see IconButton.fade).
    property <float> alpha: root.enabled ? 1.0 : 0.4;
    background: (root.solid ? Theme.solid-state(ta.pressed, ta.has-hover) : Theme.tonal(ta.pressed, ta.has-hover)).transparentize(1 - root.alpha);
    // Press: a small give under the pointer, then a spring back on release.
    transform-scale: ta.pressed ? Theme.press-scale : 1.0;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    animate background { duration: Theme.t-hover; }
    animate transform-scale {
        duration: ta.pressed ? Theme.t-press : Theme.t-release;
        easing: ta.pressed ? Curves.ease-out : Curves.release;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    lay := HorizontalLayout {
        padding-left: root.icon == "" ? 20px : 16px;
        padding-right: 20px;
        spacing: 8px;
        alignment: center;
        if root.icon != "": Icon {
            y: (parent.height - self.height) / 2;
            width: 18px;
            height: 18px;
            commands: root.icon;
            fill: (root.icon-filled ? (root.solid ? Theme.on-solid : Theme.text1) : transparent).transparentize(1 - root.alpha);
            stroke: (root.icon-filled ? transparent : (root.solid ? Theme.on-solid : Theme.text1)).transparentize(1 - root.alpha);
        }
        Body {
            text: root.label;
            font-weight: 600;
            color: (root.solid ? Theme.on-solid : Theme.text1).transparentize(1 - root.alpha);
            vertical-alignment: center;
        }
    }
}

// A thin rail with a fill, for progress shown inside pages (the bar has its own seek line).
export component ProgressRail inherits Rectangle {
    in property <float> progress;
    height: 4px;
    border-radius: 2px;
    background: Theme.track;
    Rectangle {
        x: 0;
        width: parent.width * clamp(root.progress, 0, 1);
        border-radius: 2px;
        background: Theme.accent;
    }
}

// Album, artist or playlist card on a shelf or grid. `playable`: hovering shows a round play
// button on the cover that plays without opening (`play`). `art-h`: the art's height when it
// isn't square (Home's 16:9 video tiles); `subtitle: false` leaves only the title (Home's
// artist faces).
export component Card inherits Rectangle {
    in property <CardItem> item;
    in property <length> size;
    in property <length> art-h: root.size;
    in property <bool> subtitle: true;
    in property <bool> playable: false;
    // On its row's visible page: off, the cover takes no layer (see `Cover.layered`).
    in property <bool> on-page: true;
    callback clicked();
    callback play();
    property <bool> button-shown: root.playable && ta.has-hover;
    width: root.size;
    height: root.art-h + Theme.card-text-gap + (root.subtitle ? 40px : 24px);
    accessible-role: button;
    accessible-label: root.item.title;
    accessible-action-default => { root.clicked(); }
    // The art and its hover veil, pressed together.
    Rectangle {
        x: 0;
        y: 0;
        width: root.size;
        height: root.art-h;
        transform-scale: ta.pressed ? Theme.press-scale : 1.0;
        animate transform-scale {
            duration: ta.pressed ? Theme.t-press : Theme.t-release;
            easing: ta.pressed ? Curves.ease-out : Curves.release;
        }
        Cover {
            width: parent.width;
            height: parent.height;
            source: root.item.cover;
            round: root.item.round;
            layered: root.on-page;
        }
        // Over the cover, not in it: inside, every frame of the veil's fade drew the cover's
        // layer again (about 1 ms a frame per card at 4K, while the pointer crossed a shelf).
        Rectangle {
            width: parent.width;
            height: parent.height;
            border-radius: root.item.round ? self.width / 2 : Theme.r-m;
            background: ta.pressed ? Theme.cover-pressed : (ta.has-hover ? Theme.cover-hover : transparent);
            animate background { duration: Theme.t-hover; }
        }
    }
    title := Body {
        y: root.art-h + Theme.card-text-gap;
        width: root.size;
        text: root.item.title;
        font-weight: 600;
        horizontal-alignment: root.item.round ? center : left;
    }
    // The veil can vanish on very dark or pale art; the underlined title shows on any cover.
    if ta.has-hover: Rectangle {
        property <length> w: min(root.size, title.preferred-width);
        x: root.item.round ? (root.size - self.w) / 2 : 0px;
        y: root.art-h + Theme.card-text-gap + 18px;
        width: self.w;
        height: 1px;
        background: Theme.text1;
    }
    if root.subtitle: Body {
        y: root.art-h + Theme.card-text-gap + 20px;
        width: root.size;
        text: root.item.subtitle;
        font-size: Theme.t-meta;
        color: Theme.text2;
        horizontal-alignment: root.item.round ? center : left;
    }
    // Last, so the play button draws over the cover.
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        // Inside the touch area, so hovering the button keeps the card hovered.
        if root.playable: play-button := Rectangle {
            // 8 px from the cover's corner; on a round cover, inside the circle.
            property <length> inset: root.item.round ? root.size * 0.146 : Theme.s2;
            // Fades through each part's colour, not `opacity` (see IconButton.fade).
            property <float> fade: root.button-shown ? 1 : 0;
            x: root.size - self.width - self.inset;
            y: root.art-h - self.height - self.inset;
            width: 40px;
            height: 40px;
            border-radius: self.width / 2;
            background: (pa.pressed ? Theme.cover-button-pressed : (pa.has-hover ? Theme.cover-button-hover : Theme.cover-button)).transparentize(1 - self.fade);
            drop-shadow-blur: 8px;
            drop-shadow-color: #00000040.transparentize(1 - self.fade);
            visible: self.fade > 0;
            transform-scale: !root.button-shown && Theme.moving ? 0.9 : (pa.pressed ? Theme.press-scale : 1.0);
            accessible-role: button;
            accessible-label: @tr("Play {}", root.item.title);
            accessible-action-default => { root.play(); }
            animate fade { duration: Theme.t-fast; easing: Curves.ease-out; }
            animate transform-scale {
                duration: pa.pressed ? Theme.t-press : Theme.t-release;
                easing: pa.pressed ? Curves.ease-out : Curves.release;
            }
            animate background { duration: Theme.t-hover; }
            pa := TouchArea {
                enabled: root.button-shown;
                mouse-cursor: pointer;
                clicked => { root.play(); }
            }
            Icon {
                width: 20px;
                height: 20px;
                commands: Icons.play;
                fill: #FFFFFF.transparentize(1 - play-button.fade);
                stroke: transparent;
            }
        }
    }
}

// Song row with a cover: queue, quick picks, search results.
export component SongRow inherits Rectangle {
    in property <TrackRow> track;
    in property <bool> show-duration: true;
    in property <length> cover-size: Theme.row-cover;
    in property <bool> selected: false;
    // Right-click and a menu button on hover ask for the song menu.
    in property <bool> menu: false;
    callback clicked();
    callback double-clicked();
    // The play button on the cover (as the row's click or double-click does). On the current
    // track the button pauses and resumes instead.
    callback play();
    // Window coordinates for the menu: where it opens down from, and where it ends upward.
    callback menu-requested(length, length, length);
    property <bool> menu-shown: root.menu && ta.has-hover;
    height: Theme.row-h;
    border-radius: Theme.r-m;
    HoverIntent {
        hovered: ta.has-hover && !root.selected && !root.track.playing;
        pressed: ta.pressed || cover-play.pressed;
        id: root.track.id;
    }
    // The selected row (the current track in Up next) isn't a button; the playing row rests
    // on a light tile, hover and press over it.
    background: root.selected ? Theme.selected : (root.track.playing ? Theme.playing-row : transparent);
    accessible-role: list-item;
    accessible-label: root.track.title + ", " + root.track.artist;
    Rectangle {
        border-radius: parent.border-radius;
        background: root.selected ? transparent : Theme.state(ta.pressed, ta.has-hover);
        animate background { duration: Theme.t-hover; easing: Curves.ease-hover; }
    }
    // Under the touch area, so the play button inside it draws over the art.
    Cover {
        x: 8px;
        y: (parent.height - self.height) / 2;
        width: root.cover-size;
        height: root.cover-size;
        radius: Theme.r-s;
        source: root.track.cover;
    }
    ta := TouchArea {
        mouse-cursor: root.selected ? MouseCursor.default : MouseCursor.pointer;
        clicked => { root.clicked(); }
        double-clicked => { root.double-clicked(); }
        pointer-event(e) => {
            if root.menu && e.button == PointerEventButton.right && e.kind == PointerEventKind.up {
                root.menu-requested(root.absolute-position.x + self.mouse-x, root.absolute-position.y + self.mouse-y, root.absolute-position.y + self.mouse-y);
            }
        }
        // Inside the touch area, so hovering the buttons keeps the row hovered.
        cover-play := CoverPlay {
            x: 8px;
            y: (parent.height - self.height) / 2;
            width: root.cover-size;
            height: root.cover-size;
            current: root.track.playing;
            mark: false;
            title: root.track.title;
            play => { root.play(); }
            right-clicked(x, y) => {
                if root.menu {
                    root.menu-requested(x, y, y);
                }
            }
        }
        // It fades in and out with the hover.
        if root.menu: IconButton {
            x: parent.width - self.width - 4px;
            y: (parent.height - self.height) / 2;
            icon: Icons.more;
            label: @tr("More");
            filled: true;
            enabled: root.menu-shown;
            fade: root.menu-shown ? 1 : 0;
            visible: self.fade > 0;
            animate fade { duration: Theme.t-hover; easing: Curves.ease-hover; }
            clicked => {
                root.menu-requested(self.absolute-position.x + self.width - 4px, self.absolute-position.y + self.height, root.absolute-position.y);
            }
        }
    }
    VerticalLayout {
        x: 8px + root.cover-size + 12px;
        width: parent.width - self.x - (root.show-duration ? 64px : 8px);
        alignment: center;
        spacing: 1px;
        Body {
            text: root.track.title;
            font-weight: 600;
            color: Theme.text1;
        }
        Body {
            text: root.track.artist;
            font-size: Theme.t-meta;
            color: Theme.text2;
        }
    }
    // Under the menu button: they fade out as it fades in.
    if root.show-duration && !root.track.playing: Body {
        x: parent.width - self.width - 12px;
        height: parent.height;
        text: root.track.duration;
        font-size: Theme.t-meta;
        color: Theme.text3;
        vertical-alignment: center;
        opacity: root.menu-shown ? 0 : 1;
        animate opacity { duration: Theme.t-hover; easing: Curves.ease-hover; }
    }
    if root.track.playing: PlayingMark {
        x: parent.width - self.width - 12px;
        width: 18px;
        height: 18px;
        fade: root.menu-shown ? 0 : 1;
        animate fade { duration: Theme.t-hover; easing: Curves.ease-hover; }
    }
}

// Numbered track row (album, playlist): number, title, artist (compilations only), like and
// menu on hover, duration.
export component TrackListRow inherits Rectangle {
    in property <TrackRow> track;
    in property <bool> compilation: false;
    callback clicked();
    callback double-clicked();
    callback like-clicked();
    callback menu-clicked();
    // Right-click, at this point of the row (the song menu).
    callback context-menu(length, length);
    property <length> artist-w: root.compilation ? 240px : 0px;
    property <bool> hovered: ta.has-hover;
    // Album rows have no cover: 48 px.
    height: Theme.track-row-h;
    border-radius: Theme.r-m;
    property <bool> cell-hovered: cell.has-hover;
    function play-cell() {
        if root.track.playing {
            Player.toggle();
        } else {
            root.double-clicked();
        }
    }
    HoverIntent {
        hovered: root.hovered && !root.track.playing;
        pressed: ta.pressed || cell.pressed;
        id: root.track.id;
    }
    // The playing row rests on a light tile; hover and press go over it.
    background: root.track.playing ? Theme.playing-row : transparent;
    accessible-role: list-item;
    accessible-label: root.track.title;
    Rectangle {
        border-radius: parent.border-radius;
        background: Theme.state(ta.pressed || cell.pressed, root.hovered);
        animate background { duration: Theme.t-hover; easing: Curves.ease-hover; }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        double-clicked => { root.double-clicked(); }
        pointer-event(e) => {
            if e.button == PointerEventButton.right && e.kind == PointerEventKind.up {
                root.context-menu(self.mouse-x, self.mouse-y);
            }
        }
        // Inside the touch area, so hovering the buttons keeps the row hovered.
        // The number cell: hovering it swaps the number (or the mark) for play, and clicking
        // plays the row as a double-click does; on the current track, pause or play toggles.
        // Centred where the mark sits.
        cell := TouchArea {
            x: 12px;
            width: 48px;
            mouse-cursor: pointer;
            accessible-role: button;
            accessible-label: root.track.playing && Player.playing ? @tr("Pause {}", root.track.title) : @tr("Play {}", root.track.title);
            accessible-action-default => { root.play-cell(); }
            clicked => { root.play-cell(); }
            // The row's right-click, which this cell would otherwise swallow.
            pointer-event(e) => {
                if e.button == PointerEventButton.right && e.kind == PointerEventKind.up {
                    root.context-menu(self.x + self.mouse-x, self.mouse-y);
                }
            }
            if self.has-hover: Icon {
                width: 18px;
                height: 18px;
                commands: root.track.playing && Player.playing ? Icons.pause : Icons.play;
                fill: Theme.text1;
                stroke: transparent;
            }
        }
        // They stay instantiated and fade with the hover.
        IconButton {
            property <bool> shown: root.hovered || root.track.liked;
            x: parent.width - 140px;
            y: (parent.height - self.height) / 2;
            icon: Icons.heart;
            label: root.track.liked ? @tr("Remove like") : @tr("Like");
            filled: root.track.liked;
            tint: root.track.liked ? Theme.text1 : Theme.text2;
            enabled: self.shown;
            fade: self.shown ? 1 : 0;
            visible: self.fade > 0;
            animate fade { duration: Theme.t-hover; easing: Curves.ease-hover; }
            clicked => { root.like-clicked(); }
        }
        IconButton {
            x: parent.width - 44px;
            y: (parent.height - self.height) / 2;
            icon: Icons.more;
            label: @tr("More");
            filled: true;
            enabled: root.hovered;
            fade: root.hovered ? 1 : 0;
            visible: self.fade > 0;
            animate fade { duration: Theme.t-hover; easing: Curves.ease-hover; }
            clicked => { root.menu-clicked(); }
        }
    }
    if !root.track.playing && !root.cell-hovered: Body {
        x: 8px;
        width: 32px;
        height: parent.height;
        text: root.track.index;
        color: Theme.text3;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
    // Centred where a one-digit number sits (right-aligned at 40 px, about 8 px wide).
    if root.track.playing && !root.cell-hovered: PlayingMark {
        x: 27px;
        width: 18px;
        height: 18px;
    }
    Body {
        x: 64px;
        width: parent.width - 64px - 156px - root.artist-w;
        height: parent.height;
        text: root.track.title;
        font-weight: 600;
        color: Theme.text1;
        vertical-alignment: center;
    }
    if root.compilation: Body {
        x: parent.width - 148px - root.artist-w;
        width: root.artist-w - 24px;
        height: parent.height;
        text: root.track.artist;
        color: Theme.text2;
        vertical-alignment: center;
    }
    Body {
        x: parent.width - 92px;
        width: 44px;
        height: parent.height;
        text: root.track.duration;
        color: Theme.text2;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

// Shelf scroll arrows.
export component ShelfArrows inherits Rectangle {
    in property <bool> can-back: false;
    in property <bool> can-forward: true;
    callback back();
    callback forward();
    width: 72px;
    height: 32px;
    for icon[i] in [Icons.chevron-left, Icons.chevron-right]: Rectangle {
        property <bool> on: i == 0 ? root.can-back : root.can-forward;
        x: i * 40px;
        width: 32px;
        height: 32px;
        border-radius: 16px;
        // Dimmed through each part's colour, not `opacity` (see IconButton.fade).
        property <float> alpha: self.on ? 1.0 : 0.45;
        background: (self.on ? Theme.tonal(arrow.pressed, arrow.has-hover) : Theme.selected).transparentize(1 - self.alpha);
        animate background { duration: Theme.t-hover; }
        arrow := TouchArea {
            enabled: parent.on;
            mouse-cursor: pointer;
            clicked => {
                if i == 0 { root.back(); } else { root.forward(); }
            }
        }
        Icon {
            width: 18px;
            height: 18px;
            commands: icon;
            stroke: Theme.text1.transparentize(1 - parent.alpha);
        }
    }
}

// A titled row of cards that pages by a full row; arrows appear only while hovered.
export component Shelf inherits Rectangle {
    in property <string> title;
    in property <[CardItem]> items;
    in property <int> per-row: Theme.cards-per-row;
    // Cards show a play button on hover (`play`); pages wire it per kind.
    in property <bool> playable: false;
    callback open(CardItem);
    callback play(CardItem);
    property <length> card: floor((self.width - (root.per-row - 1) * Theme.card-gap) / root.per-row / 1px) * 1px;
    property <int> first: 0;
    // The card at the left edge. Paging is an on-screen move, so it eases in-out over
    // 280 ms; the cards follow it, so a resize moves them at once.
    property <float> at: root.first;
    animate at { duration: Theme.moving ? Theme.t-panel + 40ms : 0ms; easing: Curves.ease-in-out; }
    property <int> last-first: max(0, root.items.length - root.per-row);
    height: 48px + root.card + Theme.card-text-gap + 40px;
    hover := TouchArea {
        ShelfTitle {
            x: 0;
            y: 0;
            width: parent.width - 88px;
            text: root.title;
        }
        if hover.has-hover && root.items.length > root.per-row: ShelfArrows {
            x: parent.width - self.width;
            y: 0;
            can-back: root.first > 0;
            can-forward: root.first < root.last-first;
            back => { root.first = max(0, root.first - root.per-row); }
            forward => { root.first = min(root.last-first, root.first + root.per-row); }
        }
        Rectangle {
            y: 48px;
            height: parent.height - 48px;
            clip: true;
            for it[i] in root.items: Card {
                x: (i - root.at) * (root.card + Theme.card-gap);
                y: 0;
                size: root.card;
                item: it;
                playable: root.playable;
                clicked => { root.open(it); }
                play => { root.play(it); }
            }
        }
    }
}

// Pill tabs, a segmented control: equal segments across the width, the active one on the
// accent's tonal fill. The pill glides to a newly picked tab (`Curves.glide` over `t-morph`):
// one eased value, `at`, the pill's place counted in tabs (an index, not `x`, so a resize moves
// it at once). Everything that moves follows from it: the pill's `x`, its slight stretch on the
// way, and how lit each label is, so the labels light up as the pill reaches them rather than
// on a timer of their own. It repaints only the tab row, and nothing runs once it's there
// (`tests/tab_pill.rs`).
export component Tabs inherits Rectangle {
    in property <[string]> labels;
    in property <int> active;
    callback selected(int);
    property <length> seg-w: self.width / max(1, root.labels.length);
    property <float> at: root.active;
    animate at { duration: Theme.t-morph; easing: Curves.glide; }
    // How far the pill is between two tabs: 0 on one, 1 halfway. It stretches by up to 8 %
    // of a segment there, both edges at once, and is its own width again on arrival.
    property <float> part: root.at - floor(root.at);
    property <length> stretch: 4 * root.part * (1 - root.part) * 0.08 * root.seg-w;
    height: 40px;
    border-radius: self.height / 2;
    background: Theme.hover;
    // The active pill, under the labels.
    Rectangle {
        x: root.at * root.seg-w + 4px - root.stretch / 2;
        y: 4px;
        width: root.seg-w - 8px + root.stretch;
        height: parent.height - 8px;
        border-radius: self.height / 2;
        background: Theme.accent-tonal;
    }
    for label[i] in root.labels: Rectangle {
        property <bool> on: i == root.active;
        x: i * root.seg-w + 4px;
        y: 4px;
        width: root.seg-w - 8px;
        height: parent.height - 8px;
        border-radius: self.height / 2;
        // Hover and press over the segment; the active one only darkens its pill.
        background: self.on ? (tta.pressed ? Theme.hover : transparent) : Theme.state(tta.pressed, tta.has-hover);
        transform-scale: tta.pressed ? Theme.press-scale : 1.0;
        accessible-role: tab;
        accessible-label: label;
        accessible-action-default => { root.selected(i); }
        animate background { duration: Theme.t-hover; }
        animate transform-scale {
            duration: tta.pressed ? Theme.t-press : Theme.t-release;
            easing: tta.pressed ? Curves.ease-out : Curves.release;
        }
        tta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.selected(i); }
        }
        // Lit by the pill as much as it covers this segment, or by the hover (which eases
        // on its own, over `t-hover`).
        property <float> hovered: tta.has-hover ? 1 : 0;
        animate hovered { duration: Theme.t-hover; easing: Curves.ease-hover; }
        Body {
            text: label;
            font-weight: 600;
            color: Theme.text1.mix(Theme.text2, max(parent.hovered, 1 - min(1, abs(root.at - i))));
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: clip;
        }
    }
}

// Placeholder body for pages still to be built: the title, plus what was asked for.
export component PageStub inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    PageTitle {
        x: Theme.page-pad;
        y: Theme.page-top;
        width: parent.width - 2 * Theme.page-pad;
        text: root.title;
    }
    if root.detail != "": Body {
        x: Theme.page-pad;
        y: Theme.page-top + 56px;
        width: parent.width - 2 * Theme.page-pad;
        height: 20px;
        text: root.detail;
        color: Theme.text3;
        vertical-alignment: center;
    }
}
