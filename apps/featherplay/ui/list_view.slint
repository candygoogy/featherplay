// `ListView`: std-widgets' (the fluent style's ScrollView and ListView, Slint 1.18.1), the
// same look and behaviour, with its two scroll bars as one shared component.
//
// Slint copies a component into each place it's used when its root is shown or hidden by a
// binding, and the fluent scroll bar's is: every ListView carried two whole bars
// (track, thumb, both arrow buttons, their states and animations), about twenty times over.
// Here each bar sits in `Bar`, whose root is plain, so the bars are compiled once. The
// compiler virtualises a `for` in any component named `ListView` that has the content and
// visible size properties, as it does std-widgets' own.
//
// The arrows are the fluent style's (its `scrollbar` SVGs, as paths). Adapted from Slint's sources,
// under the same licence (GPL-3.0-only OR LicenseRef-Slint-Royalty-free-2.0 OR
// LicenseRef-Slint-Software-3.0, Copyright © SixtyFPS GmbH).
import { Palette } from "std-widgets.slint";

// The fluent palette's values the bars use; `Palette.background` is #1C1C1C exactly when
// the fluent style is dark.
global BarColours {
    out property <bool> dark: Palette.background == #1C1C1C;
    out property <brush> text-secondary: BarColours.dark ? #FFFFFFC9 : #00000099;
}

// The fluent style's scroll bar arrows.
global Arrows {
    out property <string> up: "M0.992188 6C0.854167 6 0.72526 5.97396 0.605469 5.92188C0.485677 5.86719 0.380208 5.79557 0.289062 5.70703C0.200521 5.61589 0.130208 5.51042 0.078125 5.39062C0.0260417 5.26823 0 5.13802 0 5C0 4.89062 0.0143229 4.79036 0.0429688 4.69922C0.0742188 4.60807 0.119792 4.51823 0.179688 4.42969L2.78125 0.644531C2.84896 0.545573 2.92839 0.458333 3.01953 0.382812C3.11068 0.307292 3.20833 0.244792 3.3125 0.195312C3.41927 0.143229 3.53125 0.104167 3.64844 0.078125C3.76562 0.0520833 3.88281 0.0390625 4 0.0390625C4.11719 0.0390625 4.23438 0.0520833 4.35156 0.078125C4.46875 0.104167 4.57943 0.143229 4.68359 0.195312C4.79036 0.244792 4.88932 0.307292 4.98047 0.382812C5.07161 0.458333 5.15104 0.545573 5.21875 0.644531L7.82031 4.42969C7.88021 4.51823 7.92448 4.60807 7.95312 4.69922C7.98438 4.79036 8 4.89062 8 5C8 5.13802 7.97396 5.26823 7.92188 5.39062C7.86979 5.51042 7.79948 5.61589 7.71094 5.70703C7.6224 5.79557 7.51693 5.86719 7.39453 5.92188C7.27474 5.97396 7.14714 6 7.01172 6H0.992188Z";
    out property <string> down: "M0 1C0 0.864583 0.0260417 0.735677 0.078125 0.613281C0.130208 0.490885 0.200521 0.385417 0.289062 0.296875C0.380208 0.205729 0.485677 0.134115 0.605469 0.0820312C0.72526 0.0273438 0.854167 0 0.992188 0H7.01172C7.14714 0 7.27474 0.0260417 7.39453 0.078125C7.51693 0.130208 7.6224 0.201823 7.71094 0.292969C7.79948 0.384115 7.86979 0.490885 7.92188 0.613281C7.97396 0.733073 8 0.860677 8 0.996094C8 1.10547 7.98438 1.20573 7.95312 1.29688C7.92448 1.38802 7.88021 1.47917 7.82031 1.57031L5.21875 5.35547C5.08073 5.55599 4.90365 5.71354 4.6875 5.82812C4.47396 5.94271 4.24479 6 4 6C3.75521 6 3.52474 5.94271 3.30859 5.82812C3.09505 5.71354 2.91927 5.55599 2.78125 5.35547L0.179688 1.57031C0.119792 1.48177 0.0742188 1.39193 0.0429688 1.30078C0.0143229 1.20964 0 1.10938 0 1Z";
    out property <string> left: "M0 4C0 3.75521 0.0572917 3.52604 0.171875 3.3125C0.286458 3.09635 0.44401 2.91927 0.644531 2.78125L4.42969 0.179687C4.51823 0.119792 4.60807 0.0755208 4.69922 0.046875C4.79036 0.015625 4.89062 0 5 0C5.13542 0 5.26432 0.0260417 5.38672 0.078125C5.50911 0.130208 5.61458 0.201823 5.70312 0.292969C5.79427 0.38151 5.86589 0.485677 5.91797 0.605469C5.97266 0.72526 6 0.854167 6 0.992187L6 7.00781C6 7.14583 5.97266 7.27474 5.91797 7.39453C5.86589 7.51432 5.79427 7.61979 5.70313 7.71094C5.61458 7.79948 5.50911 7.86979 5.38672 7.92187C5.26432 7.97396 5.13542 8 5 8C4.79427 8 4.60417 7.9401 4.42969 7.82031L0.644531 5.21875C0.44401 5.08073 0.286458 4.90495 0.171875 4.69141C0.0572917 4.47526 0 4.24479 0 4Z";
    out property <string> right: "M0 7.00781L0 0.992187C0 0.854167 0.0260417 0.72526 0.078125 0.605469C0.132812 0.485677 0.204427 0.38151 0.292969 0.292969C0.384115 0.201823 0.489583 0.130208 0.609375 0.078125C0.731771 0.0260417 0.861979 0 1 0C1.20573 0 1.39583 0.0598958 1.57031 0.179687L5.35547 2.78125C5.55859 2.92187 5.71615 3.09896 5.82813 3.3125C5.94271 3.52604 6 3.75521 6 4C6 4.24479 5.94271 4.47396 5.82813 4.6875C5.71615 4.90104 5.55859 5.07812 5.35547 5.21875L1.57031 7.82031C1.39583 7.9401 1.20573 8 1 8C0.861979 8 0.731771 7.97396 0.609375 7.92188C0.489583 7.86979 0.384115 7.79948 0.292969 7.71094C0.204427 7.61979 0.132813 7.51432 0.078125 7.39453C0.0260417 7.27474 0 7.14583 0 7.00781Z";
}

component ScrollViewButton inherits TouchArea {
    // The arrow's path, on an 8 x 6 grid (6 x 8 when `horizontal`).
    in property <string> arrow;
    in property <bool> horizontal;

    width: root.horizontal ? 6px : 8px;
    height: root.horizontal ? 8px : 6px;

    // The fluent arrows were white at 0.5442 opacity under the image's colorize: the fill is
    // the colour at that share of its alpha.
    icon := Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: parent.width;
        height: self.width * (root.horizontal ? 8 / 6 : 6 / 8);
        viewbox-width: root.horizontal ? 6 : 8;
        viewbox-height: root.horizontal ? 8 : 6;
        commands: root.arrow;
        fill: Palette.border.transparentize(0.4558);

        animate fill, opacity { duration: 150ms; }
        animate width, height { duration: 150ms; easing: ease-out; }
    }

    states [
        pressed when root.pressed : {
            opacity: 1;
            icon.width: root.width - 2px;
        }
        hover when root.has-hover : {
            opacity: 1;
            icon.fill: BarColours.text-secondary.transparentize(0.4558);
        }
    ]
}

component ScrollBar inherits Rectangle {
    in-out property <bool> horizontal;
    in-out property <length> maximum;
    in-out property <length> page-size;
    in-out property <length> value;
    in property <ScrollBarPolicy> policy: ScrollBarPolicy.as-needed;
    in property <bool> enabled;

    callback scrolled();

    property <length> offset: 16px;
    property <length> size: 2px;
    property <length> track-size: root.horizontal ? root.width - 2 * root.offset : root.height - 2 * offset;
    property <length> step-size: 10px;

    border-width: 1px;
    border-radius: 7px;
    visible: (self.policy == ScrollBarPolicy.always-on) || (self.policy == ScrollBarPolicy.as-needed && self.maximum > 0);
    clip: true;

    states [
        hover when touch-area.has-hover || down-scroll-button.has-hover || up-scroll-button.has-hover : {
            root.background: Palette.alternate-background;
            root.size: 6px;
            up-scroll-button.opacity: 1;
            down-scroll-button.opacity: 1;
        }
    ]

    animate size { duration: 150ms; easing: ease-out; }

    thumb := Rectangle {
        width: !root.horizontal ? root.size : root.maximum <= 0phx ? 0phx : max(min(16px, root.width), root.track-size * root.page-size / (root.maximum + root.page-size));
        height: root.horizontal ? root.size : root.maximum <= 0phx ? 0phx : max(min(16px, root.height), root.track-size * (root.page-size / (root.maximum + root.page-size)));
        x: !root.horizontal ? parent.width - 4px - self.width : root.offset + (root.track-size - thumb.width) * (-root.value / root.maximum);
        y: root.horizontal ? parent.height - 4px - self.height : root.offset + (root.track-size - thumb.height) * (-root.value / root.maximum);
        border-radius: (root.horizontal ? self.height : self.width) / 2;
        background: Palette.border;

        animate width, height { duration: 150ms; easing: ease-out; }
    }

    touch-area := TouchArea {
        property <{pressed-value: length, maximum: length, x:length, y: length}> saved-values;

        width: parent.width;
        height: parent.height;

        function update-saved-values() {
            self.saved-values = { pressed-value: -root.value, maximum: root.maximum, x: self.mouse-x, y: self.mouse-y };
        }

        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                self.update-saved-values();
            }
        }

        moved => {
            if (self.enabled && self.pressed) {
                // Update reference points when the size of the viewport changes to
                // avoid 'jumping' during scrolling.
                // This happens when height estimate of a ListView changes after
                // new items are loaded.
                if (self.saved-values.maximum != root.maximum) {
                    self.update-saved-values();
                }

                root.value = -max(0px, min(root.maximum, self.saved-values.pressed-value + (
                    root.horizontal ? (self.mouse-x - self.saved-values.x) * (root.maximum / (root.track-size - thumb.width))
                               : (self.mouse-y - self.saved-values.y) * (root.maximum / (root.track-size - thumb.height))
                )));
                root.scrolled();
            }
        }

        scroll-event(event) => {
            if (root.horizontal && event.delta-x != 0) {
                root.value = max(-root.maximum, min(0px, root.value + event.delta-x));
                return accept;
            } else if (!root.horizontal && event.delta-y != 0) {
                root.value = max(-root.maximum, min(0px, root.value + event.delta-y));
                return accept;
            }
            reject
        }
    }

    up-scroll-button := ScrollViewButton {
        opacity: 0;
        x: !root.horizontal ? (parent.width - self.width) / 2 : 4px;
        y: root.horizontal ? (parent.height - self.height) / 2 : 4px;
        arrow: root.horizontal ? Arrows.left : Arrows.up;
        horizontal: root.horizontal;

        clicked => {
            root.value = min(0px, root.value + root.step-size);
        }
    }

    down-scroll-button := ScrollViewButton {
        opacity: 0;
        x: !root.horizontal ? (parent.width - self.width) / 2 : root.width - self.width - 4px;
        y: root.horizontal ? (parent.height - self.height) / 2 : root.height - self.height - 4px;
        arrow: root.horizontal ? Arrows.right : Arrows.down;
        horizontal: root.horizontal;

        clicked => {
            root.value = max(-root.maximum, root.value - root.step-size);
        }
    }
}

// A scroll bar in a plain root, so it's one shared component.
component Bar {
    in property <bool> horizontal;
    in property <length> maximum;
    in property <length> page-size;
    in-out property <length> value;
    in property <ScrollBarPolicy> policy: ScrollBarPolicy.as-needed;
    in property <bool> enabled;
    out property <bool> shown: bar.visible;

    callback scrolled();

    bar := ScrollBar {
        width: root.width;
        height: root.height;
        horizontal: root.horizontal;
        maximum: root.maximum;
        page-size: root.page-size;
        value <=> root.value;
        policy: root.policy;
        enabled: root.enabled;

        scrolled => { root.scrolled(); }
    }
}

export component ListView {
    in property <bool> enabled: true;
    out property <length> visible-width <=> flickable.width;
    out property <length> visible-height <=> flickable.height;
    in-out property <length> content-width <=> flickable.content-width;
    in-out property <length> content-height <=> flickable.content-height;
    in-out property <length> content-x <=> flickable.content-x;
    in-out property <length> content-y <=> flickable.content-y;
    in property <ScrollBarPolicy> vertical-scrollbar-policy <=> vertical-bar.policy;
    in property <ScrollBarPolicy> horizontal-scrollbar-policy <=> horizontal-bar.policy;
    in property <bool> mouse-drag-pan-enabled <=> flickable.mouse-drag-pan-enabled;

    callback scrolled <=> flickable.flicked;

    min-height: 50px;
    min-width: 50px;
    horizontal-stretch: 1;
    vertical-stretch: 1;
    preferred-height: 100%;
    preferred-width: 100%;
    accessible-role: list;
    accessible-orientation: Orientation.vertical;

    flickable := Flickable {
        mouse-drag-pan-enabled: false;
        content-y <=> vertical-bar.value;
        content-x <=> horizontal-bar.value;
        width: parent.width;
        height: parent.height;

        @children
    }

    vertical-bar := Bar {
        enabled: root.enabled;
        width: 14px;
        x: flickable.width + flickable.x - self.width;
        y: flickable.y;
        height: horizontal-bar.shown ? parent.height - horizontal-bar.height : parent.height;
        horizontal: false;
        maximum: flickable.content-height - flickable.height;
        page-size: flickable.height;

        scrolled => { root.scrolled(); }
    }

    horizontal-bar := Bar {
        enabled: root.enabled;
        width: vertical-bar.shown ? parent.width - vertical-bar.width : parent.width;
        height: 14px;
        y: flickable.height + flickable.y - self.height;
        x: flickable.x;
        horizontal: true;
        maximum: flickable.content-width - flickable.width;
        page-size: flickable.width;

        scrolled => { root.scrolled(); }
    }
}
