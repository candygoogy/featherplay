// Navigation: which page is shown, and the calls that change it. `src/router.rs` owns the
// history; these callbacks are the only way Slint code navigates.

export enum PageKind { home, explore, mood, history, library, album, playlist, artist, search, now-playing, settings, about, sign-in }

export global Nav {
    // Set by the router; read-only for pages.
    in property <PageKind> page: PageKind.home;
    // The id of the album, playlist or artist shown, "" otherwise (sidebar highlight).
    in property <string> page-id;
    in property <bool> can-back;
    in property <bool> can-forward;

    // Pages without a parameter (home, explore, history, now-playing, settings, about,
    // sign-in).
    callback go(PageKind);
    // 0 Liked, 1 Playlists, 2 Albums, 3 Artists.
    callback open-library(int);
    // 0 New releases, 1 Charts, 2 Moods & genres.
    callback open-explore(int);
    // A mood or genre's playlists: its params, and its name.
    callback open-mood(string, string);
    callback open-album(string);
    callback open-playlist(string);
    callback open-artist(string);
    callback search(string);
    callback back();
    callback forward();
    // The bar's cover and title: opens Now playing, or goes back if it's open.
    callback toggle-now-playing();
}

// Frame state shared by the sidebar, the bar and the panel.
export global Frame {
    // The Up next panel (filled by `src/queue_panel.rs`). Toggled by the bar's queue button.
    in-out property <bool> queue-open: false;
    callback queue-toggled(bool);
    // Now playing's side panel (Up next and Related), shown unless hidden with the bar's
    // queue button there. Its own state: the frame's panel keeps `queue-open`.
    in-out property <bool> side-open: true;
    callback side-toggled(bool);
    // The window is too narrow for a side panel beside the page (`AppWindow.sheet`, set by
    // the window): Up next opens as a sheet above the bar instead, on every page, and Now
    // playing's side panel steps aside. The two panels keep their saved states for when the
    // window widens again.
    in-out property <bool> sheet: false;
    // The sheet is open. Not saved: it's a passing look, like a menu.
    in-out property <bool> sheet-open: false;
    // Now playing's side panel shows: open, and the window wide enough for it.
    out property <bool> side-shown: side-open && !sheet;
    // The page's Up next, Related and Lyrics tabs are open, wherever they show: the sheet, Now
    // playing's side panel, or the frame's.
    out property <bool> tabs-open: sheet ? sheet-open : (Nav.page == PageKind.now-playing ? side-open : queue-open);
    // The bar has given Shuffle and Repeat to the sheet (set by the window), and the volume
    // too (`volume-in-sheet`), each when the bar has no room left for it.
    in-out property <bool> order-in-sheet: false;
    in-out property <bool> volume-in-sheet: false;
    // The bar's volume popup, from its volume button where the slider doesn't fit.
    in-out property <bool> volume-open: false;
    // Below `Theme.drawer-below`: the sidebar's drawer, from the top bar's menu button.
    in-out property <bool> drawer-open: false;
    // The bar's mini player button, shown where the desktop has no tray: opens the mini
    // player above the point given (the button's top centre, logical pixels in the window),
    // or closes it, as a click on the tray icon does.
    callback toggle-mini(length, length);
    // Set by keyboard actions (Alt+Left/Right, Enter in search) just before they navigate, so
    // the page appears without its enter fade: keyboard actions don't animate. Cleared once
    // the page changed.
    in-out property <bool> instant: false;
    // Now playing is the page (set by Rust with `Nav.page`; it takes the whole body). A
    // property of its own, set only when it changes: read through `Nav.page`, everything it
    // places was marked dirty by every page change (`AppWindow.full-page`).
    in-out property <bool> full-page: false;
    // The window is hidden in the tray (set by Rust): nothing animates then.
    in-out property <bool> hidden: false;
    // The window's own title bar (Windows, unless Settings › Window › Title bar says Windows'):
    // the row at the window's top draws the icon and name and the window buttons, and Windows
    // drags, sizes and snaps the window by it (`src/title_bar.rs`). Off, the system's title
    // bar is above the window and the row has Back, Forward and search only. Set by Rust.
    in-out property <bool> own-bar: false;
    // The window buttons as Windows reports them (0 minimise, 1 maximise, 2 close, -1 none):
    // the one under the pointer and the one held down; whether the window is the active one
    // and maximised. Set by Rust from the window procedure.
    in-out property <int> caption-hover: -1;
    in-out property <int> caption-down: -1;
    in-out property <bool> active: true;
    in-out property <bool> maximised: false;
    // Now playing's header controls while they're in the window's top row (its pill with the
    // buttons beside it, and "Playing from"), as left edges and widths in the window: the
    // window's hit test leaves them to the app (`TopBar.hits`). Set by the page.
    in-out property <length> np-controls-x;
    in-out property <length> np-controls-w;
    in-out property <length> np-source-x;
    in-out property <length> np-source-w;
    // A window button pressed by a screen reader (the pointer's clicks go through Windows).
    callback caption(int);
    // The wheel has scrolled and the pointer hasn't moved since (set by `wheel.rs`): rows
    // passing under it don't take the hover.
    in-out property <bool> scrolling: false;
}
