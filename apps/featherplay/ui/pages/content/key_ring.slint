import { Theme } from "../../theme.slint";

// A tab stop over its parent: Tab gives it the keys and a 2 px accent ring just outside the
// parent's edge (`radius` its corners); Enter or Space activates it (Space stays play and pause). A
// click doesn't ring it. Put it under what takes the clicks.
export component KeyRing inherits Rectangle {
    in property <length> radius;
    callback activated();
    property <bool> ring;
    fs := FocusScope {
        focus-gained(reason) => { root.ring = reason == FocusReason.tab-navigation; }
        focus-lost => { root.ring = false; }
        key-pressed(e) => {
            if e.text == Key.Return {
                root.activated();
                return accept;
            }
            reject
        }
    }
    Rectangle {
        visible: fs.has-focus && root.ring;
        x: -4px;
        y: -4px;
        width: parent.width + 8px;
        height: parent.height + 8px;
        border-radius: root.radius + 4px;
        border-width: 2px;
        border-color: Theme.accent;
    }
}
