// Pieces the content pages share: Home, Library, album, playlist, artist and search.
// Generic building blocks stay in parts.slint; these are the page-level ones.
// The skeletons are in `content/skeletons.slint` and the card grid in `content/grid.slint`.
import { Theme, Curves, Icons } from "../theme.slint";
import { TrackRow, CardItem, ItemKind, Icon, Display, Body, Cover, CoverPlay, IconButton, Pill, HoverIntent, Bands, Refused } from "../parts.slint";
import { Nav, PageKind } from "../nav.slint";

export { CardLine, Grid, CardGrid } from "content/grid.slint";
import { HeaderSizes } from "content/header_sizes.slint";
import { KeyRing } from "content/key_ring.slint";
export { KeyRing } from "content/key_ring.slint";
export { HeaderSizes, HeaderTitle } from "content/header_sizes.slint";
export { Skeleton, SkeletonBlock, SkeletonBar, SkeletonRow, SkeletonCard, SkeletonList, SkeletonGrid, SkeletonShelves, SkeletonCollection } from "content/skeletons.slint";

// Opens an album, playlist or artist card. Songs are played by the page instead.
export global Open {
    public function item(it: CardItem) {
        if it.kind == ItemKind.album {
            Nav.open-album(it.id);
        } else if it.kind == ItemKind.playlist {
            Nav.open-playlist(it.id);
        } else if it.kind == ItemKind.artist {
            Nav.open-artist(it.id);
        }
    }
}

/// Glyphs only the page states use.
export global StateIcons {
    // A circle with an exclamation mark (errors).
    out property <string> alert: "M12 3.5 a8.5 8.5 0 1 0 0.01 0 Z M12 7.8 V12.8 M12 16.2 V16.3";
}

// Over the top of a page that runs up under the clear top bar (album, playlist, artist):
// clear at rest, so the page's wash or photo shows behind the search field; the ground,
// fading out just below the bar, once content scrolls under it. It follows the scroll
// (`scrolled`, how far the content has moved up), so nothing animates by itself.
// A flat fill under the bar and a short fade of solid bands below it, their alpha following
// the scroll: content scrolls under it, so it's filled again every frame, and a gradient with
// alpha there cost a 4K playlist frame ~1.3 ms (an `opacity` would also draw it through a layer).
export component TopScrim inherits Rectangle {
    in property <length> scrolled;
    property <color> ink: Theme.ground.transparentize(1 - clamp(root.scrolled / Theme.top-bar-h, 0, 1));
    y: 0;
    height: Theme.top-bar-h + Theme.s4;
    Rectangle {
        y: 0;
        height: Theme.top-bar-h;
        background: root.ink;
    }
    Bands {
        y: Theme.top-bar-h;
        height: Theme.s4;
        count: 16;
        top: root.ink;
        bottom: root.ink.transparentize(1);
    }
}

// Content that has just arrived fades in over `t-fast`, without moving.
export component FadeIn inherits Rectangle {
    property <bool> arrived: false;
    opacity: root.arrived ? 1 : 0;
    animate opacity { duration: Theme.t-fast; easing: Curves.ease-hover; }
    init => { root.arrived = true; }
}

// A page that didn't load: a glyph, what happened, and a way on: trying again. Signed out
// too, as the catalogue loads without an account; what needs one shows `AccountGate`.
export component ErrorState inherits Rectangle {
    in property <string> message;
    callback retry();
    height: lay.preferred-height;
    accessible-role: text;
    accessible-label: @tr("This didn\u{2019}t load. {}", root.message);
    lay := VerticalLayout {
        alignment: start;
        spacing: Theme.s2;
        Icon {
            width: 32px;
            height: 32px;
            commands: StateIcons.alert;
            stroke: Theme.text3;
            stroke-width: 1.6px;
        }
        Rectangle { height: 4px; }
        Body {
            text: @tr("This didn\u{2019}t load");
            font-size: Theme.t-body-l;
            font-weight: 600;
            color: Theme.text1;
        }
        Body {
            text: root.message;
            color: Theme.text2;
            wrap: word-wrap;
        }
        Rectangle { height: Theme.s2; }
        HorizontalLayout {
            alignment: start;
            Pill {
                label: @tr("Try again");
                clicked => { root.retry(); }
            }
        }
    }
}

// Nothing to show: a glyph, a title, one line, and an optional action.
export component EmptyState inherits Rectangle {
    in property <string> glyph: Icons.note;
    in property <string> title;
    in property <string> line;
    in property <string> action;
    callback action-clicked();
    height: lay.preferred-height;
    lay := VerticalLayout {
        alignment: start;
        spacing: Theme.s2;
        Icon {
            width: 40px;
            height: 40px;
            commands: root.glyph;
            stroke: Theme.text3;
            stroke-width: 1.4px;
        }
        Rectangle { height: 4px; }
        Body {
            text: root.title;
            font-size: Theme.t-body-l;
            font-weight: 600;
            color: Theme.text1;
        }
        if root.line != "": Body {
            text: root.line;
            color: Theme.text2;
            wrap: word-wrap;
        }
        if root.action != "": Rectangle { height: Theme.s2; }
        if root.action != "": HorizontalLayout {
            alignment: start;
            Pill {
                label: root.action;
                clicked => { root.action-clicked(); }
            }
        }
    }
}

// A faint, still row of what a gated page will list: a cover and two lines, at `fade` of
// the skeleton's ink (through the colours, not `opacity`, which would draw it in a layer).
component GhostRow inherits Rectangle {
    in property <length> title-w;
    in property <length> line-w;
    in property <float> fade: 1.0;
    property <color> ink: Theme.skeleton.transparentize(1 - root.fade);
    height: Theme.row-h;
    Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: Theme.row-cover;
        height: Theme.row-cover;
        border-radius: Theme.r-s;
        background: root.ink;
    }
    Rectangle {
        x: Theme.row-cover + Theme.s3;
        y: 14px;
        width: root.title-w;
        height: 10px;
        border-radius: 5px;
        background: root.ink;
    }
    Rectangle {
        x: Theme.row-cover + Theme.s3;
        y: 32px;
        width: root.line-w;
        height: 8px;
        border-radius: 4px;
        background: Theme.skeleton.transparentize(1 - 0.6 * root.fade);
    }
}

// Signed out, in place of what belongs to an account (Library, History, Liked songs): one
// gate, at `Theme.gate-y` under the page title on every page. A 56 px tile with the page's
// own icon (the sidebar's), a title, at most two lines, Sign in and a way on that works
// signed out. Liked songs' header already shows its heart, so it drops the tile (`glyph`
// ""). Under it, three faint rows of what will be there fade out: still, as nothing is
// loading (no sweep, no timer). Calm, as an empty page is: nothing went wrong.
export component AccountGate inherits Rectangle {
    in property <string> glyph;
    in property <string> title;
    in property <string> line;
    // The second action, "Go to Explore".
    in property <bool> explore: true;
    in property <bool> ghost: true;
    height: lay.preferred-height;
    lay := VerticalLayout {
        alignment: start;
        if root.glyph != "": HorizontalLayout {
            alignment: start;
            Rectangle {
                width: 56px;
                height: 56px;
                border-radius: Theme.r-l;
                background: Theme.panel;
                border-width: 1px;
                border-color: Theme.card-edge;
                Icon {
                    width: 26px;
                    height: 26px;
                    commands: root.glyph;
                    stroke: Theme.text2;
                }
            }
        }
        if root.glyph != "": Rectangle { height: Theme.s4; }
        Display {
            text: root.title;
            font-size: Theme.t-display-xs;
            wrap: word-wrap;
        }
        Rectangle { height: Theme.s2; }
        Body {
            text: root.line;
            color: Theme.text2;
            wrap: word-wrap;
        }
        Rectangle { height: Theme.s5; }
        HorizontalLayout {
            alignment: start;
            spacing: Theme.s2;
            Pill {
                label: @tr("Sign in");
                solid: true;
                clicked => { Nav.go(PageKind.sign-in); }
            }
            if root.explore: Pill {
                label: @tr("Go to Explore");
                clicked => { Nav.go(PageKind.explore); }
            }
        }
        if root.ghost: Rectangle { height: Theme.s6; }
        // Each row a step fainter, down into the ground.
        if root.ghost: GhostRow { title-w: 220px; line-w: 140px; fade: 0.85; }
        if root.ghost: GhostRow { title-w: 180px; line-w: 140px; fade: 0.5; }
        if root.ghost: GhostRow { title-w: 250px; line-w: 100px; fade: 0.3; }
    }
}

// Song row with a cover, for playlists, Liked, search and an artist's top songs: cover, title
// and artist, the album (when there's room), like and menu on hover, the duration.
// Double-click plays; right-click or the menu button asks for the song menu.
export component SongListRow inherits Rectangle {
    in property <TrackRow> track;
    in property <bool> show-album: true;
    // Keeps the heart of liked rows shown; lists of liked songs show it on hover only.
    in property <bool> show-liked: true;
    // One of the account's own playlists: a click picks the row (`picked`, with Ctrl or
    // Shift held), and a picked row rests on the `selected` tile. Pressed and moved 4 px, the
    // row drags (`drag`, then `drop`, or `drag-cancelled` when the press is taken away).
    in property <bool> pickable;
    // Songs are being dragged in the list; `lifted`: this is one of them, dimmed in place.
    in property <bool> drag-active;
    in property <bool> lifted;
    // The raised copy a drag carries: no tile of its own; `badge` in the duration's place
    // ("3 songs", for several).
    in property <bool> copy;
    in property <string> badge;
    callback activated();
    callback picked(/* ctrl */ bool, /* shift */ bool);
    // The pointer's y in the window, and in the row at the press.
    callback drag(length, length);
    callback drop();
    callback drag-cancelled();
    // A drag started from this press: its release drops, it doesn't pick.
    property <bool> dragged;
    callback like-clicked();
    // Window coordinates for the menu: where it opens down from, and where it ends upward.
    callback menu-requested(length, length, length);
    property <bool> hovered: ta.has-hover && !root.drag-active;
    // A narrow row (a narrow window): the heart doesn't keep a column of its own. It shows
    // on hover in the duration's place, the ⋯ beside it, and the title takes the room.
    property <bool> narrow: root.width < 520px;
    property <length> right-w: root.narrow ? 100px : 156px;
    property <bool> heart-shown: root.hovered || (root.track.liked && root.show-liked && !root.narrow);
    property <length> text-x: 8px + Theme.row-cover + 12px;
    // The album column starts where it does in every list. A row without a duration (an
    // artist's top songs) moves the heart into the duration's slot and gives the room it
    // leaves to the album, which still elides before the heart.
    property <length> duration-w: root.track.duration == "" ? 48px : 0px;
    property <length> album-col: root.show-album && root.width >= 640px ? floor((root.width - root.text-x - root.right-w) * 0.38 / 1px) * 1px : 0px;
    property <length> album-x: root.width - root.right-w - root.album-col;
    property <length> album-w: root.album-col > 0 ? root.album-col + root.duration-w : 0px;
    // YouTube refuses the song now (`Refused`): greyed as in `SongRow`, the second line
    // saying why while hovered. A double-click still tries it.
    property <bool> refused: Refused.changes >= 0 && Refused.has(root.track.id);
    property <float> alpha: root.refused ? 0.45 : 1.0;
    height: Theme.row-h;
    border-radius: Theme.r-m;
    HoverIntent {
        hovered: root.hovered && !root.track.playing;
        pressed: ta.pressed || cover-play.pressed;
        id: root.track.id;
    }
    // The playing row rests on a light tile; hover and press show over it.
    // Animated as a private property: a root animating a public one is copied into each use.
    property <brush> ground: root.lifted || root.copy ? transparent : root.track.selected ? Theme.state-on(true, ta.pressed, root.hovered) : root.track.playing && !ta.pressed && !root.hovered ? Theme.playing-row : Theme.state(ta.pressed, root.hovered);
    animate ground { duration: Theme.t-hover; }
    background: root.ground;
    opacity: root.lifted ? 0.35 : 1;
    accessible-role: list-item;
    accessible-label: root.track.title + ", " + root.track.artist;
    accessible-item-selectable: root.pickable;
    accessible-item-selected: root.pickable && root.track.selected;
    accessible-description: root.refused ? @tr("YouTube won't play this song in featherplay right now") : "";
    // Under the touch area, so the play button inside it draws over the art.
    Cover {
        x: 8px;
        y: (parent.height - self.height) / 2;
        width: Theme.row-cover;
        height: Theme.row-cover;
        radius: Theme.r-s;
        source: root.track.cover;
    }
    ta := TouchArea {
        mouse-cursor: root.drag-active ? MouseCursor.grabbing : MouseCursor.pointer;
        double-clicked => { root.activated(); }
        // As Up next's rows (`QueueRow`): the pointer moved 4 px from the press drags. The
        // pointer goes in window coordinates: the list may scroll under it, and reuse this
        // row for another song meanwhile.
        moved => {
            if root.pickable && self.pressed && (root.dragged || abs(self.mouse-y - self.pressed-y) > Theme.s1) {
                root.dragged = true;
                root.drag(self.absolute-position.y + self.mouse-y, self.pressed-y);
            }
        }
        pointer-event(e) => {
            if e.button == PointerEventButton.right && e.kind == PointerEventKind.up {
                root.menu-requested(root.absolute-position.x + self.mouse-x, root.absolute-position.y + self.mouse-y, root.absolute-position.y + self.mouse-y);
            }
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.up {
                if root.dragged {
                    root.dragged = false;
                    root.drop();
                } else if root.pickable && self.has-hover {
                    root.picked(e.modifiers.control, e.modifiers.shift);
                }
            }
            if e.kind == PointerEventKind.cancel && root.dragged {
                root.dragged = false;
                root.drag-cancelled();
            }
        }
        // Inside the touch area, so hovering the buttons keeps the row hovered. The current
        // track's cover rests under a deep veil with the playing mark; hovering a cover
        // shows play (pause on the current track), and clicking it plays as a double-click.
        cover-play := CoverPlay {
            x: 8px;
            y: (parent.height - self.height) / 2;
            width: Theme.row-cover;
            height: Theme.row-cover;
            current: root.track.playing;
            title: root.track.title;
            play => { root.activated(); }
            right-clicked(x, y) => { root.menu-requested(x, y, y); }
        }
        if root.heart-shown: IconButton {
            x: root.narrow ? parent.width - 90px : parent.width - 140px + root.duration-w;
            y: (parent.height - self.height) / 2;
            icon: Icons.heart;
            label: root.track.liked ? @tr("Remove like") : @tr("Like");
            filled: root.track.liked;
            tint: root.track.liked ? Theme.text1 : Theme.text2;
            clicked => { root.like-clicked(); }
        }
        if root.hovered: IconButton {
            x: parent.width - 44px;
            y: (parent.height - self.height) / 2;
            icon: Icons.more;
            label: @tr("More");
            filled: true;
            clicked => {
                root.menu-requested(self.absolute-position.x + self.width - 4px, self.absolute-position.y + self.height, root.absolute-position.y);
            }
        }
    }
    VerticalLayout {
        x: root.text-x;
        width: parent.width - self.x - root.right-w - root.album-col - (root.album-col > 0 ? 16px : 0px);
        alignment: center;
        spacing: 1px;
        Body {
            text: root.track.title;
            font-weight: 600;
            color: Theme.text1.transparentize(1 - root.alpha);
        }
        Body {
            property <bool> why: root.refused && root.hovered;
            text: self.why ? @tr("YouTube won't play this song in featherplay right now") : root.track.artist;
            font-size: Theme.t-meta;
            color: self.why ? Theme.text2 : Theme.text2.transparentize(1 - root.alpha);
        }
    }
    if root.album-w > 0: Rectangle {
        x: root.album-x;
        width: root.album-w;
        height: parent.height;
        // The link's width, a property read twice on purpose (the touch area's width and
        // `enabled`, first there, so a constant after it can't fold the read away). Read once,
        // Slint 1.19's compiler inlines it into the row's item geometry, which the renderer asks
        // for on every frame: the album would be measured each frame of a scroll, and its drawn
        // line broken and its "…" shaped again after each measure.
        property <length> link-w: min(self.width, album.preferred-width);
        album := Body {
            x: 0;
            width: parent.width;
            height: parent.height;
            text: root.track.album;
            color: (album-ta.has-hover ? Theme.text1 : Theme.text2).transparentize(1 - root.alpha);
            vertical-alignment: center;
        }
        // Only the text itself is a link.
        album-ta := TouchArea {
            x: 0;
            width: parent.link-w;
            height: 24px;
            enabled: parent.link-w > 0 && root.track.album-id != "";
            mouse-cursor: self.enabled ? pointer : default;
            clicked => { Nav.open-album(root.track.album-id); }
        }
    }
    Body {
        x: parent.width - 92px;
        width: 44px;
        height: parent.height;
        // Narrow, the heart takes its place while it shows.
        visible: !(root.narrow && root.heart-shown) && root.badge == "";
        text: root.track.duration;
        color: Theme.text2.transparentize(1 - root.alpha);
        horizontal-alignment: right;
        vertical-alignment: center;
    }
    if root.badge != "": Rectangle {
        x: parent.width - 48px - self.width;
        y: (parent.height - self.height) / 2;
        width: badge-text.preferred-width + 20px;
        height: 24px;
        border-radius: 12px;
        background: Theme.solid;
        badge-text := Body {
            text: root.badge;
            font-size: Theme.t-meta;
            font-weight: 600;
            color: Theme.on-solid;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// Filter chips (Library, Search): pills, the active one on the accent's tonal fill (as the
// Now playing tabs), the others outlined.
export component Chips inherits Rectangle {
    in property <[string]> labels;
    in property <int> active;
    // Each chip is a tab stop: Tab gives it the keys and the accent ring, Enter picks it.
    in property <bool> keys: false;
    callback selected(int);
    height: 36px;
    // Its size asks for the chips at their full padding (the hidden copy below), and it can
    // be given less: a narrow page, a settings row stacking its controls, a long translation.
    preferred-width: full.preferred-width;
    min-width: 0px;
    max-width: 100000px;
    horizontal-stretch: 0;
    // Given less, the chips fit (`fit`): their padding gives way first, evenly, down to `s2`
    // a side; then their labels narrow alike, eliding. Worked out when the width or the
    // labels change, not bound to the width: the row's sizes then feed nothing above.
    property <int> n: root.labels.length;
    property <length> gaps: max(0, root.n - 1) * Theme.s2;
    property <length> natural: full.preferred-width;
    property <length> pad: Theme.s4 + 2px;
    property <float> scale: 1;
    function fit() {
        let labels = root.natural - root.gaps - root.n * 2 * (Theme.s4 + 2px);
        if root.n == 0 || root.natural <= root.width {
            root.pad = Theme.s4 + 2px;
            root.scale = 1;
        } else if labels + root.gaps + root.n * 2 * Theme.s2 <= root.width {
            root.pad = (root.width - root.gaps - labels) / (2 * root.n);
            root.scale = 1;
        } else {
            root.pad = Theme.s2;
            root.scale = max(0, (root.width - root.gaps - root.n * 2 * Theme.s2) / max(1px, labels));
        }
    }
    init => { root.fit(); }
    changed width => { root.fit(); }
    changed natural => { root.fit(); }
    // Measured only: the chips at their full padding.
    Rectangle {
        visible: false;
        full := HorizontalLayout {
            spacing: Theme.s2;
            for label in root.labels: Rectangle {
                width: m.preferred-width + 2 * Theme.s4 + 4px;
                m := Body {
                    accessible-role: none;
                    text: label;
                    font-weight: 600;
                }
            }
        }
    }
    HorizontalLayout {
        alignment: start;
        spacing: Theme.s2;
        for label[i] in root.labels: Rectangle {
            property <bool> on: i == root.active;
            width: floor(t.preferred-width * root.scale / 1px) * 1px + 2 * root.pad;
            border-radius: self.height / 2;
            border-width: self.on ? 0px : 1px;
            border-color: Theme.hairline;
            background: self.on ? Theme.solid-state(ta.pressed, ta.has-hover) : Theme.state(ta.pressed, ta.has-hover);
            // Press: a small give, then a short spring back.
            transform-scale: ta.pressed ? Theme.press-scale : 1.0;
            accessible-role: tab;
            accessible-label: label;
            accessible-action-default => { root.selected(i); }
            animate background { duration: Theme.t-hover; }
            animate transform-scale {
                duration: ta.pressed ? Theme.t-press : Theme.t-release;
                easing: ta.pressed ? Curves.ease-out : Curves.release;
            }
            if root.keys: KeyRing {
                radius: parent.border-radius;
                activated => { root.selected(i); }
            }
            ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.selected(i); }
            }
            t := Body {
                x: root.pad;
                width: parent.width - 2 * root.pad;
                text: label;
                font-weight: 600;
                color: parent.on ? Theme.on-solid : Theme.text2;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

// The tall header of an album or a playlist: the cover's colour washes the
// page top, up under the clear top bar (the page runs beneath it, so the header starts
// `Theme.top-bar-h` down and its height includes it); a large cover on the left; beside it, stacked up from the cover's bottom edge,
// the kind line ("Album, 1996"), the title in the display face, the byline (clickable),
// the meta line and the actions. Liked songs gets its own tile instead of a cover.
export component CollectionHeader inherits Rectangle {
    in property <image> cover;
    in property <bool> round: false;
    // The cover's wash for each theme (`follow::washes`); transparent until it's known.
    in property <color> wash-dark: transparent;
    in property <color> wash-light: transparent;
    // Liked songs: a red tile with a white heart instead of a cover.
    in property <bool> liked-tile: false;
    in property <string> kind;
    in property <string> title;
    in property <string> byline;
    in property <bool> byline-link: false;
    in property <string> meta;
    in property <string> primary: @tr("Play");
    in property <string> secondary: @tr("Shuffle");
    in property <string> secondary-icon: Icons.shuffle;
    in property <bool> enabled: true;
    // The buttons. Without them (Liked songs signed out: nothing to play) the lines above
    // stack down to the cover's bottom edge in their place.
    in property <bool> actions: true;
    // Play and Shuffle among them; without them (an empty playlist: nothing to play) the ⋯
    // stands alone, still usable.
    in property <bool> plays: true;
    // A ⋯ after the buttons (the album's, a playlist's or an artist's menu), and whether it can
    // be used now.
    in property <bool> more: false;
    in property <bool> more-enabled: true;
    // Changing this opens the ⋯'s menu as a click does (`--snapshot`, tests).
    in property <int> more-asked;
    callback byline-clicked();
    callback primary-clicked();
    callback secondary-clicked();
    // The ⋯: where its menu opens (window coordinates), and the ⋯'s top for one that opens up.
    callback more-clicked(length, length, length);
    function open-more() {
        root.more-clicked(more-btn.absolute-position.x, more-btn.absolute-position.y + more-btn.height + 4px, more-btn.absolute-position.y - 4px);
    }
    changed more-asked => { root.open-more(); }
    property <length> pad: Theme.pad-for(root.width);
    property <length> top: Theme.top-bar-h + Theme.page-top;
    // A narrow page (under about 600 px), where the lines beside the cover would have under
    // 300 px: everything stacks on the page's left edge, the cover first (smaller, so a
    // track or two still shows below), then the lines and the buttons under it, the title a
    // size down and up to two lines.
    property <bool> stacked: HeaderSizes.stacked(root.width);
    property <length> cover-size: HeaderSizes.cover(root.width);
    property <length> text-x: root.stacked ? root.pad : root.pad + root.cover-size + Theme.s6;
    property <length> text-w: root.width - root.text-x - root.pad;
    property <length> bottom: root.top + root.cover-size;
    // Stacked, from the top down (as `HeaderSizes.height` adds them up): the kind line under
    // the cover, the title, the byline, the meta, the buttons.
    property <length> s-title-y: root.bottom + Theme.s5 + (root.kind != "" ? 20px : 0px);
    property <length> s-title-h: title.preferred-height;
    property <length> s-byline-y: root.s-title-y + root.s-title-h + 4px;
    property <length> s-meta-y: root.s-byline-y + (root.byline != "" ? 26px : 0px);
    property <length> s-buttons-y: root.s-meta-y + (root.meta != "" ? 20px : 0px) + Theme.s4;
    // Beside the cover, from the bottom up: the buttons, a 24 px gap, the meta, the byline.
    // (Apart from the stacked ones, so the title's room beside the cover doesn't read the
    // stacked lines, which sit under the title's own height: a binding loop to the compiler.)
    property <length> side-buttons-y: root.bottom - 40px;
    property <length> side-meta-y: root.actions ? root.side-buttons-y - Theme.s5 - 20px : root.bottom - (root.meta != "" ? 20px : 0px);
    property <length> side-byline-y: root.side-meta-y - (root.byline != "" ? 26px : 0px);
    property <length> buttons-y: root.stacked ? root.s-buttons-y : root.side-buttons-y;
    property <length> meta-y: root.stacked ? root.s-meta-y : root.side-meta-y;
    property <length> byline-y: root.stacked ? root.s-byline-y : root.side-byline-y;
    // A long title wraps to a second line when there's room above it for the kind line.
    property <length> line-h: title.font-metrics.ascent - title.font-metrics.descent;
    property <length> title-room: root.side-byline-y - root.top - (root.kind != "" ? 24px : 0px);
    property <bool> two-lines: root.stacked || root.title-room >= 2 * root.line-h;
    property <bool> wrapped: root.two-lines && title.preferred-height > 1.5 * root.line-h;
    property <length> title-h: root.stacked ? root.s-title-h : (root.wrapped ? 2 * root.line-h : 56px);
    property <length> title-y: root.stacked ? root.s-title-y : root.byline-y - root.title-h + 4px;
    property <color> wash: Theme.pick(root.wash-dark, root.wash-light);
    animate wash { duration: Theme.t-colour; easing: Curves.ease-hover; }
    height: HeaderSizes.height(root.width, root.s-title-h, root.kind != "", root.byline != "", root.meta != "", root.actions);

    // The wash: the cover's colour from under the top bar, fading to the ground over the
    // 420 px below it. It reaches past the header, behind the first rows, which scroll over
    // it: so solid bands, not a gradient (`Bands`).
    Bands {
        x: 0;
        y: 0;
        width: root.width;
        height: Theme.top-bar-h + 420px;
        count: 64;
        top: root.wash;
        bottom: root.wash.transparentize(1);
    }
    if !root.liked-tile: Cover {
        x: root.pad;
        y: root.top;
        width: root.cover-size;
        height: root.cover-size;
        source: root.cover;
        round: root.round;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: Theme.cover-shadow;
    }
    if root.liked-tile: Rectangle {
        x: root.pad;
        y: root.top;
        width: root.cover-size;
        height: root.cover-size;
        border-radius: Theme.r-m;
        background: @linear-gradient(135deg, Theme.brand-accent 0%, #7A0E20 100%);
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: Theme.cover-shadow;
        Icon {
            width: 88px;
            height: 88px;
            commands: Icons.heart;
            fill: #FFFFFF;
            stroke: transparent;
        }
    }
    if root.kind != "": Body {
        x: root.text-x;
        y: root.title-y - 20px;
        width: root.text-w;
        height: 20px;
        text: root.kind;
        font-size: Theme.t-meta;
        font-weight: 600;
        color: Theme.text2;
        vertical-alignment: center;
    }
    title := Display {
        x: root.text-x;
        y: root.title-y;
        width: root.text-w;
        height: root.title-h;
        text: root.title;
        font-size: root.stacked ? Theme.t-display-l : Theme.t-display-xl;
        font-weight: 800;
        wrap: root.two-lines ? word-wrap : no-wrap;
        max-lines: 2;
        vertical-alignment: center;
    }
    if root.byline != "": Rectangle {
        x: root.text-x;
        y: root.byline-y;
        width: root.text-w;
        height: 22px;
        // Read twice on purpose, as `SongListRow`'s album link (here too first in `enabled`: the
        // playlist's header leaves `byline-link` at its constant false, which would fold a read
        // after it away). Read once, Slint 1.19 inlines it into the item geometry and the byline
        // is measured on every frame drawn.
        property <length> link-w: min(self.width, by.preferred-width);
        by := Body {
            x: 0;
            width: parent.width;
            height: parent.height;
            text: root.byline;
            font-size: Theme.t-body-l;
            font-weight: 600;
            color: by-ta.has-hover ? Theme.text2 : Theme.text1;
            vertical-alignment: center;
        }
        by-ta := TouchArea {
            x: 0;
            width: parent.link-w;
            enabled: parent.link-w > 0 && root.byline-link;
            mouse-cursor: self.enabled ? pointer : default;
            clicked => { root.byline-clicked(); }
        }
    }
    Body {
        x: root.text-x;
        y: root.meta-y;
        width: root.text-w;
        height: 20px;
        text: root.meta;
        color: Theme.text2;
        vertical-alignment: center;
    }
    HorizontalLayout {
        x: root.text-x;
        y: root.buttons-y;
        height: 40px;
        spacing: Theme.s2;
        alignment: start;
        if root.actions && root.plays: Pill {
            label: root.primary;
            icon: Icons.play;
            solid: true;
            enabled: root.enabled;
            clicked => { root.primary-clicked(); }
        }
        if root.actions && root.plays && root.secondary != "": Pill {
            label: root.secondary;
            icon: root.secondary-icon;
            icon-filled: false;
            enabled: root.enabled;
            clicked => { root.secondary-clicked(); }
        }
        more-btn := IconButton {
            visible: root.more && root.actions;
            width: self.visible ? 40px : 0px;
            height: 40px;
            icon: Icons.more;
            label: @tr("More");
            tint: Theme.text1;
            enabled: (root.enabled || !root.plays) && root.more-enabled;
            clicked => { root.open-more(); }
        }
    }
}
