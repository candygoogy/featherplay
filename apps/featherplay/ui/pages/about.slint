// About (a calm single column): the logo, the tagline, the version row with "Check for
// updates" and what the last check found, the not-affiliated disclaimer, the log folder and
// the diagnostics for a bug report, the licences and the Made with Slint badge that Slint's
// royalty-free licence asks for (its `AboutSlint` widget, drawn as paths: `MadeWithSlint`).
// Filled by `src/pages/about.rs`.
// When a newer release is out (`src/updates.rs`), a banner above the logo says so, in one of
// the states of `UpdateState`, and the row's pill goes: the banner's button is the action.
import { MadeWithSlint } from "../made_with_slint.slint";
import { Theme } from "../theme.slint";
import { Body, Display, Pill, TextLink } from "../parts.slint";
import { Logo } from "../logo.slint";

// A third-party component and its licence.
export struct Credit {
    name: string,
    licence: string,
}

// The banner's state (the design board's B1-B9).
export enum UpdateState {
    // No newer release: no banner.
    none,
    // "Get it" opens the release page (a portable copy, automatic install off, a dev build).
    get,
    // The setup is downloading: no button.
    downloading,
    // The setup is downloaded and checked: "Restart to update".
    ready,
    // The download didn't finish: "Try again", or the release page.
    download-failed,
    // A checksum that didn't match, no setup for this PC, or a setup that wouldn't start:
    // "Get it".
    cannot-install,
    // The last update didn't install: "Try again", or the log folder.
    install-failed,
    // Scoop's copy: the command, with "Copy command".
    scoop,
    // "Restart to update" was clicked, before featherplay quits: no button.
    starting,
    // The release's checksums weren't signed for it with featherplay's keys: nothing was
    // downloaded; "Get it" opens the website.
    unverified,
}

export global AboutData {
    in property <string> version;
    // featherplay's MIT licence and Manrope's OFL.txt, in full.
    in property <string> mit-text;
    in property <string> ofl-text;
    in property <[Credit]> credits;
    // A newer release ("0.2.0"), or "" for none, and the banner's state.
    in property <string> update-version;
    in property <UpdateState> update-state;
    // The version row: the last check's line ("Up to date. Checked 2 hours ago.", or ""),
    // and its pill's label ("Check for updates", "Checking…", "Try again", or "" for none).
    in property <string> check-line;
    in property <string> check-pill;
    // A check is going: the pill ignores clicks (it isn't dimmed).
    in property <bool> checking;
    // The banner's solid (or tonal) button, and its text link.
    callback get-update();
    callback update-secondary();
    // The version row's pill.
    callback check-now();
    // The Scoop command is on the clipboard: a toast says so.
    callback command-copied();
    // Opens the log folder in Explorer.
    callback open-log-folder();
    // The plain text Copy diagnostics puts on the clipboard, made when it's clicked.
    callback diagnostics() -> string;
    // The text is on the clipboard: a toast says so.
    callback copied();
}

// What Scoop's copy is updated with, shown and copied as it's typed.
global ScoopCommand {
    out property <string> text: "scoop update featherplay";
}

// A newer release is out: its version, what's happening with it, and what to do.
component UpdateBanner inherits Rectangle {
    callback copy-command();
    property <UpdateState> state: AboutData.update-state;
    property <string> title: root.state == UpdateState.install-failed
        ? @tr("The update to {} didn't install", AboutData.update-version)
        : @tr("featherplay {} is out", AboutData.update-version);
    property <string> line: root.state == UpdateState.downloading ? @tr("Downloading the update…")
        : root.state == UpdateState.ready ? @tr("You have {}. The update is downloaded and installs when featherplay restarts.", AboutData.version)
        : root.state == UpdateState.download-failed ? @tr("The download didn't finish. You have {}.", AboutData.version)
        : root.state == UpdateState.cannot-install ? @tr("It can't be installed from here. You have {}.", AboutData.version)
        : root.state == UpdateState.install-failed ? @tr("You still have {}. The log folder has the details.", AboutData.version)
        : root.state == UpdateState.starting ? @tr("Starting the update…")
        : root.state == UpdateState.unverified ? @tr("This update couldn't be verified. Download it from featherplay.candygoogy.dev.")
        : @tr("You have {}.", AboutData.version);
    property <string> primary: root.state == UpdateState.get || root.state == UpdateState.cannot-install || root.state == UpdateState.unverified ? @tr("Get it")
        : root.state == UpdateState.ready ? @tr("Restart to update")
        : root.state == UpdateState.download-failed || root.state == UpdateState.install-failed ? @tr("Try again")
        : root.state == UpdateState.scoop ? @tr("Copy command")
        : "";
    property <string> secondary: root.state == UpdateState.download-failed ? @tr("Get it on GitHub")
        : root.state == UpdateState.install-failed ? @tr("Open log folder")
        : root.state == UpdateState.get || root.state == UpdateState.downloading || root.state == UpdateState.ready || root.state == UpdateState.scoop ? @tr("What's new")
        : "";
    border-radius: Theme.r-l;
    background: Theme.accent-tonal;
    min-height: max(72px, lay.min-height);
    preferred-height: max(72px, lay.preferred-height);
    accessible-role: groupbox;
    accessible-label: root.title;
    lay := HorizontalLayout {
        padding: Theme.s4;
        padding-left: Theme.s5;
        spacing: Theme.s4;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Body {
                text: root.title;
                font-size: Theme.t-body-l;
                font-weight: 600;
                overflow: clip;
                wrap: word-wrap;
            }
            if root.state != UpdateState.scoop: Body {
                text: root.line;
                font-size: Theme.t-meta;
                color: Theme.text2;
                overflow: clip;
                wrap: word-wrap;
            }
            // "Update with Scoop: `scoop update featherplay`", the command in a code span.
            if root.state == UpdateState.scoop: HorizontalLayout {
                alignment: start;
                spacing: 6px;
                Body {
                    text: @tr("Update with Scoop:");
                    font-size: Theme.t-meta;
                    color: Theme.text2;
                    vertical-alignment: center;
                }
                Rectangle {
                    border-radius: 4px;
                    background: Theme.selected;
                    width: cmd.preferred-width + 12px;
                    height: cmd.preferred-height + 2px;
                    accessible-role: text;
                    accessible-label: ScoopCommand.text;
                    cmd := Text {
                        text: ScoopCommand.text;
                        font-family: "Cascadia Mono";
                        font-size: Theme.t-meta;
                        color: Theme.text2;
                        accessible-role: none;
                    }
                }
            }
        }
        if root.secondary != "": VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            padding-left: 12px;
            padding-right: root.primary != "" ? 12px : 0px;
            TextLink {
                text: root.secondary;
                clicked => { AboutData.update-secondary(); }
            }
        }
        if root.primary != "": VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            Pill {
                label: root.primary;
                solid: root.state != UpdateState.scoop;
                clicked => {
                    if root.state == UpdateState.scoop {
                        root.copy-command();
                    } else {
                        AboutData.get-update();
                    }
                }
            }
        }
    }
}

// The version, what the last check found, and "Check for updates", between hairlines: what
// it is on the left, the thing itself on the right.
component VersionRow inherits Rectangle {
    min-height: lay.min-height;
    preferred-height: lay.preferred-height;
    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.hairline;
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.hairline;
    }
    lay := HorizontalLayout {
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: Theme.s5;
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            Body {
                text: @tr("Version {}", AboutData.version);
                font-size: Theme.t-body-l;
                font-weight: 600;
            }
            if AboutData.check-line != "": Body {
                text: AboutData.check-line;
                font-size: Theme.t-meta;
                color: Theme.text2;
                overflow: clip;
                wrap: word-wrap;
                accessible-label: AboutData.checking ? @tr("Checking for updates") : self.text;
            }
        }
        if AboutData.check-pill != "": VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            Pill {
                compact: true;
                label: AboutData.check-pill;
                clicked => {
                    if !AboutData.checking {
                        AboutData.check-now();
                    }
                }
            }
        }
    }
}

component SectionTitle inherits Display {
    font-size: 20px;
    height: 32px;
    vertical-alignment: center;
}

// A licence line that opens its full text.
component LicenceRow inherits Rectangle {
    in property <string> name;
    in property <string> licence;
    in property <string> full-text;
    in property <bool> divider: true;
    property <bool> open: false;
    min-height: lay.min-height;
    preferred-height: lay.preferred-height;
    if root.divider: Rectangle {
        y: 0;
        height: 1px;
        background: Theme.hairline;
    }
    lay := VerticalLayout {
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: Theme.s3;
        HorizontalLayout {
            spacing: Theme.s4;
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;
                Body {
                    text: root.name;
                    font-weight: 600;
                }
                Body {
                    text: root.licence;
                    font-size: Theme.t-meta;
                    color: Theme.text2;
                    overflow: clip;
                    wrap: word-wrap;
                }
            }
            if root.full-text != "": Rectangle {
                width: t.preferred-width + 24px;
                height: 32px;
                border-radius: 16px;
                background: Theme.tonal(ta.pressed, ta.has-hover);
                accessible-role: button;
                accessible-label: root.open ? @tr("Hide the licence of {}", root.name) : @tr("Show the licence of {}", root.name);
                accessible-action-default => { root.open = !root.open; }
                animate background { duration: Theme.t-hover; }
                ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.open = !root.open; }
                }
                t := Body {
                    text: root.open ? @tr("Hide licence") : @tr("Show licence");
                    font-size: Theme.t-meta;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        if root.open: Rectangle {
            min-height: txt.min-height + 2 * Theme.s4;
            preferred-height: txt.preferred-height + 2 * Theme.s4;
            border-radius: Theme.r-m;
            background: Theme.card;
            border-width: 1px;
            border-color: Theme.card-edge;
            txt := Body {
                x: Theme.s4;
                y: Theme.s4;
                width: parent.width - 2 * Theme.s4;
                text: root.full-text;
                font-size: Theme.t-meta;
                color: Theme.text2;
                overflow: clip;
                wrap: word-wrap;
            }
        }
    }
}

export component AboutPage inherits Rectangle {
    property <length> col-w: min(self.width - 2 * Theme.page-pad, 640px);

    flick := Flickable {
        width: parent.width;
        height: parent.height;
        content-height: col.preferred-height + Theme.page-top + Theme.page-end;

        col := VerticalLayout {
            x: Theme.page-pad;
            y: Theme.page-top;
            width: root.col-w;
            height: self.preferred-height;
            spacing: Theme.s7;

            if AboutData.update-state != UpdateState.none: UpdateBanner {
                copy-command => {
                    copy-field.text = ScoopCommand.text;
                    copy-field.select-all();
                    copy-field.copy();
                    copy-field.clear-selection();
                    AboutData.command-copied();
                }
            }

            VerticalLayout {
                spacing: Theme.s3;
                Logo {
                    width: 72px;
                    height: 72px;
                }
                Display {
                    text: "featherplay";
                    font-size: Theme.t-display-l;
                    height: 52px;
                    vertical-alignment: center;
                }
                Body {
                    text: @tr("A fast, lightweight desktop player for YouTube Music.");
                    font-size: Theme.t-body-l;
                    color: Theme.text1;
                    overflow: clip;
                    wrap: word-wrap;
                }
                VersionRow { }
                Body {
                    text: @tr("featherplay is not affiliated with Google or YouTube.");
                    color: Theme.text2;
                    overflow: clip;
                    wrap: word-wrap;
                }
            }

            VerticalLayout {
                spacing: Theme.s3;
                SectionTitle {
                    text: @tr("Logs and bug reports");
                }
                Body {
                    text: @tr("If something goes wrong, the log folder holds what featherplay noted, with a crash file for each crash. Copy diagnostics puts the versions, which services are on and the last playback errors on the clipboard, for a bug report. Neither names your account.");
                    color: Theme.text2;
                    overflow: clip;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: Theme.s3;
                    Pill {
                        height: 32px;
                        label: @tr("Open log folder");
                        clicked => { AboutData.open-log-folder(); }
                    }
                    Pill {
                        height: 32px;
                        label: @tr("Copy diagnostics");
                        clicked => {
                            copy-field.text = AboutData.diagnostics();
                            copy-field.select-all();
                            copy-field.copy();
                            copy-field.clear-selection();
                            AboutData.copied();
                        }
                    }
                }
            }

            VerticalLayout {
                SectionTitle {
                    text: @tr("Licences");
                }
                LicenceRow {
                    divider: false;
                    name: "featherplay";
                    licence: "MIT License";
                    full-text: AboutData.mit-text;
                }
                LicenceRow {
                    name: "Manrope";
                    licence: @tr("SIL Open Font License 1.1. The heading face, embedded.");
                    full-text: AboutData.ofl-text;
                }
                for c in AboutData.credits: LicenceRow {
                    name: c.name;
                    licence: c.licence;
                }
            }

            HorizontalLayout {
                alignment: start;
                MadeWithSlint {
                    width: 200px;
                }
            }
        }
    }

    // Copy diagnostics goes through this: the platform's clipboard, as a copy from a field.
    copy-field := TextInput {
        width: 0;
        height: 0;
        visible: false;
        read-only: true;
        single-line: false;
    }

    // Its track ends above the floating bar.
    if flick.content-height > flick.height: Rectangle {
        property <length> track: flick.height - Theme.bar-clear - 8px;
        property <length> thumb: max(32px, self.track * flick.height / flick.content-height);
        x: parent.width - 8px;
        y: 4px + (self.track - self.thumb) * (-flick.content-y / (flick.content-height - flick.height));
        width: 4px;
        height: self.thumb;
        border-radius: 2px;
        background: Theme.track;
    }
}
