// Playlist page, also Liked songs ("LM"): the same tall header as an album, then
// song rows with covers, the artist and the album. Data comes from `src/pages/playlist.rs`.
// Signed out, Liked songs is the account's: under its header, the page asks to sign in.
// An artist's songs and videos show here too, under a header of the artist's.
//
// The list is a ListView; the header rides in its first row so it scrolls away with it.
// Covers are asked for as rows appear (`cover-needed`), so long playlists load only what's seen.
import { ListView } from "../list_view.slint";
import { Theme, Icons } from "../theme.slint";
import { TrackRow, CardItem, ItemKind, RowsShown, ShownRows, SongList } from "../parts.slint";
import { ItemMenu } from "../item_menu.slint";
import { PlaylistMenu } from "../playlist_menu.slint";
import { SongMenu } from "../song_menu.slint";
import { Nav, PageKind } from "../nav.slint";
import { SidebarData } from "../sidebar.slint";
import { CollectionHeader, SongListRow, SkeletonCollection, HeaderSizes, HeaderTitle, SkeletonList, ErrorState, EmptyState, AccountGate, FadeIn, TopScrim } from "content.slint";

// Where Alt+Up, Alt+Down, Alt+Home and Alt+End move the picked rows: a place up or down,
// to the top or to the end.
export enum ReorderKey { up, down, home, end }

export global PlaylistData {
    in property <bool> loading;
    in property <string> error;
    // "LM" is Liked songs.
    in property <string> id;
    in property <bool> liked-songs;
    in property <string> title;
    // "Playlist".
    in property <string> kind;
    // The playlist's author, when it has one.
    in property <string> byline;
    // "42 songs, 2 hours 5 minutes".
    in property <string> meta;
    in property <image> cover;
    // An artist's songs or videos (its page's "Show all"): the artist's id, which the byline
    // (the artist's name) links back to, and the artist's photo as the cover, round.
    in property <string> artist-id;
    in property <bool> round;
    // The header's wash from the cover, per theme (transparent until it's worked out).
    in property <color> wash-dark;
    in property <color> wash-light;
    in property <[TrackRow]> tracks;
    // Plays the playlist from track `i`.
    callback play(int);
    callback shuffle();
    callback like(int);
    // Row `i` is on screen and has no cover yet.
    callback cover-needed(int);
    // Loads the playlist again after an error.
    callback retry();
    // Playlist `id` is the account's own, as the sidebar's list has it (or made here).
    callback is-own(string) -> bool;
    // The account may edit the playlist shown: its rows can be picked and moved
    // (`src/pages/playlist/reorder.rs`).
    in property <bool> editable;
    // Row `i` clicked, with Ctrl or Shift held or not.
    callback pick(/* i */ int, /* ctrl */ bool, /* shift */ bool);
    // Lets the picked rows go (Esc); whether there were any.
    callback unpick() -> bool;
    // Moves the picked rows by key.
    callback move-picked(ReorderKey);
    // Picks every row (Ctrl+A).
    callback pick-all();
    // A drag starts on row `i`: picked, it takes the rows picked with it, else it alone.
    callback drag-start(int);
    // The rows dragged land before row `i` (at the end past the last).
    callback drop-picked(int);
    // How many rows are picked, the first and the last.
    in property <int> picked-count;
    in property <int> picked-first;
    in property <int> picked-last;
    // Later pages of the playlist are still arriving.
    in property <bool> more-coming;
    // Rows are being dragged; Esc sets it back, ending the drag.
    in-out property <bool> dragging;
    // Rows `reveal-first` to `reveal-last` moved by key: the list scrolls to show them, each
    // time `revealed` counts up.
    in property <int> reveal-first;
    in property <int> reveal-last;
    in property <int> revealed;
}

component Header inherits CollectionHeader {
    cover: PlaylistData.cover;
    round: PlaylistData.round;
    byline-link: PlaylistData.artist-id != "";
    byline-clicked => { Nav.open-artist(PlaylistData.artist-id); }
    liked-tile: PlaylistData.liked-songs;
    wash-dark: PlaylistData.liked-songs ? Theme.brand-accent.transparentize(0.7) : PlaylistData.wash-dark;
    wash-light: PlaylistData.liked-songs ? Theme.brand-accent.transparentize(0.85) : PlaylistData.wash-light;
    kind: PlaylistData.kind;
    byline: PlaylistData.byline;
    title: PlaylistData.title;
    meta: PlaylistData.meta;
    enabled: PlaylistData.tracks.length > 0;
    // An empty playlist (a new one) hides Play and Shuffle rather than greying them.
    plays: PlaylistData.loading || PlaylistData.tracks.length > 0;
    // Signed out, Liked songs has nothing to play: no Play or Shuffle, rather than greyed ones.
    actions: !(PlaylistData.liked-songs && SidebarData.signed-out);
    // The ⋯: the playlist's menu, as its tiles have it (`ItemMenu`: Play next, Add to queue,
    // Pin), or for the account's own the sidebar's (`PlaylistMenu`), with Rename and Delete.
    // Liked songs has its own tile first in Shortcuts and the sidebar.
    more: !PlaylistData.liked-songs;
    property <CardItem> item: { id: PlaylistData.id, kind: ItemKind.playlist, title: PlaylistData.title, subtitle: PlaylistData.byline, cover: PlaylistData.cover };
    more-clicked(x, y, top) => {
        if PlaylistData.is-own(PlaylistData.id) {
            PlaylistMenu.show(root.item, x, y, top);
        } else {
            ItemMenu.show(root.item, false, x, y, top);
        }
    }
    primary-clicked => { PlaylistData.play(0); }
    secondary-clicked => { PlaylistData.shuffle(); }
}

export component PlaylistPage inherits Rectangle {
    // The page runs up under the clear top bar (app.slint), so its header starts below it.
    // Its height: `HeaderSizes`, as the header lays itself out, with the title measured as the
    // stacked header sets it.
    property <length> pad: Theme.pad-for(root.width);
    title-probe := HeaderTitle {
        visible: false;
        width: root.width - 2 * root.pad;
        text: PlaylistData.title;
    }
    property <length> header-h: HeaderSizes.height(root.width, title-probe.preferred-height, PlaylistData.kind != "", PlaylistData.byline != "", PlaylistData.meta != "", !(PlaylistData.liked-songs && SidebarData.signed-out));
    property <bool> sign-in: PlaylistData.liked-songs && SidebarData.signed-out;
    // Loading: the shape of the header and the rows. Liked songs knows its header already.
    if PlaylistData.loading && PlaylistData.title == "": SkeletonCollection { }
    if PlaylistData.loading && PlaylistData.title != "" && !root.sign-in: Rectangle {
        Header {
            x: 0;
            y: 0;
            width: root.width;
        }
        SkeletonList {
            y: root.header-h;
            height: parent.height - self.y;
            count: 6;
        }
    }
    // No tracks (an error, an empty playlist): the header, if any, stands alone.
    if root.sign-in || (!PlaylistData.loading && PlaylistData.tracks.length == 0): FadeIn {
        if PlaylistData.title != "": Header {
            x: 0;
            y: 0;
            width: root.width;
        }
        // The header's tile is the heart already, so the gate has none of its own.
        if root.sign-in: AccountGate {
            x: root.pad;
            y: root.header-h;
            width: min(460px, root.width - 2 * root.pad);
            glyph: "";
            explore: false;
            title: @tr("Sign in to see your liked songs");
            line: @tr("Your account keeps the songs you like, on every device.");
        }
        if PlaylistData.error != "" && !root.sign-in: ErrorState {
            x: root.pad;
            y: PlaylistData.title != "" ? root.header-h : Theme.top-bar-h + Theme.page-top;
            width: min(480px, root.width - 2 * root.pad);
            message: PlaylistData.error;
            retry => { PlaylistData.retry(); }
        }
        if PlaylistData.error == "" && PlaylistData.title != "" && !root.sign-in: EmptyState {
            x: root.pad;
            y: root.header-h;
            width: min(480px, root.width - 2 * root.pad);
            glyph: PlaylistData.liked-songs ? Icons.heart : Icons.note;
            title: PlaylistData.liked-songs ? @tr("Songs you like show up here") : @tr("This playlist is empty");
            line: PlaylistData.liked-songs ? @tr("Like a song with its heart to keep it here.") : @tr("Songs added to it show up here.");
            action: PlaylistData.liked-songs ? @tr("Go to Home") : "";
            action-clicked => { Nav.go(PageKind.home); }
        }
    }
    if PlaylistData.tracks.length > 0 && !root.sign-in: FadeIn {
        // Under the rows and the header: a click on empty space lets the picked rows go.
        TouchArea {
            enabled: PlaylistData.editable;
            clicked => { PlaylistData.unpick(); }
        }
        list := ListView {
            for t[i] in PlaylistData.tracks: Rectangle {
                height: (i == 0 ? root.header-h : 0px) + Theme.row-h + (i == PlaylistData.tracks.length - 1 ? Theme.page-end : 0px);
                init => { PlaylistData.cover-needed(i); }
                if i == 0: Header {
                    x: 0;
                    y: 0;
                    width: parent.width;
                }
                SongListRow {
                    x: root.pad - 8px;
                    y: i == 0 ? root.header-h : 0px;
                    width: parent.width - 2 * root.pad + 16px;
                    track: t;
                    show-liked: !PlaylistData.liked-songs;
                    pickable: PlaylistData.editable;
                    drag-active: drags.active;
                    lifted: drags.active && t.selected;
                    activated => { PlaylistData.play(i); }
                    picked(ctrl, shift) => { PlaylistData.pick(i, ctrl, shift); }
                    drag(y, grab) => {
                        if drags.from < 0 {
                            drags.from = i;
                            drags.grab-y = grab;
                            PlaylistData.drag-start(i);
                            PlaylistData.dragging = true;
                        }
                        drags.view-y = y - list.absolute-position.y;
                    }
                    drop => {
                        if drags.lands {
                            PlaylistData.drop-picked(drags.slot);
                        }
                        drags.end();
                    }
                    drag-cancelled => { drags.end(); }
                    like-clicked => { PlaylistData.like(i); }
                    menu-requested(x, y, top) => { SongMenu.show(t, x, y, top); }
                }
            }
        }
        // Rows moved by key stay in view: between the top bar and the floating bar.
        property <int> revealed: PlaylistData.revealed;
        changed revealed => {
            let top = root.header-h + PlaylistData.reveal-first * Theme.row-h;
            let bottom = root.header-h + (PlaylistData.reveal-last + 1) * Theme.row-h;
            let from = Theme.top-bar-h;
            let to = list.visible-height - Theme.bar-clear;
            if bottom - top > to - from || top + list.content-y < from {
                list.content-y = min(0px, from - top);
            } else if bottom + list.content-y > to {
                list.content-y = max(list.visible-height - list.content-height, to - bottom);
            }
        }
        TopScrim {
            scrolled: -list.content-y;
        }
        RowsShown {
            list: SongList.playlist;
            first: ShownRows.first(-list.content-y, root.header-h, Theme.row-h);
            last: ShownRows.last(-list.content-y, root.header-h, Theme.row-h, list.visible-height - Theme.bar-clear, PlaylistData.tracks.length);
        }

        // Dragging the picked rows, as Up next drags one (`UpNext`): they stay in place,
        // dimmed, a raised copy of the row pressed follows the pointer, and a line shows where
        // they land. Esc ends it (`PlaylistData.dragging`).
        drags := Rectangle {
            width: 0;
            height: 0;
            // The row pressed; where the pointer was in it; the pointer in the list's view.
            in-out property <int> from: -1;
            in-out property <length> grab-y;
            in-out property <length> view-y;
            out property <bool> active: PlaylistData.dragging && self.from >= 0;
            property <int> n: PlaylistData.tracks.length;
            // As in Up next: the rows land above the row under the pointer, or below it when it's
            // below the row pressed; before row `slot`, at the end when it's `n`.
            property <int> under: clamp(floor((self.view-y - list.content-y - root.header-h) / Theme.row-h), 0, self.n - 1);
            out property <int> slot: self.under > self.from ? self.under + 1 : self.under;
            // Rows picked in one run don't move into a gap at or inside it; nothing goes to
            // the end while later songs still arrive (`reorder::move_rows`).
            property <bool> run: PlaylistData.picked-last - PlaylistData.picked-first + 1 == PlaylistData.picked-count;
            property <bool> stays: self.run && self.slot >= PlaylistData.picked-first && self.slot <= PlaylistData.picked-last + 1;
            out property <bool> lands: self.active && !self.stays && !(PlaylistData.more-coming && self.slot >= self.n);
            // The view between the top bar and the floating bar; 56 px bands at its ends
            // scroll the list, faster the deeper in, up to 20 rows a second.
            property <length> top: Theme.top-bar-h;
            property <length> bottom: list.visible-height - Theme.bar-clear;
            out property <float> pull: self.view-y < self.top + Theme.row-h ? -min(1, (self.top + Theme.row-h - self.view-y) / Theme.row-h) : (self.view-y > self.bottom - Theme.row-h ? min(1, (self.view-y - self.bottom + Theme.row-h) / Theme.row-h) : 0);
            out property <length> lowest: min(0px, list.visible-height - list.content-height);
            public function end() {
                self.from = -1;
                PlaylistData.dragging = false;
            }
        }
        Timer {
            interval: 16ms;
            running: drags.active && (drags.pull < 0 ? list.content-y < 0px : (drags.pull > 0 && list.content-y > drags.lowest));
            triggered => {
                list.content-y = clamp(list.content-y - drags.pull * 20 * Theme.row-h * (16ms / 1s), drags.lowest, 0px);
            }
        }
        Rectangle {
            visible: drags.lands;
            x: root.pad;
            y: list.y + list.content-y + root.header-h + drags.slot * Theme.row-h - 1px;
            width: list.width - 2 * root.pad;
            height: 2px;
            border-radius: 1px;
            background: Theme.text1;
        }
        if drags.active: Rectangle {
            x: root.pad - 8px;
            y: clamp(list.y + drags.view-y - drags.grab-y, list.y + Theme.top-bar-h - Theme.row-h / 2, list.y + list.visible-height - Theme.bar-clear - Theme.row-h / 2);
            width: list.width - 2 * root.pad + 16px;
            height: Theme.row-h;
            // Two or more: two card edges stacked under it.
            for k in PlaylistData.picked-count > 1 ? [8px, 4px] : []: Rectangle {
                x: k;
                y: k;
                width: parent.width - 2 * k;
                height: parent.height;
                border-radius: Theme.r-m;
                background: Theme.card;
                border-width: 1px;
                border-color: Theme.card-edge;
                drop-shadow-blur: 8px;
                drop-shadow-offset-y: 2px;
                drop-shadow-color: Theme.cover-shadow;
            }
            Rectangle {
                border-radius: Theme.r-m;
                background: Theme.card;
                drop-shadow-blur: 16px;
                drop-shadow-offset-y: 4px;
                drop-shadow-color: Theme.cover-shadow;
                SongListRow {
                    track: PlaylistData.tracks[drags.from];
                    show-liked: false;
                    copy: true;
                    // Two or more say how many.
                    badge: PlaylistData.picked-count > 1 ? @tr("{n} song" | "{n} songs" % PlaylistData.picked-count) : "";
                }
            }
        }
    }
}
