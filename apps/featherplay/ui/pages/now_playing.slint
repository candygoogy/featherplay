// Now playing: "Playing from …" centred in the stage's header (a click opens the source),
// and under it one block the cover's width, centred in the stage: the cover with a soft
// glow in its colour, the title in the display face (two lines at most) with "Not for me"
// (thumbs-down), like and the song menu pinned at the cover's right edge, the artists, and
// "album · year"; in a short or narrow stage the title steps down a size and the cover gives
// way first. On the right, Up next and Related tabs. The stage sits on a soft wash from the
// cover (always on). Shown full width, without the sidebar; the bottom bar stays. It opens
// with a 200 ms fade and scale from the bar's cover, the side panel following 40 ms later (a
// fade only without motion). The Lyrics toggle glides the cover from the centre to its
// column on the left over `t-lyrics`, the song's title and artist sliding along, as the stage
// takes the lyrics' panel colour and the lines fade in; one eased value (`lyr`) drives all of
// it. A song with no lines to show (none found, a failed lookup) keeps the cover view: the
// Lyrics pill says so, with a note under it saying why. It reads the `Player` global; the
// rest comes from `src/pages/now_playing.rs` through `NowPlayingData`.
import { ListView } from "std-widgets.slint";
import { Theme, Curves, Icons } from "../theme.slint";
import { TrackRow, Body, Display, Cover, IconButton, SongRow, Tabs, Icon } from "../parts.slint";
import { Nav, PageKind, Frame } from "../nav.slint";
import { Player } from "../player.slint";
import { QueueData, UpNext } from "../queue_panel.slint";
import { SkeletonList, FadeIn } from "content.slint";
import { LyricsData, LyricsState, LyricsView } from "lyrics.slint";
import { NotForMeButton, LikeButton } from "../not_for_me.slint";

export global NowPlayingData {
    // Related: loading and its error.
    in property <bool> loading;
    in property <string> error;
    // The current track's cover at `Theme.nowplaying-cover`, or at `nowplaying-cover-wide`
    // while the page draws it larger than that (`cover-wide`, set by the page, which calls
    // `cover-wide-changed` when it changes), so the art is never drawn larger than decoded.
    in property <image> cover;
    in-out property <bool> cover-wide;
    callback cover-wide-changed();
    // The stage's wash from the cover, per theme (`follow::washes_for`); transparent until known.
    in property <color> wash-dark;
    in property <color> wash-light;
    // The album's year, once known ("" otherwise).
    in property <string> year;
    // 0 Up next, 1 Related, 2 Lyrics.
    in-out property <int> tab: 0;
    // The current track's radio, without the track itself.
    in property <[TrackRow]> related;

    callback tab-selected(int);
    callback play-related(int);
    // The song menu for the current track, at this point (window coordinates), ending at the
    // last one when it opens upward.
    callback more(length, length, length);
}

// Text that navigates: a hairline appears under it on hover. As wide as its text, at most
// `room`, eliding past it.
component LinkText inherits Rectangle {
    in property <string> text;
    in property <color> tint: Theme.text1;
    in property <int> weight: 400;
    in property <length> size: Theme.t-body-l;
    in property <bool> enabled: true;
    in property <length> room: 100000px;
    // The text's own width, uncut.
    out property <length> natural: t.preferred-width;
    callback clicked();
    width: min(t.preferred-width, max(0px, root.room));
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    t := Body {
        x: 0;
        width: parent.width;
        height: parent.height;
        text: root.text;
        font-size: root.size;
        font-weight: root.weight;
        color: root.tint;
        vertical-alignment: center;
    }
    if ta.has-hover && root.enabled: Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: root.tint;
    }
}

// Up next and Related, under their pill tabs: Now playing's side panel, and the frame's
// Up next panel (app.slint), so both read the same. `shown`: the frame's panel opened; with
// Related picked it asks Rust for the current track's (cached per track).
export component SideTabs inherits Rectangle {
    in property <bool> shown: true;
    changed shown => {
        if root.shown && NowPlayingData.tab == 1 {
            NowPlayingData.tab-selected(1);
        }
    }
    // While the full lyrics view is open the lyrics show there, so the Lyrics tab steps aside
    // and its place goes to Up next. The user's tab stays in `NowPlayingData.tab` and comes
    // back when the full view closes. With lyrics off in Settings there's no Lyrics tab. A
    // song with no lyrics never opens the full view, so the tab stays and says why.
    property <bool> lyrics-away: LyricsData.showing || !LyricsData.on;
    // The tab shown. `lyrics-away` is read only with the Lyrics tab picked: read first, every
    // tab's `visible` was marked dirty whenever the lyrics view opened or closed, though the
    // tab stayed Up next, and the whole panel repainted in the toggle's first frame
    // (measured 2026-11-01).
    property <int> tab: NowPlayingData.tab == 2 && root.lyrics-away ? 0 : NowPlayingData.tab;
    Tabs {
        x: Theme.s5;
        y: Theme.s3;
        width: parent.width - 2 * Theme.s5;
        labels: root.lyrics-away ? [@tr("Up next"), @tr("Related")] : [@tr("Up next"), @tr("Related"), @tr("Lyrics")];
        active: root.tab;
        selected(i) => {
            NowPlayingData.tab = i;
            NowPlayingData.tab-selected(i);
        }
    }
    // The three tabs stay alive and only show or hide, so a switch creates no rows (the
    // first frame of a switch cost 5–7 ms when it did). Anything that moves by itself
    // (the skeletons) exists only while its tab shows.
    UpNext {
        x: 0;
        y: 64px;
        width: parent.width;
        height: parent.height - self.y;
        visible: root.tab == 0;
    }
    Rectangle {
        x: 0;
        y: 64px;
        width: parent.width;
        height: parent.height - self.y;
        visible: root.tab == 1;
        Body {
            x: Theme.s5;
            y: Theme.s2;
            height: 16px;
            text: @tr("Similar to {}", Player.title);
            font-size: Theme.t-meta;
            color: Theme.text3;
            vertical-alignment: center;
            width: parent.width - 2 * Theme.s5;
        }
        if NowPlayingData.loading && root.tab == 1: SkeletonList {
            y: 32px;
            height: parent.height - self.y;
            pad: Theme.s4 + 8px;
            count: 6;
            // Shaped like the `SongRow`s that replace it.
            compact: true;
        }
        if !NowPlayingData.loading && (NowPlayingData.error != "" || NowPlayingData.related.length == 0): Body {
            x: Theme.s5;
            y: 40px;
            width: parent.width - 2 * Theme.s5;
            height: Theme.row-h;
            text: NowPlayingData.error != "" ? NowPlayingData.error : @tr("Nothing related found");
            color: NowPlayingData.error != "" ? Theme.text2 : Theme.text3;
            wrap: word-wrap;
            vertical-alignment: center;
        }
        if NowPlayingData.related.length > 0: FadeIn {
            ListView {
                x: Theme.s4;
                y: 32px;
                width: parent.width - 2 * Theme.s4;
                // Ends above the floating bar.
                height: parent.height - self.y - Theme.bar-clear;
                for t[i] in NowPlayingData.related: SongRow {
                    track: t;
                    clicked => { NowPlayingData.play-related(i); }
                    play => { NowPlayingData.play-related(i); }
                }
            }
        }
    }
    LyricsView {
        size: Theme.t-lyric-side;
        x: 0;
        y: 64px;
        width: parent.width;
        height: parent.height - self.y;
        visible: root.tab == 2;
        shown: self.visible && root.shown;
    }
}

// Whether lyrics are on screen: Now playing's full lyrics view, or the Lyrics tab picked in
// Now playing's side panel or the frame's Up next panel, whichever the page shows and if it's
// open, with the window neither minimized nor hidden in the tray. One instance, in
// `AppWindow`, which passes its `minimized`; Rust asks for lyrics and times lines only while
// it holds. It also keeps the full view through a lookup that began while it showed
// (`LyricsData.held`), and the Lyrics pill's note for a few seconds (`LyricsData.hint`).
export component LyricsWatch {
    in property <bool> minimized;
    property <bool> live: LyricsData.on && ((NowPlayingData.tab == 2 && (Nav.page == PageKind.now-playing ? Frame.side-open : Frame.queue-open)) || LyricsData.wanted) && !Frame.hidden && !root.minimized;
    changed live => { LyricsData.live-changed(self.live); }
    property <bool> showing: LyricsData.showing;
    changed showing => { LyricsData.held = self.showing; }
    // A lookup a press waited on found nothing to show: the pill's note says why. A new
    // lookup, or lines, take it away. A lookup nobody pressed for shows no note.
    property <LyricsState> state: LyricsData.state;
    changed state => {
        LyricsData.hint = LyricsData.missing && LyricsData.wanted && LyricsData.asked;
        if !LyricsData.looking {
            LyricsData.asked = false;
        }
    }
    // One shot, only while the note shows; a toggle while it shows starts its time again.
    note-time := Timer {
        interval: 4s;
        running: LyricsData.hint;
        triggered => {
            LyricsData.hint = false;
            if !LyricsData.looking {
                LyricsData.asked = false;
            }
        }
    }
    property <int> nudged: LyricsData.nudged;
    changed nudged => { note-time.restart(); }
    // A press was for the song it was made on.
    property <string> track: Player.track-id;
    changed track => { LyricsData.asked = false; }
}

// Lyrics on and off for the stage (the full lyrics view): a tonal pill with the microphone,
// the filled pill while on (white on the lyrics' panel, the panel's colour for its ink). It
// says what the lookup found: "Finding lyrics…" while the one it asked for runs, a quieter
// "No lyrics" when there are none, "Retry lyrics" after a failure (a press asks again). A
// press on "No lyrics", or a lookup a press waited on that ends so, shows a note
// under the pill for a few seconds saying where featherplay looked (`LyricsData.hint`); the
// stage stays.
component LyricsToggle inherits Rectangle {
    in property <bool> on;
    callback clicked();
    height: 40px;
    width: lay.preferred-width;
    border-radius: self.height / 2;
    property <bool> none: !root.on && LyricsData.state == LyricsState.none;
    property <bool> failed: !root.on && LyricsData.state == LyricsState.error;
    // Only for a view asked for: a lookup for the side tab alone leaves the pill as it is.
    property <bool> finding: !root.on && LyricsData.wanted && LyricsData.looking;
    property <string> label: root.failed ? @tr("Retry lyrics") : (root.none ? @tr("No lyrics") : (root.finding ? @tr("Finding lyrics…") : @tr("Lyrics")));
    property <color> ink: root.on ? LyricsData.ink.ground : (root.none || root.finding ? Theme.text2 : Theme.text1);
    background: root.on
        ? (ta.pressed ? Theme.panel-solid-pressed : (ta.has-hover ? Theme.panel-solid-hover : Theme.panel-solid))
        : Theme.tonal(ta.pressed, ta.has-hover);
    animate background { duration: Theme.t-hover; }
    transform-scale: ta.pressed ? Theme.press-scale : 1.0;
    animate transform-scale {
        duration: ta.pressed ? Theme.t-press : Theme.t-release;
        easing: ta.pressed ? Curves.ease-out : Curves.release;
    }
    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.none || root.failed ? LyricsData.message + ". " + LyricsData.why : "";
    accessible-checked: root.on;
    accessible-action-default => { root.clicked(); }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    lay := HorizontalLayout {
        padding-left: 14px;
        padding-right: 18px;
        spacing: 8px;
        alignment: center;
        Icon {
            y: (parent.height - self.height) / 2;
            width: 18px;
            height: 18px;
            commands: Icons.lyrics;
            stroke: root.ink;
        }
        Body {
            text: root.label;
            font-weight: 600;
            color: root.ink;
            vertical-alignment: center;
        }
    }
    // The note, under the pill and ending at its right edge, as the bar's tooltips look; it
    // drops in a few pixels from the pill as it fades.
    property <bool> note: LyricsData.hint && (root.none || root.failed);
    Rectangle {
        x: root.width - self.width;
        y: root.height + Theme.s2 - (root.note ? 0px : 4px);
        width: note-lay.preferred-width;
        height: note-lay.preferred-height;
        border-radius: Theme.r-s;
        background: Theme.card;
        border-width: 1px;
        border-color: Theme.card-edge;
        drop-shadow-blur: 8px;
        drop-shadow-color: Theme.cover-shadow;
        opacity: root.note ? 1 : 0;
        visible: self.opacity > 0;
        animate opacity, y { duration: Theme.t-fast; easing: Curves.ease-out; }
        note-lay := VerticalLayout {
            padding-left: Theme.s3;
            padding-right: Theme.s3;
            padding-top: Theme.s2;
            padding-bottom: Theme.s2;
            spacing: 2px;
            Body {
                text: LyricsData.message;
                font-size: Theme.t-meta;
                font-weight: 600;
                color: Theme.text1;
            }
            Body {
                text: LyricsData.why;
                font-size: Theme.t-meta;
                color: Theme.text2;
            }
        }
    }
}

// Where the queue comes from, centred in the stage's header: a small "Playing from" over
// the source's name and a chevron. A click opens the source (`QueueData.open-source`).
// `ink`, `quiet`: its two text colours (the lyrics' inks on their panel); `on-panel`: its
// hover and press are the panel's.
component SourceButton inherits Rectangle {
    in property <string> source;
    in property <color> ink;
    in property <color> quiet;
    in property <bool> on-panel;
    // The most it may take; the name elides past it.
    in property <length> room;
    callback clicked();
    width: min(lay.preferred-width, root.room);
    height: 44px;
    border-radius: Theme.r-m;
    background: root.on-panel ? Theme.panel-state(ta.pressed, ta.has-hover) : Theme.state(ta.pressed, ta.has-hover);
    animate background { duration: Theme.t-hover; }
    transform-scale: ta.pressed ? Theme.press-scale : 1.0;
    animate transform-scale {
        duration: ta.pressed ? Theme.t-press : Theme.t-release;
        easing: ta.pressed ? Curves.ease-out : Curves.release;
    }
    accessible-role: button;
    accessible-label: @tr("Playing from {}", root.source);
    accessible-action-default => { root.clicked(); }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    lay := VerticalLayout {
        padding-left: Theme.s3;
        padding-right: Theme.s3;
        alignment: center;
        Body {
            text: @tr("Playing from");
            font-size: Theme.t-meta;
            color: root.quiet;
            horizontal-alignment: center;
        }
        HorizontalLayout {
            alignment: center;
            spacing: 2px;
            Body {
                text: root.source;
                font-weight: 600;
                color: root.ink;
                vertical-alignment: center;
            }
            Icon {
                y: (parent.height - self.height) / 2;
                width: 16px;
                height: 16px;
                commands: Icons.chevron-right;
                stroke: root.quiet;
            }
        }
    }
}

export component NowPlayingPage inherits Rectangle {
    // The side panel's width, and the room it takes from the stage. The bar's Up next button
    // shows and hides it (`Frame.side-open`). It slides like the frame's Up next panel: the
    // stage is laid out once at its new width rather than eased (that would lay it out and
    // repaint it on every frame of the slide). Opening, the panel slides in over the stage,
    // which narrows when the slide ends; closing, the stage widens at once under the panel
    // as it slides away. Either way nothing shows empty.
    property <length> panel-w: root.width >= Theme.wide-min ? Theme.nowplaying-side-w : Theme.panel-w;
    // How much of the panel is slid out past the right edge: that eases, not `x`, so the
    // panel stays at the edge while the window resizes.
    property <float> side-out: Frame.side-open ? 0 : 1;
    animate side-out { duration: Frame.side-open ? Theme.t-panel : Theme.t-panel * 0.8; easing: Curves.ease-drawer; }
    // The panel has slid all the way in: set from the slide's end, not bound to it, so the
    // stage's width depends on it alone and isn't re-evaluated on every frame of the slide.
    property <bool> side-in;
    changed side-out => { root.side-in = root.side-out <= 0; }
    property <length> side-w: Frame.side-open && root.side-in ? root.panel-w : 0px;
    property <length> stage-w: self.width - self.side-w;
    // The page runs under the floating bar; the stage centres in the room above it.
    property <length> stage-h: self.height - Theme.bar-clear;
    // The stage's header row: the back button, "Playing from" and the Lyrics pill. The block
    // (the cover and the text under it) centres in the room between it and the bar's fade.
    property <length> head-h: Theme.top-bar-h;
    // Small gaps under the header and under the cover, so a 1280 x 800 window has the
    // full-size cover; a wider one above the bar, so the block never crowds it.
    property <length> room-top: root.head-h + Theme.s2;
    property <length> room-h: root.stage-h - root.room-top - Theme.s5;
    property <length> cover-gap: Theme.s4;
    // The block's text, all of it the cover's width: the title (the display face, two lines at
    // most), the artists and "album · year". Its room is kept whatever the song has, a second
    // title line included, so the cover never moves from song to song. The title keeps the
    // face's own leading: below it (`line-height-factor` < 1) Slint 1.18's elision drops the
    // first of two lines.
    property <length> artists-h: 22px;
    property <length> album-h: 20px;
    property <length> text-rest: root.cover-gap + Theme.s2 + root.artists-h + root.album-h;
    // A short or narrow stage, where the title's display size would leave the cover under
    // `compact-cover`: the title steps down a size, so it stays in proportion to the cover
    // and the cover keeps more of the room.
    property <length> compact-cover: 360px;
    property <bool> compact: min(root.stage-w - 2 * Theme.s9, root.room-h - root.text-rest - 2 * title-probe.preferred-height) < root.compact-cover;
    property <length> block-title: root.compact ? Theme.t-display-s : Theme.t-display-m;
    property <length> title-line: root.compact ? title-probe-s.preferred-height : title-probe.preferred-height;
    property <length> text-h: root.text-rest + 2 * root.title-line;
    // Beside the side panel the cover is at most `nowplaying-cover`. With the panel hidden
    // the stage has the window's width, and the cover grows with it, up to
    // `nowplaying-cover-wide` (about a third of the stage's width), so it doesn't sit small in the
    // middle of a wide room. It changes with the stage's width, in its one relayout.
    property <length> cover-cap: root.side-w > 0 ? Theme.nowplaying-cover : clamp(root.stage-w * 0.32, Theme.nowplaying-cover, Theme.nowplaying-cover-wide);
    property <length> cover-size: max(160px, min(root.cover-cap, root.stage-w - 2 * Theme.s9, root.room-h - root.text-h));
    // Rust decodes the art at the larger size while it's drawn larger than the usual one.
    property <bool> cover-wide: root.cover-size > Theme.nowplaying-cover;
    changed cover-wide => { root.ask-cover(); }
    function ask-cover() {
        if NowPlayingData.cover-wide != root.cover-wide {
            NowPlayingData.cover-wide = root.cover-wide;
            NowPlayingData.cover-wide-changed();
        }
    }
    property <length> cover-x: (root.stage-w - root.cover-size) / 2;
    property <length> cover-y: root.room-top + max(0px, (root.room-h - root.cover-size - root.text-h) / 2);
    property <bool> shown: false;
    property <color> wash: Theme.dark ? NowPlayingData.wash-dark : NowPlayingData.wash-light;
    animate wash { duration: Theme.t-colour; easing: Curves.ease-hover; }
    // No ground of its own: the window's is under it, and the stage and the side panel are
    // opaque, so a ground here would only be one more 4K fill under them in every frame.
    init => {
        root.shown = true;
        root.side-in = Frame.side-open;
        root.ask-cover();
        // Back on the page with lyrics on: it opens on the view, through a lookup if the song
        // changed meanwhile, as when it showed.
        if LyricsData.wanted && !LyricsData.missing {
            LyricsData.held = true;
        }
    }

    // The full lyrics view: the cover small in a column on the left, the lyrics beside it.
    // Only with lines to show (`LyricsData.showing`): a song with none keeps the cover view.
    property <bool> full: LyricsData.showing;
    property <length> fl-pad: Theme.page-pad;
    property <length> fl-top: 72px;
    property <length> fl-cover: clamp(root.stage-w * 0.2, 160px, 280px);
    // The lyrics keep a readable measure; on wide windows the cover column and the lyrics
    // centre as one group in the stage.
    property <length> fl-lyrics-w: min(root.stage-w - 2 * root.fl-pad - root.fl-cover - Theme.s9, 720px);
    property <length> fl-x: max(root.fl-pad, (root.stage-w - root.fl-cover - Theme.s9 - root.fl-lyrics-w) / 2);
    property <length> fl-lyrics-x: root.fl-x + root.fl-cover + Theme.s9;
    property <length> fl-title-y: root.fl-top + Theme.s5 + root.fl-cover + Theme.s5;
    // The full view is made once the page has entered and its side panel slid in, in a frame
    // where nothing else moves, so the first toggle finds it made (and the page's first
    // frame doesn't make it either). One shot per visit; never with lyrics off.
    property <bool> warm: false;
    Timer {
        interval: Theme.t-page + 120ms;
        running: !root.warm && LyricsData.on;
        triggered => { root.warm = true; }
    }

    // The toggle between the cover and the lyrics, as one eased value: 0 the cover view, 1 the
    // lyrics view. Every position, size and colour of the switch is read from it, so it runs
    // as one motion and reverses from wherever it is. The stage takes the panel's colour over
    // the first half and the lines fade in over the second (closing: the other way round), so
    // the lines only ever show on the solid panel. Instant without motion.
    property <float> lyr: root.full ? 1 : 0;
    animate lyr { duration: Theme.t-lyrics; easing: Curves.ease-in-out; }
    // `tint` and `reveal` are set by their `-at` values' change handlers, which compare values:
    // bound to `lyr` straight, everything they mix (the stage's ground, every line's colour)
    // was marked dirty in every frame of the toggle, though each holds still over half of it,
    // and the whole 4K stage repainted for nothing (`tests/app/lyrics_button.rs`).
    property <float> tint-at: min(1, 2 * root.lyr);
    property <float> reveal-at: max(0, 2 * root.lyr - 1);
    property <float> tint: min(1, 2 * root.lyr);
    property <float> reveal: max(0, 2 * root.lyr - 1);
    changed tint-at => { root.tint = root.tint-at; }
    changed reveal-at => { root.reveal = root.reveal-at; }
    // The panel's colour crossfades on its own when the cover changes; the toggle only fades
    // it in and out.
    property <color> panel: LyricsData.ink.ground;
    animate panel { duration: Theme.t-colour; easing: Curves.ease-hover; }
    // On the lyrics' panel, the page's own text takes the panel's inks.
    property <color> ink1: LyricsData.ink.current.mix(Theme.text1, root.tint);
    property <color> ink2: LyricsData.ink.next.mix(Theme.text2, root.tint);
    // The cover, from its place in the cover view to its column in the lyrics view.
    property <length> art-x: root.cover-x + (root.fl-x - root.cover-x) * root.lyr;
    property <length> art-y: root.cover-y + (root.fl-top + Theme.s5 - root.cover-y) * root.lyr;
    property <length> art-size: root.cover-size + (root.fl-cover - root.cover-size) * root.lyr;
    // The cover's and its shadow's scale: 1 while the cover is within half a physical pixel
    // of its full size, the toggle's first and last few frames (it eases in and out), so the
    // art is copied there instead of resampled, ~a quarter of a 4K frame (measured
    // 2026-11-01).
    property <float> art-scale: abs(root.cover-size - root.art-size) < 0.5phx ? 1 : root.art-size / root.cover-size;
    // The title's top: under the cover in either view, sliding with it.
    property <length> title-y: root.cover-y + root.cover-size + root.cover-gap + (root.fl-title-y - root.cover-y - root.cover-size - root.cover-gap) * root.lyr;
    property <length> title-size: root.block-title + (Theme.t-display-s - root.block-title) * root.lyr;

    // The stage's ground, opaque: the ambient wash (the cover's colour from the top, fading
    // out low) laid over the ground beforehand, then the lyrics' panel colour mixed in as the
    // toggle runs, all panel at its end. Skia fills a gradient pixel by pixel
    // (a see-through wash under a see-through panel cost ~40 ms a 4K frame of the toggle, an
    // opaque one 16-25 ms), but a solid fill at memory speed, and the wash only changes down
    // the stage: so it's `wash-bands` solid bands, each a colour level or so from the next,
    // the steps an 8-bit gradient makes anyway (~1 ms a 4K frame).
    property <float> wash-in: root.shown ? 1 : 0;
    animate wash-in { duration: Theme.t-page; easing: Curves.ease-out; }
    property <float> wash-a: root.wash.alpha / 255 * root.wash-in;
    property <color> wash-solid: root.wash.with-alpha(1);
    property <color> ground-top: root.panel.mix(root.wash-solid.mix(Theme.ground, root.wash-a), root.tint);
    property <color> ground-mid: root.panel.mix(root.wash-solid.mix(Theme.ground, root.wash-a * 0.6), root.tint);
    property <color> ground-low: root.panel.mix(Theme.ground, root.tint);
    property <int> wash-bands: 128;
    // The bands are always there, all the panel's colour once the stage is: a ground made by
    // an `if` in the frame it was needed went unpainted in that frame, and the Lyrics pill
    // above it was drawn twice (`tests/lyrics_lines.rs`).
    Rectangle {
        x: 0;
        y: 0;
        width: root.stage-w;
        height: root.height;
        for i in root.wash-bands: Rectangle {
            // Down the stage at the band's middle: the wash's stops at 0, 55 and 100 %.
            property <float> at: (i + 0.5) / root.wash-bands;
            // Whole physical pixels, so neighbours meet without a seam.
            y: Math.round(root.height * i / root.wash-bands / 1phx) * 1phx;
            height: Math.round(root.height * (i + 1) / root.wash-bands / 1phx) * 1phx - self.y;
            background: self.at < 0.55 ? root.ground-top.mix(root.ground-mid, 1 - self.at / 0.55) : root.ground-mid.mix(root.ground-low, 1 - (self.at - 0.55) / 0.45);
        }
    }

    stage := Rectangle {
        x: 0;
        width: root.stage-w;
        opacity: root.shown ? 1.0 : 0.0;
        // From the bar's cover, bottom left.
        transform-origin: { x: Theme.bar-inset + 44px, y: root.height - Theme.bar-inset - Theme.bar-h / 2 };
        transform-scale: root.shown ? 1.0 : Theme.np-from;
        animate opacity, transform-scale { duration: Theme.t-page; easing: Curves.ease-out; }

        IconButton {
            x: Theme.s5;
            y: Theme.s4;
            icon: Icons.back;
            label: @tr("Back");
            tint: root.ink1;
            clicked => { Nav.back(); }
        }
        // "Playing from" in the middle of the header row, clear of the pill on either side;
        // only when the queue's source is known.
        if Player.has-track && QueueData.playing-from != "": SourceButton {
            x: (root.stage-w - self.width) / 2;
            y: Theme.s4 + 20px - self.height / 2;
            room: root.stage-w - 2 * (Theme.s5 + lyrics-pill.width + Theme.s3);
            source: QueueData.playing-from;
            ink: root.ink1;
            quiet: root.ink2;
            on-panel: root.tint > 0.5;
            clicked => { QueueData.open-source(); }
        }

        // The cover is laid out once at the cover view's size and scaled to the lyrics view's,
        // so the toggle moves the art and its shadow as drawn instead of drawing them again at
        // a new size on every frame. The shadow, under it, keeps one shape (its corners are
        // blurred anyway), so skia blurs it once; it scales with the cover (48 to ~30 px).
        // Its opaque ground, all under the cover (a pixel in from the cover's edges, its corners
        // never outside the cover's at either end), lets the renderer skip the shadow under it
        // (change 13): ~15 % of a 4K toggle frame was blending shadow the cover then hid.
        Rectangle {
            x: root.art-x + 1px * root.art-size / root.cover-size;
            y: root.art-y + 1px * root.art-size / root.cover-size;
            width: root.cover-size - 2px;
            height: root.cover-size - 2px;
            transform-origin: { x: 0, y: 0 };
            transform-scale: root.art-scale;
            border-radius: max(Theme.r-xl, Theme.r-l * root.cover-size / root.fl-cover);
            background: Theme.cover-empty;
            drop-shadow-blur: 48px;
            drop-shadow-offset-y: 16px;
            drop-shadow-color: Theme.cover-shadow;
        }
        // A soft glow in the cover's colour (the accent) low under it: the shadow of a shape
        // `glow-in` inside the cover, dropped well down and blurred wide, so it shows only
        // below the cover's lower edge. Laid out, scaled and opaque under the cover as the
        // shadow above is, for the same reasons.
        property <length> glow-in: 24px;
        Rectangle {
            x: root.art-x + stage.glow-in * root.art-size / root.cover-size;
            y: root.art-y + stage.glow-in * root.art-size / root.cover-size;
            width: root.cover-size - 2 * stage.glow-in;
            height: root.cover-size - 2 * stage.glow-in;
            transform-origin: { x: 0, y: 0 };
            transform-scale: root.art-scale;
            border-radius: Theme.r-xl;
            background: Theme.cover-empty;
            drop-shadow-blur: 72px;
            drop-shadow-offset-y: 36px;
            drop-shadow-color: Theme.cover-glow;
        }
        Cover {
            x: root.art-x;
            y: root.art-y;
            width: root.cover-size;
            height: root.cover-size;
            transform-origin: { x: 0, y: 0 };
            transform-scale: root.art-scale;
            // The corners as they look: r-xl in the cover view, r-l in the lyrics' column.
            radius: (Theme.r-xl + (Theme.r-l - Theme.r-xl) * root.lyr) * root.cover-size / root.art-size;
            source: NowPlayingData.cover;
            crossfade: true;
        }

        // The cover view's text is one block the cover's width, every line starting at its
        // left edge (the house style's "one edge, one width"):
        // the title, then the artists, then "album · year", each on its own line and eliding
        // at the block's width on its own.
        //
        // Row 1: the title in the display face, wrapping to a second line and eliding there,
        // beside "Not for me", like and the song menu (the bar's buttons as 40 px targets, a
        // 20 px glyph in `text2`, `Theme.s1` apart). The buttons are pinned at the cover's
        // right edge (their glyphs reach it: the buttons hang `s2` past it, about the room
        // round a glyph), centred on the title's first line, so they keep their place
        // whatever the title is; the title stops `s3` before them. They ride along and fade
        // with the lyrics toggle, and are hidden once it's done. The title slides with the
        // cover and fades into the lyrics' column's wrapped title (`full-title`).
        property <length> buttons-hang: Theme.s2;
        // The title's width: the cover's less the buttons', growing as they fade with the toggle.
        property <length> title-w: root.cover-size - (Player.has-track ? song-buttons.preferred-width - stage.buttons-hang + Theme.s3 : 0px) * (1 - root.lyr);
        // One line of the title at either size, for the buttons' place and the block's room.
        title-probe := Display {
            visible: false;
            // Any text: a line's height comes from the face's metrics.
            text: "0";
            font-size: Theme.t-display-m;
        }
        title-probe-s := Display {
            visible: false;
            text: "0";
            font-size: Theme.t-display-s;
        }
        title := Display {
            x: root.art-x;
            y: root.title-y;
            width: stage.title-w;
            height: self.preferred-height;
            visible: root.lyr < 1;
            text: Player.has-track ? Player.title : @tr("Nothing playing");
            font-size: root.title-size;
            wrap: word-wrap;
            max-lines: 2;
            overflow: elide;
            color: (Player.has-track ? root.ink1 : LyricsData.ink.next.mix(Theme.text3, root.tint)).transparentize(root.lyr);
        }
        song-buttons := HorizontalLayout {
            x: root.art-x + root.cover-size + stage.buttons-hang - self.preferred-width;
            y: root.title-y + (root.title-line - self.preferred-height) / 2;
            width: self.preferred-width;
            height: self.preferred-height;
            spacing: Theme.s1;
            if Player.has-track: NotForMeButton {
                size: 40px;
                visible: root.lyr < 1;
                fade: 1 - root.lyr;
            }
            if Player.has-track: LikeButton {
                width: 40px;
                height: 40px;
                visible: root.lyr < 1;
                fade: 1 - root.lyr;
            }
            if Player.has-track: IconButton {
                width: 40px;
                height: 40px;
                visible: root.lyr < 1;
                fade: 1 - root.lyr;
                icon: Icons.more;
                label: @tr("More");
                filled: true;
                clicked => {
                    NowPlayingData.more(self.absolute-position.x + self.width - 4px, self.absolute-position.y + self.height, self.absolute-position.y);
                }
            }
        }
        full-title := Display {
            x: root.art-x;
            y: root.title-y;
            width: root.fl-cover;
            visible: root.lyr > 0;
            text: Player.has-track ? Player.title : @tr("Nothing playing");
            font-size: root.title-size;
            color: LyricsData.ink.current.transparentize(1 - root.lyr);
            wrap: word-wrap;
        }
        // Row 2: the artists, a link to the first, under the title as it wraps (one line or
        // two). In the lyrics view they move under the column's wrapped title, eliding at the
        // column's width.
        property <length> artists-y: root.title-y + (title.height + Theme.s2) * (1 - root.lyr) + (full-title.preferred-height + Theme.s1) * root.lyr;
        artists := LinkText {
            x: root.art-x;
            y: stage.artists-y;
            height: root.artists-h + 2px * root.lyr;
            room: root.art-size;
            text: Player.artist;
            tint: root.ink1.mix(root.ink2, 1 - root.lyr);
            weight: 600;
            enabled: Player.artist-id != "";
            clicked => { Nav.open-artist(Player.artist-id); }
        }
        // Row 3: "album · year" in `text2`, the album a link, eliding before the year. It
        // fades out over the first half of the lyrics toggle, keeping its place.
        property <length> album-y: stage.artists-y + root.artists-h;
        if Player.album != "": Rectangle {
            x: root.art-x;
            y: stage.album-y;
            width: root.cover-size;
            height: root.album-h;
            album := LinkText {
                x: 0;
                height: parent.height;
                room: parent.width - (NowPlayingData.year != "" ? year.preferred-width : 0px);
                text: Player.album;
                size: Theme.t-body;
                tint: Theme.text2.transparentize(root.tint);
                enabled: Player.album-id != "" && root.lyr < 0.5;
                clicked => { Nav.open-album(Player.album-id); }
            }
            year := Body {
                x: album.width;
                y: 0;
                height: parent.height;
                visible: NowPlayingData.year != "";
                text: " · " + NowPlayingData.year;
                color: Theme.text2.transparentize(root.tint);
                vertical-alignment: center;
            }
        }
        // The lyrics, in the main area under the back button's row. Once made (`warm`) the
        // view stays, hidden while the cover view shows, so opening it makes no lines in its
        // first frame: a song's 80 lines, shaped and laid out at this size, cost 7–10 ms
        // there at 4K. Hidden, nothing in it moves (`shown`).
        if root.warm || root.lyr > 0: LyricsView {
            visible: root.lyr > 0;
            shown: root.lyr > 0;
            x: root.fl-lyrics-x - Theme.s3;
            y: root.fl-top;
            width: root.fl-lyrics-w + 2 * Theme.s3;
            height: root.stage-h - root.fl-top;
            size: root.stage-w >= Theme.lyric-wide-min ? Theme.t-lyric-wide : Theme.t-lyric-full;
            pad-x: Theme.s3;
            bottom: 0;
            card: false;
            reveal: root.reveal;
        }

        // Last, so the note under it shows over the cover. Not there without a song: nothing
        // to look up.
        lyrics-pill := LyricsToggle {
            x: root.stage-w - Theme.s5 - self.width;
            y: Theme.s4;
            visible: LyricsData.on && (Player.has-track || root.full);
            on: root.full;
            clicked => { LyricsData.toggle-view(); }
        }
    }

    // Up next / Related: on the page's entry it comes in 24 px behind the stage. That offset
    // eases on its own, not `x`: an eased `x` followed every resize of the window late.
    property <length> side-enter: root.shown ? 0px : (Theme.moving ? 24px : 0px);
    animate side-enter { duration: Theme.t-page; delay: Theme.fading ? 40ms : 0ms; easing: Curves.ease-out; }
    Rectangle {
        x: root.width - root.panel-w * (1 - root.side-out) + root.side-enter;
        width: root.panel-w;
        visible: root.side-out < 1;
        background: Theme.panel;
        clip: true;
        opacity: root.shown ? 1.0 : 0.0;
        animate opacity { duration: Theme.t-page; delay: Theme.fading ? 40ms : 0ms; easing: Curves.ease-out; }
        Rectangle {
            x: 0;
            width: 1px;
            background: Theme.hairline;
        }
        SideTabs {
            shown: Frame.side-open;
        }
    }
}
