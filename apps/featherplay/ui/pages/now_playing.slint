// Now playing: "Playing from …" centred in the stage's header (a click opens the source),
// and under it one block the cover's width, centred in the stage: the cover with a soft
// glow in its colour, the title in the display face (two lines at most) with "Not for me"
// (thumbs-down), like and the song menu pinned at the cover's right edge, the artists, and
// "album · year"; in a short or narrow stage the title steps down a size and the cover gives
// way first. On the right, Up next and Related tabs on a card that floats as the bar does,
// both tinted from the page. The page sits on the cover's field (`follow::backdrop`): the
// cover blurred wide into its own colours, darker or lighter and calm, the same in both views;
// its colours as soft bands down the page until the picture is made. Shown full width,
// without the sidebar; the bottom bar stays. It opens with a 200 ms fade and scale from the
// bar's cover, the side panel following 40 ms later (a fade only without motion). The Lyrics toggle glides the cover from the
// centre to its column on the left over `t-lyrics`, the song's title and artist sliding
// along, as the lines fade in; one eased value (`lyr`) drives all of it. On a stage under 800 px the lyrics view stacks instead: the song becomes a compact
// header (the cover small in the top left, the title, artists, "album · year" and its buttons
// beside it) and the lines fill the stage under it on the cover's left edge; the toggle glides
// the cover into that corner. A song with no lines to show (none found, a failed lookup) keeps
// the cover view: the Lyrics pill says so, with a note under it saying why. It reads the `Player` global; the
// rest comes from `src/pages/now_playing.rs` through `NowPlayingData`.
import { ListView } from "../list_view.slint";
import { Theme, Curves, Icons } from "../theme.slint";
import { TrackRow, Body, Display, Cover, IconButton, SongRow, Tabs, Icon, RowsShown, ShownRows, SongList } from "../parts.slint";
import { Nav, PageKind, Frame } from "../nav.slint";
import { Player } from "../player.slint";
import { QueueData, UpNext, QueuePanel } from "../queue_panel.slint";
import { SkeletonList, FadeIn } from "content.slint";
import { LyricsData, LyricsState, LyricsView } from "lyrics.slint";
import { SettingsData } from "settings/data.slint";
import { NotForMeButton, LikeButton } from "../not_for_me.slint";
import { Immersive, LyricsMenu, LyricsMoreButton } from "../lyrics_menu.slint";
import { BarTip } from "../bar_tip.slint";

// The bands of Now playing's page down its height: the cover's field at the top, 55 % down
// and at the bottom (`follow::backdrop::Field::stops`).
export struct FieldBands {
    top: color,
    mid: color,
    low: color,
}

// Now playing's page (the picture's size: it runs under the stage and round the Up next card)
// and the lyrics' box in it, as the page last laid them out, and the height of the lines' fade
// at its edges.
export struct StageBox {
    w: length,
    h: length,
    x: length,
    y: length,
    lw: length,
    lh: length,
    edge: length,
}

export global NowPlayingData {
    // Related: loading and its error.
    in property <bool> loading;
    in property <string> error;
    // The current track's cover at `Theme.nowplaying-cover`, or at `nowplaying-cover-wide`
    // while the page draws it larger than that (`cover-wide`, set by the page, which calls
    // `cover-wide-changed` when it changes), so the art is never drawn larger than decoded.
    in property <image> cover;
    in-out property <bool> cover-wide;
    callback cover-wide-changed();
    // The page's ground, per theme, until the picture is in: the song's cover as a calm field
    // in three bands (`follow::backdrop`).
    in property <FieldBands> field-dark;
    in property <FieldBands> field-light;
    // The cover's wash, per theme (`follow::washes_for`), for the Discord preview's banner;
    // transparent until known.
    in property <color> wash-dark;
    in property <color> wash-light;
    // The field as a picture (`src/pages/now_playing/backdrop.rs`): a bank of rows the
    // renderer draws the page from, made once per song for the page's size in physical pixels
    // (`backdrop-w` × `backdrop-h`; drawn stretched to another size until the next is made)
    // and theme (`backdrop-dark`), and the strips the lines fade into at the lyrics' top and
    // bottom, cut from it. Empty while there's none.
    in property <image> backdrop;
    in property <int> backdrop-w;
    in property <int> backdrop-h;
    in property <bool> backdrop-dark;
    in property <image> backdrop-top;
    in property <image> backdrop-bottom;
    // The page's size and where it has its lyrics (set by the page).
    in-out property <StageBox> stage-box;
    // The window is minimized or hidden in the tray (set by `LyricsWatch`).
    in-out property <bool> window-away;
    // The picture is made as soon as a song's cover is known, and kept, while the window is on
    // screen, so Now playing opens on it (minimized, its memory goes as the renderer's does).
    out property <bool> backdrop-keep: !self.window-away;
    // Now playing shows: a picture it needs at once is made on the spot.
    out property <bool> page-shown: Nav.page == PageKind.now-playing && !self.window-away;
    // Something the picture depends on changed (`LyricsWatch`, the page): Rust looks again.
    callback backdrop-changed();
    // The album's year, once known ("" otherwise).
    in property <string> year;
    // The album's page calls it a single, once known.
    in property <bool> single;
    // 0 Up next, 1 Related, 2 Lyrics.
    in-out property <int> tab: 0;
    // The current track's radio, without the track itself.
    in property <[TrackRow]> related;

    callback tab-selected(int);
    callback play-related(int);
    // The song menu for the current track, at this point (window coordinates), ending at the
    // last one when it opens upward.
    callback more(length, length, length);
}

// Text that navigates: a hairline appears under it on hover. As wide as its text, at most
// `room`, eliding past it.
component LinkText inherits Rectangle {
    in property <string> text;
    in property <color> tint: Theme.text1;
    in property <int> weight: 400;
    in property <length> size: Theme.t-body-l;
    in property <bool> enabled: true;
    in property <length> room: 100000px;
    callback clicked();
    width: min(t.preferred-width, max(0px, root.room));
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    t := Body {
        x: 0;
        width: parent.width;
        height: parent.height;
        text: root.text;
        font-size: root.size;
        font-weight: root.weight;
        color: root.tint;
        vertical-alignment: center;
    }
    Rectangle {
        visible: ta.has-hover && root.enabled;
        y: parent.height - 1px;
        height: 1px;
        background: root.tint;
    }
}

// Up next and Related, under their pill tabs: Now playing's side panel, and the frame's
// Up next panel (app.slint), so both read the same. `shown`: the frame's panel opened; with
// Related picked it asks Rust for the current track's (cached per track).
export component SideTabs inherits Rectangle {
    in property <bool> shown: true;
    // Which panel it is, for `RowsShown`: 0 the frame's (the sheet too), 1 Now playing's.
    in property <int> place;
    // Room kept free right of the tabs (the sheet's close button).
    in property <length> trail: 0px;
    changed shown => {
        if root.shown && NowPlayingData.tab == 1 {
            NowPlayingData.tab-selected(1);
        }
    }
    // While the full lyrics view is open the lyrics show there, so the Lyrics tab steps aside
    // and its place goes to Up next. The user's tab stays in `NowPlayingData.tab` and comes
    // back when the full view closes. With lyrics off in Settings there's no Lyrics tab. A
    // song with no lyrics found never opens the full view, so the tab stays and says why.
    property <bool> lyrics-away: LyricsData.shown || !LyricsData.on;
    // The tab shown. `lyrics-away` is read only with the Lyrics tab picked: read first, every
    // tab's `visible` was marked dirty whenever the lyrics view opened or closed, though the
    // tab stayed Up next, and the whole panel repainted in the toggle's first frame
    // (measured 2026-11-01).
    property <int> tab: NowPlayingData.tab == 2 && root.lyrics-away ? 0 : NowPlayingData.tab;
    Tabs {
        x: Theme.s5;
        y: Theme.s3;
        width: parent.width - 2 * Theme.s5 - root.trail;
        labels: root.lyrics-away ? [@tr("Up next"), @tr("Related")] : [@tr("Up next"), @tr("Related"), @tr("Lyrics")];
        active: root.tab;
        selected(i) => {
            NowPlayingData.tab = i;
            NowPlayingData.tab-selected(i);
        }
    }
    // The three tabs stay alive and only show or hide, so a switch creates no rows (the
    // first frame of a switch cost 5–7 ms when it did). Anything that moves by itself
    // (the skeletons) exists only while its tab shows.
    UpNext {
        x: 0;
        y: 64px;
        width: parent.width;
        height: parent.height - self.y;
        visible: root.tab == 0;
        shown: root.shown && root.tab == 0;
        place: root.place;
    }
    Rectangle {
        x: 0;
        y: 64px;
        width: parent.width;
        height: parent.height - self.y;
        visible: root.tab == 1;
        Body {
            x: Theme.s5;
            y: Theme.s2;
            height: 16px;
            text: @tr("Similar to {}", Player.title);
            font-size: Theme.t-meta;
            color: Theme.text3;
            vertical-alignment: center;
            width: parent.width - 2 * Theme.s5;
        }
        if NowPlayingData.loading && root.tab == 1: SkeletonList {
            y: 32px;
            height: parent.height - self.y;
            pad: Theme.s4 + 8px;
            count: 6;
            // Shaped like the `SongRow`s that replace it.
            compact: true;
        }
        Body {
            visible: !NowPlayingData.loading && (NowPlayingData.error != "" || NowPlayingData.related.length == 0);
            x: Theme.s5;
            y: 40px;
            width: parent.width - 2 * Theme.s5;
            height: Theme.row-h;
            text: NowPlayingData.error != "" ? NowPlayingData.error : @tr("Nothing related found");
            color: NowPlayingData.error != "" ? Theme.text2 : Theme.text3;
            wrap: word-wrap;
            vertical-alignment: center;
        }
        if NowPlayingData.related.length > 0: FadeIn {
            RowsShown {
                list: SongList.related;
                part: root.place;
                first: ShownRows.first(-related.content-y, 0, Theme.row-h);
                last: root.shown && root.tab == 1 ? ShownRows.last(-related.content-y, 0, Theme.row-h, related.visible-height, NowPlayingData.related.length) : -1;
            }
            related := ListView {
                x: Theme.s4;
                y: 32px;
                width: parent.width - 2 * Theme.s4;
                // Ends above the floating bar.
                height: parent.height - self.y - Theme.bar-clear;
                for t[i] in NowPlayingData.related: SongRow {
                    track: t;
                    clicked => { NowPlayingData.play-related(i); }
                    play => { NowPlayingData.play-related(i); }
                }
            }
        }
    }
    LyricsView {
        size: LyricsData.side-size;
        x: 0;
        y: 64px;
        width: parent.width;
        height: parent.height - self.y;
        visible: root.tab == 2;
        shown: self.visible && root.shown;
    }
}

// Whether lyrics are on screen: Now playing's full lyrics view, or the Lyrics tab picked in
// Now playing's side panel or the frame's Up next panel, whichever the page shows and if it's
// open, with the window neither minimized nor hidden in the tray; or the desktop lyrics'
// strip, whatever the window shows. One instance, in
// `AppWindow`, which passes its `minimized`; Rust asks for lyrics and times lines only while
// it holds. It also keeps the full view through a lookup that began while it showed
// (`LyricsData.held`), and the Lyrics pill's note for a few seconds (`LyricsData.hint`).
export component LyricsWatch {
    in property <bool> minimized;
    // The window's size: Now playing's picture is made for it before the page shows.
    in property <length> window-w;
    in property <length> window-h;
    property <bool> main-live: LyricsData.on && ((NowPlayingData.tab == 2 && Frame.tabs-open) || LyricsData.wanted) && !Frame.hidden && !root.minimized;
    property <bool> live: root.main-live || (LyricsData.on && LyricsData.desktop);
    changed live => {
        LyricsData.on-screen = self.live;
        LyricsData.live-changed(self.live);
    }
    changed main-live => {
        LyricsData.decorations-on-screen = self.main-live;
        LyricsData.decorations-live-changed(self.main-live);
    }
    property <bool> showing: LyricsData.showing;
    changed showing => {
        LyricsData.held = self.showing;
        LyricsData.shown = self.showing;
    }
    init => { LyricsData.shown = self.showing; }
    // A lookup a press waited on found nothing to show: the pill's note says why. A new
    // lookup, or lines, take it away. A lookup nobody pressed for shows no note.
    property <LyricsState> state: LyricsData.state;
    changed state => {
        LyricsData.hint = LyricsData.missing && LyricsData.wanted && LyricsData.asked;
        if !LyricsData.looking {
            LyricsData.asked = false;
        }
    }
    // One shot, only while the note shows; a toggle while it shows starts its time again.
    note-time := Timer {
        interval: 4s;
        running: LyricsData.hint;
        triggered => {
            LyricsData.hint = false;
            if !LyricsData.looking {
                LyricsData.asked = false;
            }
        }
    }
    property <int> nudged: LyricsData.nudged;
    changed nudged => { note-time.restart(); }
    // A press was for the song it was made on.
    property <string> track: Player.track-id;
    changed track => { LyricsData.asked = false; }
    // Now playing's picture: whether it's wanted, the page it's for, the theme and the window's
    // size. None of them changes while a song plays.
    property <bool> away: Frame.hidden || root.minimized;
    changed away => { NowPlayingData.window-away = self.away; }
    property <bool> bd-keep: NowPlayingData.backdrop-keep;
    property <bool> bd-page: NowPlayingData.page-shown;
    property <bool> bd-theme: Theme.dark;
    property <length> bd-w: root.window-w;
    property <length> bd-h: root.window-h;
    changed bd-keep => { NowPlayingData.backdrop-changed(); }
    changed bd-page => { NowPlayingData.backdrop-changed(); }
    changed bd-theme => { NowPlayingData.backdrop-changed(); }
    changed bd-w => { NowPlayingData.backdrop-changed(); }
    changed bd-h => { NowPlayingData.backdrop-changed(); }
}

// Lyrics on and off for the stage (the full lyrics view): a tonal pill with the microphone,
// the filled pill while on (the panel's solid, its colour for the ink). It
// says what the lookup found: "Finding lyrics…" while the one it asked for runs, a quieter
// "No lyrics" when there are none, "Retry lyrics" after a failure (a press asks again). A
// press on "No lyrics", or a lookup a press waited on that ends so, shows a note
// under the pill for a few seconds saying where featherplay looked (`LyricsData.hint`); the
// stage stays.
component LyricsToggle inherits Rectangle {
    in property <bool> on;
    callback clicked();
    height: 40px;
    width: lay.preferred-width;
    border-radius: self.height / 2;
    property <bool> none: !root.on && LyricsData.state == LyricsState.none;
    property <bool> failed: !root.on && LyricsData.state == LyricsState.error;
    // Only for a view asked for: a lookup for the side tab alone leaves the pill as it is.
    property <bool> finding: !root.on && LyricsData.wanted && LyricsData.looking;
    property <string> label: root.failed ? @tr("Retry lyrics") : (root.none ? @tr("No lyrics") : (root.finding ? @tr("Finding lyrics…") : @tr("Lyrics")));
    property <color> ink: root.on ? LyricsData.ink.ground : (root.none || root.finding ? LyricsData.ink.next : LyricsData.ink.current);
    background: root.on
        ? Theme.panel-solid-state(ta.pressed, ta.has-hover)
        : Theme.tonal(ta.pressed, ta.has-hover);
    animate background { duration: Theme.t-hover; }
    transform-scale: ta.pressed ? Theme.press-scale : 1.0;
    animate transform-scale {
        duration: ta.pressed ? Theme.t-press : Theme.t-release;
        easing: ta.pressed ? Curves.ease-out : Curves.release;
    }
    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.none || root.failed ? LyricsData.message + ". " + LyricsData.why : "";
    accessible-checked: root.on;
    accessible-action-default => { root.clicked(); }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    lay := HorizontalLayout {
        padding-left: 14px;
        padding-right: 18px;
        spacing: 8px;
        alignment: center;
        Icon {
            y: (parent.height - self.height) / 2;
            width: 18px;
            height: 18px;
            commands: Icons.lyrics;
            stroke: root.ink;
        }
        Body {
            text: root.label;
            font-weight: 600;
            color: root.ink;
            vertical-alignment: center;
        }
    }
    // The note, under the pill and ending at its right edge, as the bar's tooltips look; it
    // drops in a few pixels from the pill as it fades.
    property <bool> note: LyricsData.hint && (root.none || root.failed);
    Rectangle {
        x: root.width - self.width;
        y: root.height + Theme.s2 - (root.note ? 0px : 4px);
        width: note-lay.preferred-width;
        height: note-lay.preferred-height;
        border-radius: Theme.r-s;
        background: Theme.card;
        border-width: 1px;
        border-color: Theme.card-edge;
        drop-shadow-blur: 8px;
        drop-shadow-color: Theme.cover-shadow;
        opacity: root.note ? 1 : 0;
        visible: self.opacity > 0;
        animate opacity, y { duration: Theme.t-fast; easing: Curves.ease-out; }
        note-lay := VerticalLayout {
            padding-left: Theme.s3;
            padding-right: Theme.s3;
            padding-top: Theme.s2;
            padding-bottom: Theme.s2;
            spacing: 2px;
            Body {
                text: LyricsData.message;
                font-size: Theme.t-meta;
                font-weight: 600;
                color: Theme.text1;
            }
            Body {
                text: LyricsData.why;
                font-size: Theme.t-meta;
                color: Theme.text2;
            }
        }
    }
}

// Translate or Romanize, left of the lyrics menu's ⋯ and built as it is: round, tonal, the
// glyph in the lines' ink. On, a ring in that ink, not a fill: the Lyrics pill stays the one
// solid on the panel. While the answer is on its way, a quarter of the ring turns on a
// fainter track. Resting on it shows the bar's tooltip, under it.
component LyricsExtraButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <string> hint;
    in property <bool> on;
    in property <bool> loading;
    callback clicked();
    width: 40px;
    height: 40px;
    border-radius: self.height / 2;
    property <brush> ground: Theme.panel-tonal(ta.pressed, ta.has-hover);
    animate ground { duration: Theme.t-hover; }
    background: root.ground;
    accessible-role: button;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.on;
    accessible-action-default => { root.clicked(); }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            tip.dismiss();
            root.clicked();
        }
    }
    Icon {
        width: 19px;
        height: 19px;
        commands: root.icon;
        stroke-width: 1.8px;
        stroke: LyricsData.ink.current;
    }
    // The ring: the line ink when on; the track under the turning arc while loading.
    if root.on: Rectangle {
        border-radius: self.height / 2;
        border-width: 1.5px;
        border-color: root.loading ? Theme.panel-tonal(false, true) : LyricsData.ink.current;
    }
    if root.on && root.loading: Path {
        width: root.width;
        height: root.height;
        viewbox-width: 40;
        viewbox-height: 40;
        // A quarter of the ring, 1.5 px wide along its inside edge.
        commands: "M 20 0.75 A 19.25 19.25 0 0 1 39.25 20";
        stroke: LyricsData.ink.current;
        stroke-width: 1.5px;
        stroke-line-cap: round;
        fill: transparent;
        transform-rotation: Theme.moving ? mod(animation-tick() / 1ms, 900) / 900 * 360deg : 30deg;
    }
    tip := BarTip {
        over: ta.has-hover;
        name: root.label;
        hint: root.hint;
        under: true;
    }
}

global LyricsDecorationIcons {
    // Two original 24 px-grid marks: scripts becoming an A (translation), and a line of
    // non-Latin text crossing an arrow into Latin letters (romanization).
    out property <string> translation: "M3.5 5.5 H13.5 M8.5 3 V5.5 M5 8.5 C6.4 11.7 9.1 14 12.5 15.4 M12.5 8.5 C11.3 12.2 8.3 15.3 4 17 M14 20 L17.5 10.5 L21 20 M15.2 16.8 H19.8";
    out property <string> romanization: "M3 4.5 H10 V13.5 H3 Z M5 7 H8 M5 10 H8 M11.5 9 H16 M13.8 6.8 L16.2 9 L13.8 11.2 M15 20 L18 12.5 L21 20 M16.2 17 H19.8";
}

// Where the queue comes from, centred in the stage's header: a small "Playing from" over
// the source's name and a chevron. A click opens the source (`QueueData.open-source`).
// `ink`, `quiet`: its two text colours (the lyrics' inks on their panel); `on-panel`: its
// hover and press are the panel's.
component SourceButton inherits Rectangle {
    in property <string> source;
    in property <color> ink;
    in property <color> quiet;
    in property <bool> on-panel;
    // The most it may take; the name elides past it.
    in property <length> room;
    callback clicked();
    width: min(lay.preferred-width, root.room);
    height: 44px;
    border-radius: Theme.r-m;
    background: root.on-panel ? Theme.panel-state(ta.pressed, ta.has-hover) : Theme.state(ta.pressed, ta.has-hover);
    animate background { duration: Theme.t-hover; }
    transform-scale: ta.pressed ? Theme.press-scale : 1.0;
    animate transform-scale {
        duration: ta.pressed ? Theme.t-press : Theme.t-release;
        easing: ta.pressed ? Curves.ease-out : Curves.release;
    }
    accessible-role: button;
    accessible-label: @tr("Playing from {}", root.source);
    accessible-action-default => { root.clicked(); }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    lay := VerticalLayout {
        padding-left: Theme.s3;
        padding-right: Theme.s3;
        alignment: center;
        Body {
            text: @tr("Playing from");
            font-size: Theme.t-meta;
            color: root.quiet;
            horizontal-alignment: center;
        }
        HorizontalLayout {
            alignment: center;
            spacing: 2px;
            Body {
                text: root.source;
                font-weight: 600;
                color: root.ink;
                vertical-alignment: center;
            }
            Icon {
                y: (parent.height - self.height) / 2;
                width: 16px;
                height: 16px;
                commands: Icons.chevron-right;
                stroke: root.quiet;
            }
        }
    }
}

// A strip of the page round the Up next card: the page's bands there (`background`), or with
// `pictured` the part of the cover's picture that lies there. The picture is laid out whole
// and clipped to the strip (the renderer draws only the rows the strip shows), so the card's
// own pixels are never drawn under it, and a strip that changes repaints itself, not the card.
component Gutter inherits Rectangle {
    in property <bool> pictured;
    in property <length> page-w;
    in property <length> page-h;
    clip: true;
    Image {
        x: -root.x;
        y: -root.y;
        width: root.page-w;
        height: root.page-h;
        visible: root.pictured;
        source: NowPlayingData.backdrop;
        image-fit: fill;
    }
}

// One part of the player bar on the song's cover field (`BarField` in bottom_bar.slint): the
// bank drawn where the page draws it, the bar's top left at `at-x`, `at-y` in the page,
// clipped to the part, toned toward `Theme.on-field-tone` as its rows are copied (the image's
// `colorize`, the vendored renderer's change 25). A rounded clip is anti-aliased, every row
// through it drawn through its mask, and it rounds all four corners: so only the bar's ends
// (`round`) clip round, and its middle, drawn over their inner halves, clips square. The
// renderer copies only the rows a repaint shows.
export component FieldPiece inherits Rectangle {
    in property <length> at-x;
    in property <length> at-y;
    in property <length> page-w;
    in property <length> page-h;
    // The clip's corners (bound here: Slint rounds a clip only by a radius its component binds).
    in property <length> round;
    border-radius: root.round;
    clip: true;
    Image {
        x: -root.at-x - root.x;
        y: -root.at-y - root.y;
        width: root.page-w;
        height: root.page-h;
        source: NowPlayingData.backdrop;
        image-fit: fill;
        colorize: Theme.on-field-tone;
    }
}

export component NowPlayingPage inherits Rectangle {
    // Immersive mode keeps this page's field, song information and lyrics, while its chrome
    // fades until the pointer moves. Up next stays away so revealing controls never relayouts
    // the song and lines.
    property <bool> immersive: Immersive.active;
    property <float> chrome: !root.immersive || Immersive.controls ? 1 : 0;
    animate chrome { duration: Theme.t-fast; easing: Curves.ease-out; }
    // The side panel's width, and the room it takes from the stage. The bar's Up next button
    // shows and hides it (`Frame.side-open`); in a window too narrow for it, it steps aside
    // for the Up next sheet (`Frame.side-shown`). It slides like the frame's Up next panel: the
    // stage is laid out once at its new width rather than eased (that would lay it out and
    // repaint it on every frame of the slide). Opening, the panel slides in over the stage,
    // which narrows when the slide ends; closing, the stage widens at once under the panel
    // as it slides away. Either way nothing shows empty.
    property <length> panel-w: root.width >= Theme.wide-min ? Theme.nowplaying-side-w : Theme.panel-w;
    // How much of the panel is slid out past the right edge: that eases, not `x`, so the
    // panel stays at the edge while the window resizes.
    property <bool> side-shown: Frame.side-shown && !root.immersive;
    property <float> side-out: root.side-shown ? 0 : 1;
    animate side-out { duration: root.side-shown ? Theme.t-panel : Theme.t-panel * 0.8; easing: Curves.ease-drawer; }
    // The panel has slid all the way in: set from the slide's end, not bound to it, so the
    // stage's width depends on it alone and isn't re-evaluated on every frame of the slide.
    property <bool> side-in;
    changed side-out => { root.side-in = root.side-out <= 0; }
    // The stage leaves the panel its room: from the slide in's end until the slide out starts.
    // Set by handlers, never bound, so the stage's width hangs on this alone and only changes
    // when it does. Bound to `Frame.side-shown` and `side-in`, either the slide in's start
    // marked the stage dirty (repainting ~64 % of a 4K window though nothing there changed),
    // or, read the other way round, `side-in` turning false marked it dirty again as the
    // slide out started: the first closing ran 3 ms longer before it drew (2026-11-20).
    property <bool> narrow;
    changed side-in => { root.narrow = root.side-in && root.side-shown; }
    changed side-shown => {
        if !self.side-shown {
            root.narrow = false;
        }
    }
    property <length> side-w: root.narrow ? root.panel-w : 0px;
    property <length> stage-w: self.width - self.side-w;
    // The page runs under the floating bar; the stage centres in the room above it.
    property <length> stage-h: root.immersive ? self.height : self.height - Theme.bar-clear;
    // The stage's header row: the back button, "Playing from" and the Lyrics pill. The block
    // (the cover and the text under it) centres in the room between it and the bar's fade.
    property <length> head-h: root.in-bar ? 56px : 64px;
    // With the window's own title bar the header row is the window's top row (`in-bar`):
    // its controls are the row's 36 px, Back is the row's own (`TopBar`), the window buttons
    // sit right of it over the side panel (or at the stage's end without one), and its free
    // space drags the window: the controls tell the row where they are (`Frame.np-*`).
    property <bool> in-bar: Frame.own-bar && !root.immersive;
    property <length> head-y: root.in-bar ? (Theme.top-bar-h - Theme.top-control) / 2 : Theme.s4;
    property <length> head-control: root.in-bar ? Theme.top-control : 40px;
    property <length> head-end: !root.in-bar ? root.stage-w - Theme.s5 : (root.side-w > 0 ? root.stage-w - Theme.s4 : root.stage-w - 3 * Theme.caption-w - Theme.s3);
    // Small gaps under the header and under the cover, so a 1280 x 800 window has the
    // full-size cover; a wider one above the bar, so the block never crowds it.
    property <length> room-top: root.head-h + Theme.s2;
    property <length> room-h: root.stage-h - root.room-top - Theme.s5;
    property <length> cover-gap: Theme.s4;
    // A stage under 800 px (a narrow window): the lyrics view stacks, the song as a compact
    // header over the lines (`hd-*`), and the cover view's block keeps the page's padding at
    // its sides rather than `s9`, so turning lyrics on shrinks the cover in place.
    property <bool> stack: root.stage-w < 800px;
    property <length> pad: Theme.pad-for(root.stage-w);
    property <length> side: root.stack ? root.pad : Theme.s9;
    // The block's text, all of it the cover's width: the title (the display face, two lines at
    // most), the artists and "album · year". Its room is kept whatever the song has, a second
    // title line included, so the cover never moves from song to song. The title keeps the
    // face's own leading: below it (`line-height-factor` < 1) Slint 1.18's elision drops the
    // first of two lines.
    property <length> artists-h: 22px;
    property <length> album-h: 20px;
    property <length> text-rest: root.cover-gap + Theme.s2 + root.artists-h + root.album-h;
    // A short or narrow stage, where the title's display size would leave the cover under
    // `compact-cover`: the title steps down a size, so it stays in proportion to the cover
    // and the cover keeps more of the room.
    property <length> compact-cover: 360px;
    property <bool> compact: min(root.stage-w - 2 * root.side, root.room-h - root.text-rest - 2 * title-probe.preferred-height) < root.compact-cover;
    property <length> block-title: root.compact ? Theme.t-display-s : Theme.t-display-m;
    property <length> title-line: root.compact ? title-probe-s.preferred-height : title-probe.preferred-height;
    property <length> text-h: root.text-rest + 2 * root.title-line;
    // Beside the side panel the cover is at most `nowplaying-cover`. With the panel hidden
    // the stage has the window's width, and the cover grows with it, up to
    // `nowplaying-cover-wide` (about a third of the stage's width), so it doesn't sit small in the
    // middle of a wide room. It changes with the stage's width, in its one relayout.
    property <length> cover-cap: root.side-w > 0 ? Theme.nowplaying-cover : clamp(root.stage-w * 0.32, Theme.nowplaying-cover, Theme.nowplaying-cover-wide);
    property <length> cover-size: max(160px, min(root.cover-cap, root.stage-w - 2 * root.side, root.room-h - root.text-h));
    // Rust decodes the art at the larger size while it's drawn larger than the usual one:
    // not in the lyrics view, which draws it in its column, smaller than the usual one (Up
    // next coming or going there made a decode beside the stage's relayout for nothing).
    property <bool> cover-wide: root.cover-size > Theme.nowplaying-cover && !root.full;
    changed cover-wide => { root.ask-cover(); }
    function ask-cover() {
        if NowPlayingData.cover-wide != root.cover-wide {
            NowPlayingData.cover-wide = root.cover-wide;
            NowPlayingData.cover-wide-changed();
        }
    }
    property <length> cover-x: (root.stage-w - root.cover-size) / 2;
    property <length> cover-y: root.room-top + max(0px, (root.room-h - root.cover-size - root.text-h) / 2);
    property <bool> shown: false;
    // The field's bands for the theme, crossfading to the next song's.
    property <color> field-top: Theme.pick(NowPlayingData.field-dark.top, NowPlayingData.field-light.top);
    property <color> field-mid: Theme.pick(NowPlayingData.field-dark.mid, NowPlayingData.field-light.mid);
    property <color> field-low: Theme.pick(NowPlayingData.field-dark.low, NowPlayingData.field-light.low);
    animate field-top, field-mid, field-low { duration: Theme.t-colour; easing: Curves.ease-hover; }
    // No ground of its own: the window's is under it, and the stage and the side panel are
    // opaque, so a ground here would only be one more 4K fill under them in every frame.
    init => {
        root.shown = true;
        root.side-in = root.side-shown;
        root.narrow = root.side-in;
        // Set here and by their handlers, never bound: a binding to the eased toggle would last
        // until a handler first set them, and mark what they show dirty in every frame of the
        // first toggle (the card round its strips: `tests/app/lyrics_button.rs`).
        root.pictured = root.pictured-at;
        // `tint` and `reveal` too: bound to the toggle until a handler first set them, the
        // session's first toggle repainted the hidden lyrics view's whole box (2026-11-21).
        root.tint = root.tint-at;
        root.reveal = root.reveal-at;
        root.ask-cover();
        root.tell-backdrop();
        root.tell-row();
        // Back on the page with lyrics on: it opens on the view, through a lookup if the song
        // changed meanwhile, as when it showed.
        if LyricsData.wanted && !LyricsData.missing {
            LyricsData.held = true;
        }
    }

    // The full lyrics view: the cover small in a column on the left, the lyrics beside it.
    // Only with lines to show, or none by the user's choice (`LyricsData.showing`): a song
    // with none found keeps the cover view.
    property <bool> full: LyricsData.shown;
    property <length> fl-pad: root.pad;
    property <length> fl-top: root.in-bar ? 56px : 72px;
    property <length> fl-cover: clamp(root.stage-w * 0.2, 160px, 280px);
    // The lyrics keep a readable measure; on wide windows the cover column and the lyrics
    // centre as one group in the stage.
    property <length> fl-lyrics-w: min(root.stage-w - 2 * root.fl-pad - root.fl-cover - Theme.s9, 720px);
    property <length> fl-x: max(root.fl-pad, (root.stage-w - root.fl-cover - Theme.s9 - root.fl-lyrics-w) / 2);
    property <length> fl-lyrics-x: root.fl-x + root.fl-cover + Theme.s9;
    property <length> fl-title-y: root.fl-top + Theme.s5 + root.fl-cover + Theme.s5;
    // Stacked (`stack`): the song as a header in the stage's top left, under the back button's
    // row: the cover, and beside it the title (one line), the artists, "album · year" and the
    // song's buttons at the cover's foot. The lines fill the stage below it, on the cover's
    // left edge, at about the side tab's size. The cover is just tall enough for the text and
    // the buttons, so the header's height is the same for every song.
    property <bool> small: root.stage-w < 560px;
    property <length> hd-top: root.in-bar ? 60px : 76px;
    property <length> hd-cover: root.small ? 120px : 128px;
    property <length> hd-title: root.small ? Theme.t-display-s : Theme.t-display-s + 4px;
    property <length> hd-text-x: root.pad + root.hd-cover + Theme.s4 + Theme.s1;
    property <length> hd-text-w: root.stage-w - root.pad - root.hd-text-x;
    property <length> hd-lines-y: root.hd-top + root.hd-cover + Theme.s5 + Theme.s1;
    // The lyrics view's box in the stage: beside the cover's column, or stacked under the header.
    property <length> lines-x: (root.stack ? root.pad : root.fl-lyrics-x) - Theme.s3;
    property <length> lines-y: root.stack ? root.hd-lines-y : root.fl-top;
    property <length> lines-w: (root.stack ? root.stage-w - 2 * root.pad : root.fl-lyrics-w) + 2 * Theme.s3;
    property <length> hd-lyric: (LyricsData.size == 0 ? 17px : (LyricsData.size == 2 ? 24px : Theme.t-lyric-side)) + (root.small ? 0px : 2px);
    // Where the cover glides to, and its size and corners there: the column's or the header's.
    property <length> to-x: root.stack ? root.pad : root.fl-x;
    property <length> to-y: root.stack ? root.hd-top : root.fl-top + Theme.s5;
    property <length> to-size: root.stack ? root.hd-cover : root.fl-cover;
    property <length> to-radius: root.stack ? Theme.r-m : Theme.r-l;
    property <length> to-title-y: root.stack ? root.hd-top : root.fl-title-y;
    property <length> to-title: root.stack ? root.hd-title : Theme.t-display-s;
    // The full view is made once the page has entered and its side panel slid in, in a frame
    // where nothing else moves, so the first toggle finds it made (and the page's first
    // frame doesn't make it either). One shot per visit; never with lyrics off.
    property <bool> warm: false;
    Timer {
        interval: Theme.t-page + 120ms;
        running: !root.warm && LyricsData.on;
        triggered => { root.warm = true; }
    }

    // The toggle between the cover and the lyrics, as one eased value: 0 the cover view, 1 the
    // lyrics view. Every position and size of the switch is read from it, so it runs as one
    // motion and reverses from wherever it is. The page keeps its ground and its text's inks
    // (the field's, in both views); the song's text fades out over the first half and the lines
    // fade in over the second (closing: the other way round). Instant without motion.
    property <float> lyr: root.full ? 1 : 0;
    animate lyr { duration: Theme.t-lyrics; easing: Curves.ease-in-out; }
    // `tint` and `reveal` are set by their `-at` values' change handlers, which compare values:
    // bound to `lyr` straight, everything they mix (every line's colour) was marked dirty in
    // every frame of the toggle, though each holds still over half of it, and the whole 4K
    // stage repainted for nothing (`tests/app/lyrics_button.rs`). Never bound: `init` sets
    // them first.
    property <float> tint-at: min(1, 2 * root.lyr);
    property <float> reveal-at: max(0, 2 * root.lyr - 1);
    property <float> tint;
    property <float> reveal;
    changed tint-at => { root.tint = root.tint-at; }
    changed reveal-at => { root.reveal = root.reveal-at; }
    // The page's own text, on the field in either view: the lyrics' inks for the line playing
    // and the lines to come, which keep their floors on every pixel of it.
    property <color> ink1: LyricsData.ink.current;
    property <color> ink2: LyricsData.ink.next;
    // The cover, from its place in the cover view to its column in the lyrics view.
    property <length> art-x: root.cover-x + (root.to-x - root.cover-x) * root.lyr;
    property <length> art-y: root.cover-y + (root.to-y - root.cover-y) * root.lyr;
    property <length> art-size: root.cover-size + (root.to-size - root.cover-size) * root.lyr;
    // The cover's and its shadow's scale: 1 while the cover is within half a physical pixel
    // of its full size, the toggle's first and last few frames (it eases in and out), so the
    // art is copied there instead of resampled, ~a quarter of a 4K frame (measured
    // 2026-11-01).
    property <float> art-scale: abs(root.cover-size - root.art-size) < 0.5phx ? 1 : root.art-size / root.cover-size;
    // The title's top: under the cover in either view, sliding with it.
    property <length> title-y: root.cover-y + root.cover-size + root.cover-gap + (root.to-title-y - root.cover-y - root.cover-size - root.cover-gap) * root.lyr;
    property <length> title-size: root.block-title + (root.to-title - root.block-title) * root.lyr;
    // The text's left edge: under the cover, or stacked, sliding to the header's text beside it.
    property <length> text-x: root.art-x + (root.stack ? (root.hd-text-x - root.pad) * root.lyr : 0px);

    // The picture's place, for Rust (`StageBox`). The whole page, so Up next sliding in or out
    // moves its card over a picture already there; it changes with the window's size (and the
    // lyrics' box with Up next coming or going), never during the toggle or the slide.
    property <StageBox> stage-box: {
        w: root.width,
        h: root.height,
        x: root.lines-x,
        y: root.lines-y,
        lw: root.lines-w,
        lh: root.stage-h - root.lines-y,
        edge: Theme.lyric-edge,
    };
    changed stage-box => { root.tell-backdrop(); }
    function tell-backdrop() {
        NowPlayingData.stage-box = root.stage-box;
        NowPlayingData.backdrop-changed();
    }
    // The picture shows whenever there's one for the theme: made before the page opens, so the
    // page opens on it, and made on the spot for a new theme; stretched while the window is
    // being sized. The bands, made from the same field as the page draws it, are left for the
    // rare frames with none (the very first song's cover still on its way). A new song's
    // picture takes the last one's place when it's in, without a fade; turning lyrics on or
    // off doesn't touch it. Read through a change handler, as `tint` is.
    property <bool> pictured-at: NowPlayingData.backdrop.width > 0 && NowPlayingData.backdrop-dark == Theme.dark;
    property <bool> pictured;
    changed pictured-at => { root.pictured = root.pictured-at; }

    // The field as a picture under the stage: the renderer draws only the rows the frame
    // repaints, each a copy of its block's row in the bank (`follow::backdrop`). The Up next
    // card's strips draw their part of it below (`Gutter`).
    Rectangle {
        x: 0;
        y: 0;
        width: root.stage-w;
        height: root.height;
        clip: true;
        visible: root.pictured;
        Image {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            source: NowPlayingData.backdrop;
            image-fit: fill;
        }
    }

    // The page's ground until the picture is in, opaque: the field's three colours down the
    // page, faded in from the window's ground as the page enters. The same in both views, so
    // the toggle changes no ground. Skia fills a gradient pixel by pixel (an opaque one cost 16-25 ms a 4K frame),
    // but a solid fill at memory speed, and the field only changes down the page: so it's
    // `bands` solid ones, each a colour level or so from the next, the steps an 8-bit
    // gradient makes anyway (~1 ms a 4K frame).
    property <float> ground-in: root.shown ? 1 : 0;
    animate ground-in { duration: Theme.t-page; easing: Curves.ease-out; }
    property <color> ground-top: root.field-top.mix(Theme.ground, root.ground-in);
    property <color> ground-mid: root.field-mid.mix(Theme.ground, root.ground-in);
    property <color> ground-low: root.field-low.mix(Theme.ground, root.ground-in);
    // The ground `at` that share of the way down the page, as the bands have it.
    pure function ground-at(at: float) -> color {
        return at < 0.55 ? root.ground-top.mix(root.ground-mid, 1 - at / 0.55) : root.ground-mid.mix(root.ground-low, 1 - (at - 0.55) / 0.45);
    }
    property <int> bands: 128;
    // The bands are always there: a ground made by an `if` in the frame it was needed went
    // unpainted in that frame, and the Lyrics pill above it was drawn twice
    // (`tests/lyrics_lines.rs`). Hidden under the picture.
    Rectangle {
        x: 0;
        y: 0;
        width: root.stage-w;
        height: root.height;
        visible: !root.pictured;
        for i in root.bands: Rectangle {
            // Down the stage at the band's middle: the field's stops at 0, 55 and 100 %.
            property <float> at: (i + 0.5) / root.bands;
            // Whole physical pixels, so neighbours meet without a seam.
            y: Math.round(root.height * i / root.bands / 1phx) * 1phx;
            height: Math.round(root.height * (i + 1) / root.bands / 1phx) * 1phx - self.y;
            background: self.at < 0.55 ? root.ground-top.mix(root.ground-mid, 1 - self.at / 0.55) : root.ground-mid.mix(root.ground-low, 1 - (self.at - 0.55) / 0.45);
        }
    }

    stage := Rectangle {
        x: 0;
        width: root.stage-w;
        opacity: root.shown ? 1.0 : 0.0;
        // From the bar's cover, bottom left.
        transform-origin: { x: Theme.bar-inset + 44px, y: root.height - Theme.bar-inset - Theme.bar-h / 2 };
        transform-scale: root.shown ? 1.0 : Theme.np-from;
        animate opacity, transform-scale { duration: Theme.t-page; easing: Curves.ease-out; }

        IconButton {
            x: Theme.s5;
            y: Theme.s4;
            // The row at the window's top has Back then.
            visible: !root.in-bar && root.chrome > 0;
            opacity: root.chrome;
            icon: Icons.back;
            label: @tr("Back");
            tint: root.ink1;
            clicked => { Nav.back(); }
        }
        // "Playing from" in the middle of the header row, clear of the pill and the lyrics
        // menu's ⋯ beside it on either side; only when the queue's source is known, and only
        // with room for its label (a very narrow stage drops it: the bar's Up next has it).
        property <length> source-room: 2 * (root.head-end - lyrics-pill.width - Theme.s3 - (root.full ? lyrics-actions.preferred-width + Theme.s3 : 0px) - root.stage-w / 2);
        property <bool> source-shown: Player.has-track && QueueData.playing-from != "" && stage.source-room >= 96px;
        if stage.source-shown: SourceButton {
            x: (root.stage-w - self.width) / 2;
            y: root.head-y + root.head-control / 2 - self.height / 2;
            init => { root.source-w = self.width; }
            changed width => { root.source-w = self.width; }
            room: stage.source-room;
            source: QueueData.playing-from;
            ink: root.ink1;
            quiet: root.ink2;
            on-panel: root.tint > 0.5;
            visible: root.chrome > 0;
            opacity: root.chrome;
            clicked => { QueueData.open-source(); }
        }

        // The cover is laid out once at the cover view's size and scaled to the lyrics view's,
        // so the toggle moves the art and its shadow as drawn instead of drawing them again at
        // a new size on every frame. The shadow, under it, keeps one shape (its corners are
        // blurred anyway), so skia blurs it once; it scales with the cover (48 to ~30 px).
        // Its opaque ground, all under the cover (a pixel in from the cover's edges, its corners
        // never outside the cover's at either end), lets the renderer skip the shadow under it
        // (change 13): ~15 % of a 4K toggle frame was blending shadow the cover then hid.
        Rectangle {
            x: root.art-x + 1px * root.art-size / root.cover-size;
            y: root.art-y + 1px * root.art-size / root.cover-size;
            width: root.cover-size - 2px;
            height: root.cover-size - 2px;
            transform-origin: { x: 0, y: 0 };
            transform-scale: root.art-scale;
            border-radius: max(Theme.r-xl, root.to-radius * root.cover-size / root.to-size);
            background: Theme.cover-empty;
            drop-shadow-blur: 48px;
            drop-shadow-offset-y: 16px;
            drop-shadow-color: Theme.cover-shadow;
        }
        // A soft glow in the cover's colour (the accent) low under it: the shadow of a shape
        // `glow-in` inside the cover, dropped well down and blurred wide, so it shows only
        // below the cover's lower edge. Laid out, scaled and opaque under the cover as the
        // shadow above is, for the same reasons.
        property <length> glow-in: 24px;
        Rectangle {
            x: root.art-x + stage.glow-in * root.art-size / root.cover-size;
            y: root.art-y + stage.glow-in * root.art-size / root.cover-size;
            width: root.cover-size - 2 * stage.glow-in;
            height: root.cover-size - 2 * stage.glow-in;
            transform-origin: { x: 0, y: 0 };
            transform-scale: root.art-scale;
            border-radius: Theme.r-xl;
            background: Theme.cover-empty;
            drop-shadow-blur: 72px;
            drop-shadow-offset-y: 36px;
            drop-shadow-color: Theme.cover-glow;
        }
        Cover {
            x: root.art-x;
            y: root.art-y;
            width: root.cover-size;
            height: root.cover-size;
            transform-origin: { x: 0, y: 0 };
            transform-scale: root.art-scale;
            // The corners as they look: r-xl in the cover view, r-l in the lyrics' column (r-m
            // in the stacked header).
            radius: (Theme.r-xl + (root.to-radius - Theme.r-xl) * root.lyr) * root.cover-size / root.art-size;
            source: NowPlayingData.cover;
            // A new song's art lands in one frame with its field, glow and tints
            // (`src/pages/now_playing/landing.rs`), so it doesn't fade in over the last.
            crossfade: false;
            // No layer for art smaller than the cover, the last size's while Rust decodes the
            // new one (Up next closing grows the cover): a layer would be made at the cover's
            // own size, larger than it shows in the lyrics view, for the few frames until
            // then. The first closing spent ~5.5 ms of its relayout making it (2026-11-20).
            layered: self.source.width * 1phx >= self.width - 0.5px;
        }

        // The cover view's text is one block the cover's width, every line starting at its
        // left edge (the house style's "one edge, one width"):
        // the title, then the artists, then "album · year", each on its own line and eliding
        // at the block's width on its own.
        //
        // Row 1: the title in the display face, wrapping to a second line and eliding there,
        // beside "Not for me", like and the song menu (the bar's buttons as 40 px targets, a
        // 20 px glyph in `text2`, `Theme.s1` apart). The buttons are pinned at the cover's
        // right edge (their glyphs reach it: the buttons hang `s2` past it, about the room
        // round a glyph), centred on the title's first line, so they keep their place
        // whatever the title is; the title stops `s3` before them. They ride along and fade
        // with the lyrics toggle, and are hidden once it's done. The title slides with the
        // cover and fades into the lyrics' column's wrapped title (`full-title`).
        //
        // Stacked, the text slides with the cover to its place beside it in the header, the
        // title fading into the header's one-line title, "album · year" staying, and the
        // buttons gliding to the cover's foot under the text, where they stay: the header is
        // the only place the song's buttons show.
        property <length> buttons-hang: Theme.s2;
        // The text's width: the cover's, or stacked, growing to the header's beside the cover.
        property <length> text-w: root.stack ? root.cover-size + (root.hd-text-w - root.cover-size) * root.lyr : root.art-size;
        // The buttons stay through the toggle where the header shows them.
        property <float> buttons-fade: root.stack ? (root.immersive ? root.chrome : 1) : 1 - root.lyr;
        // The title's width: the cover's less the buttons', growing as they fade with the toggle.
        property <length> title-w: root.cover-size - (Player.has-track ? song-buttons.preferred-width - stage.buttons-hang + Theme.s3 : 0px) * (1 - root.lyr);
        // One line of the title at either size, for the buttons' place and the block's room.
        title-probe := Display {
            visible: false;
            // Any text: a line's height comes from the face's metrics.
            text: "0";
            font-size: Theme.t-display-m;
        }
        title-probe-s := Display {
            visible: false;
            text: "0";
            font-size: Theme.t-display-s;
        }
        title := Display {
            x: root.text-x;
            y: root.title-y;
            width: stage.title-w;
            height: self.preferred-height;
            visible: root.lyr < 1;
            text: Player.has-track ? Player.title : @tr("Nothing playing");
            font-size: root.title-size;
            wrap: word-wrap;
            max-lines: 2;
            overflow: elide;
            color: (Player.has-track ? root.ink1 : root.ink2).transparentize(root.lyr);
        }
        // In the cover view at the cover's right edge on the title's first line; stacked, at
        // the header's foot, the first glyph on the text's edge (a 20 px glyph centred in its
        // 40 px target).
        property <length> buttons-x0: root.art-x + root.cover-size + stage.buttons-hang - song-buttons.preferred-width;
        property <length> buttons-y0: root.title-y + (root.title-line - song-buttons.preferred-height) / 2;
        song-buttons := HorizontalLayout {
            x: root.stack ? stage.buttons-x0 + (root.hd-text-x - 10px - stage.buttons-x0) * root.lyr : stage.buttons-x0;
            y: root.stack ? root.cover-y + root.cover-size + root.cover-gap + (root.title-line - self.preferred-height) / 2 + (root.hd-top + root.hd-cover - self.preferred-height - root.cover-y - root.cover-size - root.cover-gap - (root.title-line - self.preferred-height) / 2) * root.lyr : stage.buttons-y0;
            width: self.preferred-width;
            height: self.preferred-height;
            spacing: Theme.s1;
            if Player.has-track: NotForMeButton {
                size: 40px;
                visible: stage.buttons-fade > 0;
                fade: stage.buttons-fade;
                ink: root.ink1;
                quiet: root.ink2;
            }
            if Player.has-track: LikeButton {
                width: 40px;
                height: 40px;
                visible: stage.buttons-fade > 0;
                fade: stage.buttons-fade;
                tint: Player.liked ? root.ink1 : root.ink2;
            }
            if Player.has-track: IconButton {
                width: 40px;
                height: 40px;
                visible: stage.buttons-fade > 0;
                fade: stage.buttons-fade;
                tint: root.ink2;
                icon: Icons.more;
                label: @tr("More");
                filled: true;
                clicked => {
                    NowPlayingData.more(self.absolute-position.x + self.width - 4px, self.absolute-position.y + self.height, self.absolute-position.y);
                }
            }
        }
        // The lyrics view's title: wrapped in the column, one line eliding in the stacked
        // header (its height then the same for every song).
        full-title := Display {
            x: root.text-x;
            y: root.title-y;
            width: root.stack ? stage.text-w : root.fl-cover;
            visible: root.lyr > 0;
            text: Player.has-track ? Player.title : @tr("Nothing playing");
            font-size: root.title-size;
            color: LyricsData.ink.current.transparentize(1 - root.lyr);
            wrap: root.stack ? no-wrap : word-wrap;
            overflow: elide;
        }
        // Row 2: the artists, a link to the first, under the title as it wraps (one line or
        // two). In the lyrics view they move under the column's wrapped title, eliding at the
        // column's width (stacked, the header's).
        property <length> artists-y: root.title-y + (title.height + Theme.s2) * (1 - root.lyr) + (full-title.preferred-height + Theme.s1) * root.lyr;
        artists := LinkText {
            x: root.text-x;
            y: stage.artists-y;
            height: root.artists-h + 2px * root.lyr;
            room: stage.text-w;
            text: Player.artist;
            tint: root.ink1.mix(root.ink2, 1 - root.lyr);
            weight: 600;
            enabled: Player.artist-id != "";
            clicked => { Nav.open-artist(Player.artist-id); }
        }
        // Row 3: "album · year" in `text2`, the album a link, eliding before the year; a single's
        // album, named as the song, would only repeat the title, so the row says "Single" (a
        // link to it) once the album's page says so, and until then only the year. It
        // fades out over the first half of the lyrics toggle, keeping its place; stacked it
        // stays, in the panel's second ink, under the artists in the header.
        property <length> album-y: stage.artists-y + root.artists-h;
        property <color> album-ink: root.stack ? root.ink2 : root.ink2.transparentize(root.tint);
        property <bool> album-repeats: Player.album == Player.title && !NowPlayingData.single;
        if Player.album != "": Rectangle {
            x: root.text-x;
            y: stage.album-y;
            width: root.stack ? stage.text-w : root.cover-size;
            height: root.album-h;
            album := LinkText {
                x: 0;
                height: parent.height;
                room: parent.width - (NowPlayingData.year != "" ? year.preferred-width : 0px);
                visible: !stage.album-repeats;
                text: Player.album == Player.title && NowPlayingData.single ? @tr("Single") : Player.album;
                size: Theme.t-body;
                tint: stage.album-ink;
                enabled: Player.album-id != "" && (root.stack || root.lyr < 0.5);
                clicked => { Nav.open-album(Player.album-id); }
            }
            year := Body {
                x: stage.album-repeats ? 0 : album.width;
                y: 0;
                height: parent.height;
                visible: NowPlayingData.year != "";
                text: (stage.album-repeats ? "" : " · ") + NowPlayingData.year;
                color: stage.album-ink;
                vertical-alignment: center;
            }
        }
        // The lyrics, in the main area under the back button's row. Once made (`warm`) the
        // view stays, hidden while the cover view shows, so opening it makes no lines in its
        // first frame: a song's 80 lines, shaped and laid out at this size, cost 7–10 ms
        // there at 4K. Hidden, nothing in it moves (`shown`).
        // It shows once its lines fade in (`reveal`), the toggle's second half opening, and
        // hides as they're gone closing: before, nothing of it shows, and shown in the
        // toggle's first frame it repainted its whole box there, a quarter of a 4K window
        // that draws nothing yet (2026-11-21).
        // Stacked, under the header, the cover's left edge and the stage's width.
        if root.warm || root.lyr > 0: LyricsView {
            visible: root.reveal > 0;
            shown: root.lyr > 0;
            x: root.lines-x;
            y: root.lines-y;
            width: root.lines-w;
            height: root.stage-h - self.y;
            size: root.stack ? root.hd-lyric : LyricsData.full-size(root.stage-w >= Theme.lyric-wide-min);
            pad-x: Theme.s3;
            bottom: 0;
            card: false;
            reveal: root.reveal;
            pictured: root.pictured;
            edge-top: NowPlayingData.backdrop-top;
            edge-bottom: NowPlayingData.backdrop-bottom;
            // The bands where the lines end, for the fade into them.
            edge-top-ground: root.ground-at(root.lines-y / root.height);
            edge-bottom-ground: root.ground-at(root.stage-h / root.height);
        }

        // Last, so the note under it shows over the cover. Not there without a song: nothing
        // to look up.
        lyrics-pill := LyricsToggle {
            x: root.head-end - self.width;
            y: root.head-y;
            height: root.head-control;
            visible: LyricsData.on && (Player.has-track || root.full) && root.chrome > 0;
            opacity: root.chrome;
            on: root.full;
            clicked => { LyricsData.toggle-view(); }
        }
        // Translate, Romanize and the lyrics menu's ⋯, left of the pill while the lyrics show.
        // Romanize only when a line is in another script.
        lyrics-actions := HorizontalLayout {
            x: lyrics-pill.x - Theme.s3 - self.preferred-width;
            y: root.head-y;
            spacing: Theme.s2;
            visible: root.full && root.chrome > 0;
            opacity: root.chrome;
            if LyricsData.has-lines: LyricsExtraButton {
                width: root.head-control;
                height: root.head-control;
                icon: LyricsDecorationIcons.translation;
                label: @tr("Translate to English");
                hint: LyricsData.translation-on && LyricsData.translation-needless ? @tr("· This song is already in English") : @tr("· An English line under each line");
                on: LyricsData.translation-on;
                loading: LyricsData.translation-loading;
                clicked => { LyricsData.set-translation(!LyricsData.translation-on); }
            }
            if LyricsData.has-lines && LyricsData.has-non-latin: LyricsExtraButton {
                width: root.head-control;
                height: root.head-control;
                icon: LyricsDecorationIcons.romanization;
                label: @tr("Romanize");
                hint: @tr("· The lines in Latin letters");
                on: LyricsData.romanization-on;
                loading: LyricsData.romanization-loading;
                clicked => { LyricsData.set-romanization(!LyricsData.romanization-on); }
            }
            LyricsMoreButton {
                width: root.head-control;
                height: root.head-control;
                asked: LyricsMenu.open-asked;
                clicked => { root.open-lyrics-menu(); }
            }
        }
    }
    // Where the header's controls are, for the window's hit test while they're in its top row:
    // the pill with the buttons left of it, and "Playing from".
    property <length> source-w;
    property <length> controls-x: root.full ? lyrics-actions.x : lyrics-pill.x;
    property <length> controls-w: lyrics-pill.visible ? lyrics-pill.x + lyrics-pill.width - root.controls-x : 0px;
    property <length> source-hit-w: stage.source-shown ? root.source-w : 0px;
    function tell-row() {
        Frame.np-controls-x = root.controls-x;
        Frame.np-controls-w = root.controls-w;
        Frame.np-source-x = (root.stage-w - root.source-hit-w) / 2;
        Frame.np-source-w = root.source-hit-w;
    }
    changed controls-x => { root.tell-row(); }
    changed controls-w => { root.tell-row(); }
    changed source-hit-w => { root.tell-row(); }
    changed stage-w => { root.tell-row(); }
    // The lyrics menu opens under the ⋯, ending at the pill's right edge.
    function open-lyrics-menu() {
        LyricsMenu.show(lyrics-pill.absolute-position.x + lyrics-pill.width, lyrics-pill.absolute-position.y + lyrics-pill.height + Theme.s2);
    }

    // Up next / Related, as a card floating over the page with the bar's inset, radius and
    // edge (`QueuePanel`'s `card`): in the panel's room at the right, `bar-inset` in from the
    // window's top and right edges and above the bar. Opaque and unclipped (its rows end inside
    // its rounded corners), so it slides as one solid layer. On the field, toned, as the bar is. On the page's entry it comes in
    // 24 px behind the stage. That offset eases on its own, not `x`: an eased `x` followed
    // every resize of the window late.
    property <length> side-enter: root.shown ? 0px : (Theme.moving ? 24px : 0px);
    animate side-enter { duration: Theme.t-page; delay: Theme.fading ? 40ms : 0ms; easing: Curves.ease-out; }
    property <length> card-x: root.width - root.panel-w;
    // With the window's own title bar the card starts under its row, the window buttons over
    // the page's strip above it.
    property <length> card-top: Frame.own-bar ? Theme.top-bar-h : Theme.bar-inset;
    property <length> card-bottom: root.stage-h - Theme.bar-inset;

    // Round the card while it's in, the page goes on: the strips at its top, right and bottom
    // (`Gutter`), each reaching under its rounded corners. While it slides, the stage runs
    // under it instead (the stage is the window's width until the slide in ends, and from the
    // first frame of the slide out). They're the field's bands (a gradient with the bands'
    // stops, so it meets the stage's), or the picture in the same frame as the stage. Neither
    // changes with the lyrics toggle, so the card isn't repainted by it.
    property <bool> card-in: root.side-shown && root.side-in;
    Gutter {
        visible: root.card-in;
        x: root.card-x;
        y: 0;
        width: root.panel-w;
        height: root.card-top + Theme.r-xl;
        page-w: root.width;
        page-h: root.height;
        pictured: root.pictured;
        background: @linear-gradient(180deg, root.ground-at(0) 0%, root.ground-at(self.height / root.height) 100%);
    }
    Gutter {
        visible: root.card-in;
        property <float> top: self.y / root.height;
        property <float> end: (self.y + self.height) / root.height;
        x: root.width - Theme.bar-inset;
        y: root.card-top + Theme.r-xl;
        width: Theme.bar-inset;
        height: root.card-bottom - Theme.r-xl - self.y;
        page-w: root.width;
        page-h: root.height;
        pictured: root.pictured;
        background: @linear-gradient(180deg, root.ground-at(self.top) 0%, root.ground-mid clamp((0.55 - self.top) / (self.end - self.top), 0, 1) * 100%, root.ground-at(self.end) 100%);
    }
    Gutter {
        visible: root.card-in;
        x: root.card-x;
        y: root.card-bottom - Theme.r-xl;
        width: root.panel-w;
        height: root.height - self.y;
        page-w: root.width;
        page-h: root.height;
        pictured: root.pictured;
        background: @linear-gradient(180deg, root.ground-at(self.y / root.height) 0%, root.ground-at(1) 100%);
    }

    QueuePanel {
        x: root.width - root.panel-w * (1 - root.side-out) + root.side-enter;
        y: root.card-top;
        width: root.panel-w - Theme.bar-inset;
        height: root.card-bottom - root.card-top;
        card: true;
        clip: false;
        visible: root.side-out < 1;
        // Its colour changes with the song in one frame, with the page's field and the cover
        // (`src/pages/now_playing/landing.rs`): the field can't fade, so nothing round it does.
        // Its shadow only while it rests: never one moving with it in the slide. A shadow
        // under an opaque fill is drawn round it only (vendored renderer, change 13), from a
        // mask made once for its size (change 17).
        drop-shadow-blur: 28px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: !root.card-in ? transparent : Theme.pick(#0000006B, #0000001A);
        opacity: root.shown ? 1.0 : 0.0;
        animate opacity { duration: Theme.t-page; delay: Theme.fading ? 40ms : 0ms; easing: Curves.ease-out; }
        // Its lists keep the room at their foot that the panel kept for the bar, which the
        // card ends above: they end `s2` inside the card.
        // Laid out `s2` wider than the card each side: its tabs and text 16 px in from the
        // card's edges, its rows' tiles 8 px.
        SideTabs {
            x: -Theme.s2;
            width: parent.width + 2 * Theme.s2;
            y: 0;
            height: parent.height + Theme.bar-clear - Theme.s2;
            shown: root.side-shown;
            place: 1;
        }
    }
}
