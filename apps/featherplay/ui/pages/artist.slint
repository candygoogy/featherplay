// Artist page: a full-width photo banner with the name, Play, Radio and a ⋯ (Play next, Add
// to queue, Pin) over its foot (a round photo header when the artist has no photo), then top
// songs, albums, singles and EPs, videos (as song rows), the playlists it's featured on and
// the artists its fans also like (round). A row YouTube Music gives nothing for is left out
// (hidden: each is placed by hand, so it takes no room in a layout).
// Data comes from `src/pages/artist.rs`. Every list here is short (the API gives a handful
// of top songs and one shelf each), so the page is one Flickable.
import { Theme, Curves, Icons } from "../theme.slint";
import { TrackRow, CardItem, ItemKind, ShelfTitle, Shelf, Display, Body, Pill, IconButton, RowsShown, SongList, TextLink } from "../parts.slint";
import { ItemMenu } from "../item_menu.slint";
import { SongMenu } from "../song_menu.slint";
import { CollectionHeader, SongListRow, Skeleton, SkeletonBlock, SkeletonBar, SkeletonRow, ErrorState, FadeIn, Grid, Open, TopScrim } from "content.slint";

export global ArtistData {
    in property <bool> loading;
    in property <string> error;
    in property <string> id;
    in property <string> name;
    in property <string> meta;
    in property <image> photo;
    // The artist has a photo (it may still be loading): the page opens on a banner.
    in property <bool> has-photo;
    in property <[TrackRow]> top-songs;
    in property <[CardItem]> albums;
    in property <[CardItem]> singles;
    // Music videos, as song rows: their views where an album would be.
    in property <[TrackRow]> videos;
    // Playlists the artist is featured on, and related artists.
    in property <[CardItem]> featured;
    in property <[CardItem]> related;
    // Plays the top songs from `i`.
    callback play(int);
    // The radio of the first top song.
    callback radio();
    callback like(int);
    // The same for the videos.
    callback play-video(int);
    callback like-video(int);
    // Loads the artist again after an error.
    callback retry();
    // A card's play button: plays the album, playlist or artist without opening it.
    callback play-card(CardItem);
    // A shelf's cards from `first` to `last` came within a screen of what shows (Albums 0,
    // Singles & EPs 1, Featured on 2, Fans might also like 3): Rust asks for their covers,
    // each once while the page is open (`src/pages/artist.rs`).
    callback near(int, int, int);
    // The width the cards are drawn at, for the size their covers are decoded at.
    callback card-size(length);
    // Which shelves go on elsewhere (Top songs 0, Albums 1, Singles & EPs 2, Videos 3), and
    // the "Show all" that opens the rest of one.
    in property <[bool]> more;
    callback show-all(int);
}

// A song shelf's "Show all", at its title row's end.
component RowsShowAll inherits TextLink {
    in property <int> shelf;
    visible: ArtistData.more[root.shelf];
    text: @tr("Show all");
    clicked => { ArtistData.show-all(root.shelf); }
}

// Which of a shelf's cards are within a screen of what shows, down the page (`top`, the
// shelf's place in the view `view` high, `span` its height) and along its rail (`at`, `per-row` cards a screen
// of it), told to `ArtistData.near` as the range moves. Covers come in before they're seen,
// and a shelf far down the page asks for none until it's scrolled near.
component NearCards {
    in property <int> shelf;
    in property <length> top;
    in property <length> span;
    in property <length> view;
    in property <float> at;
    in property <int> per-row;
    in property <int> count;
    property <bool> near: root.count > 0 && root.top < 2 * root.view && root.top + root.span > -root.view;
    property <int> first: root.near ? max(0, floor(root.at) - root.per-row) : 0;
    property <int> last: root.near ? min(root.count - 1, ceil(root.at) + 2 * root.per-row - 1) : -1;
    function tell() {
        if root.last >= root.first {
            ArtistData.near(root.shelf, root.first, root.last);
        }
    }
    init => { root.tell(); }
    changed first => { root.tell(); }
    changed last => { root.tell(); }
}

// The banner: the photo across the page, cropped from the top, fading into the ground
// under the name, the meta line and the actions. Until the photo arrives it's a quiet grey.
component Banner inherits Rectangle {
    // The ⋯: where its menu opens (window coordinates), and the ⋯'s top for one that opens up.
    callback more-clicked(length, length, length);
    property <length> pad: Theme.pad-for(root.width);
    property <length> buttons-y: root.height - 40px - Theme.s5;
    property <length> meta-y: root.buttons-y - Theme.s4 - 20px;
    property <length> name-y: root.meta-y - 68px;
    background: Theme.cover-empty;
    clip: true;
    Image {
        width: parent.width;
        height: parent.height;
        source: ArtistData.photo;
        image-fit: cover;
        vertical-alignment: top;
        opacity: ArtistData.photo.width > 0 ? 1 : 0;
        animate opacity { duration: Theme.t-cover; easing: Curves.ease-hover; }
    }
    // Keeps the name readable on any photo: clear at the top, the ground at the foot.
    Rectangle {
        background: @linear-gradient(180deg, Theme.ground.transparentize(1) 0%, Theme.ground.transparentize(0.9) 30%, Theme.ground.transparentize(0.3) 65%, Theme.ground 100%);
    }
    Display {
        x: root.pad;
        y: root.name-y;
        width: root.width - 2 * root.pad;
        height: 68px;
        text: ArtistData.name;
        font-size: Theme.t-display-xxl;
        font-weight: 800;
        vertical-alignment: center;
    }
    Body {
        x: root.pad;
        y: root.meta-y;
        width: root.width - 2 * root.pad;
        height: 20px;
        text: ArtistData.meta;
        color: Theme.text2;
        vertical-alignment: center;
    }
    HorizontalLayout {
        x: root.pad;
        y: root.buttons-y;
        height: 40px;
        spacing: Theme.s2;
        alignment: start;
        Pill {
            label: @tr("Play");
            icon: Icons.play;
            solid: true;
            enabled: ArtistData.top-songs.length > 0;
            clicked => { ArtistData.play(0); }
        }
        Pill {
            label: @tr("Radio");
            icon: Icons.radio;
            icon-filled: false;
            enabled: ArtistData.top-songs.length > 0;
            clicked => { ArtistData.radio(); }
        }
        IconButton {
            width: 40px;
            height: 40px;
            icon: Icons.more;
            label: @tr("More");
            tint: Theme.text1;
            clicked => { root.more-clicked(self.absolute-position.x, self.absolute-position.y + self.height + 4px, self.absolute-position.y - 4px); }
        }
    }
}

export component ArtistPage inherits Rectangle {
    // Either header's ⋯: the artist's menu, as its tiles have it (`ItemMenu`: Play next, Add
    // to queue, Pin).
    function more(x: length, y: length, top: length) {
        ItemMenu.show({ id: ArtistData.id, kind: ItemKind.artist, title: ArtistData.name, cover: ArtistData.photo, round: true }, false, x, y, top);
    }
    property <length> pad: Theme.pad-for(root.width);
    property <length> inner: self.width - 2 * self.pad;
    // The page runs up under the clear top bar (app.slint): the banner's photo reaches up
    // behind it, and everything else starts below it.
    property <length> inset: Theme.top-bar-h;
    // The banner: 36 % of the page's height, between 280 and 400 px, below the top bar.
    property <length> banner-h: max(280px, min(400px, floor(root.height * 0.36 / 1px) * 1px));
    property <length> header-h: root.inset + (ArtistData.has-photo ? root.banner-h + Theme.s4 : Theme.page-top + (root.width >= 900px ? 232px : 200px) + Theme.s6);
    property <length> songs-y: root.header-h + Theme.s2;
    property <length> songs-h: ArtistData.top-songs.length == 0 ? 0px : 48px + ArtistData.top-songs.length * Theme.row-h + Theme.section-gap;
    property <int> per-row: Grid.per-row(root.inner);
    property <length> card: Grid.card(root.inner, root.per-row);
    init => { ArtistData.card-size(root.card); }
    changed card => { ArtistData.card-size(root.card); }
    property <length> shelf-h: 48px + root.card + Theme.card-text-gap + 40px;
    property <length> albums-y: root.songs-y + root.songs-h;
    property <length> albums-h: ArtistData.albums.length == 0 ? 0px : root.shelf-h + Theme.section-gap;
    property <length> singles-y: root.albums-y + root.albums-h;
    property <length> singles-h: ArtistData.singles.length == 0 ? 0px : root.shelf-h + Theme.section-gap;
    property <length> videos-y: root.singles-y + root.singles-h;
    property <length> videos-h: ArtistData.videos.length == 0 ? 0px : 48px + ArtistData.videos.length * Theme.row-h + Theme.section-gap;
    property <length> featured-y: root.videos-y + root.videos-h;
    property <length> featured-h: ArtistData.featured.length == 0 ? 0px : root.shelf-h + Theme.section-gap;
    property <length> related-y: root.featured-y + root.featured-h;
    property <length> related-h: ArtistData.related.length == 0 ? 0px : root.shelf-h + Theme.section-gap;

    // Loading: the banner's shape, the name and the top songs.
    if ArtistData.loading && ArtistData.name == "": sk := Skeleton {
        SkeletonBlock {
            x: 0;
            y: 0;
            width: root.width;
            height: root.inset + root.banner-h;
            sweep: sk.sweep;
            fade: sk.fade;
        }
        SkeletonBlock {
            x: root.pad;
            y: root.inset + root.banner-h - 40px - Theme.s5 - Theme.s4 - 20px - 60px;
            width: min(320px, root.inner);
            height: 48px;
            border-radius: Theme.r-m;
            sweep: sk.sweep;
            fade: sk.fade;
        }
        for i in 2: SkeletonBlock {
            x: root.pad + i * 112px;
            y: root.inset + root.banner-h - 40px - Theme.s5;
            width: 100px;
            height: 40px;
            border-radius: 20px;
            sweep: sk.sweep;
            fade: sk.fade;
        }
        SkeletonBar {
            x: root.pad;
            y: root.inset + root.banner-h + Theme.s4 + 12px;
            width: 140px;
            height: 16px;
            sweep: sk.sweep;
            fade: sk.fade;
        }
        // Top songs have no duration: their album column takes its place.
        for i in 5: SkeletonRow {
            x: root.pad - 8px;
            y: root.inset + root.banner-h + Theme.s4 + 48px + i * Theme.row-h;
            width: root.inner + 16px;
            index: i;
            duration: false;
            sweep: sk.sweep;
            fade: sk.fade * min(1, (5 - i) / 3);
        }
    }
    if !ArtistData.loading && ArtistData.error != "": ErrorState {
        x: root.pad;
        y: root.inset + Theme.page-top;
        width: min(480px, root.inner);
        message: ArtistData.error;
        retry => { ArtistData.retry(); }
    }
    if ArtistData.name != "": FadeIn {
        flick := Flickable {
            content-height: root.related-y + root.related-h + Theme.bar-clear;
            if ArtistData.has-photo: Banner {
                x: 0;
                y: 0;
                width: root.width;
                height: root.inset + root.banner-h;
                more-clicked(x, y, top) => { root.more(x, y, top); }
            }
            // No photo: the round header.
            if !ArtistData.has-photo: CollectionHeader {
                x: 0;
                y: 0;
                width: root.width;
                cover: ArtistData.photo;
                round: true;
                title: ArtistData.name;
                meta: ArtistData.meta;
                secondary: @tr("Radio");
                secondary-icon: Icons.radio;
                enabled: ArtistData.top-songs.length > 0;
                more: true;
                more-clicked(x, y, top) => { root.more(x, y, top); }
                primary-clicked => { ArtistData.play(0); }
                secondary-clicked => { ArtistData.radio(); }
            }
            ShelfTitle {
                visible: ArtistData.top-songs.length > 0;
                x: root.pad;
                y: root.songs-y;
                width: root.inner - (songs-all.visible ? songs-all.width + Theme.s4 : 0px);
                text: @tr("Top songs");
            }
            songs-all := RowsShowAll {
                shelf: 0;
                x: root.pad + root.inner - self.width;
                y: root.songs-y + (32px - self.height) / 2;
            }
            // A handful of rows, all at the page's top.
            RowsShown {
                list: SongList.artist;
                first: 0;
                last: ArtistData.top-songs.length - 1;
            }
            for t[i] in ArtistData.top-songs: SongListRow {
                x: root.pad - 8px;
                y: root.songs-y + 48px + i * Theme.row-h;
                width: root.inner + 16px;
                track: t;
                activated => { ArtistData.play(i); }
                like-clicked => { ArtistData.like(i); }
                menu-requested(x, y, top) => { SongMenu.show(t, x, y, top); }
            }
            albums-shelf := Shelf {
                visible: ArtistData.albums.length > 0;
                x: root.pad;
                y: root.albums-y;
                width: root.inner;
                title: @tr("Albums");
                items: ArtistData.albums;
                per-row: root.per-row;
                playable: true;
                more: ArtistData.more[1];
                show-all => { ArtistData.show-all(1); }
                open(it) => { Open.item(it); }
                play(it) => { ArtistData.play-card(it); }
            }
            NearCards {
                shelf: 0;
                top: albums-shelf.y + flick.content-y;
                span: albums-shelf.height;
                view: flick.height;
                at: albums-shelf.at;
                per-row: root.per-row;
                count: ArtistData.albums.length;
            }
            singles-shelf := Shelf {
                visible: ArtistData.singles.length > 0;
                x: root.pad;
                y: root.singles-y;
                width: root.inner;
                title: @tr("Singles & EPs");
                items: ArtistData.singles;
                per-row: root.per-row;
                playable: true;
                more: ArtistData.more[2];
                show-all => { ArtistData.show-all(2); }
                open(it) => { Open.item(it); }
                play(it) => { ArtistData.play-card(it); }
            }
            NearCards {
                shelf: 1;
                top: singles-shelf.y + flick.content-y;
                span: singles-shelf.height;
                view: flick.height;
                at: singles-shelf.at;
                per-row: root.per-row;
                count: ArtistData.singles.length;
            }
            ShelfTitle {
                visible: ArtistData.videos.length > 0;
                x: root.pad;
                y: root.videos-y;
                width: root.inner - (videos-all.visible ? videos-all.width + Theme.s4 : 0px);
                text: @tr("Videos");
            }
            videos-all := RowsShowAll {
                shelf: 3;
                x: root.pad + root.inner - self.width;
                y: root.videos-y + (32px - self.height) / 2;
            }
            for t[i] in ArtistData.videos: SongListRow {
                x: root.pad - 8px;
                y: root.videos-y + 48px + i * Theme.row-h;
                width: root.inner + 16px;
                track: t;
                activated => { ArtistData.play-video(i); }
                like-clicked => { ArtistData.like-video(i); }
                menu-requested(x, y, top) => { SongMenu.show(t, x, y, top); }
            }
            featured-shelf := Shelf {
                visible: ArtistData.featured.length > 0;
                x: root.pad;
                y: root.featured-y;
                width: root.inner;
                title: @tr("Featured on");
                items: ArtistData.featured;
                per-row: root.per-row;
                playable: true;
                open(it) => { Open.item(it); }
                play(it) => { ArtistData.play-card(it); }
            }
            NearCards {
                shelf: 2;
                top: featured-shelf.y + flick.content-y;
                span: featured-shelf.height;
                view: flick.height;
                at: featured-shelf.at;
                per-row: root.per-row;
                count: ArtistData.featured.length;
            }
            related-shelf := Shelf {
                visible: ArtistData.related.length > 0;
                x: root.pad;
                y: root.related-y;
                width: root.inner;
                title: @tr("Fans might also like");
                items: ArtistData.related;
                per-row: root.per-row;
                playable: true;
                open(it) => { Open.item(it); }
                play(it) => { ArtistData.play-card(it); }
            }
            NearCards {
                shelf: 3;
                top: related-shelf.y + flick.content-y;
                span: related-shelf.height;
                view: flick.height;
                at: related-shelf.at;
                per-row: root.per-row;
                count: ArtistData.related.length;
            }
        }
        TopScrim {
            scrolled: -flick.content-y;
        }
    }
}
