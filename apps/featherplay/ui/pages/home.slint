// Home (the layout chosen 2026-10-30: shelves by kind, with the mixes as shortcuts):
// the hero, titled like a shelf, then the Home feed. Data comes from
// `src/pages/home.rs` through `HomeData`.
//
// The hero has two modes. With a session or a queue: "Pick up where you left off"
// (`ResumeCard`, as wide as the shelf row under it), the current track (from `Player`) with
// the progress, Pause or Resume and Go to album, and beside it what's next in the queue as a
// column of rows. On a fresh start with an empty queue: a featured pick from the first shelf,
// with more from it (`FeaturedCard`).
//
// Every shelf takes the shape of what it holds (`home.rs::arrange`), so the eye tells the
// shelves apart before reading them: your mixes as wide shortcuts right under the hero (what
// gets replayed most, one click away), quick picks as a dense song grid, videos as wide 16:9
// tiles, playlists as smaller cards, artists as round faces with only their names, and albums
// and anything else as standard cards. Liked songs is always the first shortcut (a red tile
// with a white heart, as on its own page), and a community playlist wears its creator's
// round photo over its collage's bottom-left corner.
//
// More shelves load as the user scrolls near the end (`home.rs::Paging`): a quiet skeleton
// shelf while a page loads, a quiet Try again if it fails; Home itself never errors for it.
import { ListView } from "../list_view.slint";
import { Theme, Curves, Icons } from "../theme.slint";
import { TrackRow, CardItem, ItemKind, Body, Display, Cover, Card, Icon, Pill, ProgressRail, SongRow, ShelfArrows, Bands, RowsShown, SongList, PageIntent } from "../parts.slint";
import { Nav } from "../nav.slint";
import { Player } from "../player.slint";
import { Skeleton, SkeletonBlock, SkeletonBar, SkeletonRow, SkeletonCard, ErrorState, EmptyState, Open } from "content.slint";
import { SongMenu } from "../song_menu.slint";

// How a shelf shows, from what it holds (`home.rs::shape`).
export enum ShelfShape { cards, songs, mixes, videos, playlists, artists }

// The row after the last shelf: nothing, the next page loading, or its quiet Try again.
export enum MoreState { idle, loading, failed }

// One shelf of the Home feed, its items as cards; a song grid also has them as rows in `songs`.
export struct HomeShelfRow {
    title: string,
    // Words before the title, in sentence case ("Similar to" Ari Abdul), or "".
    lead: string,
    items: [CardItem],
    songs: [TrackRow],
    // A round badge for each item, by index (a community playlist's creator), or empty.
    badges: [image],
    shape: ShelfShape,
}

export global HomeData {
    in property <bool> loading;
    in property <string> error;
    // The feed loaded and has no shelves (an identity with no history yet).
    in property <bool> empty;
    // The hero: true resumes the session, false features a pick (when there is one).
    in property <bool> resume;
    in property <image> hero-cover;
    // The header's wash from the resumed song's cover, per theme (`home.rs::show_wash`; the
    // accent's on grey art), already over the ground, opaque; transparent until it's worked
    // out. Shown only while resuming.
    in property <color> wash-dark;
    in property <color> wash-light;
    // The wash shows behind the top bar (set by `HomePage`, until the page has scrolled the
    // bar's height): the frame clears the bar's ground and leaves out its fade below, so the
    // wash runs up behind the search field to the window's top.
    in-out property <bool> wash-behind-bar;
    // Resume: the next 3 tracks of the queue.
    in property <[TrackRow]> next;
    // Featured: the pick, the heading over the rest ("More from Quick picks"), and 4 more
    // from that shelf.
    in property <bool> has-featured;
    in property <CardItem> featured;
    in property <string> featured-from;
    in property <[CardItem]> featured-more;
    in property <[HomeShelfRow]> shelves;
    in property <MoreState> more;
    // How many rows the page has: the top, the shelves, then the next page's row while it
    // loads or failed.
    out property <int> row-count: root.shelves.length + 1 + (root.more != MoreState.idle ? 1 : 0);
    // One entry per row, kept by `home.rs` (`bind_rows`) as one model that only grows or
    // shrinks at its end, to `row-count`, on `sync-rows`.
    in property <[int]> rows;

    callback resume-clicked();
    // Plays the queue from row `i` of `next`.
    callback play-next(int);
    callback play-featured();
    // The featured pick (-1) or one of `featured-more`.
    callback open-featured(int);
    // A song card on a shelf: plays it, with radio after it.
    callback play-song(string);
    // Fetches the feed again after an error.
    callback retry();
    // A card's play button: plays the album, playlist or artist without opening it.
    callback play-card(CardItem);
    // The user scrolled near the end: the next page, if one may load now.
    callback near-end();
    // Try again after the next page failed.
    callback retry-more();
    // The page needs `count` rows: `rows` grows or shrinks to that many at its end.
    callback sync-rows(/* count */ int);
}

// The sizes each shape lays out with. A tile has one steady width (`tile-max`, its width at a
// 1568 px window) and a row holds as many as fit, the rest of the row left empty: so tiles
// don't grow and shrink as the page widens and fits another column (opening or closing the side
// panel resized every shelf). Only a page too narrow for two shrinks them. Shortcuts keep a row
// of a few together instead (`mix-w`). Covers are fetched at about a tile's width
// (`home.rs::cover_px`).
export global Shapes {
    out property <length> head-h: 48px;
    out property <length> mix-h: 64px;
    out property <length> mix-gap: Theme.s3;
    // Mixes show two rows a page at most.
    out property <int> mix-rows: 2;
    // Quick picks: columns of four rows, as many 380 px columns as fit.
    out property <int> grid-rows: 4;
    out property <length> grid-col: 380px;
    // A community playlist's avatar badge (`home.rs::BADGE`), its ring included.
    out property <length> badge: 32px;
    // Mixes: the narrowest a shortcut may get, so a row of four holds together down to a
    // 1280 px window (`mix-w`). The other shapes: their one width.
    public pure function tile-max(s: ShelfShape) -> length {
        return s == ShelfShape.mixes ? 220px : (s == ShelfShape.videos ? 300px : (s == ShelfShape.playlists ? 160px : (s == ShelfShape.artists ? 120px : 192px)));
    }
    public pure function gap(s: ShelfShape) -> length {
        return s == ShelfShape.mixes ? root.mix-gap : Theme.card-gap;
    }
    public pure function per-row(s: ShelfShape, w: length) -> int {
        return max(2, floor((w + Shapes.gap(s)) / (Shapes.tile-max(s) + Shapes.gap(s))));
    }
    public pure function tile-w(s: ShelfShape, w: length) -> length {
        return min(Shapes.tile-max(s), floor((w - (Shapes.per-row(s, w) - 1) * Shapes.gap(s)) / Shapes.per-row(s, w) / 1px) * 1px);
    }
    // A shortcut (a mix) in a row of `n`: the row's tiles share the width, up to `mix-max` each.
    // So a row of a few keeps one length however wide the page is, rather than its tiles
    // getting narrower as the page widens and fits another column (opening and closing the
    // side panel moved its end), and the resume card above lines up with it.
    out property <length> mix-max: 240px;
    public pure function mix-w(w: length, n: int) -> length {
        return min(root.mix-max, floor((w - (min(Shapes.per-row(ShelfShape.mixes, w), max(1, n)) - 1) * root.mix-gap) / min(Shapes.per-row(ShelfShape.mixes, w), max(1, n)) / 1px) * 1px);
    }
    public pure function art-h(s: ShelfShape, w: length) -> length {
        return s == ShelfShape.videos ? round(Shapes.tile-w(s, w) * 9 / 16 / 1px) * 1px : Shapes.tile-w(s, w);
    }
    // How far a row of `n` tiles reaches in `w`, from the first tile's left edge to the
    // last's right: a shelf with fewer items than fit stops short of the content's edge.
    public pure function row-w(s: ShelfShape, w: length, n: int) -> length {
        return min(n, Shapes.per-row(s, w)) * ((s == ShelfShape.mixes ? Shapes.mix-w(w, n) : Shapes.tile-w(s, w)) + Shapes.gap(s)) - Shapes.gap(s);
    }
    // The shortcuts Home counts on before the feed is in, or when it has no row of them: as
    // many as the Shortcuts row holds (`home.rs::SHORTCUTS`).
    out property <int> lead-tiles: 4;
    public pure function rows(n: int, w: length) -> int {
        return max(1, min(root.mix-rows, ceil(n / Shapes.per-row(ShelfShape.mixes, w))));
    }
    // A shelf's height with its heading, `n` items in `w`.
    public pure function height(s: ShelfShape, w: length, n: int) -> length {
        if s == ShelfShape.songs {
            return root.head-h + root.grid-rows * Theme.row-h;
        }
        if s == ShelfShape.mixes {
            return root.head-h + Shapes.rows(n, w) * root.mix-h + (Shapes.rows(n, w) - 1) * root.mix-gap;
        }
        return root.head-h + Shapes.art-h(s, w) + Theme.card-text-gap + (s == ShelfShape.artists ? 24px : 40px);
    }
}

// A shelf's heading: optional lead words in text2 ("Similar to"), the title, and the paging
// arrows while the shelf is hovered and has more than a page.
component ShelfHead inherits Rectangle {
    in property <string> lead;
    in property <string> title;
    in property <bool> arrows;
    in property <bool> can-back;
    in property <bool> can-forward;
    callback back();
    callback forward();
    height: Shapes.head-h;
    HorizontalLayout {
        x: 0;
        y: 0;
        // Room for the arrows always, so the title doesn't re-elide when they show.
        width: root.width - 88px;
        height: 32px;
        alignment: start;
        spacing: Theme.s2;
        if root.lead != "": Display {
            text: root.lead;
            font-size: Theme.t-display-s;
            color: Theme.text2;
            vertical-alignment: center;
            horizontal-stretch: 0;
        }
        Display {
            text: root.title;
            font-size: Theme.t-display-s;
            vertical-alignment: center;
            accessible-role: text;
        }
    }
    if root.arrows: ShelfArrows {
        x: parent.width - self.width;
        y: 0;
        can-back: root.can-back;
        can-forward: root.can-forward;
        back => { root.back(); }
        forward => { root.forward(); }
    }
}

// What a tile does: songs play (with radio after them), the rest open; the play button plays
// the album, playlist or artist without opening it.
global Tiles {
    public function open(it: CardItem) {
        if it.kind == ItemKind.song {
            HomeData.play-song(it.id);
        } else {
            Open.item(it);
        }
    }
    public function play(it: CardItem) {
        if it.kind == ItemKind.song {
            HomeData.play-song(it.id);
        } else {
            HomeData.play-card(it);
        }
    }
}

// A row of cards shaped for its shelf (videos 16:9, playlists small, artists round faces
// without a subtitle, the rest standard), paged a row at a time.
component TileShelf inherits Rectangle {
    in property <HomeShelfRow> shelf;
    // Some of it shows: the warming starts then.
    in property <bool> in-sight: true;
    property <ShelfShape> shape: root.shelf.shape;
    property <int> per-row: Shapes.per-row(root.shape, root.width);
    property <length> tile-w: Shapes.tile-w(root.shape, root.width);
    property <int> first: 0;
    // The tile at the left edge, eased while paging; the tiles follow it, so a resize
    // moves them at once.
    property <float> at: root.first;
    animate at { duration: Theme.moving ? Theme.t-panel + 40ms : 0ms; easing: Curves.ease-in-out; }
    property <int> last-first: max(0, root.shelf.items.length - root.per-row);
    // Cards whose covers may take their layer: one more each tick after the shelf comes in sight,
    // not all in the frame it enters (each layer is ~0.7 ms at 4K, a row of them a frame's
    // worth). Until then a cover draws directly, where little of it shows yet. Once the first
    // page's cards have theirs the shelf is warm for good and the timer stops: a resize or a
    // page turn later doesn't start it again.
    property <int> warm: 0;
    property <bool> warmed: false;
    warming := Timer {
        interval: 8ms;
        running: !root.warmed && root.in-sight;
        triggered => {
            root.warm += 1;
            root.warmed = root.warm >= max(1, root.per-row);
        }
    }
    height: Shapes.height(root.shape, root.width, root.shelf.items.length);
    hover := TouchArea {
        ShelfHead {
            x: 0;
            y: 0;
            width: parent.width;
            lead: root.shelf.lead;
            title: root.shelf.title;
            arrows: hover.has-hover && root.shelf.items.length > root.per-row;
            can-back: root.first > 0;
            can-forward: root.first < root.last-first;
            back => { root.first = max(0, root.first - root.per-row); }
            forward => { root.first = min(root.last-first, root.first + root.per-row); }
        }
        Rectangle {
            y: Shapes.head-h;
            height: parent.height - Shapes.head-h;
            clip: true;
            for it[i] in root.shelf.items: Card {
                x: (i - root.at) * (root.tile-w + Theme.card-gap);
                y: 0;
                size: root.tile-w;
                art-h: Shapes.art-h(root.shape, root.width);
                subtitle: root.shape != ShelfShape.artists;
                item: it;
                playable: true;
                // Shown, or partly shown while paging (the others draw nothing), and warm.
                on-page: i + 1 > root.at && i < root.at + root.per-row && (root.warmed || i - root.first < root.warm);
                clicked => { Tiles.open(it); }
                play => { Tiles.play(it); }
                // The creator's photo, over the collage's bottom-left corner (the play button
                // takes the bottom-right). A ring of the ground keeps it apart from the art.
                if i < root.shelf.badges.length && root.shelf.badges[i].width > 0: Rectangle {
                    x: Theme.s2;
                    y: Shapes.art-h(root.shape, root.width) - self.height - Theme.s2;
                    width: Shapes.badge;
                    height: Shapes.badge;
                    border-radius: self.width / 2;
                    background: Theme.ground;
                    Rectangle {
                        x: 2px;
                        y: 2px;
                        width: parent.width - 4px;
                        height: parent.height - 4px;
                        border-radius: self.width / 2;
                        clip: true;
                        Image {
                            width: parent.width;
                            height: parent.height;
                            source: root.shelf.badges[i];
                            image-fit: cover;
                        }
                    }
                }
            }
        }
    }
}

// One mix as a shortcut: a wide tile on the raised card colour, the cover flush at its left
// and the title beside it; hovering shows an accent play at its right end.
component Shortcut inherits Rectangle {
    in property <CardItem> item;
    callback clicked();
    callback play();
    height: Shapes.mix-h;
    border-radius: Theme.r-m;
    background: Theme.card;
    clip: true;
    accessible-role: button;
    accessible-label: root.item.title;
    accessible-action-default => { root.clicked(); }
    property <bool> liked: root.item.id == "LM";
    if !root.liked: Cover {
        x: 0;
        y: 0;
        width: root.height;
        height: root.height;
        radius: 0px;
        source: root.item.cover;
    }
    // Liked songs: the red tile with a white heart, as its page and the sidebar show it.
    if root.liked: Rectangle {
        x: 0;
        y: 0;
        width: root.height;
        height: root.height;
        background: @linear-gradient(135deg, Theme.brand-accent 0%, #7A0E20 100%);
        Icon {
            width: 28px;
            height: 28px;
            commands: Icons.heart;
            fill: #FFFFFF;
            stroke: transparent;
        }
    }
    Rectangle {
        background: Theme.state(ta.pressed, ta.has-hover);
        animate background { duration: Theme.t-hover; easing: Curves.ease-hover; }
    }
    Body {
        x: root.height + Theme.s3;
        // The play button's room is kept, so the title doesn't re-elide on hover.
        width: root.width - self.x - 56px;
        height: root.height;
        text: root.item.title;
        font-weight: 600;
        vertical-alignment: center;
    }
    PageIntent {
        hovered: ta.has-hover;
        pressed: ta.pressed;
        pointer-x: ta.mouse-x;
        pointer-y: ta.mouse-y;
        kind: root.item.kind;
        id: root.item.id;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        // Inside the touch area, so hovering the button keeps the tile hovered.
        if ta.has-hover: Rectangle {
            x: root.width - self.width - Theme.s3;
            y: (root.height - self.height) / 2;
            width: 36px;
            height: 36px;
            border-radius: self.width / 2;
            background: Theme.accent-state(pa.pressed, pa.has-hover);
            transform-scale: pa.pressed ? Theme.press-scale : 1.0;
            animate transform-scale {
                duration: pa.pressed ? Theme.t-press : Theme.t-release;
                easing: pa.pressed ? Curves.ease-out : Curves.release;
            }
            accessible-role: button;
            accessible-label: @tr("Play {}", root.item.title);
            accessible-action-default => { root.play(); }
            pa := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.play(); }
            }
            Icon {
                width: 18px;
                height: 18px;
                commands: Icons.play;
                fill: Theme.on-accent;
                stroke: transparent;
            }
        }
    }
}

// Your mixes as shortcuts: two rows at most, paged a page (both rows) at a time.
component MixShelf inherits Rectangle {
    in property <HomeShelfRow> shelf;
    property <int> cols: Shapes.per-row(ShelfShape.mixes, root.width);
    property <int> rows: Shapes.rows(root.shelf.items.length, root.width);
    property <int> per-page: root.cols * root.rows;
    property <int> pages: ceil(root.shelf.items.length / root.per-page);
    property <length> tile-w: Shapes.mix-w(root.width, root.shelf.items.length);
    property <int> page: 0;
    property <float> at: root.page;
    animate at { duration: Theme.moving ? Theme.t-panel + 40ms : 0ms; easing: Curves.ease-in-out; }
    height: Shapes.height(ShelfShape.mixes, root.width, root.shelf.items.length);
    hover := TouchArea {
        ShelfHead {
            x: 0;
            y: 0;
            width: parent.width;
            lead: root.shelf.lead;
            title: root.shelf.title;
            arrows: hover.has-hover && root.pages > 1;
            can-back: root.page > 0;
            can-forward: root.page < root.pages - 1;
            back => { root.page = max(0, root.page - 1); }
            forward => { root.page = min(root.pages - 1, root.page + 1); }
        }
        Rectangle {
            y: Shapes.head-h;
            height: parent.height - Shapes.head-h;
            clip: true;
            for it[i] in root.shelf.items: Shortcut {
                property <int> j: mod(i, root.per-page);
                x: (floor(i / root.per-page) - root.at) * (root.width + Shapes.mix-gap) + mod(self.j, root.cols) * (root.tile-w + Shapes.mix-gap);
                y: floor(self.j / root.cols) * (Shapes.mix-h + Shapes.mix-gap);
                width: root.tile-w;
                item: it;
                clicked => { Open.item(it); }
                play => { HomeData.play-card(it); }
            }
        }
    }
}

// Quick picks as a dense grid: columns of four rows with small covers, as many 380 px columns
// as fit, paged a page of columns at a time. A click plays; right-click and ⋯ open the menu.
component SongGrid inherits Rectangle {
    in property <HomeShelfRow> shelf;
    property <int> rows: Shapes.grid-rows;
    property <int> per-page: max(2, floor((root.width + Theme.card-gap) / (Shapes.grid-col + Theme.card-gap)));
    property <int> columns: ceil(root.shelf.songs.length / root.rows);
    property <length> col-w: min(Shapes.grid-col, floor((root.width - (root.per-page - 1) * Theme.card-gap) / root.per-page / 1px) * 1px);
    // The first column shown (`FeedShelf` reads it).
    in-out property <int> first: 0;
    property <float> at: root.first;
    animate at { duration: Theme.moving ? Theme.t-panel + 40ms : 0ms; easing: Curves.ease-in-out; }
    property <int> last-first: max(0, root.columns - root.per-page);
    height: Shapes.height(ShelfShape.songs, root.width, root.shelf.songs.length);
    hover := TouchArea {
        ShelfHead {
            x: 0;
            y: 0;
            width: parent.width;
            lead: root.shelf.lead;
            title: root.shelf.title;
            arrows: hover.has-hover && root.columns > root.per-page;
            can-back: root.first > 0;
            can-forward: root.first < root.last-first;
            back => { root.first = max(0, root.first - root.per-page); }
            forward => { root.first = min(root.last-first, root.first + root.per-page); }
        }
        // The rows' hover tiles reach 8 px past the column on both sides.
        Rectangle {
            x: -8px;
            y: Shapes.head-h;
            width: parent.width + 16px;
            height: parent.height - Shapes.head-h;
            clip: true;
            for t[i] in root.shelf.songs: SongRow {
                x: (floor(i / root.rows) - root.at) * (root.col-w + Theme.card-gap);
                y: mod(i, root.rows) * Theme.row-h;
                width: root.col-w + 16px;
                height: Theme.row-h;
                track: t;
                show-duration: false;
                menu: true;
                clicked => { HomeData.play-song(t.id); }
                play => { HomeData.play-song(t.id); }
                menu-requested(x, y, top) => { SongMenu.show(t, x, y, top); }
            }
        }
    }
}

// A compact item row for the featured mode's right column: cover, title, subtitle.
component ItemRow inherits Rectangle {
    in property <CardItem> item;
    callback clicked();
    height: Theme.row-h;
    border-radius: Theme.r-m;
    background: Theme.state(ta.pressed, ta.has-hover);
    accessible-role: button;
    accessible-label: root.item.title;
    accessible-action-default => { root.clicked(); }
    animate background { duration: Theme.t-hover; easing: Curves.ease-hover; }
    PageIntent {
        hovered: ta.has-hover;
        pressed: ta.pressed;
        pointer-x: ta.mouse-x;
        pointer-y: ta.mouse-y;
        kind: root.item.kind;
        id: root.item.id;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Cover {
        x: 8px;
        y: (parent.height - self.height) / 2;
        width: Theme.row-cover;
        height: Theme.row-cover;
        radius: Theme.r-s;
        round: root.item.round;
        source: root.item.cover;
    }
    VerticalLayout {
        x: 8px + Theme.row-cover + 12px;
        width: parent.width - self.x - 8px;
        alignment: center;
        spacing: 1px;
        Body {
            text: root.item.title;
            font-weight: 600;
        }
        Body {
            text: root.item.subtitle;
            font-size: Theme.t-meta;
            color: Theme.text2;
        }
    }
}

// "Pick up where you left off": one card as wide as the shelf row under it (`HomeTop`), so it
// stops where Home's shelves stop instead of running the full width. The 152 px cover, then
// the song on one column: the title and artist on short lines (no separators), the progress
// line with its times across the column, and Pause or Resume and Go to album at the cover's
// foot. A hairline, then what's next in the queue as a column of rows under a plain label.
// The card ends with the shelf row, so the two columns can't drift apart as the window
// grows. A card too narrow for both (the Up next panel open) drops the queue's: the song's
// column keeps the room its buttons need.
component ResumeCard inherits Rectangle {
    property <length> pad: Theme.hero-pad;
    property <length> cover: Theme.hero-cover;
    property <length> text-x: root.pad + root.cover + Theme.s5;
    // The room the song's column needs beside the queue: the buttons, and a title's worth.
    property <length> song-min-w: max(260px, buttons.preferred-width);
    // The narrowest card that keeps the queue's column (its rows at their narrowest), so a
    // short row of shortcuts doesn't hide the queue (`HomeTop`).
    out property <length> queue-min-w: root.text-x + root.song-min-w + 2 * Theme.s5 + 1px + 260px - 16px + root.pad;
    // The queue's rows, their 8 px insets included: about a third of the card.
    property <length> rows-w: clamp(floor(root.width * 0.3 / 1px) * 1px, 260px, 320px);
    // The rows' hover tiles reach 8 px past the column on both sides, as Quick picks' do.
    property <length> rows-x: root.width - root.pad + 8px - root.rows-w;
    // The hairline, a gap left of the rows' covers.
    property <length> rule-x: root.rows-x + 8px - Theme.s5 - 1px;
    // The song's column beside the queue, while that leaves it its room.
    property <length> with-queue-w: root.rule-x - Theme.s5 - root.text-x;
    property <bool> has-queue: root.with-queue-w >= root.song-min-w;
    property <length> text-w: root.has-queue ? root.with-queue-w : root.width - root.text-x - root.pad;
    height: root.cover + 2 * root.pad;
    border-radius: Theme.r-l;
    background: Theme.card;
    border-width: 1px;
    border-color: Theme.card-edge;

    Cover {
        x: root.pad;
        y: root.pad;
        width: root.cover;
        height: root.cover;
        crossfade: true;
        source: HomeData.hero-cover;
    }

    Rectangle {
        x: root.text-x;
        y: root.pad;
        width: root.text-w;
        height: root.cover;
        Display {
            x: 0;
            y: 0;
            width: parent.width;
            height: 36px;
            text: Player.title;
            font-size: Theme.t-display-m;
            vertical-alignment: center;
        }
        Body {
            x: 0;
            y: 38px;
            width: parent.width;
            height: 20px;
            text: Player.artist;
            font-size: Theme.t-body-l;
            color: Theme.text2;
            vertical-alignment: center;
        }
        // Across the column, a line's gap over the buttons. The elapsed time is as wide as the
        // length, so the line doesn't shift as it ticks.
        if Player.duration-s > 0: HorizontalLayout {
            x: 0;
            y: parent.height - 40px - Theme.s4 - self.height;
            width: parent.width;
            height: 16px;
            spacing: Theme.s3;
            Body {
                width: total.preferred-width;
                text: Player.elapsed;
                font-size: Theme.t-meta;
                color: Theme.text2;
                vertical-alignment: center;
                overflow: clip;
            }
            Rectangle {
                horizontal-stretch: 1;
                accessible-role: progress-indicator;
                accessible-label: @tr("{0} of {1}", Player.elapsed, Player.total);
                ProgressRail {
                    y: (parent.height - self.height) / 2;
                    width: parent.width;
                    progress: Player.position-s / Player.duration-s;
                }
            }
            total := Body {
                text: Player.total;
                font-size: Theme.t-meta;
                color: Theme.text2;
                vertical-alignment: center;
            }
        }
        buttons := HorizontalLayout {
            x: 0;
            y: parent.height - self.height;
            width: self.preferred-width;
            height: 40px;
            spacing: Theme.s2;
            Pill {
                label: Player.playing ? @tr("Pause") : @tr("Resume");
                // As wide as the wider label, so Go to album doesn't shift as it toggles.
                alt-label: Player.playing ? @tr("Resume") : @tr("Pause");
                icon: Player.playing ? Icons.pause : Icons.play;
                solid: true;
                clicked => { HomeData.resume-clicked(); }
            }
            if Player.album-id != "": Pill {
                label: @tr("Go to album");
                clicked => { Nav.open-album(Player.album-id); }
            }
        }
    }

    if root.has-queue: Rectangle {
        x: root.rule-x;
        y: root.pad;
        width: 1px;
        height: root.cover;
        background: Theme.hairline;
    }
    // The label, then the rows from the top (`home.rs::HERO_NEXT`, three at most; two or one when
    // the queue holds fewer), over the cover's height and 4 px past it at both ends.
    if root.has-queue: Rectangle {
        x: root.rows-x;
        y: root.pad - 4px;
        width: root.rows-w;
        height: root.cover + 8px;
        Body {
            x: 8px;
            y: -4px;
            width: parent.width - 16px;
            height: 20px;
            text: @tr("Next in queue");
            font-weight: 600;
            color: Theme.text2;
            vertical-alignment: center;
        }
        if HomeData.next.length == 0: Body {
            x: 8px;
            y: 24px;
            width: parent.width - 16px;
            height: 20px;
            text: @tr("Nothing after this one");
            color: Theme.text3;
            vertical-alignment: center;
        }
        for t[i] in HomeData.next: SongRow {
            x: 0;
            y: parent.height - 3 * Theme.track-row-h + i * Theme.track-row-h;
            width: parent.width;
            height: Theme.track-row-h;
            track: t;
            menu: true;
            show-duration: false;
            double-clicked => { HomeData.play-next(i); }
            play => { HomeData.play-next(i); }
            menu-requested(x, y, top) => { SongMenu.show(t, x, y, top); }
        }
    }
}

// "Start listening" on a fresh start: a 152 px cover, the pick on short lines, Play and Go to
// it; on the right, more from its shelf as a 2 x 2 grid of rows under a plain column heading.
// The pick's column takes what it needs, up to 520 px, and the rows take the rest, so on a
// wide window the two halves stay together instead of drifting to the card's ends. A card
// too narrow for the rows (the Up next panel open at 1280) drops them.
component FeaturedCard inherits Rectangle {
    property <length> pad: Theme.hero-pad;
    property <length> cover: Theme.hero-cover;
    property <length> text-x: root.pad + root.cover + Theme.s5;
    // The room right of the cover, for the text, the gap and the rows.
    property <length> avail: root.width - root.text-x - root.pad;
    property <bool> has-list: root.avail >= 300px + Theme.s5 + 260px;
    property <length> text-w: root.has-list ? max(300px, min(520px, root.avail - Theme.s5 - 428px)) : root.avail;
    property <length> list-w: root.avail - root.text-w - Theme.s5;
    property <int> cols: root.list-w >= 420px ? 2 : 1;
    property <length> col-w: floor((root.list-w - (root.cols - 1) * Theme.s2) / root.cols / 1px) * 1px;
    height: root.cover + 2 * root.pad;
    border-radius: Theme.r-l;
    background: Theme.card;
    border-width: 1px;
    border-color: Theme.card-edge;

    Cover {
        x: root.pad;
        y: root.pad;
        width: root.cover;
        height: root.cover;
        crossfade: true;
        round: HomeData.featured.round;
        source: HomeData.hero-cover;
    }

    Rectangle {
        x: root.text-x;
        y: root.pad;
        width: root.text-w;
        height: root.cover;
        Display {
            x: 0;
            y: 0;
            width: parent.width;
            height: 36px;
            text: HomeData.featured.title;
            font-size: Theme.t-display-m;
            vertical-alignment: center;
        }
        Body {
            x: 0;
            y: 38px;
            width: parent.width;
            height: 20px;
            text: HomeData.featured.subtitle;
            font-size: Theme.t-body-l;
            color: Theme.text2;
            vertical-alignment: center;
        }
        HorizontalLayout {
            x: 0;
            y: parent.height - self.height;
            height: 40px;
            alignment: start;
            spacing: Theme.s2;
            Pill {
                label: @tr("Play");
                icon: Icons.play;
                solid: true;
                clicked => { HomeData.play-featured(); }
            }
            if HomeData.featured.kind != ItemKind.song: Pill {
                label: HomeData.featured.kind == ItemKind.artist ? @tr("Go to artist") : (HomeData.featured.kind == ItemKind.album ? @tr("Go to album") : @tr("Open playlist"));
                clicked => { HomeData.open-featured(-1); }
            }
        }
    }

    if root.has-list: Rectangle {
        x: root.width - root.list-w - root.pad;
        y: root.pad;
        width: root.list-w;
        height: root.cover;
        Body {
            x: 8px;
            y: 0;
            width: parent.width - 16px;
            height: 24px;
            text: HomeData.featured-from;
            font-weight: 600;
            vertical-alignment: center;
        }
        for it[i] in HomeData.featured-more: ItemRow {
            x: mod(i, root.cols) * (root.col-w + Theme.s2);
            y: parent.height - 2 * Theme.row-h + floor(i / root.cols) * Theme.row-h;
            width: root.col-w;
            item: it;
            visible: i < 2 * root.cols;
            clicked => { HomeData.open-featured(i); }
        }
    }
}

// The feed while it loads, in the shapes it usually arrives in: a row of mix shortcuts, the
// Quick picks grid, then a shelf of standard cards. Laid out as the shelves lay themselves
// out, so nothing jumps when the data lands.
component HomeSkeleton inherits Skeleton {
    property <int> mix-cols: Shapes.per-row(ShelfShape.mixes, root.width);
    property <length> mix-w: Shapes.mix-w(root.width, Shapes.lead-tiles);
    property <length> mixes-h: Shapes.height(ShelfShape.mixes, root.width, root.mix-cols);
    property <length> grid-y: root.mixes-h + Theme.section-gap;
    property <int> grid-cols: max(2, floor((root.width + Theme.card-gap) / (Shapes.grid-col + Theme.card-gap)));
    property <length> col-w: min(Shapes.grid-col, floor((root.width - (root.grid-cols - 1) * Theme.card-gap) / root.grid-cols / 1px) * 1px);
    property <length> cards-y: root.grid-y + Shapes.height(ShelfShape.songs, root.width, 0) + Theme.section-gap;
    property <int> per-row: Shapes.per-row(ShelfShape.cards, root.width);
    property <length> card: Shapes.tile-w(ShelfShape.cards, root.width);
    height: root.cards-y + Shapes.height(ShelfShape.cards, root.width, 0);
    for y in [0px, root.grid-y, root.cards-y]: SkeletonBlock {
        x: 0;
        y: y + 8px;
        width: 180px;
        height: 16px;
        border-radius: Theme.r-s;
        sweep: root.sweep;
        fade: root.fade;
    }
    // As many shortcuts as the Shortcuts row holds (`Shapes.lead-tiles`).
    for i in min(root.mix-cols, Shapes.lead-tiles): Rectangle {
        x: i * (root.mix-w + Shapes.mix-gap);
        y: Shapes.head-h;
        width: root.mix-w;
        height: Shapes.mix-h;
        SkeletonBlock {
            width: Shapes.mix-h;
            height: Shapes.mix-h;
            x: 0;
            y: 0;
            border-radius: Theme.r-m;
            sweep: root.sweep;
            fade: root.fade;
        }
        SkeletonBar {
            x: Shapes.mix-h + Theme.s3;
            y: (parent.height - self.height) / 2;
            width: floor(min(parent.width - self.x - 56px, 140px) * [0.7, 0.5, 0.62, 0.56, 0.66, 0.48, 0.6][mod(i, 7)] / 1px) * 1px;
            sweep: root.sweep;
            fade: root.fade;
        }
    }
    for i in root.grid-cols * Shapes.grid-rows: SkeletonRow {
        x: floor(i / Shapes.grid-rows) * (root.col-w + Theme.card-gap) - 8px;
        y: root.grid-y + Shapes.head-h + mod(i, Shapes.grid-rows) * Theme.row-h;
        width: root.col-w + 16px;
        index: i;
        compact: true;
        duration: false;
        sweep: root.sweep;
        fade: root.fade;
    }
    for i in root.per-row: SkeletonCard {
        x: i * (root.card + Theme.card-gap);
        y: root.cards-y + Shapes.head-h;
        size: root.card;
        index: i;
        sweep: root.sweep;
        fade: root.fade;
    }
}

// The row after the last shelf while the next page loads: a shelf's skeleton, small cards.
component MoreSkeleton inherits Skeleton {
    property <int> per-row: Shapes.per-row(ShelfShape.playlists, root.width);
    property <length> card: Shapes.tile-w(ShelfShape.playlists, root.width);
    height: Shapes.height(ShelfShape.playlists, root.width, 0);
    accessible-label: @tr("Loading more of Home");
    SkeletonBlock {
        x: 0;
        y: 8px;
        width: 180px;
        height: 16px;
        border-radius: Theme.r-s;
        sweep: root.sweep;
        fade: root.fade;
    }
    for i in root.per-row: SkeletonCard {
        x: i * (root.card + Theme.card-gap);
        y: Shapes.head-h;
        size: root.card;
        index: i;
        sweep: root.sweep;
        fade: root.fade;
    }
}

// The row after the last shelf when the next page failed: a quiet line and Try again, not
// the page's error (the shelves above stay).
component MoreFailed inherits Rectangle {
    height: lay.preferred-height;
    accessible-role: text;
    accessible-label: @tr("More of Home didn\u{2019}t load");
    lay := HorizontalLayout {
        alignment: start;
        spacing: Theme.s4;
        Body {
            text: @tr("More of Home didn\u{2019}t load");
            color: Theme.text2;
            vertical-alignment: center;
        }
        Pill {
            label: @tr("Try again");
            clicked => { HomeData.retry-more(); }
        }
    }
}

// One shelf of the feed, in its shape; its height follows the shape so the column can stack.
component FeedShelf inherits Rectangle {
    in property <HomeShelfRow> shelf;
    // Some of it shows: its covers may start taking layers (`TileShelf.warm`).
    in property <bool> in-sight: true;
    // A song grid's first column shown (the feed's row reports its songs, `RowsShown`).
    in-out property <int> grid-first;
    height: Shapes.height(root.shelf.shape, root.width, root.shelf.shape == ShelfShape.songs ? root.shelf.songs.length : root.shelf.items.length);
    if root.shelf.shape == ShelfShape.songs: SongGrid {
        width: parent.width;
        shelf: root.shelf;
        first <=> root.grid-first;
    }
    if root.shelf.shape == ShelfShape.mixes: MixShelf {
        width: parent.width;
        shelf: root.shelf;
    }
    if root.shelf.shape != ShelfShape.songs && root.shelf.shape != ShelfShape.mixes: TileShelf {
        width: parent.width;
        shelf: root.shelf;
        in-sight: root.in-sight;
    }
}

// The top of the feed: the hero, then the loading, error or empty state, a section apart.
component HomeTop inherits VerticalLayout {
    in property <length> inner;
    spacing: Theme.section-gap;
    // Home has no "Home" title: the hero is titled like a shelf, so the page reads as one
    // rhythm of 24 px headings.
    if HomeData.resume || HomeData.has-featured: VerticalLayout {
        spacing: 0;
        ShelfHead {
            title: HomeData.resume ? @tr("Pick up where you left off") : @tr("Start listening");
        }
        // As wide as a row of four shortcuts under it (996 px once they're at their full 240 px),
        // which keeps one length however wide the page is (`Shapes.mix-max`): steady, and lined
        // up with the Shortcuts row.
        if HomeData.resume: Rectangle {
            height: card.height;
            card := ResumeCard {
                x: 0;
                y: 0;
                width: min(parent.width, Shapes.row-w(ShelfShape.mixes, parent.width, Shapes.lead-tiles));
            }
        }
        if !HomeData.resume: FeaturedCard { }
    }
    if HomeData.loading && HomeData.shelves.length == 0: HomeSkeleton { }
    if !HomeData.loading && HomeData.error != "": ErrorState {
        width: min(480px, root.inner);
        message: HomeData.error;
        retry => { HomeData.retry(); }
    }
    if !HomeData.loading && HomeData.error == "" && HomeData.empty: EmptyState {
        width: min(480px, root.inner);
        glyph: Icons.home;
        title: @tr("Nothing on Home yet");
        line: @tr("Home fills in as you listen. Use Search to find something to play.");
    }
}

export component HomePage inherits Rectangle {
    property <length> pad: Theme.page-pad;
    // The wash: the resumed song's colour from the window's top, behind the clear top bar,
    // fading into the ground by the Shortcuts row. A new track crossfades it, colour to
    // colour; nothing to resume leaves the page plain. The page itself starts below the bar,
    // so nothing scrolls under it: as the page scrolls the bar's height, the ground comes back
    // behind the bar (`TopScrim`, as on album pages), and from there the wash is clipped to
    // the page, so the bar isn't repainted with every scroll frame.
    property <color> wash: Theme.dark ? HomeData.wash-dark : HomeData.wash-light;
    animate wash { duration: Theme.t-colour; easing: Curves.ease-hover; }
    // From the window's top (and `rise` above it, for the page's enter offset).
    property <length> wash-top: Theme.top-bar-h + Theme.rise;
    property <length> wash-h: root.wash-top + 420px;
    property <length> scrolled: -list.content-y;
    property <bool> wash-on: HomeData.resume && root.scrolled < root.wash-h - root.wash-top;
    property <bool> wash-under-bar: root.wash-on && root.scrolled < Theme.top-bar-h;
    changed wash-under-bar => { HomeData.wash-behind-bar = self.wash-under-bar; }
    property <length> inner: self.width - 2 * self.pad;
    property <int> count: HomeData.shelves.length;
    // Rows: the top, the shelves, then the next page's row while it loads or failed.
    property <int> rows: HomeData.row-count;
    // `HomeTop` shows something (so the first shelf keeps a section's distance from it).
    property <bool> top-shown: HomeData.resume || HomeData.has-featured || (HomeData.loading && root.count == 0) || (!HomeData.loading && (HomeData.error != "" || HomeData.empty));

    // The rows' model follows `rows`, a row at a time at its end. Not `for i in root.rows`:
    // Slint makes a new model of an int each time it changes, and a ListView given a new
    // model drops every row and builds them again (every shelf on screen, its cards and their
    // covers' layers: a 40 ms frame at 4K when the next page's row came, another when it
    // landed).
    init => {
        HomeData.sync-rows(root.rows);
        HomeData.wash-behind-bar = root.wash-under-bar;
    }
    changed rows => { HomeData.sync-rows(root.rows); }

    // Behind the list, not in a row: it follows the scroll (`content-y`) without depending
    // on row 0 being alive, and is gone once scrolled past. Opaque, down to the ground, in
    // solid bands rather than a gradient (`Bands`: even a two-stop opaque gradient is filled
    // pixel by pixel, ~0.6 ms of a 4K scroll frame). Once the bar has its ground back, the
    // part scrolled above the page isn't drawn (its top colour moves down the bands instead),
    // so nothing above the page repaints while Home scrolls.
    if root.wash-on: Bands {
        property <length> full-y: list.content-y - root.wash-top;
        property <length> cut: max(0px, (root.wash-under-bar ? -root.wash-top : 0px) - self.full-y);
        y: self.full-y + self.cut;
        width: root.width;
        height: root.wash-h - self.cut;
        count: 64;
        top: root.wash.mix(Theme.ground, 1 - self.cut / root.wash-h);
        bottom: Theme.ground;
    }

    // A ListView, so only the rows near the window exist: a shelf scrolled far away is dropped
    // with its cards, their art and their covers' layers (a long Home kept every card's).
    // Row 0 is `HomeTop`, row i shelf i - 1. No scroll bar, as before: its thumb would show
    // and ease its size on every resize.
    //
    // It runs on under the floating bar, where the page's clip (`app.slint`) hides it, so a
    // row is made a little before it shows. Its shelf starts warming its covers' layers
    // (`TileShelf.warm`) only once it's in sight, above the bar's top, so they spread over
    // the frames after rather than all being made unseen and drawn in the frame it shows.
    // (Not by ending the ListView at the bar: a viewport shorter than the content makes the
    // hidden scroll bar ease its thumb on every content change, a running animation.)
    list := ListView {
        vertical-scrollbar-policy: always-off;
        // Within a window's height of the end, scrolling asks for the next page (`home.rs`
        // lets one go at a time, and none once the feed ends). Only a scroll asks.
        changed content-y => {
            if root.count > 0 && -self.content-y + 2 * self.visible-height >= self.content-height {
                HomeData.near-end();
            }
        }
        for slot[i] in HomeData.rows: feed-row := Rectangle {
            // The row's top is above the floating bar's.
            property <bool> in-sight: self.y + list.content-y < root.height - Theme.bar-clear;
            // A song shelf's songs on screen, its grid's page (`FeedShelf.grid-first`), are
            // resolved ahead of a click. Told from the row, which lives as long as its
            // instance, so a row reused for another shelf, or for none, says so.
            property <int> grid-first;
            property <bool> songs: i > 0 && i <= root.count && HomeData.shelves[i - 1].shape == ShelfShape.songs;
            height: row.preferred-height;
            RowsShown {
                list: SongList.home;
                part: i - 1;
                first: feed-row.grid-first * Shapes.grid-rows;
                last: feed-row.songs && feed-row.in-sight && feed-row.y + list.content-y + feed-row.height > 0 ? min(HomeData.shelves[i - 1].songs.length, (feed-row.grid-first + max(2, floor((root.inner + Theme.card-gap) / (Shapes.grid-col + Theme.card-gap)))) * Shapes.grid-rows) - 1 : -1;
            }
            row := VerticalLayout {
                width: parent.width;
                padding-left: root.pad;
                padding-right: root.pad;
                padding-top: i == 0 ? Theme.page-top : (i == 1 && !root.top-shown ? 0px : Theme.section-gap);
                // Past the floating bar, with the usual gap.
                padding-bottom: i == HomeData.rows.length - 1 ? Theme.page-end : 0px;
                if i == 0: HomeTop {
                    inner: root.inner;
                }
                if i > 0 && i <= root.count: FeedShelf {
                    shelf: HomeData.shelves[i - 1];
                    in-sight: feed-row.in-sight;
                    grid-first <=> feed-row.grid-first;
                }
                if i > root.count && HomeData.more == MoreState.loading: MoreSkeleton { }
                if i > root.count && HomeData.more == MoreState.failed: MoreFailed { }
            }
        }
    }
    // Behind the bar (the page starts below it), while the wash shows there, the ground comes
    // back over the first `top-bar-h` of scroll, fading out just below the bar, as album pages'
    // `TopScrim` does; then the frame's own bar and fade take over, the same. A flat fill and
    // a short two-stop fade, their alpha following the scroll (an `opacity` would draw them
    // through a layer).
    if root.wash-under-bar && root.scrolled > 0: Rectangle {
        property <color> ink: Theme.ground.transparentize(1 - clamp(root.scrolled / Theme.top-bar-h, 0, 1));
        y: -Theme.top-bar-h;
        height: Theme.top-bar-h + Theme.s4;
        Rectangle {
            y: 0;
            height: Theme.top-bar-h;
            background: parent.ink;
        }
        Bands {
            y: Theme.top-bar-h;
            height: Theme.s4;
            count: 16;
            top: parent.ink;
            bottom: parent.ink.transparentize(1);
        }
    }
}
