// Home (the layout chosen 2026-11-14: a band and rails): the band, then the Home feed as
// rails. Data comes from `src/pages/home.rs` through `HomeData`.
//
// The band (`Band`, in `home/hero.slint`) is the session in its cover's colour: "Pick up where
// you left off" with Resume, "Now playing" while it plays, or on a fresh start with an empty
// queue a featured pick from the first shelf with Play; the song's four actions; what's next
// in the queue on its right.
//
// Every shelf is one rail of large tiles that pages sideways (`TileShelf`), running past the
// page's right padding to its edge, so the cut-off tile says there's more. Each takes the
// shape of what it holds (`home.rs::arrange`): videos as wide 16:9 tiles, artists as round
// faces with only their names, the rest square; quick picks stay a dense song grid of two
// rows. Your mixes come first, opened by "Shuffle Liked songs" (a red tile with a white
// heart, as on its own page, and a shuffle badge), and a community playlist wears its
// creator's round photo over its collage's bottom-left corner.
//
// More shelves load as the user scrolls near the end (`home.rs::Paging`): a quiet skeleton
// shelf while a page loads, a quiet Try again if it fails; Home itself never errors for it.
//
// `HomeData` is in `home/data.slint`; this file lays out the page and its shelves.
import { ListView } from "../list_view.slint";
import { Theme, Curves, Icons } from "../theme.slint";
import { CardItem, ItemKind, Body, Display, Card, Icon, Pill, SongRow, ShelfArrows, RowsShown, SongList, PageIntent } from "../parts.slint";
import { Skeleton, SkeletonBlock, SkeletonBar, SkeletonRow, SkeletonCard, ErrorState, EmptyState, Open } from "content.slint";
import { SongMenu } from "../song_menu.slint";
import { ShelfShape, MoreState, HomeShelfRow, HomeData } from "home/data.slint";
import { Band, BandSizes } from "home/hero.slint";

export { ShelfShape, MoreState, HomeShelfRow, HomeData } from "home/data.slint";

// The sizes Explore's shelves lay out with, in the shapes Home gives them
// (`home.rs::arrange`). A tile has one steady width (`tile-max`) and a row holds as many as
// fit, the rest of the row left empty. Only a page too narrow for two shrinks them. Covers are
// fetched at about a tile's width (`shelves.rs::cover_px`).
export global Shapes {
    out property <length> head-h: 48px;
    out property <length> mix-h: 64px;
    out property <length> mix-gap: Theme.s3;
    // Mixes show two rows a page at most.
    out property <int> mix-rows: 2;
    // Quick picks: columns of four rows, as many 380 px columns as fit.
    out property <int> grid-rows: 4;
    out property <length> grid-col: 380px;
    // A community playlist's avatar badge (`home.rs::BADGE`), its ring included.
    out property <length> badge: 32px;
    // Mixes: the narrowest a shortcut may get. The other shapes: their one width.
    public pure function tile-max(s: ShelfShape) -> length {
        return s == ShelfShape.mixes ? 220px : (s == ShelfShape.videos ? 300px : (s == ShelfShape.playlists ? 160px : (s == ShelfShape.artists ? 120px : 192px)));
    }
    public pure function gap(s: ShelfShape) -> length {
        return s == ShelfShape.mixes ? root.mix-gap : Theme.card-gap;
    }
    public pure function per-row(s: ShelfShape, w: length) -> int {
        return max(2, floor((w + Shapes.gap(s)) / (Shapes.tile-max(s) + Shapes.gap(s))));
    }
    public pure function tile-w(s: ShelfShape, w: length) -> length {
        return min(Shapes.tile-max(s), floor((w - (Shapes.per-row(s, w) - 1) * Shapes.gap(s)) / Shapes.per-row(s, w) / 1px) * 1px);
    }
    public pure function art-h(s: ShelfShape, w: length) -> length {
        return s == ShelfShape.videos ? round(Shapes.tile-w(s, w) * 9 / 16 / 1px) * 1px : Shapes.tile-w(s, w);
    }
    public pure function rows(n: int, w: length) -> int {
        return max(1, min(root.mix-rows, ceil(n / Shapes.per-row(ShelfShape.mixes, w))));
    }
    // A shelf's height with its heading, `n` items in `w`.
    public pure function height(s: ShelfShape, w: length, n: int) -> length {
        if s == ShelfShape.songs {
            return root.head-h + root.grid-rows * Theme.row-h;
        }
        if s == ShelfShape.mixes {
            return root.head-h + Shapes.rows(n, w) * root.mix-h + (Shapes.rows(n, w) - 1) * root.mix-gap;
        }
        return root.head-h + Shapes.art-h(s, w) + Theme.card-text-gap + (s == ShelfShape.artists ? 24px : 40px);
    }
}

// Home's rails. A tile has one width whatever the page's (200 px, a video 300); a rail holds
// as many as fit, and the next one shows cut off at the page's edge. Covers are fetched at a
// tile's width (`shelves.rs::cover_px`).
export global Rails {
    out property <length> head-h: 48px;
    // The gap between the band and the rails, and between rails.
    out property <length> gap: Theme.s6;
    // Quick picks: columns of two rows, as many 380 px columns as fit.
    out property <int> grid-rows: 2;
    out property <length> grid-col: 380px;
    // A community playlist's avatar badge (`home.rs::BADGE`), its ring included.
    out property <length> badge: 32px;
    public pure function tile-w(s: ShelfShape) -> length {
        return s == ShelfShape.videos ? 300px : 200px;
    }
    // Whole tiles in `w` (paging moves by these).
    public pure function per-row(s: ShelfShape, w: length) -> int {
        return max(1, floor((w + Theme.card-gap) / (Rails.tile-w(s) + Theme.card-gap)));
    }
    public pure function art-h(s: ShelfShape) -> length {
        return s == ShelfShape.videos ? round(Rails.tile-w(s) * 9 / 16 / 1px) * 1px : Rails.tile-w(s);
    }
    // A shelf's height with its heading.
    public pure function height(s: ShelfShape) -> length {
        if s == ShelfShape.songs {
            return root.head-h + root.grid-rows * Theme.row-h;
        }
        return root.head-h + Rails.art-h(s) + Theme.card-text-gap + (s == ShelfShape.artists ? 24px : 40px);
    }
}

// A shelf's heading: optional lead words in text2 ("Similar to"), the title, and the paging
// arrows while the shelf is hovered and has more than a page.
component ShelfHead inherits Rectangle {
    in property <string> lead;
    in property <string> title;
    in property <bool> arrows;
    in property <bool> can-back;
    in property <bool> can-forward;
    callback back();
    callback forward();
    height: Rails.head-h;
    HorizontalLayout {
        x: 0;
        y: 0;
        // Room for the arrows always, so the title doesn't re-elide when they show.
        width: root.width - 88px;
        height: 32px;
        alignment: start;
        spacing: Theme.s2;
        if root.lead != "": Display {
            text: root.lead;
            font-size: Theme.t-display-s;
            color: Theme.text2;
            vertical-alignment: center;
            horizontal-stretch: 0;
        }
        Display {
            text: root.title;
            font-size: Theme.t-display-s;
            vertical-alignment: center;
            accessible-role: text;
        }
    }
    if root.arrows: ShelfArrows {
        x: parent.width - self.width;
        y: 0;
        can-back: root.can-back;
        can-forward: root.can-forward;
        back => { root.back(); }
        forward => { root.forward(); }
    }
}

// What a tile does: songs play (with radio after them), the rest open; the play button plays
// the album, playlist or artist without opening it.
global Tiles {
    public function open(it: CardItem) {
        if it.kind == ItemKind.song {
            HomeData.play-song(it.id);
        } else {
            Open.item(it);
        }
    }
    public function play(it: CardItem) {
        if it.kind == ItemKind.song {
            HomeData.play-song(it.id);
        } else {
            HomeData.play-card(it);
        }
    }
}

// "Shuffle Liked songs", the first rail's first tile: the Liked songs tile (red, a white
// heart) with a shuffle badge; a click plays Liked songs shuffled (the sidebar still opens
// the page).
component ShuffleLiked inherits Rectangle {
    in property <length> size;
    callback clicked();
    width: root.size;
    height: root.size + Theme.card-text-gap + 40px;
    accessible-role: button;
    accessible-label: @tr("Shuffle Liked songs");
    accessible-action-default => { root.clicked(); }
    Rectangle {
        x: 0;
        y: 0;
        width: root.size;
        height: root.size;
        border-radius: Theme.r-m;
        clip: true;
        transform-scale: ta.pressed ? Theme.press-scale : 1.0;
        animate transform-scale {
            duration: ta.pressed ? Theme.t-press : Theme.t-release;
            easing: ta.pressed ? Curves.ease-out : Curves.release;
        }
        background: @linear-gradient(135deg, Theme.brand-accent 0%, #7A0E20 100%);
        Icon {
            width: 56px;
            height: 56px;
            commands: Icons.heart;
            fill: #FFFFFF;
            stroke: transparent;
        }
        Rectangle {
            x: Theme.s3;
            y: parent.height - self.height - Theme.s3;
            width: 44px;
            height: 44px;
            border-radius: self.width / 2;
            background: #000000BF;
            Icon {
                width: 20px;
                height: 20px;
                commands: Icons.shuffle;
                stroke: #FFFFFF;
            }
        }
        Rectangle {
            background: ta.pressed ? Theme.cover-pressed : (ta.has-hover ? Theme.cover-hover : transparent);
            animate background { duration: Theme.t-hover; }
        }
    }
    title := Body {
        y: root.size + Theme.card-text-gap;
        width: root.size;
        text: @tr("Shuffle Liked songs");
        font-weight: 600;
    }
    if ta.has-hover: Rectangle {
        y: root.size + Theme.card-text-gap + 18px;
        width: min(root.size, title.preferred-width);
        height: 1px;
        background: Theme.text1;
    }
    Body {
        y: root.size + Theme.card-text-gap + 20px;
        width: root.size;
        text: @tr("Everything you liked");
        font-size: Theme.t-meta;
        color: Theme.text2;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A rail of tiles shaped for its shelf (videos 16:9, artists round faces without a subtitle,
// the rest square), paged a page of whole tiles at a time. The tiles run on past the shelf's
// right edge by `bleed` (the page's padding), where the next one shows cut off.
component TileShelf inherits Rectangle {
    in property <HomeShelfRow> shelf;
    in property <length> bleed;
    // Some of it shows: the warming starts then.
    in property <bool> in-sight: true;
    property <ShelfShape> shape: root.shelf.shape;
    property <int> per-row: Rails.per-row(root.shape, root.width);
    property <length> tile-w: Rails.tile-w(root.shape);
    // Whole tiles and the one cut off at the edge.
    property <int> in-view: ceil((root.width + root.bleed + Theme.card-gap) / (root.tile-w + Theme.card-gap));
    property <int> first: 0;
    // The tile at the left edge, eased while paging; the tiles follow it, so a resize
    // moves them at once.
    property <float> at: root.first;
    animate at { duration: Theme.moving ? Theme.t-panel + 40ms : 0ms; easing: Curves.ease-in-out; }
    property <int> last-first: max(0, root.shelf.items.length - root.per-row);
    // Cards whose covers may take their layer: one more each tick after the shelf comes in sight,
    // not all in the frame it enters (each layer is ~0.7 ms at 4K, a row of them a frame's
    // worth). Until then a cover draws directly, where little of it shows yet. Once the first
    // page's cards have theirs the shelf is warm for good and the timer stops: a resize or a
    // page turn later doesn't start it again.
    property <int> warm: 0;
    property <bool> warmed: false;
    warming := Timer {
        interval: 8ms;
        running: !root.warmed && root.in-sight;
        triggered => {
            root.warm += 1;
            root.warmed = root.warm >= max(1, root.in-view);
        }
    }
    height: Rails.height(root.shape);
    hover := TouchArea {
        // One clip for the heading and the tiles: as the page scrolls, a shelf adds its two
        // rectangles (where it was and where it is) to the frame's damage, not its heading's
        // two besides, which pushed the playing mark's step into a merge with them
        // (`tests/app/playing_frames.rs`).
        Rectangle {
            x: 0;
            y: 0;
            width: parent.width + root.bleed;
            height: parent.height;
            clip: true;
            ShelfHead {
                x: 0;
                y: 0;
                width: root.width;
                lead: root.shelf.lead;
                title: root.shelf.title;
                arrows: hover.has-hover && root.shelf.items.length > root.per-row;
                can-back: root.first > 0;
                can-forward: root.first < root.last-first;
                back => { root.first = max(0, root.first - root.per-row); }
                forward => { root.first = min(root.last-first, root.first + root.per-row); }
            }
            for it[i] in root.shelf.items: Rectangle {
                x: (i - root.at) * (root.tile-w + Theme.card-gap);
                y: Rails.head-h;
                width: root.tile-w;
                height: parent.height - Rails.head-h;
                // Shown, or partly shown while paging (the others draw nothing), and warm.
                property <bool> on-page: i + 1 > root.at && i < root.at + root.in-view && (root.warmed || i - root.first < root.warm);
                if it.id == "LM": ShuffleLiked {
                    size: root.tile-w;
                    clicked => { HomeData.shuffle-liked(); }
                }
                if it.id != "LM": Card {
                    size: root.tile-w;
                    art-h: Rails.art-h(root.shape);
                    subtitle: root.shape != ShelfShape.artists;
                    item: it;
                    playable: true;
                    on-page: parent.on-page;
                    layer-at-size: true;
                    clicked => { Tiles.open(it); }
                    play => { Tiles.play(it); }
                    // The creator's photo, over the collage's bottom-left corner (the play button
                    // takes the bottom-right). A ring of the ground keeps it apart from the art.
                    if i < root.shelf.badges.length && root.shelf.badges[i].width > 0: Rectangle {
                        x: Theme.s2;
                        y: Rails.art-h(root.shape) - self.height - Theme.s2;
                        width: Rails.badge;
                        height: Rails.badge;
                        border-radius: self.width / 2;
                        background: Theme.ground;
                        Rectangle {
                            x: 2px;
                            y: 2px;
                            width: parent.width - 4px;
                            height: parent.height - 4px;
                            border-radius: self.width / 2;
                            clip: true;
                            Image {
                                width: parent.width;
                                height: parent.height;
                                source: root.shelf.badges[i];
                                image-fit: cover;
                            }
                        }
                    }
                }
            }
        }
    }
}

// Quick picks as a dense grid: columns of two rows with small covers, as many 380 px columns
// as fit, paged a page of columns at a time, the next column cut off past the edge (`bleed`).
// A click plays; right-click and ⋯ open the menu.
component SongGrid inherits Rectangle {
    in property <HomeShelfRow> shelf;
    in property <length> bleed;
    property <int> rows: Rails.grid-rows;
    property <int> per-page: max(2, floor((root.width + Theme.card-gap) / (Rails.grid-col + Theme.card-gap)));
    property <int> columns: ceil(root.shelf.songs.length / root.rows);
    property <length> col-w: min(Rails.grid-col, floor((root.width - (root.per-page - 1) * Theme.card-gap) / root.per-page / 1px) * 1px);
    // The first column shown (`FeedShelf` reads it).
    in-out property <int> first: 0;
    property <float> at: root.first;
    animate at { duration: Theme.moving ? Theme.t-panel + 40ms : 0ms; easing: Curves.ease-in-out; }
    property <int> last-first: max(0, root.columns - root.per-page);
    height: Rails.height(ShelfShape.songs);
    hover := TouchArea {
        // One clip for the heading and the rows, as `TileShelf` has. The rows' hover tiles
        // reach 8 px past the column on both sides.
        Rectangle {
            x: -8px;
            y: 0;
            width: parent.width + 8px + root.bleed;
            height: parent.height;
            clip: true;
            ShelfHead {
                x: 8px;
                y: 0;
                width: root.width;
                lead: root.shelf.lead;
                title: root.shelf.title;
                arrows: hover.has-hover && root.columns > root.per-page;
                can-back: root.first > 0;
                can-forward: root.first < root.last-first;
                back => { root.first = max(0, root.first - root.per-page); }
                forward => { root.first = min(root.last-first, root.first + root.per-page); }
            }
            for t[i] in root.shelf.songs: SongRow {
                x: (floor(i / root.rows) - root.at) * (root.col-w + Theme.card-gap);
                y: Rails.head-h + mod(i, root.rows) * Theme.row-h;
                width: root.col-w + 16px;
                height: Theme.row-h;
                track: t;
                show-duration: false;
                menu: true;
                clicked => { HomeData.play-song(t.id); }
                play => { HomeData.play-song(t.id); }
                menu-requested(x, y, top) => { SongMenu.show(t, x, y, top); }
            }
        }
    }
}

// Home while the feed loads: on a fresh start the band's shape (nothing to show in it yet),
// then one rail of tiles running to the page's edge. Laid out as the band and the rails lay
// themselves out, so nothing jumps when the data lands.
component HomeSkeleton inherits Skeleton {
    in property <bool> band;
    in property <length> bleed;
    property <length> rail-y: root.band ? BandSizes.height + Rails.gap : 0px;
    property <length> tile: Rails.tile-w(ShelfShape.cards);
    property <int> tiles: ceil((root.width + root.bleed + Theme.card-gap) / (root.tile + Theme.card-gap));
    height: root.rail-y + Rails.height(ShelfShape.cards);
    // Not clipped as other skeletons are: the rail runs on to the page's edge (`bleed`).
    clip: false;
    if root.band: SkeletonBlock {
        x: 0;
        y: 0;
        width: root.width;
        height: BandSizes.height;
        border-radius: Theme.r-l;
        sweep: root.sweep;
        fade: root.fade;
        SkeletonBlock {
            x: BandSizes.pad;
            y: BandSizes.pad;
            width: BandSizes.cover;
            height: BandSizes.cover;
            border-radius: Theme.r-m;
            sweep: root.sweep;
            fade: root.fade;
        }
        for b[i] in [{ y: 27px, w: 180px, h: 14px }, { y: 55px, w: 360px, h: 34px }, { y: 101px, w: 260px, h: 14px }]: SkeletonBlock {
            x: BandSizes.text-x;
            y: b.y;
            width: min(b.w, root.width - BandSizes.text-x - BandSizes.pad);
            height: b.h;
            border-radius: Theme.r-s;
            sweep: root.sweep;
            fade: root.fade;
        }
    }
    SkeletonBlock {
        x: 0;
        y: root.rail-y + 8px;
        width: 180px;
        height: 16px;
        border-radius: Theme.r-s;
        sweep: root.sweep;
        fade: root.fade;
    }
    for i in root.tiles: SkeletonCard {
        x: i * (root.tile + Theme.card-gap);
        y: root.rail-y + Rails.head-h;
        size: root.tile;
        index: i;
        sweep: root.sweep;
        fade: root.fade;
    }
}

// The row after the last shelf while the next page loads: a rail's skeleton.
component MoreSkeleton inherits Skeleton {
    property <int> per-row: Rails.per-row(ShelfShape.cards, root.width);
    property <length> card: Rails.tile-w(ShelfShape.cards);
    height: Rails.height(ShelfShape.cards);
    accessible-label: @tr("Loading more of Home");
    SkeletonBlock {
        x: 0;
        y: 8px;
        width: 180px;
        height: 16px;
        border-radius: Theme.r-s;
        sweep: root.sweep;
        fade: root.fade;
    }
    for i in root.per-row: SkeletonCard {
        x: i * (root.card + Theme.card-gap);
        y: Rails.head-h;
        size: root.card;
        index: i;
        sweep: root.sweep;
        fade: root.fade;
    }
}

// The row after the last shelf when the next page failed: a quiet line and Try again, not
// the page's error (the shelves above stay).
component MoreFailed inherits Rectangle {
    height: lay.preferred-height;
    accessible-role: text;
    accessible-label: @tr("More of Home didn\u{2019}t load");
    lay := HorizontalLayout {
        alignment: start;
        spacing: Theme.s4;
        Body {
            text: @tr("More of Home didn\u{2019}t load");
            color: Theme.text2;
            vertical-alignment: center;
        }
        Pill {
            label: @tr("Try again");
            clicked => { HomeData.retry-more(); }
        }
    }
}

// One shelf of the feed, in its shape; its height follows the shape so the column can stack.
component FeedShelf inherits Rectangle {
    in property <HomeShelfRow> shelf;
    in property <length> bleed;
    // Some of it shows: its covers may start taking layers (`TileShelf.warm`).
    in property <bool> in-sight: true;
    // A song grid's first column shown (the feed's row reports its songs, `RowsShown`).
    in-out property <int> grid-first;
    height: Rails.height(root.shelf.shape);
    if root.shelf.shape == ShelfShape.songs: SongGrid {
        width: parent.width;
        shelf: root.shelf;
        bleed: root.bleed;
        first <=> root.grid-first;
    }
    if root.shelf.shape != ShelfShape.songs: TileShelf {
        width: parent.width;
        shelf: root.shelf;
        bleed: root.bleed;
        in-sight: root.in-sight;
    }
}

// The top of the feed: the band, then the loading, error or empty state.
component HomeTop inherits VerticalLayout {
    in property <length> inner;
    in property <length> bleed;
    spacing: Rails.gap;
    if HomeData.resume || HomeData.has-featured: Band { }
    // With a session the band shows at once (it's local); only the rails wait.
    if HomeData.loading && HomeData.shelves.length == 0: HomeSkeleton {
        band: !HomeData.resume && !HomeData.has-featured;
        bleed: root.bleed;
    }
    if !HomeData.loading && HomeData.error != "": ErrorState {
        width: min(480px, root.inner);
        message: HomeData.error;
        retry => { HomeData.retry(); }
    }
    if !HomeData.loading && HomeData.error == "" && HomeData.empty: EmptyState {
        width: min(480px, root.inner);
        glyph: Icons.home;
        title: @tr("Nothing on Home yet");
        line: @tr("Home fills in as you listen. Use Search to find something to play.");
    }
}

export component HomePage inherits Rectangle {
    property <length> pad: Theme.page-pad;
    property <length> inner: self.width - 2 * self.pad;
    property <int> count: HomeData.shelves.length;
    // Rows: the top, the shelves, then the next page's row while it loads or failed.
    property <int> rows: HomeData.row-count;
    // `HomeTop` shows something (so the first shelf keeps a gap's distance from it).
    property <bool> top-shown: HomeData.resume || HomeData.has-featured || (HomeData.loading && root.count == 0) || (!HomeData.loading && (HomeData.error != "" || HomeData.empty));

    // The rows' model follows `rows`, a row at a time at its end. Not `for i in root.rows`:
    // Slint makes a new model of an int each time it changes, and a ListView given a new
    // model drops every row and builds them again (every shelf on screen, its cards and their
    // covers' layers: a 40 ms frame at 4K when the next page's row came, another when it
    // landed).
    init => { HomeData.sync-rows(root.rows); }
    changed rows => { HomeData.sync-rows(root.rows); }

    // A ListView, so only the rows near the window exist: a shelf scrolled far away is dropped
    // with its cards, their art and their covers' layers (a long Home kept every card's).
    // Row 0 is `HomeTop`, row i shelf i - 1. No scroll bar, as before: its thumb would show
    // and ease its size on every resize.
    //
    // It runs on under the floating bar, where the page's clip (`app.slint`) hides it, so a
    // row is made a little before it shows. Its shelf starts warming its covers' layers
    // (`TileShelf.warm`) only once it's in sight, above the bar's top, so they spread over
    // the frames after rather than all being made unseen and drawn in the frame it shows.
    // (Not by ending the ListView at the bar: a viewport shorter than the content makes the
    // hidden scroll bar ease its thumb on every content change, a running animation.)
    list := ListView {
        vertical-scrollbar-policy: always-off;
        // Within a window's height of the end, scrolling asks for the next page (`home.rs`
        // lets one go at a time, and none once the feed ends). Only a scroll asks.
        changed content-y => {
            if root.count > 0 && -self.content-y + 2 * self.visible-height >= self.content-height {
                HomeData.near-end();
            }
        }
        for slot[i] in HomeData.rows: feed-row := Rectangle {
            // The row's top is above the floating bar's.
            property <bool> in-sight: self.y + list.content-y < root.height - Theme.bar-clear;
            // A song shelf's songs on screen, its grid's page (`FeedShelf.grid-first`), are
            // resolved ahead of a click. Told from the row, which lives as long as its
            // instance, so a row reused for another shelf, or for none, says so.
            property <int> grid-first;
            property <bool> songs: i > 0 && i <= root.count && HomeData.shelves[i - 1].shape == ShelfShape.songs;
            height: row.preferred-height;
            RowsShown {
                list: SongList.home;
                part: i - 1;
                first: feed-row.grid-first * Rails.grid-rows;
                last: feed-row.songs && feed-row.in-sight && feed-row.y + list.content-y + feed-row.height > 0 ? min(HomeData.shelves[i - 1].songs.length, (feed-row.grid-first + max(2, floor((root.inner + Theme.card-gap) / (Rails.grid-col + Theme.card-gap)))) * Rails.grid-rows) - 1 : -1;
            }
            row := VerticalLayout {
                width: parent.width;
                padding-left: root.pad;
                padding-right: root.pad;
                padding-top: i == 0 ? Theme.page-top : (i == 1 && !root.top-shown ? 0px : Rails.gap);
                // Past the floating bar, with the usual gap.
                padding-bottom: i == HomeData.rows.length - 1 ? Theme.page-end : 0px;
                if i == 0: HomeTop {
                    inner: root.inner;
                    bleed: root.pad;
                }
                if i > 0 && i <= root.count: FeedShelf {
                    shelf: HomeData.shelves[i - 1];
                    bleed: root.pad;
                    in-sight: feed-row.in-sight;
                    grid-first <=> feed-row.grid-first;
                }
                if i > root.count && HomeData.more == MoreState.loading: MoreSkeleton { }
                if i > root.count && HomeData.more == MoreState.failed: MoreFailed { }
            }
        }
    }
}
