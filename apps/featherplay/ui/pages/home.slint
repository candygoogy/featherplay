// Home (the layout chosen 2026-11-14, its top row redesigned 2026-11-22): one first row, then
// the Home feed as rails. Data comes from `src/pages/home.rs` through `HomeData`.
//
// The first row (`HomeTop`) is the Now playing card (`Band`, in `home/hero.slint`: the session
// in its cover's colour, or on a fresh start with an empty queue a featured pick from the
// first shelf) and the Shortcuts beside it (`ShortcutGrid`): Liked songs, the pins, what's
// played lately and the library, as high as the card.
//
// Every shelf is one rail of large tiles that pages sideways (`TileShelf`), running past the
// page's right padding to its edge, so the cut-off tile says there's more. Each takes the
// shape of what it holds (`home.rs::arrange`): videos as wide 16:9 tiles, artists as round
// faces with only their names, the rest square; quick picks stay a dense song grid of two
// rows. Your mixes come first, and a community playlist wears its creator's round photo over
// its collage's bottom-left corner.
//
// More shelves load as the user scrolls near the end (`home.rs::Paging`): a quiet skeleton
// shelf while a page loads, a quiet Try again if it fails; Home itself never errors for it.
//
// `HomeData` is in `home/data.slint`; this file lays out the page and its shelves.
import { ListView } from "../list_view.slint";
import { Theme, Curves, Icons } from "../theme.slint";
import { Frame } from "../nav.slint";
import { CardItem, ItemKind, Body, Display, Card, Cover, Icon, Pill, PlayingMark, SongRow, Rail, RowsShown, SongList, PageIntent } from "../parts.slint";
import { Skeleton, SkeletonBlock, SkeletonCard, ErrorState, EmptyState, Open } from "content.slint";
import { SongMenu } from "../song_menu.slint";
import { ItemMenu } from "../item_menu.slint";
import { Player } from "../player.slint";
import { ShelfShape, MoreState, HomeShelfRow, HomeData } from "home/data.slint";
import { Band, BandSizes } from "home/hero.slint";
import { ShortcutMore } from "home/more_menu.slint";
import { NowPlayingData } from "now_playing.slint";

export { ShelfShape, MoreState, HomeShelfRow, HomeData } from "home/data.slint";
export { ShortcutMore, ShortcutMoreLayer } from "home/more_menu.slint";

// The sizes Explore's shelves lay out with, in the shapes Home gives them
// (`home.rs::arrange`). A tile has one steady width (`tile-max`) and a row holds as many as
// fit, the rest of the row left empty. Only a page too narrow for two shrinks them. Covers are
// fetched at about a tile's width (`shelves.rs::cover_px`).
export global Shapes {
    out property <length> head-h: 48px;
    out property <length> mix-h: 64px;
    out property <length> mix-gap: Theme.s3;
    // Mixes show two rows a page at most.
    out property <int> mix-rows: 2;
    // Quick picks: columns of four rows, as many 380 px columns as fit.
    out property <int> grid-rows: 4;
    out property <length> grid-col: 380px;
    // A community playlist's avatar badge (`home.rs::BADGE`), its ring included.
    out property <length> badge: 32px;
    // Mixes: the narrowest a shortcut may get. The other shapes: their one width.
    public pure function tile-max(s: ShelfShape) -> length {
        return s == ShelfShape.mixes ? 220px : (s == ShelfShape.videos ? 300px : (s == ShelfShape.playlists ? 160px : (s == ShelfShape.artists ? 120px : 192px)));
    }
    public pure function gap(s: ShelfShape) -> length {
        return s == ShelfShape.mixes ? root.mix-gap : Theme.card-gap;
    }
    public pure function per-row(s: ShelfShape, w: length) -> int {
        return max(2, floor((w + Shapes.gap(s)) / (Shapes.tile-max(s) + Shapes.gap(s))));
    }
    public pure function tile-w(s: ShelfShape, w: length) -> length {
        return min(Shapes.tile-max(s), floor((w - (Shapes.per-row(s, w) - 1) * Shapes.gap(s)) / Shapes.per-row(s, w) / 1px) * 1px);
    }
    public pure function art-h(s: ShelfShape, w: length) -> length {
        return s == ShelfShape.videos ? round(Shapes.tile-w(s, w) * 9 / 16 / 1px) * 1px : Shapes.tile-w(s, w);
    }
    public pure function rows(n: int, w: length) -> int {
        return max(1, min(root.mix-rows, ceil(n / Shapes.per-row(ShelfShape.mixes, w))));
    }
    // A shelf's height with its heading, `n` items in `w`.
    public pure function height(s: ShelfShape, w: length, n: int) -> length {
        if s == ShelfShape.songs {
            return root.head-h + root.grid-rows * Theme.row-h;
        }
        if s == ShelfShape.mixes {
            return root.head-h + Shapes.rows(n, w) * root.mix-h + (Shapes.rows(n, w) - 1) * root.mix-gap;
        }
        return root.head-h + Shapes.art-h(s, w) + Theme.card-text-gap + (s == ShelfShape.artists ? 24px : 40px);
    }
}

// Home's rails. A tile has one width whatever the page's (200 px, a video 300); a rail holds
// as many as fit, and the next one shows cut off at the page's edge. Only a page too narrow
// for two whole tiles (a video: most of one) shrinks them to fit. Covers are fetched at a
// tile's width at most (`shelves.rs::cover_px`).
export global Rails {
    out property <length> head-h: 48px;
    // The gap between the band and the rails, and between rails.
    out property <length> gap: Theme.s6;
    // Quick picks: columns of two rows, as many 380 px columns as fit. A page too narrow for
    // a column and a good part of the next shows one column its whole width.
    out property <int> grid-rows: 2;
    out property <length> grid-col: 380px;
    out property <length> grid-peek: 80px;
    // A community playlist's avatar badge (`home.rs::BADGE`), its ring included.
    out property <length> badge: 32px;
    public pure function tile-w(s: ShelfShape, w: length) -> length {
        // Two whole tiles and a sliver of the third past the padding (a gap's worth).
        return s == ShelfShape.videos ? min(300px, floor(w * 0.8 / 1px) * 1px) : min(200px, floor((w - 2 * Theme.card-gap) / 2 / 1px) * 1px);
    }
    // Whole tiles in `w` (paging moves by these).
    public pure function per-row(s: ShelfShape, w: length) -> int {
        return max(1, floor((w + Theme.card-gap) / (Rails.tile-w(s, w) + Theme.card-gap)));
    }
    public pure function art-h(s: ShelfShape, w: length) -> length {
        return s == ShelfShape.videos ? round(Rails.tile-w(s, w) * 9 / 16 / 1px) * 1px : Rails.tile-w(s, w);
    }
    // A shelf's height with its heading.
    public pure function height(s: ShelfShape, w: length) -> length {
        if s == ShelfShape.songs {
            return root.head-h + root.grid-rows * Theme.row-h;
        }
        return root.head-h + Rails.art-h(s, w) + Theme.card-text-gap + (s == ShelfShape.artists ? 24px : 40px);
    }
    // Quick picks' whole columns in `w`, and a column's width. Beside the Up next panel in
    // a wide window, two narrower columns at least, as always there.
    public pure function grid-per-page(w: length) -> int {
        return max(Frame.sheet ? 1 : 2, floor((w + Theme.card-gap) / (root.grid-col + Theme.card-gap)));
    }
    public pure function grid-col-w(w: length) -> length {
        return Rails.grid-per-page(w) == 1 && w < root.grid-col + Theme.card-gap + root.grid-peek ? w : min(root.grid-col, floor((w - (Rails.grid-per-page(w) - 1) * Theme.card-gap) / Rails.grid-per-page(w) / 1px) * 1px);
    }
}

// A shelf's heading: optional lead words in text2 ("Similar to") and the title, room left at
// its right end for the arrows (`Rail`).
component ShelfHead inherits Rectangle {
    in property <string> lead;
    in property <string> title;
    height: Rails.head-h;
    HorizontalLayout {
        x: 0;
        y: 0;
        // Room for the arrows always, so the title doesn't re-elide when they show.
        width: root.width - 88px;
        height: 32px;
        alignment: start;
        spacing: Theme.s2;
        if root.lead != "": Display {
            text: root.lead;
            font-size: Theme.t-display-s;
            color: Theme.text2;
            vertical-alignment: center;
            horizontal-stretch: 0;
        }
        Display {
            text: root.title;
            font-size: Theme.t-display-s;
            vertical-alignment: center;
            accessible-role: text;
        }
    }
}

// What a tile does: songs play (with radio after them), the rest open; the play button plays
// the album, playlist or artist without opening it.
global Tiles {
    public function open(it: CardItem) {
        if it.kind == ItemKind.song {
            HomeData.play-song(it.id);
        } else {
            Open.item(it);
        }
    }
    public function play(it: CardItem) {
        if it.kind == ItemKind.song {
            HomeData.play-song(it.id);
        } else {
            HomeData.play-card(it);
        }
    }
}

// A rail of tiles shaped for its shelf (videos 16:9, artists round faces without a subtitle,
// the rest square), moving sideways (`Rail`): a sideways scroll, or a page of whole tiles by
// the arrows. The tiles run on past the shelf's right edge by `bleed` (the page's padding),
// where the next one shows cut off.
component TileShelf inherits Rectangle {
    in property <HomeShelfRow> shelf;
    in property <length> bleed;
    // Some of it shows: the warming starts then.
    in property <bool> in-sight: true;
    property <ShelfShape> shape: root.shelf.shape;
    property <int> per-row: Rails.per-row(root.shape, root.width);
    property <length> tile-w: Rails.tile-w(root.shape, root.width);
    // Whole tiles and the one cut off at the edge.
    property <int> in-view: ceil((root.width + root.bleed + Theme.card-gap) / (root.tile-w + Theme.card-gap));
    // Cards whose covers may take their layer: one more each tick after the shelf comes in sight,
    // not all in the frame it enters (each layer is ~0.7 ms at 4K, a row of them a frame's
    // worth). Until then a cover draws directly, where little of it shows yet. Once the first
    // page's cards have theirs the shelf is warm for good and the timer stops: a resize or a
    // page turn later doesn't start it again.
    property <int> warm: 0;
    property <bool> warmed: false;
    warming := Timer {
        interval: 8ms;
        running: !root.warmed && root.in-sight;
        triggered => {
            root.warm += 1;
            root.warmed = root.warm >= max(1, root.in-view);
        }
    }
    height: Rails.height(root.shape, root.width);
    rail := Rail {
        count: root.shelf.items.length;
        per-page: root.per-row;
        step: root.tile-w + Theme.card-gap;
        // One clip for the heading and the tiles: as the page scrolls, a shelf adds its two
        // rectangles (where it was and where it is) to the frame's damage, not its heading's
        // two besides, which pushed the playing mark's step into a merge with them
        // (`tests/app/playing_frames.rs`).
        Rectangle {
            x: 0;
            y: 0;
            width: parent.width + root.bleed;
            height: parent.height;
            clip: true;
            ShelfHead {
                x: 0;
                y: 0;
                width: root.width;
                lead: root.shelf.lead;
                title: root.shelf.title;
            }
            for it[i] in root.shelf.items: Rectangle {
                x: (i - rail.at) * (root.tile-w + Theme.card-gap);
                y: Rails.head-h;
                width: root.tile-w;
                height: parent.height - Rails.head-h;
                // Shown, or partly shown while paging (the others draw nothing), and warm.
                property <bool> on-page: i + 1 > rail.at && i < rail.at + root.in-view && (root.warmed || i - rail.first < root.warm);
                Card {
                    size: root.tile-w;
                    art-h: Rails.art-h(root.shape, root.width);
                    subtitle: root.shape != ShelfShape.artists;
                    item: it;
                    playable: true;
                    on-page: parent.on-page;
                    layer-at-size: true;
                    clicked => { Tiles.open(it); }
                    play => { Tiles.play(it); }
                    // The creator's photo, over the collage's bottom-left corner (the play button
                    // takes the bottom-right). A ring of the ground keeps it apart from the art.
                    if i < root.shelf.badges.length && root.shelf.badges[i].width > 0: Rectangle {
                        x: Theme.s2;
                        y: Rails.art-h(root.shape, root.width) - self.height - Theme.s2;
                        width: Rails.badge;
                        height: Rails.badge;
                        border-radius: self.width / 2;
                        background: Theme.ground;
                        Rectangle {
                            x: 2px;
                            y: 2px;
                            width: parent.width - 4px;
                            height: parent.height - 4px;
                            border-radius: self.width / 2;
                            clip: true;
                            Image {
                                width: parent.width;
                                height: parent.height;
                                source: root.shelf.badges[i];
                                image-fit: cover;
                            }
                        }
                    }
                }
            }
        }
    }
}

// Quick picks as a dense grid: columns of two rows with small covers, as many 380 px columns
// as fit, moving sideways as every rail does (`Rail`), the next column cut off past the edge
// (`bleed`).
// A click plays; right-click and ⋯ open the menu.
component SongGrid inherits Rectangle {
    in property <HomeShelfRow> shelf;
    in property <length> bleed;
    property <int> rows: Rails.grid-rows;
    property <int> per-page: Rails.grid-per-page(root.width);
    property <int> columns: ceil(root.shelf.songs.length / root.rows);
    property <length> col-w: Rails.grid-col-w(root.width);
    // The first column shown (`FeedShelf` reads it).
    out property <int> first: rail.first;
    height: Rails.height(ShelfShape.songs, root.width);
    rail := Rail {
        count: root.columns;
        per-page: root.per-page;
        step: root.col-w + Theme.card-gap;
        // One clip for the heading and the rows, as `TileShelf` has. The rows' hover tiles
        // reach 8 px past the column on both sides.
        Rectangle {
            x: -8px;
            y: 0;
            width: parent.width + 8px + root.bleed;
            height: parent.height;
            clip: true;
            ShelfHead {
                x: 8px;
                y: 0;
                width: root.width;
                lead: root.shelf.lead;
                title: root.shelf.title;
            }
            for t[i] in root.shelf.songs: SongRow {
                x: (floor(i / root.rows) - rail.at) * (root.col-w + Theme.card-gap);
                y: Rails.head-h + mod(i, root.rows) * Theme.row-h;
                width: root.col-w + 16px;
                height: Theme.row-h;
                track: t;
                show-duration: false;
                menu: true;
                clicked => { HomeData.play-song(t.id); }
                play => { HomeData.play-song(t.id); }
                menu-requested(x, y, top) => { SongMenu.show(t, x, y, top); }
            }
        }
    }
}

// Home's Shortcuts (the board of 2026-11-22, two rows as 0.6.2 showed them): beside the Now
// playing card, a grid as high as the card, two rows of 104 px tiles in columns of at least
// 272 px (six tiles in three columns). What doesn't fit is behind an "N more" tile, the last,
// that opens the rest as a menu. Under a page too narrow for the row
// (`BandSizes.row-min`), they go under the card as 0.6.0's row: 64 px tiles in columns of at
// least 240 px, two rows at most. Liked songs leads, then the pins (a pin before the line),
// what's played lately and the library (`home.rs::show_shortcuts`).
global ShortcutSizes {
    // Beside the card: two rows of 104 px tiles, columns of at least 272 px, 16 px apart.
    out property <length> tile: 104px;
    out property <int> rows: 2;
    out property <length> gap: 16px;
    // Columns in `w`.
    public pure function fit(w: length) -> int {
        return max(1, floor((w + root.gap) / (272px + root.gap)));
    }
    // A column is at most this wide.
    out property <length> col-max: 560px;
    // Under the card: 64 px tiles, columns of at least 240 px, 12 px apart.
    out property <length> fold-gap: 12px;
    public pure function fold-cols(w: length) -> int {
        return max(1, floor((w + root.fold-gap) / (240px + root.fold-gap)));
    }
    public pure function fold-rows(n: int, w: length) -> int {
        return n > ShortcutSizes.fold-cols(w) ? 2 : 1;
    }
    public pure function fold-height(n: int, w: length) -> length {
        return ShortcutSizes.fold-rows(n, w) * 64px + (ShortcutSizes.fold-rows(n, w) - 1) * root.fold-gap;
    }
}

// Glyphs only the Shortcuts use.
global ShortcutIcons {
    // The hint tile's and a pinned tile's pushpin.
    out property <string> pin: "M9 4.5 H15 M10.2 4.5 V10 L7.5 13.5 H16.5 L13.8 10 V4.5 M12 13.5 V19.5";
}

// The cover's square of a tile, `size` wide: the art (an artist's a round face inset in it;
// Liked songs its red tile with the heart). Hovered, a veil and play (Liked songs: shuffle)
// cover it, and a click plays without opening; on the one the queue came from, pause or play,
// which the player takes. Resting on that one: its art stays, with the playing mark on its
// corner, on the cover button's dark glass.
component ShortcutCover inherits TouchArea {
    in property <CardItem> item;
    in property <length> size;
    in property <bool> current;
    in property <bool> tile-hovered;
    callback play();
    property <bool> liked: root.item.id == "LM";
    property <bool> round: root.item.round;
    property <length> inset: root.round ? Math.round(root.size / 8 / 1px) * 1px : 0px;
    property <bool> pause: root.current && Player.playing;
    property <length> glyph: Math.round((root.size * 0.25 + 4px) / 1px) * 1px;
    width: root.size;
    height: root.size;
    mouse-cursor: pointer;
    accessible-role: button;
    accessible-label: root.pause ? @tr("Pause {}", root.item.title) : (root.liked ? @tr("Shuffle Liked songs") : @tr("Play {}", root.item.title));
    accessible-action-default => { root.activate(); }
    clicked => { root.activate(); }
    function activate() {
        if root.current {
            Player.toggle();
        } else {
            root.play();
        }
    }
    if root.liked: Rectangle {
        background: @linear-gradient(135deg, Theme.brand-accent 0%, #7A0E20 100%);
        Icon {
            width: Math.round(root.size * 0.31 / 1px) * 1px;
            height: self.width;
            commands: Icons.heart;
            fill: #FFFFFF;
            stroke: transparent;
        }
    }
    if !root.liked: Cover {
        x: root.inset;
        y: root.inset;
        width: root.width - 2 * root.inset;
        height: root.height - 2 * root.inset;
        radius: 0px;
        round: root.round;
        source: root.item.cover;
        layer-at-size: true;
    }
    // The veil, while hovered.
    Rectangle {
        x: root.inset;
        y: root.inset;
        width: root.width - 2 * root.inset;
        height: root.height - 2 * root.inset;
        border-radius: root.round ? self.width / 2 : 0px;
        background: root.pressed ? Theme.cover-button-pressed : Theme.cover-button;
        opacity: root.tile-hovered ? 1 : 0;
        visible: self.opacity > 0;
        animate opacity { duration: Theme.t-hover; easing: Curves.ease-hover; }
        animate background { duration: Theme.t-hover; easing: Curves.ease-hover; }
    }
    // The playing mark on the art's bottom-left corner: 24 px on the large tiles, 20 on the
    // others. White, as every mark on artwork: the song's accent on another item's art (a
    // purple wave on the red Liked songs tile) says nothing.
    if root.current && !root.tile-hovered: Rectangle {
        property <length> d: root.size >= 104px ? 24px : 20px;
        property <length> at: root.size >= 104px ? 6px : 4px;
        x: self.at;
        y: root.size - self.at - self.d;
        width: self.d;
        height: self.d;
        border-radius: self.d / 2;
        background: Theme.cover-button;
        PlayingMark {
            width: parent.d - 6px;
            height: parent.d - 6px;
            ink: #FFFFFF;
        }
    }
    // White on the dark veil, over any art in either theme.
    Icon {
        width: root.glyph;
        height: root.glyph;
        commands: root.pause ? Icons.pause : (root.liked && !root.current ? Icons.shuffle : Icons.play);
        fill: root.liked && !root.current ? transparent : #FFFFFF;
        stroke: root.liked && !root.current ? #FFFFFF : transparent;
        stroke-width: 1.8px;
        opacity: root.tile-hovered ? 1 : 0;
        visible: self.opacity > 0;
        animate opacity { duration: Theme.t-hover; easing: Curves.ease-hover; }
    }
}

// A tile's surface: the card grey, lighter while hovered or while its menu is open.
component TileGround inherits Rectangle {
    in property <bool> hovered;
    in property <bool> pressed;
    // Animated as a private property: a root animating a public one is copied into each use.
    property <color> ground: root.pressed ? Theme.card.mix(Theme.text1, 0.86) : (root.hovered ? Theme.card.mix(Theme.text1, 0.92) : Theme.card);
    animate ground { duration: Theme.t-hover; }
    background: root.ground;
    border-radius: Theme.r-m;
    clip: true;
}

// One tile, `size` high: the cover's square on the left, the title and its line, a pin before
// the line when it's pinned. A click opens it; right-click opens its
// menu.
component ShortcutTile inherits TileGround {
    in property <CardItem> item;
    in property <bool> pinned;
    in property <length> size: 64px;
    property <bool> current: HomeData.playing-id != "" && HomeData.playing-id == root.item.id && HomeData.playing-kind == root.item.kind;
    property <bool> menu-open: ItemMenu.open && ItemMenu.shortcut && ItemMenu.item.id == root.item.id && ItemMenu.item.kind == root.item.kind;
    hovered: ta.has-hover || cover.has-hover || root.menu-open;
    pressed: ta.pressed;
    height: root.size;
    accessible-role: button;
    accessible-label: root.item.title;
    accessible-description: root.item.subtitle;
    accessible-action-default => { Open.item(root.item); }
    PageIntent {
        hovered: ta.has-hover;
        pressed: ta.pressed;
        pointer-x: ta.mouse-x;
        pointer-y: ta.mouse-y;
        kind: root.item.kind;
        id: root.item.id == "LM" ? "" : root.item.id;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { Open.item(root.item); }
        pointer-event(e) => {
            if e.button == PointerEventButton.right && e.kind == PointerEventKind.up {
                ItemMenu.show(root.item, true, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, self.absolute-position.y + self.mouse-y);
            }
        }
    }
    VerticalLayout {
        x: root.size + round((root.size * 0.15 + 2px) / 1px) * 1px;
        width: root.width - self.x - Theme.s4;
        alignment: center;
        Body {
            text: root.item.title;
            font-size: root.size >= 104px ? Theme.t-body-l : Theme.t-body;
            font-weight: 600;
            height: 22px;
            vertical-alignment: center;
        }
        HorizontalLayout {
            height: 17px;
            spacing: Theme.s1;
            if root.pinned: VerticalLayout {
                alignment: center;
                Icon {
                    width: 13px;
                    height: 13px;
                    commands: ShortcutIcons.pin;
                    stroke: Theme.text2;
                    stroke-width: 1.8px;
                    accessible-role: image;
                    accessible-label: @tr("Pinned");
                }
            }
            Body {
                text: root.item.subtitle;
                font-size: Theme.t-meta;
                color: Theme.text2;
                vertical-alignment: center;
            }
        }
    }
    cover := ShortcutCover {
        x: 0;
        y: 0;
        size: root.size;
        item: root.item;
        current: root.current;
        tile-hovered: ta.has-hover || self.has-hover;
        play => {
            if root.item.id == "LM" {
                HomeData.shuffle-liked();
            } else {
                HomeData.play-card(root.item);
            }
        }
        // A right-click on the cover opens the menu too.
        pointer-event(e) => {
            if e.button == PointerEventButton.right && e.kind == PointerEventKind.up {
                ItemMenu.show(root.item, true, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, self.absolute-position.y + self.mouse-y);
            }
        }
    }
}

// The last tile when the grid can't hold them all: "N more", which opens the rest as a menu
// under it (`ShortcutMore`).
component ShortcutMoreTile inherits TileGround {
    in property <int> from;
    in property <length> size;
    property <int> rest: HomeData.shortcuts.length - root.from;
    hovered: ta.has-hover || ShortcutMore.open;
    pressed: ta.pressed;
    height: root.size;
    accessible-role: button;
    accessible-label: @tr("{} more", root.rest);
    accessible-action-default => { root.show(); }
    function show() {
        ShortcutMore.show(root.from, self.absolute-position.x + root.width, self.absolute-position.y + root.height, self.absolute-position.y);
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.show(); }
    }
    Icon {
        x: (root.size - self.width) / 2;
        width: 22px;
        height: 22px;
        commands: Icons.chevron-down;
        stroke: Theme.text2;
    }
    Body {
        x: root.size + round((root.size * 0.15 + 2px) / 1px) * 1px;
        width: root.width - self.x - Theme.s4;
        text: @tr("{} more", root.rest);
        font-size: root.size >= 104px ? Theme.t-body-l : Theme.t-body;
        font-weight: 600;
        vertical-alignment: center;
        accessible-role: none;
    }
}

// A new account's last tile while the grid isn't full: how to pin (any tile or row of a
// playlist, album or artist pins from its right-click menu).
component ShortcutHint inherits Rectangle {
    in property <length> size: 64px;
    height: root.size;
    border-radius: Theme.r-m;
    border-width: 1.5px;
    border-color: Theme.hairline;
    accessible-role: text;
    accessible-label: @tr("Pin what you play most");
    accessible-description: @tr("Right-click a playlist, album or artist");
    Icon {
        x: (56px - self.width) / 2;
        width: 22px;
        height: 22px;
        commands: ShortcutIcons.pin;
        stroke: Theme.text2;
    }
    VerticalLayout {
        x: 56px;
        width: root.width - self.x - Theme.s3;
        alignment: center;
        Body {
            text: @tr("Pin what you play most");
            font-weight: 600;
            height: 22px;
            vertical-alignment: center;
            accessible-role: none;
        }
        Body {
            text: @tr("Right-click a playlist, album or artist");
            font-size: Theme.t-meta;
            color: Theme.text2;
            height: 17px;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
}

// The grid. `beside`: beside the card, its height; otherwise 0.6.0's row under the card.
// The tiles fill it row by row; the hint takes what's left of the last row (and may add a
// column where that ends the grid as a full rectangle), never a row of its own.
component ShortcutGrid inherits Rectangle {
    in property <bool> beside;
    property <int> count: HomeData.shortcuts.length;
    property <length> size: root.beside ? ShortcutSizes.tile : 64px;
    property <length> gap: root.beside ? ShortcutSizes.gap : ShortcutSizes.fold-gap;
    property <int> fit: root.beside ? ShortcutSizes.fit(root.width) : ShortcutSizes.fold-cols(root.width);
    property <int> rows: root.beside ? ShortcutSizes.rows : ShortcutSizes.fold-rows(root.count, root.width);
    // More than the grid holds: all but its last cell, then "N more".
    property <bool> over: root.count > root.rows * root.fit;
    property <int> shown: root.over ? root.rows * root.fit - 1 : root.count;
    property <int> n: root.shown + (root.over ? 1 : 0);
    property <bool> hint-ok: HomeData.shortcut-hint && !root.over;
    property <int> least-cols: root.beside ? min(root.fit, ceil(root.n / root.rows)) : root.fit;
    property <int> wider: root.least-cols + 1;
    property <int> cols: root.beside && root.hint-ok && root.rows * root.least-cols == root.n && root.least-cols < root.fit && ceil(root.n / root.wider) + (mod(root.n, root.wider) == 0 ? 1 : 0) == root.rows ? root.wider : root.least-cols;
    property <int> left: root.rows * root.cols - root.n;
    property <bool> hint: root.hint-ok && root.left > 0;
    property <int> span: root.beside ? min(root.left, root.cols - mod(root.n, root.cols)) : 1;
    property <length> col-w: floor(min(root.beside ? ShortcutSizes.col-max : 100000px, (root.width - (root.cols - 1) * root.gap) / root.cols) / 1px) * 1px;
    height: root.beside ? BandSizes.height : ShortcutSizes.fold-height(root.count, root.width);
    init => { HomeData.shortcut-tile(root.size); }
    changed size => { HomeData.shortcut-tile(self.size); }
    accessible-role: list;
    accessible-label: @tr("Shortcuts");
    for it[i] in HomeData.shortcuts: ShortcutTile {
        visible: i < root.shown;
        x: mod(i, root.cols) * (root.col-w + root.gap);
        y: floor(i / root.cols) * (root.size + root.gap);
        width: root.col-w;
        size: root.size;
        item: it;
        pinned: i < HomeData.shortcut-pins.length && HomeData.shortcut-pins[i];
    }
    ShortcutMoreTile {
        visible: root.over;
        x: mod(root.shown, root.cols) * (root.col-w + root.gap);
        y: floor(root.shown / root.cols) * (root.size + root.gap);
        width: root.col-w;
        size: root.size;
        from: root.shown;
    }
    ShortcutHint {
        visible: root.hint;
        x: mod(root.n, root.cols) * (root.col-w + root.gap);
        y: floor(root.n / root.cols) * (root.size + root.gap);
        width: root.span * root.col-w + (root.span - 1) * root.gap;
        size: root.size;
    }
}

// The card's shape while Home waits for a pick from the feed: the art at its left end, the
// title, the artists and the actions' row, as the card lays itself out, so nothing jumps
// when the data lands.
component CardSkeleton inherits Skeleton {
    property <bool> slim: BandSizes.slim(root.width);
    property <length> art: BandSizes.height-for(root.width);
    property <length> text-x: root.art + (root.slim ? 20px : 28px);
    property <length> text-w: root.width - root.text-x - 24px;
    height: root.art;
    SkeletonBlock {
        width: root.width;
        height: root.height;
        border-radius: Theme.r-l;
        sweep: root.sweep;
        fade: root.fade;
    }
    SkeletonBlock {
        width: root.art;
        height: root.art;
        border-radius: Theme.r-l;
        sweep: root.sweep;
        fade: root.fade;
    }
    for b[i] in [{ y: 26px, w: 360px, h: 32px }, { y: 76px, w: 260px, h: 14px }]: SkeletonBlock {
        x: root.text-x;
        y: root.slim ? b.y * 0.7 : b.y;
        width: min(b.w, root.text-w);
        height: root.slim ? b.h * 0.75 : b.h;
        border-radius: Theme.r-s;
        sweep: root.sweep;
        fade: root.fade;
    }
    SkeletonBlock {
        x: root.text-x;
        y: root.height - (root.slim ? 14px : 18px) - 40px;
        width: min(184px, root.text-w);
        height: 40px;
        border-radius: 20px;
        sweep: root.sweep;
        fade: root.fade;
    }
}

// The feed's first rail while it loads: one rail of tiles running to the page's edge, laid
// out as the rails lay themselves out.
component HomeSkeleton inherits Skeleton {
    in property <length> bleed;
    property <length> tile: Rails.tile-w(ShelfShape.cards, root.width);
    property <int> tiles: ceil((root.width + root.bleed + Theme.card-gap) / (root.tile + Theme.card-gap));
    height: Rails.height(ShelfShape.cards, root.width);
    // Not clipped as other skeletons are: the rail runs on to the page's edge (`bleed`).
    clip: false;
    SkeletonBlock {
        x: 0;
        y: 8px;
        width: 180px;
        height: 16px;
        border-radius: Theme.r-s;
        sweep: root.sweep;
        fade: root.fade;
    }
    for i in root.tiles: SkeletonCard {
        x: i * (root.tile + Theme.card-gap);
        y: Rails.head-h;
        size: root.tile;
        index: i;
        sweep: root.sweep;
        fade: root.fade;
    }
}

// The row after the last shelf while the next page loads: a rail's skeleton.
component MoreSkeleton inherits Skeleton {
    property <int> per-row: Rails.per-row(ShelfShape.cards, root.width);
    property <length> card: Rails.tile-w(ShelfShape.cards, root.width);
    height: Rails.height(ShelfShape.cards, root.width);
    accessible-label: @tr("Loading more of Home");
    SkeletonBlock {
        x: 0;
        y: 8px;
        width: 180px;
        height: 16px;
        border-radius: Theme.r-s;
        sweep: root.sweep;
        fade: root.fade;
    }
    for i in root.per-row: SkeletonCard {
        x: i * (root.card + Theme.card-gap);
        y: Rails.head-h;
        size: root.card;
        index: i;
        sweep: root.sweep;
        fade: root.fade;
    }
}

// The row after the last shelf when the next page failed: a quiet line and Try again, not
// the page's error (the shelves above stay).
component MoreFailed inherits Rectangle {
    height: lay.preferred-height;
    accessible-role: text;
    accessible-label: @tr("More of Home didn\u{2019}t load");
    lay := HorizontalLayout {
        alignment: start;
        spacing: Theme.s4;
        Body {
            text: @tr("More of Home didn\u{2019}t load");
            color: Theme.text2;
            vertical-alignment: center;
        }
        Pill {
            label: @tr("Try again");
            clicked => { HomeData.retry-more(); }
        }
    }
}

// One shelf of the feed, in its shape; its height follows the shape so the column can stack.
component FeedShelf inherits Rectangle {
    in property <HomeShelfRow> shelf;
    in property <length> bleed;
    // Some of it shows: its covers may start taking layers (`TileShelf.warm`).
    in property <bool> in-sight: true;
    // A song grid's first column shown (the feed's row reports its songs, `RowsShown`).
    in-out property <int> grid-first;
    height: Rails.height(root.shelf.shape, root.width);
    if root.shelf.shape == ShelfShape.songs: SongGrid {
        width: parent.width;
        shelf: root.shelf;
        bleed: root.bleed;
        init => { root.grid-first = self.first; }
        changed first => { root.grid-first = self.first; }
    }
    if root.shelf.shape != ShelfShape.songs: TileShelf {
        width: parent.width;
        shelf: root.shelf;
        bleed: root.bleed;
        in-sight: root.in-sight;
    }
}

// The top of the feed: the first row (the Now playing card and the Shortcuts beside it, or
// under it in a page under `BandSizes.row-min`), then the loading, error or empty state. The
// card shows its shape while it waits for a pick from the feed (`CardSkeleton`); with a
// session it shows at once (it's local), and only the rails wait. Without Shortcuts (turned
// off, signed out) the card is alone, at most `BandSizes.most` wide, the rest of the row empty.
component HomeTop inherits VerticalLayout {
    in property <length> inner;
    in property <length> bleed;
    property <bool> band: HomeData.resume || HomeData.has-featured;
    property <bool> waiting: HomeData.loading && HomeData.shelves.length == 0;
    property <bool> card: root.band || root.waiting;
    property <bool> tiles: HomeData.shortcuts-shown;
    property <bool> beside: root.card && root.tiles && root.inner >= BandSizes.row-min;
    // The Up next panel or sheet shows the queue, as the row knows it: closing, at once (the
    // page widens in the same frame); opening, once the page has narrowed for it, so the
    // card's column goes in the frame the whole page is laid out again anyway, not one before.
    property <bool> panel;
    property <bool> tabs-open: Frame.tabs-open;
    init => { self.panel = Frame.tabs-open; }
    changed tabs-open => {
        if !self.tabs-open {
            self.panel = false;
        }
    }
    changed inner => { self.panel = Frame.tabs-open; }
    property <length> card-w: BandSizes.card-w(root.inner, root.tiles, HomeData.resume && !root.panel);
    property <length> card-h: root.card ? BandSizes.height-for(root.card-w) : 0px;
    spacing: Rails.gap;
    if root.card || root.tiles: Rectangle {
        height: root.beside ? BandSizes.height : root.card-h + (root.card && root.tiles ? BandSizes.gap : 0px) + (root.tiles ? ShortcutSizes.fold-height(HomeData.shortcuts.length, root.inner) : 0px);
        if root.band: Band {
            x: 0;
            y: 0;
            width: root.card-w;
            panel: root.panel;
        }
        if !root.band && root.waiting: CardSkeleton {
            x: 0;
            y: 0;
            width: root.card-w;
        }
        if root.tiles: ShortcutGrid {
            beside: root.beside;
            x: root.beside ? root.card-w + BandSizes.gap : 0px;
            y: root.beside || !root.card ? 0px : root.card-h + BandSizes.gap;
            width: root.beside ? root.inner - root.card-w - BandSizes.gap : root.inner;
        }
    }
    if root.waiting: HomeSkeleton {
        bleed: root.bleed;
    }
    if !HomeData.loading && HomeData.error != "": ErrorState {
        width: min(480px, root.inner);
        message: HomeData.error;
        retry => { HomeData.retry(); }
    }
    if !HomeData.loading && HomeData.error == "" && HomeData.empty: EmptyState {
        width: min(480px, root.inner);
        glyph: Icons.home;
        title: @tr("Nothing on Home yet");
        line: @tr("Home fills in as you listen. Use Search to find something to play.");
    }
}

export component HomePage inherits Rectangle {
    property <length> pad: Theme.pad-for(self.width);
    property <length> inner: self.width - 2 * self.pad;
    property <int> count: HomeData.shelves.length;
    // Rows: the top, the shelves, then the next page's row while it loads or failed.
    property <int> rows: HomeData.row-count;
    // `HomeTop` shows something (so the first shelf keeps a gap's distance from it).
    property <bool> top-shown: HomeData.resume || HomeData.has-featured || HomeData.shortcuts-shown || (HomeData.loading && root.count == 0) || (!HomeData.loading && (HomeData.error != "" || HomeData.empty));

    // The rows' model follows `rows`, a row at a time at its end. Not `for i in root.rows`:
    // Slint makes a new model of an int each time it changes, and a ListView given a new
    // model drops every row and builds them again (every shelf on screen, its cards and their
    // covers' layers: a 40 ms frame at 4K when the next page's row came, another when it
    // landed).
    init => {
        HomeData.sync-rows(root.rows);
        HomeData.band-in-sight = root.band-in-sight;
    }
    changed rows => { HomeData.sync-rows(root.rows); }
    // The card's bottom (row 0's top padding, then the card) below the view's top. Coming
    // into view, a field it lacks is made in that frame.
    property <bool> band-in-sight: -list.content-y < Theme.page-top + BandSizes.height;
    changed band-in-sight => {
        HomeData.band-in-sight = self.band-in-sight;
        NowPlayingData.backdrop-changed();
    }

    // A ListView, so only the rows near the window exist: a shelf scrolled far away is dropped
    // with its cards, their art and their covers' layers (a long Home kept every card's).
    // Row 0 is `HomeTop`, row i shelf i - 1. No scroll bar, as before: its thumb would show
    // and ease its size on every resize.
    //
    // It runs on under the floating bar, where the page's clip (`app.slint`) hides it, so a
    // row is made a little before it shows. Its shelf starts warming its covers' layers
    // (`TileShelf.warm`) only once it's in sight, above the bar's top, so they spread over
    // the frames after rather than all being made unseen and drawn in the frame it shows.
    // (Not by ending the ListView at the bar: a viewport shorter than the content makes the
    // hidden scroll bar ease its thumb on every content change, a running animation.)
    list := ListView {
        vertical-scrollbar-policy: always-off;
        // Within a window's height of the end, scrolling asks for the next page (`home.rs`
        // lets one go at a time, and none once the feed ends). Only a scroll asks.
        changed content-y => {
            if root.count > 0 && -self.content-y + 2 * self.visible-height >= self.content-height {
                HomeData.near-end();
            }
        }
        for slot[i] in HomeData.rows: feed-row := Rectangle {
            // The row's top is above the floating bar's.
            property <bool> in-sight: self.y + list.content-y < root.height - Theme.bar-clear;
            // A song shelf's songs on screen, its grid's page (`FeedShelf.grid-first`), are
            // resolved ahead of a click. Told from the row, which lives as long as its
            // instance, so a row reused for another shelf, or for none, says so.
            property <int> grid-first;
            property <bool> songs: i > 0 && i <= root.count && HomeData.shelves[i - 1].shape == ShelfShape.songs;
            height: row.preferred-height;
            RowsShown {
                list: SongList.home;
                part: i - 1;
                first: feed-row.grid-first * Rails.grid-rows;
                last: feed-row.songs && feed-row.in-sight && feed-row.y + list.content-y + feed-row.height > 0 ? min(HomeData.shelves[i - 1].songs.length, (feed-row.grid-first + Rails.grid-per-page(root.inner)) * Rails.grid-rows) - 1 : -1;
            }
            row := VerticalLayout {
                width: parent.width;
                padding-left: root.pad;
                padding-right: root.pad;
                padding-top: i == 0 ? Theme.page-top : (i == 1 && !root.top-shown ? 0px : Rails.gap);
                // Past the floating bar, with the usual gap.
                padding-bottom: i == HomeData.rows.length - 1 ? Theme.page-end : 0px;
                if i == 0: HomeTop {
                    inner: root.inner;
                    bleed: root.pad;
                }
                if i > 0 && i <= root.count: FeedShelf {
                    shelf: HomeData.shelves[i - 1];
                    bleed: root.pad;
                    in-sight: feed-row.in-sight;
                    grid-first <=> feed-row.grid-first;
                }
                if i > root.count && HomeData.more == MoreState.loading: MoreSkeleton { }
                if i > root.count && HomeData.more == MoreState.failed: MoreFailed { }
            }
        }
    }
}
