// Home's data from `src/pages/home.rs`: the shelves' shapes and rows, and `HomeData`.
import { TrackRow, CardItem, ItemKind } from "../../parts.slint";
import { LyricInk } from "../lyrics.slint";

// How a shelf shows, from what it holds (`home.rs::shape`).
export enum ShelfShape { cards, songs, mixes, videos, playlists, artists }

// The row after the last shelf: nothing, the next page loading, or its quiet Try again.
export enum MoreState { idle, loading, failed }

// One shelf of the Home feed, its items as cards; a song grid also has them as rows in `songs`.
export struct HomeShelfRow {
    title: string,
    // Words before the title, in sentence case ("Similar to" Ari Abdul), or "".
    lead: string,
    items: [CardItem],
    songs: [TrackRow],
    // A round badge for each item, by index (a community playlist's creator), or empty.
    badges: [image],
    shape: ShelfShape,
}

export global HomeData {
    in property <bool> loading;
    in property <string> error;
    // The feed loaded and has no shelves (an identity with no history yet).
    in property <bool> empty;
    // The Now playing card (`Band`): true resumes the session (or shows it playing), false
    // features a pick (when there is one).
    in property <bool> resume;
    // The card's cover (`hero.rs::HERO_COVER`).
    in property <image> hero-cover;
    // The song the card's actions (Like, Add to playlist, Start radio, Go to artist) act on:
    // the current track while resuming, the featured song on a fresh start.
    in property <TrackRow> track;
    // Resume: what's next in the queue (`hero.rs::HERO_NEXT` at most): the card's "Next" line
    // shows the first, its Up next column three.
    in property <[TrackRow]> next;
    // Resume with fewer than three songs next: "More like this" fills the column's other rows,
    // from the song's Related tab when it's loaded (`hero.rs::more_like_this`); empty otherwise.
    in property <[TrackRow]> related;
    // Featured: the pick and its shelf's title ("Quick picks": "A pick from Quick picks").
    in property <bool> has-featured;
    in property <CardItem> featured;
    in property <string> featured-shelf;
    // The featured pick's own band, per theme, from its cover (`follow::lyric_inks_for`, as
    // the lyrics panel's): deep in the dark theme, a light tint with dark text in the light
    // one (`colour::light_tint`); grey until its colour is known. Resuming, the band takes the
    // lyrics panel's own (`LyricsData.ink-dark`, `ink-tint`), which follow the current song.
    in property <LyricInk> featured-ink-dark;
    in property <LyricInk> featured-ink-light;
    // The Shortcuts beside the card (`home.rs::show_shortcuts`): shown signed in with
    // its setting on, whatever the feed holds. Liked songs first (id "LM"), then the pins,
    // what's played lately and the library; which of them are pins, by index; and whether
    // the hint tile ("Pin what you play most") may end the grid when it doesn't fill it.
    in property <bool> shortcuts-shown;
    in property <[CardItem]> shortcuts;
    in property <[bool]> shortcut-pins;
    in property <bool> shortcut-hint;
    // The Shortcuts' tile size as the grid lays it out (104, 64 or 50 px), told as the grid
    // is made and as it changes: their covers are decoded for it (`home.rs::shortcut_tile`).
    callback shortcut-tile(length);
    // Where what plays came from (the queue's page): its Shortcuts tile shows the playing
    // mark on its art's corner, and the card's pill opens it. `song` and "" for none (a radio).
    in property <ItemKind> playing-kind: ItemKind.song;
    in property <string> playing-id;
    in property <[HomeShelfRow]> shelves;
    in property <MoreState> more;
    // How many rows the page has: the top, the shelves, then the next page's row while it
    // loads or failed.
    out property <int> row-count: root.shelves.length + 1 + (root.more != MoreState.idle ? 1 : 0);
    // One entry per row, kept by `home.rs` (`bind_rows`) as one model that only grows or
    // shrinks at its end, to `row-count`, on `sync-rows`.
    in property <[int]> rows;

    callback resume-clicked();
    callback play-featured();
    // Opens the featured pick that isn't a song (Go to album, Open playlist, Go to artist).
    callback open-featured();
    // Opens the Up next panel ("Show all", the "Next" line).
    callback show-queue();
    // One of `related`: plays it as the Related tab does.
    callback play-related(int);
    // Whether the card has room for its Up next column (`Band`), told as that changes and as the
    // Up next panel or sheet opens or closes: `related` is asked for ahead of the Related tab
    // only while one of them would show it (`hero.rs::band_column`).
    callback band-column(bool);
    // The card in the page's view (`HomePage`, from its scroll): its field is made in the
    // frame it's needed only then, off the UI thread otherwise (`now_playing::backdrop`).
    in-out property <bool> band-in-sight: true;
    // The Liked songs tile in Shortcuts: plays Liked songs shuffled.
    callback shuffle-liked();
    // A song card on a shelf: plays it, with radio after it.
    callback play-song(string);
    // Fetches the feed again after an error.
    callback retry();
    // A card's play button: plays the album, playlist or artist without opening it.
    callback play-card(CardItem);
    // The user scrolled near the end: the next page, if one may load now.
    callback near-end();
    // Try again after the next page failed.
    callback retry-more();
    // The page needs `count` rows: `rows` grows or shrinks to that many at its end.
    callback sync-rows(/* count */ int);
}
