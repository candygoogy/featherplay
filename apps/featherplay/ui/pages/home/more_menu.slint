// Home's "N more" tile's menu: the Shortcuts the grid beside the card can't hold, as rows of
// the app's menu surface (`MenuPanel`: a 32 px cover, the title and its line). A click opens
// one, as its tile does; a right-click opens its own menu (`ItemMenu`, as from a tile). Escape,
// a click outside or a scroll closes it. `ShortcutMoreLayer` is drawn over everything by
// app.slint.
import { Theme } from "../../theme.slint";
import { MenuPanel } from "../../menu_panel.slint";
import { Body, Cover } from "../../parts.slint";
import { ItemMenu } from "../../item_menu.slint";
import { Open } from "../content.slint";
import { HomeData } from "data.slint";

export global ShortcutMore {
    out property <bool> open;
    // The first of `HomeData.shortcuts` the menu lists: the grid shows those before it.
    out property <int> from;
    // The tile's right edge, its bottom and its top (window coordinates).
    out property <length> anchor-x;
    out property <length> anchor-y;
    out property <length> anchor-top;
    public function show(from: int, x: length, y: length, top: length) {
        self.from = from;
        self.anchor-x = x;
        self.anchor-y = y;
        self.anchor-top = top;
        self.open = true;
    }
    public function close() {
        self.open = false;
    }
}

export component ShortcutMoreLayer inherits Rectangle {
    callback closed();
    // The menu stays above this (the bottom bar's top edge); the layer still covers the bar.
    in property <length> bottom-limit: root.height;
    property <length> w: 300px;
    property <length> row-h: 48px;
    property <length> pad: 6px;
    property <int> rows: max(0, HomeData.shortcuts.length - ShortcutMore.from);
    property <length> content-h: 2 * root.pad + root.rows * root.row-h;
    // Under the tile, or over it where there's more room there; scrolled when neither holds it.
    property <length> below: root.bottom-limit - ShortcutMore.anchor-y - 2 * Theme.s2;
    property <length> above: ShortcutMore.anchor-top - 2 * Theme.s2;
    property <bool> up: root.content-h > root.below && root.above > root.below;
    property <length> h: min(root.content-h, root.up ? root.above : root.below);

    // The panel stays instantiated so it can fold away (`MenuPanel`).
    property <bool> open: ShortcutMore.open;
    // Closed by Escape: keyboard actions don't animate.
    property <bool> snap: false;
    changed open => {
        if root.open {
            root.snap = false;
            keys.focus();
        }
    }

    function close() {
        ShortcutMore.close();
        root.closed();
    }

    TouchArea {
        visible: ShortcutMore.open;
        width: root.width;
        height: root.height;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.close();
            }
        }
        scroll-event(e) => {
            root.close();
            accept
        }
    }
    MenuPanel {
        open: root.open;
        up: root.up;
        snap: root.snap;
        full-h: root.h;
        x: clamp(ShortcutMore.anchor-x - root.w, Theme.s2, root.width - root.w - Theme.s2);
        y: root.up ? ShortcutMore.anchor-top - Theme.s2 - self.height : ShortcutMore.anchor-y + Theme.s2;
        width: root.w;
        accessible-role: list;
        accessible-label: @tr("More shortcuts");

        // Swallows clicks on the panel's padding.
        TouchArea { enabled: root.open; }
        keys := FocusScope {
            enabled: root.open;
            key-pressed(e) => {
                if e.text == Key.Escape {
                    root.snap = true;
                    root.close();
                    return accept;
                }
                reject
            }
        }
        Flickable {
            x: root.pad;
            y: root.pad;
            width: parent.width - 2 * root.pad;
            height: parent.height - 2 * root.pad;
            content-height: root.rows * root.row-h;
            for it[i] in HomeData.shortcuts: Rectangle {
                visible: i >= ShortcutMore.from;
                y: (i - ShortcutMore.from) * root.row-h;
                width: parent.width;
                height: root.row-h;
                border-radius: 8px;
                background: Theme.state(ta.pressed, ta.has-hover);
                accessible-role: button;
                accessible-label: it.title;
                accessible-description: it.subtitle;
                accessible-action-default => {
                    root.close();
                    Open.item(it);
                }
                ta := TouchArea {
                    enabled: root.open;
                    mouse-cursor: pointer;
                    clicked => {
                        root.close();
                        Open.item(it);
                    }
                    pointer-event(e) => {
                        if e.button == PointerEventButton.right && e.kind == PointerEventKind.up {
                            root.close();
                            ItemMenu.show(it, true, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y, self.absolute-position.y + self.mouse-y);
                        }
                    }
                }
                Cover {
                    x: 10px;
                    y: (parent.height - self.height) / 2;
                    width: 32px;
                    height: 32px;
                    radius: Theme.r-s;
                    round: it.round;
                    source: it.cover;
                }
                VerticalLayout {
                    x: 10px + 32px + Theme.s3;
                    width: parent.width - self.x - 10px;
                    alignment: center;
                    spacing: 1px;
                    Body {
                        text: it.title;
                        font-weight: 600;
                    }
                    Body {
                        text: it.subtitle;
                        font-size: Theme.t-meta;
                        color: Theme.text2;
                    }
                }
            }
        }
    }
}
