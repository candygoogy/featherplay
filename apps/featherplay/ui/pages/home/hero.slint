// Home's Now playing card (`Band`, the boards of 2026-11-22 and 2026-11-26, card A): the
// session, or on a fresh start a featured pick, as one object that shares Home's first row with
// the Shortcuts (`HomeTop` in home.slint places both). Its art fills its left end edge to edge;
// then the title, the artist's round photo and the artists in full (a link to the first's
// page), the album (a link) and year, one line and the actions. The line says what's next
// while nothing else shows the queue (a click opens Up next), else where the song plays from,
// or which shelf a pick came from. Resuming, the foot is Resume ↔ Pause in one place, the four
// round actions (Like, Add to playlist, Start radio, Go to artist, on the song); the time and
// the progress are the bar's, right under the card; a pick has Play. From 760 px
// two of the queue's songs show at the card's top right (`column2`); where the row leaves
// the card its Up next column (`BandSizes.queue-min`: resuming, the panel closed), three,
// and a short queue gets "More like this" under them. A click on the card outside its
// controls opens Now playing.
//
// The card's colours come from `BandInk`. While a song resumes or plays it sits on the song's
// cover field, Now playing's (`BandField`), settling into the field's colour with a floor, so
// it's always a step above the Shortcut tiles beside it. Until that field is in (a fresh
// start's pick, the first song's colours on their way) it's a flat colour: the lyrics panel's
// deep ink in the dark theme, a light tint of the cover's hue in the light one
// (`colour::light_tint`); a featured pick has its own.
import { Theme, Curves, Icons } from "../../theme.slint";
import { CardItem, ItemKind, TrackRow, Body, Display, Cover, Icon } from "../../parts.slint";
import { Nav, Frame } from "../../nav.slint";
import { Player } from "../../player.slint";
import { SongMenu } from "../../song_menu.slint";
import { QueueData } from "../../queue_panel.slint";
import { BarTip } from "../../bar_tip.slint";
import { LyricsData, LyricInk } from "../lyrics.slint";
import { NowPlayingData } from "../now_playing.slint";
import { HomeData } from "data.slint";

// The card's colours. On the field: its ground is the field's mean with a floor (dark: OKLab
// L 0.31 to 0.35, chroma 0.06 at most; light: 0.89 to 0.92, chroma 0.035 at most, and 0.93 to
// 0.95 on neutral art, so a grey cover doesn't make a heavy grey box), the title and names in
// the field's ink, the second level a fixed share of it (AA on the floored ground in both
// themes). Off the field: the lyrics panel's inks (`LyricsData.ink`) or the pick's own. Dark
// theme: white text and white overlays; light: dark text and dark overlays, the solid pill
// black (`Theme.panel-*`).
global BandInk {
    // A song resumes or plays and Now playing's bank of rows is in for the theme (made in the
    // frame a theme or song changes while Home shows, `now_playing::backdrop`).
    out property <bool> field: HomeData.resume && NowPlayingData.backdrop.width > 0 && NowPlayingData.backdrop-dark == Theme.dark;
    out property <LyricInk> dark: self.field ? LyricsData.field-dark : (HomeData.resume ? LyricsData.ink-dark : HomeData.featured-ink-dark);
    out property <LyricInk> light: self.field ? LyricsData.field-light : (HomeData.resume ? LyricsData.ink-tint : HomeData.featured-ink-light);
    public pure function floored(c: color) -> color {
        return Theme.dark ? oklch(clamp(c.to-oklch().lightness, 0.31, 0.35), min(c.to-oklch().chroma, 0.06), c.to-oklch().hue) : (c.to-oklch().chroma < 0.03 ? oklch(clamp(c.to-oklch().lightness, 0.93, 0.95), 0, 0) : oklch(clamp(c.to-oklch().lightness, 0.89, 0.92), min(c.to-oklch().chroma, 0.035), c.to-oklch().hue));
    }
    out property <color> ground: self.field ? BandInk.floored(Theme.pick(Theme.field-card-dark, Theme.field-card-light)) : Theme.pick(self.dark.ground, self.light.ground);
    out property <color> text: Theme.pick(#FFFFFF, self.light.current);
    out property <color> text2: self.field ? Theme.pick(#FFFFFFBF, #000000B3) : Theme.pick(self.dark.next, self.light.next);
    out property <color> rule: Theme.pick(#FFFFFF26, #0000001F);
    // A row or line hovered.
    out property <color> row: Theme.pick(#FFFFFF14, #0000000D);
    // A round action: at rest, hovered, pressed, unavailable.
    public pure function round(down: bool, over: bool, enabled: bool) -> color {
        return !enabled ? Theme.pick(#FFFFFF14, #0000000A) : (down ? Theme.pick(#FFFFFF4D, #0000002E) : (over ? Theme.pick(#FFFFFF40, #00000021) : Theme.pick(#FFFFFF26, #00000012)));
    }
    // On the solid pill (Resume, Play; `Theme.panel-solid-state`): dark on the white pill, white
    // on the black one.
    out property <color> on-solid: Theme.pick(#0F0F0F, #FFFFFF);
    // The tonal pill (the source, Go to album).
    public pure function tonal(down: bool, over: bool) -> color {
        return down ? Theme.pick(#FFFFFF4D, #00000033) : (over ? Theme.pick(#FFFFFF40, #00000026) : Theme.pick(#FFFFFF2E, #00000017));
    }
    // The card hovered: a lift over its ground, under the art.
    out property <color> lift: Theme.pick(#FFFFFF0D, #0000000A);
}

// The card's sizes, and its width in Home's first row.
export global BandSizes {
    out property <length> height: 224px;
    // A card too narrow for the song beside 224 px of art (a narrow window): 176 px high, its
    // art too, the title at 24 px.
    out property <length> slim-h: 176px;
    out property <length> slim-below: 500px;
    // Under this the source pill has no room beside the four actions: where the song plays
    // from is the line under the artists instead.
    out property <length> compact-below: 588px;
    // Between the card and the Shortcuts.
    out property <length> gap: 24px;
    // A page narrower than this puts the Shortcuts under the card.
    out property <length> row-min: 800px;
    // Beside the Shortcuts the card takes 52 % of the row, between these.
    out property <length> least: 536px;
    out property <length> most: 960px;
    // The Up next column at the card's right end, and the least card that has it: the art, the
    // song's 480 px with its gaps, the column.
    out property <length> queue-w: 428px;
    out property <length> queue-min: 1188px;
    // What the Shortcuts keep beside a card with its column.
    out property <length> tiles-beside-queue: 856px;
    out property <length> row-h: 52px;
    // From this width (and below `queue-min`) a 2-row Up next column takes the card's top right,
    // the song's column beside it, 28 px apart; the album and year get their own line.
    out property <length> column2-min: 760px;
    out property <length> column2-w: 272px;
    // A short queue's rows with "More like this" under them: two headings and three rows in
    // the column's height, a 4 px gap before the second heading.
    out property <length> row-h-tight: 44px;
    public pure function slim(w: length) -> bool {
        return w < self.slim-below;
    }
    public pure function height-for(w: length) -> length {
        return BandSizes.slim(w) ? self.slim-h : self.height;
    }
    // The card's width in a page `inner` wide, beside the Shortcuts (`tiles`) or alone, with
    // room for its Up next column wanted (`queue`: resuming, the panel closed). Beside them,
    // 52 % of the row between `least` and `most`, so it never jumps as the window resizes or the
    // panel opens; with its column where the row still keeps the tiles theirs. Alone, at most
    // `most` (and its column), the rest of the row left empty. Under `row-min` the Shortcuts go
    // under it and it takes the page's width.
    public pure function card-w(inner: length, tiles: bool, queue: bool) -> length {
        if tiles {
            if inner < self.row-min {
                return inner;
            }
            if queue && inner - self.gap - self.tiles-beside-queue >= self.queue-min {
                return inner - self.gap - self.tiles-beside-queue;
            }
            return clamp(round(inner * 0.52 / 1px) * 1px, self.least, self.most);
        }
        if queue && inner >= self.most + self.queue-w {
            return self.most + self.queue-w;
        }
        return min(inner, self.most);
    }
}

// Glyphs only the card uses: where a song plays from, by its kind.
global BandIcons {
    out property <string> album: "M12 4 a8 8 0 1 0 0.01 0 Z M12 10.2 a1.8 1.8 0 1 0 0.01 0 Z";
    out property <string> playlist: "M5 7 H15 M5 12 H15 M5 17 H11 M18.5 6.5 V15.5 M18.5 15.5 a2 2 0 1 1 -4 0 a2 2 0 1 1 4 0 Z";
    public pure function source(kind: ItemKind) -> string {
        return kind == ItemKind.album ? self.album : (kind == ItemKind.artist ? Icons.person : self.playlist);
    }
}

// A pick's pill on the card: solid (Play) or tonal (Go to album, Open playlist, Go to artist),
// as wide as its label.
component BandPill inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> solid;
    callback clicked();
    width: (root.icon != "" ? 14px + 18px + 8px : 20px) + lab.preferred-width + 20px;
    height: 40px;
    border-radius: 20px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    property <color> ink: root.solid ? BandInk.on-solid : BandInk.text;
    Rectangle {
        border-radius: root.border-radius;
        background: root.solid ? Theme.panel-solid-state(ta.pressed, ta.has-hover) : BandInk.tonal(ta.pressed, ta.has-hover);
        animate background { duration: Theme.t-hover; }
        transform-scale: ta.pressed ? Theme.press-scale : 1.0;
        animate transform-scale {
            duration: ta.pressed ? Theme.t-press : Theme.t-release;
            easing: ta.pressed ? Curves.ease-out : Curves.release;
        }
        ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.clicked(); }
        }
        Icon {
            visible: root.icon != "";
            x: 14px;
            y: (parent.height - self.height) / 2;
            width: 18px;
            height: 18px;
            commands: root.icon;
            fill: root.ink;
            stroke: transparent;
        }
        lab := Body {
            x: root.icon != "" ? 40px : 20px;
            width: root.width - self.x - 20px;
            height: root.height;
            text: root.label;
            font-weight: 600;
            color: root.ink;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
}

// A round action on the card, named in the bar's tooltip.
component BandButton inherits Rectangle {
    in property <string> icon;
    in property <bool> filled;
    in property <string> name;
    in property <bool> enabled: true;
    callback clicked();
    width: 40px;
    height: 40px;
    border-radius: 20px;
    // Animated as a private property: a root animating a public one is copied into each use.
    property <brush> ground: BandInk.round(ta.pressed, ta.has-hover, root.enabled);
    animate ground { duration: Theme.t-hover; }
    background: root.ground;
    accessible-role: button;
    accessible-label: root.name;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.clicked(); }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            tip.dismiss();
            root.clicked();
        }
    }
    Icon {
        width: 20px;
        height: 20px;
        commands: root.icon;
        stroke: root.filled ? transparent : BandInk.text.transparentize(root.enabled ? 0 : 0.6);
        fill: root.filled ? BandInk.text : transparent;
    }
    tip := BarTip {
        over: ta.has-hover && root.enabled;
        name: root.name;
    }
}

// The line between the song and its actions, a button over its whole length: "Next" with the
// song's cover, or "From" with the source's glyph, the chevron at the end. The name elides;
// its second part goes once there's no room for it.
component BandLine inherits Rectangle {
    in property <string> lead;
    in property <image> cover;
    in property <string> glyph;
    in property <string> name;
    in property <string> rest;
    callback clicked();
    height: 28px;
    border-radius: 8px;
    property <brush> ground: ta.has-hover ? BandInk.row : transparent;
    animate ground { duration: Theme.t-hover; easing: Curves.ease-hover; }
    background: root.ground;
    accessible-role: button;
    accessible-label: root.lead + " " + root.name + root.rest;
    accessible-action-default => { root.clicked(); }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    lead-t := Body {
        x: 8px;
        width: min(self.preferred-width, root.width - 16px);
        height: root.height;
        text: root.lead;
        font-weight: 600;
        color: BandInk.text2;
        vertical-alignment: center;
        accessible-role: none;
    }
    property <bool> has-cover: root.glyph == "";
    property <length> mark-w: root.has-cover ? 22px : 16px;
    Cover {
        visible: root.has-cover;
        x: lead-t.x + lead-t.width + 8px;
        y: (root.height - self.height) / 2;
        width: 22px;
        height: 22px;
        radius: 3px;
        placeholder: false;
        source: root.cover;
    }
    Icon {
        visible: !root.has-cover;
        x: lead-t.x + lead-t.width + 8px;
        y: (root.height - self.height) / 2;
        width: 16px;
        height: 16px;
        commands: root.glyph;
        stroke: BandInk.text;
    }
    // The name and what follows it, up to the chevron.
    Rectangle {
        x: lead-t.x + lead-t.width + 8px + root.mark-w + 8px;
        width: max(0px, root.width - self.x - 8px - 14px - 8px);
        name-t := Body {
            x: 0;
            width: min(self.preferred-width, parent.width);
            height: root.height;
            text: root.name;
            font-weight: 600;
            color: BandInk.text;
            vertical-alignment: center;
            accessible-role: none;
        }
        Body {
            x: name-t.width;
            width: max(0px, parent.width - self.x);
            visible: self.width >= 48px;
            height: root.height;
            text: root.rest;
            color: BandInk.text2;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
    Icon {
        x: root.width - 8px - self.width;
        y: (root.height - self.height) / 2;
        width: 14px;
        height: 14px;
        commands: Icons.chevron-right;
        stroke: BandInk.text2;
    }
}

// A song in the card's Up next column: its cover, title and second line, and the length at
// the end; a click plays it, a right-click opens the song menu.
component BandRow inherits Rectangle {
    in property <image> cover;
    in property <string> title;
    in property <string> subtitle;
    in property <string> duration;
    callback clicked();
    // Right-click: the menu at this point (window coordinates).
    callback menu(length, length);
    height: BandSizes.row-h;
    border-radius: Theme.r-m;
    // Animated as a private property, as `BandButton`'s.
    property <brush> ground: Theme.panel-state(ta.pressed, ta.has-hover);
    animate ground { duration: Theme.t-hover; easing: Curves.ease-hover; }
    background: root.ground;
    accessible-role: button;
    accessible-label: root.title + ", " + root.subtitle;
    accessible-action-default => { root.clicked(); }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        pointer-event(e) => {
            if e.button == PointerEventButton.right && e.kind == PointerEventKind.up {
                root.menu(root.absolute-position.x + self.mouse-x, root.absolute-position.y + self.mouse-y);
            }
        }
    }
    Cover {
        x: 8px;
        y: (parent.height - self.height) / 2;
        width: 40px;
        height: 40px;
        radius: Theme.r-s;
        source: root.cover;
    }
    VerticalLayout {
        x: 60px;
        width: parent.width - self.x - (root.duration != "" ? dur.preferred-width + 20px : 8px);
        alignment: center;
        spacing: 1px;
        Body {
            text: root.title;
            font-weight: 600;
            color: BandInk.text;
        }
        Body {
            text: root.subtitle;
            font-size: Theme.t-meta;
            color: BandInk.text2;
        }
    }
    dur := Body {
        x: parent.width - self.width - 8px;
        width: self.preferred-width;
        height: parent.height;
        visible: root.duration != "";
        text: root.duration;
        font-size: Theme.t-meta;
        color: BandInk.text2;
        vertical-alignment: center;
    }
}

// Underlined text that does something ("Show all 12").
component BandLink inherits Rectangle {
    in property <string> text;
    callback clicked();
    width: t.preferred-width;
    height: 20px;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    t := Body {
        height: root.height;
        text: root.text;
        font-size: Theme.t-meta;
        font-weight: 600;
        color: BandInk.text;
        vertical-alignment: center;
        accessible-role: none;
    }
    Rectangle {
        y: 17px;
        height: 1px;
        background: BandInk.text;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Text that goes somewhere (the artists, the album): underlined on hover, as the bar's artist.
// As wide as its text, at most `room`, eliding past it.
component BandTextLink inherits Rectangle {
    in property <string> text;
    in property <length> size: Theme.t-body;
    in property <int> weight: 400;
    in property <color> ink: BandInk.text;
    in property <color> ink-over: root.ink;
    in property <bool> enabled: true;
    in property <length> room: 100000px;
    callback clicked();
    width: min(t.preferred-width, max(0px, root.room));
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.clicked(); }
    t := Body {
        x: 0;
        width: parent.width;
        height: parent.height;
        text: root.text;
        font-size: root.size;
        font-weight: root.weight;
        color: ta.has-hover && root.enabled ? root.ink-over : root.ink;
        vertical-alignment: center;
        accessible-role: none;
    }
    Rectangle {
        visible: ta.has-hover && root.enabled;
        x: 0;
        y: round((root.height + root.size) / 2 / 1px) * 1px + 1px;
        height: 1px;
        background: t.color;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// "Homework · 1997": the album and the year a level down, after a " · " when `dot`, as one
// run that elides at its end (the year goes first, then the album elides). The album is a
// link: underlined and in the ink on hover.
component BandMeta inherits Rectangle {
    in property <string> album;
    in property <string> album-id;
    in property <string> year;
    in property <bool> dot;
    in property <length> size: Theme.t-body;
    property <string> lead: root.dot && (root.album != "" || root.year != "") ? " · " : "";
    property <string> between: root.album != "" && root.year != "" ? " · " : "";
    // Where the album starts, and how much of it shows.
    property <length> album-x: root.lead == "" ? 0px : lead-measure.preferred-width;
    property <length> album-shown: root.album == "" ? 0px : clamp(root.width - root.album-x, 0px, album-measure.preferred-width);
    property <bool> over: ta.has-hover && root.album-id != "";
    lead-measure := Body {
        visible: false;
        text: root.lead;
        font-size: root.size;
    }
    album-measure := Body {
        visible: false;
        text: root.album;
        font-size: root.size;
    }
    Body {
        x: 0;
        width: root.width;
        height: root.height;
        text: root.lead + root.album + root.between + root.year;
        font-size: root.size;
        color: BandInk.text2;
        vertical-alignment: center;
        // A screen reader gets the album from its button below, and the year here.
        accessible-role: text;
        accessible-label: root.year;
    }
    // The album in the ink, whole, while hovered.
    Body {
        visible: root.over && root.album-shown >= album-measure.preferred-width;
        x: root.album-x;
        width: root.album-shown;
        height: root.height;
        text: root.album;
        font-size: root.size;
        color: BandInk.text;
        vertical-alignment: center;
        accessible-role: none;
    }
    Rectangle {
        visible: root.over;
        x: root.album-x;
        y: round((root.height + root.size) / 2 / 1px) * 1px + 1px;
        width: root.album-shown;
        height: 1px;
        background: root.album-shown >= album-measure.preferred-width ? BandInk.text : BandInk.text2;
    }
    Rectangle {
        x: root.album-x;
        width: root.album-shown;
        accessible-role: button;
        accessible-label: root.album;
        accessible-enabled: root.album-id != "";
        accessible-action-default => { Nav.open-album(root.album-id); }
        ta := TouchArea {
            enabled: root.album-id != "" && root.album-shown > 0;
            mouse-cursor: pointer;
            clicked => { Nav.open-album(root.album-id); }
        }
    }
}

// Resume and Pause in one place: a solid pill at one width (the longer word's), or a solid
// round (`pill` false), its glyph turning as the bar's play button's does. In the pill each
// word's glyph and word sit centred as a group, `resume-in` and `pause-in` in from where the
// longer word's start; the two crossfade in place.
component BandToggle inherits Rectangle {
    in property <bool> pill;
    in property <bool> on;
    in property <length> resume-in;
    in property <length> pause-in;
    callback clicked();
    height: 40px;
    border-radius: 20px;
    accessible-role: button;
    accessible-label: root.on ? @tr("Pause") : @tr("Resume");
    accessible-action-default => { root.clicked(); }
    property <color> ink: BandInk.on-solid;
    property <length> play-x: root.pill ? 14px + root.resume-in : (root.width - 18px) / 2;
    property <length> pause-x: root.pill ? 14px + root.pause-in : (root.width - 18px) / 2;
    Rectangle {
        border-radius: root.border-radius;
        background: Theme.panel-solid-state(ta.pressed, ta.has-hover);
        animate background { duration: Theme.t-hover; }
        transform-scale: ta.pressed ? Theme.press-scale : 1.0;
        animate transform-scale {
            duration: ta.pressed ? Theme.t-press : Theme.t-release;
            easing: ta.pressed ? Curves.ease-out : Curves.release;
        }
        ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.clicked(); }
        }
        Icon {
            x: root.play-x;
            y: (parent.height - self.height) / 2;
            width: 18px;
            height: 18px;
            commands: Icons.play;
            fill: root.ink;
            stroke: transparent;
            opacity: root.on ? 0 : 1;
            transform-scale: root.on && Theme.moving ? 0.6 : 1.0;
            transform-rotation: root.on && Theme.moving ? 90deg : 0deg;
            animate opacity { duration: Theme.t-fast; easing: Curves.ease-out; }
            animate transform-scale, transform-rotation { duration: Theme.t-morph; easing: Curves.morph; }
        }
        Icon {
            x: root.pause-x;
            y: (parent.height - self.height) / 2;
            width: 18px;
            height: 18px;
            commands: Icons.pause;
            fill: root.ink;
            stroke: transparent;
            opacity: root.on ? 1 : 0;
            transform-scale: root.on || !Theme.moving ? 1.0 : 0.6;
            transform-rotation: root.on || !Theme.moving ? 0deg : -90deg;
            animate opacity { duration: Theme.t-fast; easing: Curves.ease-out; }
            animate transform-scale, transform-rotation { duration: Theme.t-morph; easing: Curves.morph; }
        }
        // The two words crossfade.
        Body {
            visible: root.pill;
            x: 40px + root.resume-in;
            width: max(0px, root.width - 60px);
            height: root.height;
            text: @tr("Resume");
            font-weight: 600;
            color: root.ink;
            opacity: root.on ? 0 : 1;
            animate opacity { duration: Theme.t-fast; easing: Curves.ease-out; }
            vertical-alignment: center;
            accessible-role: none;
        }
        Body {
            visible: root.pill;
            x: 40px + root.pause-in;
            width: max(0px, root.width - 60px);
            height: root.height;
            text: @tr("Pause");
            font-weight: 600;
            color: root.ink;
            opacity: root.on ? 1 : 0;
            animate opacity { duration: Theme.t-fast; easing: Curves.ease-out; }
            vertical-alignment: center;
            accessible-role: none;
        }
    }
}

// One of the card's corners: the page's ground outside a quarter circle of radius `r`, a ring
// clipped to the corner (small enough for the renderer's kept rings). Drawn over the field and
// the art, which are clipped square: a rounded clip is anti-aliased, and every row of the
// field would be drawn through its mask.
component FieldCorner inherits Rectangle {
    in property <length> r;
    in property <bool> right;
    in property <bool> bottom;
    width: root.r;
    height: root.r;
    clip: true;
    Rectangle {
        x: root.right ? -2 * root.r : -root.r;
        y: root.bottom ? -2 * root.r : -root.r;
        width: 4 * root.r;
        height: 4 * root.r;
        border-radius: 2 * root.r;
        border-width: root.r;
        border-color: Theme.ground;
    }
}

// The song's cover field under the card, Now playing's bank of rows
// (`NowPlayingData.backdrop`) with its middle under the card's; the renderer copies only the
// rows the card shows. Over it, from the art's edge, the card's ground settles in, so the
// art's light spills from its edge and the text sits on the floored ground.
component BandField inherits Rectangle {
    in property <length> art;
    clip: true;
    // Kept as a layer, opaque on the page's ground (the card shows the page's ground where
    // the field doesn't reach): a scroll frame copies it rather than drawing the field and
    // blending its gradient over ~0.8 Mpx again (~2.5 ms of a 4K frame while the card shows).
    // Drawn again only when the field or the card's size changes.
    background: Theme.ground;
    cache-rendering-hint: true;
    Image {
        width: NowPlayingData.backdrop-w * 1phx;
        height: NowPlayingData.backdrop-h * 1phx;
        x: round((parent.width - self.width) / 2 / 1phx) * 1phx;
        y: round((parent.height - self.height) / 2 / 1phx) * 1phx;
        source: NowPlayingData.backdrop;
        image-fit: fill;
    }
    // The ground at 40 % on the art's edge, 74 % 106 px on, 94 % at 296 px, whole at 476 px.
    property <color> base: BandInk.ground;
    property <float> w: max(1px, root.width - root.art) / 1px;
    Rectangle {
        x: root.art;
        width: root.width - root.art;
        background: @linear-gradient(90deg, root.base.with-alpha(0.4) 0%, root.base.with-alpha(0.74) min(1, 106 / root.w), root.base.with-alpha(0.94) min(1, 296 / root.w), root.base min(1, 476 / root.w), root.base 100%);
    }
}

// The card. Its width comes from `HomeTop` (`BandSizes.card-w`); the rest follows from it.
export component Band inherits Rectangle {
    property <bool> resume: HomeData.resume;
    property <bool> playing: root.resume && Player.playing;
    property <bool> song: root.resume || HomeData.featured.kind == ItemKind.song;
    property <bool> liked: root.resume ? Player.liked : HomeData.track.liked;
    property <color> ink-ground: BandInk.ground;
    // A narrow window's card: 176 px, a 24 px title.
    property <bool> slim: BandSizes.slim(root.width);
    // A narrow card: 20 px at its right end rather than 24.
    property <bool> compact: root.width < BandSizes.compact-below;
    property <length> art: root.slim ? BandSizes.slim-h : BandSizes.height;
    // The Up next panel or sheet shows the queue (`HomeTop.panel`).
    in property <bool> panel: Frame.tabs-open;
    property <bool> column: root.resume && !root.panel && root.width >= BandSizes.queue-min;
    property <int> queued: QueueData.upcoming.length;
    property <int> rows-n: root.resume ? HomeData.next.length : 0;
    // Between `column2-min` and `queue-min`: two of the queue's songs at the top right.
    property <bool> column2: root.resume && !root.panel && !root.column && root.width >= BandSizes.column2-min && root.rows-n > 0;
    property <length> text-x: root.art + (root.slim ? 20px : 28px);
    property <length> pad-y: root.slim ? 14px : 18px;
    property <length> end-pad: root.compact ? 20px : 24px;
    // The foot's width (up to the 3-row column), and the song's (beside the 2-row one).
    property <length> foot-w: root.width - root.text-x - root.end-pad - (root.column ? BandSizes.queue-w : 0px);
    property <length> text-w: root.foot-w - (root.column2 ? BandSizes.column2-w + 28px : 0px);
    // "More like this" under a short queue (resuming only; `hero.rs` fills it then).
    property <int> more-n: root.resume ? HomeData.related.length : 0;
    // Room for the queue's column, where "More like this" shows (`HomeData.band-column`),
    // told from the turn after the card is made, once it's laid out (its width at `init`
    // isn't yet the layout's); and again as the Up next panel or sheet, which shows it too,
    // opens or closes.
    property <bool> laid-out;
    property <bool> column-room: root.laid-out && root.column;
    changed column-room => { HomeData.band-column(self.column-room); }
    changed panel => { HomeData.band-column(self.column-room); }
    Timer {
        interval: 0ms;
        running: !root.laid-out;
        triggered => { root.laid-out = true; }
    }

    // The title: 40 px on one line, else 32 px (on two lines where one doesn't hold it), then
    // it elides (the slim card: 24 px, one line or two). Measured on one line; the box keeps
    // the face's own leading.
    property <string> title: root.resume ? Player.title : HomeData.featured.title;
    title-probe := Display {
        visible: false;
        text: root.title;
        font-size: root.slim ? Theme.t-display-s : Theme.t-display-l;
    }
    property <bool> large: !root.slim && title-probe.preferred-width <= root.text-w;
    property <length> title-size: root.slim ? Theme.t-display-s : (root.large ? Theme.t-display-l : Theme.t-display-m);
    second-probe := Display {
        visible: false;
        text: root.title;
        font-size: Theme.t-display-m;
    }
    property <bool> two: root.slim ? title-probe.preferred-width > root.text-w : !root.large && second-probe.preferred-width > root.text-w;
    property <length> title-h: root.large ? 48px : (root.two ? 2 : 1) * (root.slim ? title-probe.preferred-height : second-probe.preferred-height);
    property <length> who-y: root.pad-y + root.title-h + (root.two ? 2px : 4px);
    property <length> who-h: root.slim ? 22px : 24px;
    property <length> acts-y: root.height - root.pad-y - 40px;
    property <length> line-y: root.acts-y - 8px - 28px;

    // The song's artists (all of them; the link opens the first's page), its album and year.
    // A single's album has the song's own name: it would only repeat the title, so it says
    // "Single" once the album's page says so, and goes until then.
    property <string> artists: root.resume ? Player.artist : (root.song ? HomeData.track.artist : HomeData.featured.subtitle);
    property <string> artist-id: root.song ? HomeData.track.artist-id : "";
    property <string> album: root.resume ? (Player.album == root.title ? (NowPlayingData.single ? @tr("Single") : "") : Player.album) : (root.song && HomeData.track.album != root.title ? HomeData.track.album : "");
    property <string> album-id: root.song ? HomeData.track.album-id : "";
    property <string> year: root.resume && Player.album != "" ? NowPlayingData.year : "";
    // From `column2-min` the album and year have a line of their own, where it clears the line
    // below; else they follow the artists.
    property <length> meta-y: root.who-y + root.who-h + 2px;
    property <bool> meta-own: root.resume && root.width >= BandSizes.column2-min && (root.album != "" || root.year != "") && root.meta-y + 20px <= root.line-y;

    // The line: a pick's shelf; while the Up next panel is closed and no column shows the
    // queue, what's next; else where the song plays from. Only where it clears the artists.
    property <bool> next-line: !root.panel && !root.column && !root.column2 && root.rows-n > 0;
    property <int> line: !root.resume ? 1 : (root.next-line ? 2 : (QueueData.playing-from != "" ? 3 : 0));
    property <bool> line-shown: root.line != 0 && root.who-y + root.who-h <= root.line-y;

    height: root.art;
    border-radius: Theme.r-l;
    // The flat colour fades from song to song; on the field there's none, at once.
    animate ink-ground { duration: Theme.t-turn; easing: Curves.ease-hover; }
    background: BandInk.field ? transparent : root.ink-ground;
    BandField {
        visible: BandInk.field;
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        art: root.art;
    }

    // The card is a button under its controls: a click opens Now playing, as the bar's song
    // area does. Hovered, it lifts and its art shows the bar's veil and chevron.
    card := Rectangle {
        property <bool> over: card-ta.has-hover && root.resume;
        Rectangle {
            background: BandInk.lift;
            opacity: card.over ? 1 : 0;
            animate opacity { duration: Theme.t-hover; easing: Curves.ease-hover; }
        }
        card-ta := TouchArea {
            enabled: root.resume;
            mouse-cursor: self.enabled ? pointer : default;
            clicked => { Nav.toggle-now-playing(); }
        }
    }
    Rectangle {
        visible: root.resume;
        accessible-role: button;
        accessible-label: @tr("Now playing: {}", Player.title);
        accessible-action-default => { Nav.toggle-now-playing(); }
    }

    // The art, edge to edge at the card's left end; its corners are the card's (`FieldCorner`).
    Rectangle {
        x: 0;
        y: 0;
        width: root.art;
        height: root.art;
        background: Theme.cover-empty;
        Cover {
            width: parent.width;
            height: parent.height;
            radius: 0px;
            crossfade: true;
            round: !root.resume && HomeData.featured.round;
            source: HomeData.hero-cover;
        }
        Rectangle {
            background: Theme.cover-hover;
            opacity: card.over ? 1 : 0;
            visible: self.opacity > 0;
            animate opacity { duration: Theme.t-hover; easing: Curves.ease-hover; }
            Icon {
                width: 22px;
                height: 22px;
                commands: Icons.chevron-up;
                stroke: #FFFFFF;
                stroke-width: 2px;
            }
        }
        // Its edge against the text's side.
        Rectangle {
            x: parent.width - 1px;
            width: 1px;
            background: Theme.cover-edge;
        }
    }
    Display {
        x: root.text-x;
        y: root.pad-y;
        width: root.text-w;
        height: root.title-h;
        text: root.title;
        font-size: root.title-size;
        wrap: root.two ? TextWrap.word-wrap : TextWrap.no-wrap;
        max-lines: 2;
        vertical-alignment: center;
        color: BandInk.text;
        accessible-role: text;
    }
    // The artist's round photo and the artists in full, a link; then " · album · year", the
    // rest a level down, unless those have their own line. The artists keep the line: the
    // album elides, then goes.
    Rectangle {
        property <length> size: root.slim ? Theme.t-body : Theme.t-body-l;
        property <length> photo: root.resume ? (root.slim ? 20px : 22px) : 0px;
        x: root.text-x;
        y: root.who-y;
        width: root.text-w;
        height: root.who-h;
        Rectangle {
            visible: root.resume;
            x: 0;
            y: (parent.height - self.height) / 2;
            width: parent.photo;
            height: parent.photo;
            border-radius: self.width / 2;
            // Until the photo comes, or without one: the artist's initial on a tonal round.
            background: BandInk.tonal(false, false);
            Body {
                visible: HomeData.artist-photo.width == 0;
                horizontal-alignment: center;
                vertical-alignment: center;
                text: HomeData.artist-initial;
                font-size: Theme.t-meta;
                font-weight: 600;
                color: BandInk.text;
                accessible-role: none;
            }
            Cover {
                visible: HomeData.artist-photo.width > 0;
                width: parent.width;
                height: parent.height;
                round: true;
                placeholder: false;
                source: HomeData.artist-photo;
            }
            Rectangle {
                border-radius: self.width / 2;
                border-width: 1px;
                border-color: Theme.cover-edge;
            }
        }
        artist := BandTextLink {
            x: parent.photo > 0 ? parent.photo + 8px : 0px;
            height: parent.height;
            room: parent.width - self.x;
            text: root.artists;
            size: parent.size;
            weight: 600;
            enabled: root.artist-id != "";
            clicked => { Nav.open-artist(root.artist-id); }
        }
        BandMeta {
            visible: !root.meta-own && self.width >= 48px;
            x: artist.x + artist.width;
            width: max(0px, parent.width - self.x);
            height: parent.height;
            album: root.album;
            album-id: root.album-id;
            year: root.year;
            dot: true;
            size: parent.size;
        }
    }
    // "Single · 2024" on its own line, from `column2-min`.
    BandMeta {
        visible: root.meta-own;
        x: root.text-x;
        y: root.meta-y;
        width: root.text-w;
        height: 20px;
        album: root.album;
        album-id: root.album-id;
        year: root.year;
    }

    // A pick: which shelf it came from, as quiet text.
    Body {
        visible: root.line-shown && root.line == 1;
        x: root.text-x;
        y: root.line-y;
        width: root.text-w;
        height: 28px;
        text: @tr("A pick from {}", HomeData.featured-shelf);
        font-weight: 600;
        color: BandInk.text2;
        vertical-alignment: center;
    }
    // "Next" with the next song (it opens the Up next panel), or "From" where the song plays
    // from (its page; a radio's Up next).
    BandLine {
        visible: root.line-shown && root.line != 1;
        x: root.text-x - 8px;
        y: root.line-y;
        width: root.text-w + 8px;
        lead: root.line == 2 ? @tr("Next") : @tr("From");
        cover: HomeData.next[0].cover;
        glyph: root.line == 3 ? (HomeData.playing-id == "" ? Icons.radio : BandIcons.source(HomeData.playing-kind)) : "";
        name: root.line == 2 ? HomeData.next[0].title : QueueData.playing-from;
        rest: root.line == 2 ? " · " + HomeData.next[0].artist : "";
        clicked => {
            if root.line == 2 {
                HomeData.show-queue();
            } else {
                QueueData.open-source();
            }
        }
    }

    // The actions at the foot. Resuming: Resume ↔ Pause in place and the four round actions;
    // nothing in the row depends on the play state or the song's position.
    // A pick: Play (and Go to album, Open playlist or Go to artist for one that isn't a song),
    // then as many of the round actions as fit.
    act := Rectangle {
        property <string> other-label: HomeData.featured.kind == ItemKind.artist ? @tr("Go to artist") : (HomeData.featured.kind == ItemKind.album ? @tr("Go to album") : @tr("Open playlist"));
        property <length> rounds-w: 4 * 40px + 3 * 8px;
        // The toggle as a pill as wide as the longer word, where it and the rounds fit.
        property <length> toggle-word-w: max(resume-measure.preferred-width, pause-measure.preferred-width);
        property <length> toggle-pill-w: 40px + self.toggle-word-w + 20px;
        property <bool> toggle-pill: self.width >= self.toggle-pill-w + 8px + self.rounds-w;
        property <length> toggle-w: self.toggle-pill ? self.toggle-pill-w : 40px;
        property <length> play-w: 40px + play-measure.preferred-width + 20px;
        property <length> other-w: !root.song ? 20px + other-measure.preferred-width + 20px : 0px;
        property <length> lead-w: root.resume ? self.toggle-w + 8px : self.play-w + 8px + (!root.song ? self.other-w + 8px : 0px);
        property <int> rounds: root.resume ? 4 : (!root.song ? 0 : max(0, min(4, floor((self.width - self.lead-w + 8px) / 48px))));
        x: root.text-x;
        y: root.acts-y;
        width: root.foot-w;
        height: 40px;
        // Only measured.
        resume-measure := Body {
            visible: false;
            text: @tr("Resume");
            font-weight: 600;
        }
        pause-measure := Body {
            visible: false;
            text: @tr("Pause");
            font-weight: 600;
        }
        play-measure := Body {
            visible: false;
            text: @tr("Play");
            font-weight: 600;
        }
        other-measure := Body {
            visible: false;
            text: act.other-label;
            font-weight: 600;
        }
        // Placed by hand, each shown or hidden rather than made and unmade (an `if` costs the
        // exe a component of its own): the lead (the toggle, or Play and the pick's other
        // pill), then the rounds 48 px apart from `lead-w`.
        BandToggle {
            visible: root.resume;
            x: 0;
            width: act.toggle-w;
            pill: act.toggle-pill;
            resume-in: (act.toggle-word-w - resume-measure.preferred-width) / 2;
            pause-in: (act.toggle-word-w - pause-measure.preferred-width) / 2;
            on: root.playing;
            clicked => { HomeData.resume-clicked(); }
        }
        BandPill {
            visible: !root.resume;
            x: 0;
            label: @tr("Play");
            icon: Icons.play;
            solid: true;
            clicked => { HomeData.play-featured(); }
        }
        // A pick that isn't a song: Go to album, Open playlist or Go to artist.
        BandPill {
            visible: !root.song;
            x: act.play-w + 8px;
            label: act.other-label;
            clicked => { HomeData.open-featured(); }
        }
        BandButton {
            visible: act.rounds >= 1;
            x: act.lead-w;
            icon: Icons.heart;
            filled: root.liked;
            name: root.liked ? @tr("Remove like") : @tr("Like");
            clicked => { SongMenu.like(HomeData.track.id, !root.liked); }
        }
        BandButton {
            visible: act.rounds >= 2;
            x: act.lead-w + 48px;
            icon: Icons.plus;
            name: @tr("Add to playlist");
            clicked => {
                SongMenu.show(HomeData.track, self.absolute-position.x, self.absolute-position.y + self.height + Theme.s1, self.absolute-position.y);
                if SongMenu.signed-in {
                    SongMenu.choosing = true;
                } else {
                    SongMenu.close();
                    SongMenu.add-signed-out();
                }
            }
        }
        BandButton {
            visible: act.rounds >= 3;
            x: act.lead-w + 2 * 48px;
            icon: Icons.radio;
            name: @tr("Start radio");
            clicked => { SongMenu.start-radio(HomeData.track.id); }
        }
        BandButton {
            visible: act.rounds >= 4;
            x: act.lead-w + 3 * 48px;
            icon: Icons.person;
            name: @tr("Go to artist");
            enabled: HomeData.track.artist-id != "";
            clicked => { Nav.open-artist(HomeData.track.artist-id); }
        }
    }

    // The 2-row Up next column at the top right: "Up next" and "Show all N" over two rows.
    Rectangle {
        visible: root.column2;
        x: root.width - root.end-pad - BandSizes.column2-w;
        y: root.pad-y;
        width: BandSizes.column2-w;
        height: 20px + 2 * BandSizes.row-h;
        // The hairline, 14 px before the column.
        Rectangle {
            x: -14px;
            y: 4px;
            width: 1px;
            height: parent.height - 6px;
            background: BandInk.rule;
        }
        Body {
            x: 0;
            y: 0;
            width: parent.width - 8px - (all2.visible ? all2.width + Theme.s4 : 0px);
            height: 20px;
            text: @tr("Up next");
            font-size: Theme.t-meta;
            font-weight: 600;
            color: BandInk.text2;
            vertical-alignment: center;
        }
        all2 := BandLink {
            x: parent.width - 8px - self.width;
            y: 0;
            visible: root.queued > 2;
            text: @tr("Show all {}", root.queued);
            clicked => { HomeData.show-queue(); }
        }
        for t[i] in HomeData.next: BandRow {
            visible: i < 2;
            x: -8px;
            y: 20px + i * BandSizes.row-h;
            width: parent.width + 8px;
            cover: t.cover;
            title: t.title;
            subtitle: t.artist;
            duration: t.duration;
            clicked => { QueueData.play(i); }
            menu(x, y) => { SongMenu.show(t, x, y, y); }
        }
    }

    // The Up next column at the right end: "Up next" and "Show all N" over three rows, then
    // "More like this" under a short queue, a hairline before it.
    Rectangle {
        visible: root.column;
        property <bool> mixed: root.rows-n > 0 && root.more-n > 0;
        property <length> row-h: self.mixed ? BandSizes.row-h-tight : BandSizes.row-h;
        // "More like this": under the queue's rows and a 4 px gap, or at the top without a queue.
        property <length> more-y: root.rows-n > 0 ? 20px + root.rows-n * self.row-h + 4px : 0px;
        x: root.width - BandSizes.queue-w;
        y: 22px;
        width: BandSizes.queue-w - 24px;
        height: root.height - 22px;
        // The hairline, 14 px before the column.
        Rectangle {
            x: -14px;
            y: 2px;
            width: 1px;
            height: root.height - 48px;
            background: BandInk.rule;
        }
        Body {
            visible: root.rows-n > 0;
            x: 0;
            y: 0;
            width: parent.width - 8px - (all.visible ? all.width + Theme.s4 : 0px);
            height: 20px;
            text: @tr("Up next");
            font-size: Theme.t-meta;
            font-weight: 600;
            color: BandInk.text2;
            vertical-alignment: center;
        }
        all := BandLink {
            x: parent.width - 8px - self.width;
            y: 0;
            visible: root.queued > root.rows-n;
            text: @tr("Show all {}", root.queued);
            clicked => { HomeData.show-queue(); }
        }
        for t[i] in HomeData.next: BandRow {
            x: -8px;
            y: 20px + i * parent.row-h;
            width: parent.width + 8px;
            height: parent.row-h;
            cover: t.cover;
            title: t.title;
            subtitle: t.artist;
            duration: t.duration;
            clicked => { QueueData.play(i); }
            menu(x, y) => { SongMenu.show(t, x, y, y); }
        }
        Body {
            visible: root.more-n > 0;
            x: 0;
            y: parent.more-y;
            width: parent.width - 8px;
            height: 20px;
            text: @tr("More like this");
            font-size: Theme.t-meta;
            font-weight: 600;
            color: BandInk.text2;
            vertical-alignment: center;
        }
        for t[i] in HomeData.related: BandRow {
            x: -8px;
            y: parent.more-y + 20px + i * parent.row-h;
            width: parent.width + 8px;
            height: parent.row-h;
            cover: t.cover;
            title: t.title;
            subtitle: t.artist;
            duration: t.duration;
            clicked => { HomeData.play-related(i); }
            menu(x, y) => { SongMenu.show(t, x, y, y); }
        }
    }

    // The corners in the page's ground, over the field and the art; the card's 1 px edge.
    FieldCorner {
        x: 0;
        y: 0;
        r: Theme.r-l;
    }
    FieldCorner {
        x: root.width - Theme.r-l;
        y: 0;
        r: Theme.r-l;
        right: true;
    }
    FieldCorner {
        x: 0;
        y: root.height - Theme.r-l;
        r: Theme.r-l;
        bottom: true;
    }
    FieldCorner {
        x: root.width - Theme.r-l;
        y: root.height - Theme.r-l;
        r: Theme.r-l;
        right: true;
        bottom: true;
    }
    Rectangle {
        border-radius: Theme.r-l;
        border-width: 1px;
        border-color: Theme.cover-edge;
    }
}
