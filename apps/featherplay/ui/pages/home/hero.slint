// Home's hero: "Pick up where you left off" (`ResumeCard`) and, on a fresh start,
// "Start listening" (`FeaturedCard`) with its rows (`ItemRow`). `HomeTop` lays them out.
import { Theme, Curves, Icons } from "../../theme.slint";
import { CardItem, ItemKind, Body, Display, Cover, Pill, ProgressRail, SongRow, PageIntent } from "../../parts.slint";
import { Nav } from "../../nav.slint";
import { Player } from "../../player.slint";
import { SongMenu } from "../../song_menu.slint";
import { HomeData } from "data.slint";

// A compact item row for the featured mode's right column: cover, title, subtitle.
component ItemRow inherits Rectangle {
    in property <CardItem> item;
    callback clicked();
    height: Theme.row-h;
    border-radius: Theme.r-m;
    background: Theme.state(ta.pressed, ta.has-hover);
    accessible-role: button;
    accessible-label: root.item.title;
    accessible-action-default => { root.clicked(); }
    animate background { duration: Theme.t-hover; easing: Curves.ease-hover; }
    PageIntent {
        hovered: ta.has-hover;
        pressed: ta.pressed;
        pointer-x: ta.mouse-x;
        pointer-y: ta.mouse-y;
        kind: root.item.kind;
        id: root.item.id;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Cover {
        x: 8px;
        y: (parent.height - self.height) / 2;
        width: Theme.row-cover;
        height: Theme.row-cover;
        radius: Theme.r-s;
        round: root.item.round;
        source: root.item.cover;
    }
    VerticalLayout {
        x: 8px + Theme.row-cover + 12px;
        width: parent.width - self.x - 8px;
        alignment: center;
        spacing: 1px;
        Body {
            text: root.item.title;
            font-weight: 600;
        }
        Body {
            text: root.item.subtitle;
            font-size: Theme.t-meta;
            color: Theme.text2;
        }
    }
}

// "Pick up where you left off": one card as wide as the shelf row under it (`HomeTop`), so it
// stops where Home's shelves stop instead of running the full width. The 152 px cover, then
// the song on one column: the title and artist on short lines (no separators), the progress
// line with its times across the column, and Pause or Resume and Go to album at the cover's
// foot. A hairline, then what's next in the queue as a column of rows under a plain label.
// The card ends with the shelf row, so the two columns can't drift apart as the window
// grows. A card too narrow for both (the Up next panel open) drops the queue's: the song's
// column keeps the room its buttons need.
export component ResumeCard inherits Rectangle {
    property <length> pad: Theme.hero-pad;
    property <length> cover: Theme.hero-cover;
    property <length> text-x: root.pad + root.cover + Theme.s5;
    // The room the song's column needs beside the queue: the buttons, and a title's worth.
    property <length> song-min-w: max(260px, buttons.preferred-width);
    // The narrowest card that keeps the queue's column (its rows at their narrowest), so a
    // short row of shortcuts doesn't hide the queue (`HomeTop`).
    out property <length> queue-min-w: root.text-x + root.song-min-w + 2 * Theme.s5 + 1px + 260px - 16px + root.pad;
    // The queue's rows, their 8 px insets included: about a third of the card.
    property <length> rows-w: clamp(floor(root.width * 0.3 / 1px) * 1px, 260px, 320px);
    // The rows' hover tiles reach 8 px past the column on both sides, as Quick picks' do.
    property <length> rows-x: root.width - root.pad + 8px - root.rows-w;
    // The hairline, a gap left of the rows' covers.
    property <length> rule-x: root.rows-x + 8px - Theme.s5 - 1px;
    // The song's column beside the queue, while that leaves it its room.
    property <length> with-queue-w: root.rule-x - Theme.s5 - root.text-x;
    property <bool> has-queue: root.with-queue-w >= root.song-min-w;
    property <length> text-w: root.has-queue ? root.with-queue-w : root.width - root.text-x - root.pad;
    height: root.cover + 2 * root.pad;
    border-radius: Theme.r-l;
    background: Theme.card;
    border-width: 1px;
    border-color: Theme.card-edge;

    Cover {
        x: root.pad;
        y: root.pad;
        width: root.cover;
        height: root.cover;
        crossfade: true;
        source: HomeData.hero-cover;
    }

    Rectangle {
        x: root.text-x;
        y: root.pad;
        width: root.text-w;
        height: root.cover;
        Display {
            x: 0;
            y: 0;
            width: parent.width;
            height: 36px;
            text: Player.title;
            font-size: Theme.t-display-m;
            vertical-alignment: center;
        }
        Body {
            x: 0;
            y: 38px;
            width: parent.width;
            height: 20px;
            text: Player.artist;
            font-size: Theme.t-body-l;
            color: Theme.text2;
            vertical-alignment: center;
        }
        // Across the column, a line's gap over the buttons. The elapsed time is as wide as the
        // length, so the line doesn't shift as it ticks.
        if Player.duration-s > 0: HorizontalLayout {
            x: 0;
            y: parent.height - 40px - Theme.s4 - self.height;
            width: parent.width;
            height: 16px;
            spacing: Theme.s3;
            Body {
                width: total.preferred-width;
                text: Player.elapsed;
                font-size: Theme.t-meta;
                color: Theme.text2;
                vertical-alignment: center;
                overflow: clip;
            }
            Rectangle {
                horizontal-stretch: 1;
                accessible-role: progress-indicator;
                accessible-label: @tr("{0} of {1}", Player.elapsed, Player.total);
                ProgressRail {
                    y: (parent.height - self.height) / 2;
                    width: parent.width;
                    progress: Player.position-s / Player.duration-s;
                }
            }
            total := Body {
                text: Player.total;
                font-size: Theme.t-meta;
                color: Theme.text2;
                vertical-alignment: center;
            }
        }
        buttons := HorizontalLayout {
            x: 0;
            y: parent.height - self.height;
            width: self.preferred-width;
            height: 40px;
            spacing: Theme.s2;
            Pill {
                label: Player.playing ? @tr("Pause") : @tr("Resume");
                // As wide as the wider label, so Go to album doesn't shift as it toggles.
                alt-label: Player.playing ? @tr("Resume") : @tr("Pause");
                icon: Player.playing ? Icons.pause : Icons.play;
                solid: true;
                clicked => { HomeData.resume-clicked(); }
            }
            if Player.album-id != "": Pill {
                label: @tr("Go to album");
                clicked => { Nav.open-album(Player.album-id); }
            }
        }
    }

    if root.has-queue: Rectangle {
        x: root.rule-x;
        y: root.pad;
        width: 1px;
        height: root.cover;
        background: Theme.hairline;
    }
    // The label, then the rows from the top (`home.rs::HERO_NEXT`, three at most; two or one when
    // the queue holds fewer), over the cover's height and 4 px past it at both ends.
    if root.has-queue: Rectangle {
        x: root.rows-x;
        y: root.pad - 4px;
        width: root.rows-w;
        height: root.cover + 8px;
        Body {
            x: 8px;
            y: -4px;
            width: parent.width - 16px;
            height: 20px;
            text: @tr("Next in queue");
            font-weight: 600;
            color: Theme.text2;
            vertical-alignment: center;
        }
        if HomeData.next.length == 0: Body {
            x: 8px;
            y: 24px;
            width: parent.width - 16px;
            height: 20px;
            text: @tr("Nothing after this one");
            color: Theme.text3;
            vertical-alignment: center;
        }
        for t[i] in HomeData.next: SongRow {
            x: 0;
            y: parent.height - 3 * Theme.track-row-h + i * Theme.track-row-h;
            width: parent.width;
            height: Theme.track-row-h;
            track: t;
            menu: true;
            show-duration: false;
            double-clicked => { HomeData.play-next(i); }
            play => { HomeData.play-next(i); }
            menu-requested(x, y, top) => { SongMenu.show(t, x, y, top); }
        }
    }
}

// "Start listening" on a fresh start: a 152 px cover, the pick on short lines, Play and Go to
// it; on the right, more from its shelf as a 2 x 2 grid of rows under a plain column heading.
// The pick's column takes what it needs, up to 520 px, and the rows take the rest, so on a
// wide window the two halves stay together instead of drifting to the card's ends. A card
// too narrow for the rows (the Up next panel open at 1280) drops them.
export component FeaturedCard inherits Rectangle {
    property <length> pad: Theme.hero-pad;
    property <length> cover: Theme.hero-cover;
    property <length> text-x: root.pad + root.cover + Theme.s5;
    // The room right of the cover, for the text, the gap and the rows.
    property <length> avail: root.width - root.text-x - root.pad;
    property <bool> has-list: root.avail >= 300px + Theme.s5 + 260px;
    property <length> text-w: root.has-list ? max(300px, min(520px, root.avail - Theme.s5 - 428px)) : root.avail;
    property <length> list-w: root.avail - root.text-w - Theme.s5;
    property <int> cols: root.list-w >= 420px ? 2 : 1;
    property <length> col-w: floor((root.list-w - (root.cols - 1) * Theme.s2) / root.cols / 1px) * 1px;
    height: root.cover + 2 * root.pad;
    border-radius: Theme.r-l;
    background: Theme.card;
    border-width: 1px;
    border-color: Theme.card-edge;

    Cover {
        x: root.pad;
        y: root.pad;
        width: root.cover;
        height: root.cover;
        crossfade: true;
        round: HomeData.featured.round;
        source: HomeData.hero-cover;
    }

    Rectangle {
        x: root.text-x;
        y: root.pad;
        width: root.text-w;
        height: root.cover;
        Display {
            x: 0;
            y: 0;
            width: parent.width;
            height: 36px;
            text: HomeData.featured.title;
            font-size: Theme.t-display-m;
            vertical-alignment: center;
        }
        Body {
            x: 0;
            y: 38px;
            width: parent.width;
            height: 20px;
            text: HomeData.featured.subtitle;
            font-size: Theme.t-body-l;
            color: Theme.text2;
            vertical-alignment: center;
        }
        HorizontalLayout {
            x: 0;
            y: parent.height - self.height;
            height: 40px;
            alignment: start;
            spacing: Theme.s2;
            Pill {
                label: @tr("Play");
                icon: Icons.play;
                solid: true;
                clicked => { HomeData.play-featured(); }
            }
            if HomeData.featured.kind != ItemKind.song: Pill {
                label: HomeData.featured.kind == ItemKind.artist ? @tr("Go to artist") : (HomeData.featured.kind == ItemKind.album ? @tr("Go to album") : @tr("Open playlist"));
                clicked => { HomeData.open-featured(-1); }
            }
        }
    }

    if root.has-list: Rectangle {
        x: root.width - root.list-w - root.pad;
        y: root.pad;
        width: root.list-w;
        height: root.cover;
        Body {
            x: 8px;
            y: 0;
            width: parent.width - 16px;
            height: 24px;
            text: HomeData.featured-from;
            font-weight: 600;
            vertical-alignment: center;
        }
        for it[i] in HomeData.featured-more: ItemRow {
            x: mod(i, root.cols) * (root.col-w + Theme.s2);
            y: parent.height - 2 * Theme.row-h + floor(i / root.cols) * Theme.row-h;
            width: root.col-w;
            item: it;
            visible: i < 2 * root.cols;
            clicked => { HomeData.open-featured(i); }
        }
    }
}
