// Home's band (`Band`): the session in its cover's colour at the top of the page. Resuming:
// "Pick up where you left off · <source>", the song, Resume and where it was paused; playing:
// "Now playing · <source>" and Open <source>; on a fresh start: a featured pick from the first
// shelf with Play. The same four round actions on the song in every state (Like, Add to
// playlist, Start radio, Go to artist), then on the right what's next in the queue (or more
// from the pick's shelf). `HomeTop` (home.slint) places it.
//
// The band takes its colours from `BandInk`: in the dark theme the lyrics panel's deep ink with
// white text, in the light one a light tint of the cover's hue with dark text and dark buttons
// (`colour::band_light`). Resuming they follow the current cover; a featured pick has its own.
import { Theme, Curves, Icons } from "../../theme.slint";
import { CardItem, ItemKind, TrackRow, Body, Display, Cover, Icon } from "../../parts.slint";
import { Nav, Frame } from "../../nav.slint";
import { Player } from "../../player.slint";
import { SongMenu } from "../../song_menu.slint";
import { QueueData } from "../../queue_panel.slint";
import { BarTip } from "../../bar_tip.slint";
import { LyricsData, LyricInk } from "../lyrics.slint";
import { NowPlayingData } from "../now_playing.slint";
import { HomeData } from "data.slint";

// The band's colours. Dark theme: the lyrics panel's deep ink (`LyricsData.ink-dark`), white
// text and white overlays. Light theme: a light tint of the cover's hue (`session-ink-light`,
// or the pick's), dark text tinted from the hue and dark overlays, the solid pill black as the
// light theme's is. `text2` is the second level (the ink's `next`), AA on the band and on a
// hovered row in both.
global BandInk {
    out property <LyricInk> dark: HomeData.resume ? LyricsData.ink-dark : HomeData.featured-ink-dark;
    out property <LyricInk> light: HomeData.resume ? HomeData.session-ink-light : HomeData.featured-ink-light;
    out property <color> ground: Theme.pick(self.dark.ground, self.light.ground);
    out property <color> text: Theme.pick(#FFFFFF, self.light.current);
    out property <color> text2: Theme.pick(self.dark.next, self.light.next);
    out property <color> rule: Theme.pick(#FFFFFF26, #0000001F);
    // A round action: at rest, hovered, pressed, unavailable.
    public pure function round(down: bool, over: bool, enabled: bool) -> color {
        return !enabled ? Theme.pick(#FFFFFF14, #0000000A) : (down ? Theme.pick(#FFFFFF4D, #0000002E) : (over ? Theme.pick(#FFFFFF40, #00000021) : Theme.pick(#FFFFFF26, #00000012)));
    }
    // The solid pill (Resume, Play): white on the deep band, black on the light one.
    public pure function solid(down: bool, over: bool) -> color {
        return Theme.pick(down ? Theme.panel-solid-pressed : (over ? Theme.panel-solid-hover : Theme.panel-solid), down ? #474747 : (over ? #2E2E2E : #0F0F0F));
    }
    out property <color> on-solid: Theme.pick(#0F0F0F, #FFFFFF);
    // The tonal pill (Open <source>).
    public pure function tonal(down: bool, over: bool) -> color {
        return down ? Theme.pick(#FFFFFF4D, #00000033) : (over ? Theme.pick(#FFFFFF40, #00000026) : Theme.pick(#FFFFFF2E, #00000017));
    }
    // A row hovered or pressed.
    public pure function row(down: bool, over: bool) -> color {
        return down ? Theme.pick(Theme.panel-pressed, #0000002B) : (over ? Theme.pick(Theme.panel-hover, #00000012) : transparent);
    }
}

// The band's sizes.
export global BandSizes {
    out property <length> height: 224px;
    out property <length> pad: 24px;
    out property <length> cover: 176px;
    // The text column's left edge: the padding, the cover, a 28 px gap.
    out property <length> text-x: 228px;
    // The text column beside Up next: 456 px (the divider at 708, the column from 732) until
    // the queue is `col-max` wide, then whatever the queue leaves; it gives up to 126 px to a
    // narrow band before the queue goes (the row then drops "Paused at").
    out property <length> text-max: 456px;
    out property <length> text-min: 330px;
    // The queue shows down to this wide (its titles and artists elide, the lengths go below
    // `row-full`): narrower, the "Up next · N" link. A second column joins with six songs next
    // once each can be `col-min`; each is at most `col-max`.
    out property <length> show-min: 220px;
    out property <length> row-full: 280px;
    out property <length> col-min: 400px;
    out property <length> col-max: 520px;
    out property <length> col-gap: 24px;
    out property <length> row-h: 52px;
    // A short queue's rows with "More like this" under them: two headings and three rows in
    // the cover's height, a 4 px gap before the second heading.
    out property <length> row-h-tight: 44px;
    // The four actions: 40 px each, 8 apart.
    out property <length> actions-w: 4 * 40px + 3 * 8px;
    // The narrow band, for a band too narrow for the song beside the cover and its row: in
    // a narrow window (`Frame.sheet`) a 96 px cover with the song beside it, the row under
    // both, 20 px in from the edges; beside the Up next panel in a wider one, as it always
    // was there, a 112 px cover and the band's usual height and padding.
    out property <length> narrow-h: Frame.sheet ? 192px : self.height;
    out property <length> narrow-pad: Frame.sheet ? 20px : self.pad;
    out property <length> narrow-cover: Frame.sheet ? 96px : 112px;
    public pure function narrow(w: length) -> bool {
        return w < self.text-x + self.pad + 340px;
    }
    public pure function height-for(w: length) -> length {
        return BandSizes.narrow(w) ? self.narrow-h : self.height;
    }
    // "Up next · N" needs this much band beside "Pick up where you left off": narrower (a
    // window under about 560 px), the bar's Up next button is the way to the queue.
    out property <length> link-min: 520px;
}

// A pill on the band: solid white (Resume, Play) or tonal (Open <source>). Its label elides
// past `max-w`.
component BandPill inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> solid;
    in property <length> max-w: 10000px;
    // Its width with the whole label.
    out property <length> natural: (root.icon != "" ? 16px + 18px + 8px : 20px) + lab.preferred-width + 20px;
    callback clicked();
    width: min(root.max-w, root.natural);
    height: 40px;
    border-radius: 20px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    Rectangle {
        border-radius: root.border-radius;
        background: root.solid ? BandInk.solid(ta.pressed, ta.has-hover) : BandInk.tonal(ta.pressed, ta.has-hover);
        animate background { duration: Theme.t-hover; }
        transform-scale: ta.pressed ? Theme.press-scale : 1.0;
        animate transform-scale {
            duration: ta.pressed ? Theme.t-press : Theme.t-release;
            easing: ta.pressed ? Curves.ease-out : Curves.release;
        }
        ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.clicked(); }
        }
        if root.icon != "": Icon {
            x: 16px;
            y: (parent.height - self.height) / 2;
            width: 18px;
            height: 18px;
            commands: root.icon;
            fill: root.solid ? BandInk.on-solid : BandInk.text;
            stroke: transparent;
        }
        lab := Body {
            x: root.icon != "" ? 42px : 20px;
            width: root.width - self.x - 20px;
            height: root.height;
            text: root.label;
            font-weight: 600;
            color: root.solid ? BandInk.on-solid : BandInk.text;
            vertical-alignment: center;
        }
    }
}

// A round action on the band, named in the bar's tooltip.
component BandButton inherits Rectangle {
    in property <string> icon;
    in property <bool> filled;
    in property <string> name;
    in property <bool> enabled: true;
    callback clicked();
    width: 40px;
    height: 40px;
    border-radius: 20px;
    background: BandInk.round(ta.pressed, ta.has-hover, root.enabled);
    animate background { duration: Theme.t-hover; }
    accessible-role: button;
    accessible-label: root.name;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.clicked(); }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            tip.dismiss();
            root.clicked();
        }
    }
    Icon {
        width: 20px;
        height: 20px;
        commands: root.icon;
        stroke: root.filled ? transparent : BandInk.text.transparentize(root.enabled ? 0 : 0.6);
        fill: root.filled ? BandInk.text : transparent;
    }
    tip := BarTip {
        over: ta.has-hover && root.enabled;
        name: root.name;
    }
}

// A song (or a pick) in the band's right column: its cover, title and second line, and the
// length at the end; a click plays it, a right-click opens the song menu.
component BandRow inherits Rectangle {
    in property <image> cover;
    in property <bool> round;
    in property <string> title;
    in property <string> subtitle;
    in property <string> duration;
    in property <color> ink2;
    callback clicked();
    // Right-click: the menu at this point (window coordinates).
    callback menu(length, length);
    height: BandSizes.row-h;
    border-radius: Theme.r-m;
    background: BandInk.row(ta.pressed, ta.has-hover);
    animate background { duration: Theme.t-hover; easing: Curves.ease-hover; }
    accessible-role: button;
    accessible-label: root.title + ", " + root.subtitle;
    accessible-action-default => { root.clicked(); }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        pointer-event(e) => {
            if e.button == PointerEventButton.right && e.kind == PointerEventKind.up {
                root.menu(root.absolute-position.x + self.mouse-x, root.absolute-position.y + self.mouse-y);
            }
        }
    }
    Cover {
        x: 8px;
        y: (parent.height - self.height) / 2;
        width: 40px;
        height: 40px;
        radius: Theme.r-s;
        round: root.round;
        source: root.cover;
    }
    VerticalLayout {
        x: 60px;
        width: parent.width - self.x - (root.duration != "" ? dur.preferred-width + 20px : 8px);
        alignment: center;
        spacing: 1px;
        Body {
            text: root.title;
            font-weight: 600;
            color: BandInk.text;
        }
        Body {
            text: root.subtitle;
            font-size: Theme.t-meta;
            color: root.ink2;
        }
    }
    dur := Body {
        x: parent.width - self.width - 8px;
        width: self.preferred-width;
        height: parent.height;
        visible: root.duration != "";
        text: root.duration;
        font-size: Theme.t-meta;
        color: root.ink2;
        vertical-alignment: center;
    }
}

// Underlined white text that does something ("Show all 12", "Up next · 12 ›", the source).
component BandLink inherits Rectangle {
    in property <string> text;
    in property <bool> chevron;
    in property <bool> underline: true;
    in property <bool> enabled: true;
    callback clicked();
    // Its width with the whole text.
    out property <length> natural: t.preferred-width + (root.chevron ? 18px : 0px);
    width: root.natural;
    height: 20px;
    accessible-role: button;
    accessible-enabled: root.enabled;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    t := Body {
        x: 0;
        width: min(self.preferred-width, root.width - (root.chevron ? 18px : 0px));
        height: root.height;
        text: root.text;
        font-weight: 600;
        color: BandInk.text;
        vertical-alignment: center;
    }
    if root.underline || ta.has-hover: Rectangle {
        x: 0;
        y: 18px;
        width: t.width;
        height: 1px;
        background: BandInk.text;
    }
    if root.chevron: Icon {
        x: t.width + 2px;
        y: 2px;
        width: 16px;
        height: 16px;
        commands: Icons.chevron-right;
        stroke: BandInk.text;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }
}

// The band. Its right column (Up next, or more from the pick's shelf) shows once the song's
// column (`text-min` to `text-max`) and `show-min` of queue fit beside the cover, the Up next
// panel open or not: it's the same queue the panel shows. The queue narrows first, then the
// song's column. Narrower, resuming, "Up next · N ›" at the top right opens the panel (nothing
// while the panel is open, which shows the queue). Three songs a column; a second column with
// six or more next, when each can be `col-min` beside `text-max` of song, never a third nor a
// part-filled one. Past `col-max` a column, the room goes to the song's side. A queue shorter
// than a column is filled with "More like this" under its own heading (`HomeData.related`);
// with nothing next and nothing related the song takes the band's width.
export component Band inherits Rectangle {
    property <bool> resume: HomeData.resume;
    property <bool> playing: root.resume && Player.playing;
    property <bool> song: root.resume || HomeData.featured.kind == ItemKind.song;
    property <color> ink-ground: BandInk.ground;
    property <color> ink2: BandInk.text2;
    // Too narrow for the song beside the cover and its row (a narrow window, or the Up next
    // panel open beside one): the narrow band, the cover smaller, the title a size down (two
    // below a 488 px band), the row under them both.
    property <bool> compact: BandSizes.narrow(root.width);
    // The narrow band proper, in a narrow window (`BandSizes.narrow-*`): its title steps down
    // again in a band under 488 px, and its meta line a size.
    property <bool> slim: root.compact && Frame.sheet;
    property <bool> tight: root.slim && root.width < 488px;
    property <length> pad: root.compact ? BandSizes.narrow-pad : BandSizes.pad;
    property <int> queued: QueueData.upcoming.length;
    property <int> rows-n: root.resume ? HomeData.next.length : HomeData.featured-more.length;
    // "More like this" under a short queue (resuming only; `hero.rs` fills it then).
    property <int> more-n: root.resume ? HomeData.related.length : 0;
    // The song's column and the queue share this, less the gaps around the divider and the
    // right padding.
    property <length> room: root.width - BandSizes.text-x - 3 * root.pad;
    // Two columns with six songs next, when each gets `col-min` beside `text-max` of song.
    property <int> cols: root.resume && root.rows-n >= 6 && root.room - BandSizes.text-max >= 2 * BandSizes.col-min + BandSizes.col-gap ? 2 : 1;
    property <length> col-w: root.cols == 2 ? min(BandSizes.col-max, floor((root.room - BandSizes.text-max - BandSizes.col-gap) / 2 / 1px) * 1px) : max(BandSizes.show-min, min(BandSizes.col-max, root.room - BandSizes.text-max));
    property <length> cols-w: root.cols * root.col-w + (root.cols - 1) * BandSizes.col-gap;
    // Beside the queue: the song's column, what the queue leaves (`text-max` at least, until
    // the queue is down to `show-min`); the divider a gap after it, the queue a gap after that.
    property <length> beside-w: root.room - root.cols-w;
    property <bool> wide: root.beside-w >= BandSizes.text-min;
    property <bool> column: root.wide && root.rows-n + root.more-n > 0;
    property <bool> link: root.resume && !root.column && !Frame.queue-open && root.queued > 0 && root.width >= BandSizes.link-min;
    property <length> rule-x: BandSizes.text-x + root.beside-w + root.pad;
    property <length> next-x: root.rule-x + root.pad;
    property <int> shown: min(root.rows-n, 3 * root.cols);
    // A short queue over "More like this": both in the cover's height, so tighter rows.
    property <bool> mixed: root.rows-n > 0 && root.more-n > 0;
    property <length> row-h: root.mixed ? BandSizes.row-h-tight : BandSizes.row-h;
    // "More like this": under the queue's rows and a 4 px gap, or at the top without a queue.
    property <length> more-y: root.rows-n > 0 ? 20px + root.rows-n * root.row-h + 4px : 0px;
    property <length> cover: root.compact ? BandSizes.narrow-cover : BandSizes.cover;
    property <length> text-x: root.compact ? root.pad + root.cover + Theme.s4 + (root.slim ? 0px : Theme.s1) : BandSizes.text-x;
    // The title's line: the display face at 40, 32 in the narrow band, 24 in a tight one.
    property <length> title-h: root.compact ? (root.tight ? 32px : 40px) : 48px;
    property <length> text-w: root.column ? root.beside-w : root.width - root.pad - root.text-x;
    property <bool> liked: root.resume ? Player.liked : HomeData.track.liked;
    property <string> source: root.resume ? QueueData.playing-from : HomeData.featured-shelf;
    height: root.compact ? BandSizes.narrow-h : BandSizes.height;
    border-radius: Theme.r-l;
    background: root.ink-ground;
    animate background { duration: Theme.t-colour; easing: Curves.ease-hover; }

    // The cover, its shadow under it.
    Rectangle {
        x: root.pad;
        y: root.pad;
        width: root.cover;
        height: root.cover;
        border-radius: Theme.r-m;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 10px;
        drop-shadow-color: #00000059;
        background: Theme.cover-empty;
        Cover {
            width: parent.width;
            height: parent.height;
            crossfade: true;
            round: !root.resume && HomeData.featured.round;
            source: HomeData.hero-cover;
        }
    }

    Rectangle {
        x: root.text-x;
        y: root.pad;
        width: root.text-w;
        height: root.cover;
        // "Pick up where you left off · Daily mix": the source a link to it (the pick's shelf
        // isn't one). Clear of the Up next link at the band's top right.
        Rectangle {
            property <length> room: parent.width - (root.link ? up-link.width + Theme.s4 : 0px);
            x: 0;
            y: 0;
            width: self.room;
            height: 20px;
            lead := Body {
                x: 0;
                width: min(self.preferred-width, parent.room);
                height: parent.height;
                text: !root.resume ? @tr("Start listening · from") + " " : (root.playing ? @tr("Now playing") : @tr("Pick up where you left off")) + (root.source != "" ? " · " : "");
                font-weight: 600;
                color: root.ink2;
                vertical-alignment: center;
            }
            if root.source != "": BandLink {
                x: lead.width;
                width: min(self.natural, parent.room - lead.width);
                text: root.source;
                underline: false;
                enabled: root.resume;
                clicked => { QueueData.open-source(); }
            }
        }
        Display {
            x: 0;
            y: root.slim ? 26px : 24px;
            width: parent.width;
            height: root.title-h;
            text: root.resume ? Player.title : HomeData.featured.title;
            font-size: root.compact ? (root.tight ? Theme.t-display-s : Theme.t-display-m) : Theme.t-display-l;
            vertical-alignment: center;
            color: BandInk.text;
            accessible-role: text;
        }
        // "Josh Woodward · The Beautiful Machine · 2014": the artist in white.
        Rectangle {
            property <string> artist: root.resume ? Player.artist : (root.song ? HomeData.track.artist : HomeData.featured.subtitle);
            property <string> album: root.resume ? Player.album : (root.song ? HomeData.track.album : "");
            property <string> year: root.resume && Player.album != "" ? NowPlayingData.year : "";
            property <string> rest: (self.album != "" ? " · " + self.album : "") + (self.year != "" ? " · " + self.year : "");
            x: 0;
            y: root.slim ? 26px + root.title-h : (root.compact ? 66px : 74px);
            width: parent.width;
            height: 22px;
            // A size down in the narrow band.
            property <length> size: root.slim ? Theme.t-body : Theme.t-body-l;
            artist := Body {
                x: 0;
                // The album follows right after; it elides first, and goes once the artists
                // need the whole line (which then elides).
                width: min(self.preferred-width, parent.width);
                height: parent.height;
                text: parent.artist;
                font-size: parent.size;
                font-weight: 600;
                color: BandInk.text;
                vertical-alignment: center;
            }
            rest := Body {
                x: artist.width;
                width: max(0px, parent.width - self.x);
                // Not a lone "· …".
                visible: self.width >= 48px;
                height: parent.height;
                text: parent.rest;
                font-size: parent.size;
                color: root.ink2;
                vertical-alignment: center;
            }
        }
        // The row at the cover's foot: the main pill, where it was paused, a hairline, the
        // four actions. "Paused at" goes first when the column is too narrow for it all; then
        // "Open <source>" becomes "Open", and other labels elide.
        act := Rectangle {
            property <bool> has-main: !root.playing || QueueData.playing-from != "";
            property <string> main-label: !root.resume ? @tr("Play") : (root.playing ? @tr("Open {}", QueueData.playing-from) : @tr("Resume"));
            property <length> main-natural: (root.playing ? 20px : 42px) + main-measure.preferred-width + 20px;
            // The least the main pill takes whole ("Open" while playing). In a row too short
            // for it beside everything else (a band about 320 px wide), the hairline goes, then
            // Go to artist (the artist's name above is a link to the same page).
            property <length> main-least: root.playing ? 40px + open-measure.preferred-width : self.main-natural;
            property <bool> rule-shown: self.has-main && root.song && self.main-least + Theme.s4 + 1px + Theme.s4 + BandSizes.actions-w <= self.width;
            property <bool> artist-shown: !self.has-main || self.main-least + Theme.s4 + BandSizes.actions-w <= self.width;
            property <length> fixed: (self.has-main && root.song ? (self.rule-shown ? Theme.s4 + 1px + Theme.s4 : Theme.s4) : 0px) + (root.song ? BandSizes.actions-w - (self.artist-shown ? 0px : 40px + Theme.s2) : 0px);
            property <length> paused-w: paused-lead.preferred-width + 4px + paused-time.preferred-width;
            property <bool> paused-shown: root.resume && !root.playing && self.main-natural + Theme.s4 + self.paused-w + self.fixed <= self.width;
            // In the narrow band, under the cover and the song, 16 px below them.
            x: root.compact ? root.pad - root.text-x : 0px;
            y: root.slim ? root.cover + Theme.s4 : BandSizes.cover - 40px;
            width: root.compact ? root.width - 2 * root.pad : parent.width;
            height: 40px;
            // Only measured.
            main-measure := Body {
                visible: false;
                text: act.main-label;
                font-weight: 600;
            }
            open-measure := Body {
                visible: false;
                text: @tr("Open");
                font-weight: 600;
            }
            paused-lead := Body {
                visible: false;
                text: @tr("Paused at");
            }
            paused-time := Body {
                visible: false;
                text: Player.elapsed;
                font-weight: 600;
            }
            HorizontalLayout {
                alignment: start;
                spacing: Theme.s4;
                if act.has-main: BandPill {
                    max-w: act.width - act.fixed;
                    // "Open <source>" too long for the row: just "Open" (the line above
                    // names the source), never a cut-off name.
                    label: root.playing && act.main-natural > act.width - act.fixed ? @tr("Open") : act.main-label;
                    icon: root.playing ? "" : Icons.play;
                    solid: !root.playing;
                    clicked => {
                        if !root.resume {
                            HomeData.play-featured();
                        } else if root.playing {
                            QueueData.open-source();
                        } else {
                            HomeData.resume-clicked();
                        }
                    }
                }
                if act.paused-shown: HorizontalLayout {
                    spacing: 4px;
                    Body {
                        text: @tr("Paused at");
                        color: root.ink2;
                        vertical-alignment: center;
                    }
                    Body {
                        text: Player.elapsed;
                        font-weight: 600;
                        color: BandInk.text;
                        vertical-alignment: center;
                    }
                }
                // A pick that isn't a song: Go to album, Open playlist or Go to artist.
                if !root.song: BandPill {
                    label: HomeData.featured.kind == ItemKind.artist ? @tr("Go to artist") : (HomeData.featured.kind == ItemKind.album ? @tr("Go to album") : @tr("Open playlist"));
                    clicked => { HomeData.open-featured(-1); }
                }
                if act.rule-shown: Rectangle {
                    width: 1px;
                    Rectangle {
                        y: 8px;
                        height: 24px;
                        background: Theme.pick(#FFFFFF2E, #00000024);
                    }
                }
                if root.song: HorizontalLayout {
                    spacing: Theme.s2;
                    BandButton {
                        icon: Icons.heart;
                        filled: root.liked;
                        name: root.liked ? @tr("Remove like") : @tr("Like");
                        clicked => { SongMenu.like(HomeData.track.id, !root.liked); }
                    }
                    BandButton {
                        icon: Icons.plus;
                        name: @tr("Add to playlist");
                        clicked => {
                            SongMenu.show(HomeData.track, self.absolute-position.x, self.absolute-position.y + self.height + Theme.s1, self.absolute-position.y);
                            if SongMenu.signed-in {
                                SongMenu.choosing = true;
                            } else {
                                SongMenu.close();
                                SongMenu.add-signed-out();
                            }
                        }
                    }
                    BandButton {
                        icon: Icons.radio;
                        name: @tr("Start radio");
                        clicked => { SongMenu.start-radio(HomeData.track.id); }
                    }
                    if act.artist-shown: BandButton {
                        icon: Icons.person;
                        name: @tr("Go to artist");
                        enabled: HomeData.track.artist-id != "";
                        clicked => { Nav.open-artist(HomeData.track.artist-id); }
                    }
                }
            }
        }
    }

    up-link := BandLink {
        x: root.width - root.pad - self.width;
        y: root.pad;
        visible: root.link;
        text: @tr("Up next · {}", root.queued);
        chevron: true;
        clicked => { HomeData.show-queue(); }
    }

    if root.column: Rectangle {
        x: root.rule-x;
        y: root.pad;
        width: 1px;
        height: BandSizes.cover;
        background: BandInk.rule;
    }
    // "Up next" and "Show all N" over three rows a column, then "More like this" under a short
    // queue; on a fresh start, "More from Quick picks" over three of them.
    if root.column: Rectangle {
        x: root.next-x;
        y: root.pad;
        width: root.cols-w;
        height: BandSizes.cover;
        if !root.resume || root.rows-n > 0: Body {
            x: 8px;
            y: 0;
            width: parent.width - 16px - (all.visible ? all.width + Theme.s4 : 0px);
            height: 20px;
            text: root.resume ? @tr("Up next") : HomeData.featured-from;
            font-weight: 600;
            color: root.ink2;
            vertical-alignment: center;
        }
        all := BandLink {
            x: parent.width - 8px - self.width;
            y: 0;
            visible: root.resume && root.queued > root.shown;
            text: @tr("Show all {}", root.queued);
            clicked => { HomeData.show-queue(); }
        }
        if root.resume: Rectangle {
            for t[i] in HomeData.next: BandRow {
                x: floor(i / 3) * (root.col-w + BandSizes.col-gap);
                y: 20px + mod(i, 3) * root.row-h;
                width: root.col-w;
                height: root.row-h;
                visible: i < root.shown;
                cover: t.cover;
                title: t.title;
                subtitle: t.artist;
                duration: root.col-w >= BandSizes.row-full ? t.duration : "";
                ink2: root.ink2;
                clicked => { QueueData.play(i); }
                menu(x, y) => { SongMenu.show(t, x, y, y); }
            }
        }
        if root.more-n > 0: Body {
            x: 8px;
            y: root.more-y;
            width: parent.width - 16px;
            height: 20px;
            text: @tr("More like this");
            font-weight: 600;
            color: root.ink2;
            vertical-alignment: center;
        }
        if root.more-n > 0: Rectangle {
            for t[i] in HomeData.related: BandRow {
                x: 0;
                y: root.more-y + 20px + i * root.row-h;
                width: root.col-w;
                height: root.row-h;
                cover: t.cover;
                title: t.title;
                subtitle: t.artist;
                duration: root.col-w >= BandSizes.row-full ? t.duration : "";
                ink2: root.ink2;
                clicked => { HomeData.play-related(i); }
                menu(x, y) => { SongMenu.show(t, x, y, y); }
            }
        }
        if !root.resume: Rectangle {
            for it[i] in HomeData.featured-more: BandRow {
                x: floor(i / 3) * (root.col-w + BandSizes.col-gap);
                y: 20px + mod(i, 3) * BandSizes.row-h;
                width: root.col-w;
                visible: i < root.shown;
                cover: it.cover;
                round: it.round;
                title: it.title;
                subtitle: it.subtitle;
                ink2: root.ink2;
                clicked => { HomeData.open-featured(i); }
            }
        }
    }
}
