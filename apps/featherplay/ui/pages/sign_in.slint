// Sign in: the ways in as rows of one card (house style rule 5), the block centred in the
// page. Sign in with Google, the recommended way, opens the sign-in window (a separate window
// with Google's page; the main window never hosts a webview); Use Microsoft Edge (or Google
// Chrome, Brave, Vivaldi: the row names the browser it opens) opens that browser with a
// temporary profile, or says calmly that it can't work on this PC, with "Why?" for the
// policy; with more than one of them found, "Change" lists them under the row; Paste a
// cookie header opens the paste field under its row. The card ends with what featherplay
// keeps; under it, "Continue without signing in" as a quiet pill. A way that fails says so
// above the card in plain words, with Try again. Linux has no sign-in window: its row is
// hidden and the browser row leads, and "Why?" also tells of a Snap or Flatpak browser.
// Driven by `src/pages/sign_in.rs`.
import { Theme, Icons, Curves } from "../theme.slint";
import { Body, ChoiceList, ChoiceRow, Display, Icon, Pill, TextLink } from "../parts.slint";
import { Logo } from "../logo.slint";
import { Nav, PageKind } from "../nav.slint";

// A way in, for Try again.
export enum SignInWay { none, window, browser, paste }

// Why a browser that's installed can't be used: a policy turns off the connection to it, or
// (Linux) it's a Snap or a Flatpak, whose sandbox keeps the sign-in out.
export enum BrowserBlock { policy, snap, flatpak }

// Where the session is kept: Windows' Credential Manager, the desktop's keyring (Linux's
// Secret Service), or nowhere, for this run only (Linux with no keyring running).
export enum SessionStore { credential-manager, keyring, none }

// A browser the sign-in can open that's installed on this PC, in the list under "Change".
export struct BrowserChoice {
    // As the user knows it: "Google Chrome".
    name: string,
    // In a sentence about it: "Chrome".
    short: string,
    // The sign-in can't use it, because of `block`.
    blocked: bool,
    block: BrowserBlock,
}

export global SignInData {
    // There's a sign-in window (WebView2, Windows only); without it the browser row leads.
    in property <bool> window-way: true;
    // Where the session is kept, for the card's last line.
    in property <SessionStore> session-store;
    // The sign-in window or the browser is open, or a cookie header is being checked.
    in property <bool> busy;
    // The browser sign-in is running (the browser is open, or closing).
    in property <bool> browser-running;
    // The browser the row offers, as the user knows it and as a sentence about it names it
    // (Rust sets Microsoft Edge at startup).
    in property <string> browser-name;
    in property <string> browser-short;
    // A policy on this PC turns off the connection to it, and to every other browser found
    // (or on Linux they're Snaps or Flatpaks): the option can't work, because of
    // `browser-block`.
    in property <bool> browser-blocked;
    in property <BrowserBlock> browser-block;
    // The browsers found, when there are two or more: what "Change" lists. The row offers
    // the one at `browser-current`.
    in property <[BrowserChoice]> browsers;
    in property <int> browser-current;
    // "Change" was pressed: the list is open.
    in-out property <bool> choosing;
    // What's happening, e.g. "Finish signing in in the other window."
    in property <string> status;
    // A way that failed: what happened (`error-title`), what to do (`error`), and the way
    // Try again takes (`none`: no Try again). The technical detail is only in the log.
    in property <string> error-title;
    in property <string> error;
    in property <SignInWay> retry;
    // Why the pasted text can't be used, under the paste field; cleared as it's edited.
    in-out property <string> paste-error;
    // Shown after "Session expired, sign in again".
    in property <bool> expired;
    in-out property <bool> paste-open;
    // "Why?" on a blocked browser: the policy detail is open. In the list, it's about
    // `why-browser` (the browser as a sentence names it), which `why-block` keeps out.
    in-out property <bool> why-open;
    in-out property <string> why-browser;
    in-out property <BrowserBlock> why-block;
    // The pasted header. Rust clears it once it has been taken.
    in-out property <string> cookies;
    callback open-window();
    callback open-browser();
    // Closes the browser and deletes its profile.
    callback cancel-browser();
    // "Change": offer the browser at this index of `browsers` from now on.
    callback pick-browser(int);
    callback submit(string);
}

// A glyph only this page uses, on the same 24 px grid as `Icons`.
global SignInIcons {
    out property <string> check: "M5.5 12.5 L10 17 L18.5 7.5";
}

// Why a browser can't be used: what it means first; then the policy's name for whoever looks
// it up, or (a Snap or a Flatpak, on Linux) what works instead.
component PolicyNote inherits Rectangle {
    // The browser, as a sentence names it: "Edge".
    in property <string> browser;
    in property <BrowserBlock> block;
    min-height: lay.min-height;
    preferred-height: lay.preferred-height;
    lay := VerticalLayout {
        spacing: Theme.s3;
        Body {
            // {} is a browser's name: Edge, Chrome, Chromium, Brave or Vivaldi.
            text: root.block == BrowserBlock.snap ? @tr("This {} is a Snap, whose sandbox keeps out the temporary profile featherplay opens it with, so featherplay can't use it.", root.browser)
                : root.block == BrowserBlock.flatpak ? @tr("This {} is a Flatpak, whose sandbox keeps out the temporary profile and the connection featherplay opens it with, so featherplay can't use it.", root.browser)
                : SignInData.window-way ? @tr("{} on this PC is set to keep apps from reading its sign-in, so featherplay can't use it. Sign in with Google works without it.", root.browser)
                : @tr("{} on this PC is set to keep apps from reading its sign-in, so featherplay can't use it. Pasting a cookie header works without it.", root.browser);
            font-size: Theme.t-meta + 1px;
            color: Theme.text2;
            overflow: clip;
            wrap: word-wrap;
        }
        Body {
            text: root.block == BrowserBlock.policy ? @tr("Set by an administrator or a tweaking tool: the RemoteDebuggingAllowed policy is off.")
                : @tr("One installed from a .deb or .rpm package works, as does pasting a cookie header.");
            font-size: Theme.t-meta;
            color: Theme.text3;
            overflow: clip;
            wrap: word-wrap;
        }
    }
}

// One browser in the list under "Change": its name, and a check on the one the row offers. A
// press offers it instead; Enter or Space does too, once tabbed to. One a policy blocks is dimmed,
// says so under its name, and has "Why?" where the check goes.
component BrowserEntry inherits Rectangle {
    in property <string> name;
    in property <bool> current;
    in property <bool> blocked;
    // Off while the list is shut, so Tab doesn't reach it; `showing` until it has shut.
    in property <bool> enabled: true;
    in property <bool> showing: true;
    // "Why?" is open on this one.
    in property <bool> why-open;
    callback clicked();
    callback why();
    property <bool> can-pick: root.enabled && !root.blocked;
    property <bool> ring;
    // Animated as a private property: a root animating a public one is copied into each use.
    property <brush> ground: root.can-pick ? Theme.state(ta.pressed, ta.has-hover) : transparent;
    animate ground { duration: Theme.t-hover; }
    height: root.blocked ? 52px : 40px;
    // Inside the list's corner, on the same centre.
    border-radius: Theme.r-m - Theme.s1;
    background: root.ground;
    accessible-role: button;
    accessible-label: root.name;
    accessible-description: root.blocked ? @tr("Not available on this PC") : "";
    accessible-enabled: root.can-pick;
    accessible-checkable: true;
    accessible-checked: root.current;
    accessible-action-default => {
        if root.can-pick {
            root.clicked();
        }
    }
    fs := FocusScope {
        enabled: root.can-pick;
        focus-gained(reason) => { root.ring = reason == FocusReason.tab-navigation; }
        focus-lost => { root.ring = false; }
        key-pressed(e) => {
            if e.text == Key.Return || e.text == Key.Space {
                root.clicked();
                return accept;
            }
            reject
        }
    }
    // Above the focus scope, so a click is the touch area's.
    ta := TouchArea {
        enabled: root.can-pick;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    if fs.has-focus && root.ring: Rectangle {
        border-radius: parent.border-radius;
        border-width: 2px;
        border-color: Theme.accent;
    }
    // Above the touch area, so a click on "Why?" is the link's.
    HorizontalLayout {
        padding-left: Theme.s3;
        padding-right: Theme.s3;
        spacing: Theme.s2;
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            horizontal-stretch: 1;
            // Read once, as the entry's label and description.
            Body {
                text: root.name;
                color: Theme.text1.transparentize(root.blocked ? 0.55 : 0);
                accessible-role: none;
            }
            if root.blocked: Body {
                text: @tr("Not available on this PC");
                font-size: Theme.t-meta + 1px;
                color: Theme.text2;
                accessible-role: none;
            }
        }
        if root.current && !root.blocked: VerticalLayout {
            alignment: center;
            Icon {
                width: 18px;
                height: 18px;
                commands: SignInIcons.check;
                stroke: Theme.text1;
            }
        }
        // Gone with the list, so Tab doesn't reach it while the list is shut.
        if root.blocked && root.showing: VerticalLayout {
            alignment: center;
            TextLink {
                text: @tr("Why?");
                font-size: Theme.t-meta + 1px;
                font-weight: 400;
                expands: true;
                expanded: root.why-open;
                clicked => { root.why(); }
            }
        }
    }
}

// The multi-line paste field. Its text is never logged.
component PasteField inherits Rectangle {
    in-out property <string> text;
    in property <bool> enabled: true;
    callback edited();
    height: 112px;
    border-radius: Theme.r-m;
    background: Theme.field;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.hairline;
    clip: true;
    TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
    }
    if input.text == "": Body {
        // Starts just past the text cursor, so the cursor never draws over its first letter.
        x: 12px + input.text-cursor-width + 2px;
        y: 10px;
        width: parent.width - self.x - 12px;
        text: "cookie: SID=…; HSID=…; SAPISID=…";
        color: Theme.text3;
        font-size: Theme.t-meta;
    }
    input := TextInput {
        enabled: root.enabled;
        x: 12px;
        y: 10px;
        width: parent.width - 24px;
        height: parent.height - 20px;
        text <=> root.text;
        single-line: false;
        wrap: char-wrap;
        font-family: "Cascadia Mono";
        font-size: Theme.t-meta;
        color: Theme.text2;
        selection-background-color: Theme.accent;
        selection-foreground-color: Theme.on-solid;
        accessible-label: @tr("Cookie header");
        edited => { root.edited(); }
    }
}

// A quiet note card: the expired session.
component Note inherits Rectangle {
    in property <string> text;
    min-height: lay.min-height;
    preferred-height: lay.preferred-height;
    border-radius: Theme.r-m;
    background: Theme.card;
    border-width: 1px;
    border-color: Theme.card-edge;
    lay := VerticalLayout {
        padding-top: Theme.s3;
        padding-bottom: Theme.s3;
        padding-left: Theme.s4;
        padding-right: Theme.s4;
        Body {
            text: root.text;
            overflow: clip;
            wrap: word-wrap;
        }
    }
}

// A way that failed, as a row (house style rule 2): an alert mark, what happened and what to
// do on the left, Try again on the right.
component Problem inherits Rectangle {
    in property <string> title;
    in property <string> line;
    in property <bool> can-retry;
    callback retry();
    min-height: lay.min-height;
    preferred-height: lay.preferred-height;
    border-radius: Theme.r-l;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.card-edge;
    lay := HorizontalLayout {
        padding: Theme.s4;
        spacing: Theme.s3;
        VerticalLayout {
            alignment: start;
            Icon {
                commands: Icons.alert;
                stroke: Theme.text1;
                accessible-role: none;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Body {
                text: root.title;
                font-weight: 600;
                overflow: clip;
                wrap: word-wrap;
            }
            Body {
                text: root.line;
                font-size: Theme.t-meta + 1px;
                color: Theme.text2;
                overflow: clip;
                wrap: word-wrap;
            }
        }
        // Folded away, not made and dropped (an `if` costs the exe a copy of the pill).
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: root.can-retry ? again.width : 0;
                height: again.height;
                visible: root.can-retry;
                again := Pill {
                    x: 0;
                    y: 0;
                    label: @tr("Try again");
                    clicked => { root.retry(); }
                }
            }
        }
    }
}

export component SignInPage inherits Rectangle {
    property <length> col-w: min(self.width - 2 * Theme.page-pad, 460px);
    // Which way is under way.
    property <bool> paste-busy: SignInData.busy && SignInData.paste-open && !SignInData.browser-running;
    property <bool> window-busy: SignInData.busy && !SignInData.paste-open && !SignInData.browser-running;
    // The block's height with its rows' details shut: the block is centred on it, so a
    // detail opens downwards and the row clicked stays where it was, while there's room.
    property <length> rest-h: col.preferred-height - browser-row.detail-height - paste-row.detail-height;
    // There's a choice of browsers: more than one found, and one of them works.
    property <bool> listing: !SignInData.browser-blocked && SignInData.browsers.length > 1;
    // How far the list's "Why?" note is unfolded under it, 0 to 1, eased.
    property <float> why-shown: root.listing && SignInData.why-open ? 1 : 0;
    animate why-shown {
        duration: Theme.t-expand;
        easing: Curves.ease-out;
    }
    // The room the page shows: its full height (it has no search bar above it), less the
    // floating bar's. The page itself is the width beside the sidebar and Up next.
    property <length> room-h: flick.height - Theme.bar-clear;

    flick := Flickable {
        width: parent.width;
        height: parent.height;
        content-height: max(self.height, col.y + col.preferred-height + Theme.page-end);

        col := VerticalLayout {
            x: (parent.width - root.col-w) / 2;
            // Centred in that room, a touch above the middle (where the eye puts the centre);
            // an open detail lifts it only as far as it takes to keep the block in view.
            y: max(Theme.s5, min((root.room-h - root.rest-h) * 0.45, root.room-h - self.preferred-height - Theme.s5));
            width: root.col-w;
            height: self.preferred-height;

            HorizontalLayout {
                alignment: center;
                Logo {
                    width: 56px;
                    height: 56px;
                }
            }
            VerticalLayout {
                padding-top: Theme.s4;
                Display {
                    text: @tr("Sign in to featherplay");
                    font-size: Theme.t-display-m;
                    horizontal-alignment: center;
                    overflow: clip;
                    wrap: word-wrap;
                }
            }
            VerticalLayout {
                padding-top: Theme.s2;
                Body {
                    text: @tr("Bring your library, playlists and likes. Search, radio and everything else already work without an account.");
                    font-size: Theme.t-body-l - 1px;
                    color: Theme.text2;
                    horizontal-alignment: center;
                    overflow: clip;
                    wrap: word-wrap;
                }
            }
            VerticalLayout {
                padding-top: SignInData.expired ? Theme.s6 : 0;
                Note {
                    height: SignInData.expired ? self.preferred-height : 0;
                    visible: SignInData.expired;
                    text: @tr("Your session expired. Sign in again; the music keeps playing.");
                }
            }
            // Folded away while nothing failed (an `if` would cost the exe a copy of the row).
            VerticalLayout {
                padding-top: SignInData.error-title == "" ? 0 : (SignInData.expired ? Theme.s2 : Theme.s6);
                Problem {
                    height: SignInData.error-title == "" ? 0 : self.preferred-height;
                    visible: SignInData.error-title != "";
                    title: SignInData.error-title;
                    line: SignInData.error;
                    can-retry: SignInData.retry != SignInWay.none && !SignInData.busy;
                    retry => {
                        if SignInData.retry == SignInWay.window {
                            SignInData.open-window();
                        } else if SignInData.retry == SignInWay.browser {
                            SignInData.open-browser();
                        } else if SignInData.retry == SignInWay.paste {
                            SignInData.submit(SignInData.cookies);
                        }
                    }
                }
            }

            VerticalLayout {
                padding-top: SignInData.expired || SignInData.error-title != "" ? Theme.s2 : Theme.s6;
                ChoiceList {
                    // Folded away where there's no sign-in window (Linux), as the notes above.
                    ChoiceRow {
                        height: SignInData.window-way ? self.preferred-height : 0;
                        visible: SignInData.window-way;
                        divider: false;
                        lit: true;
                        icon: Icons.person;
                        title: @tr("Sign in with Google");
                        line: root.window-busy && SignInData.status != "" ? SignInData.status : @tr("On Google's own page, in a featherplay window");
                        enabled: SignInData.window-way && !SignInData.busy;
                        dimmed: SignInData.busy && !root.window-busy;
                        bare: root.window-busy;
                        clicked => { SignInData.open-window(); }
                    }
                    // The user's own browser: Google's sign-in there, with a throwaway profile.
                    // Without the sign-in window it's the first way, and the one recommended.
                    browser-row := ChoiceRow {
                        divider: SignInData.window-way;
                        lit: !SignInData.window-way;
                        icon: Icons.browser;
                        // {} is the browser it opens: Google Chrome, Chromium, Edge, Brave or Vivaldi.
                        title: @tr("Use {}", SignInData.browser-name);
                        line: SignInData.browser-running ? SignInData.status : (SignInData.browser-blocked ? @tr("Not available on this PC") : @tr("In your own browser, with a temporary profile"));
                        enabled: !SignInData.busy && !SignInData.browser-blocked;
                        dimmed: SignInData.browser-blocked || (SignInData.busy && !SignInData.browser-running);
                        // "Change" opens the list of browsers, to sign in with another one.
                        link: SignInData.browser-running ? @tr("Cancel") : (SignInData.browser-blocked ? @tr("Why?") : (root.listing && !SignInData.busy ? @tr("Change") : ""));
                        link-expands: !SignInData.browser-running;
                        expands: SignInData.browser-blocked || root.listing;
                        open: SignInData.browser-blocked ? SignInData.why-open : (root.listing && SignInData.choosing && !SignInData.busy);
                        clicked => { SignInData.open-browser(); }
                        link-clicked => {
                            if SignInData.browser-running {
                                SignInData.cancel-browser();
                            } else if SignInData.browser-blocked {
                                SignInData.why-open = !SignInData.why-open;
                            } else {
                                // The list opens and shuts with its note folded.
                                SignInData.why-open = false;
                                SignInData.choosing = !SignInData.choosing;
                            }
                        }
                        // The row's two details, as one child (so the row's own spacing
                        // stays out of it): the browsers found, under "Change", and why one
                        // can't be used, under "Why?". With no browser that works, the note
                        // is the whole detail; with a choice, it unfolds under the list,
                        // about the blocked browser whose "Why?" was pressed. Made once and
                        // hidden while shut (the row clips them to nothing).
                        VerticalLayout {
                            // The list: rows of one tile on the ground colour.
                            Rectangle {
                                height: root.listing ? entries.preferred-height : 0;
                                visible: browser-row.showing && root.listing;
                                Rectangle {
                                    y: 0;
                                    height: entries.preferred-height;
                                    border-radius: Theme.r-m;
                                    background: Theme.ground;
                                    border-width: 1px;
                                    border-color: Theme.card-edge;
                                    entries := VerticalLayout {
                                        padding: Theme.s1;
                                        for choice[i] in SignInData.browsers: BrowserEntry {
                                            name: choice.name;
                                            blocked: choice.blocked;
                                            current: i == SignInData.browser-current;
                                            // Shut, or hidden behind a blocked row's note: Tab
                                            // doesn't reach it.
                                            enabled: browser-row.open && root.listing;
                                            showing: browser-row.showing && root.listing;
                                            why-open: SignInData.why-open && SignInData.why-browser == choice.short;
                                            clicked => { SignInData.pick-browser(i); }
                                            why => {
                                                if self.why-open {
                                                    SignInData.why-open = false;
                                                } else {
                                                    SignInData.why-browser = choice.short;
                                                    SignInData.why-block = choice.block;
                                                    SignInData.why-open = true;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            Rectangle {
                                clip: true;
                                height: SignInData.browser-blocked ? note.preferred-height : (Theme.s3 + note.preferred-height) * root.why-shown;
                                note := PolicyNote {
                                    y: SignInData.browser-blocked ? 0 : Theme.s3;
                                    height: self.preferred-height;
                                    visible: browser-row.showing && (SignInData.browser-blocked || root.why-shown > 0);
                                    browser: SignInData.browser-blocked ? SignInData.browser-short : SignInData.why-browser;
                                    block: SignInData.browser-blocked ? SignInData.browser-block : SignInData.why-block;
                                }
                            }
                        }
                    }
                    paste-row := ChoiceRow {
                        icon: Icons.clipboard;
                        title: @tr("Paste a cookie header");
                        line: @tr("For advanced users");
                        enabled: !SignInData.busy;
                        dimmed: SignInData.busy && !root.paste-busy;
                        expands: true;
                        open: SignInData.paste-open;
                        clicked => { SignInData.paste-open = !SignInData.paste-open; }
                        Body {
                            visible: paste-row.showing;
                            text: @tr("In a browser signed in to music.youtube.com, press F12, open the Network tab and reload. Click a request named \"browse\" and copy the whole value of its cookie request header.");
                            font-size: Theme.t-meta + 1px;
                            color: Theme.text2;
                            overflow: clip;
                            wrap: word-wrap;
                        }
                        PasteField {
                            visible: paste-row.showing;
                            // Shut, Tab doesn't reach it.
                            enabled: SignInData.paste-open;
                            text <=> SignInData.cookies;
                            edited => { SignInData.paste-error = ""; }
                        }
                        VerticalLayout {
                            spacing: SignInData.paste-error == "" ? 0 : Theme.s3;
                            // Why the text can't be used, in plain words; folded away while
                            // there's nothing to say.
                            Rectangle {
                                height: SignInData.paste-error == "" ? 0 : why.preferred-height;
                                visible: paste-row.showing && SignInData.paste-error != "";
                                why := Body {
                                    y: 0;
                                    height: self.preferred-height;
                                    text: SignInData.paste-error;
                                    font-size: Theme.t-meta + 1px;
                                    font-weight: 600;
                                    overflow: clip;
                                    wrap: word-wrap;
                                }
                            }
                            HorizontalLayout {
                                alignment: start;
                                Pill {
                                    visible: paste-row.showing;
                                    label: root.paste-busy ? @tr("Checking…") : @tr("Sign in with this cookie");
                                    solid: true;
                                    enabled: !SignInData.busy && SignInData.cookies != "";
                                    clicked => { SignInData.submit(SignInData.cookies); }
                                }
                            }
                        }
                    }
                    // What featherplay keeps, said once for every way in.
                    Rectangle {
                        min-height: keeps.min-height;
                        preferred-height: keeps.preferred-height;
                        Rectangle {
                            y: 0;
                            height: 1px;
                            background: Theme.hairline;
                        }
                        keeps := HorizontalLayout {
                            padding-left: Theme.s4;
                            padding-right: Theme.s4;
                            padding-top: Theme.s3;
                            padding-bottom: Theme.s3;
                            spacing: Theme.s2;
                            VerticalLayout {
                                alignment: start;
                                padding-top: 1px;
                                Icon {
                                    width: 16px;
                                    height: 16px;
                                    commands: Icons.lock;
                                    stroke: Theme.text3;
                                }
                            }
                            Body {
                                text: SignInData.session-store == SessionStore.credential-manager ? @tr("featherplay never sees your password. It keeps only the session, in Windows Credential Manager, and you can sign out any time.")
                                    : SignInData.session-store == SessionStore.keyring ? @tr("featherplay never sees your password. It keeps only the session, in your keyring, and you can sign out any time.")
                                    : @tr("featherplay never sees your password. No keyring is running to keep the session, so it lasts until featherplay closes.");
                                font-size: Theme.t-meta;
                                color: Theme.text3;
                                overflow: clip;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
            // The other way on: listening without an account, a quiet pill under the card.
            HorizontalLayout {
                padding-top: Theme.s5;
                alignment: center;
                Pill {
                    label: @tr("Continue without signing in");
                    clicked => { Nav.go(PageKind.home); }
                }
            }
        }
    }
}
