// Sign in: the ways in as rows of one card (house style rule 5). Sign in with Google, the
// recommended way, opens the sign-in window (a separate window with Google's page; the main
// window never hosts a webview); Use Microsoft Edge opens Edge with a temporary profile, or
// says calmly that it can't work on this PC, with "Why?" for the policy; Paste a cookie
// header opens the paste field under its row. Under the card, what featherplay keeps, and
// "Continue without signing in". Driven by `src/pages/sign_in.rs`.
import { Theme, Icons } from "../theme.slint";
import { Body, ChoiceList, ChoiceRow, Display, Icon, Pill, TextLink } from "../parts.slint";
import { Nav, PageKind } from "../nav.slint";

export global SignInData {
    // The sign-in window or Edge is open, or a cookie header is being checked.
    in property <bool> busy;
    // The Edge sign-in is running (Edge is open, or closing).
    in property <bool> edge;
    // A policy on this PC turns off the connection to Edge: the option can't work.
    in property <bool> edge-blocked;
    // What's happening, e.g. "Finish signing in in the other window."
    in property <string> status;
    in property <string> error;
    // Shown after "Session expired, sign in again".
    in property <bool> expired;
    in-out property <bool> paste-open;
    // "Why?" under a blocked Edge: the policy detail is open.
    in-out property <bool> why-open;
    // The pasted header. Rust clears it once it has been taken.
    in-out property <string> cookies;
    callback open-window();
    callback open-edge();
    // Closes Edge and deletes its profile.
    callback cancel-edge();
    callback submit(string);
}

// The multi-line paste field. Its text is never logged.
component PasteField inherits Rectangle {
    in-out property <string> text;
    height: 112px;
    border-radius: Theme.r-m;
    background: Theme.field;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.hairline;
    clip: true;
    TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
    }
    if input.text == "": Body {
        // Starts just past the text cursor, so the cursor never draws over its first letter.
        x: 12px + input.text-cursor-width + 2px;
        y: 10px;
        width: parent.width - self.x - 12px;
        text: "cookie: SID=…; HSID=…; SAPISID=…";
        color: Theme.text3;
        font-size: Theme.t-meta;
    }
    input := TextInput {
        x: 12px;
        y: 10px;
        width: parent.width - 24px;
        height: parent.height - 20px;
        text <=> root.text;
        single-line: false;
        wrap: char-wrap;
        font-family: "Cascadia Mono";
        font-size: Theme.t-meta;
        color: Theme.text2;
        selection-background-color: Theme.accent;
        selection-foreground-color: Theme.on-solid;
        accessible-label: @tr("Cookie header");
    }
}

// A quiet note card: the expired session, an error.
component Note inherits Rectangle {
    in property <string> text;
    min-height: lay.min-height;
    preferred-height: lay.preferred-height;
    border-radius: Theme.r-m;
    background: Theme.card;
    border-width: 1px;
    border-color: Theme.card-edge;
    lay := VerticalLayout {
        padding-top: Theme.s3;
        padding-bottom: Theme.s3;
        padding-left: Theme.s4;
        padding-right: Theme.s4;
        Body {
            text: root.text;
            overflow: clip;
            wrap: word-wrap;
        }
    }
}

export component SignInPage inherits Rectangle {
    property <length> col-w: min(self.width - 2 * Theme.page-pad, 440px);
    // Which way is under way.
    property <bool> paste-busy: SignInData.busy && SignInData.paste-open && !SignInData.edge;
    property <bool> window-busy: SignInData.busy && !SignInData.paste-open && !SignInData.edge;

    flick := Flickable {
        width: parent.width;
        height: parent.height;
        content-height: max(self.height, col.preferred-height + Theme.s8 + Theme.page-end);

        col := VerticalLayout {
            x: (parent.width - root.col-w) / 2;
            // Centred in the room above the floating bar.
            y: max(Theme.s8, (flick.height - Theme.bar-clear - self.preferred-height) / 2 - Theme.s5);
            width: root.col-w;
            height: self.preferred-height;

            Image {
                width: 48px;
                height: 48px;
                source: Theme.logo;
                accessible-role: none;
            }
            Display {
                text: @tr("Sign in to featherplay");
                font-size: Theme.t-display-m;
                height: 60px;
                vertical-alignment: bottom;
                overflow: clip;
                wrap: word-wrap;
            }
            VerticalLayout {
                padding-top: Theme.s2;
                Body {
                    text: @tr("Bring your library, playlists and likes. Search, radio and everything else already work without an account.");
                    font-size: Theme.t-body-l - 1px;
                    color: Theme.text2;
                    overflow: clip;
                    wrap: word-wrap;
                }
            }
            if SignInData.expired: VerticalLayout {
                padding-top: Theme.s5;
                Note {
                    text: @tr("Your session expired. Sign in again; the music keeps playing.");
                }
            }
            if SignInData.error != "": VerticalLayout {
                padding-top: SignInData.expired ? Theme.s2 : Theme.s5;
                Note {
                    text: SignInData.error;
                }
            }

            VerticalLayout {
                padding-top: Theme.s6 - Theme.s1;
                ChoiceList {
                    ChoiceRow {
                        divider: false;
                        lit: true;
                        icon: Icons.person;
                        title: @tr("Sign in with Google");
                        line: root.window-busy && SignInData.status != "" ? SignInData.status : @tr("On Google's own page, in a featherplay window");
                        enabled: !SignInData.busy;
                        dimmed: SignInData.busy && !root.window-busy;
                        bare: root.window-busy;
                        clicked => { SignInData.open-window(); }
                    }
                    // Edge: Google's sign-in in the user's own browser, with a throwaway profile.
                    ChoiceRow {
                        icon: Icons.browser;
                        title: @tr("Use Microsoft Edge");
                        line: SignInData.edge ? SignInData.status : (SignInData.edge-blocked ? @tr("Not available on this PC") : @tr("In your own browser, with a temporary profile"));
                        enabled: !SignInData.busy && !SignInData.edge-blocked;
                        dimmed: SignInData.edge-blocked || (SignInData.busy && !SignInData.edge);
                        link: SignInData.edge ? @tr("Cancel") : (SignInData.edge-blocked ? @tr("Why?") : "");
                        link-expands: SignInData.edge-blocked && !SignInData.edge;
                        expands: SignInData.edge-blocked;
                        open: SignInData.edge-blocked && SignInData.why-open;
                        clicked => { SignInData.open-edge(); }
                        link-clicked => {
                            if SignInData.edge {
                                SignInData.cancel-edge();
                            } else {
                                SignInData.why-open = !SignInData.why-open;
                            }
                        }
                        if SignInData.edge-blocked && SignInData.why-open: Body {
                            text: @tr("Edge's RemoteDebuggingAllowed policy is off on this PC (an administrator or a tweaking tool set it), so featherplay can't read the sign-in from Edge. Sign in with Google works without it.");
                            font-size: Theme.t-meta + 1px;
                            color: Theme.text2;
                            overflow: clip;
                            wrap: word-wrap;
                        }
                    }
                    ChoiceRow {
                        icon: Icons.clipboard;
                        title: @tr("Paste a cookie header");
                        line: @tr("For advanced users");
                        enabled: !SignInData.busy;
                        dimmed: SignInData.busy && !root.paste-busy;
                        expands: true;
                        open: SignInData.paste-open;
                        clicked => { SignInData.paste-open = !SignInData.paste-open; }
                        if SignInData.paste-open: Body {
                            text: @tr("In a browser signed in to music.youtube.com, press F12, open the Network tab and reload. Click a request named \"browse\" and copy the whole value of its cookie request header.");
                            font-size: Theme.t-meta + 1px;
                            color: Theme.text2;
                            overflow: clip;
                            wrap: word-wrap;
                        }
                        if SignInData.paste-open: PasteField {
                            text <=> SignInData.cookies;
                        }
                        if SignInData.paste-open: HorizontalLayout {
                            alignment: start;
                            Pill {
                                label: root.paste-busy ? @tr("Checking…") : @tr("Sign in with this cookie");
                                solid: true;
                                enabled: !SignInData.busy && SignInData.cookies != "";
                                clicked => { SignInData.submit(SignInData.cookies); }
                            }
                        }
                    }
                }
            }

            // What featherplay keeps.
            HorizontalLayout {
                padding-top: Theme.s4 + 2px;
                spacing: Theme.s2;
                Icon {
                    width: 16px;
                    height: 16px;
                    commands: Icons.lock;
                    stroke: Theme.text3;
                }
                Body {
                    text: @tr("featherplay never sees your password. It keeps only the session, in Windows Credential Manager, and you can sign out any time.");
                    font-size: Theme.t-meta + 1px;
                    color: Theme.text3;
                    overflow: clip;
                    wrap: word-wrap;
                }
            }
            HorizontalLayout {
                padding-top: Theme.s5;
                alignment: start;
                TextLink {
                    text: @tr("Continue without signing in");
                    clicked => { Nav.go(PageKind.home); }
                }
            }
        }
    }
}
