// The lyrics: the Lyrics tab of `SideTabs` (now_playing.slint), in Now playing and in the
// frame's Up next panel, and Now playing's full lyrics view. Filled by `src/lyrics.rs`:
// synced lines from LRCLIB, or the plain lyrics that come with the song.
//
// The look (option A of the lyrics gate, 2026-10-30): the lines on a solid panel in the
// cover's colour, with text in three levels: sung, playing, to come. In the dark theme the
// panel is deep and the text light (`colour::lyric_panel`); in the light theme it's Home's
// band's light tint with dark text (`colour::light_tint`).
// Every line is one bold weight at one size, so becoming current never re-wraps it; only its
// colour changes (past, current, to come), through the text's colour, never `opacity` (and on
// the light tint a hairline stroke thickens the line playing, `LyricLine.heavy`). The
// lines start at the top of the panel; once the current line passes a third of the way down,
// the view scrolls to keep it there, each line moving a little after the one before it
// (`LyricLine.lag`). A manual scroll pauses that for 5 s; a click on a line
// seeks there. Nothing ticks: Rust sets `current` when the next
// line starts (one single-shot timer per line, only while sound plays and the lyrics are on
// screen), and only that glide and two lines' colours animate.
import { Theme, Curves, Icons } from "../theme.slint";
import { Body, Display, Icon, Pill, TextLink } from "../parts.slint";
import { Player } from "../player.slint";
import { Nav, PageKind, Frame } from "../nav.slint";
import { Skeleton, SkeletonBar } from "content.slint";

export enum LyricsState { idle, loading, synced, plain, none, error }

// The lyrics' panel and their three levels of text (`follow::lyric_inks`), checked against
// the panel for each theme.
export struct LyricInk {
    ground: color,
    current: color,
    next: color,
    past: color,
}

// Optional text under one displayed line. Empty fields take no room. The model always lines
// up with `lines` or `plain-lines`, whichever is showing.
export struct LyricDecoration {
    romanization: string,
    translation: string,
}

// One sung piece of a line, as Unison times it: a word, or a syllable of one. `start` and `end`
// are milliseconds in the lyrics' own time (`LyricsData.progress` is in it too).
export struct LyricPart {
    text: string,
    start: int,
    end: int,
}

// A word: its pieces, with no space between them, and whether a space follows it. Lines wrap
// between words, which for scripts written without spaces (Japanese, Chinese) is between
// characters, so the space is the word's own, after it: nothing is left at a row's start.
export struct LyricWord {
    parts: [LyricPart],
    space: bool,
}

// A line's words; none for a line with no word timing.
export struct LyricWordLine {
    words: [LyricWord],
}

export global LyricsData {
    in property <LyricsState> state: LyricsState.idle;
    // Synced: one entry per timed line; "" is a gap between lines.
    in property <[string]> lines;
    // The timing of each line's words, one entry per entry of `lines`; empty when the lyrics
    // have none (LRCLIB's), and `words` empty for a line that has none. A line with words is
    // drawn piece by piece, each lit as far as it has been sung (`progress`).
    in property <[LyricWordLine]> word-lines;
    // Where the song is, in milliseconds, in the lyrics' own time (the lines' timing moved is
    // taken off). Rust sets it about every frame while a line timed by the word is playing
    // (`src/lyrics.rs`), and once at a pause or seek; only that line reads it.
    in property <int> progress;
    in property <[LyricDecoration]> decorations;
    // The line playing, or -1 before the first.
    in property <int> current: -1;
    // Plain: the whole text, and the same as lines ("" between verses).
    in property <string> plain;
    in property <[string]> plain-lines;
    // Translate and Romanize, the two round buttons beside ⋯ in Now playing's full view and
    // the two rows in Settings > Lyrics. Their state is kept between starts. Results stay in
    // memory for the session, never on disk.
    in property <bool> translation-on;
    in property <bool> romanization-on;
    in property <bool> has-non-latin;
    in property <bool> translation-loading;
    in property <bool> romanization-loading;
    // The song's answers hold at least one line (an English song has no translation).
    in property <bool> has-translation;
    in property <bool> has-romanization;
    // The song's translation came back with no line to add (an English song): Translate's
    // tooltip says so instead of promising lines.
    in property <bool> translation-needless;
    // The English is on its way for lyrics in another script, which can't be English: bars
    // hold its places. Latin-script lyrics may well be English (then no answer comes), so
    // they stay as they are until the English lands.
    out property <bool> awaiting-english: self.translation-on && self.translation-loading && self.has-non-latin;
    // Some line shows text under it, or soon will: the lines stand further apart.
    out property <bool> extras: (self.translation-on && self.has-translation) || self.awaiting-english
        || (self.romanization-on && self.has-non-latin && (self.has-romanization || self.romanization-loading));
    // The added lines' size: the body's large size, the display's smallest for Large text.
    out property <length> extra-size: self.size == 2 ? Theme.t-display-xs : Theme.t-body-l;
    callback set-translation(bool);
    callback set-romanization(bool);
    // A main-window lyrics view (not the desktop strip) is on screen. Enrichment requests
    // run only then, because the strip does not show the extra text.
    in-out property <bool> decorations-on-screen;
    callback decorations-live-changed(bool);
    // The plain lyrics show because LRCLIB failed (an outage), not because it has no synced
    // lines for the song: the note says so.
    in property <bool> synced-unavailable;
    // Where the lyrics come from ("Lyrics from LRCLIB", or the service's own source line).
    in property <string> credit;
    // Now playing shows the lyrics in its stage, the cover small beside them. Off at every
    // start; once turned on it stays on for the session, song after song, until turned off.
    in-out property <bool> full: false;
    // Settings' "Show lyrics". Off, the Lyrics toggles and tab are hidden and nothing is
    // looked up; Rust closes the full view.
    in property <bool> on: true;
    // Settings' "Lyrics from LRCLIB": where a lookup looks, for the line saying so.
    in property <bool> lrclib: true;
    // Lyrictified and Unison are asked too (Settings' "Lyrics timed by the word").
    in property <bool> word-timed;
    // The full view is asked for and Now playing shows: Rust looks the song up.
    out property <bool> wanted: self.on && self.full && Nav.page == PageKind.now-playing;
    // Lines to show, or a lookup for them still going.
    out property <bool> has-lines: self.state == LyricsState.synced || self.state == LyricsState.plain;
    out property <bool> looking: self.state == LyricsState.loading || (self.state == LyricsState.idle && Player.has-track);
    // The lookup ended with nothing to show: none found, or it failed.
    out property <bool> missing: self.state == LyricsState.none || self.state == LyricsState.error;
    // The full view showed when the lookup began (a new song, Try again), or Now playing
    // opened on it: it shows through the lookup (its skeleton), rather than opening once the
    // lines are in. Kept by `LyricsWatch` and Now playing's `init`.
    in-out property <bool> held: false;
    // The user chose no lyrics for the playing song ("None of these"): the view says so,
    // with the ways back, and the ⋯ menu stays.
    out property <bool> chose-none: self.state == LyricsState.none && self.picked && Player.has-track;
    // The full view is on screen: what the toggles show as active. Only with lines to show,
    // a lookup it holds through, or no lyrics by the user's choice: a song with none found
    // keeps the cover view, and the Lyrics pill says why.
    out property <bool> showing: self.wanted && (self.has-lines || self.chose-none || (self.looking && self.held));
    // `showing` for what draws: set by `LyricsWatch` when it changes, before the frame is
    // drawn. Read straight, every reader was marked to repaint whenever the lookup's state
    // moved, though the view stayed: the frame a song's lyrics arrived repainted the cover,
    // its title and buttons, the bar's microphone and the tabs, and merged them with the new
    // lines into most of a 4K window (2026-11-21).
    in-out property <bool> shown: false;
    // The Lyrics pill's note under it, for a few seconds after a press on the toggles: on a
    // song with no lyrics, or one whose lookup the press waited on (`asked`) and that found
    // nothing to show. Never on its own when a later song has none. `LyricsWatch` hides it
    // again; `nudged` counts the presses, each giving the note its full time.
    in-out property <bool> hint: false;
    in-out property <int> nudged: 0;
    // A press on the playing song is waiting for its lookup: if one runs (it may start only
    // once Now playing shows) and finds nothing, the note answers the press. Spent when a
    // lookup ends, the song changes or the note's time runs out with no lookup running
    // (`LyricsWatch`), so a later song never shows the note on its own.
    in-out property <bool> asked: false;
    // The cover's panel and lines: deep in the dark theme, the light tint in the light one
    // (Home's band takes both too). `ink-light`, a softer deep panel, is the desktop lyrics'.
    in property <LyricInk> ink-dark;
    in property <LyricInk> ink-light;
    in property <LyricInk> ink-tint;
    // On Now playing the lines sit on the cover's field instead (`follow::backdrop`): its
    // inks, per theme, with the field's mean colour as their ground.
    in property <LyricInk> field-dark;
    in property <LyricInk> field-light;
    property <LyricInk> shown-dark: Frame.full-page ? self.field-dark : self.ink-dark;
    property <LyricInk> shown-light: Frame.full-page ? self.field-light : self.ink-tint;
    out property <LyricInk> ink: {
        ground: Theme.pick(self.shown-dark.ground, self.shown-light.ground),
        current: Theme.pick(self.shown-dark.current, self.shown-light.current),
        next: Theme.pick(self.shown-dark.next, self.shown-light.next),
        past: Theme.pick(self.shown-dark.past, self.shown-light.past),
    };
    // The desktop lyrics' strip shows (`desktop_lyrics.rs`): lyrics are on screen, whatever
    // the window shows.
    in property <bool> desktop;
    // The text size (Settings > Lyrics and the lyrics menu): 0 Small, 1 Medium, 2 Large.
    in property <int> size: 1;
    // The side tab's lines at that size; the full view's are Now playing's (`full-size`).
    out property <length> side-size: self.size == 0 ? 17px : (self.size == 2 ? 24px : Theme.t-lyric-side);
    // The full view's lines at that size, on a stage `wide` (`Theme.lyric-wide-min`) or not.
    public pure function full-size(wide: bool) -> length {
        return self.size == 0 ? 20px : (self.size == 2 ? (wide ? 32px : 30px) : (wide ? Theme.t-lyric-wide : Theme.t-lyric-full));
    }
    // The timing for this song, as the lyrics menu says it ("On time", "0.5 s later"), and
    // whether the lines were moved (Reset shows).
    in property <string> timing: @tr("On time");
    in property <bool> timing-moved;
    // The lyrics shown were picked in "Choose other lyrics" (or none were).
    in property <bool> picked;
    // "Use the automatic match": the song's pick is forgotten (`LyricsChoose.automatic`).
    callback automatic();
    // The lyrics are on screen (`LyricsWatch`): the size keys work only then.
    in-out property <bool> on-screen;
    // The lyrics are on screen (`LyricsWatch`, now_playing.slint): Rust asks for lyrics and
    // times the lines only then.
    callback live-changed(bool);
    // A text size picked (0 Small, 1 Medium, 2 Large): shown at once and saved.
    callback pick-size(int);
    // The timing moved half a second later (1) or sooner (-1), or back on time; per song.
    callback move-timing(int);
    callback reset-timing();
    // "Choose other lyrics…": the dialog opens on LRCLIB's matches for the song.
    callback choose();
    // The desktop lyrics' strip shows, locked: the lyrics menu offers to unlock it.
    in property <bool> desktop-locked;
    callback unlock-desktop();
    // Something of the lyrics differs from the defaults (the text size, the desktop lyrics'
    // size, place or lock, a song's timing or pick): Settings offers "Reset lyrics settings".
    in property <bool> resettable;
    // Its confirmation shows; `reset` resets them.
    in-out property <bool> reset-asked;
    callback reset();
    // A click on line `i`: play from its start.
    callback seek-line(int);
    // Try again after a failed lookup.
    callback retry();
    // The lookup failed because LRCLIB is down and the song has no lyrics of its own (Rust
    // asks LRCLIB once more a minute later); otherwise a failure is the lookup's own.
    in property <bool> unavailable;
    // What the view says when it has no lines to show.
    out property <string> message: self.state == LyricsState.error
        ? (self.unavailable ? @tr("Lyrics are unavailable right now") : @tr("Couldn't load lyrics"))
        : (Player.has-track ? @tr("No lyrics for this song") : @tr("Nothing playing"));
    // Under it: where featherplay looked, or what to do next.
    out property <string> why: self.state == LyricsState.error
        ? (self.unavailable ? @tr("LRCLIB isn't answering. featherplay asks again in a minute.") : @tr("Check your connection and try again."))
        : (!Player.has-track ? @tr("Play a song to see its lyrics here.")
        : self.picked ? @tr("You chose no lyrics for this song.")
        : self.word-timed
        ? (self.lrclib ? @tr("Searched Lyrictified, Unison, LRCLIB and YouTube Music.") : @tr("Searched Lyrictified, Unison and YouTube Music. LRCLIB is off in Settings."))
        : (self.lrclib ? @tr("Searched LRCLIB and YouTube Music.") : @tr("Searched YouTube Music. LRCLIB is off in Settings.")));

    // The Lyrics toggles (the stage's pill, the bar's microphone, Ctrl+L): on Now playing,
    // lyrics on or off; anywhere else, Now playing opens on the lyrics. Nothing with lyrics off.
    // A song with no lyrics keeps the cover view and changes nothing: the pill says so, and
    // its note why. After a failed lookup the toggle asks again. On Now playing, a song not
    // looked up yet opens the view once its lines are in, the pill saying "Finding lyrics…"
    // meanwhile; from another page Now playing opens on the view at once, as it always did.
    public function toggle-view() {
        if !self.on {
            return;
        }
        if self.showing {
            self.full = false;
            return;
        }
        if !Player.has-track {
            return;
        }
        if Nav.page != PageKind.now-playing {
            if self.state == LyricsState.none && !self.chose-none {
                self.nudge();
            } else {
                self.full = true;
                self.held = !self.missing;
                self.asked = !self.has-lines && !self.chose-none;
            }
            Nav.go(PageKind.now-playing);
        } else if self.state == LyricsState.error {
            self.full = true;
            self.asked = true;
            self.retry();
        } else if self.state == LyricsState.none && !self.chose-none {
            self.nudge();
        } else {
            // Asked for, or called off while its lookup still runs.
            self.full = !self.full;
            self.asked = self.full && self.looking;
        }
    }

    // The pill's note, for its full time.
    function nudge() {
        self.hint = true;
        self.nudged += 1;
        self.asked = true;
    }
}

// One piece of a line timed by the word or syllable. While its line is the one playing, the
// piece is in the colour still to come with a copy in the line's ink over it, cut off at `fill`
// of its width, so the colour sweeps across it as it is sung. On any other line it is drawn
// once, in the line's own easing ink, as a line timed as a whole is: so a line that has been
// sung fades to the sung colour on the same curve, with no copy left over to drop. Pieces of
// one word sit edge to edge (`LyricLine` lays them out).
component LyricSyllable inherits Rectangle {
    in property <string> text;
    in property <length> size;
    // The line's ink (`LyricLine.ink`, easing between its levels).
    in property <color> ink;
    // The colour of what is still to be sung on the line playing.
    in property <color> quiet;
    // The line is the one playing: the piece sweeps from `quiet` to `ink`.
    in property <bool> playing;
    // How much of the piece has been sung, 0 to 1.
    in property <float> fill;
    in property <float> reveal: 1;
    // The light tint's hairline (`LyricLine.heavy`), on the part sung.
    in property <bool> heavy;
    width: base.preferred-width;
    height: base.preferred-height;
    base := Display {
        text: root.text;
        font-size: root.size;
        font-weight: Theme.lyric-weight;
        color: (root.playing ? root.quiet : root.ink).transparentize(1 - root.reveal);
        wrap: no-wrap;
        overflow: clip;
    }
    if root.playing && root.fill > 0: Rectangle {
        x: 0;
        width: root.width * root.fill;
        height: root.height;
        clip: true;
        Display {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            text: root.text;
            font-size: root.size;
            font-weight: Theme.lyric-weight;
            color: root.ink.transparentize(1 - root.reveal);
            wrap: no-wrap;
            overflow: clip;
            stroke: root.heavy ? self.color : transparent;
            stroke-width: 0.35px;
        }
    }
}

// One line. `level`: -1 sung, 0 playing, 1 to come; plain lyrics are all `plain`.
component LyricLine inherits Rectangle {
    in property <string> text;
    // Its words with their timing (Unison's lyrics); none for a line timed as a whole. A line
    // with words is drawn word by word in place of `text`, which it still names.
    in property <[LyricWord]> words;
    // A space's width at the line's size (`SyncedLines.space`), between its words.
    in property <length> space: root.size * 0.28;
    // Where the last word ends once the words are laid out (0 until then): the height they take.
    property <length> flow-h: 0px;
    function flowed(word: int, bottom: length) {
        if word == root.words.length - 1 {
            root.flow-h = bottom;
        }
    }
    in property <string> romanization;
    in property <string> translation;
    // The English is on its way: a bar stands in for it.
    in property <bool> waiting;
    in property <int> level: 1;
    in property <bool> plain;
    in property <length> size;
    // The pointer moved onto this line since the lines last glided (`SyncedLines.hot`): a
    // line that slides under a resting pointer doesn't light up.
    in property <bool> hot;
    // How far the line has faded in (the full view's toggle), through its colour.
    in property <float> reveal: 1;
    // The line is on screen: hidden, its colour steps at once (nothing animates out of sight).
    in property <bool> on-screen: true;
    callback clicked();
    // The pointer moved over this line, to this point (window coordinates).
    callback pointer-moved(length, length);
    property <bool> gap: root.text == "";
    property <bool> live: !root.gap && !root.plain;
    // A verse break: a little more than the gap between lines.
    property <length> gap-h: root.size * 0.6;
    // `level` as drawn: set by its change handler, which compares values, before the frame is
    // drawn. Every line's `level` is marked dirty when the line playing changes, though only
    // two change: read straight, every line's text was drawn again in the glide's first frame,
    // the whole view's (2026-11-21).
    property <int> level-at: root.level;
    property <int> lit: 1;
    changed level-at => { root.lit = root.level-at; }
    init => { root.lit = root.level; }
    // The line's level eases on its own; the toggle's fade is applied over it, every frame.
    property <color> ink: root.plain || root.lit == 0 ? LyricsData.ink.current : (root.lit < 0 ? LyricsData.ink.past : LyricsData.ink.next);
    animate ink { duration: root.on-screen ? Theme.t-line : 0ms; easing: Curves.ease-out; }
    // What is still to be sung on a line timed by the word, eased as `ink` is: when the inks
    // change under a line being sung (a crossfade's crossing, an accent), its part to come
    // and its part sung turn together.
    property <color> quiet: LyricsData.ink.next;
    animate quiet { duration: root.on-screen ? Theme.t-line : 0ms; easing: Curves.ease-out; }
    property <bool> heavy: root.lit == 0 && root.live && !Theme.dark;
    min-height: root.gap ? root.gap-h : lay.min-height;
    preferred-height: root.gap ? root.gap-h : lay.preferred-height;
    // The list's scroll, and whether it is gliding (`SyncedLines`): the line's own copy of it
    // follows `lag` late, so the lines don't all move as one block but ripple one after
    // another. `shift` is how far behind the scroll the line still is; the line's
    // look (its tile, its touch area, its text) is drawn that far off its place, and the
    // layout keeps it in its place. Without a glide the copy follows at once.
    in property <length> scroll;
    in property <bool> glide;
    in property <duration> lag;
    property <length> lagged: root.scroll;
    animate lagged {
        duration: root.glide ? Theme.t-follow : 0ms;
        delay: root.glide ? root.lag : 0ms;
        easing: Curves.lyric;
    }
    property <length> shift: root.lagged - root.scroll;
    // Animated as a private property: a root animating a public one is copied into each use.
    property <brush> ground: !root.live ? transparent : Theme.panel-state(ta.pressed, ta.has-hover && root.hot);
    animate ground { duration: Theme.t-hover; }
    // The line playing is drawn at full size and the others a little smaller, eased with the
    // scroll and rippling with it. It scales what is
    // drawn, never the type's size, so a line becoming current doesn't wrap again; it scales
    // from the text's left edge, which stays where it is. Plain lyrics are all one size.
    property <float> zoom: root.live && root.lit != 0 ? Theme.lyric-rest-scale : 1.0;
    animate zoom {
        duration: root.on-screen ? Theme.t-follow : 0ms;
        delay: root.on-screen ? root.lag : 0ms;
        easing: Curves.lyric;
    }
    accessible-role: button;
    accessible-enabled: root.live;
    accessible-label: root.text
        + (root.romanization != "" ? ". " + root.romanization : "")
        + (root.translation != "" ? ". " + root.translation : "");
    accessible-description: root.live ? @tr("Plays from this line") : "";
    accessible-action-default => { root.clicked(); }
    // The line's look, as one block: moved by `shift` and scaled by `zoom`.
    Rectangle {
        y: root.shift;
        transform-origin: { x: Theme.s3, y: self.height / 2 };
        transform-scale: root.zoom;
        Rectangle {
            border-radius: Theme.r-m;
            background: root.ground;
        }
        // Under the line, plain text in its ink, so it lights up with it: the romanization in
        // 400, then the English in 600, both at `LyricsData.extra-size`, `s1` apart. While the
        // English is on its way (`waiting`), a bar holds its place, so nothing jumps when it lands.
        lay := VerticalLayout {
            padding-left: Theme.s3;
            padding-right: Theme.s3;
            // A sixth of the type above and below: the lines keep their spacing at any size.
            padding-top: root.size / 6;
            padding-bottom: root.size / 6;
            spacing: Theme.s1;
            // Timed by the word: the words flow and wrap as the text would, a space between
            // them, and each piece lights up as it is sung. Only the line playing reads the
            // clock, so only its pieces are drawn again as it runs.
            // A flexbox doesn't know its height for the width it'll get (it reports the height
            // of a narrow one), so the line is as tall as the words lay out: the last word's
            // bottom once they are placed, and until then the rows the same text takes
            // wrapped at this width (`guess`).
            if !root.gap && root.words.length > 0: Rectangle {
                height: root.flow-h > 0 ? root.flow-h : guess.preferred-height;
                guess := Display {
                    visible: false;
                    width: parent.width;
                    text: root.text;
                    font-size: root.size;
                    font-weight: Theme.lyric-weight;
                    wrap: word-wrap;
                }
                FlexboxLayout {
                    spacing-horizontal: 0px;
                    spacing-vertical: 0px;
                    cross-axis-alignment: CrossAxisAlignment.start;
                    for word[wi] in root.words: HorizontalLayout {
                        changed y => { root.flowed(wi, self.y + self.height); }
                        changed height => { root.flowed(wi, self.y + self.height); }
                        for part in word.parts: LyricSyllable {
                            text: part.text;
                            size: root.size;
                            ink: root.ink;
                            quiet: root.quiet;
                            playing: root.lit == 0;
                            fill: root.lit == 0 ? clamp((LyricsData.progress - part.start) / max(part.end - part.start, 1), 0, 1) : 1;
                            reveal: root.reveal;
                            heavy: root.heavy;
                        }
                        if word.space: Rectangle {
                            width: root.space;
                        }
                    }
                }
            }
            if !root.gap && root.words.length == 0: Display {
                text: root.text;
                font-size: root.size;
                font-weight: Theme.lyric-weight;
                color: root.ink.transparentize(1 - root.reveal);
                wrap: word-wrap;
                overflow: clip;
                // On the light tint the line playing is a touch heavier too, dark text on a light
                // ground reading thinner than light on deep: a hairline of its own colour round
                // its glyphs, which changes no metrics, so it never re-wraps. It takes the line's
                // easing colour; transparent, on the other lines and in the dark theme, it isn't
                // drawn.
                stroke: root.heavy ? self.color : transparent;
                stroke-width: 0.35px;
            }
            if !root.gap && root.romanization != "": Body {
                text: root.romanization;
                font-size: LyricsData.extra-size;
                color: root.ink.transparentize(1 - root.reveal);
                wrap: word-wrap;
                overflow: clip;
            }
            if !root.gap && root.translation != "": Body {
                text: root.translation;
                font-size: LyricsData.extra-size;
                font-weight: 600;
                color: root.ink.transparentize(1 - root.reveal);
                wrap: word-wrap;
                overflow: clip;
            }
            if !root.gap && root.translation == "" && root.waiting: Rectangle {
                height: LyricsData.extra-size * 1.375;
                Rectangle {
                    x: 0;
                    // Roughly the English's width: more per character of another script than
                    // of a Latin one.
                    width: min(parent.width, root.text.character-count * LyricsData.extra-size * (LyricsData.has-non-latin ? 1.6 : 0.5));
                    height: 12px;
                    border-radius: Theme.r-s;
                    background: Theme.panel-skeleton.transparentize(1 - root.reveal);
                }
            }
        }
    }
    ta := TouchArea {
        y: root.shift;
        enabled: root.live;
        mouse-cursor: root.live ? pointer : default;
        clicked => { root.clicked(); }
        pointer-event(e) => {
            if e.kind == PointerEventKind.move {
                root.pointer-moved(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
}

// A quiet line under or above the lines: the credit, "Not synced".
component LyricsNote inherits HorizontalLayout {
    in property <string> text;
    in property <float> reveal: 1;
    padding-left: Theme.s3;
    Body {
        text: root.text;
        font-size: Theme.t-body;
        font-weight: 600;
        color: LyricsData.ink.next.transparentize(1 - root.reveal);
        wrap: word-wrap;
    }
}

// A pill on the lyrics' panel, as the stage's Lyrics pill and ⋯ are: `solid`, white on the
// deep panel and black on the light tint, with the panel's colour for its ink; otherwise
// tonal (`Theme.panel-*`).
component PanelPill inherits Rectangle {
    in property <string> label;
    in property <bool> solid;
    callback clicked();
    height: 40px;
    width: lay.preferred-width;
    border-radius: self.height / 2;
    property <brush> ground: root.solid
        ? Theme.panel-solid-state(ta.pressed, ta.has-hover)
        : Theme.panel-tonal(ta.pressed, ta.has-hover);
    animate ground { duration: Theme.t-hover; }
    background: root.ground;
    transform-scale: ta.pressed ? Theme.press-scale : 1.0;
    animate transform-scale {
        duration: ta.pressed ? Theme.t-press : Theme.t-release;
        easing: ta.pressed ? Curves.ease-out : Curves.release;
    }
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    lay := HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        Body {
            text: root.label;
            font-weight: 600;
            color: root.solid ? LyricsData.ink.ground : LyricsData.ink.current;
            vertical-alignment: center;
        }
    }
}

// No lines to show: the house's empty state, a tile with the microphone, what happened, where
// featherplay looked or what to do, and after a failed lookup Try again. In the side tab it's
// on the panel's own ground (the cover's colour is for lyrics); `on-panel`, in the full view,
// it's on the lyrics' panel, in its inks. A song the user chose no lyrics for gets the ways
// back: Choose other lyrics… (with LRCLIB on) and the automatic match.
component NoLyrics inherits Rectangle {
    in property <bool> on-panel;
    height: lay.preferred-height;
    accessible-role: text;
    accessible-label: LyricsData.message + ". " + LyricsData.why;
    lay := VerticalLayout {
        alignment: start;
        HorizontalLayout {
            alignment: start;
            Rectangle {
                width: 56px;
                height: 56px;
                border-radius: Theme.r-l;
                background: root.on-panel ? Theme.panel-skeleton : Theme.card;
                border-width: root.on-panel ? 0px : 1px;
                border-color: Theme.card-edge;
                Icon {
                    width: 26px;
                    height: 26px;
                    commands: Icons.lyrics;
                    stroke: root.on-panel ? LyricsData.ink.next : Theme.text2;
                }
            }
        }
        Rectangle { height: Theme.s4; }
        Display {
            text: LyricsData.message;
            font-size: Theme.t-display-xs;
            color: root.on-panel ? LyricsData.ink.current : Theme.text1;
            wrap: word-wrap;
        }
        Rectangle { height: Theme.s2; }
        Body {
            text: LyricsData.why;
            color: root.on-panel ? LyricsData.ink.next : Theme.text2;
            wrap: word-wrap;
        }
        // Chosen: the ways back. Side by side on the panel; stacked in the narrow side tab.
        if LyricsData.chose-none && root.on-panel: HorizontalLayout {
            padding-top: Theme.s5;
            alignment: start;
            spacing: Theme.s3;
            if LyricsData.lrclib: PanelPill {
                solid: true;
                label: @tr("Choose other lyrics…");
                clicked => { LyricsData.choose(); }
            }
            PanelPill {
                solid: !LyricsData.lrclib;
                label: @tr("Use the automatic match");
                clicked => { LyricsData.automatic(); }
            }
        }
        if LyricsData.chose-none && !root.on-panel: VerticalLayout {
            padding-top: Theme.s5;
            spacing: Theme.s3;
            if LyricsData.lrclib: HorizontalLayout {
                alignment: start;
                Pill {
                    label: @tr("Choose other lyrics…");
                    clicked => { LyricsData.choose(); }
                }
            }
            HorizontalLayout {
                alignment: start;
                TextLink {
                    text: @tr("Use the automatic match");
                    clicked => { LyricsData.automatic(); }
                }
            }
        }
        // A song LRCLIB matched wrongly or not at all: the user can look for it.
        if LyricsData.state == LyricsState.none && !LyricsData.chose-none && LyricsData.lrclib && Player.has-track: VerticalLayout {
            padding-top: Theme.s3;
            HorizontalLayout {
                alignment: start;
                TextLink {
                    text: @tr("Search LRCLIB yourself");
                    clicked => { LyricsData.choose(); }
                }
            }
        }
        if LyricsData.state == LyricsState.error: Rectangle { height: Theme.s5; }
        if LyricsData.state == LyricsState.error: HorizontalLayout {
            alignment: start;
            Pill {
                label: @tr("Try again");
                clicked => { LyricsData.retry(); }
            }
        }
    }
}

// The synced lines, following the song.
component SyncedLines inherits Rectangle {
    in property <length> size;
    in property <length> pad-x;
    in property <float> reveal: 1;
    // The English is on its way (`LyricsView.waiting`).
    in property <bool> waiting;
    // On screen. Hidden (a view kept alive out of sight), it follows the song without gliding.
    in property <bool> live: true;
    // Following the song, or held still by a manual scroll.
    property <bool> following: true;
    // The glide is running: only then do the lines follow the scroll late, so the user's own
    // scrolling stays direct.
    property <bool> gliding: false;
    // How many lines after the one sung start later than the one before; the rest start with
    // the last of them.
    property <int> ripple: 4;
    // The lines are gliding back up the song (a seek back, a click on a line above): the
    // lines above the one sung then trail it, so no line runs into the one it follows.
    property <bool> back: false;
    // A space's width at the lines' size and weight, for the words of lines timed by the word:
    // the difference of two hidden texts, as a lone space can measure as nothing.
    space-with := Display {
        visible: false;
        text: "0 0";
        font-size: root.size;
        font-weight: Theme.lyric-weight;
    }
    space-without := Display {
        visible: false;
        text: "00";
        font-size: root.size;
        font-weight: Theme.lyric-weight;
    }
    // Where the current line sits in the list, for resuming the follow.
    property <length> line-y;
    property <length> line-h;
    // The line the pointer last moved onto (-1: none since the last glide), and where it was:
    // Windows sends moves without movement now and then, and those don't count.
    property <int> hot: -1;
    property <length> pointer-x: -1px;
    property <length> pointer-y: -1px;
    // Another song's lines: start from the top, following again.
    property <[string]> lines: LyricsData.lines;
    changed lines => {
        root.following = true;
        root.gliding = false;
        root.hot = -1;
        resume.running = false;
        flick.content-y = 0;
    }
    // The lines shown: none while the next song's are looked up (`LyricsView` keeps this list
    // through the lookup, under the skeleton).
    property <[string]> shown-lines: LyricsData.state == LyricsState.synced ? LyricsData.lines : [];

    function follow(glide: bool) {
        if !root.following || LyricsData.current < 0 {
            return;
        }
        let target = clamp(root.height / 3 - root.line-y - root.line-h / 2, min(0px, flick.height - flick.content-height), 0px);
        // A jump of more than the view's height (a click on a line far off) isn't a ripple:
        // the lines would fly across the view. It lands at once.
        root.gliding = glide && Theme.moving && root.live && abs(target - flick.content-y) < root.height;
        root.back = target > flick.content-y;
        if glide {
            root.hot = -1;
        }
        flick.content-y = target;
    }
    function line-is(y: length, h: length, glide: bool) {
        root.line-y = y;
        root.line-h = h;
        root.follow(glide);
    }

    // Draws nothing; marked to repaint, as one rectangle, whenever the lines scroll (a glide,
    // the wheel), and first: every line on screen moves and repaints then anyway, but each
    // as a rectangle of its own, and the renderer keeps three a frame. The lines took them
    // all, and anything else repainting in that frame (the bar's tick, once a second) was
    // merged into one of them: a side-tab glide frame repainted from the bar to the panel's
    // top, 4 Mpx at 4K (2026-11-21). Inside this one, the lines leave the other two free.
    Rectangle {
        background: rgba(0, 0, 0, 0 * flick.content-y / 1px);
    }
    flick := Flickable {
        content-height: lines-lay.preferred-height;
        // No easing here: the scroll moves at once and each line follows it on its own
        // (`LyricLine.lag`), so the user's own scrolling stays direct too.
        flicked => {
            root.gliding = false;
            root.following = false;
            resume.running = true;
            resume.restart();
        }
        // The lines' height settled after the line playing was placed: Slint 1.19 lays out a
        // line's text (an `if` in it) after the line itself, so the end `follow` clamps to
        // was short and the view stopped above the line. Place it again, at once.
        changed content-height => { root.follow(false); }
        lines-lay := VerticalLayout {
            // A pixel taller than the lines need and laid out from the top, so each line's
            // place and height are its own and those above it, to the last bit: filling its
            // height exactly, the layout shared out a rounding error that changed with every
            // line added, every line moved by a hair, and each frame of a song's lines
            // arriving repainted the whole view (2026-11-21). The pixel is under the
            // `padding-bottom`, past the scroller's end: at the top, as a size of its own would
            // centre it, half a pixel up.
            y: 0;
            height: self.preferred-height + 1px;
            alignment: start;
            // The lines start at the top, where the plain lyrics do; the view never scrolls
            // above the first one (`follow` clamps at 0), so the glide only takes over once
            // the line playing passes a third of the way down.
            padding-top: Theme.s5;
            padding-bottom: root.height / 2;
            padding-left: root.pad-x - Theme.s3;
            padding-right: root.pad-x - Theme.s3;
            spacing: LyricsData.extras ? Theme.s4 : root.size * 0.18;
            for line[i] in root.shown-lines: LyricLine {
                text: line;
                words: LyricsData.word-lines[i].words;
                romanization: LyricsData.romanization-on ? LyricsData.decorations[i].romanization : "";
                translation: LyricsData.translation-on ? LyricsData.decorations[i].translation : "";
                waiting: root.waiting;
                size: root.size;
                level: i == LyricsData.current ? 0 : (i < LyricsData.current ? -1 : 1);
                hot: i == root.hot;
                reveal: root.reveal;
                on-screen: root.live;
                scroll: flick.content-y;
                glide: root.gliding;
                space: max(0px, space-with.preferred-width - space-without.preferred-width);
                // The line sung and those ahead of it in the glide's direction move first; each
                // one behind starts a little after the one before, up to `ripple` lines.
                lag: Theme.t-lyric-stagger * clamp(root.back ? LyricsData.current - i : i - LyricsData.current, 0, root.ripple);
                init => {
                    if self.level == 0 {
                        root.line-is(self.y, self.height, false);
                    }
                }
                changed level => {
                    if self.level == 0 {
                        root.line-is(self.y, self.height, true);
                    }
                }
                // The layout settled or the panel was resized: stay on the line, at once.
                changed y => {
                    if self.level == 0 {
                        root.line-is(self.y, self.height, false);
                    }
                }
                // Its text laid out (see `changed content-height`).
                changed height => {
                    if self.level == 0 {
                        root.line-is(self.y, self.height, false);
                    }
                }
                pointer-moved(x, y) => {
                    if x != root.pointer-x || y != root.pointer-y {
                        root.hot = i;
                    }
                    root.pointer-x = x;
                    root.pointer-y = y;
                }
                clicked => {
                    root.following = true;
                    LyricsData.seek-line(i);
                }
            }
            if LyricsData.credit != "" && LyricsData.state == LyricsState.synced: VerticalLayout {
                padding-top: Theme.s5;
                LyricsNote {
                    text: LyricsData.credit;
                    reveal: root.reveal;
                }
            }
        }
    }
    // Ends the glide once the last line has settled, so a wheel notch right after it isn't
    // eased as a glide.
    Timer {
        interval: Theme.t-follow + Theme.t-lyric-stagger * root.ripple;
        running: root.gliding;
        triggered => { root.gliding = false; }
    }
    // A manual scroll holds the view for 5 s, then it follows the song again.
    resume := Timer {
        interval: 5s;
        running: false;
        triggered => {
            self.running = false;
            root.following = true;
            root.follow(true);
        }
    }
}

// Where the lines run out at the top or bottom of the view: a short fade into the panel, so
// a line half scrolled away dissolves instead of being cut. A small strip (`lyric-edge`
// tall), so the glide's frames stay cheap.
component LyricsEdge inherits Rectangle {
    in property <bool> top;
    // What the lines fade into there.
    in property <color> ground;
    height: Theme.lyric-edge;
    background: @linear-gradient(root.top ? 180deg : 0deg, root.ground 0%, root.ground.transparentize(1) 100%);
}

// A strip of Now playing's picture Rust cuts at its box's size in physical pixels
// (`follow::backdrop`): drawn 1:1, so it's copied rather than resampled, and stretched to the
// box until the next one is cut (a resize, Up next coming or going). No fade: a new one takes
// the last one's place.
component BakedImage {
    in property <image> source;
    property <bool> one: abs(self.source.width * 1phx - root.width) < 1.5phx && abs(self.source.height * 1phx - root.height) < 1.5phx;
    Image {
        width: root.one ? root.source.width * 1phx : root.width;
        height: root.one ? root.source.height * 1phx : root.height;
        visible: root.source.width > 0;
        source: root.source;
        image-fit: fill;
    }
}

// The lyrics in any state, on the cover-colour panel. The side tab sets `card`: the panel is a
// rounded card inside the tab; the full view draws its own panel across the stage and leaves
// it off.
export component LyricsView inherits Rectangle {
    in property <length> size: LyricsData.side-size;
    // The lines' inset from the view's sides (the hover tile reaches `s3` past it).
    in property <length> pad-x: Theme.s5;
    // Room kept free at the bottom: the floating bar, in the side panel.
    in property <length> bottom: Theme.bar-clear;
    in property <bool> card: true;
    // The view is on screen (the side tabs keep it alive while another tab shows): the
    // loading skeleton, which moves by itself, exists only then.
    in property <bool> shown: true;
    // How far the lyrics have faded in: the full view's toggle fades them in over its second
    // half, once the stage is the panel's colour (now_playing.slint), through their colours.
    // Until then nothing of them shows.
    in property <float> reveal: 1;
    // Now playing's picture shows under the full view: the lines fade into it at the top and
    // bottom, through strips cut from it (`edge-top`, `edge-bottom`) that Rust makes with the
    // fade in them; without them, into the bands' colour there.
    in property <bool> pictured;
    in property <image> edge-top;
    in property <image> edge-bottom;
    // The full view without the picture: the ground at the top and bottom of the lines (the
    // bands there). The side tab's lines fade into its panel.
    in property <color> edge-top-ground;
    in property <color> edge-bottom-ground;
    // The side tab's panel, crossfading when the song's colour changes. In Now playing's Up
    // next card, the card's own colour: the field's mean, toned (`Theme.float-card`).
    property <color> panel: Frame.full-page && root.card ? Theme.on-field(LyricsData.ink.ground) : LyricsData.ink.ground;
    animate panel { duration: Theme.t-turn; easing: Curves.ease-hover; }
    property <length> list-h: root.height - root.bottom;
    // The English is on its way: after `t-skeleton-delay`, so a quick answer never flashes
    // them, bars hold its lines' places.
    property <bool> translating: LyricsData.awaiting-english;
    property <bool> waited: false;
    property <bool> waiting: root.translating && (root.waited || Theme.still);
    changed translating => {
        if !self.translating {
            root.waited = false;
        }
    }
    Timer {
        interval: Theme.t-skeleton-delay;
        running: root.translating && !root.waited;
        triggered => { root.waited = true; }
    }
    // The panel's box: the card's in the side tab, all of the view in the full one.
    property <length> box-x: root.card ? Theme.s4 : 0;
    property <length> box-w: root.card ? root.width - 2 * Theme.s4 : root.width;
    property <length> box-h: root.card ? root.list-h - Theme.s2 : root.list-h;
    property <bool> moving: LyricsData.has-lines;
    // No lines to show (none found, a failed lookup, nothing playing): the side tab says why
    // (`NoLyrics`); the full view shows then only for a song the user chose no lyrics for
    // (`LyricsData.showing`), saying so on its panel.
    property <bool> empty: LyricsData.missing || (LyricsData.state == LyricsState.idle && !Player.has-track);

    // The panel, as a card in the side tab, for lyrics only.
    Rectangle {
        visible: root.card && !root.empty;
        x: root.box-x;
        y: 0;
        width: root.box-w;
        height: root.box-h;
        border-radius: Theme.r-l;
        background: root.panel;
    }

    body := Rectangle {
        x: root.box-x;
        y: 0;
        width: root.box-w;
        height: root.box-h;
        border-radius: root.card ? Theme.r-l : 0;
        clip: true;

        // Plain lyrics: the same type, all readable, under a quiet note: "Not synced", or
        // after an LRCLIB outage, that synced lyrics are unavailable for now.
        if LyricsData.state == LyricsState.plain: Flickable {
            content-height: plain-lay.preferred-height;
            plain-lay := VerticalLayout {
                padding-left: root.pad-x - Theme.s3;
                padding-right: root.pad-x - Theme.s3;
                padding-top: Theme.s5;
                padding-bottom: Theme.s6;
                spacing: LyricsData.extras ? Theme.s4 : root.size * 0.18;
                VerticalLayout {
                    padding-bottom: Theme.s3;
                    LyricsNote {
                        text: LyricsData.synced-unavailable ? @tr("Synced lyrics are unavailable right now") : @tr("Not synced to the song");
                        reveal: root.reveal;
                    }
                }
                for line[i] in LyricsData.plain-lines: LyricLine {
                    text: line;
                    romanization: LyricsData.romanization-on ? LyricsData.decorations[i].romanization : "";
                    translation: LyricsData.translation-on ? LyricsData.decorations[i].translation : "";
                    waiting: root.waiting;
                    size: root.size;
                    plain: true;
                    reveal: root.reveal;
                }
                if LyricsData.credit != "": VerticalLayout {
                    padding-top: Theme.s5;
                    LyricsNote {
                        text: LyricsData.credit;
                        reveal: root.reveal;
                    }
                }
            }
        }

        // Kept through a lookup (empty, under the skeleton): made when the lines came, the
        // list and its scroller marked the whole panel to repaint, every lyrics view's, in the
        // frame a song's lyrics arrived (~4 Mpx at 4K, 2026-11-21).
        if LyricsData.state == LyricsState.synced || LyricsData.state == LyricsState.loading: SyncedLines {
            size: root.size;
            waiting: root.waiting;
            pad-x: root.pad-x;
            reveal: root.reveal;
            live: root.shown;
        }

        // The lines dissolve into the panel at its edges, or into the picture under them.
        if root.moving && root.reveal > 0 && !(root.pictured && root.edge-top.width > 0): LyricsEdge {
            x: 0;
            y: 0;
            width: parent.width;
            top: true;
            ground: root.card ? root.panel : root.edge-top-ground;
        }
        if root.moving && root.reveal > 0 && !(root.pictured && root.edge-bottom.width > 0): LyricsEdge {
            x: 0;
            y: parent.height - self.height;
            width: parent.width;
            top: false;
            ground: root.card ? root.panel : root.edge-bottom-ground;
        }
        fade-top := BakedImage {
            x: 0;
            y: 0;
            width: parent.width;
            height: Theme.lyric-edge;
            visible: root.pictured && root.moving && root.reveal > 0;
            source: root.edge-top;
        }
        fade-bottom := BakedImage {
            x: 0;
            y: parent.height - self.height;
            width: parent.width;
            height: Theme.lyric-edge;
            visible: root.pictured && root.moving && root.reveal > 0;
            source: root.edge-bottom;
        }
        // Last, over the list kept empty under it: going, it moves no item after it in the
        // stacking order, and a moved one repaints whole (the list's scroller: the panel).
        if LyricsData.state == LyricsState.loading && root.shown && root.reveal > 0: sk := Skeleton {
            x: root.pad-x;
            y: Theme.s5;
            width: parent.width - 2 * root.pad-x;
            // As tall as its bars, not the panel: going, it repaints only where they were.
            height: min(parent.height - self.y, 8 * root.size * 1.6);
            // Shaped like the lines that replace it: one bar per line, at the lines' height
            // and spacing, light on the panel.
            for i in 8: SkeletonBar {
                x: 0;
                y: i * root.size * 1.6 + root.size * 0.2;
                height: root.size * 0.75;
                width: parent.width * (mod(i, 3) == 0 ? 0.82 : (mod(i, 3) == 1 ? 0.64 : 0.74));
                border-radius: Theme.r-m;
                tone: Theme.panel-skeleton;
                tone-hi: Theme.panel-skeleton-hi;
                sweep: sk.sweep;
                fade: sk.fade;
            }
        }
    }

    if root.card && root.empty: NoLyrics {
        x: Theme.s5;
        y: Theme.s5;
        width: min(root.width - 2 * Theme.s5, 460px);
    }
    // The full view, where the lines would start.
    if !root.card && LyricsData.chose-none && root.reveal > 0: NoLyrics {
        x: root.pad-x;
        y: Theme.s5;
        width: min(root.width - 2 * root.pad-x, 520px);
        on-panel: true;
        opacity: root.reveal;
    }
}
