// Settings' Window section, by topic: Start and close (starting when the user signs in,
// closing, the tray), Look and language (the appearance, the language, the accent and its
// custom colour), Performance (what draws the window, Windows only), Notifications and hints (notifications, tooltips, the search's
// suggestions), Keyboard (the shortcuts, the global hotkeys and the quick search's key); and
// the Home group after it.
import { Theme, Appearance } from "../../theme.slint";
import { Body, KeyReveal, TextLink } from "../../parts.slint";
import { Chips } from "../content.slint";
import { SettingId, SettingKey, SettingsData, SettingsDialog, SettingsSearch } from "data.slint";
import { ExpanderBody, ExpandSwitch, Field, Group, DropdownRow, RowButton, SettingRow, Topic, ToggleRow } from "rows.slint";
import { QuickKeyRows } from "quick_key.slint";

// An accent: a dot of its colour, ringed in `text1` when it's the one picked.
component Swatch inherits Rectangle {
    in property <brush> colour;
    in property <string> name;
    in property <bool> selected;
    callback clicked();
    width: 32px;
    height: 32px;
    border-radius: self.height / 2;
    // Animated as a private property: a root animating a public one is copied into each use.
    property <brush> ground: Theme.state(ta.pressed, ta.has-hover);
    animate ground { duration: Theme.t-hover; }
    background: root.ground;
    border-width: root.selected ? 2px : 0px;
    border-color: Theme.text1;
    accessible-role: radio-button;
    accessible-label: root.name;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-action-default => { root.clicked(); }
    Rectangle {
        width: 22px;
        height: 22px;
        border-radius: self.height / 2;
        background: root.colour;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The custom colour's hue: a strip of every hue at the slider's lightness and chroma
// (`follow::hue_colour`), and a thumb. Dragging shows the colour live and saves it on
// release; the arrow keys step 5 degrees and save.
component HueSlider inherits Rectangle {
    in property <float> hue;
    property <length> knob: 20px;
    height: 24px;
    accessible-role: slider;
    accessible-label: @tr("Hue");
    accessible-value: @tr("{n} degree" | "{n} degrees" % Math.round(root.hue));
    accessible-value-minimum: 0;
    accessible-value-maximum: 360;
    accessible-value-step: 5;
    accessible-action-increment => { root.step(5); }
    accessible-action-decrement => { root.step(-5); }

    function step(by: float) {
        SettingsData.custom-hue-moved(mod(root.hue + by + 360, 360), true);
    }
    function at(x: length, done: bool) {
        let usable = root.width - root.knob;
        SettingsData.custom-hue-moved(((x - root.knob / 2) / usable).clamp(0, 1) * 359.9, done);
    }

    Rectangle {
        x: root.knob / 2 - 6px;
        y: (parent.height - self.height) / 2;
        width: parent.width - root.knob + 12px;
        height: 12px;
        border-radius: self.height / 2;
        background: @linear-gradient(90deg,
            oklch(0.65, 0.16, 0) 0%, oklch(0.65, 0.16, 30) 8.33%, oklch(0.65, 0.16, 60) 16.67%,
            oklch(0.65, 0.16, 90) 25%, oklch(0.65, 0.16, 120) 33.33%, oklch(0.65, 0.16, 150) 41.67%,
            oklch(0.65, 0.16, 180) 50%, oklch(0.65, 0.16, 210) 58.33%, oklch(0.65, 0.16, 240) 66.67%,
            oklch(0.65, 0.16, 270) 75%, oklch(0.65, 0.16, 300) 83.33%, oklch(0.65, 0.16, 330) 91.67%,
            oklch(0.65, 0.16, 360) 100%);
    }
    key-reveal := KeyReveal { }
    focus := FocusScope {
        focus-gained(reason) => {
            if reason == FocusReason.tab-navigation {
                key-reveal.show();
            }
        }
        key-pressed(e) => {
            if e.text == Key.RightArrow || e.text == Key.UpArrow {
                root.step(5);
                return accept;
            }
            if e.text == Key.LeftArrow || e.text == Key.DownArrow {
                root.step(-5);
                return accept;
            }
            reject
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                focus.focus();
                root.at(self.mouse-x, false);
            }
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.up {
                root.at(self.mouse-x, true);
            }
        }
        moved => {
            if self.pressed {
                root.at(self.mouse-x, false);
            }
        }
    }
    // The thumb, in the slider's colour at this hue, ringed so it reads on any hue.
    Rectangle {
        x: root.hue / 360 * (parent.width - root.knob);
        y: (parent.height - self.height) / 2;
        width: root.knob;
        height: root.knob;
        border-radius: self.height / 2;
        background: oklch(0.65, 0.16, root.hue);
        border-width: 2px;
        border-color: Theme.text1;
    }
    Rectangle {
        visible: focus.has-focus;
        x: root.hue / 360 * (parent.width - root.knob) - 4px;
        y: (parent.height - self.height) / 2;
        width: root.knob + 8px;
        height: root.knob + 8px;
        border-radius: self.height / 2;
        border-width: 2px;
        border-color: Theme.accent;
    }
}

// The Accent row's choices: "From the cover", the colours, and the custom colour. In a row
// too narrow for them on one line (a narrow window), the colours go on a line of their own
// under the chip. Worked out when the width changes, not bound to it, so the row's height
// feeds nothing back into its width.
component AccentChoices inherits Rectangle {
    property <int> count: SettingsData.accents.length + 1;
    property <length> step: 32px + Theme.s2;
    property <length> swatches-w: root.count * root.step - Theme.s2;
    property <length> line-w: chip.preferred-width + Theme.s2 + root.swatches-w;
    property <bool> two-lines;
    function fit() {
        root.two-lines = root.width < root.line-w;
    }
    init => { root.fit(); }
    changed width => { root.fit(); }
    changed line-w => { root.fit(); }
    preferred-width: root.line-w;
    min-width: root.swatches-w;
    max-width: root.line-w;
    preferred-height: root.two-lines ? 36px + Theme.s2 + 32px : 36px;
    min-height: self.preferred-height;
    chip := Chips {
        x: 0;
        y: 0;
        width: min(self.preferred-width, root.width);
        labels: [@tr("From the cover")];
        active: SettingsData.accent == 0 ? 0 : -1;
        selected => { SettingsData.pick-accent(0); }
    }
    property <length> swatches-x: root.two-lines ? 0px : chip.preferred-width + Theme.s2;
    property <length> swatches-y: root.two-lines ? 36px + Theme.s2 : 2px;
    for swatch[i] in SettingsData.accents: Swatch {
        x: root.swatches-x + i * root.step;
        y: root.swatches-y;
        name: swatch.name;
        colour: Theme.pick(swatch.dark, swatch.light);
        selected: SettingsData.accent == i + 1;
        clicked => { SettingsData.pick-accent(i + 1); }
    }
    // The custom colour: a hue wheel, the usual sign for "any colour".
    Swatch {
        x: root.swatches-x + SettingsData.accents.length * root.step;
        y: root.swatches-y;
        name: @tr("Custom colour");
        colour: @conic-gradient(#E5484D 0deg, #E58A3C 45deg, #D9C23A 90deg, #5CB85C 135deg, #3BB5C9 180deg, #4C7EE5 225deg, #9061E0 270deg, #D9509E 315deg, #E5484D 360deg);
        selected: SettingsData.accent == SettingsData.accents.length + 1;
        clicked => { SettingsData.pick-accent(SettingsData.accents.length + 1); }
    }
}

// The custom colour, under the Accent row while it's picked: the colour as this theme
// shows it, the hue slider and the hex field. A line below says when the theme adjusts the
// colour to keep it visible, or why a typed code was refused.
component CustomPicker inherits VerticalLayout {
    property <string> note: Theme.dark ? SettingsData.custom-note-dark : SettingsData.custom-note-light;
    padding-bottom: Theme.s4;
    spacing: Theme.s2;
    HorizontalLayout {
        spacing: Theme.s4;
        Rectangle {
            width: 36px;
            height: 36px;
            border-radius: self.height / 2;
            background: Theme.accent;
            accessible-role: image;
            accessible-label: @tr("Custom colour as shown");
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            HueSlider {
                hue: SettingsData.custom-hue;
            }
        }
        Field {
            width: 112px;
            text <=> SettingsData.custom-hex;
            label: @tr("Colour code");
            placeholder: "#4390EE";
            committed(t) => { SettingsData.custom-hex-entered(t); }
        }
    }
    if SettingsData.custom-error != "": Body {
        text: SettingsData.custom-error;
        font-size: Theme.t-meta;
        color: Theme.text1;
        wrap: word-wrap;
    }
    if SettingsData.custom-error == "" && root.note != "": Body {
        text: root.note;
        font-size: Theme.t-meta;
        color: Theme.text2;
        wrap: word-wrap;
    }
}

component HotkeyRow inherits Rectangle {
    in property <string> label;
    in property <int> index;
    in-out property <string> text;
    in property <string> placeholder;
    height: 44px;
    Body {
        x: 0;
        width: parent.width - 220px;
        height: parent.height;
        text: root.label;
        color: Theme.text2;
        vertical-alignment: center;
    }
    Field {
        x: parent.width - self.width;
        y: (parent.height - self.height) / 2;
        width: 200px;
        text <=> root.text;
        placeholder: root.placeholder;
        label: @tr("{} hotkey", root.label);
        committed(t) => { SettingsData.hotkey-edited(root.index, t); }
    }
}

// The Home group's rows the search finds, which the Window group's count leaves out.
export global HomeRows {
    out property <int> found: (SettingsSearch.hit(SettingId.home-shortcuts).hidden ? 0 : 1) + (SettingsSearch.hit(SettingId.shortcut-suggestions).hidden ? 0 : 1) + (SettingsSearch.hit(SettingId.forget-suggestions).hidden ? 0 : 1);
}

export component WindowSection inherits Group {
    // How many of the sections below the fold the page has made (`SettingsPage.made`).
    in property <int> made;
    title: @tr("Window");
    section: 6;
    found: !SettingsSearch.active || SettingsSearch.counts[6] > HomeRows.found;
    if root.made >= 4: VerticalLayout {
        // What happens when the app starts, then what happens when it's closed.
        Topic {
            heading: @tr("Start and close");
            topic: 16;
            SettingRow {
                divider: false;
                label: SettingsData.on-windows ? @tr("Start when you sign in to Windows") : @tr("Start when you log in");
                search: SettingId.start-with-system;
                detail: SettingsData.on-windows ? @tr("featherplay opens by itself when you sign in. Nothing plays until you press play.")
                    : @tr("featherplay opens by itself when you log in. Nothing plays until you press play.");
                ExpandSwitch {
                    checked: SettingsData.start-with-system;
                    label: SettingsData.on-windows ? @tr("Start when you sign in to Windows") : @tr("Start when you log in");
                    setting: SettingId.start-with-system;
                    open: start.open;
                    toggled(on) => { SettingsData.toggled(SettingKey.start-with-system, on); }
                    flip => { start.flip(); }
                }
            }
            // Only while featherplay starts by itself. Without a tray the window starts
            // minimised, and the row says so.
            start := ExpanderBody {
                search: SettingId.start-with-system;
                on: SettingsData.start-with-system;
                start-open: true;
                if SettingsData.start-with-system: ToggleRow {
                    child: true;
                    label: SettingsData.has-tray ? @tr("Start in the tray") : @tr("Start minimised");
                    search: SettingsData.has-tray ? SettingId.start-in-tray : SettingId.start-minimised;
                    detail: SettingsData.has-tray ? @tr("At sign-in there's no window, just the tray icon. Click it for the mini player.")
                        : @tr("Your desktop has no tray, so the window starts minimised.");
                    key: SettingKey.start-in-tray;
                    checked: SettingsData.start-in-tray;
                }
            }
            // Without a tray, closing the window quits: nothing to choose.
            if SettingsData.has-tray: VerticalLayout {
                DropdownRow {
                    label: @tr("When I close the window");
                    search: SettingId.close-action;
                    detail: @tr("In the tray, the music keeps going; quit from the tray icon's menu.");
                    choices: [@tr("Ask"), @tr("Close featherplay"), @tr("Keep playing in the tray")];
                    selected: SettingsData.close-action;
                }
                ToggleRow {
                    label: @tr("Turn off the mini player");
                    search: SettingId.tray-click-opens-window;
                    detail: @tr("Clicking the tray icon opens the main window instead. Right-click always shows the menu.");
                    key: SettingKey.tray-click-opens-window;
                    checked: SettingsData.tray-click-opens-window;
                }
            }
        }
        // How the app looks and speaks. The Title bar row (Windows only) goes after
        // Appearance: the desktop draws the title bar elsewhere.
        Topic {
            heading: @tr("Look and language");
            topic: 17;
            SettingRow {
                divider: false;
                label: @tr("Appearance");
                search: SettingId.appearance;
                detail: SettingsData.on-windows ? @tr("System follows Windows' light or dark mode.") : @tr("System follows your desktop's light or dark mode.");
                Chips {
                    labels: [@tr("appearance" => "Dark"), @tr("appearance" => "Light"), @tr("appearance" => "System")];
                    active: SettingsData.appearance == Appearance.dark ? 0 : (SettingsData.appearance == Appearance.light ? 1 : 2);
                    selected(i) => {
                        SettingsData.pick-appearance(i == 0 ? Appearance.dark : (i == 1 ? Appearance.light : Appearance.system));
                    }
                }
            }
            if SettingsData.on-windows: SettingRow {
                label: @tr("Title bar");
                search: SettingId.title-bar;
                detail: @tr("Integrated puts search, Back and the window buttons in one row. System is the plain bar Windows draws.");
                Chips {
                    labels: [@tr("title bar" => "Integrated"), @tr("title bar" => "System")];
                    active: SettingsData.system-title-bar ? 1 : 0;
                    selected(i) => { SettingsData.toggled(SettingKey.system-title-bar, i == 1); }
                }
            }
            if SettingsData.offer-languages: SettingRow {
                label: @tr("Language");
                search: SettingId.language;
                detail: SettingsData.on-windows ? @tr("System follows Windows' display language when featherplay has it, and English otherwise.")
                    : @tr("System follows your system's language when featherplay has it, and English otherwise.");
                Chips {
                    labels: SettingsData.language-names;
                    active: SettingsData.language;
                    selected(i) => { SettingsData.pick-language(i); }
                }
            }
            SettingRow {
                label: @tr("Accent");
                search: SettingId.accent;
                detail: @tr("From the cover takes the colour of the song that's playing, and a plain grey when the art has none.");
                AccentChoices { }
            }
            if SettingsData.accent == SettingsData.accents.length + 1 && !SettingsSearch.hit(SettingId.accent).hidden: CustomPicker { }
        }
        // What draws the window: the graphics card (the default) or the processor, switched
        // live. Windows only: the Linux build draws with the processor.
        if SettingsData.on-windows: Topic {
            heading: @tr("Performance");
            topic: 18;
            SettingRow {
                divider: false;
                label: @tr("Draw with");
                search: SettingId.draw-with;
                detail: @tr("Graphics card scrolls and animates most smoothly. Processor uses less memory.");
                Chips {
                    labels: [@tr("draw with" => "Graphics card"), @tr("draw with" => "Processor")];
                    active: SettingsData.processor-draws ? 1 : 0;
                    selected(i) => { SettingsData.toggled(SettingKey.drawing, i == 1); }
                }
            }
            // A child row says what draws the window now, as its last surface was made (kept
            // while the window is hidden). With the graphics card picked but unusable this run,
            // the pick stays and the row says the processor draws, with "Why?" for the detail
            // (as Wayland's desktop lyrics).
            ExpanderBody {
                search: SettingId.draw-with;
                start-open: true;
                VerticalLayout {
                    SettingRow {
                        child: true;
                        label: SettingsData.drawing-fallback && !SettingsData.processor-draws
                            // Status under Draw with: the graphics card couldn't start.
                            ? @tr("Drawing with the processor for now: the graphics card couldn't be used.")
                            : !SettingsData.gpu-drawing
                            // Status under Draw with: the processor draws the window.
                            ? @tr("Drawing with the processor")
                            : SettingsData.drawing-adapter == ""
                            // Status under Draw with: the graphics card, name unknown.
                            ? @tr("Drawing with the graphics card")
                            // Status under Draw with: {} is the graphics card's name.
                            : @tr("Drawing with the graphics card ({})", SettingsData.drawing-adapter);
                        if SettingsData.drawing-fallback && !SettingsData.processor-draws: TextLink {
                            reveal: true;
                            text: @tr("Why?");
                            font-size: Theme.t-meta;
                            font-weight: 400;
                            expands: true;
                            expanded: SettingsData.drawing-why;
                            clicked => { SettingsData.drawing-why = !SettingsData.drawing-why; }
                        }
                    }
                    // The detail, on a card 460 px wide (its text wraps to that width).
                    if SettingsData.drawing-fallback && !SettingsData.processor-draws && SettingsData.drawing-why: Rectangle {
                        height: why.preferred-height + 2 * Theme.s3 + Theme.s4;
                        Rectangle {
                            x: 0;
                            y: 0;
                            width: min(460px, parent.width);
                            height: parent.height - Theme.s4;
                            border-radius: Theme.r-m;
                            background: Theme.card;
                            border-width: 1px;
                            border-color: Theme.card-edge;
                            why := Body {
                                x: 14px;
                                y: Theme.s3;
                                width: parent.width - 28px;
                                height: self.preferred-height;
                                text: @tr("featherplay couldn't start drawing with the graphics card, so the processor took over. This happens over Remote Desktop, in a virtual machine, or when the graphics driver is missing or has just been updated. featherplay tries the graphics card again each time it starts.");
                                font-size: Theme.t-meta;
                                color: Theme.text2;
                                wrap: word-wrap;
                                overflow: clip;
                            }
                        }
                    }
                }
            }
        }
        Topic {
            heading: @tr("Notifications and hints");
            topic: 19;
            if SettingsData.has-notifications: ToggleRow {
                divider: false;
                label: @tr("Track notifications");
                search: SettingId.notifications;
                detail: @tr("Show a notification when the track changes.");
                key: SettingKey.notifications;
                checked: SettingsData.notifications;
            }
            ToggleRow {
                divider: SettingsData.has-notifications;
                label: @tr("Show tooltips");
                search: SettingId.tooltips;
                detail: @tr("Names and shortcuts when you rest the pointer on a button.");
                key: SettingKey.tooltips;
                checked: SettingsData.tooltips;
            }
            ToggleRow {
                label: @tr("Show settings in search suggestions");
                search: SettingId.settings-in-suggestions;
                detail: @tr("Matching settings appear below the music results in the search bar.");
                key: SettingKey.settings-in-suggestions;
                checked: SettingsData.settings-in-suggestions;
            }
        }
        Topic {
            heading: @tr("Keyboard");
            topic: 20;
            SettingRow {
                divider: false;
                label: @tr("Keyboard shortcuts");
                search: SettingId.shortcuts;
                detail: @tr("Play, skip, search and move around without the mouse.");
                RowButton {
                    label: @tr("Show shortcuts");
                    clicked => { SettingsData.open-dialog(SettingsDialog.shortcuts); }
                }
            }
            // Wayland lets no app hear keys pressed in another. The keys inside while it's on.
            if SettingsData.has-hotkeys: VerticalLayout {
                SettingRow {
                    label: @tr("Global hotkeys");
                    search: SettingId.hotkeys;
                    detail: SettingsData.on-windows ? @tr("Play, pause and skip from any app. Each key needs Ctrl, Alt, Shift or Win.")
                        : @tr("Play, pause and skip from any app. Each key needs Ctrl, Alt, Shift or Super.");
                    ExpandSwitch {
                        checked: SettingsData.hotkeys;
                        label: @tr("Global hotkeys");
                        setting: SettingId.hotkeys;
                        open: keys.open;
                        toggled(on) => { SettingsData.toggled(SettingKey.hotkeys, on); }
                        flip => { keys.flip(); }
                    }
                }
                keys := ExpanderBody {
                    search: SettingId.hotkeys;
                    on: SettingsData.hotkeys;
                    start-open: true;
                    if SettingsData.hotkeys: VerticalLayout {
                        HotkeyRow {
                            label: @tr("Play or pause");
                            index: 0;
                            text <=> SettingsData.hotkey-play-pause;
                            placeholder: @tr("Ctrl+Alt+Space");
                        }
                        HotkeyRow {
                            label: @tr("Next");
                            index: 1;
                            text <=> SettingsData.hotkey-next;
                            placeholder: @tr("Ctrl+Alt+Right");
                        }
                        HotkeyRow {
                            label: @tr("Previous");
                            index: 2;
                            text <=> SettingsData.hotkey-previous;
                            placeholder: @tr("Ctrl+Alt+Left");
                        }
                        if SettingsData.hotkeys-error != "": Body {
                            text: SettingsData.hotkeys-error;
                            font-size: Theme.t-meta;
                            color: Theme.text1;
                            overflow: clip;
                            wrap: word-wrap;
                        }
                    }
                }
            }
            // Its own row, apart from the three hotkeys: a taken key here never drops those.
            QuickKeyRows { }
        }
    }
}

// Window's Home group (2026-11-18), one card: Home's Shortcuts row on or off, whether it
// suggests from what's played, and forgetting what it learned.
export component HomeSection inherits Group {
    in property <int> made;
    title: @tr("Home");
    section: 6;
    found: !SettingsSearch.active || HomeRows.found > 0;
    if root.made >= 4: Topic {
        topic: 21;
        ToggleRow {
            divider: false;
            label: @tr("Shortcuts");
            search: SettingId.home-shortcuts;
            detail: @tr("Liked songs, your pins and what you play lately, first on Home.");
            key: SettingKey.home-shortcuts;
            checked: SettingsData.home-shortcuts;
        }
        ToggleRow {
            label: @tr("Suggest from what you play");
            search: SettingId.shortcut-suggestions;
            detail: @tr("Off: Shortcuts shows Liked songs and your pins only.");
            key: SettingKey.shortcut-suggestions;
            checked: SettingsData.shortcut-suggestions;
        }
        SettingRow {
            label: @tr("Forget suggestions");
            search: SettingId.forget-suggestions;
            detail: @tr("Clears what Shortcuts learned from your plays. Your pins stay.");
            RowButton {
                label: @tr("Forget");
                clicked => { SettingsData.forget-suggestions(); }
            }
        }
    }
}
