// Settings' search field, in the page's header right of its title: the top bar's pill
// (`SearchField` in top_bar.slint), smaller (240 × 36), with "Search settings" and the
// Ctrl F keycaps. Typing filters the page from two letters (`SettingsSearch`, filled by
// `src/pages/settings/search.rs`); × clears it; the first Escape clears it and the next one
// leaves it (the window's key handler); Ctrl+F on Settings focuses it.
import { Theme, Icons, Curves } from "../../theme.slint";
import { Body, Icon } from "../../parts.slint";
import { Keycap, TopBarData } from "../../top_bar.slint";
import { SettingsSearch } from "data.slint";

export component SettingsSearchField inherits Rectangle {
    // The text changed (the page goes back to its top).
    callback edited();
    public function focus-input() {
        input.focus();
        input.select-all();
    }
    property <bool> has-text: SettingsSearch.query != "";
    property <bool> hovered: ta.has-hover && !input.has-focus;
    // The glyph 13 px in from the edge, then 8 px to the text.
    property <length> lead: 13px + 18px + Theme.s2;
    // Room on the right: the × button, or the Ctrl F keycaps.
    property <length> trail: root.has-text ? 36px : (input.has-focus ? Theme.s3 : keycaps.width + 11px + Theme.s2);
    function set(text: string) {
        SettingsSearch.query = text;
        SettingsSearch.edited(text);
        root.edited();
    }
    width: 240px;
    height: 36px;
    border-radius: self.height / 2;
    background: Theme.field-solid;
    border-width: input.has-focus ? 2px : 1px;
    border-color: input.has-focus ? Theme.accent : (root.hovered ? Theme.field-edge-hover : Theme.field-edge);
    animate border-color { duration: Theme.t-hover; easing: Curves.ease-hover; }
    ta := TouchArea {
        mouse-cursor: text;
        clicked => { input.focus(); }
        Icon {
            x: 13px;
            width: 18px;
            height: 18px;
            commands: Icons.search;
            stroke: input.has-focus ? Theme.text1 : (root.hovered ? Theme.text2 : Theme.text3);
        }
        if !root.has-text: Body {
            // Starts just past the text cursor, so the cursor never draws over its first letter.
            x: root.lead + input.text-cursor-width + 2px;
            width: parent.width - self.x - root.trail;
            height: parent.height;
            text: @tr("Search settings");
            color: Theme.text3;
            vertical-alignment: center;
        }
        input := TextInput {
            x: root.lead;
            width: parent.width - root.lead - root.trail;
            height: parent.height;
            text <=> SettingsSearch.query;
            single-line: true;
            vertical-alignment: center;
            font-family: Theme.body-font;
            font-size: Theme.t-body;
            color: Theme.text1;
            selection-background-color: Theme.accent;
            selection-foreground-color: Theme.on-solid;
            accessible-role: text-input;
            accessible-label: @tr("Search settings");
            accessible-description: @tr("Ctrl+F");
            // The first Escape clears the text; with none, it goes on to the window, which
            // takes the keys back.
            key-pressed(e) => {
                if e.text == Key.Escape && SettingsSearch.query != "" {
                    root.set("");
                    return accept;
                }
                reject
            }
            // A paste with line breaks or tabs goes back on one line, as in the top bar.
            edited => {
                if self.text.replace-all("\u{d}", "").replace-all("\u{a}", "").replace-all("\u{9}", "") != self.text {
                    SettingsSearch.query = TopBarData.single-line(self.text);
                    self.set-selection-offsets(2147483647, 2147483647);
                }
                SettingsSearch.edited(SettingsSearch.query);
                root.edited();
            }
        }
        // The shortcut, as two small keycaps; screen readers hear it from the description.
        keycaps := HorizontalLayout {
            x: parent.width - self.width - 11px;
            y: (parent.height - self.height) / 2;
            width: self.preferred-width;
            height: self.preferred-height;
            visible: !root.has-text && !input.has-focus;
            spacing: Theme.s1;
            Keycap { text: @tr("Ctrl"); }
            Keycap { text: "F"; }
        }
        // Clears the field and keeps (or puts) the cursor in it.
        if root.has-text: Rectangle {
            x: parent.width - self.width - 4px;
            width: 28px;
            height: 28px;
            border-radius: self.width / 2;
            background: Theme.state(cta.pressed, cta.has-hover);
            accessible-role: button;
            accessible-label: @tr("Clear search");
            accessible-action-default => {
                root.set("");
                input.focus();
            }
            animate background { duration: Theme.t-hover; }
            cta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.set("");
                    input.focus();
                }
            }
            Icon {
                width: 16px;
                height: 16px;
                commands: Icons.close;
                stroke: cta.has-hover ? Theme.text1 : Theme.text2;
            }
        }
    }
}
