// Settings' Lyrics section: Finding lyrics, Translation, and, while lyrics show, On screen.
import { Theme } from "../../theme.slint";
import { Body, TextLink } from "../../parts.slint";
import { SettingId, SettingKey, SettingsData, SettingsSearch } from "data.slint";
import { Group, RowChips, SettingRow, Topic, ToggleRow } from "rows.slint";
import { LyricsData } from "../lyrics.slint";

export component LyricsSection inherits Group {
    // How many of the sections below the fold the page has made (`SettingsPage.made`).
    in property <int> made;
    title: @tr("Lyrics");
    section: 2;
    if root.made >= 1: VerticalLayout {
        Topic {
            heading: @tr("Finding lyrics");
            topic: 7;
            ToggleRow {
                divider: false;
                label: @tr("Show lyrics");
                search: SettingId.lyrics;
                detail: @tr("The Lyrics button in the bar and on Now playing, and the Lyrics tab beside Up next. Off: they're hidden, and no lyrics are looked up.");
                key: SettingKey.lyrics;
                checked: SettingsData.lyrics;
            }
            ToggleRow {
                label: @tr("Look up synced lyrics on LRCLIB");
                search: SettingId.lyrics-lrclib;
                detail: @tr("Lines follow the song. While lyrics are on screen, LRCLIB gets the song's title, artist, album and length. Off: only the lyrics that come with the song, synced for some songs.");
                key: SettingKey.lyrics-lrclib;
                checked: SettingsData.lyrics-lrclib;
                enabled: SettingsData.lyrics;
            }
        }
        // Kept with the round buttons beside ⋯ in Now playing's lyrics (`LyricsData`); the lines
        // say where they go.
        Topic {
            heading: @tr("Translation");
            topic: 8;
            ToggleRow {
                divider: false;
                label: @tr("Translate to English");
                search: SettingId.lyrics-translation;
                detail: @tr("An English line under each line. While it's on, the lines on screen go to Google Translate.");
                key: SettingKey.lyrics-translation;
                checked: LyricsData.translation-on;
                enabled: SettingsData.lyrics;
            }
            ToggleRow {
                label: @tr("Romanize");
                search: SettingId.lyrics-romanization;
                detail: @tr("Lyrics in another script, such as Japanese or Korean, also in Latin letters. Sent to Google Translate too.");
                key: SettingKey.lyrics-romanization;
                checked: LyricsData.romanization-on;
                enabled: SettingsData.lyrics;
            }
        }
        // How the lines show, hidden with lyrics off. One size for the app, also in the lyrics
        // menu (Now playing's ⋯).
        if SettingsData.lyrics: Topic {
            heading: @tr("On screen");
            topic: 9;
            SettingRow {
                divider: false;
                label: @tr("Text size");
                search: SettingId.lyrics-size;
                detail: @tr("The lines on Now playing and in the Lyrics tab.");
                RowChips {
                    labels: [@tr("Small"), @tr("Medium"), @tr("Large")];
                    active: LyricsData.size;
                    selected(i) => { LyricsData.pick-size(i); }
                }
            }
            if SettingsData.desktop-lyrics-here: ToggleRow {
                label: @tr("Desktop lyrics");
                search: SettingId.desktop-lyrics;
                detail: @tr("The line being sung, in a small strip that stays on top of other apps. Drag it where you like; lock it to let clicks through.");
                key: SettingKey.desktop-lyrics;
                checked: SettingsData.desktop-lyrics;
            }
            // Wayland keeps a window on top, places it and lets clicks through it only for the
            // desktop's own: the row says so calmly, with "Why?" for the detail.
            if !SettingsData.desktop-lyrics-here: VerticalLayout {
                SettingRow {
                    label: @tr("Desktop lyrics");
                    search: SettingId.desktop-lyrics;
                    detail: @tr("Not available on Wayland.");
                    TextLink {
                        text: @tr("Why?");
                        font-size: Theme.t-meta;
                        font-weight: 400;
                        expands: true;
                        expanded: SettingsData.desktop-lyrics-why;
                        clicked => { SettingsData.desktop-lyrics-why = !SettingsData.desktop-lyrics-why; }
                    }
                }
                // The detail, on a card 460 px wide (its text wraps to that width).
                if SettingsData.desktop-lyrics-why: Rectangle {
                    height: note.preferred-height + 2 * Theme.s3 + Theme.s4;
                    Rectangle {
                        x: 0;
                        y: 0;
                        width: min(460px, parent.width);
                        height: parent.height - Theme.s4;
                        border-radius: Theme.r-m;
                        background: Theme.card;
                        border-width: 1px;
                        border-color: Theme.card-edge;
                        note := Body {
                            x: 14px;
                            y: Theme.s3;
                            width: parent.width - 28px;
                            height: self.preferred-height;
                            text: @tr("Wayland leaves where windows sit, and what stays on top, to your desktop, so featherplay can't keep a strip above other apps, put it in one place or let clicks through it. In an X11 session it works.");
                            font-size: Theme.t-meta;
                            color: Theme.text2;
                            wrap: word-wrap;
                            overflow: clip;
                        }
                    }
                }
            }
            // The full view's picture, last (also in the lyrics menu).
            ToggleRow {
                label: @tr("Cover behind the lyrics");
                search: SettingId.lyrics-blur;
                detail: @tr("The song's cover, blurred, behind Now playing's full lyrics instead of a plain colour.");
                key: SettingKey.lyrics-blur;
                checked: SettingsData.lyrics-blur;
            }
        }
        // Back to the defaults: shown only when something differs from them, and asked first.
        if SettingsData.lyrics && LyricsData.resettable && !SettingsSearch.active: HorizontalLayout {
            padding-top: Theme.s4;
            alignment: start;
            TextLink {
                text: @tr("Reset lyrics settings");
                clicked => { LyricsData.reset-asked = true; }
            }
        }
    }
}
