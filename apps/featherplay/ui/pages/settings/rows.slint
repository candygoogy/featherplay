// Settings' shared controls and rows: the switch, the text field, a group and its cards by
// topic, a setting's row, the expanders, and the dropdown of a list of choices.
// A row names itself to the search (`SettingsSearch`, `settings/search.rs`) by its
// `SettingId`: it takes no room while the search hides it, and marks the words found.
import { Theme, Icons, Curves } from "../../theme.slint";
import { Body, Display, Icon, Pill } from "../../parts.slint";
import { Chips } from "../content.slint";
import { TextMark, RowHit, SettingId, SettingKey, SettingsData, SettingsSearch } from "data.slint";
import { ChoiceMenu } from "../../choice_menu.slint";

// An on/off switch: filled with the accent when on, outlined when off (Windows' toggle
// shape). Enter toggles it when focused. Space doesn't: a click leaves the keys on it, and
// Space plays and pauses from anywhere (app.slint), as on YouTube Music.
export component Switch inherits Rectangle {
    in property <bool> checked;
    in property <string> label;
    in property <bool> enabled: true;
    // The row it's the control of: picked from the search suggestions, the switch takes the
    // keys, ringed only when the pick was made with the keyboard.
    in property <SettingId> setting: SettingId.none;
    callback toggled(bool);
    // Once the page has brought its row into view.
    property <bool> picked: root.setting != SettingId.none && SettingsSearch.lit == root.setting && SettingsSearch.lit-shown;
    // Has the keys without its ring, until a key is pressed in it.
    property <bool> quiet;
    property <bool> focused: focus.has-focus;
    changed focused => {
        if !self.focused {
            root.quiet = false;
        }
    }
    changed picked => {
        if root.picked {
            root.take-keys();
        }
    }
    function take-keys() {
        if root.enabled {
            focus.focus();
            root.quiet = !SettingsSearch.lit-by-key;
        }
    }
    width: 40px;
    height: 22px;
    accessible-role: switch;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => { root.flip(); }

    function flip() {
        if root.enabled {
            root.toggled(!root.checked);
        }
    }
    // The track, the root's size, dimmed as a group here (see `Field`).
    Rectangle {
        border-radius: self.height / 2;
        background: root.checked ? Theme.solid : transparent;
        border-width: root.checked ? 0px : 1.5px;
        border-color: Theme.text2;
        opacity: root.enabled ? 1.0 : 0.4;
        animate background { duration: Theme.t-hover; }
        // Hover and press: a soft halo over and around the track.
        Rectangle {
            x: -4px;
            y: -4px;
            width: parent.width + 8px;
            height: parent.height + 8px;
            border-radius: self.height / 2;
            background: Theme.state(sta.pressed, sta.has-hover);
            animate background { duration: Theme.t-hover; }
        }
        focus := FocusScope {
            enabled: root.enabled;
            key-pressed(e) => {
                root.quiet = false;
                if e.text == Key.Return {
                    root.flip();
                    return accept;
                }
                reject
            }
        }
        sta := TouchArea {
            enabled: root.enabled;
            mouse-cursor: pointer;
            clicked => {
                focus.focus();
                root.flip();
            }
        }
        // The focus ring, just outside the track.
        Rectangle {
            visible: focus.has-focus && !root.quiet;
            x: -3px;
            y: -3px;
            width: parent.width + 6px;
            height: parent.height + 6px;
            border-radius: self.height / 2;
            border-width: 2px;
            border-color: Theme.accent;
        }
        Rectangle {
            x: root.checked ? parent.width - self.width - 4px : 5px;
            y: (parent.height - self.height) / 2;
            width: root.checked ? 14px : 12px;
            height: self.width;
            border-radius: self.width / 2;
            background: root.checked ? Theme.on-solid : Theme.text2;
            animate x { duration: Theme.t-hover; easing: ease-out; }
        }
    }
}

// A one-line text field (hotkeys).
export component Field inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <string> label;
    in property <bool> enabled: true;
    in property <InputType> input-type: InputType.text;
    callback committed(string);
    // Enter in the field.
    callback accepted();
    public function grab-focus() {
        input.focus();
    }
    public function select-all() {
        input.select-all();
    }
    height: 36px;
    // The field, the root's size, dimmed as a group here: Slint copies a component whose root
    // has an opacity into every place it's used.
    Rectangle {
        border-radius: Theme.r-m;
        background: Theme.field;
        border-width: input.has-focus ? 1px : (Theme.dark ? 0px : 1px);
        border-color: input.has-focus ? Theme.accent : Theme.hairline;
        opacity: root.enabled ? 1.0 : 0.4;
        TouchArea {
            enabled: root.enabled;
            mouse-cursor: MouseCursor.text;
            clicked => { input.focus(); }
        }
        Body {
            visible: input.text == "";
            // Starts just past the text cursor, so the cursor never draws over its first
            // letter.
            x: 12px + input.text-cursor-width + 2px;
            width: parent.width - self.x - 12px;
            height: parent.height;
            text: root.placeholder;
            color: Theme.text3;
            vertical-alignment: center;
        }
        input := TextInput {
            x: 12px;
            width: parent.width - 24px;
            height: parent.height;
            text <=> root.text;
            enabled: root.enabled;
            input-type: root.input-type;
            single-line: true;
            vertical-alignment: center;
            font-family: Theme.body-font;
            font-size: Theme.t-body;
            color: Theme.text1;
            selection-background-color: Theme.solid;
            selection-foreground-color: Theme.on-solid;
            accessible-label: root.label;
            accepted => {
                root.committed(self.text);
                root.accepted();
            }
            changed has-focus => {
                if !self.has-focus {
                    root.committed(self.text);
                }
            }
        }
    }
}

// The rows' measures, shared by the groups and the section index (which lines its first
// entry up with the first group's title).
export global Rows {
    out property <length> title-h: 32px;
    out property <length> link-h: 36px;
    // Inside a card, left and right: the labels' indent and the controls' inset.
    out property <length> inset: Theme.s5;
    // Between one topic's card and the next topic's heading.
    out property <length> topic-gap: 20px;
    out property <length> pad-y: 18px;
    // An expander's rows (`ExpanderBody`): a step in from its head's text, tighter than a
    // row, their titles a step smaller than a head's.
    out property <length> child-in: Theme.s5;
    out property <length> child-pad-y: Theme.s3;
    out property <length> child-title: 15px;
    // The detail under a label: a step brighter than `text2`, still from it (so it keeps the
    // cover's tint while the accent follows it), for a clearer read on the panel.
    out property <color> detail: Theme.text2.mix(Theme.text1, 0.75);
    // Above each group's title (and between the page's title and the first group).
    out property <length> gap: Theme.s7;
    // Where the Lyrics section starts at the least, from the page's title: under Playback
    // and Sound at their shortest (the widest column, the rows that come and go hidden).
    out property <length> lyrics-least-y: 1500px;
    // The least a row's label keeps beside its controls; narrower, they go under it.
    out property <length> label-min: 180px;
}

// A group heading above its rows.
component GroupTitle inherits Display {
    font-size: 20px;
    height: Rows.title-h;
    vertical-alignment: center;
}

// A group of settings: the gap above it, its title, then its cards by topic (`Topic`, its
// children). Its cards can reach `extend` past the column on the right (Discord, with its
// profile card beside the options). While the search finds none of its rows, the group
// takes no room, gap and all.
export component Group inherits Rectangle {
    in property <string> title;
    in property <length> extend: 0px;
    // Its place in the section index (0 Playback … 7 Account).
    in property <int> section;
    // The search finds some of its rows. A section of two groups (Window and Home) says
    // which group's they are.
    in property <bool> found: !SettingsSearch.active || SettingsSearch.counts[root.section] > 0;
    property <bool> hidden: !root.found;
    min-width: lay.min-width;
    min-height: root.hidden ? 0px : lay.min-height;
    preferred-height: root.hidden ? 0px : lay.preferred-height;
    vertical-stretch: 0;
    visible: !root.hidden;
    lay := VerticalLayout {
        padding-top: Rows.gap;
        spacing: Theme.s3;
        GroupTitle {
            text: root.title;
        }
        Rectangle {
            min-width: max(0px, topics.min-width - root.extend);
            min-height: topics.min-height;
            preferred-height: topics.preferred-height;
            Rectangle {
                x: 0;
                width: parent.width + root.extend;
                height: parent.height;
                accessible-role: groupbox;
                accessible-label: root.title;
                topics := VerticalLayout {
                    @children
                }
            }
        }
    }
}


// What a topic is besides its rows, compiled once (`Topic` takes its rows as children, so
// Slint copies it into every use): the gap above it, its quiet heading, and its card drawn
// under the rows, `card-h` tall below itself. Nothing while the search finds none of its rows.
component TopicHead inherits Rectangle {
    in property <string> text;
    in property <int> topic;
    in property <length> card-h;
    // 0 none of its rows found, 1 shown, 2 shown first in its group (`SettingsSearch.topics`).
    property <int> state: SettingsSearch.topics[root.topic];
    out property <bool> hidden: root.state == 0;
    property <length> gap: root.state == 2 ? 0px : Rows.topic-gap;
    height: root.hidden ? 0px : root.gap + (root.text == "" ? 0px : label.preferred-height + Theme.s2);
    label := Body {
        x: 0;
        y: root.gap;
        width: root.width;
        height: self.preferred-height;
        visible: !root.hidden && root.text != "";
        text: root.text;
        font-weight: 600;
        color: Theme.text2;
        accessible-role: none;
    }
    Rectangle {
        x: 0;
        y: root.height;
        width: root.width;
        height: root.card-h;
        visible: !root.hidden;
        border-radius: Theme.r-l;
        background: Theme.settings-card;
        border-width: 1px;
        border-color: Theme.settings-card-edge;
    }
}

// One topic of a group: a quiet heading (none where the group's title or the card's one
// expander names it) over a card of its rows (its children), `Rows.topic-gap` below the card
// before it. The search hides a card it finds none of the rows of (its rows hide themselves),
// and the first card shown in a group keeps no gap above it.
export component Topic inherits Rectangle {
    in property <string> heading;
    // Its place among the cards, in the page's order (`TOPICS` in settings/search.rs).
    in property <int> topic;
    min-width: lay.min-width;
    min-height: head.hidden ? 0px : lay.min-height;
    preferred-height: head.hidden ? 0px : lay.preferred-height;
    vertical-stretch: 0;
    head := TopicHead {
        x: 0;
        y: 0;
        text: root.heading;
        topic: root.topic;
        card-h: root.height - self.height;
    }
    lay := VerticalLayout {
        padding-top: head.height;
        padding-left: Rows.inset;
        padding-right: Rows.inset;
        @children
    }
}

// What an expander's open part is besides its rows, compiled once: whether it's open. It's
// open from the start when `start-open` (the switch heads), again each time its head is turned
// `on` or a search suggestion is picked (it may be a row inside), and while the search finds a
// row inside it or, for its row's own keys, its row (`RowHit.opened`); never while there's
// nothing inside (`on` false) or the search hides its row.
component ExpanderState {
    in property <SettingId> search;
    in property <bool> on;
    in property <bool> start-open;
    property <bool> asked: root.start-open;
    property <RowHit> hit: SettingsSearch.hit(root.search);
    out property <bool> open: root.on && !root.hit.hidden && (root.asked || root.hit.opened);
    changed on => {
        if root.on {
            root.asked = root.start-open;
        }
    }
    property <int> picks: SettingsSearch.lit-asks;
    changed picks => {
        root.asked = root.asked || root.start-open;
    }
    public function flip() {
        root.asked = !root.open;
    }
}

// An expander's open part, under its head row (`ExpandButton` there shows `open` and calls
// `flip`): its rows (`SettingRow.child`) on the card in the head's block, as macOS' System
// Settings has them: `child-in` in from the head's text, tighter than a row, no hairline
// over or among them; the next row's hairline closes the group. Open, it takes part of its
// head row's foot, so the head and its rows read as one. Its head row is `search`, and `on`
// while there's anything inside.
//
// It unfolds as the menus do (`MenuPanel`): over `t-expand` it grows from nothing to its
// rows' height, the rows riding its foot down from under the head row as one block, clipped,
// and the rows under it on the page move down with it; it folds back over `t-fast` (without
// motion, both at once). Turned off by its head's switch, its rows go at once and the room
// they took folds away.
export component ExpanderBody inherits Rectangle {
    in property <SettingId> search;
    in property <bool> on: true;
    in property <bool> start-open;
    out property <bool> open: state.open;
    public function flip() {
        state.flip();
    }
    // 0 folded, 1 open.
    property <float> reveal: root.open ? 1 : 0;
    animate reveal {
        duration: Theme.moving ? (root.open ? Theme.t-expand : Theme.t-fast) : 0ms;
        easing: Curves.ease-drawer;
    }
    // From the head's text to its first row's, as between its rows (`child-pad-y` twice),
    // so the head reads as the first of them; open, it takes the rest of the head row's
    // foot. From its last row's text to the next row's hairline, a step more, so the group
    // ends before the hairline does.
    property <length> above: 2 * Rows.child-pad-y;
    property <length> below: 2 * Rows.child-pad-y + Theme.s1;
    property <length> lift: Rows.pad-y + Rows.child-pad-y - root.above;
    // The rows' height, or, once they're gone (the switch turned off), the last they had.
    property <length> rows-h: inner.preferred-height;
    property <length> kept-h: root.rows-h;
    changed rows-h => {
        if root.rows-h > 0 {
            root.kept-h = root.rows-h;
        }
    }
    property <length> full-h: (root.open ? root.rows-h : max(root.rows-h, root.kept-h)) + root.below - Rows.child-pad-y;
    min-height: max(0px, root.full-h - root.lift) * root.reveal;
    preferred-height: self.min-height;
    max-height: self.min-height;
    vertical-stretch: 0;
    state := ExpanderState {
        search: root.search;
        on: root.on;
        start-open: root.start-open;
    }
    // Hidden on an element inside it (`SettingRow` says why).
    Rectangle {
        visible: root.reveal > 0;
        y: -root.lift;
        height: root.height + root.lift;
        clip: true;
        Rectangle {
            y: parent.height - root.full-h;
            height: root.full-h;
            inner := VerticalLayout {
                padding-left: Rows.child-in;
                height: self.preferred-height;
                @children
            }
        }
    }
}

// An expander's chevron: up while open, quiet (`text2`), its circle and `text1` only under the
// pointer, ringed while Tab has put the keys on it.
component Chevron inherits Rectangle {
    in property <bool> open;
    in property <bool> hovered;
    in property <bool> pressed;
    in property <bool> ring;
    width: 32px;
    height: 32px;
    // The face, the root's size: the root animates nothing (`SettingRow` says why).
    Rectangle {
        border-radius: self.height / 2;
        background: Theme.state(root.pressed, root.hovered);
        animate background { duration: Theme.t-hover; }
        Icon {
            width: 16px;
            height: 16px;
            commands: Icons.chevron-down;
            stroke: root.hovered || root.pressed ? Theme.text1 : Theme.text2;
            stroke-width: 1.8px;
            // Up while open, turning as the rows unfold.
            transform-rotation: root.open ? 180deg : 0deg;
            animate transform-rotation { duration: Theme.t-expand; easing: Curves.ease-drawer; }
        }
    }
    Rectangle {
        visible: root.ring;
        border-radius: self.height / 2;
        border-width: 2px;
        border-color: Theme.accent;
    }
}

// The button that opens and closes an expander (`ExpanderBody`), last among its head row's
// controls. It takes 24 px of the row and reaches 8 px past its end, so its glyph ends where
// the other rows' controls do. A screen reader hears a button that expands; Enter flips it,
// as it does a switch.
export component ExpandButton inherits Rectangle {
    // Its row's name.
    in property <string> label;
    in property <bool> open;
    callback clicked();
    property <bool> ring;
    width: 24px;
    height: 32px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-expandable: true;
    accessible-expanded: root.open;
    accessible-action-default => { root.clicked(); }
    // Under the touch area, which takes the clicks (a focus scope takes them too).
    focus := FocusScope {
        focus-gained(reason) => { root.ring = reason == FocusReason.tab-navigation; }
        focus-lost => { root.ring = false; }
        key-pressed(e) => {
            if e.text == Key.Return {
                root.ring = true;
                root.clicked();
                return accept;
            }
            reject
        }
    }
    ta := TouchArea {
        x: 0;
        width: 32px;
        mouse-cursor: pointer;
        clicked => {
            focus.focus();
            root.ring = false;
            root.clicked();
        }
    }
    Chevron {
        x: 0;
        open: root.open;
        hovered: ta.has-hover;
        pressed: ta.pressed;
        ring: root.ring;
    }
}

// A head row's switch, and while it's on, its expander's button after it: one control,
// compiled once (an `if` in each head row would be code of its own in each).
export component ExpandSwitch inherits HorizontalLayout {
    in property <bool> checked;
    in property <string> label;
    in property <SettingId> setting;
    in property <bool> open;
    callback toggled(bool);
    callback flip();
    spacing: Theme.s2;
    // Centred on the chevron, which is taller.
    VerticalLayout {
        alignment: center;
        Switch {
            checked: root.checked;
            label: root.label;
            setting: root.setting;
            toggled(on) => { root.toggled(on); }
        }
    }
    if root.checked: ExpandButton {
        label: root.label;
        open: root.open;
        clicked => { root.flip(); }
    }
}

// Text with the search's words marked. Slint draws no fill behind part of a Text, so each
// mark is a read-only TextInput laid over the text with the same font and width, its own
// letters invisible and the mark its selection: the renderer places a selection on the
// same glyphs, across wrapped lines, as when text is selected. Only text with marks has
// any: a row as it always shows is its plain Text.
export component MarkedText inherits Body {
    in property <[TextMark]> marks;
    for mark in root.marks: TextInput {
        width: parent.width;
        height: parent.height;
        text: root.text;
        font-family: root.font-family;
        font-size: root.font-size;
        font-weight: root.font-weight;
        wrap: root.wrap;
        horizontal-alignment: root.horizontal-alignment;
        vertical-alignment: root.vertical-alignment;
        read-only: true;
        enabled: false;
        // As good as transparent: a fully transparent one isn't drawn at all, selection and
        // all (`draw_text_input` in Slint's renderers).
        color: #00000001;
        selection-background-color: Theme.pressed;
        selection-foreground-color: Theme.text1;
        accessible-role: none;
        property <TextMark> at: mark;
        init => { self.set-selection-offsets(mark.start, mark.end); }
        changed at => { self.set-selection-offsets(self.at.start, self.at.end); }
    }
}

// What a setting row is besides its controls, in components of their own so they're
// compiled once: `SettingRow` takes its controls as children, so Slint copies it into
// every row, and whatever it holds itself is code in each of them.

// The fill over a row a search suggestion opened: it holds while `lit-on`, then fades.
component LitFill inherits Rectangle {
    border-radius: Theme.r-m;
    background: Theme.hover;
    opacity: SettingsSearch.lit-on ? 1 : 0;
    animate opacity {
        duration: SettingsSearch.lit-on ? 0ms : (Theme.moving ? 600ms : 0ms);
        easing: ease-out;
    }
}

// The row's hairline on top, none on the first row its group shows while filtering.
component RowDivider {
    in property <SettingId> search;
    in property <bool> divider;
    Rectangle {
        visible: root.divider && !SettingsSearch.hit(root.search).first;
        x: 0;
        y: 0;
        width: root.width;
        height: 1px;
        background: Theme.hairline;
    }
}

// Behind the row, across it: the fill while a search suggestion has it lit, and the
// hairline. Lit, it says where the row is when the page asks, for the page to bring it
// into view.
component RowBack inherits Rectangle {
    in property <SettingId> search;
    in property <bool> divider;
    property <bool> lit: root.search != SettingId.none && SettingsSearch.lit == root.search;
    property <int> measure: root.lit ? SettingsSearch.lit-measure : 0;
    changed measure => {
        SettingsSearch.lit-y = self.absolute-position.y;
        SettingsSearch.lit-measured = self.measure;
    }
    // Across the row, 12 px in from the panel's edges.
    if root.lit: LitFill {
        x: -Theme.s3;
        width: parent.width + 2 * Theme.s3;
        height: parent.height;
    }
    RowDivider {
        width: parent.width;
        height: parent.height;
        search: root.search;
        divider: root.divider;
    }
}

// The row's name and the detail under it, the search's words marked. `hidden` is the
// search's word on the whole row.
component RowLabel inherits VerticalLayout {
    in property <string> label;
    in property <string> detail;
    in property <SettingId> search;
    in property <length> title-size: Theme.t-body-l;
    property <RowHit> hit: SettingsSearch.hit(root.search);
    // Read from the callback, not `hit`: Slint would copy `root.hit.hidden` into each
    // place that reads it, the whole `RowHit` and all, in every row.
    out property <bool> hidden: SettingsSearch.hit(root.search).hidden;
    property <[TextMark]> none;
    alignment: center;
    spacing: Theme.s1;
    MarkedText {
        text: root.label;
        marks: root.hit.title-marks;
        font-size: root.title-size;
        font-weight: 500;
        overflow: clip;
        wrap: word-wrap;
    }
    if root.detail != "": MarkedText {
        text: root.detail;
        // The line the search marked, unless the row has since changed it.
        marks: root.hit.line == root.detail ? root.hit.line-marks : root.none;
        font-size: Theme.t-meta;
        color: Rows.detail;
        overflow: clip;
        wrap: word-wrap;
    }
    // Found by a hidden keyword alone: which one, quietly.
    if root.hit.hint != "": MarkedText {
        text: root.hit.hint;
        marks: root.hit.hint-marks;
        font-size: Theme.t-meta;
        color: Theme.text3;
        overflow: clip;
        wrap: word-wrap;
    }
}

// Where a row's label and controls go (`SettingRow`), worked out once here rather than in
// every row: the controls on the right, both centred in the row's height; or, in a row too
// narrow to keep `label-min` of label beside them (a narrow window), stacked, the controls
// under the label on its left edge.
component RowPlan {
    // In an expander: tighter.
    in property <bool> child;
    property <length> pad-y: root.child ? Rows.child-pad-y : Rows.pad-y;
    in property <length> row-w;
    in property <length> label-h;
    in property <length> controls-w;
    in property <length> controls-h;
    out property <bool> stacked: root.row-w < root.controls-w + Theme.s6 + Rows.label-min;
    out property <length> label-w: root.stacked ? root.row-w : root.row-w - root.controls-w - Theme.s6;
    out property <length> body-h: root.stacked ? root.label-h + Theme.s3 + root.controls-h : max(root.label-h, root.controls-h);
    out property <length> label-y: root.pad-y + (root.stacked ? 0px : (root.body-h - root.label-h) / 2);
    out property <length> controls-x: root.stacked ? 0px : root.row-w - root.controls-w;
    out property <length> controls-y: root.pad-y + (root.stacked ? root.label-h + Theme.s3 : (root.body-h - root.controls-h) / 2);
    out property <length> controls-room: root.stacked ? min(root.controls-w, root.row-w) : root.controls-w;
    out property <length> row-h: root.body-h + 2 * root.pad-y;
}

// One setting: its name and a line of detail on the left, the control on the right (under
// the name in a narrow row, `RowPlan`). While the search hides it, it takes no room.
export component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in property <bool> divider: true;
    // Its row in the search's table (none: never hidden, nothing marked).
    in property <SettingId> search: SettingId.none;
    // One of an expander's rows (`ExpanderBody`): tighter, its title a step smaller.
    in property <bool> child;
    min-height: text.hidden ? 0px : plan.row-h;
    preferred-height: self.min-height;
    plan := RowPlan {
        child: root.child;
        row-w: root.width;
        label-h: text.preferred-height;
        controls-w: controls.preferred-width;
        controls-h: controls.preferred-height;
    }
    // Hidden on an element inside it, not on the row itself: `visible` on a component's
    // root has Slint copy the component into every place it's used, ToggleRow's 28 too.
    Rectangle {
        visible: !text.hidden;
        RowBack {
            search: root.search;
            divider: root.divider && !root.child;
        }
        text := RowLabel {
            x: 0;
            y: plan.label-y;
            width: plan.label-w;
            height: self.preferred-height;
            label: root.label;
            detail: root.detail;
            search: root.search;
            title-size: root.child ? Rows.child-title : Theme.t-body-l;
        }
        controls := HorizontalLayout {
            x: plan.controls-x;
            y: plan.controls-y;
            width: plan.controls-room;
            height: self.preferred-height;
            spacing: Theme.s2;
            @children
        }
    }
}

// A row with a switch.
export component ToggleRow inherits SettingRow {
    in property <SettingKey> key;
    in property <bool> checked;
    in property <bool> enabled: true;
    Switch {
        checked: root.checked;
        label: root.label;
        enabled: root.enabled;
        setting: root.search;
        toggled(on) => { SettingsData.toggled(root.key, on); }
    }
}

// A small pill for row controls.
export component RowButton inherits Pill {
    height: 32px;
}

// Chips in a row, as small as its buttons.
export component RowChips inherits Chips {
    height: 32px;
}

// A setting's dropdown: an outlined pill with the choice picked and a chevron. A click or Enter
// (or Alt+Down) opens its menu (`ChoiceMenu`, drawn by `ChoiceMenuLayer` in app.slint) under
// it; the keys come back to it after. Space is left to play and pause, as on a switch, and the
// arrows do nothing while it's closed (they'd change the volume). A screen reader hears a
// combo box with its value.
component Dropdown inherits Rectangle {
    // Its row's name.
    in property <string> label;
    in property <SettingId> setting;
    in property <[string]> choices;
    in property <[string]> details;
    in property <int> selected;
    property <bool> open: ChoiceMenu.open && ChoiceMenu.setting == root.setting;
    // Tab or a key put the keys on it: ringed.
    property <bool> ring;
    // Picked from the search suggestions, once the page has brought its row into view: it
    // takes the keys, ringed only when the pick was made with the keyboard (as `Switch`).
    property <bool> picked: SettingsSearch.lit == root.setting && SettingsSearch.lit-shown;
    changed picked => {
        if root.picked {
            focus.focus();
            root.ring = SettingsSearch.lit-by-key;
        }
    }
    // Its menu closed: the keys come back.
    changed open => {
        if !root.open {
            focus.focus();
            root.ring = ChoiceMenu.by-key;
        }
    }
    function show(by-key: bool) {
        ChoiceMenu.show(root.setting, root.label, root.choices, root.details, root.selected, self.absolute-position.x, self.absolute-position.y, self.width, self.height, by-key);
    }
    min-width: 72px;
    preferred-width: value.preferred-width + 48px;
    max-width: 280px;
    height: 32px;
    horizontal-stretch: 0;
    accessible-role: combobox;
    accessible-label: root.label;
    accessible-value: root.choices[root.selected];
    accessible-expandable: true;
    accessible-expanded: root.open;
    accessible-action-default => { root.show(false); }
    accessible-action-expand => { root.show(false); }
    // The pill, the root's size: the root animates nothing (`SettingRow` says why).
    Rectangle {
        border-radius: self.height / 2;
        background: root.open ? Theme.selected : ta.pressed ? Theme.pressed : ta.has-hover ? Theme.hover : Theme.dropdown;
        border-width: 1px;
        border-color: root.open ? transparent : ta.has-hover ? Theme.field-edge-hover : Theme.dropdown-edge;
        animate background, border-color { duration: Theme.t-hover; }
    }
    // Under the touch area, which takes the clicks (a focus scope takes them too).
    focus := FocusScope {
        focus-lost => { root.ring = false; }
        focus-gained(reason) => { root.ring = reason == FocusReason.tab-navigation; }
        key-pressed(e) => {
            if e.text == Key.Return || (e.modifiers.alt && e.text == Key.DownArrow) {
                root.show(true);
                return accept;
            }
            if e.text == Key.UpArrow || e.text == Key.DownArrow {
                return accept;
            }
            reject
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            focus.focus();
            root.ring = false;
            root.show(false);
        }
    }
    value := Body {
        x: 14px;
        width: parent.width - 48px;
        height: parent.height;
        text: root.choices[root.selected];
        vertical-alignment: center;
        accessible-role: none;
    }
    Icon {
        x: parent.width - 26px;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        commands: Icons.chevron-down;
        stroke: Theme.text2;
        stroke-width: 1.8px;
        // Up while the menu is open, turning as it unfolds.
        transform-rotation: root.open ? 180deg : 0deg;
        animate transform-rotation { duration: Theme.t-expand; easing: Curves.ease-drawer; }
    }
    // The focus ring, just outside the pill.
    Rectangle {
        visible: root.ring && !root.open;
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: self.height / 2;
        border-width: 2px;
        border-color: Theme.accent;
    }
}

// A setting whose choices are a list: its row, with the dropdown on the right (under its name
// in a narrow row). One component for every such setting, compiled once. A search that finds
// it by a choice's name alone says which (`Matches “…”`, `settings/search.rs`); nothing opens
// by itself.
export component DropdownRow inherits SettingRow {
    in property <[string]> choices;
    // A second line under each choice in the menu ("" for none): the output devices' adapters.
    in property <[string]> details;
    in property <int> selected;
    Dropdown {
        label: root.label;
        setting: root.search;
        choices: root.choices;
        details: root.details;
        selected: root.selected;
    }
}
