// Settings (a calm single column). Every field of `Settings`, grouped: Playback, Sound,
// Lyrics, Scrobbling, Discord, Local API, Window, Account. The Last.fm API settings, the
// ListenBrainz token and the equalizer's bands are set in a small dialog over the window
// (`SettingsDialogLayer`), which also lists the keyboard shortcuts (over any page). Filled and
// applied by `src/pages/settings.rs`; changes apply at once and are saved by the controller.
// The sections, their shared rows and the dialogs are in `settings/`; this file lays out the
// page around them.
import { Theme } from "../theme.slint";
import { Body, PageTitle } from "../parts.slint";
import { ListenBrainzState, SettingsData, SettingsDialog } from "settings/data.slint";
import { Rows } from "settings/rows.slint";
import { Dialog, DialogField } from "settings/dialog.slint";
import { EqualizerDialog } from "settings/equalizer.slint";
import { ShortcutsDialog } from "settings/shortcuts.slint";
import { PlaybackSection } from "settings/playback.slint";
import { SoundSection } from "settings/sound.slint";
import { LyricsSection } from "settings/lyrics.slint";
import { ScrobblingSection } from "settings/scrobbling.slint";
import { DiscordSection } from "settings/discord.slint";
import { LocalApiSection } from "settings/local_api.slint";
import { WindowSection } from "settings/window.slint";
import { AccountSection } from "settings/account.slint";
import { SessionStore, SignInData } from "sign_in.slint";

export { SettingKey, DiscordState, LocalApiState, LastfmState, ListenBrainzState, AccentSwatch, DiscordPreview, DiscordPart, SettingsDialog, SettingsData } from "settings/data.slint";
export { Dialog, DialogField } from "settings/dialog.slint";

// An entry of Settings' section index: the section's name, marked while it's in view.
// The marked entry wears the accent's tonal fill, as the selected chip and tab do.
component SectionLink inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();
    height: Rows.link-h;
    border-radius: Theme.r-m;
    background: ta.pressed ? Theme.pressed
        : root.active ? (ta.has-hover ? Theme.accent-tonal-hover : Theme.accent-tonal)
        : (ta.has-hover ? Theme.hover : transparent);
    accessible-role: button;
    accessible-label: root.text;
    accessible-item-selected: root.active;
    accessible-action-default => { root.clicked(); }
    animate background { duration: Theme.t-hover; }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Body {
        x: Theme.s3;
        width: parent.width - 2 * Theme.s3;
        height: parent.height;
        text: root.text;
        color: root.active ? Theme.text1 : Theme.text2;
        font-weight: root.active ? 600 : 400;
        vertical-alignment: center;
    }
}

export component SettingsPage inherits Rectangle {
    // The content column: wide enough that the descriptions run one or two lines.
    property <length> col-max: 920px;
    // At wide windows a section index sits left of the column, when the column keeps
    // `beside-min` beside it: what the Discord group needs for its two columns, so the index
    // coming in doesn't send the Discord card back above its options. The block starts at the
    // page's padding, as every page's content does (level with the search field), whether the
    // side panel is open or not; the column takes the rest, up to `col-max`, so the switches
    // stay near their labels.
    property <length> index-w: 184px;
    property <length> index-gap: Theme.s7;
    property <bool> indexed: self.width >= 2 * Theme.page-pad + root.index-w + root.index-gap + root.beside-min;
    property <length> index-room: root.indexed ? root.index-w + root.index-gap : 0px;
    property <length> col-w: min(self.width - 2 * Theme.page-pad - root.index-room, root.col-max);
    property <length> block-x: Theme.page-pad;
    property <length> col-x: root.block-x + root.index-room;
    // The Discord profile card sits beside the Discord options when the Discord panel can
    // hold both: the options at `options-min` or more, the gap, the card at `card-min` or
    // more. Otherwise there's no card: above the options it pushed them a screen down, and
    // the options say what they do without it. Where the card and its gap fit whole
    // right of the column, before the page's padding, the panel reaches past the column by
    // them, so the options keep the column's width and their switches line up with the other
    // groups'; with less room there, the panel keeps the column's edge rather than jutting
    // past it by a sliver, and the options and the card share it. Beside them the card is
    // `card-w` wide, its own measure, where that leaves the options `options-ease`, enough
    // for a row's line beside its controls; in less room the card gives way first, down to
    // `card-min` (as wide as Discord draws its own), and then the options do.
    property <length> card-w: 400px;
    property <length> card-min: 340px;
    property <length> card-gap: Theme.s6;
    property <length> options-min: 400px;
    property <length> options-ease: 480px;
    property <length> beside-min: 2 * Rows.inset + root.options-min + root.card-gap + root.card-min;
    property <length> margin-room: self.width - Theme.page-pad - root.col-x - root.col-w;
    property <length> wide-panel: root.col-w + (root.margin-room >= root.card-gap + root.card-w ? root.card-gap + root.card-w : 0px);
    property <bool> card-beside: root.wide-panel >= root.beside-min;
    property <length> beside-card-w: max(root.card-min, min(root.card-w, root.wide-panel - 2 * Rows.inset - root.card-gap - root.options-ease));
    // Where the Discord rows start in the scrolled content, and how much of the page shows
    // above the player bar and the fade over its top (`bar-fade` in app.slint).
    property <length> discord-top: col.y + discord-section.y + Rows.title-h + Theme.s3 + Rows.pad-top;
    property <length> view-h: flick.height - Theme.bar-clear - Theme.s5;
    // How many of the sections below the fold (Discord, Window, Account) are made: one
    // more each tick after the page's first frame, not all with it. Making and laying out
    // every row, its text shaped, was most of the page's first frame (~13 ms at 4K shown
    // again, ~21 the first time; measured 2026-11-01). Until then a
    // section is its title on an empty panel, out of sight.
    property <int> made: 0;
    Timer {
        interval: 1ms;
        running: root.made < 3;
        triggered => { root.made += 1; }
    }

    // Where each section starts in the scrolled content, in the index's order.
    property <[length]> tops: [
        col.y + playback-section.y,
        col.y + sound-section.y,
        col.y + lyrics-section.y,
        col.y + scrobbling-section.y,
        col.y + discord-section.y,
        col.y + local-api-section.y,
        col.y + window-section.y,
        col.y + account-section.y,
    ];
    // The section in view, derived from the scroll position (nothing is timed): the last one
    // whose top has passed a third of the way down the visible page, or the last section once
    // the page is scrolled to its end.
    property <length> scrolled: -flick.content-y;
    property <length> max-scroll: max(0px, flick.content-height - flick.height);
    property <length> reading-line: root.scrolled + (flick.height - Theme.bar-clear) / 3;
    property <int> in-view: root.max-scroll > 0 && root.scrolled >= root.max-scroll - 1px ? 7
        : root.reading-line >= root.tops[7] ? 7
        : root.reading-line >= root.tops[6] ? 6
        : root.reading-line >= root.tops[5] ? 5
        : root.reading-line >= root.tops[4] ? 4
        : root.reading-line >= root.tops[3] ? 3
        : root.reading-line >= root.tops[2] ? 2
        : root.reading-line >= root.tops[1] ? 1 : 0;
    // Brings section `i`'s title near the top (as far as the page scrolls).
    function go-to(i: int) {
        flick.content-y = -min(max(0px, root.tops[i] - Theme.s5), root.max-scroll);
    }

    flick := Flickable {
        width: parent.width;
        height: parent.height;
        content-height: col.preferred-height + Theme.page-top + Theme.page-end;

        col := VerticalLayout {
            x: root.col-x;
            y: Theme.page-top;
            width: root.col-w;
            height: self.preferred-height;
            spacing: Theme.s7;

            PageTitle {
                text: @tr("Settings");
            }

            playback-section := PlaybackSection { }

            sound-section := SoundSection { }

            lyrics-section := LyricsSection { }

            scrobbling-section := ScrobblingSection { }

            discord-section := DiscordSection {
                extend: root.card-beside ? root.wide-panel - root.col-w : 0px;
                made: root.made;
                card-beside: root.card-beside;
                beside-card-w: root.beside-card-w;
                card-gap: root.card-gap;
                view-h: root.view-h;
                scrolled: root.scrolled;
                discord-top: root.discord-top;
            }

            local-api-section := LocalApiSection { }

            window-section := WindowSection {
                made: root.made;
            }

            account-section := AccountSection {
                made: root.made;
            }
        }
    }

    // The section index, at wide windows. It rises with the first section until it reaches
    // the page's top, then stays there while the sections scroll past.
    // Its first entry's label is level with the first group's title.
    if root.indexed: VerticalLayout {
        x: root.block-x;
        y: max(Theme.page-top, root.tops[0] + flick.content-y + (Rows.title-h - Rows.link-h) / 2);
        width: root.index-w;
        spacing: 2px;
        accessible-role: list;
        accessible-label: @tr("Settings sections");
        for name[i] in [@tr("Playback"), @tr("Sound"), @tr("Lyrics"), @tr("Scrobbling"), @tr("Discord"), @tr("Local API"), @tr("Window"), @tr("Account")]: SectionLink {
            text: name;
            active: i == root.in-view;
            clicked => { root.go-to(i); }
        }
    }

    // A quiet scroll indicator, shown only when the page is taller than the window.
    // Its track ends above the floating bar.
    if flick.content-height > flick.height: Rectangle {
        property <length> track: flick.height - Theme.bar-clear - 8px;
        property <length> thumb: max(32px, self.track * flick.height / flick.content-height);
        x: parent.width - 8px;
        y: 4px + (self.track - self.thumb) * (-flick.content-y / (flick.content-height - flick.height));
        width: 4px;
        height: self.thumb;
        border-radius: 2px;
        background: Theme.track;
    }
}

// The open dialog, over the whole window (sidebar and bar too): AppWindow places it at the
// app level so its scrim dims and blocks everything, like the song menu.
export component SettingsDialogLayer inherits Rectangle {
    if SettingsData.dialog == SettingsDialog.lastfm-keys: Dialog {
        width: root.width;
        height: root.height;
        title: @tr("Last.fm API settings");
        // Two sentences: whose API account is in use, then how to make one.
        detail: (SettingsData.lastfm-custom-key ? @tr("Your own API account is in use.")
            : SettingsData.lastfm-builtin-key ? @tr("featherplay's own API account is in use; you can use yours instead.")
            : @tr("This build has no API account of its own, so Last.fm needs yours."))
            + " " + @tr("Create one at last.fm/api/account/create, leaving the callback URL empty. Saving signs you out of Last.fm.");
        error: SettingsData.dialog-error;
        extra: SettingsData.lastfm-custom-key ? @tr("Remove your key") : "";
        ok => { SettingsData.lastfm-keys-save(SettingsData.dialog-key, SettingsData.dialog-secret); }
        cancel => { SettingsData.close-dialog(); }
        extra-clicked => { SettingsData.lastfm-keys-remove(); }
        DialogField {
            init => { self.grab-focus(); }
            label: @tr("API key");
            placeholder: SettingsData.lastfm-custom-key ? @tr("Enter a new key to replace yours") : @tr("32 letters and digits");
            text <=> SettingsData.dialog-key;
            accepted => { SettingsData.lastfm-keys-save(SettingsData.dialog-key, SettingsData.dialog-secret); }
        }
        DialogField {
            label: @tr("Shared secret");
            placeholder: @tr("Shown below the key on Last.fm");
            input-type: InputType.password;
            text <=> SettingsData.dialog-secret;
            accepted => { SettingsData.lastfm-keys-save(SettingsData.dialog-key, SettingsData.dialog-secret); }
        }
    }

    if SettingsData.dialog == SettingsDialog.listenbrainz-token: Dialog {
        width: root.width;
        height: root.height;
        title: @tr("ListenBrainz token");
        // Where the token is kept: the same store as the session (`SignInData`).
        detail: SignInData.session-store == SessionStore.credential-manager ? @tr("Paste the user token from listenbrainz.org/settings. featherplay checks it with ListenBrainz, then keeps it in Windows Credential Manager.")
            : @tr("Paste the user token from listenbrainz.org/settings. featherplay checks it with ListenBrainz, then keeps it in your keyring.");
        error: SettingsData.dialog-error;
        ok => { SettingsData.listenbrainz-save(SettingsData.dialog-token); }
        cancel => { SettingsData.close-dialog(); }
        DialogField {
            init => { self.grab-focus(); }
            label: @tr("User token");
            placeholder: SettingsData.listenbrainz-state == ListenBrainzState.signed-in ? @tr("Paste a new token to replace yours") : @tr("Paste your user token");
            input-type: InputType.password;
            text <=> SettingsData.dialog-token;
            accepted => { SettingsData.listenbrainz-save(SettingsData.dialog-token); }
        }
    }

    if SettingsData.dialog == SettingsDialog.equalizer: EqualizerDialog {
        width: root.width;
        height: root.height;
    }

    if SettingsData.dialog == SettingsDialog.shortcuts: ShortcutsDialog {
        width: root.width;
        height: root.height;
    }
}
