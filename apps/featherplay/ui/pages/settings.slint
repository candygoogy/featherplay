// Settings (a calm single column). Every field of `Settings`, grouped: Playback, Sound,
// Lyrics, Scrobbling, Discord, Local API, Window, Account. The Last.fm API settings, the
// ListenBrainz token and the equalizer's bands are set in a small dialog over the window
// (`SettingsDialogLayer`), which also lists the keyboard shortcuts (over any page). Filled and
// applied by `src/pages/settings.rs`; changes apply at once and are saved by the controller.
import { Theme, Curves, Icons, Appearance } from "../theme.slint";
import { Body, Display, PageTitle, Pill, Icon, Cover, TextLink } from "../parts.slint";
import { Player } from "../player.slint";
import { Chips } from "content.slint";
import { NowPlayingData } from "now_playing.slint";
import { Nav, PageKind } from "../nav.slint";
import { SidebarData } from "../sidebar.slint";
import { Shortcuts, ShortcutRow } from "../shortcuts.slint";

// The on/off settings, for `SettingsData.toggled`.
export enum SettingKey {
    prefer-song-versions,
    skip-non-music,
    skip-disliked,
    sponsorblock,
    scrobbling,
    scrobble,
    listenbrainz,
    scrobble-other-media,
    alternative-titles,
    alternative-artists,
    discord,
    discord-auto-reconnect,
    discord-clear-on-pause,
    discord-play-button,
    discord-links,
    notifications,
    hotkeys,
    lyrics,
    lyrics-lrclib,
    autoplay,
    check-for-updates,
    install-updates,
    local-api,
    amuse,
    tray-click-opens-window,
    fade-on-skip,
    match-volumes,
    tooltips,
}

// The Discord connection, live from the presence worker.
export enum DiscordState {
    off,
    // This build has no Discord app ID.
    unavailable,
    connecting,
    connected,
    not-connected,
}

// The local API's server, and the Amuse endpoint.
export enum LocalApiState {
    off,
    running,
    // It couldn't listen; `local-api-message` says why.
    failed,
}

// The Last.fm desktop sign-in, step by step.
export enum LastfmState {
    signed-out,
    // Asking Last.fm for a token, then opening the browser.
    opening,
    // The approval page is open in the browser.
    waiting,
    // Exchanging the approved token for a session.
    finishing,
    signed-in,
}

// ListenBrainz, by its user token.
export enum ListenBrainzState {
    signed-out,
    // Checking a new token with ListenBrainz.
    checking,
    signed-in,
}

// A fixed accent on the page: its name and its colour in each theme.
export struct AccentSwatch {
    name: string,
    dark: color,
    light: color,
}

// The Discord preview (`src/pages/settings.rs`, from the same card the presence sends): the
// status line and the activity, for the current track or a sample when nothing plays.
export struct DiscordPreview {
    sample: bool,
    // "Listening to …".
    status: string,
    title: string,
    artist: string,
    // 0 the progress bar, 1 time elapsed only, 2 no time.
    time: int,
    // The button's label, or empty when it's off.
    button: string,
    // The Links option: the title opens the song, the artist their page.
    title-link: bool,
    artist-link: bool,
    // The cover's hover text, which Discord shows as a line under the artist; empty if none.
    album: string,
}

// The part of the Discord profile card an option changes, lit while the option is hovered.
export enum DiscordPart {
    none,
    // The status line under the name (Status text).
    status,
    // The progress bar, or the time elapsed (Time).
    time,
    // The Play song button.
    button,
    // The title and the artist (Links).
    links,
    // The whole activity: the options that clear it.
    activity,
    // The whole card: Discord status, which shows it at all.
    card,
}

// The dialog open over the page, if any.
export enum SettingsDialog {
    none,
    lastfm-keys,
    listenbrainz-token,
    equalizer,
    // The keyboard shortcuts (over any page: Ctrl+/ opens it from anywhere).
    shortcuts,
}

export global SettingsData {
    // Playback.
    in property <bool> prefer-song-versions;
    in property <bool> skip-non-music;
    in property <bool> autoplay: true;
    // Skip silence: 0 Off, 1 Start and end, 2 Everywhere.
    in property <int> skip-silence: 0;
    // Crossfade: 0 Off, 1 2 s, 2 5 s, 3 8 s, 4 12 s. Fade on skip shows only while it's on.
    in property <int> crossfade: 0;
    in property <bool> fade-on-skip;
    // The Volume step: 0 1 %, 1 2 %, 2 5 %, 3 10 %.
    in property <int> volume-step: 2;
    // Sound. The Equalizer: 0 Off, 1 Bass, 2 Treble, 3 Vocal, 4 Custom; the bands it plays
    // (60 Hz, 250 Hz, 1 kHz, 4 kHz, 12 kHz) in dB, all 0 when off.
    in property <int> equalizer: 0;
    in property <[int]> eq-bands: [0, 0, 0, 0, 0];
    // Even out loudness: 0 Off, 1 Light, 2 Strong.
    in property <int> loudness: 0;
    in property <bool> match-volumes: true;
    // The Streaming quality: 0 High, 1 Standard.
    in property <int> streaming-quality: 0;
    in property <bool> skip-disliked: true;
    in property <bool> sponsorblock;
    // "System default" first, then the output devices by name.
    in property <[string]> devices;
    in property <int> device-index;
    // Scrobbling. `scrobbling` turns every service on or off; `scrobble` is Last.fm's own
    // switch and `listenbrainz` ListenBrainz's.
    in property <bool> scrobbling;
    in property <bool> scrobble-other-media;
    in property <bool> alternative-titles;
    in property <bool> alternative-artists;
    // This build has a Last.fm API key of its own; the user has entered theirs.
    in property <bool> lastfm-builtin-key;
    in property <bool> lastfm-custom-key;
    in property <LastfmState> lastfm-state;
    in property <string> lastfm-message;
    in property <bool> scrobble;
    in property <ListenBrainzState> listenbrainz-state;
    in property <string> listenbrainz-message;
    in property <bool> listenbrainz;
    // The dialog and its fields (cleared by Rust when it opens or closes).
    in-out property <SettingsDialog> dialog;
    in-out property <string> dialog-key;
    in-out property <string> dialog-secret;
    in-out property <string> dialog-token;
    in property <string> dialog-error;
    // Discord and the local API.
    in property <bool> discord;
    in property <DiscordState> discord-state;
    in property <bool> discord-auto-reconnect;
    in property <bool> discord-clear-on-pause;
    in property <int> discord-clear-minutes: 10;
    // 0 the progress bar, 1 time elapsed only, 2 no time.
    in property <int> discord-time;
    // "Listening to …": 0 featherplay, 1 the artist, 2 the song title.
    in property <int> discord-status-text: 2;
    in property <bool> discord-play-button;
    in property <bool> discord-links;
    in property <DiscordPreview> discord-preview;
    // The card's part for the option under the pointer, and which option lit it
    // (`DiscordOption.option`, -1 for none), so an option the pointer leaves clears only its
    // own (neighbours light the same part). Set by the page; Rust clears them when the page
    // opens and when Discord status is turned off, as the rows go away under the pointer.
    in-out property <DiscordPart> discord-lit;
    in-out property <int> discord-lit-option: -1;
    // What the card shows lit: nothing while Discord status is off or not connected, when
    // the card is dimmed.
    out property <bool> discord-live: discord && discord-state == DiscordState.connected;
    out property <DiscordPart> discord-card-lit: discord-live ? discord-lit : DiscordPart.none;
    // The local API: the switch, the server's state, the port as typed (and why it was
    // refused), and the token masked (Rust keeps the token itself for Copy).
    in property <bool> local-api;
    in property <LocalApiState> local-api-state;
    in property <string> local-api-message;
    in-out property <string> local-api-port: "26538";
    in property <string> local-api-port-error;
    in property <string> local-api-token;
    // The Amuse endpoint: the switch and its server's state (`amuse-message` says why it failed).
    in property <bool> amuse;
    in property <LocalApiState> amuse-state;
    in property <string> amuse-message;
    // Window.
    in property <bool> notifications;
    // What the close button does: 0 ask, 1 close featherplay, 2 keep playing in the tray.
    in property <int> close-action;
    // "Turn off the mini player": a left click on the tray icon opens the main window instead.
    in property <bool> tray-click-opens-window;
    // "Show tooltips": the bar's buttons name themselves and their shortcut on a rest.
    in property <bool> tooltips: true;
    in property <Appearance> appearance;
    // The Language setting: Windows default, English, then the bundled languages by their
    // own names (Rust fills both lists); `language` is the picked one's index.
    in property <[string]> language-names;
    in property <[string]> language-codes;
    in property <int> language;
    // The Accent setting: 0 from the cover, then `accents` (Red first), then the custom
    // colour (`accents.length + 1`).
    in property <int> accent;
    in property <[AccentSwatch]> accents;
    // The custom colour: as typed ("#4390EE"), its place on the hue slider (degrees), and
    // what each theme makes of it (empty when it shows as typed). Rust fills them.
    in-out property <string> custom-hex;
    in property <float> custom-hue;
    in property <string> custom-note-dark;
    in property <string> custom-note-light;
    in property <string> custom-error;
    in property <bool> hotkeys;
    in-out property <string> hotkey-play-pause;
    in-out property <string> hotkey-next;
    in-out property <string> hotkey-previous;
    in property <string> hotkeys-error;
    // The saved hotkeys (play or pause, next, previous), a keycap per key, for the shortcuts'
    // list: filled as it opens.
    in property <[[string]]> hotkey-keys;
    // Account.
    in property <bool> signed-in;
    // Lyrics: shown at all ("Show lyrics"), and looked up on LRCLIB.
    in property <bool> lyrics: true;
    in property <bool> lyrics-lrclib: true;
    // Ask GitHub once a day whether a newer featherplay is out.
    in property <bool> check-for-updates: true;
    // Download a newer release's setup and offer "Restart to update" (the installed copy).
    in property <bool> install-updates: true;

    callback toggled(SettingKey, bool);
    callback pick-device(int);
    callback pick-appearance(Appearance);
    callback pick-language(int);
    callback pick-accent(int);
    // The hue slider moved (degrees); `done` when the button is let go or a key stepped it,
    // which saves it.
    callback custom-hue-moved(float, bool);
    // Enter in the hex field, or leaving it, with the text as typed.
    callback custom-hex-entered(string);
    callback pick-close-action(int);
    callback pick-volume-step(int);
    // An Equalizer chip; Custom… (4) opens the bands.
    callback pick-equalizer(int);
    // A band in the Equalizer dialog moved: its index and its value in dB.
    callback eq-band-moved(int, int);
    // Reset in the Equalizer dialog: every band at 0 dB, and the equalizer off.
    callback eq-reset();
    callback pick-loudness(int);
    callback pick-skip-silence(int);
    callback pick-crossfade(int);
    callback pick-streaming-quality(int);
    // 0 play/pause, 1 next, 2 previous; the text as typed.
    callback hotkey-edited(int, string);
    callback lastfm-connect();
    callback lastfm-approved();
    callback lastfm-cancel();
    callback lastfm-sign-out();
    callback open-dialog(SettingsDialog);
    // OK in the Last.fm API settings, with the fields as typed.
    callback lastfm-keys-save(string, string);
    callback lastfm-keys-remove();
    callback listenbrainz-save(string);
    callback listenbrainz-remove();
    callback close-dialog();
    callback sign-out();
    callback discord-connect();
    callback discord-clear();
    // -1 shorter, +1 longer.
    callback discord-step-minutes(int);
    callback discord-pick-time(int);
    callback discord-pick-status-text(int);
    // Enter in the port field, or leaving it, with the text as typed.
    callback local-api-port-entered(string);
    callback local-api-copy();
    callback local-api-regenerate();
}

// An on/off switch: filled with the accent when on, outlined when off (Windows' toggle
// shape). Enter toggles it when focused. Space doesn't: a click leaves the keys on it, and
// Space plays and pauses from anywhere (app.slint), as on YouTube Music.
export component Switch inherits Rectangle {
    in property <bool> checked;
    in property <string> label;
    in property <bool> enabled: true;
    callback toggled(bool);
    width: 40px;
    height: 22px;
    accessible-role: switch;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => { root.flip(); }

    function flip() {
        if root.enabled {
            root.toggled(!root.checked);
        }
    }
    // The track, the root's size, dimmed as a group here (see `Field`).
    Rectangle {
        border-radius: self.height / 2;
        background: root.checked ? Theme.accent : transparent;
        border-width: root.checked ? 0px : 1.5px;
        border-color: Theme.text2;
        opacity: root.enabled ? 1.0 : 0.4;
        animate background { duration: Theme.t-hover; }
        // Hover and press: a soft halo over and around the track.
        Rectangle {
            x: -4px;
            y: -4px;
            width: parent.width + 8px;
            height: parent.height + 8px;
            border-radius: self.height / 2;
            background: Theme.state(sta.pressed, sta.has-hover);
            animate background { duration: Theme.t-hover; }
        }
        focus := FocusScope {
            enabled: root.enabled;
            key-pressed(e) => {
                if e.text == Key.Return {
                    root.flip();
                    return accept;
                }
                reject
            }
        }
        sta := TouchArea {
            enabled: root.enabled;
            mouse-cursor: pointer;
            clicked => {
                focus.focus();
                root.flip();
            }
        }
        // The focus ring, just outside the track.
        if focus.has-focus: Rectangle {
            x: -3px;
            y: -3px;
            width: parent.width + 6px;
            height: parent.height + 6px;
            border-radius: self.height / 2;
            border-width: 2px;
            border-color: Theme.accent;
        }
        Rectangle {
            x: root.checked ? parent.width - self.width - 4px : 5px;
            y: (parent.height - self.height) / 2;
            width: root.checked ? 14px : 12px;
            height: self.width;
            border-radius: self.width / 2;
            background: root.checked ? Theme.on-solid : Theme.text2;
            animate x { duration: Theme.t-hover; easing: ease-out; }
        }
    }
}

// An accent: a dot of its colour, ringed in `text1` when it's the one picked.
component Swatch inherits Rectangle {
    in property <brush> colour;
    in property <string> name;
    in property <bool> selected;
    callback clicked();
    width: 32px;
    height: 32px;
    border-radius: self.height / 2;
    // Animated as a private property: a root animating a public one is copied into each use.
    property <brush> ground: Theme.state(ta.pressed, ta.has-hover);
    animate ground { duration: Theme.t-hover; }
    background: root.ground;
    border-width: root.selected ? 2px : 0px;
    border-color: Theme.text1;
    accessible-role: radio-button;
    accessible-label: root.name;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-action-default => { root.clicked(); }
    Rectangle {
        width: 22px;
        height: 22px;
        border-radius: self.height / 2;
        background: root.colour;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The custom colour's hue: a strip of every hue at the slider's lightness and chroma
// (`follow::hue_colour`), and a thumb. Dragging shows the colour live and saves it on
// release; the arrow keys step 5 degrees and save.
component HueSlider inherits Rectangle {
    in property <float> hue;
    property <length> knob: 20px;
    height: 24px;
    accessible-role: slider;
    accessible-label: @tr("Hue");
    accessible-value: @tr("{n} degree" | "{n} degrees" % Math.round(root.hue));
    accessible-value-minimum: 0;
    accessible-value-maximum: 360;
    accessible-value-step: 5;
    accessible-action-increment => { root.step(5); }
    accessible-action-decrement => { root.step(-5); }

    function step(by: float) {
        SettingsData.custom-hue-moved(mod(root.hue + by + 360, 360), true);
    }
    function at(x: length, done: bool) {
        let usable = root.width - root.knob;
        SettingsData.custom-hue-moved(((x - root.knob / 2) / usable).clamp(0, 1) * 359.9, done);
    }

    Rectangle {
        x: root.knob / 2 - 6px;
        y: (parent.height - self.height) / 2;
        width: parent.width - root.knob + 12px;
        height: 12px;
        border-radius: self.height / 2;
        background: @linear-gradient(90deg,
            oklch(0.65, 0.16, 0) 0%, oklch(0.65, 0.16, 30) 8.33%, oklch(0.65, 0.16, 60) 16.67%,
            oklch(0.65, 0.16, 90) 25%, oklch(0.65, 0.16, 120) 33.33%, oklch(0.65, 0.16, 150) 41.67%,
            oklch(0.65, 0.16, 180) 50%, oklch(0.65, 0.16, 210) 58.33%, oklch(0.65, 0.16, 240) 66.67%,
            oklch(0.65, 0.16, 270) 75%, oklch(0.65, 0.16, 300) 83.33%, oklch(0.65, 0.16, 330) 91.67%,
            oklch(0.65, 0.16, 360) 100%);
    }
    focus := FocusScope {
        key-pressed(e) => {
            if e.text == Key.RightArrow || e.text == Key.UpArrow {
                root.step(5);
                return accept;
            }
            if e.text == Key.LeftArrow || e.text == Key.DownArrow {
                root.step(-5);
                return accept;
            }
            reject
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                focus.focus();
                root.at(self.mouse-x, false);
            }
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.up {
                root.at(self.mouse-x, true);
            }
        }
        moved => {
            if self.pressed {
                root.at(self.mouse-x, false);
            }
        }
    }
    // The thumb, in the slider's colour at this hue, ringed so it reads on any hue.
    Rectangle {
        x: root.hue / 360 * (parent.width - root.knob);
        y: (parent.height - self.height) / 2;
        width: root.knob;
        height: root.knob;
        border-radius: self.height / 2;
        background: oklch(0.65, 0.16, root.hue);
        border-width: 2px;
        border-color: Theme.text1;
    }
    if focus.has-focus: Rectangle {
        x: root.hue / 360 * (parent.width - root.knob) - 4px;
        y: (parent.height - self.height) / 2;
        width: root.knob + 8px;
        height: root.knob + 8px;
        border-radius: self.height / 2;
        border-width: 2px;
        border-color: Theme.accent;
    }
}

// A one-line text field (hotkeys).
export component Field inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <string> label;
    in property <bool> enabled: true;
    in property <InputType> input-type: InputType.text;
    callback committed(string);
    // Enter in the field.
    callback accepted();
    public function grab-focus() {
        input.focus();
    }
    public function select-all() {
        input.select-all();
    }
    height: 36px;
    // The field, the root's size, dimmed as a group here: Slint copies a component whose root
    // has an opacity into every place it's used.
    Rectangle {
        border-radius: Theme.r-m;
        background: Theme.field;
        border-width: input.has-focus ? 1px : (Theme.dark ? 0px : 1px);
        border-color: input.has-focus ? Theme.accent : Theme.hairline;
        opacity: root.enabled ? 1.0 : 0.4;
        TouchArea {
            enabled: root.enabled;
            mouse-cursor: MouseCursor.text;
            clicked => { input.focus(); }
        }
        if input.text == "": Body {
            // Starts just past the text cursor, so the cursor never draws over its first
            // letter.
            x: 12px + input.text-cursor-width + 2px;
            width: parent.width - self.x - 12px;
            height: parent.height;
            text: root.placeholder;
            color: Theme.text3;
            vertical-alignment: center;
        }
        input := TextInput {
            x: 12px;
            width: parent.width - 24px;
            height: parent.height;
            text <=> root.text;
            enabled: root.enabled;
            input-type: root.input-type;
            single-line: true;
            vertical-alignment: center;
            font-family: Theme.body-font;
            font-size: Theme.t-body;
            color: Theme.text1;
            selection-background-color: Theme.accent;
            selection-foreground-color: Theme.on-solid;
            accessible-label: root.label;
            accepted => {
                root.committed(self.text);
                root.accepted();
            }
            changed has-focus => {
                if !self.has-focus {
                    root.committed(self.text);
                }
            }
        }
    }
}

// The custom colour, under the Accent row while it's picked: the colour as this theme
// shows it, the hue slider and the hex field. A line below says when the theme adjusts the
// colour to keep it visible, or why a typed code was refused.
component CustomPicker inherits VerticalLayout {
    property <string> note: Theme.dark ? SettingsData.custom-note-dark : SettingsData.custom-note-light;
    padding-bottom: Theme.s4;
    spacing: Theme.s2;
    HorizontalLayout {
        spacing: Theme.s4;
        Rectangle {
            width: 36px;
            height: 36px;
            border-radius: self.height / 2;
            background: Theme.accent;
            accessible-role: image;
            accessible-label: @tr("Custom colour as shown");
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            HueSlider {
                hue: SettingsData.custom-hue;
            }
        }
        Field {
            width: 112px;
            text <=> SettingsData.custom-hex;
            label: @tr("Colour code");
            placeholder: "#4390EE";
            committed(t) => { SettingsData.custom-hex-entered(t); }
        }
    }
    if SettingsData.custom-error != "": Body {
        text: SettingsData.custom-error;
        font-size: Theme.t-meta;
        color: Theme.text1;
        wrap: word-wrap;
    }
    if SettingsData.custom-error == "" && root.note != "": Body {
        text: root.note;
        font-size: Theme.t-meta;
        color: Theme.text2;
        wrap: word-wrap;
    }
}

// The preview's type: the main lines (the name, the title) and the lines under them (the
// status, the artist, the time).
global PreviewType {
    out property <length> main-size: Theme.t-body;
    out property <int> main-weight: 600;
    out property <color> main-color: Theme.text1;
    out property <length> sub-size: Theme.t-meta;
    out property <color> sub-color: Theme.text2;
}

component PreviewSub inherits Body {
    font-size: PreviewType.sub-size;
    color: PreviewType.sub-color;
}

// "Listening to featherplay", over the activity as Discord heads it: small and bold, in the
// plain text colour (not the cover's tint, which made it read as a link).
component PreviewHeading inherits Body {
    font-size: PreviewType.sub-size;
    font-weight: 600;
    color: Theme.text1;
}

// The title (a main line) or the artist (a line under): one line, elided. With the Links
// option on, Discord underlines it under the pointer (it's plain otherwise), and so does the
// preview.
component PreviewLine inherits Rectangle {
    in property <string> text;
    in property <bool> link;
    in property <bool> main;
    min-height: t.min-height;
    preferred-height: t.preferred-height;
    min-width: 0px;
    horizontal-stretch: 1;
    t := Body {
        width: parent.width;
        height: parent.height;
        text: root.text;
        font-size: root.main ? PreviewType.main-size : PreviewType.sub-size;
        font-weight: root.main ? PreviewType.main-weight : 400;
        color: root.main ? PreviewType.main-color : PreviewType.sub-color;
    }
    if root.link: hover := TouchArea {
        x: 0;
        width: min(t.preferred-width, root.width);
        if hover.has-hover: Rectangle {
            x: 0;
            y: parent.height - 2px;
            height: 1px;
            background: t.color;
        }
    }
}

// A lit part's mark: the accent's tonal fill and a thin outline in the accent, eased in and
// out over `t-fast`; clear while the part isn't lit.
component LitMark inherits Rectangle {
    in property <bool> lit;
    border-width: 1px;
    // Animated as private properties: a root animating public ones is copied into each use.
    property <brush> ground: root.lit ? Theme.accent-tonal : Theme.accent-tonal.transparentize(1);
    property <brush> edge: root.lit ? Theme.accent : Theme.accent.transparentize(1);
    animate ground, edge { duration: Theme.t-fast; easing: Curves.ease-hover; }
    background: root.ground;
    border-color: root.edge;
}

// A part of the card an option changes (the time, the title and artist), marked round its
// edge while the option is hovered.
component LitPart inherits Rectangle {
    in property <bool> lit;
    // How far the mark reaches past the part, across and up and down.
    property <length> reach: 8px;
    property <length> rise: 4px;
    min-width: lay.min-width;
    preferred-width: lay.preferred-width;
    min-height: lay.min-height;
    preferred-height: lay.preferred-height;
    horizontal-stretch: 1;
    LitMark {
        x: -root.reach;
        y: -root.rise;
        width: parent.width + 2 * root.reach;
        height: parent.height + 2 * root.rise;
        border-radius: Theme.r-s + root.rise;
        lit: root.lit;
    }
    lay := VerticalLayout {
        @children
    }
}

// The profile card: how friends see you on Discord with these options, drawn in the app's
// own style (no Discord marks or colours) at about the size of Discord's profile card. A
// banner in the playing cover's colours (the accent's for the sample), the avatar over its
// edge with the online dot, "You" and the status line; then the activity as the profile
// shows it. `lit` marks the part an option changes. The time follows the player's
// once-a-second position; nothing else moves.
component ProfileCard inherits Rectangle {
    in property <DiscordPart> lit;
    property <DiscordPreview> p: SettingsData.discord-preview;
    property <bool> live: !root.p.sample && Player.has-track;
    property <float> at: root.live ? Player.position-s : 72;
    property <float> total: root.live ? Player.duration-s : 210;
    // The stage's wash from the cover (`NowPlayingData`); clear until it's known.
    property <color> wash: Theme.dark ? NowPlayingData.wash-dark : NowPlayingData.wash-light;
    property <bool> tinted: root.live && root.wash.alpha > 0;
    // The banner's two ends: the cover's wash into its accent while the accent follows the
    // cover, else into a lighter step of the wash; the sample's (and grey art's) go from a
    // deep step of the accent into the accent, so they read as a banner, not a placeholder.
    property <color> from: root.tinted ? root.wash.with-alpha(1) : Theme.accent.darker(0.6);
    property <color> to: !root.tinted || Theme.follow ? Theme.accent : root.wash.with-alpha(1).brighter(0.4);
    animate from, to { duration: Theme.t-colour; easing: Curves.ease-hover; }
    property <length> pad: Theme.s4;
    // About Discord's own proportions (a 340 px card, a 120 px banner, an 80 px avatar), a
    // little flatter so the activity stays the card's subject.
    property <length> banner-h: 112px;
    // The photo inside the ring is 76 px, the size `src/sidebar.rs` decodes it at.
    property <length> avatar: 88px;
    property <length> ring: 6px;
    property <length> cover: 80px;
    property <length> badge: 26px;
    property <bool> photo: SidebarData.signed-in && SidebarData.has-avatar;
    min-height: lay.min-height;
    preferred-height: lay.preferred-height;
    min-width: lay.min-width;
    border-radius: Theme.r-l;
    background: Theme.ground;
    border-width: 1px;
    border-color: Theme.card-edge;
    drop-shadow-blur: 24px;
    drop-shadow-offset-y: 8px;
    drop-shadow-color: Theme.cover-shadow;
    accessible-role: groupbox;
    accessible-label: @tr("Discord preview");

    Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: root.banner-h;
        border-top-left-radius: Theme.r-l - 1px;
        border-top-right-radius: Theme.r-l - 1px;
        background: @linear-gradient(120deg, root.from 0%, root.to 100%);
    }
    // The avatar: the signed-in account's photo, as the sidebar shows it (most people use the
    // same face on Discord), or a neutral person signed out, without a photo or until it
    // loads. Ringed in the card's ground where it overhangs the banner, the online dot on its
    // edge.
    Rectangle {
        x: root.pad;
        y: root.banner-h - root.avatar / 2;
        width: root.avatar;
        height: root.avatar;
        border-radius: self.width / 2;
        background: Theme.avatar;
        border-width: root.ring;
        border-color: Theme.ground;
        Icon {
            width: 36px;
            height: 36px;
            commands: Icons.person;
            stroke: Theme.text1;
        }
        // Over the person, once it's there: a plain clipped image, as it never fades or
        // crossfades and needs none of `Cover`'s machinery.
        Rectangle {
            x: root.ring;
            y: root.ring;
            width: parent.width - 2 * root.ring;
            height: self.width;
            border-radius: self.width / 2;
            clip: true;
            visible: root.photo;
            accessible-role: image;
            accessible-label: @tr("Your profile picture");
            Image {
                width: parent.width;
                height: parent.height;
                source: SidebarData.avatar;
                image-fit: ImageFit.cover;
            }
        }
        Rectangle {
            x: parent.width - self.width - 2px;
            y: parent.height - self.height - 2px;
            width: 24px;
            height: 24px;
            border-radius: self.width / 2;
            background: Theme.verified;
            border-width: 5px;
            border-color: Theme.ground;
        }
    }

    lay := VerticalLayout {
        padding-top: root.banner-h + root.avatar / 2 + Theme.s2;
        padding-bottom: root.pad;
        spacing: Theme.s4;
        VerticalLayout {
            padding-left: root.pad;
            padding-right: root.pad;
            spacing: Theme.s1;
            Display {
                text: @tr("You");
                font-size: Theme.t-display-xs;
            }
            // The status line, as a pill under the name.
            HorizontalLayout {
                alignment: start;
                Rectangle {
                    border-radius: Theme.r-s + 2px;
                    background: Theme.hover;
                    min-width: 0px;
                    preferred-width: status.preferred-width + 2 * Theme.s2;
                    LitMark {
                        border-radius: parent.border-radius;
                        lit: root.lit == DiscordPart.status;
                    }
                    HorizontalLayout {
                        padding-left: Theme.s2;
                        padding-right: Theme.s2;
                        padding-top: 3px;
                        padding-bottom: 3px;
                        status := PreviewSub {
                            text: root.p.status;
                            color: root.lit == DiscordPart.status ? Theme.text1 : PreviewType.sub-color;
                        }
                    }
                }
            }
        }
        // The activity: its heading, the cover with the app's badge on its corner and beside
        // it the title, the artist and the album (and the time elapsed); then the progress
        // bar and the button across the block, as Discord lays them out.
        HorizontalLayout {
            padding-left: root.pad;
            padding-right: root.pad;
            Rectangle {
                border-radius: Theme.r-m + 2px;
                background: Theme.panel;
                LitMark {
                    border-radius: parent.border-radius;
                    lit: root.lit == DiscordPart.activity;
                }
                VerticalLayout {
                    padding: Theme.s3 + 2px;
                    spacing: Theme.s3;
                    PreviewHeading {
                        text: @tr("Listening to featherplay");
                    }
                    HorizontalLayout {
                        spacing: Theme.s3 + 2px;
                        VerticalLayout {
                            alignment: start;
                            Rectangle {
                                width: root.cover;
                                height: root.cover;
                                Cover {
                                    width: parent.width;
                                    height: parent.height;
                                    radius: Theme.r-m;
                                    source: root.live ? Player.cover : @image-url("");
                                }
                                // A small badge, so the art stays whole, ringed in the block's
                                // colour where it overhangs the corner.
                                Rectangle {
                                    x: parent.width - self.width + Theme.s1 + 2px;
                                    y: parent.height - self.height + Theme.s1 + 2px;
                                    width: root.badge;
                                    height: root.badge;
                                    border-radius: self.width / 2;
                                    background: Theme.ground;
                                    border-width: 3px;
                                    border-color: Theme.panel;
                                    Image {
                                        width: 14px;
                                        height: 14px;
                                        source: Theme.dark ? @image-url("../logo/tri-vane-16.svg") : @image-url("../logo/tri-vane-light-16.svg");
                                    }
                                }
                            }
                        }
                        // Centred on the cover, however many lines the options leave.
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            LitPart {
                                lit: root.lit == DiscordPart.links;
                                PreviewLine {
                                    text: root.p.title;
                                    link: root.p.title-link;
                                    main: true;
                                }
                                PreviewLine {
                                    text: root.p.artist;
                                    link: root.p.artist-link;
                                }
                            }
                            if root.p.album != "": PreviewSub {
                                text: root.p.album;
                            }
                            if root.p.time == 1: LitPart {
                                lit: root.lit == DiscordPart.time;
                                PreviewSub {
                                    text: @tr("{} elapsed", Player.clock(root.at));
                                }
                            }
                        }
                    }
                    if root.p.time == 0: LitPart {
                        lit: root.lit == DiscordPart.time;
                        HorizontalLayout {
                            spacing: Theme.s2 + 2px;
                            PreviewSub {
                                text: Player.clock(root.at);
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                                Rectangle {
                                    y: (parent.height - self.height) / 2;
                                    height: 4px;
                                    border-radius: 2px;
                                    background: Theme.track;
                                }
                                Rectangle {
                                    x: 0;
                                    y: (parent.height - self.height) / 2;
                                    width: parent.width * (root.at / max(root.total, 1)).clamp(0, 1);
                                    height: 4px;
                                    border-radius: 2px;
                                    background: Theme.text1;
                                }
                            }
                            PreviewSub {
                                text: Player.clock(root.total);
                            }
                        }
                    }
                    // The button, only when the option is on: across the block as Discord
                    // draws it. A picture of the button, so it has no hover, and a fill a step
                    // quieter than the app's own buttons. Under it, why you won't find it on
                    // your own profile: Discord hides an activity's buttons from its user.
                    if root.p.button != "": VerticalLayout {
                        spacing: Theme.s2;
                        Rectangle {
                            height: 34px;
                            border-radius: Theme.r-s + 2px;
                            background: Theme.hover;
                            LitMark {
                                border-radius: parent.border-radius;
                                lit: root.lit == DiscordPart.button;
                            }
                            Body {
                                text: root.p.button;
                                font-size: Theme.t-meta;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        Body {
                            text: @tr("Discord shows this button to others, not to you.");
                            font-size: Theme.t-meta;
                            color: Theme.text3;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }
    // Discord status, which shows the card at all: a ring round the whole card.
    Rectangle {
        border-radius: root.border-radius;
        border-width: 2px;
        border-color: root.lit == DiscordPart.card ? Theme.accent : Theme.accent.transparentize(1);
        animate border-color { duration: Theme.t-fast; easing: Curves.ease-hover; }
    }
}

// The Discord options' preview: a caption saying whose view it is (or why it's dimmed), the
// profile card, and a note on how it follows the options. Dimmed, with nothing lit, while
// Discord status is off or not connected. Beside the options (or above them in a narrow
// window), the caption, the card and the note are a column `card-w` wide, so the note wraps
// at the card's width. With `text-beside`, the pane is a row like the options': the caption as
// its label and the note as its detail on the left, the card on the right, at the switches'
// edge.
component DiscordPane inherits Rectangle {
    in property <length> card-w;
    in property <bool> text-beside;
    property <bool> on: SettingsData.discord-live;
    property <string> caption: root.on ? @tr("Preview · how friends see you")
        : SettingsData.discord-state == DiscordState.unavailable ? @tr("Preview · This build has no Discord app ID")
        : !SettingsData.discord ? @tr("Preview · Discord status is off")
        : SettingsData.discord-state == DiscordState.connecting ? @tr("Preview · Connecting to Discord…")
        : @tr("Preview · Not connected to Discord");
    property <string> note: SettingsData.discord-preview.sample
        ? @tr("Nothing is playing, so a sample song stands in. Hover an option to see what it changes.")
        : @tr("Hover an option to see what it changes.");
    // Placed by hand rather than in layouts, so the two arrangements share their three parts.
    property <length> text-w: root.text-beside ? root.width - root.card-w - Theme.s6 : root.card-w;
    preferred-height: root.text-beside ? max(card.y + card.height, note.y + note.height) : note.y + note.height;
    caption := Body {
        x: 0;
        y: 0;
        width: root.text-w;
        height: self.preferred-height;
        text: root.caption;
        font-size: root.text-beside ? Theme.t-body-l : Theme.t-meta;
        font-weight: root.text-beside ? 500 : 400;
        color: root.text-beside ? Theme.text1 : Theme.text3;
        wrap: word-wrap;
    }
    card := ProfileCard {
        x: root.text-beside ? root.width - root.card-w : 0;
        y: root.text-beside ? 0 : caption.height + Theme.s3;
        width: root.card-w;
        height: self.preferred-height;
        lit: SettingsData.discord-card-lit;
        opacity: root.on ? 1 : 0.5;
    }
    note := Body {
        x: 0;
        y: root.text-beside ? caption.height + Theme.s1 : card.y + card.height + Theme.s3;
        width: root.text-w;
        height: self.preferred-height;
        text: root.note;
        font-size: Theme.t-meta;
        color: root.text-beside ? Rows.detail : Theme.text3;
        wrap: word-wrap;
    }
}

// A Discord option's rows: hovering them lights the part of the profile card the option
// changes (`SettingsData.discord-lit`), and tints the rows a shade.
component DiscordOption inherits Rectangle {
    in property <DiscordPart> part;
    // Unique among the options.
    in property <int> option;
    min-height: lay.min-height;
    preferred-height: lay.preferred-height;
    Rectangle {
        x: -Theme.s3;
        width: parent.width + 2 * Theme.s3;
        border-radius: Theme.r-m;
        background: ta.has-hover ? Theme.choice-lit : Theme.choice-lit.transparentize(1);
        animate background { duration: Theme.t-hover; easing: Curves.ease-hover; }
    }
    ta := TouchArea {
        changed has-hover => {
            if self.has-hover {
                SettingsData.discord-lit = root.part;
                SettingsData.discord-lit-option = root.option;
            } else if SettingsData.discord-lit-option == root.option {
                SettingsData.discord-lit = DiscordPart.none;
                SettingsData.discord-lit-option = -1;
            }
        }
        lay := VerticalLayout {
            @children
        }
    }
}

// The rows' measures, shared by the groups and the section index (which lines its first
// entry up with the first group's title).
global Rows {
    out property <length> title-h: 32px;
    out property <length> link-h: 36px;
    // Inside a group's panel, left and right: the labels' indent and the controls' inset.
    out property <length> inset: Theme.s5;
    // Above a panel's first row.
    out property <length> pad-top: 4px;
    out property <length> pad-y: 18px;
    // The detail under a label: a step brighter than `text2`, still from it (so it keeps the
    // cover's tint while the accent follows it), for a clearer read on the panel.
    out property <color> detail: Theme.text2.mix(Theme.text1, 0.75);
}

// A group heading above its rows.
component GroupTitle inherits Display {
    font-size: 20px;
    height: Rows.title-h;
    vertical-alignment: center;
}

// A group of settings: its title, then its rows on a rounded panel. The panel can reach
// `extend` past the column on the right (Discord, with its card beside the options).
component Group inherits VerticalLayout {
    in property <string> title;
    in property <length> extend: 0px;
    spacing: Theme.s3;
    GroupTitle {
        text: root.title;
    }
    Rectangle {
        min-width: max(0px, rows.min-width - root.extend);
        min-height: rows.min-height;
        preferred-height: rows.preferred-height;
        Rectangle {
            x: 0;
            width: parent.width + root.extend;
            height: parent.height;
            accessible-role: groupbox;
            accessible-label: root.title;
            border-radius: Theme.r-l;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.card-edge;
            rows := VerticalLayout {
                padding-top: Rows.pad-top;
                padding-bottom: 4px;
                padding-left: Rows.inset;
                padding-right: Rows.inset;
                @children
            }
        }
    }
}

// A setting row's hairline on top, and its label with the detail under it. Their own
// components, so they're compiled once: `SettingRow` takes its controls as children, so
// Slint copies it into every row.
component RowDivider {
    in property <bool> shown;
    if root.shown: Rectangle {
        y: 0;
        height: 1px;
        background: Theme.hairline;
    }
}

component RowLabel inherits VerticalLayout {
    in property <string> label;
    in property <string> detail;
    alignment: center;
    spacing: Theme.s1;
    Body {
        text: root.label;
        font-size: Theme.t-body-l;
        font-weight: 500;
        overflow: clip;
        wrap: word-wrap;
    }
    if root.detail != "": Body {
        text: root.detail;
        font-size: Theme.t-meta;
        color: Rows.detail;
        overflow: clip;
        wrap: word-wrap;
    }
}

// One setting: its name and a line of detail on the left, the control on the right.
component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in property <bool> divider: true;
    min-height: lay.min-height;
    preferred-height: lay.preferred-height;
    RowDivider {
        shown: root.divider;
    }
    lay := HorizontalLayout {
        padding-top: Rows.pad-y;
        padding-bottom: Rows.pad-y;
        spacing: Theme.s6;
        RowLabel {
            horizontal-stretch: 1;
            label: root.label;
            detail: root.detail;
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            HorizontalLayout {
                alignment: end;
                spacing: Theme.s2;
                @children
            }
        }
    }
}

// A row with a switch.
component ToggleRow inherits SettingRow {
    in property <SettingKey> key;
    in property <bool> checked;
    in property <bool> enabled: true;
    Switch {
        checked: root.checked;
        label: root.label;
        enabled: root.enabled;
        toggled(on) => { SettingsData.toggled(root.key, on); }
    }
}

// A small pill for row controls.
component RowButton inherits Pill {
    height: 32px;
}

// Chips in a row, as small as its buttons.
component RowChips inherits Chips {
    height: 32px;
}

// The Equalizer dialog's measures. Everything in it has a fixed size, so it's placed by
// these rather than by layouts (each layout costs the exe code).
global Eq {
    // A band's value line, then its rail between two 12 px margins, then its frequency.
    out property <length> value-h: 20px;
    out property <length> rail-h: 176px;
    out property <length> rail-top: self.value-h + Theme.s3;
    out property <length> label-y: self.rail-top + self.rail-h + Theme.s3;
    out property <length> height: self.label-y + 16px;
    out property <length> zero-y: self.rail-top + self.rail-h / 2;
    // The +12 / 0 / −12 scale left of the bands.
    out property <length> scale-w: 34px;
}

// One band of the Equalizer dialog: its value, an upright slider, and its frequency. The
// rail is the volume slider's turned upright, filled in the accent from the 0 dB line to the
// thumb. A press or a drag sets it in 1 dB steps, live; a double click puts it back at 0 dB.
// Keys: Up and Down 1 dB, Page Up and Page Down 3 dB, Home 0 dB (Tab moves between bands).
component EqBand inherits Rectangle {
    in property <string> label;
    in property <int> value;
    callback moved(int);
    property <length> knob: 18px;
    // The thumb's centre.
    property <length> thumb-y: Eq.rail-top + (1 - (root.value + 12) / 24) * Eq.rail-h;
    property <string> signed: root.value > 0 ? "+" + root.value : root.value < 0 ? "−" + (-root.value) : "0";
    height: Eq.height;

    function set(v: int) {
        let c = clamp(v, -12, 12);
        if c != root.value {
            root.moved(c);
        }
    }
    // A press or a drag at `y` from the band's top.
    function at(y: length) {
        root.set(round(12 - (y - Eq.rail-top) / Eq.rail-h * 24));
    }

    Body {
        y: 0;
        height: Eq.value-h;
        text: root.signed;
        font-size: Theme.t-meta;
        font-weight: root.value == 0 ? 400 : 600;
        color: root.value == 0 ? Theme.text3 : Theme.text1;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    // The slider for screen readers is the element that takes the focus: "60 Hz, +6 dB".
    focus := FocusScope {
        accessible-role: slider;
        accessible-label: root.label;
        accessible-value: @tr("{} dB", root.signed);
        accessible-value-minimum: -12;
        accessible-value-maximum: 12;
        accessible-value-step: 1;
        accessible-action-increment => { root.set(root.value + 1); }
        accessible-action-decrement => { root.set(root.value - 1); }
        key-pressed(e) => {
            if e.text == Key.UpArrow || e.text == Key.RightArrow {
                root.set(root.value + 1);
                return accept;
            }
            if e.text == Key.DownArrow || e.text == Key.LeftArrow {
                root.set(root.value - 1);
                return accept;
            }
            if e.text == Key.PageUp {
                root.set(root.value + 3);
                return accept;
            }
            if e.text == Key.PageDown {
                root.set(root.value - 3);
                return accept;
            }
            if e.text == Key.Home {
                root.set(0);
                return accept;
            }
            reject
        }
    }
    TouchArea {
        y: Eq.value-h;
        height: Eq.rail-h + 2 * Theme.s3;
        mouse-cursor: pointer;
        pointer-event(e) => {
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                focus.focus();
                root.at(self.y + self.mouse-y);
            }
        }
        moved => {
            if self.pressed {
                root.at(self.y + self.mouse-y);
            }
        }
        double-clicked => { root.set(0); }
    }
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: Eq.rail-top;
        width: 4px;
        height: Eq.rail-h;
        border-radius: 2px;
        background: Theme.track;
    }
    // The fill, from the 0 dB line to the thumb.
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: min(root.thumb-y, Eq.zero-y);
        width: 4px;
        height: abs(root.thumb-y - Eq.zero-y);
        border-radius: 2px;
        background: Theme.accent;
    }
    // The focus ring, 3 px out from the thumb.
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: root.thumb-y - self.height / 2;
        width: root.knob + 10px;
        height: self.width;
        border-radius: self.height / 2;
        border-width: 2px;
        border-color: focus.has-focus ? Theme.accent : transparent;
    }
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: root.thumb-y - self.height / 2;
        width: root.knob;
        height: root.knob;
        border-radius: self.height / 2;
        // White in both themes, edged on the light panel.
        background: Theme.dark ? Theme.text1 : #FFFFFF;
        border-width: Theme.dark ? 0px : 1px;
        border-color: #0000002A;
        drop-shadow-blur: 4px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: Theme.dark ? #0006 : #0003;
    }
    Body {
        y: Eq.label-y;
        text: root.label;
        font-size: Theme.t-meta;
        color: Theme.text2;
        horizontal-alignment: center;
    }
}

// The Equalizer dialog's five bands, beside a +12 / 0 / −12 scale, over the 0 dB line.
component EqBands inherits Rectangle {
    property <length> band-w: (self.width - Eq.scale-w) / 5;
    height: Eq.height;
    Rectangle {
        x: Eq.scale-w;
        y: Eq.zero-y;
        width: parent.width - Eq.scale-w;
        height: 1px;
        background: Theme.hairline;
    }
    for mark[i] in ["+12", "0", "−12"]: Body {
        x: 0;
        y: Eq.zero-y + (i - 1) * Eq.rail-h / 2 - self.height / 2;
        width: Eq.scale-w - Theme.s2;
        text: mark;
        font-size: 11px;
        color: Theme.text3;
        horizontal-alignment: right;
    }
    for v[i] in SettingsData.eq-bands: EqBand {
        x: Eq.scale-w + i * root.band-w;
        y: 0;
        width: root.band-w;
        label: [@tr("60 Hz"), @tr("250 Hz"), @tr("1 kHz"), @tr("4 kHz"), @tr("12 kHz")][i];
        value: v;
        moved(to) => { SettingsData.eq-band-moved(i, to); }
    }
}


// One output device: a radio mark and the name.
component DeviceRow inherits Rectangle {
    in property <string> name;
    in property <bool> selected;
    callback clicked();
    height: 40px;
    border-radius: Theme.r-m;
    // Animated as a private property: a root animating a public one is copied into each use.
    property <brush> ground: Theme.state(ta.pressed, ta.has-hover);
    animate ground { duration: Theme.t-hover; }
    background: root.ground;
    accessible-role: radio-button;
    accessible-label: root.name;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-action-default => { root.clicked(); }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Rectangle {
        x: 10px;
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        border-width: root.selected ? 5px : 1.5px;
        border-color: root.selected ? Theme.accent : Theme.text3;
        animate border-width, border-color { duration: Theme.t-hover; }
    }
    Body {
        x: 40px;
        width: parent.width - 48px;
        height: parent.height;
        text: root.name;
        color: root.selected ? Theme.text1 : Theme.text2;
        vertical-alignment: center;
    }
}

// The pause timeout: shorter, the minutes, longer.
component MinutesStepper inherits HorizontalLayout {
    in property <int> minutes;
    in property <bool> enabled: true;
    spacing: Theme.s2;
    RowButton {
        label: "−";
        accessible-label: @tr("Shorter");
        enabled: root.enabled;
        clicked => { SettingsData.discord-step-minutes(-1); }
    }
    Body {
        min-width: 56px;
        text: @tr("{n} min" | "{n} min" % root.minutes);
        color: root.enabled ? Theme.text1 : Theme.text3;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    RowButton {
        label: "+";
        accessible-label: @tr("Longer");
        enabled: root.enabled;
        clicked => { SettingsData.discord-step-minutes(1); }
    }
}

component HotkeyRow inherits Rectangle {
    in property <string> label;
    in property <int> index;
    in-out property <string> text;
    in property <string> placeholder;
    height: 44px;
    Body {
        x: 0;
        width: parent.width - 220px;
        height: parent.height;
        text: root.label;
        color: Theme.text2;
        vertical-alignment: center;
    }
    Field {
        x: parent.width - self.width;
        y: (parent.height - self.height) / 2;
        width: 200px;
        text <=> root.text;
        placeholder: root.placeholder;
        label: @tr("{} hotkey", root.label);
        committed(t) => { SettingsData.hotkey-edited(root.index, t); }
    }
}

// A labelled field in a dialog (Settings', and the playlist menu's Rename).
export component DialogField inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    in property <InputType> input-type: InputType.text;
    in-out property <string> text;
    callback accepted();
    public function grab-focus() {
        field.grab-focus();
    }
    public function select-all() {
        field.select-all();
    }
    spacing: Theme.s1;
    Body {
        text: root.label;
        font-size: Theme.t-meta;
        color: Theme.text2;
    }
    field := Field {
        text <=> root.text;
        label: root.label;
        placeholder: root.placeholder;
        input-type: root.input-type;
        accepted => { root.accepted(); }
    }
}

// A dialog's title and detail, and its error and buttons, around its fields: their own
// components, compiled once (`Dialog` takes the fields as children, so Slint copies it into
// every dialog). Their spacing is the card's, so the lines sit as they would in it.
component DialogHead inherits VerticalLayout {
    in property <string> title;
    in property <string> detail;
    spacing: Theme.s4;
    Display {
        text: root.title;
        font-size: 20px;
        // A long playlist name in "Delete “…”?" wraps rather than being cut.
        wrap: word-wrap;
    }
    if root.detail != "": Body {
        text: root.detail;
        color: Theme.text2;
        wrap: word-wrap;
    }
}

component DialogFoot inherits VerticalLayout {
    in property <string> error;
    in property <string> extra;
    in property <string> ok-label;
    callback ok();
    callback cancel();
    callback extra-clicked();
    spacing: Theme.s4;
    if root.error != "": Body {
        text: root.error;
        font-size: Theme.t-meta;
        color: Theme.text1;
        wrap: word-wrap;
    }
    HorizontalLayout {
        padding-top: Theme.s2;
        spacing: Theme.s2;
        if root.extra != "": RowButton {
            label: root.extra;
            clicked => { root.extra-clicked(); }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        RowButton {
            label: @tr("Cancel");
            clicked => { root.cancel(); }
        }
        RowButton {
            label: root.ok-label;
            solid: true;
            clicked => { root.ok(); }
        }
    }
}

// A dialog over the page: a scrim, and a card with a title, a line of detail, the fields
// (children) and the buttons. Escape or a click on the scrim cancels. Settings' dialogs, and
// the playlist menu's Rename and Delete.
export component Dialog inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <string> error;
    // A quiet button on the left ("Remove …"), shown when not empty.
    in property <string> extra;
    // The confirming button names its action ("Rename", "Delete").
    in property <string> ok-label: @tr("OK");
    callback ok();
    callback cancel();
    callback extra-clicked();
    // For a dialog without a field: Escape reaches it at once.
    public function focus-keys() {
        keys.focus();
    }
    property <bool> shown: false;
    background: Theme.scrim;
    opacity: root.shown ? 1 : 0;
    animate opacity { duration: Theme.t-menu; easing: Curves.ease-out; }
    init => { root.shown = true; }
    keys := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape {
                root.cancel();
                return accept;
            }
            reject
        }
        TouchArea {
            clicked => { root.cancel(); }
            // The page under the scrim doesn't scroll.
            scroll-event(e) => { accept }
        }
        card := Rectangle {
            width: min(460px, root.width - 2 * Theme.s5);
            height: lay.preferred-height;
            x: (root.width - self.width) / 2;
            y: max(Theme.s5, (root.height - self.height) / 2 - Theme.s6);
            border-radius: Theme.r-l;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.card-edge;
            transform-scale: root.shown ? 1 : (Theme.moving ? 0.98 : 1);
            animate transform-scale { duration: Theme.t-menu; easing: Curves.ease-out; }
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: Theme.cover-shadow;
            accessible-role: groupbox;
            accessible-label: root.title;
            // Clicks on the card don't reach the scrim.
            TouchArea { }
            lay := VerticalLayout {
                padding: Theme.s5;
                spacing: Theme.s4;
                DialogHead {
                    title: root.title;
                    detail: root.detail;
                }
                @children
                DialogFoot {
                    error: root.error;
                    extra: root.extra;
                    ok-label: root.ok-label;
                    ok => { root.ok(); }
                    cancel => { root.cancel(); }
                    extra-clicked => { root.extra-clicked(); }
                }
            }
        }
    }
}

// The Equalizer's bands over the window, from its Custom… chip: `Dialog`'s scrim and card,
// with Reset (underlined) and Done instead of Cancel and OK, as the bands apply as they move.
// Done, Escape and a click on the scrim close it; Reset puts every band at 0 dB and the
// equalizer off. Its own component rather than options on `Dialog`, which is inlined into
// every dialog of the app.
component EqualizerDialog inherits Rectangle {
    property <bool> shown: false;
    background: Theme.scrim;
    opacity: root.shown ? 1 : 0;
    animate opacity { duration: Theme.t-menu; easing: Curves.ease-out; }
    init => {
        root.shown = true;
        keys.focus();
    }
    keys := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape {
                SettingsData.close-dialog();
                return accept;
            }
            reject
        }
        TouchArea {
            clicked => { SettingsData.close-dialog(); }
            // The page under the scrim doesn't scroll.
            scroll-event(e) => { accept }
        }
        Rectangle {
            width: min(460px, root.width - 2 * Theme.s5);
            height: lay.preferred-height;
            x: (root.width - self.width) / 2;
            y: max(Theme.s5, (root.height - self.height) / 2 - Theme.s6);
            border-radius: Theme.r-l;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.card-edge;
            transform-scale: root.shown ? 1 : (Theme.moving ? 0.98 : 1);
            animate transform-scale { duration: Theme.t-menu; easing: Curves.ease-out; }
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: Theme.cover-shadow;
            accessible-role: groupbox;
            accessible-label: @tr("Equalizer");
            // Clicks on the card don't reach the scrim.
            TouchArea { }
            lay := VerticalLayout {
                padding: Theme.s5;
                spacing: Theme.s4;
                Display {
                    text: @tr("Equalizer");
                    font-size: 20px;
                }
                Body {
                    text: @tr("Drag a band to change it. Boosts turn the overall level down a little, so nothing distorts.");
                    color: Theme.text2;
                    wrap: word-wrap;
                }
                EqBands { }
                // Reset on the left, Done on the right, as `Dialog`'s buttons sit.
                Rectangle {
                    height: Theme.s2 + 32px;
                    TextLink {
                        x: 0;
                        y: Theme.s2 + (32px - self.height) / 2;
                        text: @tr("Reset");
                        clicked => { SettingsData.eq-reset(); }
                    }
                    RowButton {
                        x: parent.width - self.width;
                        y: Theme.s2;
                        label: @tr("Done");
                        solid: true;
                        clicked => { SettingsData.close-dialog(); }
                    }
                }
            }
        }
    }
}

// A key in the shortcuts' list, as a keycap like the search field's Ctrl K: 22 px, a 1 px
// edge, 12/600 in `text2`. An empty key, between two keys that each do it, is the word "or".
component Keycap inherits Rectangle {
    in property <string> text;
    property <bool> word: root.text == "";
    height: 22px;
    min-width: root.word ? 0 : self.height;
    border-radius: Theme.r-s;
    border-width: root.word ? 0 : 1px;
    border-color: Theme.field-edge;
    background: root.word ? transparent : (Theme.dark ? #FFFFFF08 : Theme.ground);
    HorizontalLayout {
        padding-left: root.word ? 2px : 6px;
        padding-right: root.word ? 2px : 6px;
        Text {
            text: root.word ? @tr("or") : root.text;
            font-family: Theme.body-font;
            font-size: Theme.t-meta;
            font-weight: root.word ? 400 : 600;
            color: root.word ? Theme.text3 : Theme.text2;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// The shortcuts' list's measures: a row, a group's heading, a column.
global Keys {
    out property <length> row-h: 32px;
    out property <length> head-h: 30px;
    out property <length> column-w: 400px;
    // A group of `n` rows under its heading.
    public pure function group(n: int) -> length {
        return self.head-h + n * self.row-h;
    }
}

// A row of the list: what it does (with a quiet note, "Global hotkey"), then its keys, or a
// line of text instead (`instead`). A hairline above all but a group's first.
component KeyRow inherits Rectangle {
    in property <string> label;
    in property <string> note;
    in property <[string]> keys;
    in property <string> instead;
    in property <bool> divider: true;
    height: Keys.row-h;
    if root.divider: Rectangle {
        y: 0;
        height: 1px;
        background: Theme.hairline;
    }
    HorizontalLayout {
        spacing: Theme.s2;
        Body {
            text: root.label;
            vertical-alignment: center;
        }
        if root.note != "": Body {
            text: root.note;
            font-size: Theme.t-meta;
            color: Theme.text3;
            vertical-alignment: center;
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        if root.instead != "": Body {
            text: root.instead;
            font-size: Theme.t-meta;
            color: Theme.text3;
            vertical-alignment: center;
        }
        if root.keys.length > 0: HorizontalLayout {
            spacing: Theme.s1;
            padding-top: (Keys.row-h - 22px) / 2;
            padding-bottom: (Keys.row-h - 22px) / 2;
            for key in root.keys: Keycap {
                text: key;
            }
        }
    }
}

// A group's heading, 12/600 in `text2`, sitting on its first row.
component KeyGroup inherits Body {
    height: Keys.head-h;
    font-size: Theme.t-meta;
    font-weight: 600;
    color: Theme.text2;
    vertical-alignment: bottom;
}

component KeyList inherits VerticalLayout {
    in property <string> title;
    in property <[ShortcutRow]> rows;
    KeyGroup {
        text: root.title;
    }
    for row[i] in root.rows: KeyRow {
        label: row.label;
        keys: row.keys;
        divider: i > 0;
    }
}

// What works from any app: the media keys always, and the global hotkeys with the user's
// keys while they're on (otherwise a line says where to turn them on).
component FromAnyApp inherits VerticalLayout {
    KeyGroup {
        text: @tr("From any app");
    }
    KeyRow {
        label: @tr("Your keyboard's media keys");
        instead: @tr("play, pause, next, previous · always on");
        divider: false;
    }
    if SettingsData.hotkey-keys.length > 0: VerticalLayout {
        for label[i] in [@tr("Play or pause"), @tr("Next"), @tr("Previous")]: KeyRow {
            label: label;
            note: @tr("Global hotkey");
            keys: SettingsData.hotkey-keys[i];
        }
    }
    if SettingsData.hotkey-keys.length == 0: Body {
        text: @tr("Global hotkeys are off. Turn them on in Settings › Window to play, pause and skip with your own keys.");
        font-size: Theme.t-meta;
        color: Rows.detail;
        wrap: word-wrap;
    }
}

// The keyboard shortcuts over the window, from Window's "Show shortcuts" or Ctrl+/ on any
// page: `Dialog`'s scrim and card with Done alone, the rows from `Shortcuts` (the list the
// window's key handler keeps to). One column, 460 px; on a window too short for it, the
// groups sit in two columns of a wider card (Playback and From any app, then Finding and
// moving), so it never scrolls, even at the window's smallest. Done, Escape and a click on
// the scrim close it.
component ShortcutsDialog inherits Rectangle {
    // The one column's height (title, groups, Done, padding), and whether it fits.
    property <length> chrome: 2 * Theme.s5 + 28px + 2 * Theme.s4 + Theme.s2 + 32px;
    property <length> from-any-app: SettingsData.hotkey-keys.length > 0 ? Keys.group(4) : Keys.group(1) + 40px;
    property <length> one-h: root.chrome + Keys.group(Shortcuts.playback.length) + Keys.group(Shortcuts.moving.length) + root.from-any-app;
    property <bool> two: root.height < root.one-h + 2 * Theme.s5;
    property <bool> shown: false;
    background: Theme.scrim;
    opacity: root.shown ? 1 : 0;
    animate opacity { duration: Theme.t-menu; easing: Curves.ease-out; }
    init => {
        root.shown = true;
        keys.focus();
    }
    // It keeps the keys: the window's shortcuts don't act under it. Escape and Ctrl+/ close it;
    // Tab moves the focus as usual.
    keys := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape || (e.modifiers.control && (e.text == "/" || e.text == "?")) {
                SettingsData.close-dialog();
                return accept;
            }
            if e.text == Key.Tab || e.text == Key.Backtab {
                return reject;
            }
            accept
        }
        TouchArea {
            clicked => { SettingsData.close-dialog(); }
            // The page under the scrim doesn't scroll.
            scroll-event(e) => { accept }
        }
        // The groups are placed by hand rather than by two sets of layouts, one per
        // arrangement: each layout costs the exe code (see `Eq`).
        card := Rectangle {
            property <length> pad: Theme.s5;
            property <length> col-w: root.two ? (self.width - 2 * self.pad - Theme.s6) / 2 : self.width - 2 * self.pad;
            property <length> top: self.pad + 28px + Theme.s4;
            property <length> body-h: root.two ? max(playback.height + any-app.height, moving.height) : playback.height + moving.height + any-app.height;
            width: min(root.two ? 2 * Keys.column-w + Theme.s6 + 2 * Theme.s5 : 460px, root.width - 2 * Theme.s5);
            height: self.top + self.body-h + Theme.s4 + Theme.s2 + 32px + self.pad;
            x: (root.width - self.width) / 2;
            y: max(Theme.s5, (root.height - self.height) / 2 - (root.two ? 0 : Theme.s6));
            border-radius: Theme.r-l;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.card-edge;
            transform-scale: root.shown ? 1 : (Theme.moving ? 0.98 : 1);
            animate transform-scale { duration: Theme.t-menu; easing: Curves.ease-out; }
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: Theme.cover-shadow;
            accessible-role: groupbox;
            accessible-label: @tr("Keyboard shortcuts");
            // Clicks on the card don't reach the scrim.
            TouchArea { }
            Display {
                x: card.pad;
                y: card.pad;
                height: 28px;
                text: @tr("Keyboard shortcuts");
                font-size: 20px;
            }
            // One column: Playback, Finding and moving, From any app. Two: Playback over From
            // any app, Finding and moving beside them.
            playback := KeyList {
                x: card.pad;
                y: card.top;
                width: card.col-w;
                height: self.preferred-height;
                title: @tr("Playback");
                rows: Shortcuts.playback;
            }
            moving := KeyList {
                x: root.two ? card.pad + card.col-w + Theme.s6 : card.pad;
                y: root.two ? card.top : card.top + playback.height;
                width: card.col-w;
                height: self.preferred-height;
                title: @tr("Finding and moving");
                rows: Shortcuts.moving;
            }
            any-app := FromAnyApp {
                x: card.pad;
                y: card.top + playback.height + (root.two ? 0 : moving.height);
                width: card.col-w;
                height: self.preferred-height;
            }
            RowButton {
                x: card.width - card.pad - self.width;
                y: card.top + card.body-h + Theme.s4 + Theme.s2;
                label: @tr("Done");
                solid: true;
                clicked => { SettingsData.close-dialog(); }
            }
        }
    }
}

// An entry of Settings' section index: the section's name, marked while it's in view.
// The marked entry wears the accent's tonal fill, as the selected chip and tab do.
component SectionLink inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();
    height: Rows.link-h;
    border-radius: Theme.r-m;
    background: ta.pressed ? Theme.pressed
        : root.active ? (ta.has-hover ? Theme.accent-tonal-hover : Theme.accent-tonal)
        : (ta.has-hover ? Theme.hover : transparent);
    accessible-role: button;
    accessible-label: root.text;
    accessible-item-selected: root.active;
    accessible-action-default => { root.clicked(); }
    animate background { duration: Theme.t-hover; }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Body {
        x: Theme.s3;
        width: parent.width - 2 * Theme.s3;
        height: parent.height;
        text: root.text;
        color: root.active ? Theme.text1 : Theme.text2;
        font-weight: root.active ? 600 : 400;
        vertical-alignment: center;
    }
}

export component SettingsPage inherits Rectangle {
    // The content column: wide enough that the descriptions run one or two lines.
    property <length> col-max: 920px;
    // At wide windows a section index sits left of the column, when the column keeps at
    // least 760 px beside it. The block starts at the page's padding, as every page's content
    // does (level with the search field), whether the side panel is open or not; the column
    // takes the rest, up to `col-max`, so the switches stay near their labels.
    property <length> index-w: 184px;
    property <length> index-gap: Theme.s7;
    property <bool> indexed: self.width >= 2 * Theme.page-pad + root.index-w + root.index-gap + 760px;
    property <length> index-room: root.indexed ? root.index-w + root.index-gap : 0px;
    property <length> col-w: min(self.width - 2 * Theme.page-pad - root.index-room, root.col-max);
    property <length> block-x: Theme.page-pad;
    property <length> col-x: root.block-x + root.index-room;
    // The Discord profile card sits beside the Discord options when the Discord panel can
    // hold both: the options at `options-min` or more, the gap, the card. The panel then
    // reaches past the column on the right, by the card and its gap at most, as far as the
    // page's padding. Otherwise the card sits above the options.
    property <length> card-w: 400px;
    property <length> card-gap: Theme.s7;
    property <length> options-min: 520px;
    property <length> wide-panel: min(self.width - Theme.page-pad - root.col-x, root.col-w + root.card-gap + root.card-w);
    property <bool> card-beside: root.wide-panel - 2 * Rows.inset >= root.options-min + root.card-gap + root.card-w;
    // Where the Discord rows start in the scrolled content, and how far the card stays below
    // the page's top while the options scroll past it (its caption level with the section
    // index's first entry).
    property <length> discord-top: col.y + discord-section.y + Rows.title-h + Theme.s3 + Rows.pad-top;
    property <length> card-stick: Theme.page-top - Rows.pad-y;
    property <bool> confirm-sign-out: false;
    // How many of the sections below the fold (Discord, Window, Account) are made: one
    // more each tick after the page's first frame, not all with it. Making and laying out
    // every row, its text shaped, was most of the page's first frame (~13 ms at 4K shown
    // again, ~21 the first time; measured 2026-11-01). Until then a
    // section is its title on an empty panel, out of sight.
    property <int> made: 0;
    Timer {
        interval: 1ms;
        running: root.made < 3;
        triggered => { root.made += 1; }
    }

    // Where each section starts in the scrolled content, in the index's order.
    property <[length]> tops: [
        col.y + playback-section.y,
        col.y + sound-section.y,
        col.y + lyrics-section.y,
        col.y + scrobbling-section.y,
        col.y + discord-section.y,
        col.y + local-api-section.y,
        col.y + window-section.y,
        col.y + account-section.y,
    ];
    // The section in view, derived from the scroll position (nothing is timed): the last one
    // whose top has passed a third of the way down the visible page, or the last section once
    // the page is scrolled to its end.
    property <length> scrolled: -flick.content-y;
    property <length> max-scroll: max(0px, flick.content-height - flick.height);
    property <length> reading-line: root.scrolled + (flick.height - Theme.bar-clear) / 3;
    property <int> in-view: root.max-scroll > 0 && root.scrolled >= root.max-scroll - 1px ? 7
        : root.reading-line >= root.tops[7] ? 7
        : root.reading-line >= root.tops[6] ? 6
        : root.reading-line >= root.tops[5] ? 5
        : root.reading-line >= root.tops[4] ? 4
        : root.reading-line >= root.tops[3] ? 3
        : root.reading-line >= root.tops[2] ? 2
        : root.reading-line >= root.tops[1] ? 1 : 0;
    // Brings section `i`'s title near the top (as far as the page scrolls).
    function go-to(i: int) {
        flick.content-y = -min(max(0px, root.tops[i] - Theme.s5), root.max-scroll);
    }

    flick := Flickable {
        width: parent.width;
        height: parent.height;
        content-height: col.preferred-height + Theme.page-top + Theme.page-end;

        col := VerticalLayout {
            x: root.col-x;
            y: Theme.page-top;
            width: root.col-w;
            height: self.preferred-height;
            spacing: Theme.s7;

            PageTitle {
                text: @tr("Settings");
            }

            playback-section := Group {
                title: @tr("Playback");
                ToggleRow {
                    divider: false;
                    label: @tr("Prefer song versions");
                    detail: @tr("Some uploads are music videos with intros or skits in the audio. Play the song version instead when there is one.");
                    key: SettingKey.prefer-song-versions;
                    checked: SettingsData.prefer-song-versions;
                }
                ToggleRow {
                    label: @tr("Autoplay similar songs when a list ends");
                    detail: @tr("When a playlist, album or other list ends, play on with songs like its last one. Off, the list starts again from the top. Repeat all always starts it again.");
                    key: SettingKey.autoplay;
                    checked: SettingsData.autoplay;
                }
                ToggleRow {
                    label: @tr("Skip non-music in radio");
                    detail: @tr("Radio and autoplay leave out user uploads and podcast episodes. Tracks you pick always play.");
                    key: SettingKey.skip-non-music;
                    checked: SettingsData.skip-non-music;
                }
                ToggleRow {
                    label: @tr("Skip non-music parts");
                    detail: @tr("Skips the intros and outros SponsorBlock users marked in music videos.");
                    key: SettingKey.sponsorblock;
                    checked: SettingsData.sponsorblock;
                }
                ToggleRow {
                    label: @tr("Skip songs I've disliked");
                    detail: @tr("Playlists, albums and radio move past songs you've disliked. A song you pick yourself still plays.");
                    key: SettingKey.skip-disliked;
                    checked: SettingsData.skip-disliked;
                }
                SettingRow {
                    label: @tr("Skip silence");
                    detail: @tr("Skips the silence before a song starts and after it ends. Everywhere also shortens silences of 2 seconds or more inside a song.");
                    RowChips {
                        labels: [@tr("Off"), @tr("Start and end"), @tr("Everywhere")];
                        active: SettingsData.skip-silence;
                        selected(i) => { SettingsData.pick-skip-silence(i); }
                    }
                }
                SettingRow {
                    label: @tr("Crossfade");
                    detail: @tr("The end of a song fades into the next. Songs from the same album play without a fade, and Next and Previous cut.");
                    RowChips {
                        labels: [@tr("Off"), @tr("{} s", 2), @tr("{} s", 5), @tr("{} s", 8), @tr("{} s", 12)];
                        active: SettingsData.crossfade;
                        selected(i) => { SettingsData.pick-crossfade(i); }
                    }
                }
                if SettingsData.crossfade != 0: ToggleRow {
                    label: @tr("Fade on skip");
                    detail: @tr("Next, Previous and a click on another song fade over 2 seconds instead of cutting.");
                    key: SettingKey.fade-on-skip;
                    checked: SettingsData.fade-on-skip;
                }
                SettingRow {
                    label: @tr("Playback speed");
                    detail: @tr("Faster or slower, at the same pitch. While it isn't 1×, the player bar shows it.");
                    RowChips {
                        labels: Player.speed-labels;
                        active: Player.speed;
                        selected(i) => { Player.pick-speed(i); }
                    }
                }
                SettingRow {
                    label: @tr("Volume step");
                    detail: @tr("How much the mouse wheel and the Up and Down keys change the volume.");
                    RowChips {
                        labels: [@tr("{} %", 1), @tr("{} %", 2), @tr("{} %", 5), @tr("{} %", 10)];
                        active: SettingsData.volume-step;
                        selected(i) => { SettingsData.pick-volume-step(i); }
                    }
                }
            }

            sound-section := Group {
                title: @tr("Sound");
                SettingRow {
                    divider: false;
                    label: @tr("Equalizer");
                    detail: @tr("Shapes the sound of every song. Custom… lets you set each band.");
                    RowChips {
                        labels: [@tr("Off"), @tr("Bass"), @tr("Treble"), @tr("Vocal"), @tr("Custom…")];
                        active: SettingsData.equalizer;
                        selected(i) => { SettingsData.pick-equalizer(i); }
                    }
                }
                SettingRow {
                    label: @tr("Even out loudness");
                    detail: @tr("Brings quiet parts up and loud parts down, for low volume or a noisy room. Strong flattens a lot.");
                    RowChips {
                        labels: [@tr("Off"), @tr("Light"), @tr("Strong")];
                        active: SettingsData.loudness;
                        selected(i) => { SettingsData.pick-loudness(i); }
                    }
                }
                ToggleRow {
                    label: @tr("Match song volumes");
                    detail: @tr("Turns louder songs down to the same level, as YouTube Music's own player does.");
                    key: SettingKey.match-volumes;
                    checked: SettingsData.match-volumes;
                }
                SettingRow {
                    label: @tr("Streaming quality");
                    detail: @tr("High plays Opus, which sounds better than AAC at about the same data use. Standard always plays AAC at 128 kbps. Songs already loaded keep their quality.");
                    RowChips {
                        labels: [@tr("High"), @tr("Standard")];
                        active: SettingsData.streaming-quality;
                        selected(i) => { SettingsData.pick-streaming-quality(i); }
                    }
                }
                SettingRow {
                    label: @tr("Output device");
                    detail: @tr("If the device goes away, playback pauses and moves to the system default.");
                }
                VerticalLayout {
                    padding-bottom: Theme.s2;
                    for d[i] in SettingsData.devices: DeviceRow {
                        name: d;
                        selected: i == SettingsData.device-index;
                        clicked => { SettingsData.pick-device(i); }
                    }
                }
            }

            lyrics-section := Group {
                title: @tr("Lyrics");
                ToggleRow {
                    divider: false;
                    label: @tr("Show lyrics");
                    detail: @tr("The Lyrics button in the bar and on Now playing, and the Lyrics tab beside Up next. Off: they're hidden, and no lyrics are looked up.");
                    key: SettingKey.lyrics;
                    checked: SettingsData.lyrics;
                }
                ToggleRow {
                    label: @tr("Look up synced lyrics on LRCLIB");
                    detail: @tr("Lines follow the song. While lyrics are on screen, LRCLIB gets the song's title, artist, album and length. Off: only the lyrics that come with the song, synced for some songs.");
                    key: SettingKey.lyrics-lrclib;
                    checked: SettingsData.lyrics-lrclib;
                    enabled: SettingsData.lyrics;
                }
            }

            scrobbling-section := Group {
                title: @tr("Scrobbling");
                ToggleRow {
                    divider: false;
                    label: @tr("Scrobble");
                    detail: @tr("Send what you play to Last.fm and ListenBrainz, once you've played half a track or 4 minutes of it.");
                    key: SettingKey.scrobbling;
                    checked: SettingsData.scrobbling;
                }
                ToggleRow {
                    label: @tr("Scrobble other media");
                    detail: @tr("Also scrobble user uploads and podcasts, not only songs and official music videos.");
                    key: SettingKey.scrobble-other-media;
                    checked: SettingsData.scrobble-other-media;
                    enabled: SettingsData.scrobbling;
                }
                ToggleRow {
                    label: @tr("Use alternative titles");
                    detail: @tr("Send the video's original title rather than the translated or romanised one shown here.");
                    key: SettingKey.alternative-titles;
                    checked: SettingsData.alternative-titles;
                    enabled: SettingsData.scrobbling;
                }
                ToggleRow {
                    label: @tr("Use alternative artists");
                    detail: @tr("Send the artist from the video's tags, spelled as the label has it, rather than the first artist shown.");
                    key: SettingKey.alternative-artists;
                    checked: SettingsData.alternative-artists;
                    enabled: SettingsData.scrobbling;
                }
                SettingRow {
                    label: "Last.fm";
                    detail: SettingsData.lastfm-message != "" ? SettingsData.lastfm-message
                        : SettingsData.lastfm-state == LastfmState.signed-in ? @tr("Connected. Scrobbles go to your Last.fm profile.")
                        : SettingsData.lastfm-state == LastfmState.opening ? @tr("Opening Last.fm in your browser…")
                        : SettingsData.lastfm-state == LastfmState.waiting ? @tr("Approve featherplay on the Last.fm page in your browser, then come back here.")
                        : SettingsData.lastfm-state == LastfmState.finishing ? @tr("Connecting…")
                        : !SettingsData.lastfm-builtin-key && !SettingsData.lastfm-custom-key ? @tr("Scrobble to your Last.fm profile. Enter an API key under API settings first.")
                        : @tr("Scrobble what you play to your Last.fm profile.");
                    if SettingsData.lastfm-state == LastfmState.signed-out || SettingsData.lastfm-state == LastfmState.signed-in: RowButton {
                        label: @tr("API settings…");
                        clicked => { SettingsData.open-dialog(SettingsDialog.lastfm-keys); }
                    }
                    if SettingsData.lastfm-state == LastfmState.signed-out: RowButton {
                        label: @tr("Connect");
                        clicked => { SettingsData.lastfm-connect(); }
                    }
                    if SettingsData.lastfm-state == LastfmState.waiting: RowButton {
                        label: @tr("Cancel");
                        clicked => { SettingsData.lastfm-cancel(); }
                    }
                    if SettingsData.lastfm-state == LastfmState.waiting: RowButton {
                        label: @tr("I've approved it");
                        solid: true;
                        clicked => { SettingsData.lastfm-approved(); }
                    }
                    if SettingsData.lastfm-state == LastfmState.signed-in: RowButton {
                        label: @tr("Disconnect");
                        clicked => { SettingsData.lastfm-sign-out(); }
                    }
                }
                if SettingsData.lastfm-state == LastfmState.signed-in: ToggleRow {
                    label: @tr("Scrobble to Last.fm");
                    detail: @tr("Off keeps the connection.");
                    key: SettingKey.scrobble;
                    checked: SettingsData.scrobble;
                    enabled: SettingsData.scrobbling;
                }
                SettingRow {
                    label: "ListenBrainz";
                    detail: SettingsData.listenbrainz-message != "" ? SettingsData.listenbrainz-message
                        : SettingsData.listenbrainz-state == ListenBrainzState.checking ? @tr("Checking the token with ListenBrainz…")
                        : SettingsData.listenbrainz-state == ListenBrainzState.signed-in ? @tr("Connected. Listens go to your ListenBrainz profile.")
                        : @tr("Send listens to your ListenBrainz profile with your user token.");
                    if SettingsData.listenbrainz-state == ListenBrainzState.signed-out: RowButton {
                        label: @tr("Add token…");
                        clicked => { SettingsData.open-dialog(SettingsDialog.listenbrainz-token); }
                    }
                    if SettingsData.listenbrainz-state == ListenBrainzState.signed-in: RowButton {
                        label: @tr("Change token…");
                        clicked => { SettingsData.open-dialog(SettingsDialog.listenbrainz-token); }
                    }
                    if SettingsData.listenbrainz-state == ListenBrainzState.signed-in: RowButton {
                        label: @tr("Remove");
                        clicked => { SettingsData.listenbrainz-remove(); }
                    }
                }
                if SettingsData.listenbrainz-state == ListenBrainzState.signed-in: ToggleRow {
                    label: @tr("Scrobble to ListenBrainz");
                    detail: @tr("Off keeps the token.");
                    key: SettingKey.listenbrainz;
                    checked: SettingsData.listenbrainz;
                    enabled: SettingsData.scrobbling;
                }
            }

            discord-section := Group {
                title: @tr("Discord");
                extend: root.card-beside ? root.wide-panel - root.col-w : 0px;
                // Two columns while the card fits beside the options: the rows on the left,
                // the card's lane on the right. Otherwise the card sits above the options, in
                // the room kept for it there. One card either way, placed over the layout.
                if root.made >= 1: block := Rectangle {
                    property <length> inner-w: root.col-w - 2 * Rows.inset;
                    property <length> card-w: root.card-beside ? root.card-w : min(root.card-w, block.inner-w);
                    // Above the options, the caption and the note go left of the card while
                    // they keep a column of their own, so the card doesn't hang off the left
                    // of an empty panel.
                    property <bool> text-beside: !root.card-beside && block.inner-w - root.card-w - Theme.s6 >= 220px;
                    property <length> pane-w: block.text-beside ? block.inner-w : block.card-w;
                    property <length> pane-h: pane.preferred-height + 2 * Rows.pad-y;
                    min-width: columns.min-width;
                    min-height: columns.min-height;
                    preferred-height: columns.preferred-height;
                    columns := HorizontalLayout {
                        spacing: root.card-beside ? root.card-gap : 0px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            // At the top, when the card beside them is the taller.
                            alignment: start;
                            Rectangle {
                                height: root.card-beside ? 0px : block.pane-h;
                            }
                            discord-rows := VerticalLayout {
                                DiscordOption {
                                    part: DiscordPart.card;
                                    option: 1;
                                    SettingRow {
                                        divider: !root.card-beside;
                                        label: @tr("Discord status");
                                        detail: SettingsData.discord-state == DiscordState.unavailable ? @tr("This build has no Discord app ID.")
                                            : !SettingsData.discord ? @tr("Show \"Listening to\" with the track on your Discord profile.")
                                            : SettingsData.discord-state == DiscordState.connected ? @tr("Connected to Discord.")
                                            : SettingsData.discord-state == DiscordState.connecting ? @tr("Connecting to Discord…")
                                            : SettingsData.discord-auto-reconnect ? @tr("Not connected. Discord isn't running; featherplay tries again while music plays.")
                                            : @tr("Not connected. Discord isn't running, or it closed.");
                                        if SettingsData.discord && SettingsData.discord-state == DiscordState.not-connected: RowButton {
                                            label: @tr("Connect");
                                            clicked => { SettingsData.discord-connect(); }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            Switch {
                                                checked: SettingsData.discord;
                                                label: @tr("Discord status");
                                                enabled: SettingsData.discord-state != DiscordState.unavailable;
                                                toggled(on) => { SettingsData.toggled(SettingKey.discord, on); }
                                            }
                                        }
                                    }
                                }
                                if SettingsData.discord: VerticalLayout {
                                    ToggleRow {
                                        label: @tr("Reconnect automatically");
                                        detail: @tr("When Discord isn't running or restarts, try again while music plays.");
                                        key: SettingKey.discord-auto-reconnect;
                                        checked: SettingsData.discord-auto-reconnect;
                                    }
                                    DiscordOption {
                                        part: DiscordPart.activity;
                                        option: 2;
                                        SettingRow {
                                            label: @tr("Clear activity");
                                            detail: @tr("Remove the track from your profile until the next one starts or you resume.");
                                            RowButton {
                                                label: @tr("Clear");
                                                enabled: SettingsData.discord-state == DiscordState.connected;
                                                clicked => { SettingsData.discord-clear(); }
                                            }
                                        }
                                    }
                                    DiscordOption {
                                        part: DiscordPart.activity;
                                        option: 3;
                                        SettingRow {
                                            label: @tr("Clear after a pause");
                                            detail: @tr("Remove the track when paused this long.");
                                            MinutesStepper {
                                                minutes: SettingsData.discord-clear-minutes;
                                                enabled: SettingsData.discord-clear-on-pause;
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                Switch {
                                                    checked: SettingsData.discord-clear-on-pause;
                                                    label: @tr("Clear after a pause");
                                                    toggled(on) => { SettingsData.toggled(SettingKey.discord-clear-on-pause, on); }
                                                }
                                            }
                                        }
                                    }
                                    DiscordOption {
                                        part: DiscordPart.button;
                                        option: 4;
                                        ToggleRow {
                                            label: @tr("Play song button");
                                            detail: @tr("A button under the activity that opens the song in a browser.");
                                            key: SettingKey.discord-play-button;
                                            checked: SettingsData.discord-play-button;
                                        }
                                    }
                                    DiscordOption {
                                        part: DiscordPart.links;
                                        option: 5;
                                        ToggleRow {
                                            label: @tr("Links");
                                            detail: @tr("The title opens the song, the artist their page and the cover the album.");
                                            key: SettingKey.discord-links;
                                            checked: SettingsData.discord-links;
                                        }
                                    }
                                    DiscordOption {
                                        part: DiscordPart.time;
                                        option: 6;
                                        SettingRow {
                                            label: @tr("Time");
                                            detail: @tr("What your profile shows of the track's time while it plays.");
                                        }
                                        VerticalLayout {
                                            padding-bottom: Theme.s2;
                                            for t[i] in [@tr("Progress bar"), @tr("Time elapsed only"), @tr("No time")]: DeviceRow {
                                                name: t;
                                                selected: i == SettingsData.discord-time;
                                                clicked => { SettingsData.discord-pick-time(i); }
                                            }
                                        }
                                    }
                                    DiscordOption {
                                        part: DiscordPart.status;
                                        option: 7;
                                        SettingRow {
                                            label: @tr("Status text");
                                            detail: @tr("What your status says in member lists and DMs.");
                                        }
                                        VerticalLayout {
                                            padding-bottom: Theme.s2;
                                            for t[i] in [@tr("Listening to featherplay"), @tr("Listening to the artist"), @tr("Listening to the song title")]: DeviceRow {
                                                name: t;
                                                selected: i == SettingsData.discord-status-text;
                                                clicked => { SettingsData.discord-pick-status-text(i); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        lane := Rectangle {
                            width: root.card-beside ? root.card-w : 0px;
                            min-height: root.card-beside ? block.pane-h : 0px;
                        }
                    }
                    // Beside the options, the card keeps in view while they scroll past it,
                    // within their rows.
                    pane := DiscordPane {
                        x: root.card-beside ? lane.x : 0px;
                        y: Rows.pad-y + (root.card-beside ? max(0px, min(root.scrolled + root.card-stick - root.discord-top, discord-rows.height - block.pane-h)) : 0px);
                        width: block.pane-w;
                        height: self.preferred-height;
                        card-w: block.card-w;
                        text-beside: block.text-beside;
                    }
                }
            }

            local-api-section := Group {
                title: @tr("Local API");
                // Made with the page: off, as it mostly is, it's two rows.
                VerticalLayout {
                    ToggleRow {
                        divider: false;
                        label: @tr("API server");
                        detail: !SettingsData.local-api ? @tr("Let stream overlays, Stream Deck and scripts on this PC show what's playing and control playback. Tools made for Pear's API Server work too.")
                            : SettingsData.local-api-state == LocalApiState.failed ? SettingsData.local-api-message
                            : SettingsData.local-api-state == LocalApiState.running ? @tr("On at http://127.0.0.1:{}. Only apps on this PC that have the token can use it.", SettingsData.local-api-port)
                            : @tr("Starting…");
                        key: SettingKey.local-api;
                        checked: SettingsData.local-api;
                    }
                    if SettingsData.local-api: VerticalLayout {
                        SettingRow {
                            label: @tr("Port");
                            detail: SettingsData.local-api-port-error != "" ? SettingsData.local-api-port-error
                                : @tr("26538 is the one Pear Desktop uses, so its tools find featherplay.");
                            Field {
                                width: 96px;
                                text <=> SettingsData.local-api-port;
                                label: @tr("Local API port");
                                placeholder: "26538";
                                committed(t) => { SettingsData.local-api-port-entered(t); }
                            }
                        }
                        SettingRow {
                            label: @tr("Access token");
                            detail: @tr("Apps send it as \"Authorization: Bearer\" and the token. It stays hidden here, so it doesn't show on stream. Regenerate disconnects the apps using the old one.");
                            Body {
                                text: SettingsData.local-api-token;
                                color: Rows.detail;
                                vertical-alignment: center;
                                accessible-label: @tr("Token, hidden");
                            }
                            RowButton {
                                label: @tr("Copy");
                                enabled: SettingsData.local-api-token != "";
                                clicked => { SettingsData.local-api-copy(); }
                            }
                            RowButton {
                                label: @tr("Regenerate");
                                clicked => { SettingsData.local-api-regenerate(); }
                            }
                        }
                    }
                    ToggleRow {
                        label: @tr("Amuse");
                        detail: !SettingsData.amuse ? @tr("Lets Amuse show what's playing. It needs no token: any app on this PC can see it, but no website other than Amuse's.")
                            : SettingsData.amuse-state == LocalApiState.failed ? SettingsData.amuse-message
                            : SettingsData.amuse-state == LocalApiState.running ? @tr("On at http://127.0.0.1:9863. It needs no token: any app on this PC can see it, but no website other than Amuse's.")
                            : @tr("Starting…");
                        key: SettingKey.amuse;
                        checked: SettingsData.amuse;
                    }
                }
            }

            window-section := Group {
                title: @tr("Window");
                if root.made >= 2: VerticalLayout {
                    SettingRow {
                        divider: false;
                        label: @tr("When I close the window");
                        detail: @tr("In the tray, the music keeps going; quit from the tray icon's menu.");
                    }
                    VerticalLayout {
                        padding-bottom: Theme.s2;
                        for t[i] in [@tr("Ask"), @tr("Close featherplay"), @tr("Keep playing in the tray")]: DeviceRow {
                            name: t;
                            selected: i == SettingsData.close-action;
                            clicked => { SettingsData.pick-close-action(i); }
                        }
                    }
                    ToggleRow {
                        label: @tr("Turn off the mini player");
                        detail: @tr("Clicking the tray icon opens the main window instead. Right-click always shows the menu.");
                        key: SettingKey.tray-click-opens-window;
                        checked: SettingsData.tray-click-opens-window;
                    }
                    SettingRow {
                        label: @tr("Appearance");
                        detail: @tr("System follows Windows' light or dark mode.");
                        Chips {
                            labels: [@tr("appearance" => "Dark"), @tr("appearance" => "Light"), @tr("appearance" => "System")];
                            active: SettingsData.appearance == Appearance.dark ? 0 : (SettingsData.appearance == Appearance.light ? 1 : 2);
                            selected(i) => {
                                SettingsData.pick-appearance(i == 0 ? Appearance.dark : (i == 1 ? Appearance.light : Appearance.system));
                            }
                        }
                    }
                    SettingRow {
                        label: @tr("Language");
                        detail: @tr("Windows default follows Windows' display language when featherplay has it, and English otherwise.");
                        Chips {
                            labels: SettingsData.language-names;
                            active: SettingsData.language;
                            selected(i) => { SettingsData.pick-language(i); }
                        }
                    }
                    SettingRow {
                        label: @tr("Accent");
                        detail: @tr("From the cover takes the colour of the song that's playing, and uses red when the art is grey.");
                        Chips {
                            labels: [@tr("From the cover")];
                            active: SettingsData.accent == 0 ? 0 : -1;
                            selected => { SettingsData.pick-accent(0); }
                        }
                        for swatch[i] in SettingsData.accents: Swatch {
                            name: swatch.name;
                            colour: Theme.dark ? swatch.dark : swatch.light;
                            selected: SettingsData.accent == i + 1;
                            clicked => { SettingsData.pick-accent(i + 1); }
                        }
                        // The custom colour: a hue wheel, the usual sign for "any colour".
                        Swatch {
                            name: @tr("Custom colour");
                            colour: @conic-gradient(#E5484D 0deg, #E58A3C 45deg, #D9C23A 90deg, #5CB85C 135deg, #3BB5C9 180deg, #4C7EE5 225deg, #9061E0 270deg, #D9509E 315deg, #E5484D 360deg);
                            selected: SettingsData.accent == SettingsData.accents.length + 1;
                            clicked => { SettingsData.pick-accent(SettingsData.accents.length + 1); }
                        }
                    }
                    if SettingsData.accent == SettingsData.accents.length + 1: CustomPicker { }
                    ToggleRow {
                        label: @tr("Track notifications");
                        detail: @tr("Show a notification when the track changes.");
                        key: SettingKey.notifications;
                        checked: SettingsData.notifications;
                    }
                    ToggleRow {
                        label: @tr("Show tooltips");
                        detail: @tr("Names and shortcuts when you rest the pointer on a button.");
                        key: SettingKey.tooltips;
                        checked: SettingsData.tooltips;
                    }
                    SettingRow {
                        label: @tr("Keyboard shortcuts");
                        detail: @tr("Play, skip, search and move around without the mouse.");
                        RowButton {
                            label: @tr("Show shortcuts");
                            clicked => { SettingsData.open-dialog(SettingsDialog.shortcuts); }
                        }
                    }
                    ToggleRow {
                        label: @tr("Global hotkeys");
                        detail: @tr("Play, pause and skip from any app. Each key needs Ctrl, Alt, Shift or Win.");
                        key: SettingKey.hotkeys;
                        checked: SettingsData.hotkeys;
                    }
                    if SettingsData.hotkeys: VerticalLayout {
                        padding-bottom: Theme.s3;
                        HotkeyRow {
                            label: @tr("Play or pause");
                            index: 0;
                            text <=> SettingsData.hotkey-play-pause;
                            placeholder: @tr("Ctrl+Alt+Space");
                        }
                        HotkeyRow {
                            label: @tr("Next");
                            index: 1;
                            text <=> SettingsData.hotkey-next;
                            placeholder: @tr("Ctrl+Alt+Right");
                        }
                        HotkeyRow {
                            label: @tr("Previous");
                            index: 2;
                            text <=> SettingsData.hotkey-previous;
                            placeholder: @tr("Ctrl+Alt+Left");
                        }
                        if SettingsData.hotkeys-error != "": Body {
                            text: SettingsData.hotkeys-error;
                            font-size: Theme.t-meta;
                            color: Theme.text1;
                            overflow: clip;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            account-section := Group {
                title: @tr("Account");
                if root.made >= 3: VerticalLayout {
                    SettingRow {
                        divider: false;
                        label: @tr("Music account");
                        detail: !SettingsData.signed-in ? @tr("Not signed in.")
                            : root.confirm-sign-out ? @tr("Sign out? The saved session is deleted; the music keeps playing.")
                            : @tr("Signed in. The session is kept in Windows Credential Manager.");
                        if !SettingsData.signed-in: RowButton {
                            label: @tr("Sign in");
                            clicked => { Nav.go(PageKind.sign-in); }
                        }
                        if SettingsData.signed-in && !root.confirm-sign-out: RowButton {
                            label: @tr("Sign out");
                            clicked => { root.confirm-sign-out = true; }
                        }
                        if SettingsData.signed-in && root.confirm-sign-out: RowButton {
                            label: @tr("Cancel");
                            clicked => { root.confirm-sign-out = false; }
                        }
                        if SettingsData.signed-in && root.confirm-sign-out: RowButton {
                            label: @tr("Sign out");
                            solid: true;
                            clicked => {
                                root.confirm-sign-out = false;
                                SettingsData.sign-out();
                            }
                        }
                    }
                    ToggleRow {
                        label: @tr("Check for updates");
                        detail: @tr("Once a day, and when songs keep failing to play, ask GitHub whether a newer featherplay is out. Off, featherplay only checks when you click Check for updates in About.");
                        key: SettingKey.check-for-updates;
                        checked: SettingsData.check-for-updates;
                    }
                    ToggleRow {
                        label: @tr("Install updates automatically");
                        detail: @tr("Download a newer version in the background, check it, and install it when you click Restart to update. Only for the installed featherplay, not the portable exe.");
                        key: SettingKey.install-updates;
                        checked: SettingsData.install-updates;
                        enabled: SettingsData.check-for-updates;
                    }
                    SettingRow {
                        label: @tr("About featherplay");
                        detail: @tr("Version, licences and credits.");
                        RowButton {
                            label: @tr("About");
                            clicked => { Nav.go(PageKind.about); }
                        }
                    }
                }
            }
        }
    }

    // The section index, at wide windows. It rises with the first section until it reaches
    // the page's top, then stays there while the sections scroll past.
    // Its first entry's label is level with the first group's title.
    if root.indexed: VerticalLayout {
        x: root.block-x;
        y: max(Theme.page-top, root.tops[0] + flick.content-y + (Rows.title-h - Rows.link-h) / 2);
        width: root.index-w;
        spacing: 2px;
        accessible-role: list;
        accessible-label: @tr("Settings sections");
        for name[i] in [@tr("Playback"), @tr("Sound"), @tr("Lyrics"), @tr("Scrobbling"), @tr("Discord"), @tr("Local API"), @tr("Window"), @tr("Account")]: SectionLink {
            text: name;
            active: i == root.in-view;
            clicked => { root.go-to(i); }
        }
    }

    // A quiet scroll indicator, shown only when the page is taller than the window.
    // Its track ends above the floating bar.
    if flick.content-height > flick.height: Rectangle {
        property <length> track: flick.height - Theme.bar-clear - 8px;
        property <length> thumb: max(32px, self.track * flick.height / flick.content-height);
        x: parent.width - 8px;
        y: 4px + (self.track - self.thumb) * (-flick.content-y / (flick.content-height - flick.height));
        width: 4px;
        height: self.thumb;
        border-radius: 2px;
        background: Theme.track;
    }
}

// The open dialog, over the whole window (sidebar and bar too): AppWindow places it at the
// app level so its scrim dims and blocks everything, like the song menu.
export component SettingsDialogLayer inherits Rectangle {
    if SettingsData.dialog == SettingsDialog.lastfm-keys: Dialog {
        width: root.width;
        height: root.height;
        title: @tr("Last.fm API settings");
        // Two sentences: whose API account is in use, then how to make one.
        detail: (SettingsData.lastfm-custom-key ? @tr("Your own API account is in use.")
            : SettingsData.lastfm-builtin-key ? @tr("featherplay's own API account is in use; you can use yours instead.")
            : @tr("This build has no API account of its own, so Last.fm needs yours."))
            + " " + @tr("Create one at last.fm/api/account/create, leaving the callback URL empty. Saving signs you out of Last.fm.");
        error: SettingsData.dialog-error;
        extra: SettingsData.lastfm-custom-key ? @tr("Remove your key") : "";
        ok => { SettingsData.lastfm-keys-save(SettingsData.dialog-key, SettingsData.dialog-secret); }
        cancel => { SettingsData.close-dialog(); }
        extra-clicked => { SettingsData.lastfm-keys-remove(); }
        DialogField {
            init => { self.grab-focus(); }
            label: @tr("API key");
            placeholder: SettingsData.lastfm-custom-key ? @tr("Enter a new key to replace yours") : @tr("32 letters and digits");
            text <=> SettingsData.dialog-key;
            accepted => { SettingsData.lastfm-keys-save(SettingsData.dialog-key, SettingsData.dialog-secret); }
        }
        DialogField {
            label: @tr("Shared secret");
            placeholder: @tr("Shown below the key on Last.fm");
            input-type: InputType.password;
            text <=> SettingsData.dialog-secret;
            accepted => { SettingsData.lastfm-keys-save(SettingsData.dialog-key, SettingsData.dialog-secret); }
        }
    }

    if SettingsData.dialog == SettingsDialog.listenbrainz-token: Dialog {
        width: root.width;
        height: root.height;
        title: @tr("ListenBrainz token");
        detail: @tr("Paste the user token from listenbrainz.org/settings. featherplay checks it with ListenBrainz, then keeps it in Windows Credential Manager.");
        error: SettingsData.dialog-error;
        ok => { SettingsData.listenbrainz-save(SettingsData.dialog-token); }
        cancel => { SettingsData.close-dialog(); }
        DialogField {
            init => { self.grab-focus(); }
            label: @tr("User token");
            placeholder: SettingsData.listenbrainz-state == ListenBrainzState.signed-in ? @tr("Paste a new token to replace yours") : @tr("Paste your user token");
            input-type: InputType.password;
            text <=> SettingsData.dialog-token;
            accepted => { SettingsData.listenbrainz-save(SettingsData.dialog-token); }
        }
    }

    if SettingsData.dialog == SettingsDialog.equalizer: EqualizerDialog {
        width: root.width;
        height: root.height;
    }

    if SettingsData.dialog == SettingsDialog.shortcuts: ShortcutsDialog {
        width: root.width;
        height: root.height;
    }
}
