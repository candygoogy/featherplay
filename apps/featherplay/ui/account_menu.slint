// The account menu: every identity YouTube Music's own switcher lists (photo, name, handle
// or "No channel", a check on the active one), then "Switch Google account" and "Sign out".
// The sidebar's account row opens it with `AccountMenu.show(x, top)` (window coordinates);
// `AccountMenuLayer` in app.slint draws it over everything. `src/account_menu.rs` fills it
// and connects the actions.
import { ListView } from "list_view.slint";
import { Theme, Icons, Curves } from "theme.slint";
import { Icon, Body, Cover, Display } from "parts.slint";

export struct AccountItem {
    // The identity's key (`Identity::key`), handed back by `pick`.
    key: string,
    name: string,
    // The handle, "No channel", or the channel's subscribers.
    detail: string,
    photo: image,
    has-photo: bool,
    // The avatar letter until the photo arrives.
    initial: string,
    active: bool,
}

export global AccountMenu {
    out property <bool> open;
    // The left edge and the top of the row it opens from; it opens upward, ending above it.
    out property <length> anchor-x;
    out property <length> anchor-top;
    in property <[AccountItem]> accounts;
    // The list is being fetched (the first open of a session).
    in property <bool> loading;
    // Why the list couldn't be fetched, or "".
    in property <string> error;

    callback opened();
    // Act as the identity with this key.
    callback pick(string);
    // Opens the sign-in window again, to add or change the Google login.
    callback switch-google();
    callback sign-out();

    public function show(x: length, top: length) {
        self.anchor-x = x;
        self.anchor-top = top;
        self.open = true;
        self.opened();
    }
    public function close() {
        self.open = false;
    }
}

// Glyphs only this menu uses, on the same 24 px grid as `Icons`.
global AccountIcons {
    out property <string> check: "M5.5 12.5 L10 17 L18.5 7.5";
    out property <string> switch: "M5 8.5 H18.5 M15.5 5.5 L18.5 8.5 L15.5 11.5 M19 15.5 H5.5 M8.5 12.5 L5.5 15.5 L8.5 18.5";
    out property <string> sign-out: "M13.5 4.5 H18 A1.5 1.5 0 0 1 19.5 6 V18 A1.5 1.5 0 0 1 18 19.5 H13.5 M10 8 L6 12 L10 16 M6 12 H15.5";
}

component ActionItem inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    // Off while the menu fades out, so a click then does nothing.
    in property <bool> enabled: true;
    callback clicked();
    height: 36px;
    border-radius: Theme.r-s;
    // Animated as a private property: a root animating a public one is copied into each use.
    property <brush> ground: Theme.state(ta.pressed, ta.has-hover);
    animate ground { duration: Theme.t-hover; }
    background: root.ground;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Icon {
        x: 10px;
        width: 18px;
        height: 18px;
        commands: root.icon;
        stroke: Theme.text2;
    }
    Body {
        x: 40px;
        width: parent.width - 48px;
        height: parent.height;
        text: root.label;
        vertical-alignment: center;
    }
}

component Divider inherits Rectangle {
    height: 9px;
    Rectangle {
        x: 8px;
        y: 4px;
        width: parent.width - 16px;
        height: 1px;
        background: Theme.hairline;
    }
}

// One identity: the round photo (or its letter), the name, the detail line, a check if active
// (or, with a `badge`, that word instead: the first sign-in's picker marks Google's default).
component IdentityRow inherits Rectangle {
    in property <AccountItem> item;
    in property <bool> enabled: true;
    // The keyboard is on it (the picker).
    in property <bool> selected;
    in property <string> badge;
    callback clicked();
    height: 52px;
    border-radius: Theme.r-s;
    // Animated as a private property: a root animating a public one is copied into each use.
    property <brush> ground: Theme.state-on(root.selected, ta.pressed, ta.has-hover);
    animate ground { duration: Theme.t-hover; }
    background: root.ground;
    accessible-role: button;
    property <string> who: root.item.detail != "" ? root.item.name + ", " + root.item.detail : root.item.name;
    accessible-label: root.badge != "" ? root.who + ", " + root.badge
        : root.item.active ? @tr("{}, current account", root.who) : root.who;
    property <length> trail: root.badge != "" ? 84px : 36px;
    accessible-action-default => { root.clicked(); }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Rectangle {
        x: 8px;
        y: (parent.height - self.height) / 2;
        width: 32px;
        height: 32px;
        border-radius: 16px;
        background: Theme.avatar;
        if root.item.initial != "": Text {
            text: root.item.initial;
            font-family: Theme.display-font;
            font-weight: 700;
            font-size: 14px;
            color: Theme.text1;
        }
        if root.item.initial == "": Icon {
            width: 18px;
            height: 18px;
            commands: Icons.person;
            stroke: Theme.text1;
        }
        if root.item.has-photo: Cover {
            width: parent.width;
            height: parent.height;
            round: true;
            source: root.item.photo;
        }
    }
    VerticalLayout {
        x: 52px;
        width: parent.width - 52px - root.trail;
        alignment: center;
        spacing: 1px;
        Body {
            text: root.item.name;
            font-weight: 600;
        }
        if root.item.detail != "": Body {
            text: root.item.detail;
            font-size: Theme.t-meta;
            color: Theme.text3;
        }
    }
    if root.item.active && root.badge == "": Icon {
        x: parent.width - 30px;
        width: 18px;
        height: 18px;
        commands: AccountIcons.check;
        stroke: Theme.text1;
    }
    if root.badge != "": Body {
        x: parent.width - root.trail;
        width: root.trail - 12px;
        height: parent.height;
        text: root.badge;
        font-size: Theme.t-meta;
        font-weight: 600;
        color: Theme.text3;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}

// Covers the window while the menu is open: a click outside closes it, Escape too.
export component AccountMenuLayer inherits Rectangle {
    callback closed();
    property <length> w: 288px;
    property <length> title-h: 32px;
    property <length> row-h: 52px;
    // Five rows show; more scroll.
    property <int> shown-rows: min(5, max(1, AccountMenu.accounts.length));
    property <bool> listing: !AccountMenu.loading && AccountMenu.error == "" && AccountMenu.accounts.length > 0;
    property <length> list-h: root.listing ? root.shown-rows * root.row-h : root.row-h;
    property <length> h: 2 * Theme.s2 + root.title-h + root.list-h + 9px + 2 * 36px;

    // Motion, as the song menu: the panel stays instantiated so it can fade out.
    // Opening, it snaps to its start (a little small, nudged down toward the row), then
    // grows from its bottom-left corner, the corner nearest the row.
    property <bool> open: AccountMenu.open;
    property <bool> settled: true;
    // Closed by Escape: keyboard actions don't animate.
    property <bool> snap: false;
    changed open => {
        if root.open {
            root.snap = false;
            root.settled = false;
            settle.running = true;
            keys.focus();
        }
    }
    settle := Timer {
        interval: 1ms;
        running: false;
        triggered => {
            self.running = false;
            root.settled = true;
        }
    }

    function close() {
        AccountMenu.close();
        root.closed();
    }

    if AccountMenu.open: TouchArea {
        width: root.width;
        height: root.height;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.close();
            }
        }
        scroll-event(e) => {
            root.close();
            accept
        }
    }
    panel := Rectangle {
        property <length> nudge: root.open && !root.settled ? Theme.nudge : 0px;
        x: max(8px, min(AccountMenu.anchor-x, root.width - root.w - 8px));
        y: max(8px, AccountMenu.anchor-top - 4px - self.height) + self.nudge;
        width: root.w;
        height: root.h;
        opacity: root.open ? 1 : 0;
        visible: self.opacity > 0;
        transform-origin: { x: 0px, y: self.height };
        transform-scale: !root.open ? (Theme.moving ? 0.98 : 1.0) : (root.settled ? 1.0 : Theme.pop-from);
        animate opacity { duration: root.open ? Theme.t-menu : (root.snap ? 0ms : Theme.t-fast); easing: Curves.ease-out; }
        animate transform-scale, nudge {
            duration: !root.open ? Theme.t-fast : (root.settled ? Theme.t-menu : 0ms);
            easing: Curves.ease-out;
        }
        // The list growing from its loading row to the accounts.
        animate height { duration: root.open && root.settled ? Theme.t-menu : 0ms; easing: Curves.ease-out; }
        border-radius: Theme.r-l;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.card-edge;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: Theme.cover-shadow;
        clip: true;
        accessible-role: list;
        accessible-label: @tr("Account menu");

        // Swallows clicks on the panel's padding.
        TouchArea { enabled: root.open; }
        keys := FocusScope {
            enabled: root.open;
            key-pressed(e) => {
                if e.text == Key.Escape {
                    root.snap = true;
                    root.close();
                    return accept;
                }
                reject
            }
        }

        Body {
            x: Theme.s2 + 10px;
            y: Theme.s2;
            width: parent.width - 2 * Theme.s2 - 20px;
            height: root.title-h;
            text: @tr("Accounts");
            font-size: Theme.t-meta;
            font-weight: 600;
            color: Theme.text3;
            vertical-alignment: center;
        }

        if !root.listing: Body {
            x: Theme.s2 + 10px;
            y: Theme.s2 + root.title-h;
            width: parent.width - 2 * Theme.s2 - 20px;
            height: root.row-h;
            text: AccountMenu.loading ? @tr("Loading your accounts…")
                : AccountMenu.error != "" ? AccountMenu.error : @tr("No accounts to show");
            color: Theme.text3;
            vertical-alignment: center;
            wrap: word-wrap;
        }
        if root.listing: ListView {
            x: Theme.s2;
            y: Theme.s2 + root.title-h;
            width: parent.width - 2 * Theme.s2;
            height: root.list-h;
            for a in AccountMenu.accounts: IdentityRow {
                item: a;
                enabled: root.open;
                clicked => {
                    if !a.active {
                        AccountMenu.pick(a.key);
                    }
                    root.close();
                }
            }
        }

        VerticalLayout {
            x: Theme.s2;
            y: Theme.s2 + root.title-h + root.list-h;
            width: parent.width - 2 * Theme.s2;
            height: 9px + 2 * 36px;
            Divider { }
            ActionItem {
                enabled: root.open;
                icon: AccountIcons.switch;
                label: @tr("Switch Google account");
                clicked => {
                    AccountMenu.switch-google();
                    root.close();
                }
            }
            ActionItem {
                enabled: root.open;
                icon: AccountIcons.sign-out;
                label: @tr("Sign out");
                clicked => {
                    AccountMenu.sign-out();
                    root.close();
                }
            }
        }
    }
}

// The first sign-in's question, when the cookies hold more than one identity: which one
// featherplay acts as. Asked before the pages load (src/account_picker.rs); the choice is
// saved as a pick from the menu is.
export global AccountPicker {
    // Shown over the window.
    in property <bool> open;
    // The account menu's rows, with no check on them.
    in property <[AccountItem]> accounts;
    // The identity Google would use (marked "Default"); Escape picks it.
    in property <int> default-row;
    // The row the keyboard is on.
    in-out property <int> focused;
    // Act as the identity with this key.
    callback choose(string);
}

// The picker over the whole window, in the close dialog's scrim and card. There is no
// cancel: a click on the scrim does nothing, Escape takes the default.
export component AccountPickerDialog inherits Rectangle {
    // After the choice, so the window takes the keys back.
    callback closed();
    // Where the card centres: the page's room (right of the sidebar, left of Up next while
    // it's open, above the bar), as the sign-in page's block does. The scrim covers it all.
    in property <length> room-x: 0;
    in property <length> room-w: self.width;
    in property <length> room-h: self.height;
    property <bool> shown: false;
    property <length> row-h: 52px;
    property <int> rows: AccountPicker.accounts.length;
    // Five rows show; more scroll.
    property <int> shown-rows: min(5, max(1, root.rows));
    property <int> focused: AccountPicker.focused;
    background: Theme.scrim;
    opacity: root.shown ? 1 : 0;
    animate opacity { duration: Theme.t-menu; easing: Curves.ease-out; }
    init => {
        root.shown = true;
        scope.focus();
    }

    function choose(row: int) {
        if row >= 0 && row < root.rows {
            AccountPicker.choose(AccountPicker.accounts[row].key);
            root.closed();
        }
    }
    function step(by: int) {
        AccountPicker.focused = max(0, min(root.rows - 1, AccountPicker.focused + by));
    }
    // The keyboard's row stays in view.
    changed focused => {
        if root.focused * root.row-h < -list.content-y {
            list.content-y = -root.focused * root.row-h;
        } else if (root.focused + 1) * root.row-h > list.visible-height - list.content-y {
            list.content-y = list.visible-height - (root.focused + 1) * root.row-h;
        }
    }

    scope := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape {
                root.choose(AccountPicker.default-row);
                return accept;
            }
            if e.text == Key.UpArrow || e.text == Key.Backtab || (e.text == Key.Tab && e.modifiers.shift) {
                root.step(-1);
                return accept;
            }
            if e.text == Key.DownArrow || e.text == Key.Tab {
                root.step(1);
                return accept;
            }
            if e.text == Key.Return || e.text == " " {
                root.choose(AccountPicker.focused);
                return accept;
            }
            reject
        }
        TouchArea {
            // The page under the scrim doesn't scroll or take clicks.
            scroll-event(e) => { accept }
        }
        card := Rectangle {
            width: min(420px, root.room-w - 2 * Theme.s5);
            height: lay.preferred-height;
            x: root.room-x + (root.room-w - self.width) / 2;
            // A touch above the middle, as the sign-in block sits.
            y: max(Theme.s5, (root.room-h - self.height) * 0.45);
            border-radius: Theme.r-l;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.card-edge;
            transform-scale: root.shown ? 1 : (Theme.moving ? 0.98 : 1);
            animate transform-scale { duration: Theme.t-menu; easing: Curves.ease-out; }
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: Theme.cover-shadow;
            accessible-role: groupbox;
            accessible-label: @tr("Choose an account");
            // Clicks on the card don't reach the scrim.
            TouchArea { }
            lay := VerticalLayout {
                // The rows' photos line up with the text: they sit 8 px into their row.
                padding: Theme.s4;
                padding-top: Theme.s5;
                spacing: Theme.s4;
                VerticalLayout {
                    padding-left: Theme.s2;
                    padding-right: Theme.s2;
                    spacing: Theme.s2;
                    Display {
                        text: @tr("Choose an account");
                        font-size: 20px;
                    }
                    Body {
                        text: @tr("Your Google sign-in has more than one account. Pick the one featherplay uses; you can switch later from the account menu.");
                        color: Theme.text2;
                        wrap: word-wrap;
                    }
                }
                list := ListView {
                    height: root.shown-rows * root.row-h;
                    for a[i] in AccountPicker.accounts: IdentityRow {
                        item: a;
                        selected: i == AccountPicker.focused;
                        badge: i == AccountPicker.default-row ? @tr("Account" => "Default") : "";
                        clicked => {
                            AccountPicker.focused = i;
                            root.choose(i);
                        }
                    }
                }
            }
        }
    }
}
