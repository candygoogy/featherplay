// The main window: the frame (sidebar, top bar, content, Up next panel, bottom bar) and the page
// switch. Pages live in pages/*.slint, one file each; see ui/README.md for who owns what.
import "fonts/manrope/Manrope-Variable.ttf";

import { Theme, Curves, Icons } from "theme.slint";
import { Nav, PageKind, Frame } from "nav.slint";
import { Mark, Bands, Icon } from "parts.slint";
import { Player } from "player.slint";
import { Probe, ProbeRegion } from "probe.slint";
import { Sidebar } from "sidebar.slint";
import { TopBar, TopBarData, CaptionButtons } from "top_bar.slint";
import { BottomBar, SpeedLayer, VolumeLayer, VolumeRow } from "bottom_bar.slint";
import { Sleep, SleepLayer } from "sleep_timer.slint";
import { QueuePanel } from "queue_panel.slint";
import { HomePage, ShortcutMoreLayer, HomeData } from "pages/home.slint";
import { LibraryPage } from "pages/library.slint";
import { ExplorePage, MoodPage } from "pages/explore.slint";
import { HistoryPage } from "pages/history.slint";
import { AlbumPage } from "pages/album.slint";
import { PlaylistPage, PlaylistData, ReorderKey } from "pages/playlist.slint";
import { ArtistPage } from "pages/artist.slint";
import { DiscographyPage } from "pages/discography.slint";
import { SearchPage } from "pages/search.slint";
import { NowPlayingPage, SideTabs, LyricsWatch } from "pages/now_playing.slint";
import { LyricsData } from "pages/lyrics.slint";
import { SettingsPage, SettingsData, SettingsDialog, SettingsDialogLayer, SettingKey } from "pages/settings.slint";
import { AboutPage } from "pages/about.slint";
import { SignInPage } from "pages/sign_in.slint";
import { SongMenu, SongMenuLayer } from "song_menu.slint";
import { PlaylistMenu, PlaylistDialog } from "playlist_menu.slint";
import { PlaylistMenuLayer, PlaylistDialogLayer } from "playlist_menu_layer.slint";
import { ItemMenu } from "item_menu.slint";
import { ItemMenuLayer } from "item_menu_layer.slint";
import { AlbumMenu, AlbumMenuLayer, AlbumDialogLayer } from "album_menu.slint";
import { AccountMenu, AccountMenuLayer, AccountPickerDialog, AccountPicker } from "account_menu.slint";
import { ToastView } from "toast.slint";
import { CloseDialog, CloseChoice } from "close_dialog.slint";
import { AgeNote, AgeNoteLayer } from "age_note.slint";
import { Shortcuts, ShortcutKind } from "shortcuts.slint";
import { Immersive, LyricsMenu, LyricsMenuLayer, LyricsChoose, LyricsChooseLayer, LyricsResetLayer } from "lyrics_menu.slint";
import { ChoiceMenu, ChoiceMenuLayer } from "choice_menu.slint";

// What Rust can reach. Shared pieces first, then one line per page: a page's owner adds its
// own exported structs to its own line only (blank lines keep the merges clean).
export { Theme, Icons, Appearance } from "theme.slint";
export { TrackRow, CardItem, ItemKind, RowHover, Refused, PageHover, Mark, ShownRows, SongList } from "parts.slint";
export { Nav, PageKind, Frame } from "nav.slint";
export { Probe } from "probe.slint";
export { Player, Repeat, SilenceSpan } from "player.slint";
export { SidebarData } from "sidebar.slint";
export { TopBarData, Suggestion, SuggestionKind } from "top_bar.slint";
export { QueueData } from "queue_panel.slint";
export { Tooltips } from "bar_tip.slint";
export { ChoiceMenu } from "choice_menu.slint";
export { Sleep } from "sleep_timer.slint";
export { Shortcuts, ShortcutKind, ShortcutRow } from "shortcuts.slint";

export { HomeData, HomeShelfRow, ShelfShape, MoreState, ShortcutMore } from "pages/home.slint";

export { SongMenu } from "song_menu.slint";

export { PlaylistMenu, PlaylistKind, PlaylistDialog } from "playlist_menu.slint";
export { ItemMenu } from "item_menu.slint";

export { AlbumMenu, AlbumAction } from "album_menu.slint";

export { AccountMenu, AccountItem, AccountPicker } from "account_menu.slint";

export { Toast, ToastTone } from "toast.slint";

export { LibraryData } from "pages/library.slint";

export { Grid, CardLine } from "pages/content.slint";

export { ExploreData, MoodData, ChartArtistRow, MoodTile, MoodGroup } from "pages/explore.slint";

export { HistoryData } from "pages/history.slint";

export { AlbumData } from "pages/album.slint";

export { PlaylistData, ReorderKey } from "pages/playlist.slint";

export { ArtistData } from "pages/artist.slint";
export { DiscographyData } from "pages/discography.slint";

export { SearchData } from "pages/search.slint";

export { NowPlayingData, StageBox } from "pages/now_playing.slint";

export { LyricDecoration, LyricsData, LyricsState, LyricInk, LyricPart, LyricWord, LyricWordLine } from "pages/lyrics.slint";
export { Immersive, LyricsMenu, LyricsChoose, LyricsMatch, ChooseState } from "lyrics_menu.slint";

export { SettingsData, SettingKey, LastfmState, DiscordState, ListenBrainzState, SettingsDialog, AccentSwatch, DiscordPreview, DiscordPart, SettingId, SettingsSearch, TextMark, RowHit } from "pages/settings.slint";

export { AboutData, Credit, UpdateState } from "pages/about.slint";

export { BrowserChoice, SessionStore, SignInData, SignInWay } from "pages/sign_in.slint";

export { SignInWindow } from "sign_in_window.slint";

export { MiniPlayer, MiniData } from "mini_player.slint";
// The quick search box, a window of its own (src/quick_search.rs).
export { QuickSearch, QuickData, QuickRow, QuickState, QuickPick } from "quick_search.slint";
export { QuickKeyData } from "pages/settings/quick_key.slint";

export { DesktopLyrics, StripData } from "desktop_lyrics.slint";

export { CloseChoice } from "close_dialog.slint";

export { AgeNote } from "age_note.slint";

export component AppWindow inherits Window {
    title: "featherplay";
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 480px;
    min-height: 600px;
    background: Theme.ground;
    default-font-family: Theme.body-font;
    default-font-size: Theme.t-body;
    // Immersive mode is the platform's real borderless full-screen state. This two-way link
    // also turns the mode off if the window system leaves full screen.
    full-screen <=> Immersive.active;
    forward-focus: keys;

    property <bool> wide: self.width >= Theme.wide-min;
    // Below `Theme.drawer-below` there's no sidebar beside the page: the top bar's menu button
    // opens the full one as a drawer over it (`Frame.drawer-open`).
    property <bool> drawer: self.width < Theme.drawer-below;
    // The Up next panel fits beside the page while the window holds the rail, the panel and
    // the page's least width: 72 + 340 + 540 = 952 px. Worked out, not a round 960: a window
    // snapped to half a 1920 px screen is about 958 px wide, and keeps the panel. Narrower,
    // Up next is a sheet above the bar on every page (`Frame.sheet`), Now playing's side panel
    // included. Rust reads `sheet` (the Frame copy follows a turn of the event loop later).
    property <length> panel-fit: Theme.rail-w + Theme.panel-w + Theme.page-min-w;
    out property <bool> sheet: self.width < root.panel-fit;
    init => { Frame.sheet = root.sheet; }
    changed sheet => {
        Frame.sheet = root.sheet;
        if !root.sheet {
            Frame.sheet-open = false;
        }
    }
    // Widened past it with the drawer open: the sidebar is back beside the page, and the keys
    // come back to the window.
    changed drawer => {
        if !root.drawer && Frame.drawer-open {
            Frame.drawer-open = false;
            keys.focus();
        }
    }
    property <bool> drawer-shown: root.drawer && Frame.drawer-open && !root.full-page;
    property <bool> sheet-shown: root.sheet && Frame.sheet-open;
    // Keyboard actions don't animate: a drawer opened with the keys is there at once, and
    // Escape closes the drawer or the sheet at once. A click or the bar's button eases them.
    property <bool> drawer-by-key;
    property <bool> drawer-snap;
    property <bool> sheet-snap;
    // How far the drawer is slid out past the left edge, and the sheet down behind the bar:
    // these ease, and the geometry follows from them, so a resize moves them at once.
    property <float> d-out: root.drawer-shown ? 0 : 1;
    animate d-out {
        duration: root.drawer-shown ? (root.drawer-by-key ? 0ms : Theme.t-panel) : (root.drawer-snap ? 0ms : Theme.t-panel * 0.8);
        easing: Curves.ease-drawer;
    }
    property <float> s-out: root.sheet-shown ? 0 : 1;
    animate s-out {
        duration: root.sheet-shown ? Theme.t-panel : (root.sheet-snap ? 0ms : Theme.t-panel * 0.8);
        easing: Curves.ease-drawer;
    }
    // The sheet: from `Theme.sheet-top` to 8 px above the bar, `bar-inset` in from the sides as
    // the bar is, up to `Theme.sheet-max-w` wide at the right, above the Up next button. Once
    // the bar has no volume button, a volume row at its foot.
    property <length> sheet-h: root.bar-top - Theme.s2 - Theme.sheet-top;
    property <length> sheet-w: min(root.width - 2 * Theme.bar-inset, Theme.sheet-max-w);
    property <length> sheet-foot: Frame.volume-in-sheet ? 57px : 0px;
    function open-drawer(by-key: bool) {
        root.drawer-by-key = by-key;
        root.drawer-snap = false;
        Frame.drawer-open = true;
        sidebar.take-keys(by-key);
    }
    // The keys go back where they came from: the menu button if it opened the drawer from
    // the keyboard (and the page picked still has the top bar), else the window.
    function close-drawer(by-key: bool) {
        if !Frame.drawer-open {
            return;
        }
        root.drawer-snap = by-key;
        Frame.drawer-open = false;
        if root.drawer-by-key && !root.no-top && !root.full-page {
            top-bar.focus-menu();
        } else {
            keys.focus();
        }
    }
    function close-sheet(by-key: bool) {
        root.sheet-snap = by-key;
        Frame.sheet-open = false;
    }
    changed sheet-shown => {
        if root.sheet-shown {
            root.sheet-snap = false;
        }
    }
    // Now playing takes the whole body; the sidebar and the panel step aside. From
    // `Frame.full-page`, which Rust sets only when it changes: bound to `Nav.page` straight,
    // everything it places (the sidebar, Up next, the bar's clear) was marked dirty by every
    // page change, and the page's first frames repainted the whole window
    // (measured 2026-11-01). Not a change handler: those run at the
    // start of the event loop's next turn, after the click's frame is drawn.
    property <bool> full-page: Frame.full-page;
    // The sidebar shows as the icon rail below `wide-min`, and while the Up next panel is in
    // where making room for it beside the full sidebar would leave the page narrower than
    // `Theme.page-min-w` (from `wide-min` to 1120 px). Beside the rail there's room down to
    // `panel-fit`; narrower, Up next is the sheet, and below `drawer-below` there's no rail.
    // It folds with the page's one relayout once the panel is in, and unfolds at once
    // as the panel leaves (`panel-push`). The width is read first and `panel-in` before
    // `panel-shown`: read first, the panel's state marked the sidebar and the page dirty in
    // the slide's first frame though nothing folds, and the whole window repainted there
    // (`tests/app/first_frames.rs`).
    property <bool> fold: root.width - Theme.sidebar-w - root.panel-w < Theme.page-min-w && root.panel-in && root.panel-shown;
    property <bool> rail: !root.wide || root.fold;
    property <length> side-w: root.full-page || root.drawer ? 0px : (root.rail ? Theme.rail-w : Theme.sidebar-w);
    // The player bar floats over the bottom of everything (`Theme.bar-inset` in from the
    // edges): the sidebar and the panel run the window's height behind it with their rows
    // ending at its top; the pages end at its top, fading into the ground just above it.
    property <length> bar-top: self.height - Theme.bar-clear;
    // How far above the bar's top the pages start fading into the ground.
    property <length> bar-fade: Theme.s5;
    // Open, and the page beside it (`panel-shown`): in a window too narrow for it, the panel
    // keeps its state, hidden, for when the window widens again.
    property <bool> panel-open: Frame.queue-open && !root.full-page;
    property <bool> panel-shown: root.panel-open && !root.sheet;
    // The Up next panel: as wide as Now playing's side panel on a wide window, so titles
    // aren't cut short; narrower below `panel-wide-min`.
    property <length> panel-w: self.width >= Theme.panel-wide-min ? Theme.nowplaying-side-w : Theme.panel-w;
    // The page makes room for the panel, laid out once at its new width rather than eased
    // (that would lay it out and repaint it on every frame of the slide). Opening, the panel
    // slides in over the page, which narrows when the slide ends; closing, the page widens at
    // once under the panel as it slides away. Either way nothing shows empty.
    property <length> panel-push: root.panel-shown && root.panel-in ? root.panel-w : 0px;
    // The panel has slid all the way in. Set from its slide's end (not bound to it), so the
    // page's width depends on it alone and isn't re-evaluated on every frame of the slide.
    property <bool> panel-in;
    // The page's room: from the sidebar's edge, `page-width` wide (for the tests, and for
    // where the sign-in window opens).
    out property <length> page-x: root.side-w;
    out property <length> page-width: root.width - root.side-w - root.panel-push;
    // The top bar sits above every page but Now playing and Sign in (whose block centres in
    // the page's full height). Album, playlist and artist pages run up under it, clear, so
    // their cover wash or photo reaches the window's top (each draws a `TopScrim` for when
    // content scrolls under it); the others start below it.
    property <bool> no-top: Nav.page == PageKind.sign-in;
    // The search field, still focused as Sign in hides it (a session that ended while the user
    // typed), would take the keys out of sight: the window takes them back.
    changed no-top => {
        if root.no-top && top-bar.searching {
            keys.focus();
        }
    }
    // The controls in the row at the window's top, as left edges and widths (`TopBar.hits`),
    // for Windows' hit test (`src/title_bar.rs`): the rest of the row drags the window. While a
    // menu, a dialog or the drawer lies over the window, all of it is the app's.
    out property <[length]> caption-hits: root.overlay-open ? [0px, root.width] : top-bar.hits;
    property <bool> under-top: Nav.page == PageKind.album || Nav.page == PageKind.playlist || Nav.page == PageKind.artist;
    property <length> top-h: root.full-page || root.under-top || root.no-top ? 0px : Theme.top-bar-h;

    // Page enter: a new page (another kind, or another album, playlist or artist) rises
    // `rise` over `t-page`. It doesn't fade: a fade would draw the whole page through a layer
    // on every frame of it. Keyboard navigation and Now playing (which has its own opening)
    // skip it.
    property <PageKind> page: Nav.page;
    property <string> page-id: Nav.page-id;
    property <bool> entered: true;
    changed page => { root.page-changed(); }
    changed page-id => { root.page-changed(); }
    function page-changed() {
        // Another page closes the drawer and the sheet, which lie over it.
        root.close-drawer(Frame.instant);
        if Frame.sheet-open {
            root.close-sheet(true);
        }
        if Frame.instant || !Theme.fading || Nav.page == PageKind.now-playing {
            root.entered = true;
        } else {
            // Snap to the start values, then ease in from there on the next tick.
            root.entered = false;
            enter.running = true;
        }
        Frame.instant = false;
    }
    enter := Timer {
        interval: 1ms;
        running: false;
        triggered => {
            self.running = false;
            root.entered = true;
        }
    }
    // The playing mark's one clock (`Mark`): steps only while sound plays, the window is on
    // screen and something on it shows a mark: Up next in the panel or the sheet, a song row
    // on screen marked playing (`Mark.rows`, from src/prepare.rs), or what the rows don't
    // tell: History, Now playing, Home's tile for where the song plays from. Paused,
    // stopped, loading, minimized, hidden in the tray, with reduced motion, on Explore, a
    // mood, Settings, About or Sign in, or with the song's row off screen, it isn't armed.
    property <bool> marks-shown: root.panel-shown || root.sheet-shown || ((Nav.page != PageKind.explore && Nav.page != PageKind.mood && Nav.page != PageKind.settings && Nav.page != PageKind.about && Nav.page != PageKind.sign-in) && (Mark.rows || Nav.page == PageKind.history || Nav.page == PageKind.now-playing || (Nav.page == PageKind.home && HomeData.playing-id != "")));
    Timer {
        interval: Mark.step;
        running: Player.playing && !Player.loading && Theme.moving && !root.minimized && !Frame.hidden && root.marks-shown;
        triggered => { Mark.frame += 1; }
    }
    // The Lyrics tab's lines are timed only while it's on screen (pages/lyrics.slint).
    LyricsWatch {
        minimized: root.minimized;
        window-w: root.width;
        window-h: root.height;
    }
    // A keyboard navigation that didn't move (no history) mustn't leave `instant` set.
    instant-clear := Timer {
        interval: 50ms;
        running: Frame.instant;
        triggered => { Frame.instant = false; }
    }
    // Keyboard actions that navigate.
    function navigate-by-key() {
        Frame.instant = true;
    }

    // Settings' dialogs close: the keys come back to the window (the dialog had them).
    property <SettingsDialog> settings-dialog: SettingsData.dialog;
    changed settings-dialog => {
        if root.settings-dialog == SettingsDialog.none {
            keys.focus();
        }
    }

    // A menu, a popup or a dialog is open over the window: the transport keys and Ctrl+/ wait.
    property <bool> overlay-open: CloseChoice.open || AgeNote.open || SettingsData.dialog != SettingsDialog.none || AlbumMenu.open || AlbumMenu.dialog || SongMenu.open || PlaylistMenu.open || PlaylistMenu.dialog != PlaylistDialog.none || ItemMenu.open || AccountMenu.open || AccountPicker.open || Player.speed-open || Sleep.open || Frame.volume-open || root.drawer-shown || LyricsMenu.open || LyricsChoose.open || LyricsData.reset-asked || ChoiceMenu.open;

    // Full-screen controls behave like a video player's: entering and every real pointer move
    // gives them three seconds. A popup pauses the countdown, so it never loses its opener.
    property <int> immersive-revealed: Immersive.revealed;
    changed immersive-revealed => {
        if Immersive.active && !root.overlay-open {
            immersive-hide.restart();
        }
    }
    // It lasts while the full lyrics view is asked for on Now playing: a song with no lyrics
    // shows its cover there and stays full screen; leaving the lyrics or the page ends it.
    property <bool> immersive-valid: LyricsData.wanted;
    changed immersive-valid => {
        if Immersive.active && !root.immersive-valid {
            Immersive.leave();
        }
    }
    property <bool> immersive-active: Immersive.active;
    changed immersive-active => {
        // A native full-screen exit changes `active` through the two-way window binding.
        if !root.immersive-active {
            Immersive.leave();
        }
    }
    immersive-hide := Timer {
        interval: 3s;
        running: Immersive.active && Immersive.controls && !root.overlay-open;
        triggered => { Immersive.hide-controls(); }
    }
    property <float> immersive-chrome: !Immersive.active || Immersive.controls ? 1 : 0;
    animate immersive-chrome { duration: Theme.t-fast; easing: Curves.ease-out; }

    // The shortcuts, listed for Settings' "Keyboard shortcuts" in shortcuts.slint: each one
    // taken here is reported there (`Shortcuts.used`). A new one goes in both.
    keys := FocusScope {
        key-pressed(e) => {
            if e.modifiers.control && (e.text == "k" || e.text == "K") {
                Shortcuts.used(ShortcutKind.search);
                // Now playing hides the bar: leave it first. Sign in has none: search from
                // Home, as "Continue without signing in" goes, but not from under the account
                // picker, which keeps the keys.
                if AccountPicker.open {
                    return accept;
                }
                if root.full-page {
                    root.navigate-by-key();
                    Nav.back();
                } else if root.no-top {
                    root.navigate-by-key();
                    Nav.go(PageKind.home);
                }
                top-bar.focus-search();
                return accept;
            }
            // Settings' search (on Settings only, not under a menu or a dialog): the top bar's
            // field, which searches the settings there, takes the keys, its text selected.
            if e.modifiers.control && !e.modifiers.alt && !e.modifiers.meta && (e.text == "f" || e.text == "F") {
                Shortcuts.used(ShortcutKind.search-settings);
                if Nav.page == PageKind.settings && !root.overlay-open {
                    top-bar.focus-search();
                }
                return accept;
            }
            // Desktop lyrics on or off, as Settings' switch: only while it's offered (lyrics
            // on, and a desktop that can keep a strip on top). A held key acts once.
            if e.modifiers.control && e.modifiers.shift && !e.modifiers.alt && !e.modifiers.meta && (e.text == "l" || e.text == "L") {
                Shortcuts.used(ShortcutKind.desktop-lyrics);
                if SettingsData.lyrics && SettingsData.desktop-lyrics-here && !e.repeat {
                    SettingsData.toggled(SettingKey.desktop-lyrics, !SettingsData.desktop-lyrics);
                }
                return accept;
            }
            // Lyrics on or off, as the bar's microphone does (off any page, Now playing opens
            // on them). Nothing with lyrics off in Settings.
            if e.modifiers.control && (e.text == "l" || e.text == "L") {
                Shortcuts.used(ShortcutKind.lyrics);
                if LyricsData.on && (Player.has-track || LyricsData.showing) {
                    if !LyricsData.showing && Nav.page != PageKind.now-playing {
                        root.navigate-by-key();
                    }
                    LyricsData.toggle-view();
                }
                return accept;
            }
            // The lyrics' text size a step larger or smaller (Ctrl+= or Ctrl++, Ctrl+-), while
            // lyrics show. Not under a menu or a dialog.
            if e.modifiers.control && !e.modifiers.alt && !e.modifiers.meta && (e.text == "=" || e.text == "+" || e.text == "-") {
                Shortcuts.used(ShortcutKind.lyrics-size);
                if LyricsData.on-screen && LyricsData.has-lines && !root.overlay-open && !e.repeat {
                    LyricsData.pick-size(e.text == "-" ? max(0, LyricsData.size - 1) : min(2, LyricsData.size + 1));
                }
                return accept;
            }
            // The mini player on or off, as the bar's button does: only where the desktop has
            // no tray, as the button. Not under a menu or a dialog.
            if !SettingsData.has-tray && e.modifiers.control && !e.modifiers.alt && !e.modifiers.meta && (e.text == "m" || e.text == "M") {
                Shortcuts.used(ShortcutKind.mini-player);
                if !root.overlay-open && !e.repeat {
                    bottom-bar.toggle-mini();
                }
                return accept;
            }
            // Previous, Next, Shuffle and Repeat, as the bar's buttons do: Ctrl+Left, Ctrl+Right,
            // Ctrl+S and Ctrl+R. Not while a text field has the keys (Ctrl+Left and Right move
            // by word there, and some reach here at the field's ends), nor under a menu or a
            // dialog; a held key acts once; with nothing loaded they do nothing.
            if e.modifiers.control && !e.modifiers.alt && !e.modifiers.shift && !e.modifiers.meta && (e.text == Key.LeftArrow || e.text == Key.RightArrow || e.text == "s" || e.text == "S" || e.text == "r" || e.text == "R") {
                if TextInputInterface.text-input-focused {
                    return reject;
                }
                let kind = e.text == Key.LeftArrow ? ShortcutKind.previous : (e.text == Key.RightArrow ? ShortcutKind.next : (e.text == "s" || e.text == "S" ? ShortcutKind.shuffle : ShortcutKind.repeat));
                Shortcuts.used(kind);
                if Player.has-track && !e.repeat && !root.overlay-open {
                    if kind == ShortcutKind.previous {
                        Player.previous();
                    } else if kind == ShortcutKind.next {
                        Player.next();
                    } else if kind == ShortcutKind.shuffle {
                        Player.toggle-shuffle();
                    } else {
                        Player.cycle-repeat();
                    }
                }
                return accept;
            }
            // The keyboard shortcuts' list (Settings' dialog) over any page: Ctrl+/. With Ctrl
            // held the key comes as the character Shift makes, so layouts where "/" needs Shift
            // (Shift+7 in German) work too; Ctrl+? on a US layout opens it as well. Not from a
            // text field, nor over a menu or another dialog.
            if e.modifiers.control && !e.modifiers.alt && !e.modifiers.meta && (e.text == "/" || e.text == "?") {
                if TextInputInterface.text-input-focused {
                    return reject;
                }
                Shortcuts.used(ShortcutKind.shortcuts);
                if !root.overlay-open {
                    SettingsData.open-dialog(SettingsDialog.shortcuts);
                }
                return accept;
            }
            // Every song of one of the account's own playlists picked, to move them. Not from a
            // text field (it selects its text), nor under a menu or a dialog.
            if e.modifiers.control && !e.modifiers.alt && !e.modifiers.meta && (e.text == "a" || e.text == "A") {
                if TextInputInterface.text-input-focused {
                    return reject;
                }
                Shortcuts.used(ShortcutKind.select-all);
                if Nav.page == PageKind.playlist && PlaylistData.editable && !root.overlay-open {
                    PlaylistData.pick-all();
                }
                return accept;
            }
            // The rows picked on one of the account's own playlists move: Alt+Up and Alt+Down a
            // place, Alt+Home and Alt+End to the top or the end. Not under a menu or a dialog.
            if e.modifiers.alt && !e.modifiers.control && !e.modifiers.meta && (e.text == Key.UpArrow || e.text == Key.DownArrow || e.text == Key.Home || e.text == Key.End) {
                Shortcuts.used(ShortcutKind.move-songs);
                if Nav.page == PageKind.playlist && PlaylistData.editable && !root.overlay-open {
                    PlaylistData.move-picked(e.text == Key.UpArrow ? ReorderKey.up : e.text == Key.DownArrow ? ReorderKey.down : e.text == Key.Home ? ReorderKey.home : ReorderKey.end);
                }
                return accept;
            }
            if e.modifiers.alt && e.text == Key.LeftArrow {
                Shortcuts.used(ShortcutKind.back);
                root.navigate-by-key();
                Nav.back();
                return accept;
            }
            if e.modifiers.alt && e.text == Key.RightArrow {
                Shortcuts.used(ShortcutKind.forward);
                root.navigate-by-key();
                Nav.forward();
                return accept;
            }
            // Space plays and pauses, as the bar's play button does, from any page. It reaches
            // here only when nothing focused took it: a text field types it instead; buttons
            // don't take the keys; Settings' switches leave it and flip on Enter. A held Space
            // flips once (auto-repeats are dropped); with nothing loaded it does nothing.
            if e.text == " " && !e.modifiers.control && !e.modifiers.alt && !e.modifiers.meta {
                Shortcuts.used(ShortcutKind.play-pause);
                if Player.has-track && !e.repeat {
                    Player.toggle();
                }
                return accept;
            }
            // Up and Down move the volume one Volume step, from any page. Like Space, they reach
            // here only when nothing focused took them: text fields move their cursor with them,
            // the search suggestions, the account picker and the hue slider their own choice.
            // Not under a dialog.
            if (e.text == Key.UpArrow || e.text == Key.DownArrow) && !e.modifiers.control && !e.modifiers.alt && !e.modifiers.meta {
                Shortcuts.used(ShortcutKind.volume);
                if !CloseChoice.open && !AgeNote.open && SettingsData.dialog == SettingsDialog.none && !AlbumMenu.dialog {
                    bottom-bar.step-volume(e.text == Key.UpArrow);
                }
                return accept;
            }
            if e.text == Key.Escape {
                Shortcuts.used(ShortcutKind.escape);
                // A drag of a playlist's songs ends where it started.
                if PlaylistData.dragging {
                    PlaylistData.dragging = false;
                    return accept;
                }
                // First Escape leaves immersive mode; a second one leaves Now playing.
                if Immersive.active {
                    Immersive.leave();
                    keys.focus();
                    return accept;
                }
                // In the search field: the first Escape clears it, the next leaves it.
                if top-bar.searching && TopBarData.query != "" {
                    top-bar.clear-search();
                    return accept;
                }
                // Then the drawer or the Up next sheet, before leaving Now playing.
                if root.drawer-shown {
                    root.close-drawer(true);
                    return accept;
                }
                if root.sheet-shown {
                    root.close-sheet(true);
                    keys.focus();
                    return accept;
                }
                // Then the rows picked on a playlist.
                if Nav.page == PageKind.playlist && PlaylistData.editable && PlaylistData.unpick() {
                    keys.focus();
                    return accept;
                }
                if root.full-page {
                    root.navigate-by-key();
                    Nav.back();
                }
                keys.focus();
                return accept;
            }
            reject
        }

        Rectangle {
            x: root.side-w;
            y: 0;
            width: root.page-width;
            // The pages end at the bar's top: below it, beside and under the floating bar, the
            // window's ground shows, and nothing of a page is drawn there. A page is still laid
            // out the window's height, so its content scrolls up from under the bar.
            height: root.full-page ? root.height : root.bar-top;
            clip: true;
            Rectangle {
                // Only the enter offset eases: where the page starts (below the top bar, or
                // under it) steps at once with the page.
                property <length> rise-by: root.entered ? 0px : Theme.rise;
                animate rise-by { duration: root.entered ? Theme.t-page : 0ms; easing: Curves.ease-out; }
                y: root.top-h + self.rise-by;
                height: root.height - root.top-h;
                if Nav.page == PageKind.home: HomePage {
                    width: parent.width;
                    height: parent.height;
                }
                if Nav.page == PageKind.library: LibraryPage {
                    width: parent.width;
                    height: parent.height;
                }
                if Nav.page == PageKind.explore: ExplorePage {
                    width: parent.width;
                    height: parent.height;
                }
                if Nav.page == PageKind.mood: MoodPage {
                    width: parent.width;
                    height: parent.height;
                }
                if Nav.page == PageKind.history: HistoryPage {
                    width: parent.width;
                    height: parent.height;
                }
                if Nav.page == PageKind.album: AlbumPage {
                    width: parent.width;
                    height: parent.height;
                }
                if Nav.page == PageKind.playlist: PlaylistPage {
                    width: parent.width;
                    height: parent.height;
                }
                if Nav.page == PageKind.artist: ArtistPage {
                    width: parent.width;
                    height: parent.height;
                }
                if Nav.page == PageKind.discography: DiscographyPage {
                    width: parent.width;
                    height: parent.height;
                }
                if Nav.page == PageKind.search: SearchPage {
                    width: parent.width;
                    height: parent.height;
                }
                if Nav.page == PageKind.now-playing: NowPlayingPage {
                    width: parent.width;
                    height: parent.height;
                }
                if Nav.page == PageKind.settings: SettingsPage {
                    width: parent.width;
                    height: parent.height;
                }
                if Nav.page == PageKind.about: AboutPage {
                    width: parent.width;
                    height: parent.height;
                }
                if Nav.page == PageKind.sign-in: SignInPage {
                    width: parent.width;
                    height: parent.height;
                }
            }
            // Content scrolling down to the bar dissolves into the ground over the strip just
            // above its top, rather than being cut. It repaints whenever content scrolls under
            // it, so it's only this strip, not the bar's height, and solid bands rather than a
            // gradient with alpha, the costliest fill to draw.
            Bands {
                visible: !root.full-page;
                y: root.bar-top - root.bar-fade;
                height: root.bar-fade;
                top: Theme.ground.transparentize(100%);
                bottom: Theme.ground;
            }
            // Content scrolling up under the bar fades out rather than being cut. At rest the
            // pages' top padding is blank ground, so the fade is invisible.
            Bands {
                visible: !root.full-page && !root.under-top && !root.no-top;
                y: Theme.top-bar-h;
                height: Theme.s4;
                count: 16;
                top: Theme.ground;
                bottom: Theme.ground.transparentize(100%);
            }
        }

        // The row at the window's top (`TopBar`), after the page so it lies over a page that
        // runs up under it, and before the drawer, which slides over it.
        top-bar := TopBar {
            x: 0;
            y: 0;
            width: root.width;
            side-w: root.side-w;
            page-w: root.page-width;
            visible: (!root.full-page || Frame.own-bar) && !Immersive.active;
            stage: root.full-page;
            clear: root.under-top || root.no-top;
            searchable: !root.no-top;
            narrow: root.rail;
            menu: root.drawer;
            menu-open: root.drawer-shown;
            menu-pressed(by-key) => {
                if root.drawer-shown {
                    root.close-drawer(by-key);
                } else {
                    root.open-drawer(by-key);
                }
            }
            area-h: root.bar-top;
            settings: Nav.page == PageKind.settings;
            submitted(q) => {
                root.navigate-by-key();
                Nav.search(q);
                keys.focus();
            }
            picked(i, by-key) => {
                if by-key {
                    root.navigate-by-key();
                }
                TopBarData.picked-by-key = by-key;
                TopBarData.pick(i);
                keys.focus();
            }
            dismissed => { keys.focus(); }
        }

        // The drawer's scrim, over the page and under the drawer: a click on it closes the
        // drawer, and the page under it doesn't scroll. Faded through its colour.
        Rectangle {
            visible: root.drawer && (root.drawer-shown || root.d-out < 1);
            background: root.drawer-shown ? Theme.drawer-scrim : Theme.drawer-scrim.transparentize(100%);
            animate background { duration: root.drawer-shown ? (root.drawer-by-key ? 0ms : Theme.t-menu) : (root.drawer-snap ? 0ms : Theme.t-fast); easing: Curves.ease-out; }
            TouchArea {
                pointer-event(e) => {
                    if e.kind == PointerEventKind.down {
                        root.close-drawer(false);
                    }
                }
                scroll-event(e) => { accept }
            }
        }

        // The sidebar, after the page so that, as the drawer, it lies over it (beside the page
        // the two never meet). The drawer is the full sidebar slid in from the left edge.
        // Beside the page it starts under the row at the window's top (`top-bar`), which holds
        // its first row; as the drawer it runs the window's height, over the row.
        sidebar := Sidebar {
            x: root.drawer ? -Theme.sidebar-w * root.d-out : 0;
            y: root.drawer ? 0 : Theme.top-bar-h;
            height: root.height - self.y;
            lead: root.drawer ? Theme.s3 : Theme.s1;
            clear: Theme.bar-clear;
            visible: root.drawer ? root.d-out < 1 : !root.full-page;
            rail: root.rail && !root.drawer;
            drawer: root.drawer;
            picked => { root.close-drawer(false); }
            escaped => { root.close-drawer(true); }
        }

        // The sheet's scrim, over the page and the rail, under the sheet and the bar.
        Rectangle {
            visible: root.sheet && (root.sheet-shown || root.s-out < 1);
            background: root.sheet-shown ? Theme.scrim : Theme.scrim.transparentize(100%);
            animate background { duration: root.sheet-shown ? Theme.t-menu : (root.sheet-snap ? 0ms : Theme.t-fast); easing: Curves.ease-out; }
            TouchArea {
                pointer-event(e) => {
                    if e.kind == PointerEventKind.down {
                        root.close-sheet(false);
                    }
                }
                scroll-event(e) => { accept }
            }
        }

        // Up next: the side panel at the window's right edge, or where it doesn't fit beside
        // the page, the sheet, the same panel as a card above the bar. The sheet rises from
        // behind the bar's top edge, where it's cut off (`clip`).
        Rectangle {
            y: 0;
            height: root.sheet ? root.bar-top : root.height;
            clip: root.sheet;
            QueuePanel {
                // How much of it is slid out past the right edge: that eases, not `x`, so
                // the panel stays at the edge while the window resizes.
                property <float> out: root.panel-open ? 0 : 1;
                animate out { duration: root.panel-open ? Theme.t-panel : Theme.t-panel * 0.8; easing: Curves.ease-drawer; }
                init => { root.panel-in = self.out <= 0; }
                changed out => { root.panel-in = self.out <= 0; }
                card: root.sheet;
                x: root.sheet ? root.width - Theme.bar-inset - root.sheet-w : root.width - root.panel-w * (1 - self.out);
                y: root.sheet ? Theme.sheet-top + root.s-out * (root.sheet-h + Theme.s2) : 0;
                width: root.sheet ? root.sheet-w : root.panel-w;
                height: root.sheet ? root.sheet-h : root.height;
                visible: root.sheet ? root.s-out < 1 : self.out < 1;
                open: root.sheet ? root.sheet-shown : root.panel-shown;
                // In the sheet, its lists end 12 px above the volume row, or the sheet's foot:
                // they keep the panel's room for the bar below them, which the sheet cuts off.
                // Beside the page, its tabs clear the window buttons over its top.
                SideTabs {
                    y: root.sheet ? 0px : Theme.panel-top;
                    height: root.sheet ? parent.height + Theme.bar-clear - root.sheet-foot - Theme.s3 : parent.height - self.y;
                    shown: root.sheet ? root.sheet-shown : root.panel-shown;
                    trail: root.sheet ? 36px + Theme.s2 : 0px;
                }
                // Closes the sheet, as Escape, a click outside it and the bar's button do. Its
                // right edge on the rows' (left of the list's scroll bar), as Clear's is.
                Rectangle {
                    visible: root.sheet;
                    x: parent.width - Theme.s4 - Theme.s2 - self.width;
                    y: Theme.s3 + 2px;
                    width: 36px;
                    height: 36px;
                    border-radius: self.height / 2;
                    background: Theme.tonal(close-ta.pressed, close-ta.has-hover);
                    accessible-role: button;
                    accessible-label: @tr("Close Up next");
                    accessible-action-default => { root.close-sheet(false); }
                    animate background { duration: Theme.t-hover; }
                    close-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.close-sheet(false); }
                    }
                    Icon {
                        width: 18px;
                        height: 18px;
                        commands: Icons.close;
                        stroke: Theme.text1;
                    }
                }
                // The volume, once the bar has no button for it: a row at the sheet's foot,
                // the mute button under the rows' covers, the value under their lengths.
                Rectangle {
                    visible: root.sheet && Frame.volume-in-sheet;
                    y: parent.height - root.sheet-foot;
                    height: root.sheet-foot;
                    Rectangle {
                        x: Theme.s4;
                        y: 0;
                        width: parent.width - 2 * Theme.s4 - Theme.s2;
                        height: 1px;
                        background: Theme.hairline;
                    }
                    VolumeRow {
                        x: Theme.s4;
                        y: 1px + (parent.height - 1px - self.height) / 2;
                        width: parent.width - 2 * Theme.s4 - Theme.s2 - Theme.s3;
                    }
                }
                // Beside the page, the panel's foot ends in the ground as the page's does: its
                // rows dissolve over the same strip above the bar, and under the bar's row it's
                // the ground, so the bar floats on one ground from edge to edge and its colour
                // never meets the panel's grey.
                Bands {
                    visible: !root.sheet;
                    y: root.bar-top - root.bar-fade;
                    height: root.bar-fade;
                    top: Theme.ground.transparentize(100%);
                    bottom: Theme.ground;
                }
                Rectangle {
                    visible: !root.sheet;
                    y: root.bar-top;
                    height: parent.height - self.y;
                    background: Theme.ground;
                }
            }
        }

        bottom-bar := BottomBar {
            x: Theme.bar-inset;
            y: root.bar-top;
            width: root.width - 2 * Theme.bar-inset;
            page-w: root.width;
            page-h: root.height;
            visible: root.immersive-chrome > 0;
            opacity: root.immersive-chrome;
        }

        // Settings' dialogs: their scrim covers the whole window and takes its clicks. The
        // keyboard shortcuts' shows over any page (Ctrl+/).
        if (Nav.page == PageKind.settings && SettingsData.dialog != SettingsDialog.none) || SettingsData.dialog == SettingsDialog.shortcuts: SettingsDialogLayer {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
        }

        // While the search suggestions show, a click beside the pages (the sidebar, the bar,
        // the Up next panel) closes them, as one on a page does (`TopBar`), and goes no
        // further.
        Rectangle {
            visible: top-bar.suggestions-open;
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            for area in [
                { x: 0px, y: 0px, w: root.side-w, h: root.height },
                { x: root.side-w, y: root.bar-top, w: root.width - root.side-w, h: root.height - root.bar-top },
                { x: root.side-w + root.page-width, y: 0px, w: root.width - root.side-w - root.page-width, h: root.bar-top },
            ]: TouchArea {
                x: area.x;
                y: area.y;
                width: area.w;
                height: area.h;
                pointer-event(e) => {
                    if e.kind == PointerEventKind.down {
                        top-bar.close-suggestions(false);
                        TopBarData.dismissed();
                        keys.focus();
                    }
                }
            }
        }

        // Toasts: bottom centre, 16 px above the bar. On Sign in, centred under its block, in
        // the page's room (beside Up next while it's open).
        ToastView {
            x: root.no-top ? root.page-x + (root.page-width - self.width) / 2 : (root.width - self.width) / 2;
            y: root.bar-top - Theme.s4 - self.height;
            focus-released => { keys.focus(); }
        }

        // The bar's speed popup, from its speed pill.
        SpeedLayer {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            visible: Player.speed-open;
            bottom: root.bar-top;
            anchor: bottom-bar.x + bottom-bar.speed-centre;
            closed => { keys.focus(); }
        }

        // The bar's sleep timer popup, from its button.
        SleepLayer {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            visible: Sleep.open;
            bottom: root.bar-top;
            anchor: bottom-bar.x + bottom-bar.sleep-centre;
            closed => { keys.focus(); }
        }

        // The bar's volume popup, from its volume button where the slider doesn't fit.
        VolumeLayer {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            visible: Frame.volume-open;
            bottom: root.bar-top;
            anchor: bottom-bar.x + bottom-bar.volume-centre;
            closed => { keys.focus(); }
        }

        // The account menu, from the sidebar's account row.
        AccountMenuLayer {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            closed => { keys.focus(); }
        }

        // The song menu, over everything while open.
        SongMenuLayer {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            bottom-limit: root.bar-top;
            closed => { keys.focus(); }
        }

        // Settings' choice menu, from a setting's dropdown. The dropdown takes the keys back.
        ChoiceMenuLayer {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            bottom-limit: root.bar-top;
        }

        // Now playing's lyrics menu, from the ⋯ beside the Lyrics pill, and "Choose other
        // lyrics", centred in the stage (left of the side panel).
        LyricsMenuLayer {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            closed => { keys.focus(); }
        }
        if LyricsChoose.open: LyricsChooseLayer {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            room-w: Nav.page == PageKind.now-playing && Frame.side-shown ? root.width - (root.width >= Theme.wide-min ? Theme.nowplaying-side-w : Theme.panel-w) : root.width;
            closed => { keys.focus(); }
        }
        if LyricsData.reset-asked: LyricsResetLayer {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            closed => { keys.focus(); }
        }

        // The sidebar's playlist menu, over everything while open, and its dialogs.
        PlaylistMenuLayer {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            bottom-limit: root.bar-top;
            closed => { keys.focus(); }
        }
        ItemMenuLayer {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            bottom-limit: root.bar-top;
            closed => { keys.focus(); }
        }
        // Home's "N more" Shortcuts, over everything while open.
        ShortcutMoreLayer {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            bottom-limit: root.bar-top;
            top-limit: root.top-h;
            closed => { keys.focus(); }
        }
        if PlaylistMenu.dialog != PlaylistDialog.none: PlaylistDialogLayer {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            closed => { keys.focus(); }
        }

        // The album page's ⋯ menu, over everything while open, and its confirmation.
        AlbumMenuLayer {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            bottom-limit: root.bar-top;
            closed => { keys.focus(); }
        }
        if AlbumMenu.dialog: AlbumDialogLayer {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            closed => { keys.focus(); }
        }

        // The close dialog (src/close.rs): what the close button does, until the user picks.
        if CloseChoice.open: CloseDialog {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            closed => { keys.focus(); }
        }

        // The first age-restricted skip of a run (src/age_note.rs): why, and how to play them.
        if AgeNote.open: AgeNoteLayer {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            closed => { keys.focus(); }
        }

        // The first sign-in's account picker (src/account_picker.rs), over everything, its
        // card centred in the page's room, where the sign-in page's block is.
        if AccountPicker.open: AccountPickerDialog {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            room-x: root.page-x;
            room-w: root.page-width;
            room-h: root.bar-top;
            closed => { keys.focus(); }
        }

        // The window buttons, over everything: they work whatever lies over the window.
        if Frame.own-bar && !Immersive.active: CaptionButtons {
            x: root.width - self.width;
            y: 0;
        }

        if Probe.region: ProbeRegion {
            x: Probe.region-x;
            y: Probe.region-y;
        }

        // While the wheel scrolls under a still pointer, this holds the hover, so the rows
        // passing under it don't light up and fade one after another (each a repaint). The
        // wheel passes through to the list; moving the pointer or pressing a button removes
        // it first (`wheel.rs`), so hover and clicks are as before. It stops at the bar, which
        // never scrolls: the volume slider under the wheel keeps its hover.
        TouchArea {
            visible: Frame.scrolling;
            x: 0;
            y: 0;
            width: root.width;
            height: root.bar-top;
        }

        // Once the chrome has gone this topmost area hides the pointer and makes the first
        // move reveal it. Real windows also report every move through `wheel.rs`, including
        // moves over interactive lyrics and song information.
        TouchArea {
            visible: Immersive.active && !Immersive.controls && !root.overlay-open;
            mouse-cursor: MouseCursor.none;
            pointer-event(e) => {
                if e.kind == PointerEventKind.move {
                    Immersive.reveal();
                }
            }
        }
    }
}
