// The tray's mini player: a small borderless window that opens over the notification area on
// a left click of the tray icon (`src/mini.rs` creates it, places it and drops it on close);
// on Wayland, which places windows itself, an ordinary one in the desktop's frame.
// Top: the cover, then the title (up to two lines) and the artist, with the pin and the button
// that opens the main window in the top-right corner, level with the cover's top. Pinned, it
// stays open and on top until closed, the corner holds its × and a press off the controls
// moves it. Then the bar's seek line across the window (a click or a drag on it seeks), the
// time played and the length under its ends. Last, one row centred: previous, play or pause
// and next, flanked by the like heart on the left and "not for me" on the right, so play sits
// in the middle of the window.
//
// It has its own `Player` and `Theme` globals (globals belong to their window): Rust copies
// the main window's into them. Nothing in it runs a timer; the position arrives with the
// bar's once-a-second tick while sound plays (the seek line shimmers only while loading).
import { Theme, Icons, Curves } from "theme.slint";
import { Body, Cover, Display, IconButton, PlayButton } from "parts.slint";
import { Player } from "player.slint";
import { SeekLine } from "bottom_bar.slint";

export global MiniData {
    // The cover the mini player loads for itself (`mini::COVER`).
    in property <image> cover;
    // Show the main window (then the mini player closes, unless it's pinned).
    callback open-app();
    // Escape or the ×: close.
    callback dismiss();
    // The window lost activation: close, unless it's pinned.
    callback activation-lost();
    // Pinned (its pin button): it stays open and above other windows until closed.
    in-out property <bool> pinned;
    callback toggle-pin();
    // A left press off the controls while pinned: move the window with the pointer.
    callback drag();
    // An ordinary window in the desktop's frame, where the tray can't place it (Wayland).
    in property <bool> framed;
}

// A time under an end of the progress line.
component Time inherits Body {
    width: 64px;
    height: 14px;
    font-size: Theme.t-meta;
    color: Theme.text2;
    vertical-alignment: center;
    overflow: clip;
}

export component MiniPlayer inherits Window {
    // The heart pops when a like is added, as in the bar.
    property <bool> heart-pop: false;
    property <length> pad: Theme.s3;
    property <length> cover-size: 64px;
    property <length> text-x: root.pad + root.cover-size + Theme.s3;
    property <length> line-y: root.pad + root.cover-size + Theme.s3;
    property <length> controls-y: root.line-y + 4px + Theme.s1 + 14px + Theme.s1;
    // The top-right buttons: 32 px each, the last 8 px from the edge.
    property <length> slot: 32px;
    property <length> corner-x: root.width - Theme.s2 - root.slot;

    title: @tr("featherplay mini player");
    // `mini::SIZE`: 340 x 170.
    width: 340px;
    height: root.controls-y + 44px + root.pad;
    no-frame: !MiniData.framed;
    always-on-top: true;
    background: Theme.bar;
    default-font-family: Theme.body-font;
    default-font-size: Theme.t-body;
    forward-focus: keys;

    pop-end := Timer {
        interval: 1ms;
        running: false;
        triggered => {
            self.running = false;
            root.heart-pop = false;
        }
    }

    keys := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape {
                MiniData.dismiss();
                return accept;
            }
            // As in the main window: a held Space flips playback once.
            if e.text == " " && !e.modifiers.control && !e.modifiers.alt && !e.modifiers.meta {
                if Player.has-track && !e.repeat {
                    Player.toggle();
                }
                return accept;
            }
            reject
        }
        // Another window took the activation (a click elsewhere, Alt+Tab): close, as a flyout
        // does, unless it's pinned.
        focus-lost(reason) => {
            if reason == FocusReason.window-activation {
                MiniData.activation-lost();
            }
        }
        // Pinned, a left press on the cover or the ground moves the window; the controls
        // above it take their own presses.
        TouchArea {
            enabled: MiniData.pinned;
            pointer-event(e) => {
                if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                    MiniData.drag();
                }
            }
        }
    }

    Cover {
        x: root.pad;
        y: root.pad;
        width: root.cover-size;
        height: root.cover-size;
        radius: Theme.r-m;
        source: MiniData.cover;
        crossfade: true;
    }

    // The title on up to two lines, then the artist, centred beside the cover. "Nothing
    // playing" in quiet body text, as the bar shows it.
    VerticalLayout {
        x: root.text-x;
        y: root.pad;
        width: min(open.x, pin.x) - Theme.s2 - self.x;
        height: root.cover-size;
        alignment: center;
        spacing: 2px;
        Display {
            text: Player.has-track ? Player.title : @tr("Nothing playing");
            font-family: Player.has-track ? Theme.display-font : Theme.body-font;
            font-size: Player.has-track ? Theme.t-body-l : Theme.t-body;
            font-weight: Player.has-track ? 700 : 600;
            letter-spacing: Player.has-track ? self.font-size * Theme.display-tracking : 0px;
            color: Player.has-track ? Theme.text1 : Theme.text3;
            wrap: word-wrap;
            max-lines: 2;
        }
        if Player.has-track && Player.artist != "": Body {
            text: Player.artist;
            font-size: Theme.t-meta;
            color: Theme.text2;
        }
    }

    // Keeps the mini player open and on top. It holds its place either way, so a second
    // click unpins it; pinned, the corner beside it is the ×.
    pin := IconButton {
        x: root.corner-x - root.slot;
        y: open.y;
        width: root.slot;
        height: root.slot;
        glyph: 18px;
        // A push pin: its head, its body widening to the rim, the needle.
        icon: "M8.5 4.5 H15.5 M10 4.5 V9.5 L7 13.5 H17 L14 9.5 V4.5 M12 13.5 V19.5";
        label: MiniData.pinned ? @tr("Unpin") : @tr("Keep on top");
        description: @tr("Keeps the mini player open and above other windows");
        active: MiniData.pinned;
        tint: Theme.text2;
        clicked => { MiniData.toggle-pin(); }
    }

    // Opens the main window as it was left; unpinned, the mini player closes. In the corner,
    // its glyph level with the cover's top edge; pinned, left of the pin.
    open := IconButton {
        x: MiniData.pinned ? root.corner-x - 2 * root.slot : root.corner-x;
        y: root.pad - (self.height - self.glyph) / 2;
        width: root.slot;
        height: root.slot;
        glyph: 18px;
        // A window with an arrow out of its corner.
        icon: "M13.5 4.5 H19.5 V10.5 M19.5 4.5 L12 12 M17.5 14 V18 A1.5 1.5 0 0 1 16 19.5 H6 A1.5 1.5 0 0 1 4.5 18 V8 A1.5 1.5 0 0 1 6 6.5 H10";
        label: @tr("Open featherplay");
        tint: Theme.text2;
        clicked => { MiniData.open-app(); }
    }

    // Pinned, the corner closes it.
    if MiniData.pinned: IconButton {
        x: root.corner-x;
        y: open.y;
        width: root.slot;
        height: root.slot;
        glyph: 18px;
        icon: Icons.close;
        label: @tr("Close");
        tint: Theme.text2;
        clicked => { MiniData.dismiss(); }
    }

    // The seek line across the window's padding, the accent up to the time played; its 4 px
    // line at `line-y`, in a 16 px band that takes the presses (so a drag on it seeks, never
    // moves the window). Under its ends, the time played (where a drag would drop) and the
    // length.
    seek := SeekLine {
        x: root.pad;
        y: root.line-y + 2px - self.height / 2;
        width: root.width - 2 * root.pad;
        tip-within: true;
    }
    Time {
        x: root.pad;
        y: root.line-y + 4px + Theme.s1;
        text: !Player.has-track ? "" : (seek.dragging ? Player.clock(seek.preview * Player.duration-s) : Player.elapsed);
        horizontal-alignment: left;
    }
    Time {
        x: root.width - root.pad - self.width;
        y: root.line-y + 4px + Theme.s1;
        text: Player.has-track ? Player.total : "";
        horizontal-alignment: right;
    }

    // The controls, centred on the window: the transport with the play disc in the middle,
    // the heart and "not for me" a step further out on either side.
    HorizontalLayout {
        x: (root.width - self.width) / 2;
        y: root.controls-y;
        width: self.preferred-width;
        height: 44px;
        alignment: center;
        spacing: Theme.s2;
        IconButton {
            y: 4px;
            icon: Icons.heart;
            label: Player.liked ? @tr("Remove like") : @tr("Like");
            filled: Player.liked;
            tint: Player.liked ? Theme.text1 : Theme.text2;
            enabled: Player.has-track;
            glyph-scale: root.heart-pop && Theme.moving ? 0.8 : 1.0;
            clicked => {
                if !Player.liked {
                    root.heart-pop = true;
                    pop-end.running = true;
                }
                Player.toggle-like();
            }
        }
        Rectangle { width: Theme.s1; }
        IconButton {
            y: 4px;
            icon: Icons.prev;
            label: @tr("Previous");
            filled: true;
            tint: Theme.text1;
            enabled: Player.has-track;
            clicked => { Player.previous(); }
        }
        // The bar's play button, smaller: the same morph, round paused and a rounded square
        // playing.
        PlayButton {
            size: 44px;
            glyph: 22px;
        }
        IconButton {
            y: 4px;
            icon: Icons.next;
            label: @tr("Next");
            filled: true;
            tint: Theme.text1;
            enabled: Player.has-track;
            clicked => { Player.next(); }
        }
        Rectangle { width: Theme.s1; }
        IconButton {
            y: 4px;
            icon: Player.disliked ? Icons.dislike-filled : Icons.dislike;
            filled: Player.disliked;
            label: @tr("Not for me");
            description: @tr("Skips the song and tells YouTube Music you dislike it");
            tint: Player.disliked ? Theme.text1 : Theme.text2;
            enabled: Player.has-track;
            clicked => { Player.not-for-me(); }
        }
    }
}
